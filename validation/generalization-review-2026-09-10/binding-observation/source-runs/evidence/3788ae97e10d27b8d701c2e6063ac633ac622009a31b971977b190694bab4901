theory Factor_Clause_Rule_Application
  imports Factor_Rule_Instances
begin

section \<open>An actual clause applies under its complete conditional boundary\<close>

theorem positive_clause_rule_instance:
  assumes clause: "((d,c),S)\<in>system_clauses P"
    and head: "schema_call_formed P d t"
    and rule_instance: "schema_rule_instance S (positive_meaning P) t"
  shows "(d,t)\<in>positive_meaning P"
proof -
  obtain V Q where inst: "schema_instance S V t Q" and material: "schema_material_satisfied S V"
    and support: "\<forall>s e x. (s,e,x)\<in>Q \<longrightarrow> (e,x)\<in>positive_meaning P"
    using rule_instance by (simp only: schema_rule_instance_def; blast)
  have calls: "\<forall>s e x. (s,e,x)\<in>Q \<longrightarrow> schema_call_formed P e x"
    by (intro allI impI, rule positive_meaning_formed) (use support in blast)
  have admitted: "admitted_schema_instance P d c V t Q"
    using head clause inst material calls by (simp only: admitted_schema_instance_def; blast)
  show ?thesis by (rule positive_meaning_step[OF admitted support])
qed

text \<open>
  The schema comes from the supplied program. Its head must satisfy the
  actual interface, and every ordinary premise must have semantic support.
  The rule-instance hypothesis includes the complete binder, premise family,
  and material checks. This step is shared by the executable learned libraries.
\<close>

end
