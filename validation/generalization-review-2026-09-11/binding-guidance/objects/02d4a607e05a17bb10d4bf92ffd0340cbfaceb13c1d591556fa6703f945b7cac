theory Factor_Learned_Execution_Soundness
  imports "Factor_Learned_Investigation"
begin

section \<open>Generated rules preserve the library's actual semantic contract\<close>

theorem finite_learned_rules_sound:
  assumes interpreted: "\<And>q H. (q,H) |\<in>| R \<Longrightarrow>
      learned_schema_inferences L (decode_finite_call_term q) (decode_finite_premises H)"
    and library: "\<And>d S t. (d,S)\<in>L \<Longrightarrow>
      schema_rule_instance S (positive_meaning P) t \<Longrightarrow> (d,t)\<in>positive_meaning P"
  shows "inference_sound (\<lambda>q. decode_finite_call_term q\<in>positive_meaning P)
    (finite_inference_rules R)"
proof -
  have native_sound: "inference_sound (\<lambda>q. q\<in>positive_meaning P) (learned_schema_inferences L)"
    by (rule learned_schema_inferences_sound) (use library in blast)
  show ?thesis unfolding inference_sound_def
  proof (intro allI impI)
    fix q H
    assume finite: "finite H" and functional: "single_valued H"
      and step: "finite_inference_rules R q H"
      and support: "rel_ran H\<subseteq>{q. decode_finite_call_term q\<in>positive_meaning P}"
    obtain J where member: "(q,J) |\<in>| R" and shape: "H=fset J"
      using step by (auto simp: finite_inference_rules_def)
    have native_rule: "learned_schema_inferences L (decode_finite_call_term q) (decode_finite_premises J)"
      by (rule interpreted[OF member])
    have boundary: "finite (decode_finite_premises J)" "single_valued (decode_finite_premises J)"
      using native_rule by (auto simp: learned_schema_inferences_def schema_instance_def schema_premise_instance_def)
    have decoded_support: "rel_ran (decode_finite_premises J)\<subseteq>{q. q\<in>positive_meaning P}"
      using support by (auto simp: shape decode_finite_premises_def map_relation_values_def rel_ran_def; force)
    show "decode_finite_call_term q\<in>positive_meaning P"
      using native_sound native_rule boundary decoded_support
      by (cases "decode_finite_call_term q"; auto simp: inference_sound_def)
  qed
qed

theorem finite_generated_schema_rules_sound:
  assumes library: "\<And>d S ps t. (d,S,ps)\<in>set L \<Longrightarrow>
    schema_rule_instance (decode_finite_schema S) (positive_meaning P) t \<Longrightarrow> (d,t)\<in>positive_meaning P"
  shows "inference_sound (\<lambda>q. decode_finite_call_term q\<in>positive_meaning P)
    (finite_inference_rules (finite_generated_schema_rules L C))"
  by (rule finite_learned_rules_sound[where
      L="{(d,decode_finite_schema S) |d S ps. (d,S,ps)\<in>set L}"])
    (use library finite_generated_schema_rule_inference in blast)+

theorem finite_learned_rules_result_sound:
  assumes interpreted: "\<And>q H. (q,H) |\<in>| R \<Longrightarrow>
      learned_schema_inferences L (decode_finite_call_term q) (decode_finite_premises H)"
    and library: "\<And>d S t. (d,S)\<in>L \<Longrightarrow>
      schema_rule_instance S (positive_meaning P) t \<Longrightarrow> (d,t)\<in>positive_meaning P"
    and known: "decode_finite_call_term ` fset K\<subseteq>positive_meaning P"
  shows "decode_finite_call_term ` finite_inference_result R K
    \<subseteq>positive_meaning P"
proof -
  have initial: "fset K\<subseteq>{q. decode_finite_call_term q\<in>positive_meaning P}"
    using known by blast
  have closure: "inference_closure (finite_inference_rules R)
      (fset K)\<subseteq>{q. decode_finite_call_term q\<in>positive_meaning P}"
    by (rule inference_closure_sound[OF finite_learned_rules_sound[OF interpreted library] initial])
  show ?thesis using closure by (auto simp only: finite_inference_result_exact)
qed

theorem finite_learned_closure_sound:
  assumes library: "\<And>d S ps t. (d,S,ps)\<in>set L \<Longrightarrow>
    schema_rule_instance (decode_finite_schema S) (positive_meaning P) t \<Longrightarrow> (d,t)\<in>positive_meaning P"
    and known: "image decode_finite_call_term (fset K)\<subseteq>positive_meaning P"
  shows "image decode_finite_call_term (finite_inference_result (finite_generated_schema_rules L C) K)
    \<subseteq>positive_meaning P"
  by (rule finite_learned_rules_result_sound[where
      L="{(d,decode_finite_schema S) |d S ps. (d,S,ps)\<in>set L}"])
    (use library known finite_generated_schema_rule_inference in blast)+

text \<open>
  The executable rule family inherits the conditional soundness of its actual
  decoded library. Semantic evidence for every known call is a separate
  premise of closure soundness. Possible frontier calls carry no such claim.
  Native admission of a frontier can discharge that premise where the actual
  predicate has an available checker. The inference driver does not create
  semantic evidence by putting a possible call into its initial knowledge.
\<close>

end
