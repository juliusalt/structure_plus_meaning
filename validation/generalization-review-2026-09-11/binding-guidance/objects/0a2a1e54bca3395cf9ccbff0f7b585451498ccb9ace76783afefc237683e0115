#!/usr/bin/env python3
"""Construct a finite method comparison from complete retained reasoning runs.

Reference truth and the original input gate are explicit prerequisites of this
comparison. The builder supplies measured observations to the existing basis
and revision machinery; it does not declare a method adequate by name.
"""
from __future__ import annotations

import argparse
import json
from pathlib import Path

import check_guided_reasoning as guided
import check_reasoning as review
import investigate


def build_case(baseline, methods, prefix, selected):
    original, before = guided.load_baseline(baseline)
    indices = [i for i, c in enumerate(original) if c["name"].startswith(prefix)]
    assert indices, "The independently declared workload prefix must select a nonempty family."
    assert all(len(original[i]["native_goal_truth"]) == len(original[i]["goals"]) for i in indices)
    runs = [("original", baseline, original, before)]
    for name, directory in methods:
        cases, reports = guided.load_baseline(directory)
        runs.append((name, directory, cases, reports))
    assert len({name for name, _, _, _ in runs}) == len(runs)
    values = {(i, j): value for value, (i, j) in enumerate(
        (i, j) for i in indices for j in range(len(original[i]["goals"])))}
    observations, evidence, measurements = [], [], []
    for method, (name, directory, cases, reports) in enumerate(runs):
        aligned = {c.get("baseline_source_index", i): i for i, c in enumerate(cases)}
        assert all(i in aligned for i in indices), (name, "incomplete workload coverage")
        rows = []
        for i in indices:
            case, result = cases[aligned[i]], reports[aligned[i]]
            reference = original[i]
            assert all(case[field] == reference[field] for field in ["library", "frontier", "goals"])
            residual = set(map(review.freeze, result["residual"]))
            truth = reference["native_goal_truth"]
            sound = not result["input_formed"] or all(t or review.freeze(g) in residual
                                                    for g, t in zip(reference["goals"], truth))
            formed = result["input_formed"] == before[i]["input_formed"]
            if sound:
                observations.append([0, method, i])
            if formed:
                observations.append([2, method, i])
            progress = [j for j, (g, t) in enumerate(zip(reference["goals"], truth))
                        if before[i]["input_formed"] and result["input_formed"] and t
                        and review.freeze(g) not in residual]
            observations += [[1, method, values[i, j]] for j in progress]
            rows.append({"reference_case": i, "sound_settlement": sound, "original_gate": formed,
                         "settled_true_goal_occurrences": progress,
                         "added_known_calls": [q for q in case["known"] if q not in reference["known"]]})
        measurements.append({"method": method, "name": name, "workloads": rows})
        evidence += [{"path": str((directory / file).resolve()), "sha256": review.digest(directory / file)}
                     for file in ["receipt.json", "cases.json", "results.log"]]
    profiles = {m: {(f, w) for f, n, w in observations if n == m} for m in range(len(runs))}
    relation = [[a, b] for a in profiles for b in profiles if profiles[a] <= profiles[b]]
    for path in [Path(__file__), Path(guided.__file__), Path(review.__file__)]:
        evidence.append({"path": str(path.resolve()), "sha256": review.digest(path)})
    case = {
        "schema": investigate.SCHEMA, "kind": "basis",
        "question": "Which observations distinguish the measured methods' preservation of native truth, useful settlement, and the original complete input gate?",
        "scope": {
            "methods": {str(i): name for i, (name, _, _, _) in enumerate(runs)},
            "workload_prefix": prefix,
            "workloads": {str(i): original[i]["name"] for i in indices},
            "facets": {"0": "No false native goal is accepted as settled",
                       "1": "Each accepted settlement of a true original goal occurrence",
                       "2": "The original complete input-formation result is preserved"},
            "values": {"useful_goal_occurrences": [{"value": v, "case": i, "goal": j}
                                                  for (i, j), v in values.items()]},
            "comparison": "Preservation of every supplied quality observation across the complete declared workload family.",
            "boundary": "Reference native truth comes from the retained benchmark contracts and comparisons. The supplied finite method family does not establish coverage of all future methods or workloads.",
        },
        "candidates": list(profiles), "facets": [0, 1, 2], "selected": selected,
        "observations": observations, "relation": relation, "evidence": evidence,
    }
    investigate.validate_case(case)
    return case, measurements


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--baseline", type=Path, required=True)
    parser.add_argument("--method", nargs=2, action="append", metavar=("NAME", "DIRECTORY"), required=True)
    parser.add_argument("--prefix", required=True)
    parser.add_argument("--selected", type=int, nargs="*", default=[0])
    parser.add_argument("--output", type=Path, required=True)
    args = parser.parse_args()
    if not __debug__:
        raise ValueError("Method comparison requires Python assertions to be enabled.")
    assert not args.output.exists(), "Retain existing comparisons and use a new directory."
    methods = [(name, Path(directory)) for name, directory in args.method]
    case, measurements = build_case(args.baseline, methods, args.prefix, args.selected)
    args.output.mkdir(parents=True)
    (args.output / "case.json").write_text(json.dumps(case, indent=2) + "\n")
    (args.output / "measurements.json").write_text(json.dumps(measurements, indent=2) + "\n")
    print(json.dumps({"methods": len(case["candidates"]), "workloads": len(case["scope"]["workloads"]),
                      "observations": len(case["observations"]), "relation": case["relation"],
                      "case": str(args.output / "case.json")}, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
