theory Factor_Binding_Guided_Investigation
  imports "Factor_Binding_Program_Compilation" "Factor_Guided_Investigation"
begin

lemma binding_observation_clause_head_scope:
  assumes clause: "((d,c),S)\<in>system_clauses binding_observation_program"
  shows "schema_variables S=pattern_variables (schema_conclusion S)"
  using clause
  by (auto simp: binding_observation_program_def binding_observation_schema_defs schema_variables_def)

theorem binding_observation_construction_head_scope:
  assumes member: "(d,S,ps)\<in>set binding_observation_construction_library"
  shows "finite_schema_head_missing S={||}"
proof -
  obtain c where clause: "((d,c),decode_finite_schema S)\<in>system_clauses binding_observation_program"
    using binding_observation_construction_clause[OF member] by blast
  have same: "schema_variables (decode_finite_schema S)=
    pattern_variables (schema_conclusion (decode_finite_schema S))"
    by (rule binding_observation_clause_head_scope[OF clause])
  show ?thesis using same
    by (auto simp: finite_schema_head_missing_def fset_inject[symmetric]
      finite_schema_variables_correct finite_pattern_variables_correct)
qed

theorem binding_observation_guided_closure_sound:
  assumes known: "image decode_finite_call_term (fset K)\<subseteq>positive_meaning binding_observation_program"
  shows "image decode_finite_call_term (finite_inference_result
    (finite_guided_rules n (if enabled then binding_observation_construction_library else []) C Q) K)
    \<subseteq>positive_meaning binding_observation_program"
  by (rule finite_guided_closure_sound)
    (use binding_observation_construction_member_sound known in \<open>auto split: if_splits\<close>)

definition binding_observation_guided_investigation where
  "binding_observation_guided_investigation n enabled C K goals=
    natural_guided_investigation n (if enabled then binding_observation_construction_library else []) C K goals"

text \<open>
  Every clause of the actual native binding program satisfies the complete
  head-scope condition. Requested-head instantiation therefore recovers every
  local instance of each clause. The bounded guided investigation still has
  to construct and settle the linked premises. Closure uses this same native
  program and retains the original known-call hypothesis.
\<close>

export_code binding_observation_guided_investigation checking SML

end
