theory Factor_Binding_Program_Compilation
  imports "Factor_Program_Library" "Factor_Binding_Observation_Clauses"
begin

definition compiled_binding_observation_program where
  "compiled_binding_observation_program=finite_system_of binding_observation_program"

lemmas compiled_binding_observation_program_code [code] =
  compiled_binding_observation_program_def[unfolded binding_observation_program_def
    finite_system_of_def finite_schema_of_def binding_observation_schema_defs
    map_relation_values_def, simplified]

lemma compiled_binding_observation_program_exact:
  "decode_finite_system compiled_binding_observation_program=binding_observation_program"
  unfolding compiled_binding_observation_program_def
  by (rule decode_finite_system_of) simp

lemma compiled_binding_observation_program_formed:
  "finite_system_formed compiled_binding_observation_program"
  by (simp only: finite_system_formed_correct compiled_binding_observation_program_exact
    binding_observation_program_formed)

definition binding_observation_construction_library ::
  "(nat\<times>(nat,nat,nat) finite_factor_schema\<times>(nat\<times>nat\<times>nat finite_term_pattern) list) list" where
  "binding_observation_construction_library=
    finite_program_construction_library compiled_binding_observation_program"

lemma binding_observation_construction_formed:
  "finite_schema_library_formed binding_observation_construction_library"
  unfolding binding_observation_construction_library_def
  by (rule finite_program_library_formed[OF compiled_binding_observation_program_formed])

theorem binding_observation_construction_member_sound:
  assumes member: "(d,S,ps)\<in>set binding_observation_construction_library"
    and rule_instance: "schema_rule_instance (decode_finite_schema S)
      (positive_meaning binding_observation_program) t"
  shows "(d,t)\<in>positive_meaning binding_observation_program"
proof -
  obtain c where clause: "((d,c),S) |\<in>| finite_system_clauses compiled_binding_observation_program"
    using member unfolding binding_observation_construction_library_def
    by (simp only: finite_program_library_member[OF compiled_binding_observation_program_formed]; blast)
  have decoded: "((d,c),decode_finite_schema S)\<in>
    system_clauses (decode_finite_system compiled_binding_observation_program)"
    using clause by (auto simp: map_relation_values_def)
  have actual: "((d,c),decode_finite_schema S)\<in>system_clauses binding_observation_program"
    using decoded by (simp only: compiled_binding_observation_program_exact)
  have interface: "(d,Pattern_Variable 0)\<in>system_interfaces binding_observation_program"
    using actual by auto
  show ?thesis
    by (rule positive_variable_clause_rule[OF binding_observation_program_formed actual interface rule_instance])
qed

text \<open>
  This library contains all seven actual clauses, including row observations
  and both empty-list clauses. Its finite source is a reduction of the complete
  native program, without a separately entered schema or dependency table.
  Complete program extraction establishes coverage of clauses, not completeness
  of any particular application-search procedure.
\<close>

export_code binding_observation_construction_library checking SML

end
