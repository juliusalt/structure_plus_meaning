 in "{\"entry\":" ^ jnat d ^ ",\"schema\":" ^ jschema s ^
 ",\"enumeration\":" ^ jlist jsymbolic ps ^ ",\"premise_missing\":" ^ jf jnat premise ^
 ",\"head_missing\":" ^ jf jnat head ^ "}" end;
fun emitBindingGaps id rows = print
 ("BINDING_GAPS_RESULT " ^ Int.toString id ^ " " ^ jlist jbindinggaps rows ^ "\n");
