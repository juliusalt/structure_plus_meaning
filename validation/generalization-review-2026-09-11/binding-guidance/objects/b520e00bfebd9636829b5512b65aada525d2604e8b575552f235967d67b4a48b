theory Factor_Requested_Applications
  imports Factor_Generation_Bindings
begin

section \<open>A requested head can supply the complete binding relation\<close>

lemma finite_matching_complete_scope:
  assumes bindings: "finite_term_bindings_formed (finite_pattern_variables p) V"
    and inst: "finite_pattern_instance V p t"
  shows "finite_matching_bindings p t=V"
proof -
  let ?M="finite_matching_bindings p t"
  let ?D="decode_finite_term_bindings"
  have native: "pattern_instance (?D V) (decode_finite_pattern p) (decode_finite_term t)"
    using inst by (simp only: finite_pattern_instance_correct)
  have subset: "?D ?M\<subseteq>?D V"
    and domain: "rel_dom (?D ?M)=pattern_variables (decode_finite_pattern p)"
    using finite_matching_bindings_complete[OF native] by blast+
  have formed: "term_bindings_formed (pattern_variables (decode_finite_pattern p)) (?D V)"
    using bindings by (simp only: finite_term_bindings_formed_correct finite_pattern_variables_correct)
  have reverse: "?D V\<subseteq>?D ?M"
  proof
    fix z assume member: "z\<in>?D V"
    obtain a x where shape: "z=(a,x)" by (cases z) auto
    have in_domain: "a\<in>rel_dom (?D ?M)"
      using member formed domain by (auto simp: shape term_bindings_formed_def rel_dom_def)
    obtain y where recovered: "(a,y)\<in>?D ?M" using in_domain by (auto simp: rel_dom_def)
    have same: "x=y"
      using subset recovered member formed
      by (auto simp: shape term_bindings_formed_def single_valued_def)
    show "z\<in>?D ?M" using recovered by (simp only: shape same)
  qed
  have equal: "?D ?M=?D V" using subset reverse by blast
  show ?thesis
  proof (rule fset_inject[THEN iffD1], rule set_eqI)
    fix z
    obtain a x where shape: "z=(a,x)" by (cases z) auto
    show "z\<in>fset ?M \<longleftrightarrow> z\<in>fset V"
      by (simp only: shape decode_finite_term_binding[symmetric] equal)
  qed
qed

definition finite_instantiated_premises where
  "finite_instantiated_premises S V=ffUnion (fimage (\<lambda>(s,d,p).
    fimage (\<lambda>t. (s,d,t)) (finite_pattern_values V p)) (finite_schema_premises S))"

lemma finite_instantiated_premises_member:
  "(s,d,t) |\<in>| finite_instantiated_premises S V \<longleftrightarrow>
    (\<exists>p. (s,d,p) |\<in>| finite_schema_premises S \<and> finite_pattern_instance V p t)"
  by (auto simp: finite_instantiated_premises_def finite_pattern_values_exact; force)

lemma finite_schema_instance_premise_iff:
  assumes inst: "finite_schema_instance S V t H"
  shows "(s,d,u) |\<in>| H \<longleftrightarrow>
    (\<exists>p. (s,d,p) |\<in>| finite_schema_premises S \<and> finite_pattern_instance V p u)"
proof -
  have native: "schema_instance (decode_finite_schema S) (decode_finite_term_bindings V)
    (decode_finite_term t) (decode_finite_premises H)"
    using inst by (simp only: finite_schema_instance_correct)
  show ?thesis
    using schema_instance_premise_iff[OF native, of s d "decode_finite_term u"]
    by (auto simp: decode_finite_premises_def decode_finite_call_pattern_def
      map_relation_values_def finite_pattern_instance_correct)
qed

lemma finite_instantiated_premises_exact:
  assumes inst: "finite_schema_instance S V t H"
  shows "finite_instantiated_premises S V=H"
proof (rule fset_inject[THEN iffD1], rule set_eqI)
  fix z
  obtain s d x where shape: "z=(s,d,x)" by (cases z) auto
  show "z\<in>fset (finite_instantiated_premises S V) \<longleftrightarrow> z\<in>fset H"
    by (simp only: shape finite_instantiated_premises_member finite_schema_instance_premise_iff[OF inst])
qed

definition finite_requested_schema_applications where
  "finite_requested_schema_applications S t=
    (let V=finite_matching_bindings (finite_schema_conclusion S) t;
         H=finite_instantiated_premises S V
     in if finite_schema_instance S V t H \<and> finite_schema_material_satisfied S V
        then {|(t,V,H)|} else {||})"

lemma finite_requested_schema_application_sound:
  assumes generated: "(t,V,H) |\<in>| finite_requested_schema_applications S q"
  shows "t=q" "finite_schema_instance S V t H" "finite_schema_material_satisfied S V"
  using generated by (auto simp: finite_requested_schema_applications_def Let_def split: if_splits)

lemma finite_schema_instance_head_bindings:
  assumes inst: "finite_schema_instance S V t H"
    and covered: "finite_schema_head_missing S={||}"
  shows "finite_matching_bindings (finite_schema_conclusion S) t=V"
proof -
  have scope: "finite_schema_variables S=finite_pattern_variables (finite_schema_conclusion S)"
    using covered by (auto simp: finite_schema_head_missing_def finite_schema_variables_def)
  have bindings: "finite_term_bindings_formed (finite_pattern_variables (finite_schema_conclusion S)) V"
    and head: "finite_pattern_instance V (finite_schema_conclusion S) t"
    using inst by (auto simp: finite_schema_instance_def scope)
  show ?thesis by (rule finite_matching_complete_scope[OF bindings head])
qed

theorem finite_requested_schema_applications_exact:
  assumes covered: "finite_schema_head_missing S={||}"
  shows "(t,V,H) |\<in>| finite_requested_schema_applications S t \<longleftrightarrow>
    finite_schema_instance S V t H \<and> finite_schema_material_satisfied S V"
proof
  assume "(t,V,H) |\<in>| finite_requested_schema_applications S t"
  then show "finite_schema_instance S V t H \<and> finite_schema_material_satisfied S V"
    using finite_requested_schema_application_sound by blast
next
  assume valid: "finite_schema_instance S V t H \<and> finite_schema_material_satisfied S V"
  have bindings: "finite_matching_bindings (finite_schema_conclusion S) t=V"
    by (rule finite_schema_instance_head_bindings[OF conjunct1[OF valid] covered])
  have body: "finite_instantiated_premises S V=H"
    by (rule finite_instantiated_premises_exact[OF conjunct1[OF valid]])
  show "(t,V,H) |\<in>| finite_requested_schema_applications S t"
    using valid by (simp only: finite_requested_schema_applications_def Let_def bindings body) simp
qed

text \<open>
  The requested term supplies bindings, not semantic evidence. Every complete
  schema instance and material condition is checked before an application is
  returned. The premise family is constructed from the schema itself, retaining
  every original socket and callee. For schemas whose heads cover their entire
  variable scope, the application account is exact on every finite term.
  Variables absent from the head are not assigned arbitrary values.
\<close>

export_code finite_requested_schema_applications checking SML

end
