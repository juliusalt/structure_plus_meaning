theory Factor_Generation_Monotonicity
  imports "Factor_Set_Frontier_Generation"
begin

lemma finite_premise_set_joins_mono:
  assumes included: "C |\<subseteq>| D"
  shows "finite_premise_set_joins ps C |\<subseteq>| finite_premise_set_joins ps D"
proof (induction ps)
  case Nil
  then show ?case by simp
next
  case (Cons z ps)
  obtain s d p where shape: "z=(s,d,p)" by (cases z) auto
  show ?case using Cons.IH included
    apply (auto simp: shape ffUnion_membership fimage_iff Bex_def split_paired_Ex)
    subgoal for aa ba bb
      apply (rule exI[of _ aa], rule exI[of _ ba])
      using Cons.IH included
      by (auto simp: image_iff intro!: bexI[where x="(d,bb)"])
    done
qed

theorem finite_schema_generation_on_set_mono:
  assumes included: "C |\<subseteq>| D"
  shows "finite_schema_generation_on_set S ps C |\<subseteq>| finite_schema_generation_on_set S ps D"
  using finite_premise_set_joins_mono[OF included, where ps=ps]
  apply (auto simp: finite_schema_generation_on_set_def ffUnion_membership
    fimage_iff Bex_def split_paired_Ex)
  subgoal for ab ba x
    apply (rule exI[of _ ab], rule exI[of _ ba])
    by (auto simp: image_iff intro!: bexI[where x=x])
  done

lemma finite_generated_application_on_set:
  "(d,S,t,V,H) |\<in>| finite_generated_applications_on_set L C \<longleftrightarrow>
    (\<exists>ps. (d,S,ps)\<in>set L \<and> (t,V,H) |\<in>| finite_schema_generation_on_set S ps C)"
proof -
  obtain cs where enumeration: "fset_of_list cs=C" using exists_fset_of_list by blast
  show ?thesis
    by (simp only: enumeration[symmetric] finite_generated_applications_on_lists
      finite_schema_generation_on_lists finite_generated_schema_application)
qed

theorem finite_generated_applications_on_set_mono:
  assumes included: "C |\<subseteq>| D"
  shows "finite_generated_applications_on_set L C |\<subseteq>| finite_generated_applications_on_set L D"
  unfolding less_eq_fset.rep_eq
proof
  fix z assume member: "z\<in>fset (finite_generated_applications_on_set L C)"
  obtain d S t V H where shape: "z=(d,S,t,V,H)" by (cases z) auto
  obtain ps where source: "(d,S,ps)\<in>set L"
    and generated: "(t,V,H) |\<in>| finite_schema_generation_on_set S ps C"
    using member by (simp only: shape finite_generated_application_on_set; blast)
  have retained: "(t,V,H) |\<in>| finite_schema_generation_on_set S ps D"
    using finite_schema_generation_on_set_mono[OF included] generated by auto
  show "z\<in>fset (finite_generated_applications_on_set L D)"
    using source retained by (simp only: shape finite_generated_application_on_set; blast)
qed

lemma finite_generated_conclusion_image:
  "fimage fst (finite_generated_rules_on_set L C)=
    fimage (\<lambda>(d,S,t,V,H). (d,t)) (finite_generated_applications_on_set L C)"
  by (simp add: finite_generated_rules_on_set_def fimage_fimage split_def comp_def)

text \<open>
  Enlarging the possible frontier retains every complete generated application.
  Matching agreement, complete premise enumerations, all material checks, and
  complete bindings remain the same tests on an existing application. This
  monotonicity concerns possible constructions; it establishes no new known
  call and assumes no semantic truth for the enlarged frontier.
\<close>

end
