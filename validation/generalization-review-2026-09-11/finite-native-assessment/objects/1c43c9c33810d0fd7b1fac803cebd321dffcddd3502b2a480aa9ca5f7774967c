import concurrent.futures,json,os,subprocess,sys
from pathlib import Path
root=Path('/home/julius/structure_and_semantics')
archive=root/'validation/generalization-review-2026-09-11/finite-native-reader'
index=json.loads((archive/'index.json').read_text())
out=Path('/tmp/finite-native-replays');out.mkdir()
tasks=[('stage',n) for n in index['runs']]+[('investigation',n) for n in index['investigations']]
poly='/opt/isabelle/contrib/polyml-5.9.2-2/x86_64-linux/poly'
def run(task):
 kind,name=task;label=kind+'--'+name
 command=[sys.executable,str(root/'tools/replay_reasoning_review.py'),'--archive',str(archive),'--'+kind,name,'--poly',poly,'--output',str(out/label)]
 with (out/(label+'.log')).open('w') as log:
  result=subprocess.run(command,stdout=log,stderr=subprocess.STDOUT,env={**os.environ,'PYTHONDONTWRITEBYTECODE':'1'})
 record={'kind':kind,'name':name,'exit_code':result.returncode,'output':str(out/label),'log':str(out/(label+'.log'))}
 if result.returncode: print(json.dumps(record),flush=True)
 return record
results=[]
with concurrent.futures.ThreadPoolExecutor(max_workers=4) as pool:
 for future in concurrent.futures.as_completed([pool.submit(run,t) for t in tasks]):
  results.append(future.result())
  if len(results)%10==0 or len(results)==len(tasks):print('Completed '+str(len(results))+'/'+str(len(tasks)),flush=True)
summary={'status':'accepted' if all(r['exit_code']==0 for r in results) else 'failed','stages':len(index['runs']),'investigations':len(index['investigations']),'results':results}
(out/'summary.json').write_text(json.dumps(summary,indent=2)+'\n')
print(json.dumps({k:v for k,v in summary.items() if k!='results'}),flush=True)
sys.exit(0 if summary['status']=='accepted' else 1)
