theory RRA_Finite_Environments
  imports RRA_Finite_Artifacts RRA_Environment
begin

section \<open>Exact targets as complete finite inputs\<close>

datatype finite_exact_target =
    Finite_Whole finite_exact_artifact
  | Finite_Anchor finite_exact_artifact local_address

fun decode_finite_target :: "finite_exact_target \<Rightarrow> exact_target" where
  "decode_finite_target (Finite_Whole C) = Whole_Artifact (decode_finite_object C)"
| "decode_finite_target (Finite_Anchor C a) = Occurrence_Anchor (decode_finite_object C,a)"

fun finite_target_of :: "exact_target \<Rightarrow> finite_exact_target" where
  "finite_target_of (Whole_Artifact R) = Finite_Whole (finite_object_of R)"
| "finite_target_of (Occurrence_Anchor (R,a)) = Finite_Anchor (finite_object_of R) a"

fun finite_target_formed :: "finite_exact_target \<Rightarrow> bool" where
  "finite_target_formed (Finite_Whole C) = finite_exact_formed C"
| "finite_target_formed (Finite_Anchor C a) =
    (finite_exact_formed C \<and> a |\<in>| finite_carrier (finite_structure C))"

lemma finite_target_formed_correct:
  "finite_target_formed C \<longleftrightarrow> target_formed (decode_finite_target C)"
  by (cases C) (simp_all add: finite_exact_formed_correct anchor_formed_def
      decode_finite_object_def decode_finite_structure_def)

lemma decode_finite_target_injective [simp]:
  "decode_finite_target C = decode_finite_target D \<longleftrightarrow> C = D"
  by (cases C; cases D) auto

lemma finite_target_of_decode [simp]:
  "finite_target_of (decode_finite_target C) = C"
  by (cases C) auto

lemma decode_finite_target_of:
  assumes "target_formed t"
  shows "decode_finite_target (finite_target_of t) = t"
  using assms by (cases t) (auto simp: anchor_formed_def exact_formed_def
      decode_finite_object_of split: prod.splits)

section \<open>Complete finite artifact environments\<close>

record 'u finite_artifact_environment =
  finite_environment_artifacts :: "('u \<times> finite_exact_artifact) fset"
  finite_environment_bindings :: "(('u \<times> local_address) \<times> 'u) fset"

definition decode_finite_environment ::
  "'u finite_artifact_environment \<Rightarrow> 'u artifact_environment" where
  "decode_finite_environment C =
    \<lparr>environment_artifacts =
       map_relation_values decode_finite_object (fset (finite_environment_artifacts C)),
     environment_bindings = fset (finite_environment_bindings C)\<rparr>"

definition finite_enumerated_environment ::
  "('u\<times>finite_exact_artifact) list \<Rightarrow>
    (('u\<times>local_address)\<times>'u) list \<Rightarrow> 'u finite_artifact_environment" where
  "finite_enumerated_environment A B =
    \<lparr>finite_environment_artifacts=fset_of_list A,
      finite_environment_bindings=fset_of_list B\<rparr>"

lemma decode_finite_enumerated_environment [simp]:
  "decode_finite_environment (finite_enumerated_environment A B) =
    \<lparr>environment_artifacts=map_relation_values decode_finite_object (set A),
      environment_bindings=set B\<rparr>"
  by (simp add: finite_enumerated_environment_def decode_finite_environment_def)

definition finite_environment_formed :: "'u finite_artifact_environment \<Rightarrow> bool" where
  "finite_environment_formed C \<longleftrightarrow>
    finite_relation_functional (finite_environment_artifacts C) \<and>
    fBall (finite_environment_artifacts C) (\<lambda>(u,R). finite_exact_formed R) \<and>
    finite_relation_functional (finite_environment_bindings C) \<and>
    fBall (finite_environment_bindings C) (\<lambda>((u,k),v).
      fBex (finite_environment_artifacts C)
        (\<lambda>(w,R). w=u \<and> k |\<in>| finite_carrier (finite_structure R)) \<and>
      v |\<in>| fimage fst (finite_environment_artifacts C))"

lemma decode_finite_environment_fields [simp]:
  "environment_artifacts (decode_finite_environment C) =
    map_relation_values decode_finite_object (fset (finite_environment_artifacts C))"
  "environment_bindings (decode_finite_environment C) = fset (finite_environment_bindings C)"
  by (simp_all add: decode_finite_environment_def)

lemma decode_finite_environment_entry [simp]:
  "artifact_at (decode_finite_environment C) u R \<longleftrightarrow>
    (\<exists>A. (u,A) |\<in>| finite_environment_artifacts C \<and> R = decode_finite_object A)"
  by (simp add: artifact_at_def)

lemma decode_finite_environment_slot:
  "(\<exists>R. artifact_at (decode_finite_environment C) u R \<and>
    k \<in> rra_carrier (object_structure R)) \<longleftrightarrow>
    (\<exists>A. (u,A) |\<in>| finite_environment_artifacts C \<and>
      k |\<in>| finite_carrier (finite_structure A))"
  by auto

lemma finite_environment_formed_components:
  "finite_environment_formed C \<longleftrightarrow>
    single_valued (fset (finite_environment_artifacts C)) \<and>
    (\<forall>u R. (u,R) |\<in>| finite_environment_artifacts C \<longrightarrow> finite_exact_formed R) \<and>
    single_valued (fset (finite_environment_bindings C)) \<and>
    (\<forall>u k v. ((u,k),v) |\<in>| finite_environment_bindings C \<longrightarrow>
      (\<exists>R. (u,R) |\<in>| finite_environment_artifacts C \<and>
        k |\<in>| finite_carrier (finite_structure R)) \<and>
      v \<in> fst ` fset (finite_environment_artifacts C))"
  by (simp add: finite_environment_formed_def finite_relation_functional_correct
      fimage.rep_eq Ball_def Bex_def split_paired_All split_paired_Ex)

lemma finite_environment_formed_correct:
  "finite_environment_formed C \<longleftrightarrow>
    environment_formed (decode_finite_environment C)"
proof -
  have injective: "inj (decode_finite_object :: finite_exact_artifact \<Rightarrow> exact_artifact)"
    by (auto simp: inj_def)
  have artifacts: "(\<forall>u R. artifact_at (decode_finite_environment C) u R \<longrightarrow> exact_formed R) \<longleftrightarrow>
    (\<forall>u A. (u,A) |\<in>| finite_environment_artifacts C \<longrightarrow> finite_exact_formed A)"
    by (auto simp: finite_exact_formed_correct)
  show ?thesis
    by (simp del: decode_finite_environment_entry
        add: finite_environment_formed_components environment_formed_def
        map_relation_values_functional[OF injective] artifacts
        binds_slot_def environment_uses_def rel_dom_image decode_finite_environment_slot)
qed

lemma decode_finite_environment_injective [simp]:
  "decode_finite_environment C = decode_finite_environment D \<longleftrightarrow> C = D"
proof -
  have injective: "inj (decode_finite_object :: finite_exact_artifact \<Rightarrow> exact_artifact)"
    by (auto simp: inj_def)
  show ?thesis
    by (cases C; cases D)
      (simp add: decode_finite_environment_def map_relation_values_injective[OF injective] fset_inject)
qed

definition finite_environment_of ::
  "'u artifact_environment \<Rightarrow> 'u finite_artifact_environment" where
  "finite_environment_of E =
    \<lparr>finite_environment_artifacts =
       Abs_fset ((\<lambda>(u,R). (u,finite_object_of R)) ` environment_artifacts E),
     finite_environment_bindings = Abs_fset (environment_bindings E)\<rparr>"

lemma decode_finite_environment_of:
  assumes formed: "environment_formed E"
  shows "decode_finite_environment (finite_environment_of E) = E"
proof -
  have art: "finite (environment_artifacts E)" and binding: "finite (environment_bindings E)"
    using formed by (auto simp: environment_formed_def)
  let ?enc = "\<lambda>(u,R). (u,finite_object_of R)"
  let ?dec = "\<lambda>(u,C). (u,decode_finite_object C)"
  have inverse: "\<And>x. x \<in> environment_artifacts E \<Longrightarrow> ?dec (?enc x) = x"
  proof -
    fix x assume member: "x \<in> environment_artifacts E"
    obtain u R where x: "x=(u,R)" by (cases x) auto
    have rf: "object_formed R" using formed member x
      by (auto simp: environment_formed_def artifact_at_def exact_formed_def)
    show "?dec (?enc x) = x" using decode_finite_object_of[OF rf] by (simp add: x)
  qed
  have image: "?dec ` ?enc ` environment_artifacts E = id ` environment_artifacts E"
    unfolding image_image by (rule image_cong) (use inverse in auto)
  have af: "finite (?enc ` environment_artifacts E)" using art by simp
  have a: "fset (Abs_fset (?enc ` environment_artifacts E)) = ?enc ` environment_artifacts E"
    by (rule Abs_fset_inverse) (simp add: af)
  have b: "fset (Abs_fset (environment_bindings E)) = environment_bindings E"
    by (rule Abs_fset_inverse) (simp add: binding)
  show ?thesis
    using image a b by (cases E)
      (simp add: decode_finite_environment_def finite_environment_of_def map_relation_values_def)
qed

theorem finite_environment_representation:
  assumes "environment_formed E"
  shows "\<exists>!C. finite_environment_formed C \<and> decode_finite_environment C = E"
proof -
  have decode: "decode_finite_environment (finite_environment_of E) = E"
    by (rule decode_finite_environment_of[OF assms])
  have formed: "finite_environment_formed (finite_environment_of E)"
    using assms by (simp add: finite_environment_formed_correct decode)
  show ?thesis
    by (rule ex1I[of _ "finite_environment_of E"]) (use decode formed in auto)
qed

export_code finite_target_formed finite_environment_formed checking SML

text \<open>
  Every artifact and every binding is supplied in the finite input. Formation
  checks both source-slot membership and target-use existence. Equal artifacts
  at distinct uses retain their distinct placements and outgoing bindings.
  The decoder changes the implementation representation of values, without
  resolving names or consulting an external artifact store.
\<close>

end
