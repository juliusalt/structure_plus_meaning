theory Factor_Finite_Inference_Source_Checks
  imports Factor_Finite_Inference_Sources Factor_Closed_Native_Definitions
begin

section \<open>Retain separate component certificates before package composition\<close>

lemma finite_literal_environment_checks:
  "finite_environment_formed (finite_literal_sources [])"
  "finite_environment_formed (finite_literal_extension [])"
  by code_simp+

lemma finite_literal_binder_check:
  "finite_binder_scope_at (finite_literal_artifact []) [3] {||}"
  by code_simp

lemma finite_literal_environments_formed:
  "environment_formed (decode_finite_environment (finite_literal_sources []))"
  "environment_formed (decode_finite_environment (finite_literal_extension []))"
  using finite_literal_environment_checks
  by (auto simp: finite_environment_formed_correct)

lemma finite_literal_binder:
  "binder_scope_at (decode_finite_object (finite_literal_artifact [])) [3] {}"
  using finite_literal_binder_check
  by (simp add: finite_binder_scope_at_correct)

lemma finite_literal_artifact_at:
  "artifact_at (decode_finite_environment (finite_literal_sources p)) None
    (decode_finite_object (finite_literal_artifact p))"
  by (simp add: finite_literal_sources_def finite_enumerated_environment_def fset_of_list.rep_eq)

lemma finite_literal_records_check:
  "finite_record_at (finite_literal_artifact []) [1] [[17],[18]] [[2],[6]]"
  "finite_record_at (finite_literal_artifact []) [2] [[19],[20]] [[3],[5]]"
  "finite_record_at (finite_literal_artifact []) [8] [[21],[22],[23]] [[3],[5],[14]]"
  by code_simp+

lemma finite_literal_families_check:
  "finite_family_at (finite_literal_artifact []) [6] {|([7],[8])|}"
  "finite_family_at (finite_literal_artifact []) [14] {||}"
  by code_simp+

lemma finite_literal_payload_check:
  "finite_payload_leaf_at (finite_literal_artifact []) [5] []"
  by code_simp

lemma finite_literal_pattern:
  "pattern_quoted_at (decode_finite_environment (finite_literal_sources [])) None {} [5]
    (Pattern_Payload []) {[5]} {}"
proof -
  have leaf: "payload_leaf_at (decode_finite_object (finite_literal_artifact [])) [5] []"
    using finite_literal_payload_check by (simp only: finite_payload_leaf_at_correct)
  have payload_read: "term_quoted_at (decode_finite_environment (finite_literal_sources [])) None [5]
    (Payload_Term []) {[5]} {}"
    by (rule term_quoted_at.payload[OF finite_literal_environments_formed(1)
      finite_literal_artifact_at leaf])
  show ?thesis by (rule pattern_quoted_at.payload[OF payload_read]) simp
qed

lemma finite_literal_native_schema_composed:
  "native_schema_at (decode_finite_environment (finite_literal_sources [])) None [8]
    (decode_finite_schema (finite_literal_schema []))"
proof -
  let ?E="decode_finite_environment (finite_literal_sources [])"
  let ?R="decode_finite_object (finite_literal_artifact [])"
  have rec: "record_at ?R [8] [[21],[22],[23]] [[3],[5],[14]]"
    using finite_literal_records_check(3) by (simp only: finite_record_at_correct)
  have family: "family_at ?R [14] {}"
    using finite_literal_families_check(2) by (simp add: finite_family_at_correct)
  have body: "prospective_family_at ?E None {} [14] {}"
    unfolding prospective_family_at_def
    by (rule conjI[OF finite_literal_environments_formed(1)], rule exI[of _ ?R], rule exI[of _ "{}"])
      (use family finite_literal_artifact_at in \<open>simp add: single_valued_def rel_dom_def\<close>)
  show ?thesis unfolding native_schema_at_def
    by (rule conjI[OF finite_literal_environments_formed(1)], rule exI[of _ ?R],
      rule exI[of _ "[[21],[22],[23]]"], rule exI[of _ "[3]"], rule exI[of _ "[5]"],
      rule exI[of _ "[14]"], rule exI[of _ "{}"], rule exI[of _ "{[5]}"], rule exI[of _ "{}"])
      (use finite_literal_artifact_at rec finite_literal_binder finite_literal_pattern body in
        \<open>simp add: finite_literal_schema_def decode_finite_schema_def map_relation_values_def
          schema_variables_def native_premise_family_calls_only\<close>)
qed

lemma finite_literal_native_definition_composed:
  "native_definition_at (decode_finite_environment (finite_literal_sources [])) None [1]
    (Pattern_Payload []) {([7],decode_finite_schema (finite_literal_schema []))}"
proof -
  let ?E="decode_finite_environment (finite_literal_sources [])"
  let ?R="decode_finite_object (finite_literal_artifact [])"
  have rec: "record_at ?R [1] [[17],[18]] [[2],[6]]"
    "record_at ?R [2] [[19],[20]] [[3],[5]]"
    using finite_literal_records_check(1,2) by (simp_all only: finite_record_at_correct)
  have scope: "scoped_pattern_at ?E None [2] (Pattern_Payload []) {[2],[19],[20],[3],[5]} {}"
    unfolding scoped_pattern_at_def
    by (rule conjI[OF finite_literal_environments_formed(1)], rule exI[of _ ?R],
      rule exI[of _ "[[19],[20]]"], rule exI[of _ "[3]"], rule exI[of _ "[5]"],
      rule exI[of _ "{}"], rule exI[of _ "{[5]}"])
      (use finite_literal_artifact_at rec(2) finite_literal_binder finite_literal_pattern in auto)
  have family: "family_at ?R [6] {([7],[8])}"
    using finite_literal_families_check(1) by (simp add: finite_family_at_correct)
  have clauses: "native_schema_family_at ?E None [6] {([7],decode_finite_schema (finite_literal_schema []))}"
    unfolding native_schema_family_at_def
    by (rule conjI[OF finite_literal_environments_formed(1)], rule exI[of _ ?R],
      rule exI[of _ "{([7],[8])}"])
      (use finite_literal_artifact_at family finite_literal_native_schema_composed in
        \<open>auto simp: single_valued_def rel_dom_def\<close>)
  show ?thesis unfolding native_definition_at_def
    by (rule conjI[OF finite_literal_environments_formed(1)], rule exI[of _ ?R],
      rule exI[of _ "[[17],[18]]"], rule exI[of _ "[2]"], rule exI[of _ "[6]"],
      rule exI[of _ "{[2],[19],[20],[3],[5]}"], rule exI[of _ "{}"])
      (use finite_literal_artifact_at rec(1) scope clauses in auto)
qed

lemma finite_literal_schema_check:
  "finite_literal_schema [] |\<in>| finite_native_schema_readings (finite_literal_sources []) None [8]"
  using finite_literal_native_schema_composed
  by (simp only: finite_native_schema_readings_correct)

lemma finite_literal_definition_check:
  "(Finite_Pattern_Payload [],{|([7],finite_literal_schema [])|}) |\<in>|
    finite_native_definition_readings (finite_literal_sources []) None [1]"
  using finite_literal_native_definition_composed
  by (simp add: finite_native_definition_readings_correct map_relation_values_def)

lemma finite_literal_root_check:
  "{|([16],None,[1])|} |\<in>| finite_native_root_family_readings (finite_literal_sources []) None [0]"
  by code_simp

lemma finite_literal_node_check:
  "((Finite_Inference (None,[7]) {||},{||}),fset_of_list finite_literal_node_interior,{|[6]|}) |\<in>|
    finite_proof_node_readings (finite_literal_extension []) (Some []) []"
  by code_simp

lemma finite_literal_package_composed:
  "native_package_at (decode_finite_environment (finite_literal_sources [])) None [0]
    (decode_finite_system (finite_literal_program []))"
proof -
  let ?E="decode_finite_environment (finite_literal_sources [])"
  let ?S="decode_finite_schema (finite_literal_schema [])"
  let ?G="{((None,[1]),Pattern_Payload [],{([7],?S)})}"
  have ef: "environment_formed ?E"
    using finite_literal_environment_checks(1) by (simp only: finite_environment_formed_correct)
  have native_read: "native_definition_at ?E None [1] (Pattern_Payload []) {([7],?S)}"
    using finite_literal_definition_check
    by (simp add: finite_native_definition_readings_correct map_relation_values_def)
  have formed: "native_package_formed ?E {(None,[1])}"
    and graph: "native_definition_graph ?E {(None,[1])}=?G"
    using native_closed_definition_graph[OF ef, where G="?G"] native_read
    by (auto simp: rel_dom_def schema_dependencies_def finite_literal_schema_def
      decode_finite_schema_def map_relation_values_def rel_ran_def)
  have program: "native_program ?E {(None,[1])}=decode_finite_system (finite_literal_program [])"
    by (auto simp: native_program_def graph finite_literal_program_def
      decode_finite_system_def map_relation_values_def)
  have roots: "native_root_family_at ?E None [0] {([16],None,[1])}"
    using finite_literal_root_check by (simp add: finite_native_root_family_readings_correct)
  show ?thesis unfolding native_package_at_def
    by (rule exI[of _ "{([16],None,[1])}"])
      (use roots formed program in \<open>auto simp: rel_ran_def\<close>)
qed

lemma finite_literal_native_checks_closed:
  "finite_literal_native_checks [] = [True,True,True,True,True,True]"
  using finite_literal_environment_checks finite_literal_binder_check finite_literal_schema_check
    finite_literal_node_check finite_literal_package_composed
  by (simp add: finite_literal_native_checks_def finite_native_package_readings_correct)

lemma finite_literal_native_schema:
  "native_schema_at (decode_finite_environment (finite_literal_sources [])) None [8]
    (decode_finite_schema (finite_literal_schema []))"
  using finite_literal_native_checks_closed
  by (simp add: finite_literal_native_checks_def finite_native_schema_readings_correct)

lemma finite_literal_native_package:
  "native_package_at (decode_finite_environment (finite_literal_sources [])) None [0]
    (decode_finite_system (finite_literal_program []))"
  using finite_literal_native_checks_closed
  by (simp add: finite_literal_native_checks_def finite_native_package_readings_correct)

lemma finite_literal_native_node:
  "native_proof_node_at (decode_finite_environment (finite_literal_extension [])) (Some []) []
    (Schema_Inference (None,[7]) {||}) {} (set finite_literal_node_interior) {[6]}"
  using finite_literal_native_checks_closed
  by (simp add: finite_literal_native_checks_def finite_proof_node_readings_correct
    decode_finite_binding_set_def fset_of_list.rep_eq)

end
