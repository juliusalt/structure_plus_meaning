  Rra_structure_ext of 'a set * ('a * ('a * 'a)) set * 'b;

datatype ('a, 'b, 'c) opaque_basis_ext =
  Opaque_basis_ext of ('a * 'b -> nat) * ('a * 'b) set * 'c;

datatype ('a, 'b, 'c) structured_object_ext =
  Structured_object_ext of
    ('a, unit) rra_structure_ext * ('a, 'b, unit) opaque_basis_ext * 'c;

datatype exact_target =
  Whole_Artifact of ((nat list), (nat list), unit) structured_object_ext |
