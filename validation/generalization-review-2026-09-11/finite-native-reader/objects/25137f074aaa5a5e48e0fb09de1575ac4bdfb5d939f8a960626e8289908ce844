    (((nat list), (nat list), unit) structured_object_ext * nat list);

datatype factor_term = Target_Term of exact_target | Payload_Term of nat list |
  Pair_Term of factor_term * factor_term;

datatype finite_exact_target =
  Finite_Whole of ((nat list), (nat list), unit) finite_structured_object_ext |
