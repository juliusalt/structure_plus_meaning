fun equal_optiona A_ NONE (SOME x2) = false
  | equal_optiona A_ (SOME x2) NONE = false
  | equal_optiona A_ (SOME x2) (SOME y2) = eq A_ x2 y2
  | equal_optiona A_ NONE NONE = true;

fun equal_option A_ = {equal = equal_optiona A_} : ('a option) equal;

fun less_eq_option A_ NONE x = true
  | less_eq_option A_ (SOME x) NONE = false
  | less_eq_option A_ (SOME x) (SOME y) = less_eq (ord_preorder A_) x y;

fun less_option A_ x NONE = false
  | less_option A_ NONE (SOME x) = true
  | less_option A_ (SOME x) (SOME y) = less (ord_preorder A_) x y;

fun ord_option A_ = {less_eq = less_eq_option A_, less = less_option A_} :
  ('a option) ord;

fun preorder_option A_ = {ord_preorder = ord_option A_} : ('a option) preorder;

fun order_option A_ = {preorder_order = preorder_option (preorder_order A_)} :
