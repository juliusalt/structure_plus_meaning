fun id x = (fn xa => xa) x;

fun list_ex p [] = false
  | list_ex p (x :: xs) = p x orelse list_ex p xs;

fun bex (Set xs) p = list_ex p xs;

fun nth (x :: xs) Zero_nat = x
  | nth (x :: xs) (Suc n) = nth xs n;

fun ball (Set xs) p = list_all p xs;

fun fold f [] s = s
  | fold f (x :: xs) s = fold f xs (f x s);

fun map f [] = []
  | map f (x21 :: x22) = f x21 :: map f x22;

fun image f (Set xs) = Set (map f xs);

fun fimage xb xc = Abs_fset (image xb (fset xc));

fun remdups A_ [] = []
  | remdups A_ (x :: xs) =
    (if membera A_ xs x then remdups A_ xs else x :: remdups A_ xs);

fun plus_nat Zero_nat n = n
  | plus_nat (Suc m) n = plus_nat m (Suc n);

val one_nat : nat = Suc Zero_nat;

fun nat_of_num One = one_nat
  | nat_of_num (Bit0 n) = let
                            val m = nat_of_num n;
                          in
                            plus_nat m m
                          end
  | nat_of_num (Bit1 n) = let
                            val m = nat_of_num n;
                          in
                            Suc (plus_nat m m)
                          end;

