fun fst (x1, x2) = x1;

fun snd (x1, x2) = x2;

fun octets_formed xs =
  list_all
    (fn x =>
      less_nat x
        (nat_of_num
          (Bit0 (Bit0 (Bit0 (Bit0 (Bit0 (Bit0 (Bit0 (Bit0 One))))))))))
    xs;

fun count A_ (Mset xs) x =
  fold (fn y => (if eq A_ x y then Suc else id)) xs Zero_nat;

fun minus_nat m Zero_nat = m
  | minus_nat Zero_nat n = Zero_nat
  | minus_nat (Suc m) (Suc n) = minus_nat m n;

fun divmod_nat m n =
  (if equal_nata n Zero_nat orelse less_nat m n then (Zero_nat, m)
    else let
           val (q, a) = divmod_nat (minus_nat m n) n;
         in
           (Suc q, a)
         end);

fun divide_nat m n = fst (divmod_nat m n);

fun size_list xs = length_tailrec xs Zero_nat;

fun part B_ f pivot [] = ([], ([], []))
  | part B_ f pivot (x :: xs) =
    let
      val (lts, (eqs, gts)) = part B_ f pivot xs;
      val xa = f x;
    in
      (if less ((ord_preorder o preorder_order o order_linorder) B_) xa pivot
        then (x :: lts, (eqs, gts))
        else (if less ((ord_preorder o preorder_order o order_linorder) B_)
                   pivot xa
               then (lts, (eqs, x :: gts)) else (lts, (x :: eqs, gts))))
    end;

fun sort_key B_ f xs =
  (case xs of [] => [] | [_] => xs
    | [x, y] =>
      (if less_eq ((ord_preorder o preorder_order o order_linorder) B_) (f x)
            (f y)
        then xs else [y, x])
    | _ :: _ :: _ :: _ =>
      let
        val (lts, (eqs, gts)) =
          part B_ f
            (f (nth xs (divide_nat (size_list xs) (nat_of_num (Bit0 One))))) xs;
      in
        sort_key B_ f lts @ eqs @ sort_key B_ f gts
      end);

fun sorted_list_of_set (A1_, A2_) (Set xs) =
  sort_key A2_ (fn x => x) (remdups A1_ xs);

fun sorted_list_of_fset (A1_, A2_) xa = sorted_list_of_set (A1_, A2_) (fset xa);

fun map_option f NONE = NONE
  | map_option f (SOME x2) = SOME (f x2);

val bot_set : 'a set = Set [];

fun divmod_integer k l =
  (if ((k : IntInf.int) = (0 : IntInf.int))
    then ((0 : IntInf.int), (0 : IntInf.int))
    else (if IntInf.< ((0 : IntInf.int), l)
           then (if IntInf.< ((0 : IntInf.int), k)
                  then IntInf.divMod (IntInf.abs k, IntInf.abs l)
                  else let
                         val (r, s) =
                           IntInf.divMod (IntInf.abs k, IntInf.abs l);
                       in
                         (if ((s : IntInf.int) = (0 : IntInf.int))
                           then (IntInf.~ r, (0 : IntInf.int))
                           else (IntInf.- (IntInf.~ r, (1 : IntInf.int)),
                                  IntInf.- (l, s)))
                       end)
           else (if ((l : IntInf.int) = (0 : IntInf.int))
                  then ((0 : IntInf.int), k)
                  else apsnd IntInf.~
                         (if IntInf.< (k, (0 : IntInf.int))
                           then IntInf.divMod (IntInf.abs k, IntInf.abs l)
                           else let
                                  val (r, s) =
                                    IntInf.divMod (IntInf.abs k, IntInf.abs l);
                                in
                                  (if ((s : IntInf.int) = (0 : IntInf.int))
                                    then (IntInf.~ r, (0 : IntInf.int))
                                    else (IntInf.- (IntInf.~
              r, (1 : IntInf.int)),
   IntInf.- (IntInf.~ l, s)))
                                end))));

fun of_nat_aux A_ inc Zero_nat i = i
  | of_nat_aux A_ inc (Suc n) i = of_nat_aux A_ inc n (inc i);

fun of_nat A_ n =
  of_nat_aux A_
    (fn i =>
      plus ((plus_semigroup_add o semigroup_add_numeral o
              numeral_semiring_numeral o semiring_numeral_semiring_1)
             A_)
        i (one ((one_numeral o numeral_semiring_numeral o
                  semiring_numeral_semiring_1)
                 A_)))
    n (zero ((zero_mult_zero o mult_zero_semiring_0 o semiring_0_semiring_1)
              A_));

fun integer_of_nat x = of_nat semiring_1_integer x;

fun nat_of_integer k =
  (if IntInf.<= (k, (0 : IntInf.int)) then Zero_nat
    else let
           val (l, j) = divmod_integer k (2 : IntInf.int);
           val la = nat_of_integer l;
           val lb = plus_nat la la;
         in
           (if ((j : IntInf.int) = (0 : IntInf.int)) then lb
             else plus_nat lb one_nat)
         end);

val bot_fset : 'a fset = Abs_fset bot_set;

fun address_pair_data z =
  Pair_Term (Payload_Term (fst z), Payload_Term (snd z));

fun incidence_data z =
  Pair_Term (Payload_Term (fst z), address_pair_data (snd z));

fun data_list_term [] = Payload_Term []
  | data_list_term (t :: ts) = Pair_Term (t, data_list_term ts);

fun natural_data_term Zero_nat = Payload_Term []
  | natural_data_term (Suc n) =
    Pair_Term (Payload_Term [], natural_data_term n);

fun use_data_term NONE = Payload_Term []
  | use_data_term (SOME a) =
    Pair_Term (data_list_term (map natural_data_term a), Payload_Term []);

fun binding_data z =
  Pair_Term
    (Pair_Term (use_data_term (fst (fst z)), Payload_Term (snd (fst z))),
      use_data_term (snd z));

fun finite_bindings
  (Finite_opaque_basis_ext (finite_bag, finite_bindings, more)) =
  finite_bindings;

fun finite_bag (Finite_opaque_basis_ext (finite_bag, finite_bindings, more)) =
  finite_bag;

fun decode_finite_basis A_ B_ d =
  Opaque_basis_ext
    (count (equal_prod A_ B_) (finite_bag d), fset (finite_bindings d), ());

fun finite_relation_functional A_ B_ f =
  ball (fset f)
    (fn x =>
      ball (fset f)
        (fn y =>
          (if eq A_ (fst x) (fst y) then eq B_ (snd x) (snd y) else true)));

fun finite_basis_formed A_ B_ u d =
  finite_relation_functional A_ B_ (finite_bindings d) andalso
    (ball (set_mset (finite_bag d)) (fn x => member A_ (fst x) (fset u)) andalso
      ball (fset (finite_bindings d)) (fn x => member A_ (fst x) (fset u)));

fun finite_structure
  (Finite_structured_object_ext (finite_structure, finite_data, more)) =
  finite_structure;

fun finite_data
  (Finite_structured_object_ext (finite_structure, finite_data, more)) =
  finite_data;

fun finite_carrier
  (Finite_rra_structure_ext (finite_carrier, finite_incidence, more)) =
  finite_carrier;

fun finite_incidence
  (Finite_rra_structure_ext (finite_carrier, finite_incidence, more)) =
  finite_incidence;

fun finite_structure_formed A_ s =
  ball (fset (finite_incidence s))
    (fn (r, (p, x)) =>
      member A_ r (fset (finite_carrier s)) andalso
        (member A_ p (fset (finite_carrier s)) andalso
          member A_ x (fset (finite_carrier s))));

fun finite_object_formed A_ B_ c =
  finite_structure_formed A_ (finite_structure c) andalso
    finite_basis_formed A_ B_ (finite_carrier (finite_structure c))
      (finite_data c);

fun finite_exact_formed c =
  finite_object_formed (equal_list equal_nat) (equal_list equal_nat) c andalso
    (ball (fset (finite_carrier (finite_structure c))) octets_formed andalso
      (ball (set_mset (finite_bag (finite_data c)))
         (fn x => octets_formed (snd x)) andalso
        ball (fset (finite_bindings (finite_data c)))
          (fn x => octets_formed (snd x))));

fun artifact_data_term a e b f =
  Pair_Term
    (data_list_term (map Payload_Term a),
      Pair_Term
        (data_list_term (map incidence_data e),
          Pair_Term
            (data_list_term (map address_pair_data b),
              data_list_term (map address_pair_data f))));

val zero_multiset : 'a multiset = Mset [];

fun decode_finite_structure s =
  Rra_structure_ext (fset (finite_carrier s), fset (finite_incidence s), ());

fun decode_finite_object A_ B_ c =
  Structured_object_ext
    (decode_finite_structure (finite_structure c),
      decode_finite_basis A_ B_ (finite_data c), ());

fun decode_finite_target (Finite_Whole c) =
  Whole_Artifact
    (decode_finite_object (equal_list equal_nat) (equal_list equal_nat) c)
  | decode_finite_target (Finite_Anchor (c, a)) =
    Occurrence_Anchor
      (decode_finite_object (equal_list equal_nat) (equal_list equal_nat) c, a);

fun decode_finite_term (Finite_Target t) = Target_Term (decode_finite_target t)
  | decode_finite_term (Finite_Payload v) = Payload_Term v
  | decode_finite_term (Finite_Pair (x, y)) =
    Pair_Term (decode_finite_term x, decode_finite_term y);

fun finite_target_formed (Finite_Whole c) = finite_exact_formed c
  | finite_target_formed (Finite_Anchor (c, a)) =
    finite_exact_formed c andalso
      member (equal_list equal_nat) a
        (fset (finite_carrier (finite_structure c)));

fun finite_term_formed (Finite_Target t) = finite_target_formed t
  | finite_term_formed (Finite_Payload v) = octets_formed v
  | finite_term_formed (Finite_Pair (x, y)) =
    finite_term_formed x andalso finite_term_formed y;

val finite_empty_artifact :
  ((nat list), (nat list), unit) finite_structured_object_ext
  = Finite_structured_object_ext
      (Finite_rra_structure_ext (bot_fset, bot_fset, ()),
        Finite_opaque_basis_ext (zero_multiset, bot_fset, ()), ());

fun sorted_list_of_multiset A_ (Mset xs) = sort_key A_ (fn x => x) xs;

fun finite_environment_artifacts
  (Finite_artifact_environment_ext
    (finite_environment_artifacts, finite_environment_bindings, more))
  = finite_environment_artifacts;

fun finite_environment_bindings
  (Finite_artifact_environment_ext
    (finite_environment_artifacts, finite_environment_bindings, more))
  = finite_environment_bindings;

fun finite_environment_formed A_ c =
  finite_relation_functional A_
    (equal_finite_structured_object_ext (equal_list equal_nat)
      (equal_list equal_nat) equal_unit)
    (finite_environment_artifacts c) andalso
    (ball (fset (finite_environment_artifacts c))
       (fn (_, a) => finite_exact_formed a) andalso
      (finite_relation_functional (equal_prod A_ (equal_list equal_nat)) A_
         (finite_environment_bindings c) andalso
        ball (fset (finite_environment_bindings c))
          (fn (a, b) =>
            let
              val (u, k) = a;
            in
              (fn v =>
                bex (fset (finite_environment_artifacts c))
                  (fn (w, r) =>
                    eq A_ w u andalso
                      member (equal_list equal_nat) k
                        (fset (finite_carrier (finite_structure r)))) andalso
                  member A_ v
                    (image fst (fset (finite_environment_artifacts c))))
            end
              b)));

fun artifact_rows_term q = let
                             val (a, (e, (b, c))) = q;
                           in
                             artifact_data_term a e b c
                           end;

fun finite_self_contained_term (Target_Term t) = NONE
  | finite_self_contained_term (Payload_Term p) = SOME (Finite_Payload p)
  | finite_self_contained_term (Pair_Term (x, y)) =
    (case finite_self_contained_term x of NONE => NONE
      | SOME a =>
        map_option (fn b => Finite_Pair (a, b)) (finite_self_contained_term y));

fun finite_data_projection t =
  finite_self_contained_term (decode_finite_term t);

fun finite_enumerated_environment a b =
  Finite_artifact_environment_ext (fset_of_list a, fset_of_list b, ());

fun finite_artifact_rows c =
  (sorted_list_of_fset
     (equal_list equal_nat, linorder_list (equal_nat, linorder_nat))
     (finite_carrier (finite_structure c)),
    (sorted_list_of_fset
       (equal_prod (equal_list equal_nat)
          (equal_prod (equal_list equal_nat) (equal_list equal_nat)),
         linorder_prod (linorder_list (equal_nat, linorder_nat))
           (linorder_prod (linorder_list (equal_nat, linorder_nat))
             (linorder_list (equal_nat, linorder_nat))))
       (finite_incidence (finite_structure c)),
      (sorted_list_of_multiset
         (linorder_prod (linorder_list (equal_nat, linorder_nat))
           (linorder_list (equal_nat, linorder_nat)))
         (finite_bag (finite_data c)),
        sorted_list_of_fset
          (equal_prod (equal_list equal_nat) (equal_list equal_nat),
            linorder_prod (linorder_list (equal_nat, linorder_nat))
              (linorder_list (equal_nat, linorder_nat)))
          (finite_bindings (finite_data c)))));

fun finite_artifact_value c =
  the (finite_self_contained_term
        (artifact_rows_term (finite_artifact_rows c)));

fun finite_environment_artifact_rows c =
  sorted_list_of_fset
    (equal_prod (equal_option (equal_list equal_nat))
       (equal_prod (equal_list (equal_list equal_nat))
         (equal_prod
           (equal_list
             (equal_prod (equal_list equal_nat)
               (equal_prod (equal_list equal_nat) (equal_list equal_nat))))
           (equal_prod
             (equal_list
               (equal_prod (equal_list equal_nat) (equal_list equal_nat)))
             (equal_list
               (equal_prod (equal_list equal_nat) (equal_list equal_nat)))))),
      linorder_prod (linorder_option (linorder_list (equal_nat, linorder_nat)))
        (linorder_prod
          (linorder_list
            (equal_list equal_nat, linorder_list (equal_nat, linorder_nat)))
          (linorder_prod
            (linorder_list
              (equal_prod (equal_list equal_nat)
                 (equal_prod (equal_list equal_nat) (equal_list equal_nat)),
                linorder_prod (linorder_list (equal_nat, linorder_nat))
                  (linorder_prod (linorder_list (equal_nat, linorder_nat))
                    (linorder_list (equal_nat, linorder_nat)))))
            (linorder_prod
              (linorder_list
                (equal_prod (equal_list equal_nat) (equal_list equal_nat),
                  linorder_prod (linorder_list (equal_nat, linorder_nat))
                    (linorder_list (equal_nat, linorder_nat))))
              (linorder_list
                (equal_prod (equal_list equal_nat) (equal_list equal_nat),
                  linorder_prod (linorder_list (equal_nat, linorder_nat))
                    (linorder_list (equal_nat, linorder_nat))))))))
    (fimage (fn (u, r) => (u, finite_artifact_rows r))
      (finite_environment_artifacts c));

fun environment_artifact_rows_term q =
  Pair_Term (use_data_term (fst q), artifact_rows_term (snd q));

fun finite_environment_term c =
  Pair_Term
    (data_list_term
       (map environment_artifact_rows_term
         (finite_environment_artifact_rows c)),
      data_list_term
        (map binding_data
          (sorted_list_of_fset
            (equal_prod
               (equal_prod (equal_option (equal_list equal_nat))
                 (equal_list equal_nat))
               (equal_option (equal_list equal_nat)),
              linorder_prod
                (linorder_prod
                  (linorder_option (linorder_list (equal_nat, linorder_nat)))
                  (linorder_list (equal_nat, linorder_nat)))
                (linorder_option (linorder_list (equal_nat, linorder_nat))))
            (finite_environment_bindings c))));

fun finite_environment_value c =
  the (finite_self_contained_term (finite_environment_term c));

fun finite_enumerated_artifact a e b f =
  Finite_structured_object_ext
    (Finite_rra_structure_ext (fset_of_list a, fset_of_list e, ()),
      Finite_opaque_basis_ext (Mset b, fset_of_list f, ()), ());

fun finite_presented_environment_formed c =
  finite_environment_formed (equal_option (equal_list equal_nat)) c;

