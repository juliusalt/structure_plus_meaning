fun finite_join_readings C_ f v r ps x y =
  ffUnion
    (equal_prod C_
      (equal_prod (equal_fset (equal_list equal_nat))
        (equal_fset (equal_list equal_nat))))
    (fimage
      (fn (xa, (l, a)) =>
        ffUnion
          (equal_prod C_
            (equal_prod (equal_fset (equal_list equal_nat))
              (equal_fset (equal_list equal_nat))))
          (fimage
            (fn (ya, (q, b)) =>
              let
                val fa = finsert (equal_list equal_nat) r (fset_of_list ps);
                val i =
                  sup_fset (equal_list equal_nat)
                    (sup_fset (equal_list equal_nat) fa l) q;
                val k = sup_fset (equal_list equal_nat) a b;
              in
                (if equal_fseta (equal_list equal_nat)
                      (inf_fset (equal_list equal_nat) fa
                        (sup_fset (equal_list equal_nat) l q))
                      bot_fset andalso
                      (equal_fseta (equal_list equal_nat)
                         (inf_fset (equal_list equal_nat) l q) bot_fset andalso
                        equal_fseta (equal_list equal_nat)
                          (inf_fset (equal_list equal_nat) i
                            (sup_fset (equal_list equal_nat) k v))
                          bot_fset)
                  then finsert
                         (equal_prod C_
                           (equal_prod (equal_fset (equal_list equal_nat))
                             (equal_fset (equal_list equal_nat))))
                         (f xa ya, (i, k)) bot_fset
                  else bot_fset)
              end)
            y))
      x);

