fun finite_family_at A_ B_ c r m =
  finite_object_formed A_ B_ c andalso
    (member A_ r (fset (finite_carrier (finite_structure c))) andalso
      (equal_fseta (equal_prod A_ A_)
         (finite_headed_incidence A_ (finite_structure c) r) m andalso
        (finite_relation_functional A_ A_ m andalso
          (not (member A_ r (image fst (fset m))) andalso
            (ball (image fst (fset m))
               (fn p =>
                 equal_fseta (equal_prod A_ A_)
                   (finite_headed_incidence A_ (finite_structure c) p)
                   bot_fset) andalso
              finite_data_empty_on A_ B_ c (finsert A_ r (fimage fst m)))))));

