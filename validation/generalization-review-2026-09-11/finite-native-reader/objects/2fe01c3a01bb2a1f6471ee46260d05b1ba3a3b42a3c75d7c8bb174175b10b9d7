      (ffilter (fn (q, _) => eq A_ q p) (finite_headed_incidence A_ s r)))
    (finsert A_ x bot_fset);

fun finite_record_path A_ s r [] xs = false
  | finite_record_path A_ s r (p :: ps) [] = false
  | finite_record_path A_ s r (p :: ps) (x :: xs) =
    not (eq A_ p r) andalso
      (finite_field_endpoint A_ s r p x andalso
        (if null ps
          then null xs andalso
                 equal_fseta (equal_prod A_ A_) (finite_headed_incidence A_ s p)
                   bot_fset
          else equal_fseta (equal_prod A_ A_) (finite_headed_incidence A_ s p)
                 (finsert (equal_prod A_ A_) (p, hd ps) bot_fset) andalso
                 finite_record_path A_ s r ps xs));

fun finite_record_at A_ B_ c r ps xs =
  finite_object_formed A_ B_ c andalso
    (member A_ r (fset (finite_carrier (finite_structure c))) andalso
      ((null ps andalso
          (null xs andalso
            equal_fseta (equal_prod A_ A_)
              (finite_headed_incidence A_ (finite_structure c) r)
              bot_fset) orelse
         finite_record_path A_ (finite_structure c) r ps xs andalso
           equal_fseta (equal_prod A_ A_)
             (finite_headed_incidence A_ (finite_structure c) r)
             (fset_of_list (zip ps xs))) andalso
        finite_data_empty_on A_ B_ c (finsert A_ r (fset_of_list ps))));

