fun address_pair_data z =
  Pair_Term (Payload_Term (fst z), Payload_Term (snd z));

fun incidence_data z =
  Pair_Term (Payload_Term (fst z), address_pair_data (snd z));

fun data_list_term [] = Payload_Term []
  | data_list_term (t :: ts) = Pair_Term (t, data_list_term ts);

fun natural_data_term n =
  (if equal_nata n zero_nat then Payload_Term []
    else Pair_Term (Payload_Term [], natural_data_term (minus_nat n one_nat)));

fun use_data_term NONE = Payload_Term []
  | use_data_term (SOME a) =
    Pair_Term (data_list_term (map natural_data_term a), Payload_Term []);

fun binding_data z =
  Pair_Term
    (Pair_Term (use_data_term (fst (fst z)), Payload_Term (snd (fst z))),
      use_data_term (snd z));

fun site_data_term u r = Pair_Term (use_data_term u, Payload_Term r);

fun artifact_data_term a e b f =
  Pair_Term
    (data_list_term (map Payload_Term a),
      Pair_Term
        (data_list_term (map incidence_data e),
          Pair_Term
            (data_list_term (map address_pair_data b),
              data_list_term (map address_pair_data f))));

fun sorted_list_of_multiset A_ (Mset xs) = sort_key A_ (fn x => x) xs;

fun ground_schema_report t =
