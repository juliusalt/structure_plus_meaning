theory Factor_Proof_Node_Code
  imports Factor_Proof_Node_Construction Factor_Graph_Metadata
begin

section \<open>A derived compilation contract for both proof-node forms\<close>

fun proof_node_reference_sites ::
  "('u definition_site,'u definition_site) schema_graph_node \<Rightarrow>
    ('u definition_site \<times> 'u definition_site) set \<Rightarrow> 'u definition_site set" where
  "proof_node_reference_sites Schema_Assertion D={}"
| "proof_node_reference_sites (Schema_Inference c V) D=insert c (rel_dom (fset V)\<union>rel_dom D\<union>rel_ran D)"

definition proof_node_code_for ::
  "('u definition_site,'u definition_site) schema_graph_node \<Rightarrow>
    ('u definition_site \<times> 'u definition_site) set \<Rightarrow> exact_artifact \<Rightarrow>
    (local_address\<times>exact_artifact) set \<Rightarrow> (local_address\<times>'u definition_site) set \<Rightarrow>
    local_address set \<Rightarrow> local_address set \<Rightarrow> bool" where
  "proof_node_code_for N D R L C I K \<longleftrightarrow>
    exact_formed R \<and> bag_count (object_data R)=(\<lambda>_. 0) \<and>
    []\<in>rra_carrier (object_structure R) \<and> reference_table_formed L C \<and>
    rra_carrier (object_structure R)=I\<union>K \<and> I\<inter>K={} \<and>
    K=rel_dom L\<union>rel_dom C \<and> rel_ran C=proof_node_reference_sites N D \<and>
    (\<forall>E u. environment_formed E \<longrightarrow> artifact_at E u R \<longrightarrow> syntax_references E u L C \<longrightarrow>
      native_proof_node_at E u [] N D I K)"

theorem proof_node_code_total:
  fixes E :: "local_address option artifact_environment"
  assumes ef: "environment_formed E" and inputs: "graph_node_inputs_at E D N"
    and finite: "finite D" and functional: "single_valued D"
    and targets: "\<forall>s n. (s,n)\<in>D \<longrightarrow> octets_formed (snd n)"
  shows "\<exists>R L C I K. proof_node_code_for N D R L C I K"
proof (cases N)
  case Schema_Assertion
  have empty: "D={}" using inputs Schema_Assertion by simp
  obtain R where code: "exact_formed R" "bag_count (object_data R)=(\<lambda>_. 0)"
    "rra_carrier (object_structure R)={[]}"
    "\<forall>F :: local_address option artifact_environment. \<forall>u.
      environment_formed F \<longrightarrow> artifact_at F u R \<longrightarrow>
      native_proof_node_at F u [] Schema_Assertion {} {[]} {}"
    using assertion_node_syntax_total by blast
  show ?thesis
    by (rule exI[of _ R], rule exI[of _ "{}"], rule exI[of _ "{}"],
        rule exI[of _ "{[]}"], rule exI[of _ "{}"])
       (use code empty in \<open>simp add: proof_node_code_for_def Schema_Assertion\<close>)
next
  case (Schema_Inference c V)
  have cite: "c\<in>environment_positions E" and bindings: "single_valued (fset V)"
    and arguments: "\<forall>a t. (a,t)\<in>fset V \<longrightarrow> a\<in>environment_positions E \<and> term_formed t"
    and sockets: "rel_dom D\<subseteq>environment_positions E" using inputs Schema_Inference by simp_all
  have address: "octets_formed (snd c)" by (rule environment_position_address[OF ef cite])
  have terms: "\<forall>a t. (a,t)\<in>fset V \<longrightarrow> octets_formed (snd a) \<and> term_formed t"
  proof (intro allI impI)
    fix a t assume member: "(a,t)\<in>fset V"
    have at: "a\<in>environment_positions E" and tf: "term_formed t" using arguments member by blast+
    show "octets_formed (snd a) \<and> term_formed t" using environment_position_address[OF ef at] tf by blast
  qed
  have endpoints: "\<forall>s n. (s,n)\<in>D \<longrightarrow> octets_formed (snd s) \<and> octets_formed (snd n)"
  proof (intro allI impI)
    fix s n assume member: "(s,n)\<in>D"
    have key: "s\<in>rel_dom D" by (rule rel_domI[OF member])
    have at: "s\<in>environment_positions E" by (rule subsetD[OF sockets key])
    show "octets_formed (snd s) \<and> octets_formed (snd n)"
      using environment_position_address[OF ef at] targets member by blast
  qed
  show ?thesis using inference_node_syntax_total[OF address bindings terms finite functional endpoints]
    by (simp add: proof_node_code_for_def Schema_Inference)
qed

lemma proof_node_code_recovers:
  assumes code: "proof_node_code_for N D R L C I K"
    and ef: "environment_formed E" and art: "artifact_at E u R" and refs: "syntax_references E u L C"
  shows "native_proof_node_at E u [] N D I K"
  using code ef art refs unfolding proof_node_code_for_def by blast

lemma proof_node_reference_boundary:
  assumes inputs: "graph_node_inputs_at E D N" and targets: "rel_ran D\<subseteq>U"
  shows "proof_node_reference_sites N D\<subseteq>environment_positions E\<union>U"
proof (cases N)
  case Schema_Assertion
  then show ?thesis by simp
next
  case (Schema_Inference c V)
  have clause: "c\<in>environment_positions E"
    and arguments: "\<forall>a t. (a,t)\<in>fset V \<longrightarrow> a\<in>environment_positions E"
    and sockets: "rel_dom D\<subseteq>environment_positions E"
    using inputs Schema_Inference by auto
  have keys: "rel_dom (fset V)\<subseteq>environment_positions E"
    using arguments by (auto simp only: rel_dom_def; blast)
  show ?thesis using clause keys sockets targets by (simp only: Schema_Inference proof_node_reference_sites.simps) blast
qed

text \<open>
  This contract packages already proved syntax and recovery properties. It is
  not stored in a proof artifact and does not validate a derivation. Program
  inputs stay at their actual sites; only the proof targets need subsequent
  placement. Compatible installed references then recover the exact node.
\<close>

end
