from pathlib import Path
import json,os,subprocess,sys,time,uuid
sys.dont_write_bytecode=True
root=Path('/home/julius/structure_and_semantics');sys.path.insert(0,str(root/'tools'))
import investigate,check_reasoning as review
base=Path('/tmp/native-investigation-report-diagnostic-finitepresenters10')
proof=base/'native-source-proof.json';p=json.loads(proof.read_text());assert p['status']=='accepted'
engine=Path(p['exports'][0]['path']);assert review.digest(engine)==p['exports'][0]['sha256']
assert all(review.digest(root/'theories'/(n+'.thy'))==h for n,h in p['sources'].items())
poly=Path('/opt/isabelle/contrib/polyml-5.9.2-2/x86_64-linux/poly')
out=Path('/tmp/generalization-quality-review/finite-reader-example/native-source-execution1');assert not out.exists();out.mkdir()
cases=[{'name':'empty-literal','payload':[]},{'name':'nonempty-literal','payload':[0,255]},{'name':'nonbyte-literal','payload':[256]}]
(out/'cases.json').write_text(json.dumps(cases,indent=2)+'\n')
program='use '+investigate.ml_string(str(engine))+';\nstructure N = Finite_Literal_Sources;\nval n = N.nat_of_integer;\n'+review.SCALAR_JSON_PRELUDE
for i,c in enumerate(cases):
 program+='val () = print ("LITERAL_RESULT '+str(i)+' " ^ jlist Bool.toString (N.finite_literal_native_checks '+investigate.ml_list(c['payload'],investigate.ml_nat)+') ^ "\\n");\n'
runtime=out/'execute.ML';runtime.write_text(program)
tracked=[proof,engine,poly,Path(__file__),runtime,out/'cases.json',*review.loaded_tool_sources()]
hashes={str(f):review.digest(f) for f in tracked}
report={'invocation':str(uuid.uuid4()),'status':'failed','boundary':'Executed native finite reader checks in the accepted definition context. The separate unconditional Isabelle assertions and complete inference reader construction remain required.'}
for f in tracked:
 if f!=poly:investigate.archive_evidence(out,report,'native source execution input',f,hashes[str(f)])
start=time.monotonic()
with (out/'results.log').open('w') as log:
 try:r=subprocess.run([str(poly),'--script',str(runtime)],stdout=log,stderr=subprocess.STDOUT,timeout=90)
 except subprocess.TimeoutExpired:report['error']='Native checks exceeded the execution timeout';r=None
report['elapsed_seconds']=time.monotonic()-start
if r is not None:
 report['exit_code']=r.returncode
 if r.returncode==0:
  values=[json.loads(line.split(' ',2)[2]) for line in (out/'results.log').read_text().splitlines() if line.startswith('LITERAL_RESULT ')]
  assert len(values)==len(cases) and all(len(row)==6 and all(type(v) is bool for v in row) for row in values)
  assert all(review.digest(f)==h for f,h in hashes.items())
  report.update(status='executed',results=values,execution_inputs=hashes,proof_receipt_sha256=review.digest(proof))
(out/'receipt.json').write_text(json.dumps(report,indent=2)+'\n')
print(json.dumps({k:v for k,v in report.items() if k not in ['evidence_archive','execution_inputs']},indent=2))
print((out/'results.log').read_text() if (out/'results.log').stat().st_size<16000 else 'Full result log retained.')
sys.exit(0 if report['status']=='executed' else 1)
