theory Factor_Executable_Data_Values
  imports Factor_Executable_Terms Factor_Self_Contained_Terms
begin

section \<open>Reuse the same finite sequence and its decoding argument\<close>

abbreviation finite_data_sequence where
  "finite_data_sequence xs \<equiv> foldr Finite_Pair xs (Finite_Payload [])"

lemma decode_finite_data_sequence [simp]:
  "decode_finite_term (finite_data_sequence xs)=data_list_term (map decode_finite_term xs)"
  by (induction xs) simp_all

section \<open>Convert exactly the payload-and-pair data domain\<close>

fun finite_self_contained_term :: "factor_term \<Rightarrow> finite_factor_term option" where
  "finite_self_contained_term (Target_Term t)=None"
| "finite_self_contained_term (Payload_Term p)=Some (Finite_Payload p)"
| "finite_self_contained_term (Pair_Term x y)=
    (case finite_self_contained_term x of None \<Rightarrow> None
      | Some a \<Rightarrow> map_option (Finite_Pair a) (finite_self_contained_term y))"

lemma finite_self_contained_term_domain:
  "finite_self_contained_term t=None \<longleftrightarrow> \<not>self_contained_term t"
  by (induction t) (auto split: option.splits)

lemma finite_self_contained_term_sound:
  assumes "finite_self_contained_term t=Some v"
  shows "decode_finite_term v=t"
  using assms by (induction t arbitrary: v) (auto split: option.splits)

theorem finite_self_contained_term_exact:
  "finite_self_contained_term t=Some v \<longleftrightarrow>
    self_contained_term t \<and> decode_finite_term v=t"
  by (rule partial_inverse_exact[OF finite_self_contained_term_domain
      finite_self_contained_term_sound]) (auto simp: inj_def)

lemma decode_finite_self_contained_term:
  assumes "self_contained_term t"
  shows "decode_finite_term (the (finite_self_contained_term t))=t"
proof -
  obtain v where value: "finite_self_contained_term t=Some v"
    using assms finite_self_contained_term_domain[of t]
    by (cases "finite_self_contained_term t") auto
  show ?thesis using value finite_self_contained_term_exact[of t v] by simp
qed

definition finite_data_projection :: "finite_factor_term \<Rightarrow> finite_factor_term option" where
  "finite_data_projection t=finite_self_contained_term (decode_finite_term t)"

lemma finite_data_projection_exact:
  "finite_data_projection t=Some v \<longleftrightarrow>
    self_contained_term (decode_finite_term t) \<and> v=t"
  by (simp add: finite_data_projection_def finite_self_contained_term_exact)

export_code finite_data_projection checking SML

text \<open>
  The converter reuses existing payload-and-pair layouts without constructing
  a finite inverse for an arbitrary target artifact. Target-bearing terms
  are rejected. Data conversion and term formation remain separate: an
  invalid payload is preserved for the existing formation check.
\<close>

end
