lemma finite_literal_source_included:
  "environment_included (literal_environment p) (literal_extension p)"
  by (auto simp: environment_included_def finite_literal_extension_def Let_def
    map_relation_values_def)

lemma finite_literal_artifact_at:
  "artifact_at (literal_environment p) None (decode_finite_object (finite_literal_artifact p))"
  by (simp add: finite_literal_sources_def finite_enumerated_environment_def fset_of_list.rep_eq)

lemma finite_literal_background_retained:
  "artifact_at (literal_extension p) (Some [256]) (decode_finite_object finite_literal_background)"
  "binds_slot (literal_extension p) None [23] (Some [256])"
proof -
  have old: "artifact_at (literal_environment p) (Some [256]) (decode_finite_object finite_literal_background)"
    "binds_slot (literal_environment p) None [23] (Some [256])"
    by (simp_all add: finite_literal_sources_def finite_enumerated_environment_def
      fset_of_list.rep_eq binds_slot_def)
  show "artifact_at (literal_extension p) (Some [256]) (decode_finite_object finite_literal_background)"
    by (rule included_artifact[OF finite_literal_source_included old(1)])
  show "binds_slot (literal_extension p) None [23] (Some [256])"
    by (rule included_binding[OF finite_literal_source_included old(2)])
qed

lemma finite_literal_presentations:
  "environment_value_presents (literal_environment []) (finite_environment_term (finite_literal_sources []))"
  "environment_value_presents (literal_extension []) (finite_environment_term (finite_literal_extension []))"
  using finite_environment_value_exact finite_literal_environment_checks by auto

lemma finite_literal_schema_recognizer:
  "literal_schema p=recognizer_schema (exact_term_pattern (Payload_Term p))"
  by (simp add: finite_literal_schema_def decode_finite_schema_def
    map_relation_values_def recognizer_schema_def)

lemma finite_literal_report:
  "schema_reference_presents (literal_schema []) (ground_schema_report (Payload_Term []))"
  by (simp add: finite_literal_schema_recognizer ground_recognizer_report)

lemma finite_literal_pattern_boundary:
  "schema_pattern_boundary (literal_program []) (None,[1]) (literal_schema [])"
proof -
  have formed: "schema_system_formed (literal_program [])"
    by (rule native_package_system_formed[OF finite_literal_native_package])
  have head: "schema_pattern_call (literal_program []) (None,[1]) (Pattern_Payload [])"
    unfolding schema_pattern_call_def
    by (rule conjI[OF formed], rule exI[of _ "Pattern_Payload []"], rule exI[of _ "{}"])
      (simp add: finite_literal_program_def decode_finite_system_def map_relation_values_def
        pattern_bindings_formed_def single_valued_def rel_dom_def)
  show ?thesis using head
    by (simp add: schema_pattern_boundary_def finite_literal_schema_recognizer recognizer_schema_def
      schema_formed_def single_valued_def)
qed

lemma finite_literal_binding:
  "specialization_binding_at (literal_extension []) None [0] (None,[1]) [7]
    (literal_environment []) None [3] (literal_environment []) None [8]
    (ground_schema_report (Payload_Term [])) (positioned_binding_rows_term []) [[3]] []"
proof -
  have package: "native_package_at (literal_extension []) None [0] (literal_program [])"
    by (rule native_package_included[OF finite_literal_native_package
      finite_literal_source_included finite_literal_environments_formed(2)])
  have clause: "(((None,[1]),[7]),literal_schema [])\<in>system_clauses (literal_program [])"
    by (simp add: finite_literal_program_def decode_finite_system_def map_relation_values_def)
  have ground: "schema_variables (literal_schema [])={}"
    by (simp add: finite_literal_schema_recognizer)
  show ?thesis
    by (rule ground_specialization_binding[OF package clause ground
      finite_literal_environments_formed(1) finite_literal_artifact_at finite_literal_binder
      finite_literal_native_schema finite_literal_pattern_boundary finite_literal_report])
qed

lemma finite_literal_inference:
  "inference_specialization_at (literal_extension []) None [0] (Some []) [] (None,[1]) [7]
    (literal_environment []) None [3] (literal_environment []) None [8]
    (ground_schema_report (Payload_Term [])) [] finite_literal_node_interior [[6]] [[3]] []"
  unfolding inference_specialization_at_def
  by (intro conjI, simp, simp add: finite_literal_node_interior_def, simp,
    rule exI[of _ "[]"])
    (use finite_literal_native_node finite_literal_binding in simp)

section \<open>One explicit full reader argument\<close>

definition finite_literal_inference_term :: "octets \<Rightarrow> factor_term" where
  "finite_literal_inference_term p =
    (case ground_schema_report (Payload_Term p) of Pair_Term b report \<Rightarrow>
      inference_specialization_argument
        (finite_environment_term (finite_literal_extension p)) (use_data_term None) (Payload_Term [0])
        (use_data_term (Some [])) (Payload_Term []) (use_data_term None) (Payload_Term [1]) (Payload_Term [7])
        (finite_environment_term (finite_literal_sources p)) (use_data_term None) (Payload_Term [3])
        (Pair_Term (finite_environment_term (finite_literal_sources p))
          (Pair_Term (use_data_term None) (Payload_Term [8]))) b report (discharge_rows_term [])
        (data_list_term (map Payload_Term finite_literal_node_interior))
        (data_list_term (map Payload_Term [[6]])) (data_list_term (map Payload_Term [[3]]))
        (data_list_term (map Payload_Term []))
      | _ \<Rightarrow> Payload_Term [])"

lemma finite_literal_inference_term_self_contained:
  "self_contained_term (finite_literal_inference_term p)"
  by (simp add: finite_literal_inference_term_def ground_schema_report_def
    finite_environment_term_self_contained source_root_argument_def)

definition finite_literal_inference_value :: "octets \<Rightarrow> finite_factor_term" where
  "finite_literal_inference_value p=the (finite_self_contained_term (finite_literal_inference_term p))"

lemma decode_finite_literal_inference_value [simp]:
  "decode_finite_term (finite_literal_inference_value p)=finite_literal_inference_term p"
  unfolding finite_literal_inference_value_def
  by (rule decode_finite_self_contained_term[OF finite_literal_inference_term_self_contained])

theorem finite_literal_inference_admitted:
  "(350,decode_finite_term (finite_literal_inference_value []))
    \<in>positive_meaning inference_specialization_system"
  using inference_specialization_on_sources[OF finite_literal_presentations(2)
    finite_literal_presentations(1) finite_literal_presentations(1),
    where pu=None and pr="[0]" and nu="Some []" and nr="[]" and du=None and dr="[1]" and c="[7]"
      and v=None and r="[3]" and w=None and t="[8]" and ds="[]"
      and NIs=finite_literal_node_interior and NKs="[[6]]" and RIs="[[3]]" and RKs="[]"]
    finite_literal_inference
  by (simp add: finite_literal_inference_term_def ground_schema_report_def)

export_code finite_literal_inference_value Finite_Payload Finite_Pair Finite_Target Finite_Whole
  nat_of_integer integer_of_nat in SML module_name Finite_Literal_Inference file_prefix finite_literal_inference

text \<open>
  This input contains the complete extended package environment, the complete
