section \<open>Complete finite environments and retained source material\<close>

abbreviation literal_environment where
  "literal_environment p \<equiv> decode_finite_environment (finite_literal_sources p)"

abbreviation literal_extension where
  "literal_extension p \<equiv> decode_finite_environment (finite_literal_extension p)"

abbreviation literal_schema where
  "literal_schema p \<equiv> decode_finite_schema (finite_literal_schema p)"

