import json,os,subprocess,sys
from pathlib import Path
sys.dont_write_bytecode=True
root=Path('/home/julius/structure_and_semantics');sys.path.insert(0,str(root/'tools'))
from compare_reasoning_methods import comparison_case
from investigate import file_hash
base=Path('/tmp/generalization-quality-review/finite-reader-example')
items=[('presentation-design','How should the existing complete data layouts be converted to executable finite term values?',
 ['Repeat each public layout directly with finite constructors','Use a reusable converter for payload-and-pair terms, reject target terms, and reuse the existing complete artifact/use/binding layouts with finite enumerations','Use finite_term_of on arbitrary target-bearing terms without an executable target inverse'],
 ['Preserves every artifact and environment field, including attachment multiplicity','Uses an executable finite-data path with an explicit conversion domain','Reuses the original public data layouts instead of maintaining parallel copies','Keeps finite formation, native reading proof and the executed positive example as further requirements'],
 [[0,1,3],[0,1,2,3],[0,3]],list(range(4))),
 ('sequence-reuse','How should the existing general finite-sequence decoding argument be reused by the data encoders?',
 ['Copy the fold and prove its decoding relation again','Put the general sequence interface and decoding theorem in a shared lower module, retaining the existing binding-specific aliases and theorem','Import the entire native binding-observation execution module into the artifact encoder'],
 ['Reuses the established decoding argument','Makes the general operation available without the unrelated native binding program','Preserves existing binding interfaces and behavior','Checks the existing consumer after the change'],
 [[1],[0,1,2,3],[0,2,3]],list(range(4)))]
paths=[root/'theories/Factor_Artifact_Values.thy',root/'theories/Factor_Material_Observation.thy',root/'theories/Factor_Environment_Values.thy',root/'theories/Factor_Self_Contained_Terms.thy',root/'theories/Factor_Binding_Observation_Execution.thy',root/'theories/Factor_Executable_Terms.thy',root/'theories/RRA_Finite_Artifacts.thy',base/'plan/complete-results.json',Path(__file__)]
evidence=[{'path':str(p),'sha256':file_hash(p)} for p in paths]
boundary='The observations concern proposed interfaces and reuse, with source bodies retained. They do not prove the new implementation. The first encoder batch is a component of the explicit native example; source construction, its actual native reading and execution remain required. Sorting chooses one complete presentation and does not change the existing semantics of other complete orders.'
problems=[]
for name,q,candidates,facets,profiles,required in items:
 case=comparison_case(list(range(len(candidates))),list(range(len(facets))),[[f,c,0] for c,fs in enumerate(profiles) for f in fs],[0],question=q,scope={'candidates':dict(enumerate(candidates)),'facets':dict(enumerate(facets)),'boundary':boundary},evidence=evidence)
 problems.append({'name':name,'case':case,'required_observations':[[f,0] for f in required]})
spec={'question':'What reusable finite-presentation implementation should be prepared from the actual source interfaces?','boundary':boundary,'problems':problems}
(base/'presenter-design-specification.json').write_text(json.dumps(spec,indent=2)+'\n')
r=subprocess.run([sys.executable,str(root/'tools/check_decision_cases.py'),'--specification',str(base/'presenter-design-specification.json'),'--output',str(base/'presenter-design')],env={**os.environ,'PYTHONDONTWRITEBYTECODE':'1'})
assert r.returncode==0
results=json.loads((base/'presenter-design/complete-results.json').read_text())['results']
assert all(row['assessment']['dominant']==[1] for row in results)
print('The returned choices support the shared data-only converter and reuse of the existing sequence proof; native proof and execution remain required.',flush=True)
