          "theory": "Factor_Admitted_Context",
          "source": "theory Factor_Admitted_Context\n  imports Factor_List_Profiles\nbegin\n\nsection \\<open>A contextual operation retains an explicit context check\\<close>\n\ndefinition admitted_context_schema :: \"nat \\<Rightarrow> nat \\<Rightarrow> (nat,nat,nat) factor_schema\" where\n  \"admitted_context_schema context_site operation_site=data_rule (Pattern_Pair data_x data_y)\n    {(0,context_site,data_x),(1,operation_site,Pattern_Pair data_x data_y)}\"\n\nlemma admitted_context_formed [simp]: \"schema_formed (admitted_context_schema context_site operation_site)\"\n  by (auto simp: admitted_context_schema_def schema_formed_def single_valued_def)\n\nlemma admitted_context_dependencies [simp]:\n  \"schema_dependencies (admitted_context_schema context_site operation_site)={context_site,operation_site}\"\n  by (auto simp: admitted_context_schema_def schema_dependencies_def rel_ran_image)\n\nlocale admitted_context_profile =\n  fixes P :: \"(nat,nat,nat,nat) schema_system\" and entry context_site operation_site :: nat\n  assumes system_formed: \"schema_system_formed P\"\n    and family: \"\\<And>c S. ((entry,c),S)\\<in>system_clauses P \\<longleftrightarrow>\n      c=0 \\<and> S=admitted_context_schema context_site operation_site\"\n    and call: \"\\<And>t. schema_call_formed P entry t \\<longleftrightarrow> term_formed t\"\nbegin\n\nlemma valuation:\n  \"(entry,t)\\<in>positive_meaning P \\<longleftrightarrow>\n    (\\<exists>h::nat\\<Rightarrow>factor_term. term_formed (h 0) \\<and> term_formed (h 1) \\<and>\n      t=Pair_Term (h 0) (h 1) \\<and> (context_site,h 0)\\<in>positive_meaning P \\<and>\n      (operation_site,Pair_Term (h 0) (h 1))\\<in>positive_meaning P)\"\n  by (subst ordinary_positive_entry_valuation)\n    (auto simp: family admitted_context_schema_def schema_variables_def call)\n\ntheorem exact:\n  \"(entry,t)\\<in>positive_meaning P \\<longleftrightarrow>\n    (\\<exists>p q. t=Pair_Term p q \\<and> (context_site,p)\\<in>positive_meaning P \\<and>\n      (operation_site,Pair_Term p q)\\<in>positive_meaning P)\"\nproof\n  assume \"(entry,t)\\<in>positive_meaning P\"\n  then show \"\\<exists>p q. t=Pair_Term p q \\<and> (context_site,p)\\<in>positive_meaning P \\<and>\n      (operation_site,Pair_Term p q)\\<in>positive_meaning P\"\n    by (simp only: valuation) blast\nnext\n  assume \"\\<exists>p q. t=Pair_Term p q \\<and> (context_site,p)\\<in>positive_meaning P \\<and>\n      (operation_site,Pair_Term p q)\\<in>positive_meaning P\"\n  then obtain p q where parts: \"t=Pair_Term p q\" \"(context_site,p)\\<in>positive_meaning P\"\n    \"(operation_site,Pair_Term p q)\\<in>positive_meaning P\" by blast\n  have formed: \"term_formed p\" \"term_formed q\"\n    using schema_call_formed_target[OF positive_meaning_formed[OF parts(3)]] by auto\n  show \"(entry,t)\\<in>positive_meaning P\"\n    by (simp only: valuation; rule exI[of _ \"\\<lambda>i::nat. if i=0 then p else q\"])\n      (use parts formed in auto)\nqed\n\ncorollary at_input:\n  \"(entry,Pair_Term p q)\\<in>positive_meaning P \\<longleftrightarrow>\n    (context_site,p)\\<in>positive_meaning P \\<and> (operation_site,Pair_Term p q)\\<in>positive_meaning P\"\n  by (auto simp only: exact factor_term.inject)\n\ntheorem lists:\n  assumes list: \"context_list_profile P element operation_site\"\n  shows \"(entry,Pair_Term p (data_list_term xs))\\<in>positive_meaning P \\<longleftrightarrow>\n    (context_site,p)\\<in>positive_meaning P \\<and>\n    (\\<forall>x\\<in>set xs. (element,Pair_Term p x)\\<in>positive_meaning P)\"\nproof -\n  have formed: \"term_formed p\" if \"(context_site,p)\\<in>positive_meaning P\"\n    using schema_call_formed_target[OF positive_meaning_formed[OF that]] by blast\n  show ?thesis by (simp only: at_input context_list_profile.lists[OF list])\n    (use formed in blast)\nqed\n\nend\n\ntext \\<open>\n  The two premise sockets call the actual context and operation definitions\n  in the same program. For a complete contextual list, the derived contract\n  retains context admission even when there are no element calls. The list's\n  existing meaning and the context's independently owned domain remain intact.\n\\<close>\n\nend\n",
