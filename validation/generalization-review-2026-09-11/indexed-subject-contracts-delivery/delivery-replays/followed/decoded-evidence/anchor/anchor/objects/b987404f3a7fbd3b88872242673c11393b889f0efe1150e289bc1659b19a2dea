          "theory": "Inference_Demands",
          "source": "theory Inference_Demands\n  imports Inference_Development\nbegin\n\nsection \\<open>Backward demand retains the actual rule and every premise occurrence\\<close>\n\ndefinition inference_premise_use where\n  \"inference_premise_use R a H i b \\<longleftrightarrow>\n    finite H \\<and> single_valued H \\<and> R a H \\<and> (i,b)\\<in>H\"\n\ndefinition inference_demand_edges where\n  \"inference_demand_edges R K={(a,b). a\\<notin>K \\<and> (\\<exists>H i. inference_premise_use R a H i b)}\"\n\ndefinition inference_demand where\n  \"inference_demand R K A={b. \\<exists>a\\<in>A. (a,b)\\<in>(inference_demand_edges R K)\\<^sup>*}\"\n\nlemma inference_demand_member:\n  \"b\\<in>inference_demand R K A \\<longleftrightarrow>\n    (\\<exists>a\\<in>A. (a,b)\\<in>(inference_demand_edges R K)\\<^sup>*)\"\n  by (auto simp: inference_demand_def)\n\nlemma inference_demand_initial:\n  \"A\\<subseteq>inference_demand R K A\"\n  by (auto simp: inference_demand_def)\n\nlemma inference_demand_step:\n  assumes demanded: \"a\\<in>inference_demand R K A\" and unsettled: \"a\\<notin>K\"\n    and premise: \"inference_premise_use R a H i b\"\n  shows \"b\\<in>inference_demand R K A\"\nproof -\n  obtain q where initial: \"q\\<in>A\" and path: \"(q,a)\\<in>(inference_demand_edges R K)\\<^sup>*\"\n    using demanded by (auto simp: inference_demand_member)\n  have edge: \"(a,b)\\<in>inference_demand_edges R K\"\n    using unsettled premise by (auto simp: inference_demand_edges_def)\n  have \"(q,b)\\<in>(inference_demand_edges R K)\\<^sup>*\"\n    by (rule rtrancl.rtrancl_into_rtrancl[OF path edge])\n  then show ?thesis using initial by (auto simp: inference_demand_member)\nqed\n\nlemma inference_demand_premises:\n  assumes \"a\\<in>inference_demand R K A\" \"a\\<notin>K\" \"finite H\" \"single_valued H\" \"R a H\"\n  shows \"rel_ran H\\<subseteq>inference_demand R K A\"\n  using inference_demand_step[OF assms(1,2)] assms(3-5)\n  by (auto simp: inference_premise_use_def rel_ran_def)\n\ntheorem inference_demand_origin:\n  assumes \"b\\<in>inference_demand R K A\" \"b\\<notin>A\"\n  shows \"\\<exists>a H i. a\\<in>inference_demand R K A \\<and> a\\<notin>K \\<and>\n    inference_premise_use R a H i b\"\nproof -\n  obtain q where initial: \"q\\<in>A\" and path: \"(q,b)\\<in>(inference_demand_edges R K)\\<^sup>*\"\n    using assms(1) by (auto simp: inference_demand_member)\n  obtain a where previous: \"(q,a)\\<in>(inference_demand_edges R K)\\<^sup>*\"\n    and edge: \"(a,b)\\<in>inference_demand_edges R K\"\n    using path assms(2) initial by (cases rule: rtranclE) auto\n  have demanded: \"a\\<in>inference_demand R K A\"\n    using previous initial by (auto simp: inference_demand_member)\n  show ?thesis using demanded edge by (auto simp: inference_demand_edges_def)\nqed\n\nlemma inference_demand_known_antimono:\n  assumes \"K\\<subseteq>L\"\n  shows \"inference_demand R L A\\<subseteq>inference_demand R K A\"\nproof -\n  have edges: \"inference_demand_edges R L\\<subseteq>inference_demand_edges R K\"\n    using assms by (auto simp: inference_demand_edges_def)\n  have paths: \"(inference_demand_edges R L)\\<^sup>*\\<subseteq>(inference_demand_edges R K)\\<^sup>*\"\n    by (rule rtrancl_mono[OF edges])\n  show ?thesis using paths by (auto simp: inference_demand_def)\nqed\n\ndefinition guided_inferences where\n  \"guided_inferences R K A a H \\<longleftrightarrow> R a H \\<and> a\\<in>inference_demand R K A\"\n\ntheorem inference_restriction_on_closed_demand:\n  assumes closed: \"\\<And>a H. a\\<in>D \\<Longrightarrow> a\\<notin>K \\<Longrightarrow>\n    finite H \\<Longrightarrow> single_valued H \\<Longrightarrow> R a H \\<Longrightarrow> rel_ran H\\<subseteq>D\"\n    and inside: \"a\\<in>D\"\n  shows \"a\\<in>inference_closure (\\<lambda>a H. R a H \\<and> a\\<in>D) K \\<longleftrightarrow>\n    a\\<in>inference_closure R K\"\nproof\n  assume \"a\\<in>inference_closure (\\<lambda>a H. R a H \\<and> a\\<in>D) K\"\n  then show \"a\\<in>inference_closure R K\"\n    using inference_refines_by_inclusion[where R=\"\\<lambda>a H. R a H \\<and> a\\<in>D\" and S=R]\n    by (auto simp: inference_refines_def)\nnext\n  assume original: \"a\\<in>inference_closure R K\"\n  have transfer: \"finite_inference R K b \\<Longrightarrow> b\\<in>D \\<Longrightarrow>\n      finite_inference (\\<lambda>a H. R a H \\<and> a\\<in>D) K b\" for b\n  proof (induction rule: finite_inference.induct)\n    case (seed b)\n    show ?case by (rule finite_inference.seed[OF seed.hyps])\n  next\n    case (step H b)\n    show ?case\n    proof (cases \"b\\<in>K\")\n      case True\n      show ?thesis by (rule finite_inference.seed[OF True])\n    next\n      case False\n      have support: \"rel_ran H\\<subseteq>D\"\n        by (rule closed[OF step.prems False step.hyps(1-3)])\n      show ?thesis by (rule finite_inference.step[OF step.hyps(1,2)])\n        (use step.hyps(3) step.prems step.IH support in auto)\n    qed\n  qed\n  show \"a\\<in>inference_closure (\\<lambda>a H. R a H \\<and> a\\<in>D) K\"\n    by (rule finite_inference_sound[OF transfer[OF finite_inference_complete[OF original] inside]])\nqed\n\ntheorem guided_inference_exact:\n  assumes \"a\\<in>inference_demand R K A\"\n  shows \"a\\<in>inference_closure (guided_inferences R K A) K \\<longleftrightarrow>\n    a\\<in>inference_closure R K\"\n  unfolding guided_inferences_def\n  by (rule inference_restriction_on_closed_demand[OF inference_demand_premises assms])\n\ntheorem guided_goal_residual_exact:\n  assumes \"rel_ran H\\<subseteq>A\"\n  shows \"remaining_obligations (inference_closure (guided_inferences R K A) K) H=\n    remaining_obligations (inference_closure R K) H\"\n  using assms inference_demand_initial[of A R K] guided_inference_exact[of _ R K A]\n  by (auto simp: remaining_obligations_def rel_ran_def)\n\ntheorem guided_inferences_sound:\n  \"inference_sound T R \\<Longrightarrow> inference_sound T (guided_inferences R K A)\"\n  by (auto simp: inference_sound_def guided_inferences_def)\n\ntheorem a_route_retains_every_unsettled_use:\n  assumes route: \"finite H\" \"single_valued H\" \"R a H\"\n  shows \"(i,b)\\<in>remaining_obligations K H \\<longleftrightarrow>\n      inference_premise_use R a H i b \\<and> b\\<notin>K\"\n    and \"remaining_obligations K H={} \\<Longrightarrow> a\\<in>inference_closure R K\"\nproof -\n  show \"(i,b)\\<in>remaining_obligations K H \\<longleftrightarrow>\n      inference_premise_use R a H i b \\<and> b\\<notin>K\"\n    using route by (simp add: inference_premise_use_def)\n  assume \"remaining_obligations K H={}\"\n  then have known: \"rel_ran H\\<subseteq>K\" by (simp only: remaining_obligations_empty)\n  have supported: \"rel_ran H\\<subseteq>inference_closure R K\"\n    by (rule subset_trans[OF known inference_closure_seed])\n  show \"a\\<in>inference_closure R K\"\n    by (rule inference_closure_step[where R=R and H=H, OF route supported])\nqed\n\ntheorem equal_conditions_keep_their_distinct_reasons:\n  assumes \"i\\<noteq>j\" \"inference_premise_use R a H i b\" \"inference_premise_use R a H j b\" \"b\\<notin>K\"\n  shows \"(i,b)\\<in>remaining_obligations K H \\<and> (j,b)\\<in>remaining_obligations K H \\<and> (i,b)\\<noteq>(j,b)\"\n  using assms by (auto simp: inference_premise_use_def)\n\ntheorem demand_reachability_does_not_discharge_a_goal:\n  defines \"R \\<equiv> (\\<lambda>a::bool. \\<lambda>H::(unit\\<times>bool) set. H={((),a)})\"\n  shows \"True\\<in>inference_demand R {} {True} \\<and> True\\<notin>inference_closure R {}\"\nproof -\n  have empty: \"inference_closure R {}={}\"\n    by (rule unsupported_inference_cycle) (simp add: R_def)\n  show ?thesis using inference_demand_initial[of \"{True}\" R \"{}\"] by (simp add: empty)\nqed\n\ntext \\<open>\n  A demanded condition expands through the actual available inference rules.\n  Each reason retains the rule's complete premise family and the particular\n  premise occurrence. Established conditions end their own expansion.\n  Alternatives remain separate rules; their premises remain conjunctive.\n\n  Backward reachability only identifies relevant work. Restricting inference\n  to this complete demand preserves every original answer to the requested\n  goals and their exact residual occurrences. The soundness of the rules and\n  the truth of the seeds remain separate obligations. A reachable unsupported\n  cycle is explicitly not a proof.\n\n  This construction supplies search guidance from the conditions produced by\n  an assessment. It uses neither a premise-count cutoff nor an immediate\n  improvement test to decide which deeper dependencies may matter.\n\\<close>\n\nend\n",
