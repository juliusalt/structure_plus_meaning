          "source": "theory Factor_Schema_Forests\n  imports Factor_Schema_Code\nbegin\n\nsection \\<open>Native recovery of independently scoped clause blocks\\<close>\n\nlemma schema_codes_forest_recovers:\n  fixes E :: \"local_address option artifact_environment\"\n  assumes lengths: \"length rs = length Rs\" \"length As = length Rs\" \"length Ls = length Rs\" \"length Cs = length Rs\"\n    and codes: \"\\<forall>i<length Rs. schema_code (Rs!i) (rs!i) (As!i) (Ls!i) (Cs!i)\"\n    and ef: \"environment_formed E\" and target: \"artifact_at E u T\"\n    and reads: \"object_reads_agree (syntax_forest Rs) T (rra_carrier (object_structure (syntax_forest Rs)))\"\n    and refs: \"syntax_references E u (syntax_forest_table Ls) (syntax_forest_table Cs)\"\n  shows \"\\<forall>i<length Rs. native_schema_at E u (syntax_branch i (rs!i))\n    (rename_schema (syntax_branch i) (syntax_branch i) id (As!i))\"\nproof -\n  have formed: \"\\<forall>R\\<in>set Rs. exact_formed R\"\n  proof (intro ballI)\n    fix R assume member: \"R \\<in> set Rs\"\n    obtain i where index: \"i < length Rs\" \"R=Rs!i\" using member by (metis in_set_conv_nth)\n    have code: \"schema_code (Rs!i) (rs!i) (As!i) (Ls!i) (Cs!i)\" using codes index(1) by blast\n    show \"exact_formed R\" using schema_code_properties(1)[OF code] index(2) by simp\n  qed\n  have counts: \"\\<forall>R\\<in>set Rs. bag_count (object_data R) = (\\<lambda>_. 0)\"\n  proof (intro ballI)\n    fix R assume member: \"R \\<in> set Rs\"\n    obtain i where index: \"i < length Rs\" \"R=Rs!i\" using member by (metis in_set_conv_nth)\n    have code: \"schema_code (Rs!i) (rs!i) (As!i) (Ls!i) (Cs!i)\" using codes index(1) by blast\n    show \"bag_count (object_data R) = (\\<lambda>_. 0)\" using schema_code_properties(2)[OF code] index(2) by simp\n  qed\n  show ?thesis\n  proof (intro allI impI)\n    fix i assume index: \"i < length Rs\"\n    have code: \"schema_code (Rs!i) (rs!i) (As!i) (Ls!i) (Cs!i)\" using codes index by blast\n    have dependencies: \"schema_dependencies (As!i) \\<subseteq> rel_ran (Cs!i)\"\n      using schema_code_properties(6)[OF code] by simp\n    have li: \"i < length Ls\" and ci: \"i < length Cs\" using lengths index by simp_all\n    have child_refs: \"syntax_references E u (map_slot_keys (syntax_branch i) (Ls!i))\n      (map_slot_keys (syntax_branch i) (Cs!i))\"\n      by (rule syntax_references_mono[OF refs syntax_forest_table_child[OF li] syntax_forest_table_child[OF ci]])\n    have child_reads: \"object_reads_agree (push_object (syntax_branch i) (Rs!i)) T\n      (syntax_branch i ` rra_carrier (object_structure (Rs!i)))\"\n      by (rule object_reads_agree_extend[OF syntax_forest_child_reads[OF formed counts index] reads])\n    show \"native_schema_at E u (syntax_branch i (rs!i))\n      (rename_schema (syntax_branch i) (syntax_branch i) id (As!i))\"\n      by (rule compiled_schema_copy[OF schema_code_properties(1,5,7)[OF code] dependencies ef target\n          syntax_branch_injective syntax_branch_addressing[OF schema_code_properties(1)[OF code]]\n          child_reads child_refs])\n  qed\nqed\n\ntheorem schema_forest_total:\n  fixes Ss :: \"('a,'s,local_address option definition_site) factor_schema list\"\n  assumes formed: \"\\<forall>S\\<in>set Ss. schema_formed S\"\n    and addresses: \"\\<forall>S\\<in>set Ss. \\<forall>d\\<in>schema_dependencies S. octets_formed (snd d)\"\n  shows \"\\<exists>R rs As L C. exact_formed R \\<and> bag_count (object_data R) = (\\<lambda>_. 0) \\<and>\n    length rs = length Ss \\<and> length As = length Ss \\<and> reference_table_formed L C \\<and>\n    rel_dom L \\<union> rel_dom C \\<subseteq> rra_carrier (object_structure R) \\<and>\n    rel_ran C = (\\<Union>S\\<in>set Ss. schema_dependencies S) \\<and> set rs \\<subseteq> rra_carrier (object_structure R) \\<and>\n    (\\<forall>i<length Ss. schema_alpha_variant (Ss!i) (As!i)) \\<and>\n    (\\<forall>E u. environment_formed E \\<longrightarrow> artifact_at E u R \\<longrightarrow>\n      syntax_references E u L C \\<longrightarrow>\n      (\\<forall>i<length Ss. native_schema_at E u (rs!i) (As!i)))\"\nproof -\n  obtain Rs :: \"exact_artifact list\" and rs :: \"local_address list\"\n    and As :: \"local_address option native_schema list\"\n    and Ls :: \"(local_address \\<times> exact_artifact) set list\"\n    and Cs :: \"(local_address \\<times> local_address option definition_site) set list\" where built:\n    \"length Rs = length Ss\" \"length rs = length Ss\" \"length As = length Ss\"\n    \"length Ls = length Ss\" \"length Cs = length Ss\"\n    \"\\<forall>i<length Ss. schema_alpha_variant (Ss!i) (As!i) \\<and> schema_code (Rs!i) (rs!i) (As!i) (Ls!i) (Cs!i)\"\n    using schema_code_list_total[OF formed addresses] by metis\n  let ?R = \"syntax_forest Rs\"\n  let ?rs = \"map (\\<lambda>i. syntax_branch i (rs!i)) [0..<length Ss]\"\n  let ?As = \"map (\\<lambda>i. rename_schema (syntax_branch i) (syntax_branch i) id (As!i)) [0..<length Ss]\"\n  let ?L = \"syntax_forest_table Ls\"\n  let ?C = \"syntax_forest_table Cs\"\n  have codes: \"\\<forall>i<length Rs. schema_code (Rs!i) (rs!i) (As!i) (Ls!i) (Cs!i)\"\n    using built(1,6) by simp\n  have each_formed: \"\\<forall>R\\<in>set Rs. exact_formed R\"\n    using codes schema_code_properties(1) by (metis in_set_conv_nth)\n  have rf: \"exact_formed ?R\" by (rule syntax_forest_formed[OF each_formed])\n  have profiles: \"\\<forall>i<length Ls. reference_table_formed (Ls!i) (Cs!i)\"\n    using built(1,4) codes schema_code_properties(4) by metis\n  have lc_len: \"length Ls = length Cs\" using built(4,5) by simp\n  have profile: \"reference_table_formed ?L ?C\" by (rule reference_table_forest[OF lc_len profiles])\n  have ll: \"length Ls = length Rs\" and cl: \"length Cs = length Rs\" using built(1,4,5) by simp_all\n  have lb: \"\\<forall>i<length Rs. rel_dom (Ls!i) \\<subseteq> rra_carrier (object_structure (Rs!i))\"\n    and cb: \"\\<forall>i<length Rs. rel_dom (Cs!i) \\<subseteq> rra_carrier (object_structure (Rs!i))\"\n    using codes schema_code_properties(5) by blast+\n  have bounds: \"rel_dom ?L \\<union> rel_dom ?C \\<subseteq> rra_carrier (object_structure ?R)\"\n    using syntax_forest_table_bounds[OF ll lb] syntax_forest_table_bounds[OF cl cb] by blast\n  have dependencies: \"\\<forall>i<length Ss. rel_ran (Cs!i) = schema_dependencies (Ss!i)\"\n  proof (intro allI impI)\n    fix i assume index: \"i < length Ss\"\n    have alpha: \"schema_alpha_variant (Ss!i) (As!i)\"\n      and code: \"schema_code (Rs!i) (rs!i) (As!i) (Ls!i) (Cs!i)\" using built(6) index by blast+\n    show \"rel_ran (Cs!i) = schema_dependencies (Ss!i)\"\n      using schema_code_properties(6)[OF code] schema_alpha_dependencies[OF alpha] by simp\n  qed\n  have mapped_dependencies: \"map rel_ran Cs = map schema_dependencies Ss\"\n    using dependencies built(5) by (intro nth_equalityI) auto\n  have ranges: \"(\\<Union>M\\<in>set Cs. rel_ran M) = (\\<Union>S\\<in>set Ss. schema_dependencies S)\"\n  proof -\n    have \"(\\<Union>M\\<in>set Cs. rel_ran M) = \\<Union>(set (map rel_ran Cs))\" by simp\n    also have \"\\<dots> = \\<Union>(set (map schema_dependencies Ss))\" by (simp only: mapped_dependencies)\n    also have \"\\<dots> = (\\<Union>S\\<in>set Ss. schema_dependencies S)\" by simp\n    finally show ?thesis .\n  qed\n  have range: \"rel_ran ?C = (\\<Union>S\\<in>set Ss. schema_dependencies S)\"\n    by (simp only: syntax_forest_table_range ranges)\n  have roots: \"set ?rs \\<subseteq> rra_carrier (object_structure ?R)\"\n  proof\n    fix a assume member: \"a \\<in> set ?rs\"\n    obtain i where index: \"i < length Ss\" \"a=syntax_branch i (rs!i)\" using member by auto\n    have code: \"schema_code (Rs!i) (rs!i) (As!i) (Ls!i) (Cs!i)\" using built(6) index(1) by blast\n    have small: \"i < length Rs\" using index(1) built(1) by simp\n    show \"a \\<in> rra_carrier (object_structure ?R)\"\n      using syntax_forest_child_inside[OF small schema_code_properties(3)[OF code]] index(2) by simp\n  qed\n  have alpha: \"\\<forall>i<length Ss. schema_alpha_variant (Ss!i) (?As!i)\"\n  proof (intro allI impI)\n    fix i assume index: \"i < length Ss\"\n    have original: \"schema_alpha_variant (Ss!i) (As!i)\" using built(6) index by blast\n    have copied: \"schema_alpha_variant (Ss!i) (rename_schema (syntax_branch i) (syntax_branch i) id (As!i))\"\n      by (rule schema_alpha_copy[OF original syntax_branch_injective])\n    show \"schema_alpha_variant (Ss!i) (?As!i)\" using copied index by simp\n  qed\n  have lengths: \"length rs = length Rs\" \"length As = length Rs\" \"length Ls = length Rs\" \"length Cs = length Rs\"\n    using built(1-5) by simp_all\n  have identity_reads: \"object_reads_agree ?R ?R (rra_carrier (object_structure ?R))\"\n    by (simp add: object_reads_agree_def)\n  have recover: \"\\<forall>E u. environment_formed E \\<longrightarrow> artifact_at E u ?R \\<longrightarrow>\n    syntax_references E u ?L ?C \\<longrightarrow> (\\<forall>i<length Ss. native_schema_at E u (?rs!i) (?As!i))\"\n  proof (rule allI, rule allI, rule impI, rule impI, rule impI)\n    fix E u assume ef: \"environment_formed E\" and source: \"artifact_at E u ?R\"\n      and refs: \"syntax_references E u ?L ?C\"\n    have reads: \"\\<forall>i<length Rs. native_schema_at E u (syntax_branch i (rs!i))\n      (rename_schema (syntax_branch i) (syntax_branch i) id (As!i))\"\n      by (rule schema_codes_forest_recovers[OF lengths codes ef source identity_reads refs])\n    show \"\\<forall>i<length Ss. native_schema_at E u (?rs!i) (?As!i)\" using reads built(1) by simp\n  qed\n  show ?thesis by (rule exI[of _ ?R], rule exI[of _ ?rs], rule exI[of _ ?As], rule exI[of _ ?L], rule exI[of _ ?C])\n    (use rf profile bounds range roots alpha recover in auto)\nqed\n\ntext \\<open>\n  Every complete finite source clause list has a finite syntax forest. Its\n  clauses retain their individual variable-sharing patterns, and all private\n  scopes are copied disjointly. The forest recovers every corresponding native\n  schema in the actual environment. Each schema is an injective binder and\n  socket renaming of its source, and the combined callee set is exactly the\n  union of the source dependencies, including for an empty clause list.\n\\<close>\n\nend\n",
