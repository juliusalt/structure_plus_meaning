          "theory": "Factor_Bag_Comparison",
          "source": "theory Factor_Bag_Comparison\n  imports Factor_Data_Comparison\nbegin\n\nsection \\<open>Complete lists and removal of one occurrence\\<close>\n\nabbreviation data_elements :: \"factor_term list \\<Rightarrow> bool\" where\n  \"data_elements xs \\<equiv> \\<forall>x\\<in>set xs. term_formed x \\<and> self_contained_term x\"\n\ndefinition data_list_nil_schema :: \"(nat,nat,nat) factor_schema\" where\n  \"data_list_nil_schema=data_rule (Pattern_Payload []) {}\"\n\ndefinition list_step_schema :: \"nat \\<Rightarrow> nat \\<Rightarrow> (nat,nat,nat) factor_schema\" where\n  \"list_step_schema element list=data_rule (Pattern_Pair data_x data_y)\n    {(0,element,data_x),(1,list,data_y)}\"\n\ndefinition data_list_cons_schema :: \"(nat,nat,nat) factor_schema\" where\n  \"data_list_cons_schema=list_step_schema 2 4\"\n\ndefinition data_list_clauses :: \"(nat \\<times> (nat,nat,nat) factor_schema) set\" where\n  \"data_list_clauses={(0,data_list_nil_schema),(1,data_list_cons_schema)}\"\n\ndefinition data_list_system :: \"(nat,nat,nat,nat) schema_system\" where\n  \"data_list_system=add_view_definition data_comparison_system 4 data_x data_list_clauses\"\n\ndefinition data_selection_here_schema :: \"(nat,nat,nat) factor_schema\" where\n  \"data_selection_here_schema=data_rule\n    (Pattern_Pair data_x (Pattern_Pair (Pattern_Pair data_x data_y) data_y))\n    {(0,2,data_x),(1,4,data_y)}\"\n\ndefinition selection_later_schema :: \"nat \\<Rightarrow> nat \\<Rightarrow> (nat,nat,nat) factor_schema\" where\n  \"selection_later_schema data select=data_rule\n    (Pattern_Pair data_x (Pattern_Pair (Pattern_Pair data_z data_y) (Pattern_Pair data_z data_w)))\n    {(0,data,data_z),(1,select,Pattern_Pair data_x (Pattern_Pair data_y data_w))}\"\n\ndefinition data_selection_later_schema :: \"(nat,nat,nat) factor_schema\" where\n  \"data_selection_later_schema=selection_later_schema 2 5\"\n\ndefinition data_selection_clauses :: \"(nat \\<times> (nat,nat,nat) factor_schema) set\" where\n  \"data_selection_clauses={(0,data_selection_here_schema),(1,data_selection_later_schema)}\"\n\ndefinition data_selection_system :: \"(nat,nat,nat,nat) schema_system\" where\n  \"data_selection_system=add_view_definition data_list_system 5 data_x data_selection_clauses\"\n\ndefinition bag_nil_schema :: \"(nat,nat,nat) factor_schema\" where\n  \"bag_nil_schema=data_rule (Pattern_Pair (Pattern_Payload []) (Pattern_Payload [])) {}\"\n\ndefinition bag_step_schema :: \"nat \\<Rightarrow> nat \\<Rightarrow> (nat,nat,nat) factor_schema\" where\n  \"bag_step_schema select bag=data_rule (Pattern_Pair (Pattern_Pair data_x data_y) data_z)\n    {(0,select,Pattern_Pair data_x (Pattern_Pair data_z data_w)),\n     (1,bag,Pattern_Pair data_y data_w)}\"\n\ndefinition bag_cons_schema :: \"(nat,nat,nat) factor_schema\" where\n  \"bag_cons_schema=bag_step_schema 5 6\"\n\ndefinition bag_comparison_clauses :: \"(nat \\<times> (nat,nat,nat) factor_schema) set\" where\n  \"bag_comparison_clauses={(0,bag_nil_schema),(1,bag_cons_schema)}\"\n\ndefinition bag_comparison_system :: \"(nat,nat,nat,nat) schema_system\" where\n  \"bag_comparison_system=add_view_definition data_selection_system 6 data_x bag_comparison_clauses\"\n\nlemmas data_list_schema_defs = data_list_nil_schema_def data_list_cons_schema_def list_step_schema_def\nlemmas data_selection_schema_defs = data_selection_here_schema_def data_selection_later_schema_def selection_later_schema_def\nlemmas bag_schema_defs = bag_nil_schema_def bag_cons_schema_def bag_step_schema_def\nlemmas bag_system_defs = bag_comparison_system_def data_selection_system_def data_list_system_def\n\nlemma data_list_system_formed [simp]: \"schema_system_formed data_list_system\"\n  unfolding data_list_system_def\n  by (rule add_recursive_definition_formed[OF data_comparison_system_formed])\n    (auto simp: data_list_clauses_def data_list_schema_defs schema_formed_def\n      schema_dependencies_def single_valued_def rel_dom_def rel_ran_def octets_formed_def)\n\nlemma data_list_definitions [simp]: \"system_definitions data_list_system={0,1,2,3,4}\"\n  by (auto simp: data_list_system_def)\n\nlemma data_selection_system_formed [simp]: \"schema_system_formed data_selection_system\"\n  unfolding data_selection_system_def\n  by (rule add_recursive_definition_formed[OF data_list_system_formed])\n    (auto simp: data_selection_clauses_def data_selection_schema_defs schema_formed_def\n      schema_dependencies_def single_valued_def rel_dom_def rel_ran_def)\n\nlemma data_selection_definitions [simp]: \"system_definitions data_selection_system={0,1,2,3,4,5}\"\n  by (auto simp: data_selection_system_def)\n\nlemma bag_comparison_system_formed [simp]: \"schema_system_formed bag_comparison_system\"\n  unfolding bag_comparison_system_def\n  by (rule add_recursive_definition_formed[OF data_selection_system_formed])\n    (auto simp: bag_comparison_clauses_def bag_schema_defs schema_formed_def\n      schema_dependencies_def single_valued_def rel_dom_def rel_ran_def octets_formed_def)\n\nlemma bag_comparison_definitions [simp]: \"system_definitions bag_comparison_system={0,1,2,3,4,5,6}\"\n  by (auto simp: bag_comparison_system_def)\n\nlemma bag_comparison_call:\n  \"schema_call_formed bag_comparison_system d t \\<longleftrightarrow> d\\<in>{0,1,2,3,4,5,6} \\<and> term_formed t\"\n  by (simp only: schema_call_formed_def bag_comparison_system_formed)\n    (auto simp: bag_system_defs data_comparison_system_def data_recognition_system_def\n      distinct_payloads_system_def)\n\nlemma data_list_old_meaning:\n  assumes \"d\\<in>{0,1,2,3}\"\n  shows \"(d,t)\\<in>positive_meaning data_list_system \\<longleftrightarrow>\n    (d,t)\\<in>positive_meaning data_comparison_system\"\n  using added_definition_preserves_old(2)[OF data_comparison_system_formed\n    data_list_system_formed[unfolded data_list_system_def], of d t] assms\n  by (auto simp: data_list_system_def)\n\nlemma data_selection_old_meaning:\n  assumes \"d\\<in>{0,1,2,3,4}\"\n  shows \"(d,t)\\<in>positive_meaning data_selection_system \\<longleftrightarrow>\n    (d,t)\\<in>positive_meaning data_list_system\"\n  using added_definition_preserves_old(2)[OF data_list_system_formed\n    data_selection_system_formed[unfolded data_selection_system_def], of d t] assms\n  by (auto simp: data_selection_system_def)\n\nlemma bag_comparison_previous_meaning:\n  assumes \"d\\<in>{0,1,2,3,4,5}\"\n  shows \"(d,t)\\<in>positive_meaning bag_comparison_system \\<longleftrightarrow>\n    (d,t)\\<in>positive_meaning data_selection_system\"\n  using added_definition_preserves_old(2)[OF data_selection_system_formed\n    bag_comparison_system_formed[unfolded bag_comparison_system_def], of d t] assms\n  by (auto simp: bag_comparison_system_def)\n\ntheorem bag_comparison_old_meaning:\n  assumes \"d\\<in>{0,1,2,3}\"\n  shows \"(d,t)\\<in>positive_meaning bag_comparison_system \\<longleftrightarrow>\n    (d,t)\\<in>positive_meaning data_comparison_system\"\n  using bag_comparison_previous_meaning[of d t] data_selection_old_meaning[of d t]\n    data_list_old_meaning[OF assms, of t] assms by auto\n\nlemma bag_comparison_recognizes:\n  \"(2,t)\\<in>positive_meaning bag_comparison_system \\<longleftrightarrow> term_formed t \\<and> self_contained_term t\"\n  using bag_comparison_old_meaning[of 2 t] data_comparison_recognizes[of t] by auto\n\nlemma bag_comparison_new_clauses [simp]:\n  \"((4,c),S)\\<in>system_clauses bag_comparison_system \\<longleftrightarrow> (c,S)\\<in>data_list_clauses\"\n  \"((5,c),S)\\<in>system_clauses bag_comparison_system \\<longleftrightarrow> (c,S)\\<in>data_selection_clauses\"\n  \"((6,c),S)\\<in>system_clauses bag_comparison_system \\<longleftrightarrow> (c,S)\\<in>bag_comparison_clauses\"\nproof -\n  have owned: \"((d,c),S)\\<in>system_clauses data_comparison_system \\<Longrightarrow>\n    d\\<in>system_definitions data_comparison_system\" for d c S\n    using data_comparison_system_formed unfolding schema_system_formed_def by blast\n  have absent: \"d\\<in>{4,5,6} \\<Longrightarrow> ((d,c),S)\\<notin>system_clauses data_comparison_system\" for d c S\n    by (auto dest: owned)\n  show \"((4,c),S)\\<in>system_clauses bag_comparison_system \\<longleftrightarrow> (c,S)\\<in>data_list_clauses\"\n    \"((5,c),S)\\<in>system_clauses bag_comparison_system \\<longleftrightarrow> (c,S)\\<in>data_selection_clauses\"\n    \"((6,c),S)\\<in>system_clauses bag_comparison_system \\<longleftrightarrow> (c,S)\\<in>bag_comparison_clauses\"\n    using absent by (auto simp: bag_system_defs)\nqed\n\nlemma bag_comparison_rule:\n  assumes clause: \"((d,c),S)\\<in>system_clauses bag_comparison_system\"\n    and ordinary: \"schema_material_premises S={}\"\n    and assignment: \"\\<forall>a\\<in>schema_variables S. term_formed (f a)\"\n    and support: \"\\<forall>s e p. (s,e,p)\\<in>schema_premises S \\<longrightarrow>\n      (e,evaluate_pattern f p)\\<in>positive_meaning bag_comparison_system\"\n  shows \"(d,evaluate_pattern f (schema_conclusion S))\\<in>positive_meaning bag_comparison_system\"\nproof -\n  have sf: \"schema_formed S\" and member: \"d\\<in>system_definitions bag_comparison_system\"\n    using clause bag_comparison_system_formed by (auto simp: schema_system_formed_def)\n  have tf: \"term_formed (evaluate_pattern f (schema_conclusion S))\"\n    by (rule evaluate_pattern_formed)\n      (use sf assignment in \\<open>auto simp: schema_formed_def schema_variables_def\\<close>)\n  have call: \"schema_call_formed bag_comparison_system d (evaluate_pattern f (schema_conclusion S))\"\n    using member tf by (simp add: bag_comparison_call)\n  show ?thesis by (rule ordinary_positive_valuation_step[OF clause ordinary assignment call support])\nqed\n\nsection \\<open>Exact recognition of the entire list boundary\\<close>\n\ntheorem data_list_sound:\n  assumes holds: \"(4,t)\\<in>positive_meaning bag_comparison_system\"\n  shows \"\\<exists>xs. t=data_list_term xs \\<and> data_elements xs\"\nproof -\n  have invariant: \"(4::nat)=4 \\<longrightarrow> (\\<exists>xs. t=data_list_term xs \\<and> data_elements xs)\"\n  proof (rule positive_valuation_induct[OF holds, where property=\"\\<lambda>d t.\n      d=4 \\<longrightarrow> (\\<exists>xs. t=data_list_term xs \\<and> data_elements xs)\"])\n    fix d c S f\n    assume clause: \"((d,c),S)\\<in>system_clauses bag_comparison_system\"\n      and assignment: \"\\<forall>a\\<in>schema_variables S. term_formed (f a)\"\n      and call: \"schema_call_formed bag_comparison_system d (evaluate_pattern f (schema_conclusion S))\"\n      and support: \"\\<forall>s e p. (s,e,p)\\<in>schema_premises S \\<longrightarrow>\n        (e,evaluate_pattern f p)\\<in>positive_meaning bag_comparison_system \\<and>\n        (e=4 \\<longrightarrow> (\\<exists>xs. evaluate_pattern f p=data_list_term xs \\<and> data_elements xs))\"\n    show \"d=4 \\<longrightarrow> (\\<exists>xs. evaluate_pattern f (schema_conclusion S)=data_list_term xs \\<and> data_elements xs)\"\n    proof\n      assume \"d=4\"\n      then have cases: \"S=data_list_nil_schema \\<or> S=data_list_cons_schema\"\n        using clause by (auto simp: data_list_clauses_def)\n      then show \"\\<exists>xs. evaluate_pattern f (schema_conclusion S)=data_list_term xs \\<and> data_elements xs\"\n      proof\n        assume \"S=data_list_nil_schema\"\n        then show ?thesis by (intro exI[of _ \"[]\"]) (simp add: data_list_nil_schema_def)\n      next\n        assume schema: \"S=data_list_cons_schema\"\n        have head: \"term_formed (f 0) \\<and> self_contained_term (f 0)\"\n          using support schema bag_comparison_recognizes[of \"f 0\"]\n          by (auto simp: data_list_cons_schema_def list_step_schema_def)\n        obtain xs where tail: \"f 1=data_list_term xs\" \"data_elements xs\"\n          using support[rule_format, of 1 4 data_y] schema by (auto simp: data_list_cons_schema_def list_step_schema_def)\n        show ?thesis by (intro exI[of _ \"f 0#xs\"])\n          (use head tail in \\<open>simp add: schema data_list_cons_schema_def list_step_schema_def\\<close>)\n      qed\n    qed\n  qed\n  show ?thesis using invariant by simp\nqed\n\ntheorem data_list_complete:\n  assumes \"data_elements xs\"\n  shows \"(4,data_list_term xs)\\<in>positive_meaning bag_comparison_system\"\n  using assms\nproof (induction xs)\n  case Nil\n  have result: \"(4,evaluate_pattern (\\<lambda>_. Payload_Term []) (schema_conclusion data_list_nil_schema))\n    \\<in>positive_meaning bag_comparison_system\"\n    by (rule bag_comparison_rule[where c=0])\n      (auto simp: data_list_clauses_def data_list_nil_schema_def schema_variables_def)\n  show ?case using result by (simp add: data_list_nil_schema_def)\nnext\n  case (Cons x xs)\n  have tail: \"(4,data_list_term xs)\\<in>positive_meaning bag_comparison_system\" using Cons by auto\n  have head: \"(2,x)\\<in>positive_meaning bag_comparison_system\"\n    using Cons.prems by (simp add: bag_comparison_recognizes)\n  let ?f=\"\\<lambda>a::nat. if a=0 then x else data_list_term xs\"\n  have result: \"(4,evaluate_pattern ?f (schema_conclusion data_list_cons_schema))\n    \\<in>positive_meaning bag_comparison_system\"\n    by (rule bag_comparison_rule[where c=1])\n      (use Cons.prems head tail in \\<open>auto simp: data_list_clauses_def data_list_cons_schema_def list_step_schema_def\n        schema_variables_def data_list_term_formed\\<close>)\n  show ?case using result by (simp add: data_list_cons_schema_def list_step_schema_def)\nqed\n\ntheorem data_list_exact:\n  \"(4,t)\\<in>positive_meaning bag_comparison_system \\<longleftrightarrow>\n    (\\<exists>xs. t=data_list_term xs \\<and> data_elements xs)\"\n  using data_list_sound data_list_complete by blast\n\nsection \\<open>Each selection removes exactly one matching occurrence\\<close>\n\ntheorem data_selection_sound:\n  assumes holds: \"(5,t)\\<in>positive_meaning bag_comparison_system\"\n  shows \"\\<exists>x pre post. t=Pair_Term x\n    (Pair_Term (data_list_term (pre@x#post)) (data_list_term (pre@post))) \\<and>\n    data_elements (pre@x#post)\"\nproof -\n  let ?Q=\"\\<lambda>t. \\<exists>x pre post. t=Pair_Term x\n    (Pair_Term (data_list_term (pre@x#post)) (data_list_term (pre@post))) \\<and>\n    data_elements (pre@x#post)\"\n  have invariant: \"(5::nat)=5 \\<longrightarrow> ?Q t\"\n  proof (rule positive_valuation_induct[OF holds, where property=\"\\<lambda>d t. d=5 \\<longrightarrow> ?Q t\"])\n    fix d c S f\n    assume clause: \"((d,c),S)\\<in>system_clauses bag_comparison_system\"\n      and assignment: \"\\<forall>a\\<in>schema_variables S. term_formed (f a)\"\n      and call: \"schema_call_formed bag_comparison_system d (evaluate_pattern f (schema_conclusion S))\"\n      and support: \"\\<forall>s e p. (s,e,p)\\<in>schema_premises S \\<longrightarrow>\n        (e,evaluate_pattern f p)\\<in>positive_meaning bag_comparison_system \\<and>\n        (e=5 \\<longrightarrow> ?Q (evaluate_pattern f p))\"\n    show \"d=5 \\<longrightarrow> ?Q (evaluate_pattern f (schema_conclusion S))\"\n    proof\n      assume \"d=5\"\n      then have cases: \"S=data_selection_here_schema \\<or> S=data_selection_later_schema\"\n        using clause by (auto simp: data_selection_clauses_def)\n      then show \"?Q (evaluate_pattern f (schema_conclusion S))\"\n      proof\n        assume schema: \"S=data_selection_here_schema\"\n        have head: \"term_formed (f 0) \\<and> self_contained_term (f 0)\"\n          using support schema bag_comparison_recognizes[of \"f 0\"]\n          by (auto simp: data_selection_here_schema_def)\n        have list: \"(4,f 1)\\<in>positive_meaning bag_comparison_system\"\n          using support schema by (auto simp: data_selection_here_schema_def)\n        obtain post where tail: \"f 1=data_list_term post\" \"data_elements post\"\n          using data_list_sound[OF list] by blast\n        show ?thesis by (intro exI[of _ \"f 0\"] exI[of _ \"[]\"] exI[of _ post])\n          (use head tail in \\<open>simp add: schema data_selection_here_schema_def\\<close>)\n      next\n        assume schema: \"S=data_selection_later_schema\"\n        have skipped: \"term_formed (f 2) \\<and> self_contained_term (f 2)\"\n          using support schema bag_comparison_recognizes[of \"f 2\"]\n          by (auto simp: data_selection_later_schema_def selection_later_schema_def)\n        obtain pre post where tail: \"f 1=data_list_term (pre@f 0#post)\"\n          \"f 3=data_list_term (pre@post)\" \"data_elements (pre@f 0#post)\"\n          using support[rule_format, of 1 5 \"Pattern_Pair data_x (Pattern_Pair data_y data_w)\"] schema\n          by (auto simp: data_selection_later_schema_def selection_later_schema_def)\n        show ?thesis by (intro exI[of _ \"f 0\"] exI[of _ \"f 2#pre\"] exI[of _ post])\n          (use skipped tail in \\<open>simp add: schema data_selection_later_schema_def selection_later_schema_def\\<close>)\n      qed\n    qed\n  qed\n  show ?thesis using invariant by simp\nqed\n\ntheorem data_selection_complete:\n  assumes \"data_elements (pre@x#post)\"\n  shows \"(5,Pair_Term x (Pair_Term (data_list_term (pre@x#post)) (data_list_term (pre@post))))\n    \\<in>positive_meaning bag_comparison_system\"\n  using assms\nproof (induction pre)\n  case Nil\n  have head: \"(2,x)\\<in>positive_meaning bag_comparison_system\"\n    using Nil.prems by (simp add: bag_comparison_recognizes)\n  have tail: \"(4,data_list_term post)\\<in>positive_meaning bag_comparison_system\"\n    by (rule data_list_complete) (use Nil.prems in auto)\n  let ?f=\"\\<lambda>a::nat. if a=0 then x else data_list_term post\"\n  have result: \"(5,evaluate_pattern ?f (schema_conclusion data_selection_here_schema))\n    \\<in>positive_meaning bag_comparison_system\"\n    by (rule bag_comparison_rule[where c=0])\n      (use Nil.prems head tail in \\<open>auto simp: data_selection_clauses_def data_selection_here_schema_def\n        schema_variables_def data_list_term_formed\\<close>)\n  show ?case using result by (simp add: data_selection_here_schema_def)\nnext\n  case (Cons z pre)\n  have skipped: \"(2,z)\\<in>positive_meaning bag_comparison_system\"\n    using Cons.prems by (simp add: bag_comparison_recognizes)\n  have tail: \"(5,Pair_Term x (Pair_Term (data_list_term (pre@x#post)) (data_list_term (pre@post))))\n    \\<in>positive_meaning bag_comparison_system\" using Cons by auto\n  let ?f=\"\\<lambda>a::nat. if a=0 then x else if a=1 then data_list_term (pre@x#post)\n    else if a=2 then z else data_list_term (pre@post)\"\n  have result: \"(5,evaluate_pattern ?f (schema_conclusion data_selection_later_schema))\n    \\<in>positive_meaning bag_comparison_system\"\n    by (rule bag_comparison_rule[where c=1])\n      (use Cons.prems skipped tail in \\<open>auto simp: data_selection_clauses_def data_selection_later_schema_def selection_later_schema_def\n        schema_variables_def data_list_term_formed\\<close>)\n  show ?case using result by (simp add: data_selection_later_schema_def selection_later_schema_def)\nqed\n\ntheorem data_selection_exact:\n  \"(5,Pair_Term x (Pair_Term (data_list_term xs) (data_list_term ys)))\n    \\<in>positive_meaning bag_comparison_system \\<longleftrightarrow>\n    data_elements xs \\<and> (\\<exists>pre post. xs=pre@x#post \\<and> ys=pre@post)\"\nproof\n  assume holds: \"(5,Pair_Term x (Pair_Term (data_list_term xs) (data_list_term ys)))\n    \\<in>positive_meaning bag_comparison_system\"\n  show \"data_elements xs \\<and> (\\<exists>pre post. xs=pre@x#post \\<and> ys=pre@post)\"\n    using data_selection_sound[OF holds] by (auto simp: data_list_term_injective)\nnext\n  assume \"data_elements xs \\<and> (\\<exists>pre post. xs=pre@x#post \\<and> ys=pre@post)\"\n  then show \"(5,Pair_Term x (Pair_Term (data_list_term xs) (data_list_term ys)))\n    \\<in>positive_meaning bag_comparison_system\"\n    using data_selection_complete by blast\nqed\n\nabbreviation selected_data_member :: \"factor_term \\<Rightarrow> factor_term \\<Rightarrow> bool\" where\n  \"selected_data_member x t \\<equiv>\n    \\<exists>r. (5,Pair_Term x (Pair_Term t r))\\<in>positive_meaning bag_comparison_system\"\n\nlemma selected_data_member_exact:\n  \"selected_data_member x t \\<longleftrightarrow>\n    (\\<exists>xs. t=data_list_term xs \\<and> data_elements xs \\<and> x\\<in>set xs)\"\nproof\n  assume \"selected_data_member x t\"\n  then obtain r where step: \"(5,Pair_Term x (Pair_Term t r))\\<in>positive_meaning bag_comparison_system\" by blast\n  obtain pre post where parts: \"t=data_list_term (pre@x#post)\" \"data_elements (pre@x#post)\"\n    using data_selection_sound[OF step] by auto\n  show \"\\<exists>xs. t=data_list_term xs \\<and> data_elements xs \\<and> x\\<in>set xs\"\n    by (intro exI[of _ \"pre@x#post\"]) (use parts in auto)\nnext\n  assume \"\\<exists>xs. t=data_list_term xs \\<and> data_elements xs \\<and> x\\<in>set xs\"\n  then obtain xs where parts: \"t=data_list_term xs\" \"data_elements xs\" \"x\\<in>set xs\" by blast\n  obtain pre post where split: \"xs=pre@x#post\" using split_list[OF parts(3)] by blast\n  have step: \"(5,Pair_Term x (Pair_Term t (data_list_term (pre@post))))\\<in>positive_meaning bag_comparison_system\"\n    using data_selection_complete[of pre x post] parts(1,2) split by simp\n  show \"selected_data_member x t\" using step by blast\nqed\n\nlemma selected_data_member_formed:\n  assumes \"selected_data_member x t\"\n  shows \"term_formed x \\<and> self_contained_term x \\<and> term_formed t \\<and> self_contained_term t\"\n  using assms by (auto simp: selected_data_member_exact data_list_term_formed data_list_term_self_contained)\n\nlemma data_collection_selection:\n  assumes read: \"data_collection_presents R A a\"\n    and formed: \"\\<And>z t. z\\<in>A \\<Longrightarrow> R z t \\<Longrightarrow> term_formed t \\<and> self_contained_term t\"\n  shows \"(\\<forall>z\\<in>A. \\<exists>t. selected_data_member t a \\<and> R z t) \\<and>\n    (\\<forall>t. selected_data_member t a \\<longrightarrow> (\\<exists>z\\<