          "theory": "Factor_List_Set_Presentations",
          "source": "theory Factor_List_Set_Presentations\n  imports Factor_Finite_Set_Presentations\nbegin\n\nsection \\<open>Repeated displayed rows can present the same finite set\\<close>\n\ndefinition data_list_fset_presents ::\n  \"('a\\<Rightarrow>factor_term\\<Rightarrow>bool) \\<Rightarrow> 'a fset \\<Rightarrow> factor_term \\<Rightarrow> bool\" where\n  \"data_list_fset_presents R S t \\<longleftrightarrow>\n    (\\<exists>xs. data_sequence_presents R xs t \\<and> fset_of_list xs=S)\"\n\ntheorem data_list_fset_presentation_class:\n  assumes source: \"presentation_class R D A\"\n  shows \"presentation_class (data_list_fset_presents R)\n    (\\<lambda>S. \\<forall>a\\<in>fset S. D a)\n    (\\<lambda>t. \\<exists>ps. (\\<forall>p\\<in>set ps. A p) \\<and> t=data_list_term ps)\"\nproof -\n  have sequences: \"presentation_class (data_sequence_presents R)\n      (\\<lambda>xs. \\<forall>a\\<in>set xs. D a)\n      (\\<lambda>t. \\<exists>ps. (\\<forall>p\\<in>set ps. A p) \\<and> t=data_list_term ps)\"\n    by (rule data_sequence_presentation_class[OF source])\n  have image: \"presentation_class\n      (\\<lambda>S t. \\<exists>xs. data_sequence_presents R xs t \\<and> fset_of_list xs=S)\n      (\\<lambda>S. \\<forall>a\\<in>fset S. D a)\n      (\\<lambda>t. \\<exists>ps. (\\<forall>p\\<in>set ps. A p) \\<and> t=data_list_term ps)\"\n  proof (rule presentation_class_image[OF sequences])\n    fix xs assume \"\\<forall>a\\<in>set xs. D a\"\n    then show \"\\<forall>a\\<in>fset (fset_of_list xs). D a\" by (simp add: fset_of_list.rep_eq)\n  next\n    fix S assume domain: \"\\<forall>a\\<in>fset S. D a\"\n    obtain xs where enumeration: \"set xs=fset S\"\n      using finite_distinct_list[OF finite_fset[of S]] by blast\n    have represented: \"fset_of_list xs=S\"\n      by (rule fset_inject[THEN iffD1]) (simp add: fset_of_list.rep_eq enumeration)\n    show \"\\<exists>xs. (\\<forall>a\\<in>set xs. D a) \\<and> fset_of_list xs=S\"\n      by (rule exI[of _ xs]) (use represented enumeration domain in simp)\n  qed\n  show ?thesis using image by (simp only: data_list_fset_presents_def presentation_class_def)\nqed\n\nlemma data_list_fset_presents_function:\n  \"data_list_fset_presents (\\<lambda>a p. D a \\<and> p=f a) S t \\<longleftrightarrow>\n    (\\<exists>xs. (\\<forall>a\\<in>set xs. D a) \\<and> fset_of_list xs=S \\<and> t=data_list_term (map f xs))\"\nproof -\n  have element: \"(\\<lambda>a p. D a \\<and> p=f a)=(\\<lambda>a p. p=f a \\<and> D a)\"\n    by (intro ext) auto\n  show ?thesis\n    by (auto simp only: data_list_fset_presents_def data_sequence_presents_def element\n      list_all2_function_restricted)\nqed\n\nlemma data_list_fset_presents_identity:\n  \"data_list_fset_presents (\\<lambda>a p. D a \\<and> p=a) S (data_list_term xs) \\<longleftrightarrow>\n    (\\<forall>a\\<in>set xs. D a) \\<and> fset_of_list xs=S\"\nproof -\n  have rows: \"list_all2 (\\<lambda>a p. D a \\<and> p=a) ys xs \\<longleftrightarrow>\n      ys=xs \\<and> (\\<forall>a\\<in>set xs. D a)\" for ys xs\n    by (induction ys arbitrary: xs) (auto simp: list_all2_Cons1)\n  show ?thesis\n    by (auto simp: data_list_fset_presents_def data_sequence_presents_def data_list_term_injective rows)\nqed\n\nlemma data_list_fset_presents_finite_image:\n  assumes \"data_sequence_presents R xs t\"\n  shows \"data_list_fset_presents R (fset_of_list xs) t\"\n  using assms by (auto simp: data_list_fset_presents_def)\n\ncontext list_profile\nbegin\n\ntheorem finite_set_class:\n  assumes element: \"presentation_class R D (\\<lambda>t. (element_site,t)\\<in>positive_meaning P)\"\n  shows \"presentation_class (data_list_fset_presents R) (\\<lambda>S. \\<forall>a\\<in>fset S. D a)\n    (\\<lambda>t. (list_site,t)\\<in>positive_meaning P)\"\nproof -\n  have source: \"presentation_class (data_list_fset_presents R) (\\<lambda>S. \\<forall>a\\<in>fset S. D a)\n      (\\<lambda>t. \\<exists>xs. (\\<forall>x\\<in>set xs. (element_site,x)\\<in>positive_meaning P) \\<and> t=data_list_term xs)\"\n    by (rule data_list_fset_presentation_class[OF element])\n  have admission: \"(\\<lambda>t. \\<exists>xs. (\\<forall>x\\<in>set xs. (element_site,x)\\<in>positive_meaning P) \\<and> t=data_list_term xs)=\n      (\\<lambda>t. (list_site,t)\\<in>positive_meaning P)\"\n    by (rule ext) (simp only: exact; blast)\n  show ?thesis using source by (simp only: admission)\nqed\n\nend\n\ntext \\<open>\n  This class is the covered image of the complete sequence class under the\n  existing finite-set operation. The subject retains each member; the displayed\n  list retains its own order and repeated occurrences. Every allowed element\n  presentation and every displayed enumeration remains available. No count\n  or order of that displayed list becomes part of finite-set identity.\n\n  The earlier distinct-member collection class remains unchanged. This class\n  supplies the broader input convention already used by the finite evaluator,\n  whose list interface discards repeated identical rows only when interpreting\n  the represented finite relation. Counted subjects still use their bag class.\n\\<close>\n\nend\n",
