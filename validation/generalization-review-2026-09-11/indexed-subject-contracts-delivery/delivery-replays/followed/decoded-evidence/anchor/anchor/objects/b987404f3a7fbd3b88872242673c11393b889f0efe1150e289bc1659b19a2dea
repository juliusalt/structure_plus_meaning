          "source": "theory Presentation_Function_Witnesses\n  imports Presentation_Contract_Constructions\nbegin\n\nsection \\<open>A returned witness has a complete subject boundary\\<close>\n\nlocale presented_function_witness =\n  left: presentation_class R D A + right: presentation_class S E B\n  for R :: \"'a \\<Rightarrow> 'p \\<Rightarrow> bool\" and D A\n    and S :: \"'b \\<Rightarrow> 'q \\<Rightarrow> bool\" and E B +\n  fixes f :: \"'a \\<Rightarrow> 'b\" and operation :: \"'p \\<Rightarrow> 'q \\<Rightarrow> bool\"\n  assumes input_boundary: \"\\<And>p q. operation p q \\<Longrightarrow> A p\"\n    and sound: \"\\<And>a p q. R a p \\<Longrightarrow> operation p q \\<Longrightarrow> S (f a) q\"\n    and total: \"\\<And>p. A p \\<Longrightarrow> \\<exists>q. operation p q\"\nbegin\n\ntheorem input_exact:\n  \"(\\<exists>q. operation p q) \\<longleftrightarrow> A p\"\n  using input_boundary total by blast\n\nlemma image_boundary:\n  assumes \"D a\"\n  shows \"E (f a)\"\nproof -\n  obtain p where read: \"R a p\" using left.total[OF assms] by blast\n  obtain q where result: \"operation p q\" using total[OF left.presentation_boundary[OF read]] by blast\n  show ?thesis by (rule right.subject_boundary[OF sound[OF read result]])\nqed\n\nlemma output_boundary:\n  assumes \"operation p q\"\n  shows \"B q\"\nproof -\n  obtain a where read: \"R a p\" using left.admitted[OF input_boundary[OF assms]] by blast\n  show ?thesis by (rule right.presentation_boundary[OF sound[OF read assms]])\nqed\n\ntheorem output_equivalence:\n  assumes \"operation p q\" \"operation p r\"\n  shows \"presentation_transport S S q r\"\nproof -\n  obtain a where read: \"R a p\" using left.admitted[OF input_boundary[OF assms(1)]] by blast\n  show ?thesis using sound[OF read assms(1)] sound[OF read assms(2)]\n    by (auto simp: presentation_transport_def)\nqed\n\nsection \\<open>A complete downstream relation consumes any returned witness\\<close>\n\ntheorem postrelation:\n  assumes following: \"presented_relation_contract S E B T F C L check\"\n  shows \"presented_relation_contract R D A T F C (\\<lambda>a c. L (f a) c)\n    (\\<lambda>p r. \\<exists>q. operation p q \\<and> check q r)\"\nproof -\n  interpret following: presented_relation_contract S E B T F C L check by (rule following)\n  have exact: \"(\\<exists>q. operation p q \\<and> check q r) \\<longleftrightarrow>\n      presented_relation R T (\\<lambda>a c. L (f a) c) p r\" for p r\n  proof\n    assume \"\\<exists>q. operation p q \\<and> check q r\"\n    then obtain q where run: \"operation p q\" and checked: \"check q r\" by blast\n    obtain a where read: \"R a p\" using left.admitted[OF input_boundary[OF run]] by blast\n    have result: \"S (f a) q\" by (rule sound[OF read run])\n    obtain c where target: \"T c r\" and link: \"L (f a) c\"\n      using checked by (simp only: following.at_source[OF result]; blast)\n    show \"presented_relation R T (\\<lambda>a c. L (f a) c) p r\"\n      using read target link by (auto simp: presented_relation_def)\n  next\n    assume \"presented_relation R T (\\<lambda>a c. L (f a) c) p r\"\n    then obtain a c where read: \"R a p\" and target: \"T c r\" and link: \"L (f a) c\"\n      by (auto simp: presented_relation_def)\n    obtain q where run: \"operation p q\" using total[OF left.presentation_boundary[OF read]] by blast\n    have result: \"S (f a) q\" by (rule sound[OF read run])\n    have checked: \"check q r\" using link by (simp only: following.at[OF result target])\n    show \"\\<exists>q. operation p q \\<and> check q r\" using run checked by blast\n  qed\n  show ?thesis using left.presentation_class_axioms following.right.presentation_class_axioms exact\n    by (simp add: presented_relation_contract_def presented_relation_contract_axioms_def)\nqed\n\ntheorem postcompose:\n  assumes following: \"presented_function_contract S E B T F C g check\"\n  shows \"presented_function_contract R D A T F C (g\\<circ>f)\n    (\\<lambda>p r. \\<exists>q. operation p q \\<and> check q r)\"\nproof -\n  interpret following: presented_function_contract S E B T F C g check by (rule following)\n  show ?thesis using postrelation[OF following.presented_relation_contract_axioms]\n    image_boundary following.image_boundary\n    by (simp add: presented_function_contract_def presented_function_contract_axioms_def)\nqed\n\ntheorem completion:\n  \"presented_function_contract R D A S E B f\n    (\\<lambda>p r. \\<exists>q. operation p q \\<and> presentation_transport S S q r)\"\n  using postcompose[OF presentation_identity_function[OF right.presentation_class_axioms\n      right.presentation_class_axioms]] by simp\n\ntheorem completion_by_comparison:\n  assumes comparison: \"\\<And>b q r. S b q \\<Longrightarrow> (check q r \\<longleftrightarrow> S b r)\"\n  shows \"presented_function_contract R D A S E B f (\\<lambda>p r. \\<exists>q. operation p q \\<and> check q r)\"\nproof -\n  have transport: \"presentation_transport S S q r \\<longleftrightarrow> S b r\" if \"S b q\" for b q r\n    using presented_function_contract.output[OF presentation_identity_function[\n      OF right.presentation_class_axioms right.presentation_class_axioms] that] by simp\n  have checked: \"check q r \\<longleftrightarrow> presentation_transport S S q r\"\n    if run: \"operation p q\" for p q r\n  proof -\n    obtain a where source: \"R a p\" using left.admitted[OF input_boundary[OF run]] by blast\n    have computed: \"S (f a) q\" by (rule sound[OF source run])\n    show ?thesis by (simp only: comparison[OF computed] transport[OF computed])\n  qed\n  have same: \"(\\<lambda>p r. \\<exists>q. operation p q \\<and> check q r)=\n      (\\<lambda>p r. \\<exists>q. operation p q \\<and> presentation_transport S S q r)\"\n    by (intro ext) (use checked in blast)\n  show ?thesis using completion by (simp only: same)\nqed\n\ntheorem predicate_transfer:\n  assumes check: \"\\<And>b q. S b q \\<Longrightarrow> (test q \\<longleftrightarrow> L b)\"\n  shows \"(\\<exists>q. operation p q \\<and> test q) \\<longleftrightarrow>\n    presented_predicate R (\\<lambda>a. L (f a)) p\"\nproof\n  assume \"\\<exists>q. operation p q \\<and> test q\"\n  then obtain q where run: \"operation p q\" and checked: \"test q\" by blast\n  obtain a where read: \"R a p\" using left.admitted[OF input_boundary[OF run]] by blast\n  have link: \"L (f a)\" using checked check[OF sound[OF read run]] by blast\n  show \"presented_predicate R (\\<lambda>a. L (f a)) p\"\n    using read link by (auto simp: presented_predicate_def)\nnext\n  assume \"presented_predicate R (\\<lambda>a. L (f a)) p\"\n  then obtain a where read: \"R a p\" and link: \"L (f a)\" by (auto simp: presented_predicate_def)\n  obtain q where run: \"operation p q\" using total[OF left.presentation_boundary[OF read]] by blast\n  have checked: \"test q\" using link check[OF sound[OF read run]] by blast\n  show \"\\<exists>q. operation p q \\<and> test q\" using run checked by blast\nqed\n\nsection \\<open>Restrictions and actual presentation changes remain local\\<close>\n\ntheorem specialization:\n  assumes boundary: \"\\<And>a. K a \\<Longrightarrow> D a\"\n  shows \"presented_function_witness (\\<lambda>a p. K a \\<and> R a p) K\n    (presented_predicate R K) S E B f\n    (\\<lambda>p q. presented_predicate R K p \\<and> operation p q)\"\nproof -\n  have source: \"presentation_class (\\<lambda>a p. K a \\<and> R a p) K (presented_predicate R K)\"\n    using presentation_class_subdomain[OF left.presentation_class_axioms boundary]\n    by (simp only: presentation_class_def presented_predicate_def conj_commute)\n  show ?thesis\n  proof (rule presented_function_witness.intro[OF source right.presentation_class_axioms]; unfold_locales)\n    fix p q assume \"presented_predicate R K p \\<and> operation p q\"\n    then show \"presented_predicate R K p\" by blast\n  next\n    fix a p q assume \"K a \\<and> R a p\" \"presented_predicate R K p \\<and> operation p q\"\n    then show \"S (f a) q\" u