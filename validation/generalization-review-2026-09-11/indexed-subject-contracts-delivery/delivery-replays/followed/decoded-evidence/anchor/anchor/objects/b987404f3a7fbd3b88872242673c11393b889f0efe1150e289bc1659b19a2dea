          "theory": "Factor_Site_Values",
          "source": "theory Factor_Site_Values\n  imports Factor_Environment_Values Factor_Complete_Data_Quotation\nbegin\n\nsection \\<open>One exact scope and one actual site\\<close>\n\ndefinition site_value_presents ::\n  \"local_address option artifact_environment \\<Rightarrow> local_address option \\<Rightarrow> local_address \\<Rightarrow>\n    factor_term \\<Rightarrow> bool\" where\n  \"site_value_presents E u r t \\<longleftrightarrow> (u,r)\\<in>environment_positions E \\<and>\n    (\\<exists>e. environment_value_presents E e \\<and> t=Pair_Term e (site_data_term u r))\"\n\ntheorem site_value_presents_unique:\n  assumes first: \"site_value_presents E u r t\" and second: \"site_value_presents F v s t\"\n  shows \"E=F \\<and> u=v \\<and> r=s\"\nproof -\n  obtain e where left: \"environment_value_presents E e\" \"t=Pair_Term e (site_data_term u r)\"\n    using first unfolding site_value_presents_def by blast\n  obtain f where right: \"environment_value_presents F f\" \"t=Pair_Term f (site_data_term v s)\"\n    using second unfolding site_value_presents_def by blast\n  have same: \"e=f\" and sites: \"u=v \\<and> r=s\" using left(2) right(2) by simp_all\n  have other: \"environment_value_presents F e\" using right(1) same by simp\n  show ?thesis using environment_value_presents_unique[OF left(1) other] sites by blast\nqed\n\nlemma site_value_presents_formed:\n  assumes present: \"site_value_presents E u r t\"\n  shows \"environment_formed E \\<and> term_formed t \\<and> self_contained_term t\"\nproof -\n  obtain e where site: \"(u,r)\\<in>environment_positions E\"\n    and body: \"environment_value_presents E e\" and encoded: \"t=Pair_Term e (site_data_term u r)\"\n    using present unfolding site_value_presents_def by blast\n  have ef: \"environment_formed E\" and formed: \"term_formed e\" and closed: \"self_contained_term e\"\n    using environment_value_presents_formed[OF body] by auto\n  have address: \"octets_formed r\" using environment_position_address[OF ef site] by simp\n  show ?thesis using ef formed closed address encoded by simp\nqed\n\ntheorem site_value_presents_total:\n  assumes formed: \"environment_formed E\" and site: \"(u,r)\\<in>environment_positions E\"\n  shows \"\\<exists>t. site_value_presents E u r t\"\nproof -\n  obtain e where body: \"environment_value_presents E e\" using environment_value_presents_total[OF formed] by blast\n  show ?thesis by (rule exI[of _ \"Pair_Term e (site_data_term u r)\"])\n    (use site body in \\<open>auto simp: site_value_presents_def\\<close>)\nqed\n\ndefinition site_value_quoted_at ::\n  \"exact_artifact \\<Rightarrow> local_address \\<Rightarrow> local_address option artifact_environment \\<Rightarrow>\n    local_address option \\<Rightarrow> local_address \\<Rightarrow> bool\" where\n  \"site_value_quoted_at C q E u r \\<longleftrightarrow>\n    (\\<exists>t. site_value_presents E u r t \\<and> complete_data_quoted_at C q t)\"\n\ntheorem site_value_quoted_unique:\n  assumes first: \"site_value_quoted_at C q E u r\" and second: \"site_value_quoted_at C q F v s\"\n  shows \"E=F \\<and> u=v \\<and> r=s\"\nproof -\n  obtain t where left: \"site_value_presents E u r t\" \"complete_data_quoted_at C q t\"\n    using first unfolding site_value_quoted_at_def by blast\n  obtain a where right: \"site_value_presents F v s a\" \"complete_data_quoted_at C q a\"\n    using second unfolding site_value_quoted_at_def by blast\n  have same: \"t=a\" by (rule complete_data_quotation_unique[OF left(2) right(2)])\n  have other: \"site_value_presents F v s t\" using right(1) same by simp\n  show ?thesis by (rule site_value_presents_unique[OF left(1) other])\nqed\n\nlemma site_value_quoted_formed:\n  assumes quote: \"site_value_quoted_at C q E u r\"\n  shows \"exact_formed C \\<and> environment_formed E \\<and> (u,r)\\<in>environment_positions E\"\nproof -\n  obtain t where present: \"site_value_presents E u r t\" and full: \"complete_data_quoted_at C q t\"\n    using quote unfolding site_value_quoted_at_def by blast\n  show ?thesis using complete_data_quotation_formed[OF full] site_value_presents_formed[OF present]\n    present by (auto simp: site_value_presents_def)\nqed\n\nlemma site_value_quoted_anchor:\n  assumes quote: \"site_value_quoted_at C q E u r\"\n  shows \"anchor_formed (C,q)\"\nproof -\n  obtain t where full: \"complete_data_quoted_at C q t\" using quote unfolding site_value_quoted_at_def by blast\n  show ?thesis by (rule complete_data_quotation_anchor[OF full])\nqed\n\ntheorem site_value_quoted_total:\n  assumes formed: \"environment_formed E\" and site: \"(u,r)\\<in>environment_positions E\"\n  shows \"\\<exists>C. exact_formed C \\<and> site_value_quoted_at C [] E u r\"\nproof -\n  obtain t where present: \"site_value_presents E u r t\" using site_value_presents_total[OF formed site] by blast\n  have tf: \"term_formed t\" and closed: \"self_contained_term t\" using site_value_presents_formed[OF present] by auto\n  have full: \"complete_data_quoted_at (term_syntax t) [] t\"\n    by (rule complete_data_quotation_total[OF tf closed])\n  have cf: \"exact_formed (term_syntax t)\" using complete_data_quotation_formed[OF full] by blast\n  show ?thesis by (rule exI[of _ \"term_syntax t\"])\n    (use present full cf in \\<open>auto simp: site_value_quoted_at_def\\<close>)\nqed\n\ntheorem site_value_quoted_in_environment:\n  assumes quote: \"site_value_quoted_at C q E u r\" and formed: \"environment_formed F\" and source: \"artifact_at F v C\"\n  shows \"\\<exists>t. site_value_presents E u r t \\<and>\n    term_quoted_at F v q t (rra_carrier (object_structure C)) {}\"\nproof -\n  obtain t where present: \"site_value_presents E u r t\" and full: \"complete_data_quoted_at C q t\"\n    using quote unfolding site_value_quoted_at_def by blast\n  have native: \"term_quoted_at F v q t (rra_carrier (object_structure C)) {}\"\n    by (rule self_contained_quoted_in_environment[OF complete_data_quotation_native[OF full] formed source])\n  show ?thesis using present native by blast\nqed\n\ntext \\<open>\n  The complete environment and its selected site are exact data. The quotation\n  recovers both without consulting an outer binding. The actual-site condition\n  does not assign a grammar or a semantic role to that site. Each higher reader\n  checks its own syntax and determines the scope that it needs to retain.\n  Collections admit every complete presentation; no chosen enumeration is\n  thereby admitted as a semantic distinction.\n\\<close>\n\nend\n",
