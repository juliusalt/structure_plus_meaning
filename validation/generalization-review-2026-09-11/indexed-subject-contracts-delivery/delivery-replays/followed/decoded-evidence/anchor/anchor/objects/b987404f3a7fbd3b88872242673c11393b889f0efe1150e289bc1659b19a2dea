          "theory": "Factor_System_Restriction",
          "source": "theory Factor_System_Restriction\n  imports Factor_Definition_Closure\nbegin\n\nsection \\<open>Retaining complete definitions on a closed boundary\\<close>\n\ndefinition system_restriction :: \"('a,'s,'d,'c) schema_system \\<Rightarrow> 'd set \\<Rightarrow> ('a,'s,'d,'c) schema_system\" where\n  \"system_restriction P U=\\<lparr>\n    system_interfaces={(d,p)\\<in>system_interfaces P. d\\<in>U},\n    system_clauses={((d,c),S)\\<in>system_clauses P. d\\<in>U}\\<rparr>\"\n\nlemma system_restriction_interfaces [simp]:\n  \"(d,p)\\<in>system_interfaces (system_restriction P U) \\<longleftrightarrow> d\\<in>U \\<and> (d,p)\\<in>system_interfaces P\"\n  by (auto simp: system_restriction_def)\n\nlemma system_restriction_clauses [simp]:\n  \"((d,c),S)\\<in>system_clauses (system_restriction P U) \\<longleftrightarrow> d\\<in>U \\<and> ((d,c),S)\\<in>system_clauses P\"\n  by (auto simp: system_restriction_def)\n\nlemma system_restriction_definitions [simp]:\n  \"system_definitions (system_restriction P U)=system_definitions P\\<inter>U\"\n  by (auto simp: system_definitions_def rel_dom_def)\n\nlemma system_restriction_agreement:\n  \"systems_agree_on P (system_restriction P U) U\"\n  by (simp add: systems_agree_on_def)\n\nlemma system_restriction_intersection:\n  \"system_restriction (system_restriction P U) V=system_restriction P (U\\<inter>V)\"\n  by (auto simp: system_restriction_def)\n\ntheorem system_restriction_formed:\n  assumes formed: \"schema_system_formed P\" and closed: \"system_dependency_closed P U\"\n  shows \"schema_system_formed (system_restriction P U)\"\nproof -\n  have old_finite: \"finite (system_interfaces P)\" \"finite (system_clauses P)\"\n    using formed unfolding schema_system_formed_def by blast+\n  have subsets: \"system_interfaces (system_restriction P U)\\<subseteq>system_interfaces P\"\n    \"system_clauses (system_restriction P U)\\<subseteq>system_clauses P\"\n    by (auto simp: system_restriction_def)\n  have finite: \"finite (system_interfaces (system_restriction P U))\"\n    \"finite (system_clauses (system_restriction P U))\"\n    using finite_subset[OF subsets(1) old_finite(1)] finite_subset[OF subsets(2) old_finite(2)] by blast+\n  have old_interfaces: \"single_valued (system_interfaces P)\"\n    and old_clauses: \"single_valued (system_clauses P)\"\n    using formed unfolding schema_system_formed_def by blast+\n  have interfaces: \"single_valued (system_interfaces (system_restriction P U))\"\n    and clauses: \"single_valued (system_clauses (system_restriction P U))\"\n    using old_interfaces old_clauses by (auto simp: single_valued_def)\n  have patterns: \"\\<forall>d p. (d,p)\\<in>system_interfaces (system_restriction P U) \\<longrightarrow> pattern_formed p\"\n    using formed by (auto simp: schema_system_formed_def)\n  have schemas: \"\\<forall>d c S. ((d,c),S)\\<in>system_clauses (system_restriction P U) \\<longrightarrow>\n      d\\<in>system_definitions (system_restriction P U) \\<and> schema_formed S \\<and>\n      schema_dependencies S\\<subseteq>system_definitions (system_restriction P U)\"\n  proof (intro allI impI)\n    fix d c S assume row: \"((d,c),S)\\<in>system_clauses (system_restriction P U)\"\n    have original: \"((d,c),S)\\<in>system_clauses P\" and member: \"d\\<in>U\" using row by auto\n    have facts: \"d\\<in>system_definitions P\" \"schema_formed S\" \"schema_dependencies S\\<subseteq>system_definitions P\"\n      using formed original unfolding schema_system_formed_def by blast+\n    have retained: \"schema_dependencies S\\<subseteq>U\"\n      using closed original member by (auto simp: system_dependency_closed_def system_dependency_edges_def)\n    show \"d\\<in>system_definitions (system_restriction P U) \\<and> schema_formed S \\<and>\n        schema_dependencies S\\<subseteq>system_definitions (system_restriction P U)\"\n      using facts member retained by auto\n  qed\n  show ?thesis using finite interfaces clauses patterns schemas by (simp only: schema_system_formed_def)\nqed\n\ntheorem system_restriction_calls:\n  assumes \"schema_system_formed P\" \"system_dependency_closed P U\"\n  shows \"schema_call_formed (system_restriction P U) d t \\<longleftrightarrow> d\\<in>U \\<and> schema_call_formed P d t\"\n  using assms system_restriction_formed[OF assms] by (auto simp: schema_call_formed_def)\n\ntheorem system_restriction_meaning:\n  assumes formed: \"schema_system_formed P\" and closed: \"system_dependency_closed P U\"\n  shows \"(d,t)\\<in>positive_meaning (system_restriction P U) \\<longleftrightarrow> d\\<in>U \\<and> (d,t)\\<in>positive_meaning P\"\nproof (cases \"d\\<in>U\")\n  case True\n  show ?thesis using positive_meaning_dependency_locality[OF formed system_restriction_formed[OF formed closed]\n    system_restriction_agreement closed True, of t] True by blast\nnext\n  case False\n  have absent: \"(d,t)\\<notin>positive_meaning (system_restriction P U)\"\n  proof\n    assume member: \"(d,t)\\<in>positive_meaning (system_restriction P U)\"\n    have call: \"schema_call_formed (system_restriction P U) d t\"\n      by (rule positive_meaning_formed[OF member])\n    show False using call system_restriction_calls[OF formed closed, of d t] False by blast\n  qed\n  show ?thesis using absent False by simp\nqed\n\nsection \\<open>The requested roots determine the least retained program\\<close>\n\ndefinition rooted_system :: \"('a,'s,'d,'c) schema_system \\<Rightarrow> 'd set \\<Rightarrow> ('a,'s,'d,'c) schema_system\" where\n  \"rooted_system P roots=system_restriction P (system_definition_closure P roots)\"\n\nlemma rooted_system_formed:\n  assumes \"schema_system_formed P\"\n  shows \"schema_system_formed (rooted_system P roots)\"\n  unfolding rooted_system_def by (rule system_restriction_formed[OF assms system_definition_closure_closed])\n\nlemma rooted_system_definitions:\n  assumes \"schema_system_formed P\" \"roots\\<subseteq>system_definitions P\"\n  shows \"system_definitions (rooted_system P roots)=system_definition_closure P roots\"\n  using system_definition_closure_boundary(1)[OF assms]\n  by (auto simp: rooted_system_def)\n\nlemma rooted_system_subdomain:\n  \"system_definitions (rooted_system P roots)\\<subseteq>system_definitions P\"\n  by (auto simp: rooted_system_def)\n\nlemma rooted_system_agreement:\n  \"systems_agree_on P (rooted_system P roots) (system_definitions (rooted_system P roots))\"\n  by (auto simp: rooted_system_def systems_agree_on_def)\n\nlemma rooted_system_roots:\n  assumes \"schema_system_formed P\" \"roots\\<subseteq>system_definitions P\"\n  shows \"roots\\<subseteq>system_definitions (rooted_system P roots)\"\n  by (simp only: rooted_system_definitions[OF assms]) (rule system_definition_closure_roots)\n\ntheorem rooted_system_calls:\n  assumes \"schema_system_formed P\"\n  shows \"schema_call_formed (rooted_system P roots) d t \\<longleftrightarrow>\n    d\\<in>system_definition_closure P roots \\<and> schema_call_formed P d t\"\n  unfolding rooted_system_def by (rule system_restriction_calls[OF assms system_definition_closure_closed])\n\ntheorem rooted_system_meaning:\n  assumes \"schema_system_formed P\"\n  shows \"(d,t)\\<in>positive_meaning (rooted_system P roots) \\<longleftrightarrow>\n    d\\<in>system_definition_closure P roots \\<and> (d,t)\\<in>positive_meaning P\"\n  unfolding rooted_system_def by (rule system_restriction_meaning[OF assms system_definition_closure_closed])\n\ncorollary rooted_system_variable_calls:\n  assumes formed: \"schema_system_formed P\"\n    and prior: \"schema_call_formed P d t \\<longleftrightarrow> d\\<in>system_definitions P \\<and> term_formed t\"\n  shows \"schema_call_formed (rooted_system P roots) d t \\<longleftrightarrow>\n    d\\<in>system_definitions (rooted_system P roots) \\<and> term_formed t\"\nproof -\n  have calls: \"schema_call_formed (rooted_system P roots) d t \\<longleftrightarrow>\n      d\\<in>system_definition_closure P roots \\<and> d\\<in>system_definitions P \\<and> term_formed t\"\n    by (simp only: rooted_system_calls[OF formed] prior)\n  have domain: \"system_definitions (rooted_system P roots)=\n      system_definitions P\\<inter>system_definition_closure P roots\"\n    by (simp only: rooted_system_def system_restriction_definitions)\n  show ?thesis by (simp only: calls domain Int_iff; blast)\nqed\n\ncorollary rooted_system_meaning_at:\n  assumes formed: \"schema_system_formed P\"\n    and member: \"d\\<in>system_definitions (rooted_system P roots)\"\n  shows \"(d,t)\\<in>positive_meaning (rooted_system P roots) \\<longleftrightarrow> (d,t)\\<in>positive_meaning P\"\n  using member by (simp only: rooted_system_meaning[OF formed])\n    (auto simp: rooted_system_def)\n\ntheorem rooted_system_least:\n  assumes \"schema_system_formed P\" \"roots\\<subseteq>system_definitions P\"\n    \"roots\\<subseteq>U\" \"system_dependency_closed P U\"\n  shows \"system_definitions (rooted_system P roots)\\<subseteq>U\"\n  by (simp only: rooted_system_definitions[OF assms(1,2)])\n    (rule system_definition_closure_least[OF assms(3,4)])\n\ntext \\<open>\n  Restriction retains the complete interface and every clause of each retained\n  definition. A dependency-closed boundary preserves formation and all positive\n  calls at its members. The least such boundary is already determined by the\n  supplied roots and actual prospective callees.\n\n  The result is a program constructed from the source. Its smaller definition\n  domain need not equal the source program's identity or quoted scope. The\n  theorem preserves exactly the stated calls and does not change an already\n  adopted scope. A new reader can use this construction to retain only its\n  actual dependencies before its own native program is compiled.\n\\<close>\n\nend\n",
