          "source": "theory Factor_Environment_Values\n  imports Factor_Artifact_Values Factor_Coordinate_Values\nbegin\n\nsection \\<open>Every artifact use and every scoped binding\\<close>\n\ndefinition environment_artifact_entry_presents ::\n  \"(local_address option\\<times>exact_artifact) \\<Rightarrow> factor_term \\<Rightarrow> bool\" where\n  \"environment_artifact_entry_presents z t \\<longleftrightarrow>\n    (\\<exists>v. artifact_value_presents (snd z) v \\<and> t=Pair_Term (use_data_term (fst z)) v)\"\n\nlemma environment_artifact_entry_formed:\n  assumes read: \"environment_artifact_entry_presents z t\"\n  shows \"term_formed t \\<and> self_contained_term t\"\nproof -\n  obtain v where material: \"artifact_value_presents (snd z) v\"\n    and encoded: \"t=Pair_Term (use_data_term (fst z)) v\"\n    using read unfolding environment_artifact_entry_presents_def by blast\n  show ?thesis using artifact_value_presents_formed[OF material] encoded by simp\nqed\n\nlemma environment_artifact_entry_unique:\n  assumes first: \"environment_artifact_entry_presents z t\"\n    and second: \"environment_artifact_entry_presents w t\"\n  shows \"z=w\"\nproof -\n  obtain a where left: \"artifact_value_presents (snd z) a\"\n    \"t=Pair_Term (use_data_term (fst z)) a\"\n    using first unfolding environment_artifact_entry_presents_def by blast\n  obtain b where right: \"artifact_value_presents (snd w) b\"\n    \"t=Pair_Term (use_data_term (fst w)) b\"\n    using second unfolding environment_artifact_entry_presents_def by blast\n  have same: \"a=b\" and coordinates: \"use_data_term (fst z)=use_data_term (fst w)\"\n    using left(2) right(2) by simp_all\n  have use: \"fst z=fst w\" by (rule injD[OF use_data_term_injective coordinates])\n  have other: \"artifact_value_presents (snd w) a\" using right(1) same by simp\n  have materials: \"snd z=snd w\" by (rule artifact_value_presents_unique[OF left(1) other])\n  show ?thesis by (rule prod_eqI[OF use materials])\nqed\n\ndefinition binding_data ::\n  \"((local_address option\\<times>local_address)\\<times>local_address option) \\<Rightarrow> factor_term\" where\n  \"binding_data z =\n    Pair_Term (Pair_Term (use_data_term (fst (fst z))) (Payload_Term (snd (fst z))))\n      (use_data_term (snd z))\"\n\nlemma binding_data_injective: \"inj binding_data\"\nproof (rule injI)\n  fix z w\n  assume same: \"binding_data z=binding_data w\"\n  have source: \"use_data_term (fst (fst z))=use_data_term (fst (fst w))\"\n    and slot: \"snd (fst z)=snd (fst w)\"\n    and target: \"use_data_term (snd z)=use_data_term (snd w)\"\n    using same by (simp_all add: binding_data_def)\n  have sources: \"fst (fst z)=fst (fst w)\" by (rule injD[OF use_data_term_injective source])\n  have targets: \"snd z=snd w\" by (rule injD[OF use_data_term_injective target])\n  show \"z=w\" using sources slot targets by (cases z; cases w) auto\nqed\n\nlemma binding_data_self_contained [simp]: \"self_contained_term (binding_data z)\"\n  by (simp add: binding_data_def)\n\nlemma binding_data_formed:\n  assumes ef: \"environment_formed E\" and row: \"z\\<in>environment_bindings E\"\n  shows \"term_formed (binding_data z)\"\nproof -\n  obtain u k v where shape: \"z=((u,k),v)\" by (cases z) auto\n  have binding: \"binds_slot E u k v\" using row shape by (simp add: binds_slot_def)\n  obtain R where source: \"artifact_at E u R\" \"k\\<in>rra_carrier (object_structure R)\"\n    using ef binding unfolding environment_formed_def by blast\n  have rf: \"exact_formed R\" using ef source(1) by (simp add: environment_formed_def)\n  have slot: \"octets_formed k\" using rf source(2) by (auto simp: exact_formed_def)\n  show ?thesis using slot shape by (simp add: binding_data_def)\nqed\n\ndefinition environment_value_presents ::\n  \"local_address option artifact_environment \\<Rightarrow> factor_term \\<Rightarrow> bool\" where\n  \"environment_value_presents E t \\<longleftrightarrow>\n    environment_formed E \\<and>\n    (\\<exists>a b. data_collection_presents environment_artifact_entry_presents (environment_artifacts E) a \\<and>\n      data_collection_presents (\\<lambda>z v. v=binding_data z) (environment_bindings E) b \\<and>\n      t=Pair_Term a b)\"\n\ntheorem environment_value_presents_unique:\n  assumes first: \"environment_value_presents E t\" and second: \"environment_value_presents F t\"\n  shows \"E=F\"\nproof -\n  obtain a b where left:\n    \"data_collection_presents environment_artifact_entry_presents (environment_artifacts E) a\"\n    \"data_collection_presents (\\<lambda>z v. v=binding_data z) (environment_bindings E) b\"\n    \"t=Pair_Term a b\" using first unfolding environment_value_presents_def by blast\n  obtain c d where right:\n    \"data_collection_presents environment_artifact_entry_presents (environment_artifacts F) c\"\n    \"data_collection_presents (\\<lambda>z v. v=binding_data z) (environment_bindings F) d\"\n    \"t=Pair_Term c d\" using second unfolding environment_value_presents_def by blast\n  have fields: \"c=a \\<and> d=b\" using left(3) right(3) by simp\n  have other_artifacts:\n    \"data_collection_presents environment_artifact_entry_presents (environment_artifacts F) a\"\n    and other_bindings:\n    \"data_collection_presents (\\<lambda>z v. v=binding_data z) (environment_bindings F) b\"\n    using right(1,2) fields by simp_all\n  have artifacts: \"environment_artifacts E=environment_artifacts F\"\n    by (rule data_collection_presents_unique[OF left(1) other_artifacts])\n       (rule environment_artifact_entry_unique; assumption)\n  have bindings: \"environment_bindings E=environment_bindings F\"\n    by (rule data_collection_presents_unique[OF left(2) other_bindings])\n       (auto dest: injD[OF binding_data_injective])\n  show ?thesis using artifacts bindings by (cases E; cases F) simp\nqed\n\ntheorem environment_value_presents_total:\n  assumes ef: \"environment_formed E\"\n  shows \"\\<exists>t. environment_value_presents E t\"\nproof -\n  have af: \"finite (environment_artifacts E)\" and bf: \"finite (environment_bindings E)\"\n    using ef by (auto simp: environment_formed_def)\n  have each: \"\\<forall>z\\<in>environment_artifacts E. \\<exists>t. environment_artifact_entry_presents z t\"\n  proof (intro ballI)\n    fix z assume row: \"z\\<in>environment_artifacts E\"\n    obtain u R where shape: \"z=(u,R)\" by (cases z) auto\n    have source: \"artifact_at E u R\" using row shape by (simp add: artifact_at_def)\n    have rf: \"exact_formed R\" using ef source by (simp add: environment_formed_def)\n    obtain v where material: \"artifact_value_presents R v\"\n      using artifact_value_presents_total[OF rf] by blast\n    show \"\\<exists>t. environment_artifact_entry_presents z t\"\n      by (rule exI[of _ \"Pair_Term (use_data_term u) v\"])\n         (use material shape in \\<open>auto simp: environment_artifact_entry_presents_def\\<close>)\n  qed\n  obtain a where artifacts:\n    \"data_collection_presents environment_artifact_entry_presents (environment_artifacts E) a\"\n    using data_collection_presents_total[OF af each] by blast\n  have every_binding: \"\\<forall>z\\<in>environment_bindings E. \\<exists>v. v=binding_data z\" by simp\n  obtain b where bindings:\n    \"data_collection_presents (\\<lambda>z v. v=binding_data z) (environment_bindings E) b\"\n    using data_collection_presents_total[OF bf every_binding] by blast\n  show ?thesis by (rule exI[of _ \"Pair_Term a b\"])\n    (use ef artifacts bindings in \\<open>auto simp: environment_value_presents_def\\<close>)\nqed\n\nlemma environment_value_presents_formed:\n  assumes present: \"environment_value_presents E t\"\n  shows \"environment_formed E \\<and> term_formed t \\<and> self_contained_term t\"\nproof -\n  obtain a b where ef: \"environment_formed E\" and parts:\n    \"data_collection_presents environment_artifact_entry_presents (environment_artifacts E) a\"\n    \"data_collection_presents (\\<lambda>z v. v=binding_data z) (environment_bindings E) b