          "source": "theory Candidate_Observations\n  imports Inference_Development\nbegin\n\nsection \\<open>Every observation keeps the facet and the actual witnessed use\\<close>\n\ndefinition candidate_profile ::\n  \"'f set \\<Rightarrow> ('f \\<Rightarrow> 'c \\<Rightarrow> 'w set) \\<Rightarrow> 'c \\<Rightarrow> ('f\\<times>'w) set\" where\n  \"candidate_profile F observe c={(f,w). f\\<in>F \\<and> w\\<in>observe f c}\"\n\nlemma candidate_profile_member [simp]:\n  \"(f,w)\\<in>candidate_profile F observe c \\<longleftrightarrow> f\\<in>F \\<and> w\\<in>observe f c\"\n  by (simp add: candidate_profile_def)\n\nlemma candidate_profile_comparison:\n  \"candidate_profile F observe c\\<subseteq>candidate_profile F observe d \\<longleftrightarrow>\n    (\\<forall>f\\<in>F. observe f c\\<subseteq>observe f d)\"\n  by (auto simp: candidate_profile_def)\n\nlemma candidate_profile_union:\n  \"candidate_profile (F\\<union>G) observe c=candidate_profile F observe c\\<union>candidate_profile G observe c\"\n  by auto\n\nlemma candidate_profile_restriction:\n  assumes \"F\\<subseteq>G\"\n  shows \"candidate_profile G observe c\\<subseteq>candidate_profile G observe d \\<Longrightarrow>\n    candidate_profile F observe c\\<subseteq>candidate_profile F observe d\"\n  using assms by (auto simp: candidate_profile_comparison)\n\ndefinition candidate_losses where\n  \"candidate_losses F observe c d=candidate_profile F observe c-candidate_profile F observe d\"\n\nlemma candidate_losses_member [simp]:\n  \"(f,w)\\<in>candidate_losses F observe c d \\<longleftrightarrow>\n    f\\<in>F \\<and> w\\<in>observe f c \\<and> w\\<notin>observe f d\"\n  by (auto simp: candidate_losses_def)\n\nlemma candidate_losses_empty:\n  \"candidate_losses F observe c d={} \\<longleftrightarrow>\n    candidate_profile F observe c\\<subseteq>candidate_profile F observe d\"\n  by (auto simp: candidate_losses_def)\n\ntheorem strict_candidate_improvement:\n  \"candidate_profile F observe c\\<subset>candidate_profile F observe d \\<longleftrightarrow>\n    candidate_losses F observe c d={} \\<and> candidate_losses F observe d c\\<noteq>{}\"\n  by (auto simp: candidate_losses_def)\n\ntheorem incomparable_candidates_retain_both_reasons:\n  \"\\<not>candidate_profile F observe c\\<subseteq>candidate_profile F observe d \\<and>\n    \\<not>candidate_profile F observe d\\<subseteq>candidate_profile F observe c \\<longleftrightarrow>\n    candidate_losses F observe c d\\<noteq>{} \\<and> candidate_losses F observe d c\\<noteq>{}\"\n  by (simp only: candidate_losses_empty)\n\ndefinition profile_obligations where\n  \"profile_obligations F observe c d=\n    graph_map (candidate_profile F observe c) (\\<lambda>(f,w). (d,f,w))\"\n\ndefinition profile_condition where\n  \"profile_condition observe z \\<longleftrightarrow> snd (snd z)\\<in>observe (fst (snd z)) (fst z)\"\n\ntheorem profile_comparison_reduction:\n  \"exact_obligation_reduction UNIV\n    (\\<lambda>z. candidate_profile F observe (fst z)\\<subseteq>candidate_profile F observe (snd z))\n    (profile_condition observe)\n    (\\<lambda>z. profile_obligations F observe (fst z) (snd z))\"\n  by (auto simp: exact_obligation_reduction_def profile_obligations_def graph_map_ran\n    image_subset_iff candidate_profile_def profile_condition_def)\n\ntheorem profile_comparison_residual:\n  \"remaining_obligations {z. profile_condition observe z} (profile_obligations F observe c d)=\n    graph_map (candidate_losses F observe c d) (\\<lambda>(f,w). (d,f,w))\"\n  by (auto simp: remaining_obligations_def profile_obligations_def graph_map_def\n    candidate_profile_def candidate_losses_def profile_condition_def)\n\nsection \\<open>The intended comparison precedes the choice of observations\\<close>\n\ndefinition comparison_observations_sound where\n  \"comparison_observations_sound C relation F observe \\<longleftrightarrow>\n    (\\<forall>c\\<in>C. \\<forall>d\\<in>C. relation c d \\<longrightarrow>\n      candidate_profile F observe c\\<subseteq>candidate_profile F observe d)\"\n\ndefinition comparison_basis where\n  \"comparison_basis C relation F observe \\<longleftrightarrow>\n    (\\<forall>c\\<in>C. \\<forall>d\\<in>C. relation c d \\<longleftrightarrow>\n      candidate_profile F observe c\\<subseteq>candidate_profile F observe d)\"\n\ndefinition comparison_failures where\n  \"comparison_failures C relation F observe=\n    {(c,d). c\\<in>C \\<and> d\\<in>C \\<and>\n      candidate_profile F observe c\\<subseteq>candidate_profile F observe d \\<and> \\<not>relation c d}\"\n\ntheorem comparison_basis_exact:\n  \"comparison_basis C relation F observe \\<longleftrightarrow>\n    comparison_observations_sound C relation F observe \\<and> comparison_failures C relation F observe={}\"\n  by (auto simp: comparison_basis_def comparison_observations_sound_def comparison_failures_def)\n\nlemma comparison_basis_at:\n  assumes \"comparison_basis C relation F observe\" \"c\\<in>C\" \"d\\<in>C\"\n  shows \"relation c d \\<longleftrightarrow> candidate_profile F observe c\\<subseteq>candidate_profile F observe d\"\n  using assms by (simp add: comparison_basis_def)\n\ntheorem comparison_basis_requires_reflexivity:\n  assumes \"comparison_basis C relation F observe\" \"c\\<in>C\"\n  shows \"relation c c\"\n  using comparison_basis_at[OF assms(1) assms(2,2)] by simp\n\ntheorem comparison_basis_requires_transitivity:\n  assumes basis: \"comparison_basis C relation F observe\"\n    and members: \"a\\<in>C\" \"b\\<in>C\" \"c\\<in>C\"\n    and first: \"relation a b\" and second: \"relation b c\"\n  shows \"relation a c\"\nproof -\n  have one: \"candidate_profile F observe a\\<subseteq>candidate_profile F observe b\"\n    using first by (simp only: comparison_basis_at[OF basis members(1,2)])\n  have two: \"candidate_profile F observe b\\<subseteq>candidate_profile F observe c\"\n    using second by (simp only: comparison_basis_at[OF basis members(2,3)])\n  show ?thesis by (simp only: comparison_basis_at[OF basis members(1,3)])\n    (rule subset_trans[OF one two])\nqed\n\nlemma comparison_sound_restriction:\n  assumes \"comparison_observations_sound C relation G observe\" \"F\\<subseteq>G\"\n  shows \"comparison_observations_sound C relation F observe\"\n  using assms by (auto simp: comparison_observations_sound_def candidate_profile_comparison; blast)\n\nlemma comparison_failures_antimono:\n  assumes \"F\\<subseteq>G\"\n  shows \"comparison_failures C relation G observe\\<subseteq>comparison_failures C relation F observe\"\n  using assms by (auto simp: comparison_failures_def candidate_profile_comparison; blast)\n\ntheorem omitted_facet_has_a_witness:\n  assumes whole: \"comparison_basis C relation U observe\" and included: \"F\\<subseteq>U\"\n    and failure: \"(c,d)\\<in>comparison_failures C relation F observe\"\n  shows \"\\<exists>f\\<in>U-F. \\<exists>w. w\\<in>observe f c \\<and> w\\<notin>observe f d\"\n  using assms by (auto simp: comparison_basis_def comparison_failures_def candidate_profile_comparison; blast)\n\ntheorem a_witness_refines_the_comparison:\n  assumes failure: \"(c,d)\\<in>comparison_failures C relation F observe\"\n    and witnessed: \"w\\<in>observe f c\" \"w\\<notin>observe f d\"\n  shows \"comparison_failures C relation (insert f F) observe\\<subset>\n    comparison_failures C relation F observe\"\nproof -\n  have included: \"comparison_failures C relation (insert f F) observe\\<subseteq>\n      comparison_failures C relation F observe\"\n    by (rule comparison_failures_antimono[OF subset_insertI])\n  have removed: \"(c,d)\\<notin>comparison_failures C relation (insert f F) observe\"\n    using witnessed by (auto simp: comparison_failures_def candidate_profile_comparison)\n  show ?thesis using included failure removed by blast\nqed\n\ntheorem an_inadequate_observation_language_remains_visible:\n  assumes \"c\\<in>C\" \"d\\<in>C\" \"\\<not>relation c d\"\n    \"\\<forall>f\\<in>U. observe f c\\<subseteq>observe f d\" \"F\\<subseteq>U\"\n  shows \"(c,d)\\<in>comparison_failures C relation F observe \\<and>\n    \\<not>comparison_basis C relation F observe\"\n  using assms by (auto simp: comparison_failures_def comparison_basis_def candidate_profile_comparison)\n\ntheorem finite_comparison_scope_has_a_finite_basis:\n  assumes finite: \"finite C\" and whole: \"comparison_basis C relation U observe\"\n  shows \"\\<exists>F. finite F \\<and> F\\<subseteq>U \\<and> comparison_basis C relation F observe\"\nproof -\n  let ?B=\"{(c,d)\\<in>C\\<times>C. \\<not>relation c d}\"\n  let ?choose=\"\\<lambda>z. SOME f. f\\<in>U \\<and> (\\<exists>w. w\\<in>observe f (fst z) \\<and> w\\<notin>observe f (snd z))\"\n  have witness: \"\\<exists>f. f\\<in>U \\<and> (\\<exists>w. w\\<in>observe f (fst z) \\<and> w\\<notin>observe f (snd z))\"\n    if \"z\\<in>?B\" for z\n    using whole that by (auto simp: comparison_basis_def candidate_profile_comparison; blast)\n  have chosen: \"?choose z\\<in>U \\<and> (\\<exists>w. w\\<in>observe (?choose z) (fst z) \\<and>\n      w\\<notin>observe (?choose z) (snd z))\" if \"z\\<in>?B\" for z\n    by (rule someI_ex[OF witness[OF that]])\n  let ?F=\"?choose ` ?B\"\n  have finite_pairs: \"finite (C\\<times>C)\" by (rule finite_cartesian_product[OF finite finite])\n  have finite_bad: \"finite ?B\" by (rule finite_subset[OF _ finite_pairs]) auto\n  have fin: \"finite ?F\" by (rule finite_imageI[OF finite_bad])\n  have sub: \"?F\\<subseteq>U\" using chosen by blast\n  have sound: \"comparison_observations_sound C relation ?F observe\"\n    by (rule comparison_sound_restriction[OF _ sub])\n      (use whole in \\<open>simp only: comparison_basis_exact; blast\\<close>)\n  have reflected: \"relation c d\"\n    if left: \"c\\<in>C\" and right: \"d\\<in>C\"\n      and measured: \"candidate_profile ?F observe c\\<subseteq>candidate_profile ?F observe d\" for c d\n  proof (rule ccontr)\n    assume denied: \"\\<not>relation c d\"\n    have bad: \"(c,d)\\<in>?B\" using left right denied by simp\n    have retained: \"?choose (c,d)\\<in>?F\" by (rule imageI[OF bad])\n    obtain w where first: \"w\\<in>observe (?choose (c,d)) c\"\n      and second: \"w\\<notin>observe (?choose (c,d)) d\" using chosen[OF bad] by auto\n    have included: \"observe (?choose (c,d)) c\\<subseteq>observe (?choose (c,d)) d\"\n      using measured retained by (simp only: candidate_profile_comparison; blast)\n    show False using subsetD[OF included first] second by contradiction\n  qed\n  have basis: \"comparison_basis C relation ?F observe\"\n    using sound reflected by (auto simp: comparison_basis_def comparison_observations_sound_def)\n  show ?thesis by (rule exI[of _ ?F]) (use fin sub basis in blast)\nqed\n\ntheorem essential_facets_prevent_a_smaller_basis:\n  assumes smaller: \"G\\<subset>F\"\n    and essential: \"\\<And>f. f\\<in>F \\<Longrightarrow>\n      \\<exists>c d. (c,d)\\<in>comparison_failures C relation (F-{f}) observe\"\n  shows \"\\<not>comparison_basis C relation G observe\"\nproof -\n  obtain f where member: \"f\\<in>F\" and absent: \"f\\<notin>G\" using smaller by blast\n  have included: \"G\\<subseteq>F-{f}\" using smaller absent by blast\n  obtain c d where bad: \"(c,d)\\<in>comparison_failures C relation (F-{f}) observe\"\n    using essential[OF member] by blast\n  have \"(c,d)\\<in>comparison_failures C relation G observe\"\n    by (rule subsetD[OF comparison_failures_antimono[OF included] bad])\n  then show ?thesis by (auto simp: comparison_basis_exact)\nqed\n\ntheorem a_preorder_has_an_exact_observation_basis:\n  assumes reflexive: \"\\<And>c. c\\<in>C \\<Longrightarrow> relation c c\"\n    and transitive: \"\\<And>a b c. a\\<in>C \\<Longrightarrow> b\\<in>C \\<Longrightarrow> c\\<in>C \\<Longrightarrow>\n      relation a b \\<Longrightarrow> relation b c \\<Longrightarrow> relation a c\"\n  shows \"comparison_basis C relation {()} (\\<lambda>_ c. {a\\<in>C. relation a c})\"\n  unfolding comparison_basis_def\nproof (intro ballI)\n  fix c d assume first: \"c\\<in>C\" and second: \"d\\<in>C\"\n  have equation: \"relation c d \\<longleftrightarrow> {a\\<in>C. relation a c}\\<subseteq>{a\\<in>C. relation a d}\"\n  proof\n    assume related: \"relation c d\"\n    show \"{a\\<in>C. relation a c}\\<subseteq>{a\\<in>C. relation a d}\"\n    proof\n      fix a assume \"a\\<in>{a\\<in>C. relation a c}\"\n      then have member: \"a\\<in>C\" and earlier: \"relation a c\" by auto\n      have \"relation a d\" by (rule transitive[OF member first second earlier related])\n      then show \"a\\<in>{a\\<in>C. relation a d}\" using member by simp\n    qed\n  next\n    assume included: \"{a\\<in>C. relation a c}\\<subseteq>{a\\<in>C. relation a d}\"\n    have member: \"c\\<in>{a\\<in>C. relation a c}\" using first reflexive[OF first] by simp\n    have \"c\\<in>{a\\<in>C. relation a d}\" by (rule subsetD[OF included member])\n    then show \"relation c d\" by simp\n  qed\n  show \"relation c d \\<longleftrightarrow>\n    candidate_profile {()} (\\<lambda>_ c. {a\\<in>C. relation a c}) c\\<subseteq>\n      candidate_profile {()} (\\<lambda>_ c. {a\\<in>C. relation a c}) d\"\n    using equation by (simp add: candidate_profile_comparison)\nqed\n\ntext \\<open>\n  A profile contains independently meaningful witnessed uses, qualified by\n  their facet. Its two directed differences retain both improvements and\n  losses. The existing partial-order and obligation machinery consumes these\n  profiles; a facet count or a weighted score is not substituted for them.\n\n  The comparison relation is fixed independently. A basis must both preserve\n  its valid comparisons and reflect them. A failure retains the actual two\n  candidates. An adequate larger family then supplies a missing facet and a\n  distinguishing witness, which directs a strictly informative refinement.\n  If the whole proposed observation language misses that distinction, the\n  failure remains visible. Enlarging a selected subfamily cannot hide it.\n\n  A finite candidate scope admits a finite basis when the supplied whole\n  family is adequate. This does not establish that the candidate scope covers\n  all intended developments. Essential-facet witnesses separately justify\n  irredundancy. Preorders admit a general down-set basis, but its mathematical\n  existence does not supply an executable observation of an arbitrary order.\n  Conversely, a relation with an exact profile-inclusion basis must be\n  reflexive and transitive on its candidate scope. An incompatible relation\n  must remain a separate condition or be justified by a different comparison.\n\\<close>\n\nend\n",
