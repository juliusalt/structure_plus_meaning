          "source": "theory Finite_Derived_Observations\n  imports Finite_Investigation_Interface\nbegin\n\nsection \\<open>Observation indices present actual subjects, operations and values\\<close>\n\ndefinition finite_derived_observations where\n  \"finite_derived_observations C U W P=ffUnion (fimage (\\<lambda>(f,u).\n    ffUnion (fimage (\\<lambda>(c,s). fimage (\\<lambda>(w,v). (f,c,w))\n      (ffilter (\\<lambda>(w,v). P u s v) W)) C)) U)\"\n\nlemma finite_derived_observation_member:\n  \"(f,c,w) |\\<in>| finite_derived_observations C U W P \\<longleftrightarrow>\n    (\\<exists>u s v. (f,u) |\\<in>| U \\<and> (c,s) |\\<in>| C \\<and>\n      (w,v) |\\<in>| W \\<and> P u s v)\"\n  by (auto simp: finite_derived_observations_def ffUnion.rep_eq fimage.rep_eq\n    image_iff split: prod.splits; force)\n\ndefinition finite_observation_subjects_formed where\n  \"finite_observation_subjects_formed C U W \\<longleftrightarrow>\n    single_valued (fset C) \\<and> single_valued (fset U) \\<and> single_valued (fset W)\"\n\ntheorem finite_derived_observation_at_subject:\n  assumes scope: \"finite_observation_subjects_formed C U W\"\n    and candidate: \"(c,s) |\\<in>| C\" and operation: \"(f,u) |\\<in>| U\"\n    and output_value: \"(w,v) |\\<in>| W\"\n  shows \"(f,c,w) |\\<in>| finite_derived_observations C U W P \\<longleftrightarrow> P u s v\"\n  using assms by (auto simp: finite_derived_observation_member\n    finite_observation_subjects_formed_def single_valued_def; blast)\n\nlemma finite_derived_observations_formed:\n  \"finite_observation_table_formed (fimage fst C) (fimage fst U)\n    (finite_derived_observations C U W P)\"\n  by (auto simp: finite_observation_table_formed_def finite_derived_observation_member; force)\n\ntheorem finite_derived_profile_at_subject:\n  assumes scope: \"finite_observation_subjects_formed C U W\"\n    and candidate: \"(c,s) |\\<in>| C\"\n  shows \"fset (finite_candidate_profile F (finite_derived_observations C U W P) c)=\n    {(f,w). f |\\<in>| F \\<and> (\\<exists>u v. (f,u) |\\<in>| U \\<and> (w,v) |\\<in>| W \\<and> P u s v)}\"\nproof -\n  have functional: \"single_valued (fset C)\"\n    using scope by (simp add: finite_observation_subjects_formed_def)\n  have rows: \"(f,c,w) |\\<in>| finite_derived_observations C U W P \\<longleftrightarrow>\n    (\\<exists>u v. (f,u) |\\<in>| U \\<and> (w,v) |\\<in>| W \\<and> P u s v)\" for f w\n  proof\n    assume member: \"(f,c,w) |\\<in>| finite_derived_observations C U W P\"\n    obtain u a v where actual: \"(f,u) |\\<in>| U\" \"(c,a) |\\<in>| C\"\n      \"(w,v) |\\<in>| W\" \"P u a v\"\n      using member by (simp only: finite_derived_observation_member) blast\n    have same: \"a=s\" by (rule single_valued_outputs[OF functional actual(2) candidate])\n    show \"\\<exists>u v. (f,u) |\\<in>| U \\<and> (w,v) |\\<in>| W \\<and> P u s v\"\n      using actual same by blast\n  next\n    assume actual: \"\\<exists>u v. (f,u) |\\<in>| U \\<and> (w,v) |\\<in>| W \\<and> P u s v\"\n    show \"(f,c,w) |\\<in>| finite_derived_observations C U W P\"\n      using actual candidate by (simp only: finite_derived_observation_member) blast\n  qed\n  show ?thesis by (auto simp: finite_candidate_profile_exact candidate_profile_def\n    finite_table_observations_def rows)\nqed\n\ntheorem finite_derived_observations_extensional:\n  assumes agreement: \"\\<And>f u c s w v. (f,u) |\\<in>| U \\<Longrightarrow> (c,s) |\\<in>| C \\<Longrightarrow>\n    (w,v) |\\<in>| W \\<Longrightarrow> P u s v \\<longleftrightarrow> Q u s v\"\n  shows \"finite_derived_observations C U W P=finite_derived_observations C U W Q\"\nproof -\n  have \"fset (finite_derived_observations C U W P)=fset (finite_derived_observations C U W Q)\"\n    using agreement by (auto simp: finite_derived_observation_member split: prod.splits; blast)\n  then show ?thesis by (simp only: fset_inject)\nqed\n\nsection \\<open>Function graphs present the complete finite source maps\\<close>\n\nlemma indexed_relation_rows_member:\n  \"(c,d)\\<in>set (filter (\\<lambda>(c,d). R c d) (investigation_pairs cs)) \\<longleftrightarrow>\n    c\\<in>set cs \\<and> d\\<in>set cs \\<and> R c d\"\n  by (auto simp: investigation_pairs_exact)\n\nlemma indexed_value_rows_member:\n  \"(f,c,w)\\<in>set (concat (map (\\<lambda>c. map (\\<lambda>f. (f,c,value f c)) fs) cs)) \\<longleftrightarrow>\n    c\\<in>set cs \\<and> f\\<in>set fs \\<and> w=value f c\"\n  by auto\n\nlemma indexed_predicate_rows_member:\n  \"(f,c,w)\\<in>set (concat (map (\\<lambda>f. concat (map (\\<lambda>c.\n      map (\\<lambda>w. (f,c,w)) (filter (P f c) ws)) cs)) fs)) \\<longleftrightarrow>\n    f\\<in>set fs \\<and> c\\<in>set cs \\<and> w\\<in>set ws \\<and> P f c w\"\n  by auto\n\nlemma indexed_satisfied_rows_member:\n  \"(f,c,w)\\<in>set (concat (map (\\<lambda>f. map (\\<lambda>c. (f,c,v)) (filter (P f) cs)) fs)) \\<longleftrightarrow>\n    f\\<in>set fs \\<and> c\\<in>set cs \\<and> w=v \\<and> P f c\"\n  by auto\n\nlemma finite_function_graph:\n  \"fset (fimage (\\<lambda>i. (i,S i)) I)=graph_map (fset I) S\"\n  by (auto simp: fimage.rep_eq graph_map_def)\n\nlemma finite_function_graph_member:\n  \"(i,s) |\\<in>| fimage (\\<lambda>j. (j,S j)) I \\<longleftrightarrow> i |\\<in>| I \\<and> s=S i\"\n  by (simp only: finite_function_graph graph_map_member)\n\nlemma finite_function_graph_all:\n  \"(\\<forall>(i,s)\\<in>fset (fimage (\\<lambda>j. (j,S j)) I). P i s) \\<longleftrightarrow>\n    (\\<forall>i\\<in>fset I. P i (S i))\"\n  by (auto simp: fimage.rep_eq)\n\nlemma finite_observation_function_graphs_formed:\n  \"finite_observation_subjects_formed\n    (fimage (\\<lambda>c. (c,C c)) Cs) (fimage (\\<lambda>f. (f,U f)) Us)\n    (fimage (\\<lambda>w. (w,W w)) Ws)\"\n  by (simp only: finite_observation_subjects_formed_def finite_function_graph\n    graph_map_single_valued; simp)\n\ntheorem finite_derived_observation_on_function_graphs:\n  \"(f,c,w) |\\<in>| finite_derived_observations\n      (fimage (\\<lambda>c. (c,C c)) Cs) (fimage (\\<lambda>f. (f,U f)) Us)\n      (fimage (\\<lambda>w. (w,W w)) Ws) P \\<longleftrightarrow>\n    f |\\<in>| Us \\<and> c |\\<in>| Cs \\<and> w |\\<in>| Ws \\<and> P (U f) (C c) (W w)\"\n  by (auto simp: finite_derived_observation_member fimage.rep_eq)\n\ntheorem finite_table_derived_from_function_graphs:\n  assumes equation: \"\\<And>f c w. (f,c,w) |\\<in>| T \\<longleftrightarrow>\n    f |\\<in>| Us \\<and> c |\\<in>| Cs \\<and> w |\\<in>| Ws \\<and> P (U f) (C c) (W w)\"\n  shows \"T=finite_derived_observations\n    (fimage (\\<lambda>c. (c,C c)) Cs) (fimage (\\<lambda>f. (f,U f)) Us)\n    (fimage (\\<lambda>w. (w,W w)) Ws) P\"\nproof -\n  have \"fset T=fset (finite_derived_observations\n      (fimage (\\<lambda>c. (c,C c)) Cs) (fimage (\\<lambda>f. (f,U f)) Us)\n      (fimage (\\<lambda>w. (w,W w)) Ws) P)\"\n    by (auto simp: equation finite_derived_observation_on_function_graphs)\n  then show ?thesis by (simp only: fset_inject)\nqed\n\ntext \\<open>\n  The source maps contain the actual candidate, operation and result subjects.\n  An index contributes only through a row in those maps. The exact equation is\n  about the independently supplied relation P on those subjects. A concrete\n  operation must establish its own equation against that relation; a label,\n  stored description or file identity cannot supply it.\n\n  Functional maps prevent one index from silently selecting incompatible\n  subjects. Several indices may present the same subject. Empty result sets\n  and unrepresented values remain explicit. The existing finite comparison\n  consumes the derived table without changing its observation semantics.\n\\<close>\n\nexport_code finite_derived_observations checking SML\n\nend\n",
