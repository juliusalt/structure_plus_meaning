          "source": "theory Factor_Future_Applications\n  imports Factor_Native_Meaning Factor_Application_Encoding RRA_Fresh_Uses\nbegin\n\nsection \\<open>Application recovery commutes with use placement and inclusion\\<close>\n\nlemma native_application_use_renaming:\n  assumes app: \"native_application_at E u r d t I K\" and injective: \"inj h\"\n  shows \"native_application_at (rename_environment h E) (h u) r (h (fst d),snd d) t I K\"\nproof -\n  let ?F = \"rename_environment h E\"\n  have ef: \"environment_formed E\" using app by (simp add: native_application_at_def)\n  have ff: \"environment_formed ?F\" by (rule environment_renaming_formed[OF ef injective])\n  obtain R ps c a cite C J A where parts:\n    \"artifact_at E u R\" \"record_at R r ps [c,a]\" \"citation_at R c cite C\"\n    \"citation_location E u cite (fst d) (snd d)\" \"term_quoted_at E u a t J A\"\n    \"insert r (set ps) \\<inter> (C \\<union> J) = {}\" \"C \\<inter> J = {}\"\n    \"I=insert r (set ps \\<union> C \\<union> J)\" \"K=citation_slots cite \\<union> A\" \"I \\<inter> K = {}\"\n    using app by (auto simp: native_application_at_def)\n  have art: \"artifact_at ?F (h u) R\"\n    using artifact_at_renamed_use[OF injective, of E u R] parts(1) by simp\n  have loc: \"citation_location ?F (h u) cite (h (fst d)) (snd d)\"\n    using citation_location_use_renaming[OF injective, of E u cite \"fst d\" \"snd d\"] parts(4) by simp\n  have quote: \"term_quoted_at ?F (h u) a t J A\" by (rule term_quoted_use_renaming[OF parts(5) injective])\n  show ?thesis unfolding native_application_at_def\n    by (rule conjI[OF ff], rule exI[of _ R], rule exI[of _ ps],\n        rule exI[of _ c], rule exI[of _ a], rule exI[of _ cite],\n        rule exI[of _ C], rule exI[of _ J], rule exI[of _ A])\n       (use art loc quote parts(2,3,6-10) in auto)\nqed\n\nlemma native_application_included:\n  assumes app: \"native_application_at E u r d t I K\" and included: \"environment_included E F\"\n    and ff: \"environment_formed F\"\n  shows \"native_application_at F u r d t I K\"\nproof -\n  obtain R ps c a cite C J A where parts:\n    \"artifact_at E u R\" \"record_at R r ps [c,a]\" \"citation_at R c cite C\"\n    \"citation_location E u cite (fst d) (snd d)\" \"term_quoted_at E u a t J A\"\n    \"insert r (set ps) \\<inter> (C \\<union> J) = {}\" \"C \\<inter> J = {}\"\n    \"I=insert r (set ps \\<union> C \\<union> J)\" \"K=citation_slots cite \\<union> A\" \"I \\<inter> K = {}\"\n    using app by (auto simp: native_application_at_def)\n  have art: \"artifact_at F u R\" by (rule included_artifact[OF included parts(1)])\n  have loc: \"citation_location F u cite (fst d) (snd d)\" by (rule included_location[OF included parts(4)])\n  have quote: \"term_quoted_at F u a t J A\" by (rule term_quoted_included[OF parts(5) included ff])\n  show ?thesis using ff art loc quote parts(2,3,6-10)\n    unfolding native_application_at_def by blast\nqed\n\nlemma call_environment_binding_source:\n  assumes \"binds_slot (call_environment R a t) u k v\"\n  shows \"u=Some []\"\nproof -\n  obtain x y where source: \"u=call_use x\"\n    and binding: \"binds_slot (term_environment (Pair_Term (Target_Term (Occurrence_Anchor (R,a))) t)) x k y\"\n    using assms by (auto simp: call_environment_def binds_slot_renaming)\n  have \"x=None\" using binding by (cases x) (auto simp: term_environment_def)\n  then show ?thesis using source by simp\nqed\n\nlemma call_environment_target_passive:\n  \"\\<not> binds_slot (call_environment R a t) None k v\"\n  using call_environment_binding_source by fastforce\n\nsection \\<open>Every formed future term can be added to an existing environment\\<close>\n\ndefinition future_call_environment ::\n  \"local_address option artifact_environment \\<Rightarrow> local_address option \\<Rightarrow> exact_artifact \\<Rightarrow>\n    local_address \\<Rightarrow> factor_term \\<Rightarrow> local_address option artifact_environment\" where\n  \"future_call_environment E u R a t = graft_environment E u (call_environment R a t)\"\n\ndefinition future_call_use ::\n  \"local_address option artifact_environment \\<Rightarrow> local_address option \\<Rightarrow> local_address option\" where\n  \"future_call_use E u = fresh_use_map (environment_uses E) u (Some [])\"\n\nlemma future_call_use_fresh:\n  assumes \"environment_formed E\"\n  shows \"future_call_use E u \\<notin> environment_uses E\"\n  using fresh_use_map_outside[OF environment_uses_finite[OF assms], of u \"[]\"]\n  by (simp add: future_call_use_def)\n\nlemma future_call_includes_existing:\n  \"environment_included E (future_call_environment E u R a t)\"\n  unfolding future_call_environment_def by (rule graft_includes_existing)\n\ntheorem future_call_environment_formed:\n  assumes ef: \"environment_formed E\" and source: \"artifact_at E u R\"\n    and anchor: \"anchor_formed (R,a)\" and arg: \"term_formed t\"\n  shows \"environment_formed (future_call_environment E u R a t)\"\n  unfolding future_call_environment_def\n  by (rule graft_environment_formed[OF ef call_environment_formed[OF anchor arg] source\n        call_environment_target call_environment_target_passive])\n\ntheorem future_call_existing_artifacts:\n  assumes ef: \"environment_formed E\" and source: \"artifact_at E u R\"\n    and anchor: \"anchor_formed (R,a)\" and arg: \"term_formed t\" and member: \"v \\<in> environment_uses E\"\n  shows \"artifact_at (future_call_environment E u R a t) v S \\<longleftrightarrow> artifact_at E v S\"\n  unfolding future_call_environment_def\n  by (rule graft_existing_artifacts_unchanged[OF ef call_environment_formed[OF anchor arg]\n        source call_environment_target member])\n\ntheorem future_call_existing_bindings:\n  assumes ef: \"environment_formed E\" and member: \"v \\<in> environment_uses E\"\n  shows \"binds_slot (future_call_environment E u R a t) v k w \\<longleftrightarrow> binds_slot E v k w\"\n  unfolding future_call_environment_def\n  by (rule graft_existing_bindings_unchanged[OF ef call_environment_target_passive member])\n\ntheorem future_call_representation:\n  assumes ef: \"environment_formed E\" and source: \"artifact_at E u R\"\n    and anchor: \"anchor_formed (R,a)\" and arg: \"term_formed t\"\n  shows \"\\<exists>I K. native_application_at (future_call_environment E u R a t) (future_call_use E u) [] (u,a) t I K \\<and>\n    rra_carrier (object_structure (call_syntax R a t)) = I \\<union> K\"\nproof -\n  let ?C = \"call_environment R a t\"\n  let ?h = \"fresh_use_map (environment_uses E) u\"\n  let ?F = \"future_call_environment E u R a t\"\n  let ?I = \"term_syntax_interior (Pair_Term (Target_Term (Occurrence_Anchor (R,a))) t)\"\n  let ?K = \"rel_dom (term_literal_bindings (Pair_Term (Target_Term (Occurrence_Anchor (R,a))) t))\"\n  have injective: \"inj ?h\" by (rule fresh_use_map_injective[OF environment_uses_finite[OF ef]])\n  have original: \"native_application_at ?C (Some []) [] (None,a) t ?I ?K\"\n    by (rule native_application_representation[OF anchor arg])\n  have placed: \"native_application_at (rename_environment ?h ?C) (future_call_use E u) [] (u,a) t ?I ?K\"\n    using native_application_use_renaming[OF original injective]\n    by (simp add: future_call_use_def)\n  have included: \"environment_included (rename_environment ?h ?C) ?F\"\n    unfolding future_call_environment_def by (rule graft_includes_imported)\n  have ff: \"environment_formed ?F\" by (rule future_call_environment_formed[OF assms])\n  have recovered: \"native_application_at ?F (future_call_use E u) [] (u,a) t ?I ?K\"\n    by (rule native_application_included[OF placed included ff])\n  show ?thesis using recovered native_application_complete_carrier[of R a t] by blast\nqed\n\ntheorem future_call_preserves_program:\n  assumes package: \"native_package_at E pu pr P\" and source: \"artifact_at E u R\"\n    and anchor: \"anchor_formed (R,a)\" and arg: \"term_formed t\"\n  shows \"native_package_at (future_call_environment E u R a t) pu pr P\"\n    and \"native_package_environment (future_call_environment E u R a t) pu pr = native_package_environment E pu pr\"\nproof -\n  have ef: \"environment_formed E\"\n    using native_package_projection(1)[OF package] by (simp add: native_package_formed_def)\n  have ff: \"environment_formed (future_call_environment E u R a t)\"\n    by (rule future_call_environment_formed[OF ef source anchor arg])\n  show \"native_package_at (future_call_environment E u R a t) pu pr P\"\n    by (rule native_package_included[OF package future_call_includes_existing ff])\n  show \"native_package_environment (future_call_environment E u R a t) pu pr = native_package_environment E pu pr\"\n    by (rule native_package_environment_extension[OF package future_call_includes_existing ff])\nqed\n\ntheorem future_call_truth:\n  assumes package: \"native_package_at E pu pr P\" and source: \"artifact_at E u R\"\n    and anchor: \"anchor_formed (R,a)\" and arg: \"term_formed t\"\n  shows \"native_positive_holds (future_call_environment E u R a t) pu pr (future_call_use E u) []\n    \\<longleftrightarrow> ((u,a),t) \\<in> positive_meaning P\"\nproof -\n  have ef: \"environment_formed E\"\n    using native_package_projection(1)[OF package] by (simp add: native_package_formed_def)\n  have preserved: \"native_package_at (future_call_environment E u R a t) pu pr P\"\n    by (rule future_call_preserves_program(1)[OF assms])\n  obtain I K where app: \"native_application_at (future_call_environment E u R a t) (future_call_use E u) [] (u,a) t I K\"\n    using future_call_representation[OF ef source anchor arg] by blast\n  show ?thesis by (rule native_positive_holds_with_reads[OF preserved app])\nqed\n\ntheorem future_call_formed_against_interface:\n  assumes package: \"native_package_at E pu pr P\" and source: \"artifact_at E u R\"\n    and anchor: \"anchor_formed (R,a)\" and arg: \"term_formed t\"\n    and call: \"schema_call_formed P (u,a) t\"\n  shows \"native_application_formed (future_call_environment E u R a t) pu pr (future_call_use E u) []\"\nproof -\n  have ef: \"environment_formed E\"\n    using native_package_projection(1)[OF package] by (simp add: native_package_formed_def)\n  have preserved: \"native_package_at (future_call_environment E u R a t) pu pr P\"\n    by (rule future_call_preserves_program(1)[OF package source anchor arg])\n  obtain I K where app: \"native_application_at (future_call_environment E u R a t) (future_call_use E u) [] (u,a) t I K\"\n    using future_call_representation[OF ef source anchor arg] by blast\n  show ?thesis using preserved app call unfolding native_application_formed_def by blast\nqed\n\nlemma future_call_arguments_distinct:\n  assumes ef: \"environment_formed E\" and source: \"artifact_at E u R\" and anchor: \"anchor_formed (R,a)\"\n    and tf: \"term_formed t\" and sf: \"term_formed s\"\n    and same: \"future_call_environment E u R a t = future_call_environment E u R a s\"\n  shows \"t=s\"\nproof -\n  obtain I K where first: \"native_application_at (future_call_environment E u R a t) (future_call_use E u) [] (u,a) t I K\"\n    using future_call_representation[OF ef source anchor tf] by blast\n  obtain J W where second: \"native_application_at (future_call_environment E u R a s) (future_call_use E u) [] (u,a) s J W\"\n    using future_call_representation[OF ef source anchor sf] by blast\n  have other: \"native_application_at (future_call_environment E u R a t) (future_call_use E u) [] (u,a) s J W\"\n    using second same by simp\n  show ?thesis using native_application_unique[OF first other] by blast\nqed\n\ntheorem future_call_environment_family_infinite:\n  assumes ef: \"environment_formed E\" and source: \"artifact_at E u R\" and anchor: \"anchor_formed (R,a)\"\n  shows \"infinite (future_call_environment E u R a ` {t. term_formed t})\"\nproof\n  assume finite: \"finite (future_call_environment E u R a ` {t. term_formed t})\"\n  have injective: \"inj_on (future_call_environment E u R a) {t. term_formed t}\"\n    by (rule inj_onI) (auto intro: future_call_arguments_distinct[OF ef source anchor])\n  have \"finite {t. term_formed t}\" by (rule finite_imageD[OF finite injective])\n  then show False using future_term_domain_is_infinite by blast\nqed\n\ntext \\<open>\n  This construction permits arbitrary existing outgoing bindings at the callee\n  use. The separate call package contributes none there. Its other uses are\n  fresh, and every old artifact value and binding remains exact. Repeating the\n  construction with the resulting finite environment allocates further fresh\n  occurrences in the same unbounded carrier.\n\n  Program closure is identical before and after the extension. Applications\n  recover their ordinary arguments and check the original interface; truth is\n  the original program's independent meaning. No proof, retention, adoption,\n  or foundation-wide resource rule is added by supplying a future argument.\n\\<close>\n\nend\n",
