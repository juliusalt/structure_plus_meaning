          "theory": "Factor_Observation_Clauses",
          "source": "theory Factor_Observation_Clauses\n  imports Factor_Context_Filters Factor_Related_List_Maps Factor_List_Set_Presentations\nbegin\n\nsection \\<open>Membership and omission have the same complete data boundary\\<close>\n\ndefinition observation_member_schema :: \"(nat,nat,nat) factor_schema\" where\n  \"observation_member_schema=data_rule (Pattern_Pair data_x data_y)\n    {(0,5,Pattern_Pair data_y (Pattern_Pair data_x data_z))}\"\n\ndefinition observation_absent_schema :: \"(nat,nat,nat) factor_schema\" where\n  \"observation_absent_schema=data_rule (Pattern_Pair data_x data_y)\n    {(0,2,data_y),(1,132,Pattern_Pair data_y data_x)}\"\n\ndefinition observation_context_schema :: \"(nat,nat,nat) factor_schema\" where\n  \"observation_context_schema=data_rule (Pattern_Pair data_x data_y)\n    {(0,4,data_x),(1,2,data_y)}\"\n\nsection \\<open>Every observation row retains its facet, candidate, and witness\\<close>\n\ndefinition observation_keep_schema :: \"(nat,nat,nat) factor_schema\" where\n  \"observation_keep_schema=data_rule\n    (Pattern_Pair (Pattern_Pair data_x data_y) (Pattern_Pair data_z (Pattern_Pair data_y data_w)))\n    {(0,303,Pattern_Pair data_x data_z),(1,2,data_y),(2,2,data_w)}\"\n\ndefinition observation_other_candidate_schema :: \"(nat,nat,nat) factor_schema\" where\n  \"observation_other_candidate_schema=data_rule\n    (Pattern_Pair (Pattern_Pair data_x data_y)\n      (Pattern_Pair data_z (Pattern_Pair data_w (Pattern_Variable 4))))\n    {(0,4,data_x),(1,3,Pattern_Pair data_y data_w),(2,2,data_z),(3,2,Pattern_Variable 4)}\"\n\ndefinition observation_other_facet_schema :: \"(nat,nat,nat) factor_schema\" where\n  \"observation_other_facet_schema=data_rule\n    (Pattern_Pair (Pattern_Pair data_x data_y)\n      (Pattern_Pair data_z (Pattern_Pair data_w (Pattern_Variable 4))))\n    {(0,304,Pattern_Pair data_x data_z),(1,2,data_y),(2,2,data_w),(3,2,Pattern_Variable 4)}\"\n\ndefinition observation_pair_schema :: \"(nat,nat,nat) factor_schema\" where\n  \"observation_pair_schema=data_rule\n    (context_relation_pattern data_x (Pattern_Pair data_y (Pattern_Pair data_z data_w))\n      (Pattern_Pair data_y data_w))\n    {(0,2,data_y),(1,2,data_z),(2,2,data_w)}\"\n\ndefinition observation_profile_schema :: \"(nat,nat,nat) factor_schema\" where\n  \"observation_profile_schema=data_rule (context_relation_pattern data_x data_y data_z)\n    {(0,298,context_relation_pattern data_x data_y data_w),\n     (1,300,context_relation_pattern data_x data_w data_z)}\"\n\ndefinition observation_losses_schema :: \"(nat,nat,nat) factor_schema\" where\n  \"observation_losses_schema=data_rule\n    (context_relation_pattern (Pattern_Pair data_x (Pattern_Pair data_y data_z)) data_w (Pattern_Variable 4))\n    {(0,301,context_relation_pattern (Pattern_Pair data_x data_y) data_w (Pattern_Variable 5)),\n     (1,301,context_relation_pattern (Pattern_Pair data_x data_z) data_w (Pattern_Variable 6)),\n     (2,305,context_relation_pattern (Pattern_Variable 6) (Pattern_Variable 5) (Pattern_Variable 4))}\"\n\nlemmas observation_schema_defs=observation_member_schema_def observation_absent_schema_def\n  observation_context_schema_def observation_keep_schema_def observation_other_candidate_schema_def\n  observation_other_facet_schema_def observation_pair_schema_def observation_profile_schema_def observation_losses_schema_def\n\ndefinition observation_clause_family :: \"nat \\<Rightarrow> (nat\\<times>(nat,nat,nat) factor_schema) set\" where\n  \"observation_clause_family d=(if d=295 then {(0,observation_context_schema)}\n    else if d=296 then {(0,observation_keep_schema)}\n    else if d=297 then {(0,observation_other_candidate_schema),(1,observation_other_facet_schema)}\n    else if d=298 then context_filter_clauses 295 296 297 298\n    else if d=299 then {(0,observation_pair_schema)}\n    else if d=300 then related_list_clauses 299 300\n    else if d=301 then {(0,observation_profile_schema)}\n    else if d=303 then {(0,observation_member_schema)}\n    else if d=304 then {(0,observation_absent_schema)}\n    else if d=305 then context_filter_clauses 4 304 303 305\n    else if d=306 then {(0,observation_losses_schema)} else {})\"\n\nsection \\<open>The complete ordinary group depends only on actual collection operations\\<close>\n\ndefinition observation_group_system :: \"(nat,nat,nat,nat) schema_system\" where\n  \"observation_group_system=\\<lparr>\n    system_interfaces={(d,data_x) |d. d\\<in>{295,296,297,298,299,300,301,303,304,305,306}},\n    system_clauses={((d,c),S). d\\<in>{295,296,297,298,299,300,301,303,304,305,306} \\<and>\n      (c,S)\\<in>observation_clause_family d}\\<rparr>\"\n\nlemma observation_group_definitions [simp]:\n  \"system_definitions observation_group_system={295,296,297,298,299,300,301,303,304,305,306}\"\n  by (auto simp: observation_group_system_def system_definitions_def rel_dom_def)\n\nlemma observation_group_interfaces [simp]:\n  \"(d,p)\\<in>system_interfaces observation_group_system \\<longleftrightarrow>\n    d\\<in>system_definitions observation_group_system \\<and> p=data_x\"\n  by (simp only: observation_group_definitions; auto simp: observation_group_system_def)\n\nlemma observation_group_clauses [simp]:\n  \"((d,c),S)\\<in>system_clauses observation_group_system \\<longleftrightarrow>\n    d\\<in>system_definitions observation_group_system \\<and> (c,S)\\<in>observation_clause_family d\"\n  by (simp only: observation_group_definitions; auto simp: observation_group_system_def)\n\nlemma observation_group_formed_over:\n  \"schema_system_formed_over {2,3,4,5,132} observation_group_system\"\nproof -\n  have finite: \"finite (observation_clause_family d)\" for d\n    by (simp add: observation_clause_family_def context_filter_clauses_def related_list_clauses_def)\n  have functional: \"single_valued (observation_clause_family d)\" for d\n    by (auto simp: observation_clause_family_def context_filter_clauses_def related_list_clauses_def\n      single_valued_def split: if_splits)\n  have schemas: \"schema_formed S \\<and> schema_dependencies S\\<subseteq>\n      {2,3,4,5,132}\\<union>system_definitions observation_group_system\"\n    if \"(c,S)\\<in>observation_clause_family d\" for c S d\n    using that by (auto simp: observation_clause_family_def observation_schema_defs\n      context_filter_clauses_def context_filter_nil_schema_def context_filter_keep_schema_def\n      context_filter_drop_schema_def related_list_clauses_def related_list_nil_schema_def related_list_step_schema_def\n      schema_formed_def schema_dependencies_def single_valued_def rel_dom_def rel_ran_def octets_formed_def\n      split: if_splits)\n  show ?thesis\n  proof (rule schema_system_formed_over_families[where D=\"{295,296,297,298,299,300,301,303,304,305,306}\"\n      and p=\"\\<lambda>_. data_x\" and C=observation_clause_family])\n    show \"system_interfaces observation_group_system=\n      {(d,data_x) |d. d\\<in>{295,296,297,298,299,300,301,303,304,305,306}}\"\n      by (simp add: observation_group_system_def)\n    show \"system_clauses observation_group_system=\n      {((d,c),S). d\\<in>{295,296,297,298,299,300,301,303,304,305,306} \\<and> (c,S)\\<in>observation_clause_family d}\"\n      by (simp add: observation_group_system_def)\n    show \"finite {295::nat,296,297,298,299,300,301,303,304,305,306}\" by simp\n    show \"pattern_formed data_x\" if \"d\\<in>{295::nat,296,297,298,299,300,301,303,304,305,306}\" for d by simp\n    show \"finite (observation_clause_family d)\" if \"d\\<in>{295,296,297,298,299,300,301,303,304,305,306}\" for d\n      by (rule finite)\n    show \"single_valued (observation_clause_family d)\" if \"d\\<in>{295,296,297,298,299,300,301,303,304,305,306}\" for d\n      by (rule functional)\n    show \"schema_formed S \\<and> schema_dependencies S\\<subseteq>\n      {2,3,4,5,132}\\<union>{295,296,297,298,299,300,301,303,304,305,306}\"\n      if \"d\\<in>{295,296,297,298,299,300,301,303,304,305,306}\" \"(c,S)\\<in>observation_clause_family d\" for d c S\n      using schemas[OF that(2)] by (simp only: observation_group_definitions)\n  qed\nqed\n\nlemma observation_external_dependencies:\n  \"system_external_dependencies observation_group_system={2,3,4,5,132}\"\nproof -\n  have bounded: \"system_external_dependencies observation_group_system\\<subseteq>{2,3,4,5,132}\"\n    by (rule system_external_dependencies_boundary[OF observation_group_formed_over])\n  have reached: \"e\\<in>system_external_dependencies observation_group_system\"\n    if \"((d,c),S)\\<in>system_clauses observation_group_system\" \"e\\<in>schema_dependencies S\"\n      \"e\\<notin>system_definitions observation_group_system\" for d c S e\n  proof -\n    have member: \"e\\<in>(\\<Union>row\\<in>system_clauses observation_group_system. schema_dependencies (snd row))\"\n      by (rule UN_I[OF that(1)]) (use that(2) in simp)\n    show ?thesis using member that(3) by (simp only: system_external_dependencies_clauses Diff_iff; blast)\n  qed\n  have two: \"2\\<in>system_external_dependencies observation_group_system\"\n    by (rule reached[where d=295 and c=0 and S=observation_context_schema])\n      (auto simp: observation_clause_family_def observation_context_schema_def schema_dependencies_def rel_ran_image)\n  have three: \"3\\<in>system_external_dependencies observation_group_system\"\n    by (rule reached[where d=297 and c=0 and S=observation_other_candidate_schema])\n      (auto simp: observation_clause_family_def observation_other_candidate_schema_def schema_dependencies_def rel_ran_image)\n  have four: \"4\\<in>system_external_dependencies observation_group_system\"\n    by (rule reached[where d=295 and c=0 and S=observation_context_schema])\n      (auto simp: observation_clause_family_def observation_context_schema_def schema_dependencies_def rel_ran_image)\n  have five: \"5\\<in>system_external_dependencies observation_group_system\"\n    by (rule reached[where d=303 and c=0 and S=observation_member_schema])\n      (auto simp: observation_clause_family_def observation_member_schema_def schema_dependencies_def rel_ran_image)\n  have absence: \"132\\<in>system_external_dependencies observation_group_system\"\n    by (rule reached[where d=304 and c=0 and S=observation_absent_schema])\n      (auto simp: observation_clause_family_def observation_absent_schema_def schema_dependencies_def rel_ran_image)\n  show ?thesis using bounded two three four five absence by blast\nqed\n\ndefinition observation_base_system :: \"(nat,nat,nat,nat) schema_system\" where\n  \"observation_base_system=rooted_system data_absence_system (system_external_dependencies observation_group_system)\"\n\nlemma observation_base_formed [simp]: \"schema_system_formed observation_base_system\"\n  unfolding observation_base_system_def by (rule rooted_system_formed[OF data_absence_system_formed])\n\nlemma observation_base_subdomain:\n  \"system_definitions observation_base_system\\<subseteq>system_definitions data_absence_system\"\n  unfolding observation_base_system_def by (rule rooted_system_subdomain)\n\nlemma observation_base_roots:\n  \"{2,3,4,5,132}\\<subseteq>system_definitions observation_base_system\"\n  unfolding observation_base_system_def observation_external_dependencies\n  by (rule rooted_system_roots[OF data_absence_system_formed]) auto\n\nlemma observation_base_least:\n  assumes \"{2,3,4,5,132}\\<subseteq>U\" \"system_dependency_closed data_absence_system U\"\n  shows \"system_definitions observation_base_system\\<subseteq>U\"\n  unfolding observation_base_system_def observation_external_dependencies\n  by (rule rooted_system_least[OF data_absence_system_formed _ assms]) auto\n\nlemma observation_base_call:\n  \"schema_call_formed observation_base_system d t \\<longleftrightarrow>\n    d\\<in>system_definitions observation_base_system \\<and> term_formed t\"\n  unfolding observation_base_system_def\n  by (rule rooted_system_variable_calls[OF data_absence_system_formed data_absence_call])\n\ninterpretation observation_group: positive_definition_group observation_base_system observation_group_system\nproof (rule positive_definition_group.intro)\n  show \"schema_system_formed observation_base_system\" by simp\n  show \"schema_system_formed_over (system_definitions observation_base_system) observation_group_system\"\n    by (rule schema_system_formed_over_mono[OF observation_group_formed_over observation_base_roots])\n  show \"system_definitions observation_base_system\\<inter>system_definitions observation_group_system={}\"\n    using observation_base_subdomain by auto\nqed\n\ndefinition observation_system :: \"(nat,nat,nat,nat) schema_system\" where\n  \"observation_system=system_union observation_base_system observation_group_system\"\n\nlemma observation_system_formed [simp]: \"schema_system_formed observation_system\"\n  using observation_group.formed by (simp only: observation_system_def)\n\nlemma observation_definitions [simp]:\n  \"system_definitions observation_system=system_definitions observation_base_system\\<union>system_definitions observation_group_system\"\n  by (simp add: observation_system_def)\n\nlemma observation_call:\n  \"schema_call_formed observation_system d t \\<longleftrightarrow>\n    d\\<in>system_definitions observation_system \\<and> term_formed t\"\n  unfolding observation_system_def\n  by (rule observation_group.variable_calls[where D=\"system_definitions observation_group_system\" and a=0,\n    OF observation_base_call]) (simp only: observation_group_interfaces)\n\nlemma observation_clause:\n  assumes \"d\\<in>system_definitions observation_group_system\"\n  shows \"((d,c),S)\\<in>system_clauses observation_system \\<longleftrightarrow> (c,S)\\<in>observation_clause_family d\"\n  using observation_group.group_clauses[OF assms, of c S]\n  by (simp only: observation_system_def observation_group_clauses; use assms in simp)\n\nlemma observation_base_meaning:\n  assumes \"d\\<in>{2,3,4,5,132}\"\n  shows \"(d,t)\\<in>positive_meaning observation_system \\<longleftrightarrow> (d,t)\\<in>positive_meaning data_absence_system\"\nproof -\n  have member: \"d\\<in>system_definitions observation_base_system\" using observation_base_roots assms by blast\n  show ?thesis\n    using observation_group.old_meaning[OF member, of t]\n      rooted_system_meaning_at[OF data_absence_system_formed member[unfolded observation_base_system_def], of t]\n    by (simp only: observation_system_def observation_base_system_def; blast)\nqed\n\nend\n",
