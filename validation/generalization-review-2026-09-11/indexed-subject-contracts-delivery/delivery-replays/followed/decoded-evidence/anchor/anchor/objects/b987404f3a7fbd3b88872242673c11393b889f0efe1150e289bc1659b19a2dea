          "theory": "Bootstrap_Finite_Closure",
          "source": "theory Bootstrap_Finite_Closure\n  imports Bootstrap_Relations \"HOL-Library.FSet\"\nbegin\n\nsection \\<open>Closure and well-foundedness of complete finite edge relations\\<close>\n\ndefinition finite_edge_compose :: \"('a \\<times> 'b) fset \\<Rightarrow> ('b \\<times> 'c) fset \\<Rightarrow> ('a \\<times> 'c) fset\" where\n  \"finite_edge_compose R S = ffUnion (fimage (\\<lambda>(x,y).\n    fimage (\\<lambda>(u,v). (x,v)) (ffilter (\\<lambda>(u,v). u=y) S)) R)\"\n\nlemma finite_edge_compose_correct:\n  \"fset (finite_edge_compose R S) = fset R O fset S\"\n  by (auto simp: finite_edge_compose_def fimage.rep_eq ffUnion.rep_eq split: prod.splits; force)\n\nsection \\<open>Bounded iteration stops when its state no longer changes\\<close>\n\nfun stabilizing_iteration :: \"nat \\<Rightarrow> ('a \\<Rightarrow> 'a) \\<Rightarrow> 'a \\<Rightarrow> 'a\" where\n  \"stabilizing_iteration 0 f x=x\"\n| \"stabilizing_iteration (Suc n) f x=\n    (let next=f x in if next=x then x else stabilizing_iteration n f next)\"\n\nlemma stabilizing_iteration_exact:\n  \"stabilizing_iteration n f x=(f ^^ n) x\"\nproof (induction n arbitrary: x)\n  case 0\n  show ?case by simp\nnext\n  case (Suc n)\n  show ?case\n  proof (cases \"f x=x\")\n    case True\n    have fixed: \"(f ^^ n) x=x\" using True by (induction n) simp_all\n    show ?thesis using True fixed by (simp add: Let_def funpow_Suc_right)\n  next\n    case False\n    show ?thesis using Suc.IH[of \"f x\"] False\n      by (simp only: stabilizing_iteration.simps Let_def funpow_Suc_right comp_apply if_False)\n  qed\nqed\n\nfun finite_path_bound :: \"nat \\<Rightarrow> ('a \\<times> 'a) fset \\<Rightarrow> ('a \\<times> 'a) fset\" where\n  \"finite_path_bound 0 E = E\"\n| \"finite_path_bound (Suc n) E =\n    finite_path_bound n E |\\<union>| finite_edge_compose (finite_path_bound n E) E\"\n\n\nlemma finite_path_bound_shared_step:\n  \"finite_path_bound (Suc n) E =\n    (let previous=finite_path_bound n E in previous |\\<union>| finite_edge_compose previous E)\"\n  by (simp only: Let_def finite_path_bound.simps)\n\nlemma finite_path_bound_code [code]:\n  \"finite_path_bound n E =\n    (if n=0 then E else\n      (let previous=finite_path_bound (n-1) E in previous |\\<union>| finite_edge_compose previous E))\"\n  by (cases n) (simp_all add: Let_def)\n\nlemma finite_path_bound_correct:\n  \"fset (finite_path_bound n E) = ntrancl n (fset E)\"\n  by (induction n) (auto simp: finite_edge_compose_correct)\n\ndefinition finite_edge_closure :: \"('a \\<times> 'a) fset \\<Rightarrow> ('a \\<times> 'a) fset\" where\n  \"finite_edge_closure E = finite_path_bound (fcard E - 1) E\"\n\nlemma finite_path_bound_iteration:\n  \"finite_path_bound n E=((\\<lambda>R. R |\\<union>| finite_edge_compose R E) ^^ n) E\"\n  by (induction n) simp_all\n\nlemma finite_edge_closure_stable_code [code]:\n  \"finite_edge_closure E=stabilizing_iteration (fcard E-1)\n    (\\<lambda>R. R |\\<union>| finite_edge_compose R E) E\"\n  by (simp only: finite_edge_closure_def stabilizing_iteration_exact finite_path_bound_iteration)\n\nlemma finite_edge_closure_correct:\n  \"fset (finite_edge_closure E) = (fset E)\\<^sup>+\"\n  by (simp add: finite_edge_closure_def finite_path_bound_correct fcard.rep_eq finite_trancl_ntranl)\n\ndefinition finite_edge_reaches :: \"('a \\<times> 'a) fset \\<Rightarrow> 'a \\<Rightarrow> 'a \\<Rightarrow> bool\" where\n  \"finite_edge_reaches E x y \\<longleftrightarrow> x=y \\<or> (x,y) |\\<in>| finite_edge_closure E\"\n\nlemma finite_edge_reaches_correct:\n  \"finite_edge_reaches E x y \\<longleftrightarrow> (x,y) \\<in> (fset E)\\<^sup>*\"\n  by (auto simp: finite_edge_reaches_def finite_edge_closure_correct rtrancl_eq_or_trancl)\n\ndefinition finite_edge_wellfounded :: \"('a \\<times> 'a) fset \\<Rightarrow> bool\" where\n  \"finite_edge_wellfounded E \\<longleftrightarrow> fBall (finite_edge_closure E) (\\<lambda>(x,y). x\\<noteq>y)\"\n\nlemma finite_edge_wellfounded_correct:\n  \"finite_edge_wellfounded E \\<longleftrightarrow> wf (fset E)\"\n  by (auto simp: finite_edge_wellfounded_def finite_edge_closure_correct\n      wf_iff_acyclic_if_finite acyclic_def Ball_def split_paired_All)\n\nsection \\<open>Finite labelled transitions recover every reachable output\\<close>\n\ndefinition finite_transition_keys :: \"('a \\<Rightarrow> 'k) \\<Rightarrow> ('k \\<times> 'a) fset \\<Rightarrow> ('k \\<times> 'k) fset\" where\n  \"finite_transition_keys key R = fimage (\\<lambda>(k,a). (k,key a)) R\"\n\ndefinition finite_reachable_outputs :: \"('a \\<Rightarrow> 'k) \\<Rightarrow> ('k \\<times> 'a) fset \\<Rightarrow> 'a \\<Rightarrow> 'a fset\" where\n  \"finite_reachable_outputs key R root = finsert root\n    (fimage snd (ffilter (\\<lambda>(k,a). finite_edge_reaches (finite_transition_keys key R) (key root) k) R))\"\n\nlemma finite_transition_keys_member:\n  \"(k,l) |\\<in>| finite_transition_keys key R \\<longleftrightarrow> (\\<exists>a. (k,a) |\\<in>| R \\<and> l=key a)\"\n  by (auto simp: finite_transition_keys_def fimage.rep_eq)\n\nlemma finite_reachable_outputs_member:\n  \"a |\\<in>| finite_reachable_outputs key R root \\<longleftrightarrow>\n    a=root \\<or> (\\<exists>k. (k,a) |\\<in>| R \\<and> (key root,k) \\<in> (fset (finite_transition_keys key R))\\<^sup>*)\"\n  by (auto simp: finite_reachable_outputs_def finite_edge_reaches_correct fimage.rep_eq\n      split: prod.splits intro: rev_image_eqI; force)\n\nlemma finite_reachable_outputs_invariant:\n  fixes root :: 'a and key :: \"'a \\<Rightarrow> 'k\"\n  assumes initial: \"root \\<in> A\"\n    and advance: \"\\<And>a b. a \\<in> A \\<Longrightarrow> (key a,b) |\\<in>| R \\<Longrightarrow> b \\<in> A\"\n  shows \"fset (finite_reachable_outputs key R root) \\<subseteq> A\"\nproof -\n  have reachable: \"\\<And>k. (key root,k) \\<in> (fset (finite_transition_keys key R))\\<^sup>* \\<Longrightarrow>\n      (\\<exists>a\\<in>A. key a=k)\"\n  proof -\n    fix k assume path: \"(key root,k) \\<in> (fset (finite_transition_keys key R))\\<^sup>*\"\n    show \"\\<exists>a\\<in>A. key a=k\"\n      using path\n    proof (induction rule: rtrancl_induct)\n      case base\n      show ?case using initial by blast\n    next\n      case (step k l)\n      obtain a where a: \"a \\<in> A\" \"key a=k\" using step.IH by blast\n      obtain b where b: \"(k,b) |\\<in>| R\" \"l=key b\"\n        using step.hyps(2) by (simp only: finite_transition_keys_member) blast\n      have member: \"b \\<in> A\" by (rule advance[OF a(1)]) (use a(2) b(1) in simp)\n      show ?case using member b(2) by blast\n    qed\n  qed\n  show ?thesis\n  proof\n    fix a assume member: \"a \\<in> fset (finite_reachable_outputs key R root)\"\n    show \"a \\<in> A\"\n    proof (cases \"a=root\")\n      case True\n      show ?thesis using initial True by simp\n    next\n      case False\n      obtain k where row: \"(k,a) |\\<in>| R\" and path: \"(key root,k) \\<in> (fset (finite_transition_keys key R))\\<^sup>*\"\n        using member False by (auto simp: finite_reachable_outputs_member)\n      obtain b where b: \"b \\<in> A\" \"key b=k\" using reachable[OF path] by blast\n      show ?thesis by (rule advance[OF b(1)]) (use b(2) row in simp)\n    qed\n  qed\nqed\n\n\nsection \\<open>Several roots share the same complete transition closure\\<close>\n\ndefinition finite_reachable_outputs_from ::\n  \"('a \\<Rightarrow> 'k) \\<Rightarrow> ('k\\<times>'a) fset \\<Rightarrow> 'a fset \\<Rightarrow> 'a fset\" where\n  \"finite_reachable_outputs_from key R roots=ffUnion (fimage (finite_reachable_outputs key R) roots)\"\n\nlemma finite_reachable_outputs_from_member:\n  \"a\\<in>fset (finite_reachable_outputs_from key R roots) \\<longleftrightarrow>\n    a\\<in>fset roots \\<or> (\\<exists>r\\<in>fset roots. \\<exists>k. (k,a)\\<in>fset R \\<and>\n      (key r,k)\\<in>(fset (finite_transition_keys key R))\\<^sup>*)\"\n  by (auto simp: finite_reachable_outputs_from_def ffUnion.rep_eq fimage.rep_eq\n    finite_reachable_outputs_member)\n\nlemma finite_reachable_outputs_from_empty [simp]:\n  \"finite_reachable_outputs_from key R {||}={||}\"\n  by (simp add: finite_reachable_outputs_from_def)\n\nlemma finite_reachable_outputs_from_singleton [simp]:\n  \"finite_reachable_outputs_from key R {|root|}=finite_reachable_outputs key R root\"\n  by (simp add: finite_reachable_outputs_from_def)\n\ntheorem finite_reachable_outputs_from_union:\n  \"finite_reachable_outputs_from key R (A |\\<union>| B)=\n    finite_reachable_outputs_from key R A |\\<union>| finite_reachable_outputs_from key R B\"\nproof -\n  have \"fset (finite_reachable_outputs_from key R (A |\\<union>| B))=\n      fset (finite_reachable_outputs_from key R A |\\<union>| finite_reachable_outputs_from key R B)\"\n    by (auto simp: finite_reachable_outputs_from_member)\n  then show ?thesis by (simp only: fset_inject)\nqed\n\nlemma finite_reachable_outputs_from_code [code]:\n  \"finite_reachable_outputs_from key R roots =\n    (let paths=finite_edge_closure (finite_transition_keys key R); keys=fimage key roots\n     in roots |\\<union>| fimage snd (ffilter (\\<lambda>(k,a).\n       k\\<in>fset keys \\<or> (\\<exists>r\\<in>fset keys. (r,k)\\<in>fset paths)) R))\"\nproof -\n  have equality: \"fset (finite_reachable_outputs_from key R roots)=\n      fset (let paths=finite_edge_closure (finite_transition_keys key R); keys=fimage key roots\n        in roots |\\<union>| fimage snd (ffilter (\\<lambda>(k,a).\n          k\\<in>fset keys \\<or> (\\<exists>r\\<in>fset keys. (r,k)\\<in>fset paths)) R))\"\n    by (auto simp: finite_reachable_outputs_from_member Let_def fimage.rep_eq\n      finite_edge_closure_correct rtrancl_eq_or_trancl split: prod.splits; force)\n  show ?thesis using equality by (simp only: fset_inject)\nqed\n\nlemma finite_reachable_outputs_code [code]:\n  \"finite_reachable_outputs key R root=finite_reachable_outputs_from key R {|root|}\"\n  by simp\n\ntext \\<open>\n  Every finite root family has exactly the union of its original reachable\n  outputs. The shared evaluation retains all initial values and every labelled\n  output, including different values with the same transition key. Empty\n  families, cycles, and unrelated edges keep their original meanings.\n\n  The proved code equations compute each recursive prefix once and reuse one\n  complete transition closure across all roots. They change no mathematical\n  definition or path bound. Choosing a private iteration order does not add a\n  root, omit an edge, or identify output values through their keys.\n\\<close>\n\nexport_code finite_edge_closure finite_edge_reaches finite_edge_wellfounded finite_reachable_outputs checking SML\n\ntext \\<open>\n  Bounded iteration stops as soon as its state is unchanged. Its exactness\n  theorem holds for every update function and every supplied bound, so the\n  closure code retains the original path bound and complete relation.\n\n  The iteration bound is derived from the number of supplied edges. The empty\n  relation is included. Closure contains every finite path, and a finite\n  relation is well-founded exactly when its closure contains no self-edge.\n  No enumeration order or additional edge is part of the input.\n\\<close>\n\nend\n",
          "sha256": "df469431d4c9e4f95b2b3b3d192d7da9d677800b0383609dd25b212264581bc5"
        },
