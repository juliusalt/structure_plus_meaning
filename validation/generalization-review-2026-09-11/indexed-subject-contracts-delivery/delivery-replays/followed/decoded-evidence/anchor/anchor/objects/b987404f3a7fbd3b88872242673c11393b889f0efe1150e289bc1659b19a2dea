          "theory": "Factor_Compiled_Applications",
          "source": "theory Factor_Compiled_Applications\n  imports Factor_Program_Compilation Factor_Future_Applications\nbegin\n\nsection \\<open>The compiled program accepts exactly the source application boundary\\<close>\n\nlemma compiled_system_call_boundary:\n  assumes formed: \"schema_system_formed P\" and injective: \"inj_on g (system_definitions P)\"\n    and variant: \"system_alpha_variant (rename_system g P) Q\" and member: \"d \\<in> system_definitions P\"\n  shows \"schema_call_formed Q (g d) t \\<longleftrightarrow> schema_call_formed P d t\"\n  using system_alpha_calls[OF variant, of \"g d\" t] renamed_system_call[OF formed injective member, of t] by blast\n\nlemma compiled_system_meaning_at:\n  assumes injective: \"inj_on g (system_definitions P)\" and member: \"d \\<in> system_definitions P\"\n    and meaning: \"positive_meaning Q = map_prod g id ` positive_meaning P\"\n  shows \"(g d,t) \\<in> positive_meaning Q \\<longleftrightarrow> (d,t) \\<in> positive_meaning P\"\nproof\n  assume \"(g d,t) \\<in> positive_meaning Q\"\n  then obtain e x where source: \"(e,x) \\<in> positive_meaning P\" \"g d=g e\" \"t=x\"\n    using meaning by (auto simp: map_prod_def)\n  have call: \"schema_call_formed P e x\" by (rule positive_meaning_formed[OF source(1)])\n  have inside: \"e \\<in> system_definitions P\" using schema_call_formed_target[OF call] by blast\n  have same: \"d=e\" by (rule inj_onD[OF injective source(2) member inside])\n  show \"(d,t) \\<in> positive_meaning P\" using source(1,3) same by simp\nnext\n  assume source: \"(d,t) \\<in> positive_meaning P\"\n  have \"map_prod g id (d,t) \\<in> map_prod g id ` positive_meaning P\" by (rule imageI[OF source])\n  then show \"(g d,t) \\<in> positive_meaning Q\" using meaning by simp\nqed\n\nlemma native_package_definition_anchor:\n  assumes package: \"native_package_at E pu pr Q\" and member: \"d \\<in> system_definitions Q\"\n  shows \"\\<exists>R. artifact_at E (fst d) R \\<and> anchor_formed (R,snd d)\"\nproof -\n  have formed: \"native_package_formed E (native_package_roots E pu pr)\" by (rule native_package_projection(1)[OF package])\n  have site: \"d \\<in> native_definition_sites E (native_package_roots E pu pr)\"\n    using member native_package_projection(3)[OF package] by (simp add: native_package_sites_def)\n  obtain p C where read: \"native_definition_at E (fst d) (snd d) p C\"\n    using formed site by (auto simp: native_package_formed_def)\n  show ?thesis by (rule native_definition_has_anchor[OF read])\nqed\n\nsection \\<open>Every formed argument extends an existing native package\\<close>\n\ntheorem native_application_extension_total:\n  fixes E :: \"local_address option artifact_environment\"\n  assumes package: \"native_package_at E pu pr P\" and member: \"d\\<in>system_definitions P\"\n    and arg: \"term_formed t\"\n  shows \"\\<exists>F au I K. environment_formed F \\<and> environment_included E F \\<and>\n    au\\<notin>environment_uses E \\<and> native_package_at F pu pr P \\<and>\n    native_application_at F au [] d t I K \\<and>\n    native_package_environment F pu pr=native_package_environment E pu pr \\<and>\n    (native_application_formed F pu pr au []\\<longleftrightarrow>schema_call_formed P d t) \\<and>\n    (native_positive_holds F pu pr au []\\<longleftrightarrow>(d,t)\\<in>positive_meaning P) \\<and>\n    (\\<forall>v\\<in>environment_uses E. \\<forall>R. artifact_at F v R\\<longleftrightarrow>artifact_at E v R) \\<and>\n    (\\<forall>v\\<in>environment_uses E. \\<forall>k w. binds_slot F v k w\\<longleftrightarrow>binds_slot E v k w)\"\nproof -\n  have ef: \"environment_formed E\"\n    using native_package_projection(1)[OF package] by (simp add: native_package_formed_def)\n  obtain R where source: \"artifact_at E (fst d) R\" \"anchor_formed (R,snd d)\"\n    using native_package_definition_anchor[OF package member] by blast\n  let ?F=\"future_call_environment E (fst d) R (snd d) t\"\n  let ?au=\"future_call_use E (fst d)\"\n  have ff: \"environment_formed ?F\" by (rule future_call_environment_formed[OF ef source arg])\n  have included: \"environment_included E ?F\" by (rule future_call_includes_existing)\n  have fresh: \"?au\\<notin>environment_uses E\" by (rule future_call_use_fresh[OF ef])\n  obtain I K where app: \"native_application_at ?F ?au [] d t I K\"\n    using future_call_representation[OF ef source arg] by auto\n  have preserved: \"native_package_at ?F pu pr P\"\n    by (rule future_call_preserves_program(1)[OF package source arg])\n  have canonical: \"native_package_environment ?F pu pr=native_package_environment E pu pr\"\n    by (rule future_call_preserves_program(2)[OF package source arg])\n  have boundary: \"native_application_formed ?F pu pr ?au []\\<longleftrightarrow>schema_call_formed P d t\"\n    by (rule native_application_formed_with_reads[OF preserved app])\n  have truth: \"native_positive_holds ?F pu pr ?au []\\<longleftrightarrow>(d,t)\\<in>positive_meaning P\"\n    by (rule native_positive_holds_with_reads[OF preserved app])\n  have arts: \"\\<forall>v\\<in>environment_uses E. \\<forall>S. artifact_at ?F v S\\<longleftrightarrow>artifact_at E v S\"\n    by (intro ballI allI) (rule future_call_existing_artifacts[OF ef source arg]; assumption)\n  have bindings: \"\\<forall>v\\<in>environment_uses E. \\<forall>k w. binds_slot ?F v k w\\<longleftrightarrow>binds_slot E v k w\"\n    by (intro ballI allI) (rule future_call_existing_bindings[OF ef]; assumption)\n  show ?thesis\n    by (rule exI[of _ ?F], rule exI[of _ ?au], rule exI[of _ I], rule exI[of _ K])\n       (use ff included fresh preserved app canonical boundary truth arts bindings in blast)\nqed\n\nsection \\<open>One closed finite native program for all future formed arguments\\<close>\n\ntheorem compiled_program_with_future_applications:\n  assumes formed: \"schema_system_formed P\"\n  shows \"\\<exists>g :: 'd \\<Rightarrow> local_address option definition_site. \\<exists>E pu Q.\n    inj_on g (system_definitions P) \\<and> closed_native_package_at E pu [] Q \\<and>\n    native_package_environment E pu []=E \\<and> system_alpha_variant (rename_system g P) Q \\<and>\n    positive_meaning Q=image (map_prod g id) (positive_meaning P) \\<and>\n    (\\<forall>d\\<in>system_definitions P. \\<forall>t. term_formed t \\<longrightarrow>\n      (\\<exists>F au I K. environment_formed F \\<and> environment_included E F \\<and> au \\<notin> environment_uses E \\<and>\n        native_package_at F pu [] Q \\<and> native_application_at F au [] (g d) t I K \\<and>\n        native_package_environment F pu [] = E \\<and>\n        (native_application_formed F pu [] au [] \\<longleftrightarrow> schema_call_formed P d t) \\<and>\n        (native_positive_holds F pu [] au [] \\<longleftrightarrow> (d,t) \\<in> positive_meaning P) \\<and>\n        (\\<forall>v\\<in>environment_uses E. \\<forall>R. artifact_at F v R \\<longleftrightarrow> artifact_at E v R) \\<and>\n        (\\<forall>v\\<in>environment_uses E. \\<forall>k w. binds_slot F v k w \\<longleftrightarrow> binds_slot E v k w)))\"\nproof -\n  obtain g :: \"'d \\<Rightarrow> local_address option definition_site\"\n    and E :: \"local_address option artifact_environment\" and pu and Q where compiled:\n    \"inj_on g (system_definitions P)\" \"closed_native_package_at E pu [] Q\"\n    \"native_package_environment E pu [] = E\" \"system_alpha_variant (rename_system g P) Q\"\n    \"positive_meaning Q = map_prod g id ` positive_meaning P\"\n    using program_compilation_total[OF formed] by metis\n  have package: \"native_package_at E pu [] Q\" using compiled(2) by (simp add: closed_native_package_at_def)\n  have defs: \"system_definitions Q = g ` system_definitions P\"\n    using compiled(4) by (simp add: system_alpha_variant_def renamed_system_definitions)\n  have all_calls: \"\\<forall>d\\<in>system_definitions P. \\<forall>t. term_formed t \\<longrightarrow>\n    (\\<exists>F au I K. environment_formed F \\<and> environment_included E F \\<and> au \\<notin> environment_uses E \\<and>\n      native_package_at F pu [] Q \\<and> native_application_at F au [] (g d) t I K \\<and>\n      native_package_environment F pu [] = E \\<and>\n      (native_application_formed F pu [] au [] \\<longleftrightarrow> schema_call_formed P d t) \\<and>\n      (native_positive_holds F pu [] au [] \\<longleftrightarrow> (d,t) \\<in> positive_meaning P) \\<and>\n      (\\<forall>v\\<in>environment_uses E. \\<forall>R. artifact_at F v R \\<longleftrightarrow> artifact_at E v R) \\<and>\n      (\\<forall>v\\<in>environment_uses E. \\<forall>k w. binds_slot F v k w \\<longleftrightarrow> binds_slot E v k w))\"\n  proof (intro ballI allI impI)\n    fix d t assume member: \"d \\<in> system_definitions P\" and arg: \"term_formed t\"\n    have target: \"g d \\<in> system_definitions Q\" using imageI[OF member, of g] defs by simp\n    obtain F au I K where future: \"environment_formed F\" \"environment_included E F\"\n      \"au\\<notin>environment_uses E\" \"native_package_at F pu [] Q\"\n      \"native_application_at F au [] (g d) t I K\"\n      \"native_package_environment F pu []=native_package_environment E pu []\"\n      \"native_application_formed F pu [] au []\\<longleftrightarrow>schema_call_formed Q (g d) t\"\n      \"native_positive_holds F pu [] au []\\<longleftrightarrow>(g d,t)\\<in>positive_meaning Q\"\n      \"\\<forall>v\\<in>environment_uses E. \\<forall>R. artifact_at F v R\\<longleftrightarrow>artifact_at E v R\"\n      \"\\<forall>v\\<in>environment_uses E. \\<forall>k w. binds_slot F v k w\\<longleftrightarrow>binds_slot E v k w\"\n      using native_application_extension_total[OF package target arg] by blast\n    have canonical: \"native_package_environment F pu []=E\" using future(6) compiled(3) by simp\n    have boundary: \"native_application_formed F pu [] au []\\<longleftrightarrow>schema_call_formed P d t\"\n      using future(7) compiled_system_call_boundary[OF formed compiled(1,4) member] by blast\n    have truth: \"native_positive_holds F pu [] au []\\<longleftrightarrow>(d,t)\\<in>positive_meaning P\"\n      using future(8) compiled_system_meaning_at[OF compiled(1) member compiled(5)] by blast\n    show \"\\<exists>F au I K. environment_formed F \\<and> environment_included E F \\<and> au \\<notin> environment_uses E \\<and>\n      native_package_at F pu [] Q \\<and> native_application_at F au [] (g d) t I K \\<and>\n      native_package_environment F pu [] = E \\<and>\n      (native_application_formed F pu [] au [] \\<longleftrightarrow> schema_call_formed P d t) \\<and>\n      (native_positive_holds F pu [] au [] \\<longleftrightarrow> (d,t) \\<in> positive_meaning P) \\<and>\n      (\\<forall>v\\<in>environment_uses E. \\<forall>R. artifact_at F v R \\<longleftrightarrow> artifact_at E v R) \\<and>\n      (\\<forall>v\\<in>environment_uses E. \\<forall>k w. binds_slot F v k w \\<longleftrightarrow> binds_slot E v k w)\"\n      by (rule exI[of _ F], rule exI[of _ au], rule exI[of _ I], rule exI[of _ K])\n         (use future(1-5,9,10) canonical boundary truth in blast)\n  qed\n  show ?thesis by (rule exI[of _ g], rule exI[of _ E], rule exI[of _ pu], rule exI[of _ Q])\n    (use compiled all_calls in blast)\nqed\n\ntheorem compiled_program_future_applications:\n  assumes formed: \"schema_system_formed P\"\n  shows \"\\<exists>g :: 'd \\<Rightarrow> local_address option definition_site. \\<exists>E pu Q.\n    inj_on g (system_definitions P) \\<and> closed_native_package_at E pu [] Q \\<and>\n    (\\<forall>d\\<in>system_definitions P. \\<forall>t. term_formed t \\<longrightarrow>\n      (\\<exists>F au I K. environment_formed F \\<and> environment_included E F \\<and> au \\<notin> environment_uses E \\<and>\n        native_package_at F pu [] Q \\<and> native_application_at F au [] (g d) t I K \\<and>\n        native_package_environment F pu [] = E \\<and>\n        (native_application_formed F pu [] au [] \\<longleftrightarrow> schema_call_formed P d t) \\<and>\n        (native_positive_holds F pu [] au [] \\<longleftrightarrow> (d,t) \\<in> positive_meaning P) \\<and>\n        (\\<forall>v\\<in>environment_uses E. \\<forall>R. artifact_at F v R \\<longleftrightarrow> artifact_at E v R) \\<and>\n        (\\<forall>v\\<in>environment_uses E. \\<forall>k w. binds_slot F v k w \\<longleftrightarrow> binds_slot E v k w)))\"\n  using compiled_program_with_future_applications[OF formed]\n  apply (elim exE conjE)\n  subgoal for g E pu Q\n    by (rule exI[of _ g], rule exI[of _ E], rule exI[of _ pu], rule exI[of _ Q])\n      (intro conjI; assumption)\n  done\n\nsection \\<open>Local operation contracts survive the same fixed compilation\\<close>\n\ntheorem compiled_exact_operations:\n  fixes P :: \"('a,'s,'d,'c) schema_system\"\n  assumes formed: \"schema_system_formed P\" and selected: \"D\\<subseteq>system_definitions P\"\n    and calls: \"\\<And>d t. d\\<in>D \\<Longrightarrow> schema_call_formed P d t \\<longleftrightarrow> term_formed t\"\n    and exact: \"\\<And>d t. d\\<in>D \\<Longrightarrow> (d,t)\\<in>positive_meaning P \\<longleftrightarrow> J d t\"\n  shows \"\\<exists>E :: local_address option artifact_environment. \\<exists>pu Q g.\n    closed_native_package_at E pu [] Q \\<and> native_package_environment E pu []=E \\<and> inj_on g D \\<and>\n    (\\<forall>d\\<in>D. \\<forall>t. term_formed t \\<longrightarrow>\n      (\\<exists>F au I K. environment_formed F \\<and> environment_included E F \\<and> au\\<notin>environment_uses E \\<and>\n        native_package_at F pu [] Q \\<and> native_application_at F au [] (g d) t I K \\<and>\n        native_package_environment F pu []=E \\<and> native_application_formed F pu [] au [] \\<and>\n        (native_positive_holds F pu [] au [] \\<longleftrightarrow> J d t) \\<and>\n        (\\<forall>v\\<in>environment_uses E. \\<forall>R. artifact_at F v R \\<longleftrightarrow> artifact_at E v R) \\<and>\n        (\\<forall>v\\<in>environment_uses E. \\<forall>k w. binds_slot F v k w \\<longleftrightarrow> binds_slot E v k w)))\"\nproof -\n  obtain g :: \"'d \\<Rightarrow> local_address option definition_site\"\n    and E :: \"local_address option artifact_environment\" and pu Q\n    where injective: \"inj_on g (system_definitions P)\"\n    and closed: \"closed_native_package_at E pu [] Q\"\n    and scope: \"native_package_environment E pu []=E\"\n    and future: \"\\<forall>d\\<in>system_definitions P. \\<forall>t. term_formed t \\<longrightarrow>\n      (\\<exists>F au I K. environment_formed F \\<and> environment_included E F \\<and> au\\<notin>environment_uses E \\<and>\n        native_package_at F pu [] Q \\<and> native_application_at F au [] (g d) t I K \\<and>\n        native_package_environment F pu []=E \\<and>\n        (native_application_formed F pu [] au [] \\<longleftrightarrow> schema_call_formed P d t) \\<and>\n        (native_positive_holds F pu [] au [] \\<longleftrightarrow> (d,t)\\<in>positive_meaning P) \\<and>\n        (\\<forall>v\\<in>environment_uses E. \\<forall>R. artifact_at F v R \\<longleftrightarrow> artifact_at E v R) \\<and>\n        (\\<forall>v\\<in>environment_uses E. \\<forall>k w. binds_slot F v k w \\<longleftrightarrow> binds_slot E v k w))\"\n    using compiled_program_with_future_applications[OF formed]\n    by (elim exE conjE) (rule that; assumption)\n  have sites: \"inj_on g D\" by (rule inj_on_subset[OF injective selected])\n  show ?thesis\n  proof (rule exI[of _ E], rule exI[of _ pu], rule exI[of _ Q], rule exI[of _ g], intro conjI ballI allI impI)\n    show \"closed_native_package_at E pu [] Q\" by (rule closed)\n    show \"native_package_environment E pu []=E\" by (rule scope)\n    show \"inj_on g D\" by (rule sites)\n  next\n    fix d :: 'd and t :: factor_term\n    assume member: \"d\\<in>D\" and arg: \"term_formed t\"\n    have inside: \"d\\<in>system_definitions P\" using selected member by blast\n    obtain F au I K where parts: \"environment_formed F\" \"environment_included E F\" \"au\\<notin>environment_uses E\"\n      \"native_package_at F pu [] Q\" \"native_application_at F au [] (g d) t I K\"\n      \"native_package_environment F pu []=E\"\n      \"native_application_formed F pu [] au [] \\<longleftrightarrow> schema_call_formed P d t\"\n      \"native_positive_holds F pu [] au [] \\<longleftrightarrow> (d,t)\\<in>positive_meaning P\"\n      \"\\<forall>v\\<in>environment_uses E. \\<forall>R. artifact_at F v R \\<longleftrightarrow> artifact_at E v R\"\n      \"\\<forall>v\\<in>environment_uses E. \\<forall>k w. binds_slot F v k w \\<longleftrightarrow> binds_slot E v k w\"\n      using future[rule_format, OF inside arg]\n      by (elim exE conjE) (rule that; assumption)\n    show \"\\<exists>F au I K. environment_formed F \\<and> environment_included E F \\<and> au\\<notin>environment_uses E \\<and>\n      native_package_at F pu [] Q \\<and> native_application_at F au [] (g d) t I K \\<and>\n      native_package_environment F pu []=E \\<and> native_application_formed F pu [] au [] \\<and>\n      (native_positive_holds F pu [] au [] \\<longleftrightarrow> J d t) \\<and>\n      (\\<forall>v\\<in>environment_uses E. \\<forall>R. artifact_at F v R \\<longleftrightarrow> artifact_at E v R) \\<and>\n      (\\<forall>v\\<in>environment_uses E. \\<forall>k w. binds_slot F v k w \\<longleftrightarrow> binds_slot E v k w)\"\n      by (rule exI[of _ F], rule exI[of _ au], rule exI[of _ I], rule exI[of _ K])\n        (use parts arg calls[OF member] exact[OF member] in blast)\n  qed\nqed\n\ntext \\<open>\n  A single finite closed compilation serves every formed future argument at\n  every source definition. Each call has actual native syntax, the original\n  interface boundary, and exactly the original positive truth. The canonical\n  program environment and all of its existing artifacts and bindings remain\n  unchanged when those future arguments are added. Selected operations may\n  export their already proved local equations through the same construction.\n  The expected relation in that theorem is a proof contract for the supplied\n  actual program; it does not provide a new primitive or a method to compile\n  an arbitrary mathematical predicate.\n\\<close>\n\nend\n",
