          "theory": "Inference_Closure",
          "source": "theory Inference_Closure\n  imports Obligation_Reductions\nbegin\n\nsection \\<open>Local inference rules determine their least consequences\\<close>\n\ndefinition inference_consequences ::\n  \"('a \\<Rightarrow> ('i \\<times> 'a) set \\<Rightarrow> bool) \\<Rightarrow> 'a set \\<Rightarrow> 'a set\" where\n  \"inference_consequences R X={a. \\<exists>H. finite H \\<and> single_valued H \\<and>\n    R a H \\<and> rel_ran H\\<subseteq>X}\"\n\nlemma inference_consequences_mono:\n  \"mono (inference_consequences R)\"\n  by (auto simp: mono_def inference_consequences_def)\n\ndefinition inference_closure ::\n  \"('a \\<Rightarrow> ('i \\<times> 'a) set \\<Rightarrow> bool) \\<Rightarrow> 'a set \\<Rightarrow> 'a set\" where\n  \"inference_closure R K=lfp (\\<lambda>X. K\\<union>inference_consequences R X)\"\n\nlemma inference_closure_unfold:\n  \"inference_closure R K=K\\<union>inference_consequences R (inference_closure R K)\"\n  unfolding inference_closure_def\n  by (rule lfp_unfold) (use inference_consequences_mono in \\<open>auto simp: mono_def\\<close>)\n\nlemma inference_closure_seed:\n  \"K\\<subseteq>inference_closure R K\"\n  by (subst inference_closure_unfold) blast\n\nlemma inference_closure_step:\n  assumes \"finite H\" \"single_valued H\" \"R a H\" \"rel_ran H\\<subseteq>inference_closure R K\"\n  shows \"a\\<in>inference_closure R K\"\n  by (subst inference_closure_unfold)\n    (use assms in \\<open>auto simp: inference_consequences_def\\<close>)\n\ntheorem inference_closure_least:\n  assumes \"K\\<subseteq>X\" \"inference_consequences R X\\<subseteq>X\"\n  shows \"inference_closure R K\\<subseteq>X\"\n  unfolding inference_closure_def\n  by (rule lfp_lowerbound) (use assms in blast)\n\nlemma inference_closure_closed:\n  \"inference_consequences R (inference_closure R K)\\<subseteq>inference_closure R K\"\n  using inference_closure_unfold[of R K] by blast\n\ntheorem inference_closure_mono:\n  assumes \"K\\<subseteq>L\"\n  shows \"inference_closure R K\\<subseteq>inference_closure R L\"\n  by (rule inference_closure_least)\n    (use assms inference_closure_seed[of L R] inference_closure_closed[of R L] in blast)+\n\ntheorem inference_closure_idempotent:\n  \"inference_closure R (inference_closure R K)=inference_closure R K\"\nproof (rule equalityI)\n  show \"inference_closure R (inference_closure R K)\\<subseteq>inference_closure R K\"\n    by (rule inference_closure_least[OF subset_refl inference_closure_closed])\n  show \"inference_closure R K\\<subseteq>inference_closure R (inference_closure R K)\"\n    by (rule inference_closure_seed)\nqed\n\ntheorem inference_closure_cut:\n  assumes \"a\\<in>inference_closure R H\" \"H\\<subseteq>inference_closure R K\"\n  shows \"a\\<in>inference_closure R K\"\nproof -\n  have enlarged: \"inference_closure R H\\<subseteq>inference_closure R (inference_closure R K)\"\n    by (rule inference_closure_mono[OF assms(2)])\n  have included: \"inference_closure R H\\<subseteq>inference_closure R K\"\n    using enlarged by (simp only: inference_closure_idempotent)\n  show ?thesis by (rule subsetD[OF included assms(1)])\nqed\n\ntheorem inference_closure_accumulate:\n  \"inference_closure R (inference_closure R K\\<union>L)=inference_closure R (K\\<union>L)\"\nproof (rule equalityI)\n  have \"inference_closure R K\\<union>L\\<subseteq>inference_closure R (K\\<union>L)\"\n    using inference_closure_mono[of K \"K\\<union>L\" R]\n      inference_closure_seed[of \"K\\<union>L\" R] by blast\n  then show \"inference_closure R (inference_closure R K\\<union>L)\\<subseteq>\n      inference_closure R (K\\<union>L)\"\n    using inference_closure_mono by (metis inference_closure_idempotent)\nnext\n  show \"inference_closure R (K\\<union>L)\\<subseteq>\n      inference_closure R (inference_closure R K\\<union>L)\"\n    by (rule inference_closure_mono) (use inference_closure_seed[of K R] in blast)\nqed\n\nsection \\<open>Finite derivation and semantic soundness remain distinct\\<close>\n\ninductive finite_inference ::\n  \"('a \\<Rightarrow> ('i \\<times> 'a) set \\<Rightarrow> bool) \\<Rightarrow> 'a set \\<Rightarrow> 'a \\<Rightarrow> bool\"\n  for R K where\n  seed: \"a\\<in>K \\<Longrightarrow> finite_inference R K a\"\n| step: \"finite H \\<Longrightarrow> single_valued H \\<Longrightarrow> R a H \\<Longrightarrow>\n    (\\<forall>b\\<in>rel_ran H. finite_inference R K b) \\<Longrightarrow> finite_inference R K a\"\n\ntheorem finite_inference_sound:\n  \"finite_inference R K a \\<Longrightarrow> a\\<in>inference_closure R K\"\nproof (induction rule: finite_inference.induct)\n  case (seed a)\n  show ?case by (rule subsetD[OF inference_closure_seed seed])\nnext\n  case (step H a)\n  show ?case by (rule inference_closure_step[where H=H and R=R])\n    (rule step.hyps(1), rule step.hyps(2), rule step.hyps(3), use step.IH in blast)\nqed\n\ntheorem finite_inference_complete:\n  \"a\\<in>inference_closure R K \\<Longrightarrow> finite_inference R K a\"\nproof -\n  have \"inference_closure R K\\<subseteq>{a. finite_inference R K a}\"\n    by (rule inference_closure_least)\n      (auto simp: inference_consequences_def intro: finite_inference.intros)\n  then show \"a\\<in>inference_closure R K \\<Longrightarrow> finite_inference R K a\" by blast\nqed\n\ntheorem finite_inference_exact:\n  \"finite_inference R K a \\<longleftrightarrow> a\\<in>inference_closure R K\"\n  by (rule iffI, erule finite_inference_sound, erule finite_inference_complete)\n\ndefinition inference_sound ::\n  \"('a \\<Rightarrow> bool) \\<Rightarrow> ('a \\<Rightarrow> ('i \\<times> 'a) set \\<Rightarrow> bool) \\<Rightarrow> bool\" where\n  \"inference_sound T R \\<longleftrightarrow>\n    (\\<forall>a H. finite H \\<longrightarrow> single_valued H \\<longrightarrow> R a H \\<longrightarrow>\n      rel_ran H\\<subseteq>{b. T b} \\<longrightarrow> T a)\"\n\ntheorem inference_closure_sound:\n  assumes \"inference_sound T R\" \"K\\<subseteq>{a. T a}\"\n  shows \"inference_closure R K\\<subseteq>{a. T a}\"\n  by (rule inference_closure_least[OF assms(2)])\n    (use assms(1) in \\<open>auto simp: inference_sound_def inference_consequences_def\\<close>)\n\ntheorem inference_supplies_reduction:\n  assumes \"inference_sound T R\"\n    \"\\<And>a. a\\<in>D \\<Longrightarrow> a\\<in>inference_closure R (rel_ran (F a))\"\n  shows \"obligation_reduction D T T F\"\n  using assms inference_closure_sound by (auto simp: obligation_reduction_def; blast)\n\ntheorem inference_discharges_residual:\n  assumes rules: \"inference_sound T R\" and known: \"K\\<subseteq>{a. T a}\"\n    and reduction: \"obligation_reduction D P T F\"\n  shows \"obligation_reduction D P T\n    (\\<lambda>a. remaining_obligations (inference_closure R K) (F a))\"\n  by (rule obligation_reduction_residual[OF reduction inference_closure_sound[OF rules known]])\n\ntheorem unsupported_inference_cycle:\n  assumes \"\\<And>a H. finite H \\<Longrightarrow> single_valued H \\<Longrightarrow> R a H \\<Longrightarrow> H\\<noteq>{}\"\n  shows \"inference_closure R {}={}\"\nproof -\n  have \"inference_consequences R {}\\<subseteq>{}\"\n    by (auto simp: inference_consequences_def rel_ran_def dest: assms)\n  then show ?thesis using inference_closure_least[of \"{}\" \"{}\" R] by blast\nqed\n\nsection \\<open>A method comparison reduces to its immediate rules\\<close>\n\ndefinition inference_refines ::\n  \"('a \\<Rightarrow> ('i \\<times> 'a) set \\<Rightarrow> bool) \\<Rightarrow>\n    ('a \\<Rightarrow> ('j \\<times> 'a) set \\<Rightarrow> bool) \\<Rightarrow> bool\" where\n  \"inference_refines R S \\<longleftrightarrow> (\\<forall>K. inference_closure R K\\<subseteq>inference_closure S K)\"\n\nlemma inference_refines_refl:\n  \"inference_refines R R\"\n  by (simp add: inference_refines_def)\n\nlemma inference_refines_trans:\n  \"inference_refines R S \\<Longrightarrow> inference_refines S T \\<Longrightarrow> inference_refines R T\"\n  by (auto simp: inference_refines_def)\n\ntheorem inference_refines_iff_rules:\n  \"inference_refines R S \\<longleftrightarrow>\n    (\\<forall>a H. finite H \\<longrightarrow> single_valued H \\<longrightarrow> R a H \\<longrightarrow>\n      a\\<in>inference_closure S (rel_ran H))\"\nproof\n  assume refinement: \"inference_refines R S\"\n  show \"\\<forall>a H. finite H \\<longrightarrow> single_valued H \\<longrightarrow> R a H \\<longrightarrow>\n      a\\<in>inference_closure S (rel_ran H)\"\n  proof (intro allI impI)\n    fix a H\n    assume fin: \"finite H\" and formed: \"single_valued H\" and rule: \"R a H\"\n    have source: \"a\\<in>inference_closure R (rel_ran H)\"\n      by (rule inference_closure_step[where H=H and R=R])\n        (rule fin, rule formed, rule rule, rule inference_closure_seed)\n    have included: \"inference_closure R (rel_ran H)\\<subseteq>inference_closure S (rel_ran H)\"\n      using refinement by (auto simp: inference_refines_def)\n    show \"a\\<in>inference_closure S (rel_ran H)\" by (rule subsetD[OF included source])\n  qed\nnext\n  assume local: \"\\<forall>a H. finite H \\<longrightarrow> single_valued H \\<longrightarrow> R a H \\<longrightarrow>\n    a\\<in>inference_closure S (rel_ran H)\"\n  have closed: \"inference_consequences R (inference_closure S K)\\<subseteq>inference_closure S K\" for K\n  proof\n    fix a assume \"a\\<in>inference_consequences R (inference_closure S K)\"\n    then obtain H where fin: \"finite H\" and formed: \"single_valued H\"\n      and rule: \"R a H\" and support: \"rel_ran H\\<subseteq>inference_closure S K\"\n      by (auto simp: inference_consequences_def)\n    have reduced: \"a\\<in>inference_closure S (rel_ran H)\"\n      using local fin formed rule by blast\n    show \"a\\<in>inference_closure S K\" by (rule inference_closure_cut[OF reduced support])\n  qed\n  show \"inference_refines R S\"\n    using inference_closure_least[OF inference_closure_seed closed]\n    by (simp add: inference_refines_def)\nqed\n\ntheorem inference_refines_by_inclusion:\n  assumes \"\\<And>a H. R a H \\<Longrightarrow> S a H\"\n  shows \"inference_refines R S\"\n  unfolding inference_refines_iff_rules\nproof (intro allI impI)\n  fix a H\n  assume fin: \"finite H\" and formed: \"single_valued H\" and source: \"R a H\"\n  have target: \"S a H\" by (rule assms[OF source])\n  show \"a\\<in>inference_closure S (rel_ran H)\"\n    by (rule inference_closure_step[where H=H and R=S])\n      (rule fin, rule formed, rule target, rule inference_closure_seed)\nqed\n\ntheorem inference_refines_residuals:\n  assumes \"inference_refines R S\"\n  shows \"remaining_obligations (inference_closure S K) H\\<subseteq>\n    remaining_obligations (inference_closure R K) H\"\n  by (rule remaining_obligations_antimono) (use assms in \\<open>auto simp: inference_refines_def\\<close>)\n\ntheorem inference_refines_strict_witness:\n  assumes \"inference_refines R S\"\n  shows \"\\<not>inference_refines S R \\<longleftrightarrow>\n    (\\<exists>K a. a\\<in>inference_closure S K \\<and> a\\<notin>inference_closure R K)\"\n  by (auto simp: inference_refines_def)\n\ntheorem inference_extension_conservative_iff:\n  \"inference_refines (\\<lambda>a H. R a H \\<or> S a H) R \\<longleftrightarrow> inference_refines S R\"\n  by (auto simp: inference_refines_iff_rules\n    intro: inference_closure_step[OF _ _ _ inference_closure_seed])\n\ntext \\<open>\n  The least closure accounts for finite derivations from supplied assumptions.\n  Finite functional premise families retain distinct uses of equal claims.\n  A rule's validity is proved against an independently fixed truth predicate;\n  merely adding a rule or reaching a fixed point does not establish soundness.\n  An unsupported cycle cannot supply its own premise.\n\n  Refinement means inclusion of conditional capabilities for every assumption\n  set, not just success on one example. Its exact recognition criterion checks\n  each immediate source rule using the target method. Transitivity, residual\n  discharge, and conservative extension then follow without reopening client\n  proofs. Remaining occurrences are derived from the original obligation family.\n\\<close>\n\nend\n",
