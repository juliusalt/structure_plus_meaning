          "source": "theory Factor_Target_Admission\n  imports Factor_Record_Admission Factor_Target_Values\nbegin\n\nsection \\<open>Whole artifacts and actual occurrence addresses\\<close>\n\ndefinition target_whole_schema :: \"(nat,nat,nat) factor_schema\" where\n  \"target_whole_schema=data_rule (Pattern_Pair data_x (Pattern_Payload [])) {(0,11,data_x)}\"\n\ndefinition target_occurrence_schema :: \"(nat,nat,nat) factor_schema\" where\n  \"target_occurrence_schema=data_rule\n    (Pattern_Pair (Pattern_Pair data_x data_y) (Pattern_Pair data_z (Pattern_Payload [])))\n    {(0,11,Pattern_Pair data_x data_y),(1,5,Pattern_Pair data_z (Pattern_Pair data_x data_w))}\"\n\ndefinition target_admission_clauses :: \"(nat \\<times> (nat,nat,nat) factor_schema) set\" where\n  \"target_admission_clauses={(0,target_whole_schema),(1,target_occurrence_schema)}\"\n\ndefinition target_admission_system :: \"(nat,nat,nat,nat) schema_system\" where\n  \"target_admission_system=add_view_definition record_admission_system 35 data_x target_admission_clauses\"\n\nlemma target_admission_system_formed [simp]: \"schema_system_formed target_admission_system\"\n  unfolding target_admission_system_def\n  by (rule add_recursive_definition_formed[OF record_admission_system_formed])\n    (auto simp: target_admission_clauses_def target_whole_schema_def target_occurrence_schema_def\n      schema_formed_def schema_dependencies_def single_valued_def rel_dom_def rel_ran_def octets_formed_def)\n\nlemma target_admission_definitions [simp]:\n  \"system_definitions target_admission_system=insert 35 (system_definitions record_admission_system)\"\n  by (simp add: target_admission_system_def)\n\nlemma target_admission_call:\n  \"schema_call_formed target_admission_system d t \\<longleftrightarrow>\n    d\\<in>system_definitions target_admission_system \\<and> term_formed t\"\n  using added_variable_calls[OF record_admission_system_formed\n    target_admission_system_formed[unfolded target_admission_system_def] record_admission_call]\n  by (simp only: target_admission_system_def[symmetric])\n\nlemma target_admission_old_meaning:\n  assumes \"d\\<in>system_definitions record_admission_system\"\n  shows \"(d,t)\\<in>positive_meaning target_admission_system \\<longleftrightarrow>\n    (d,t)\\<in>positive_meaning record_admission_system\"\n  using added_definition_preserves_old(2)[OF record_admission_system_formed\n    target_admission_system_formed[unfolded target_admission_system_def], of d t] assms\n  by (auto simp: target_admission_system_def)\n\nlemma target_admission_clause [simp]:\n  \"((35,c),S)\\<in>system_clauses target_admission_system \\<longleftrightarrow> (c,S)\\<in>target_admission_clauses\"\nproof -\n  have owned: \"((d,c),S)\\<in>system_clauses record_admission_system \\<Longrightarrow>\n    d\\<in>system_definitions record_admission_system\" for d c S\n    using record_admission_system_formed unfolding schema_system_formed_def by blast\n  have absent: \"((35,c),S)\\<notin>system_clauses record_admission_system\" by (auto dest: owned)\n  show ?thesis using absent by (simp add: target_admission_system_def)\nqed\n\nlemma target_admission_headed_meaning:\n  assumes \"d\\<in>system_definitions headed_material_system\"\n  shows \"(d,t)\\<in>positive_meaning target_admission_system \\<longleftrightarrow>\n    (d,t)\\<in>positive_meaning headed_material_system\"\n  using target_admission_old_meaning[of d t] record_admission_old_meaning[of d t]\n    socket_chain_old_meaning[of d t] family_admission_headed_meaning[OF assms, of t] assms by auto\n\nlemma target_admission_components:\n  \"(11,t)\\<in>positive_meaning target_admission_system \\<longleftrightarrow> (\\<exists>R. artifact_value_presents R t)\"\n  \"(5,t)\\<in>positive_meaning target_admission_system \\<longleftrightarrow> (5,t)\\<in>positive_meaning bag_comparison_system\"\n  using target_admission_headed_meaning[of 11 t] target_admission_headed_meaning[of 5 t]\n    headed_material_components(1,2)[of t] by auto\n\nlemma target_admission_valuation:\n  \"(35,t)\\<in>positive_meaning target_admission_system \\<longleftrightarrow>\n    (\\<exists>h::nat\\<Rightarrow>factor_term. term_formed (h 0) \\<and>\n      t=Pair_Term (h 0) (Payload_Term []) \\<and> (\\<exists>R. artifact_value_presents R (h 0))) \\<or>\n    (\\<exists>h::nat\\<Rightarrow>factor_term. (\\<forall>i\\<in>{0,1,2,3}. term_formed (h i)) \\<and>\n      t=Pair_Term (Pair_Term (h 0) (h 1)) (Pair_Term (h 2) (Payload_Term [])) \\<and>\n      (\\<exists>R. artifact_value_presents R (Pair_Term (h 0) (h 1))) \\<and>\n      (5,Pair_Term (h 2) (Pair_Term (h 0) (h 3)))\\<in>positive_meaning bag_comparison_system)\"\nproof -\n  have ordinary: \"\\<And>c S. ((35,c),S)\\<in>system_clauses target_admission_system \\<Longrightarrow>\n    schema_material_premises S={}\"\n    by (auto simp: target_admission_clauses_def target_whole_schema_def target_occurrence_schema_def)\n  have member: \"35\\<in>system_definitions target_admission_system\" by simp\n  let ?A=\"\\<lambda>(S::(nat,nat,nat) factor_schema) (h::nat\\<Rightarrow>factor_term).\n    (\\<forall>i\\<in>schema_variables S. term_formed (h i)) \\<and>\n    t=evaluate_pattern h (schema_conclusion S) \\<and> term_formed t \\<and>\n    (\\<forall>s d p. (s,d,p)\\<in>schema_premises S \\<longrightarrow>\n      (d,evaluate_pattern h p)\\<in>positive_meaning target_admission_system)\"\n  have valuation: \"(35,t)\\<in>positive_meaning target_admission_system \\<longleftrightarrow>\n    (\\<exists>c S. (c,S)\\<in>target_admission_clauses \\<and> (\\<exists>h. ?A S h))\"\n    using ordinary_positive_entry_valuation[where P=target_admission_system and d=35 and t=t, OF ordinary]\n    by (simp only: target_admission_clause target_admission_call member simp_thms ex_simps)\n  have clauses: \"(\\<exists>c S. (c,S)\\<in>target_admission_clauses \\<and> P S) \\<longleftrightarrow>\n    P target_whole_schema \\<or> P target_occurrence_schema\" for P\n    by (auto simp: target_admission_clauses_def)\n  have whole: \"?A target_whole_schema h \\<longleftrightarrow>\n    term_formed (h 0) \\<and> t=Pair_Term (h 0) (Payload_Term []) \\<and>\n      (\\<exists>R. artifact_value_presents R (h 0))\" for h\n    by (auto simp: target_whole_schema_def schema_variables_def target_admission_components octets_formed_def)\n  have occurrence: \"?A target_occurrence_schema h \\<longleftrightarrow>\n    (\\<forall>i\\<in>{0,1,2,3}. term_formed (h i)) \\<and>\n    t=Pair_Term (Pair_Term (h 0) (h 1)) (Pair_Term (h 2) (Payload_Term [])) \\<and>\n    (\\<exists>R. artifact_value_presents R (Pair_Term (h 0) (h 1))) \\<and>\n    (5,Pair_Term (h 2) (Pair_Term (h 0) (h 3)))\\<in>positive_meaning bag_comparison_system\" for h\n    by (auto simp: target_occurrence_schema_def schema_variables_def target_admission_components octets_formed_def)\n  show ?thesis by (subst valuation) (simp only: clauses whole occurrence)\nqed\n\nlemma target_admission_fields:\n  \"(35,t)\\<in>positive_meaning target_admission_system \\<longleftrightarrow>\n    (\\<exists>R a. t=Pair_Term a (Payload_Term []) \\<and> artifact_value_presents R a) \\<or>\n    (\\<exists>R a b k. t=Pair_Term (Pair_Term a b) (Pair_Term k (Payload_Term [])) \\<and>\n      artifact_value_presents R (Pair_Term a b) \\<and> selected_data_member k a)\"\nproof\n  assume \"(35,t)\\<in>positive_meaning target_admission_system\"\n  then show \"(\\<exists>R a. t=Pair_Term a (Payload_Term []) \\<and> artifact_value_presents R a) \\<or>\n    (\\<exists>R a b k. t=Pair_Term (Pair_Term a b) (Pair_Term k (Payload_Term [])) \\<and>\n      artifact_value_presents R (Pair_Term a b) \\<and> selected_data_member k a)\"\n    by (auto simp: target_admission_valuation)\nnext\n  assume \"(\\<exists>R a. t=Pair_Term a (Payload_Term []) \\<and> artifact_value_presents R a) \\<or>\n    (\\<exists>R a b k. t=Pair_Term (Pair_Term a b) (Pair_Term k (Payload_Term [])) \\<and>\n      artifact_value_presents R (Pair_Term a b) \\<and> selected_data_membe