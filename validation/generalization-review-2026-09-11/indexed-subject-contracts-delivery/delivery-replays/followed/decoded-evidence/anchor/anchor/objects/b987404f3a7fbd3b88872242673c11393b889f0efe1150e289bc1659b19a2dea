          "source": "theory Finite_Observation_Contracts\n  imports Finite_Derived_Observations\nbegin\n\nsection \\<open>The runtime exports its checked observation equation\\<close>\n\nML \\<open>\nstructure Finite_Observation_Contracts =\nstruct\n  type contract =\n    {definition: thm, equation: thm, formation: thm,\n     observation: thm, comparison: thm};\n\n  structure Data = Theory_Data\n  (\n    type T = contract Symtab.table;\n    val empty = Symtab.empty;\n    val merge = Symtab.merge (fn (a, b) => eq_list Thm.eq_thm_prop\n      ([#definition a, #equation a, #formation a, #observation a, #comparison a],\n       [#definition b, #equation b, #formation b, #observation b, #comparison b]));\n  );\n\n  fun equation_sides th =\n    let val prop = Thm.prop_of th\n    in case try Logic.dest_equals prop of\n      SOME pair => pair\n    | NONE => HOLogic.dest_eq (HOLogic.dest_Trueprop prop)\n    end;\n\n  fun constant_name term = fst (dest_Const (Term.head_of term));\n\n  fun compared_source th =\n    let\n      val (left, _) = HOLogic.dest_eq (HOLogic.dest_Trueprop\n        (Logic.strip_assums_concl (Thm.prop_of th)));\n      val (_, container) = HOLogic.dest_mem left;\n    in case Term.strip_comb container of\n      (Const (name, _), [source]) =>\n        if name = @{const_name set} then source\n        else error \"The source theorem must concern the complete result list\"\n    | _ => error \"The source theorem has no complete result list\"\n    end;\n\n  fun components ({definition, equation, formation, observation, comparison}: contract) =\n    let\n      val (function, calculation) = equation_sides definition;\n      val (basis, args) = Term.strip_comb calculation;\n      val _ = if constant_name basis = @{const_name investigation_basis} andalso length args = 5\n        then () else error \"The investigation definition must apply the existing finite basis operation\";\n      val (encoded, derived) = equation_sides equation;\n      val observer = (case Term.strip_comb encoded of\n          (Const (name, _), [term]) =>\n            if name = @{const_name fset_of_list} then term\n            else error \"The source equation must present the complete observation list\"\n        | _ => error \"The source equation has no complete observation list\");\n      val (derive, subjects) = Term.strip_comb derived;\n      val _ = if constant_name derive = @{const_name finite_derived_observations} andalso length subjects = 4\n        then () else error \"The source equation must use the derived-observation operation\";\n      val _ = if constant_name observer = constant_name (nth args 3)\n        then () else error \"The checked equation belongs to a different observation function\";\n      val _ = if constant_name (compared_source observation) = constant_name observer\n          andalso constant_name (compared_source comparison) = constant_name (nth args 4)\n        then () else error \"The source theorems must concern these same observation and comparison functions\";\n      val _ = if observer aconv (nth args 3)\n        then () else error \"The checked equation uses different observation arguments\";\n      val _ = if compared_source observation aconv observer\n          andalso compared_source comparison aconv (nth args 4)\n        then () else error \"The source theorems use different observation or comparison arguments\";\n      val (formed, maps) = Term.strip_comb (HOLogic.dest_Trueprop (Thm.prop_of formation));\n      val _ = if constant_name formed = @{const_name finite_observation_subjects_formed}\n          andalso eq_list (op aconv) (maps, take 3 subjects)\n        then () else error \"The functionality theorem must concern these same subject maps\";\n      val _ = if forall (null o Thm.hyps_of) [definition, equation, formation]\n        then () else error \"A source contract may not discharge unstated hypotheses\";\n    in (function, observer, nth args 4, subjects, take 2 args) end;\n\n  fun register contract thy =\n    let val (function, _, _, _, _) = components contract\n    in Data.map (Symtab.update_new (constant_name function, contract)) thy end;\n\n  fun term_element name term = XML.Elem ((name, []), Term_XML.Encode.term_raw term);\n  fun theorem_element name th = term_element name (Thm.prop_of th);\n\n  fun definitions thy seeds =\n    let\n      val by_constant = Symtab.make_list (Defs.dest_constdefs [] (Theory.defs_of thy));\n      val axioms = Symtab.make (Theory.all_axioms_of thy);\n      fun expand [] seen selected = (seen, selected)\n        | expand (name :: pending) seen selected =\n            if Symtab.defined seen name then expand pending seen selected\n            else\n              let\n                val names = these (Symtab.lookup by_constant name);\n                fun fetch def =\n                  (case Symtab.lookup axioms def of SOME prop => (def, prop)\n                  | NONE => error (\"Missing kernel definition \" ^ quote def));\n                val equations = map fetch names;\n                val more = maps (fn (_, prop) => Term.add_const_names prop []) equations;\n              in expand (more @ pending) (Symtab.update (name, ()) seen)\n                (fold Symtab.update equations selected) end;\n      val (seen, selected) = expand (maps (fn t => Term.add_const_names t []) seeds)\n        Symtab.empty Symtab.empty;\n      val primitives = filter (fn name => not (Symtab.defined by_constant name)) (Symtab.keys seen);\n    in\n      XML.Elem ((\"definitions\", []), map (fn (name, prop) =>\n        XML.Elem ((\"definition\", [(\"name\", name)]), Term_XML.Encode.term_raw prop)) (Symtab.dest selected)) ::\n      [XML.Elem ((\"context_constants\", []), map (fn name =>\n        term_element \"constant\" (Const (name, Sign.the_const_type thy name))) primitives)]\n    end;\n\n  fun export function thy =\n    let\n      val name = constant_name function;\n      val contract = (case Symtab.lookup (Data.get thy) name of SOME value => value\n        | NONE => error (\"No checked observation contract for \" ^ quote name));\n      val (actual_function, observer, relation, subjects, domains) = components contract;\n      val {definition, equation, formation, observation, comparison} = contract;\n      val propositions = map Thm.prop_of [definition, equation, formation, observation, comparison];\n      fun indices term = XML.Encode.list XML.Encode.int (map (snd o HOLogic.dest_number) (HOLogic.dest_list term));\n      val body = [XML.Elem ((\"candidate_indices\", []), indices (nth domains 0)),\n        XML.Elem ((\"facet_indices\", []), indices (nth domains 1)),\n        term_element \"function\" actual_function, term_element \"observer\" observer,\n        term_element \"relation\" relation,\n        XML.Elem ((\"subjects\", []), map (term_element \"term\") subjects),\n        theorem_element \"calculation\" definition, theorem_element \"observation_equation\" equation,\n        theorem_element \"functional_maps\" formation, theorem_element \"at_subject\" observation,\n        theorem_element \"comparison_at_subject\" comparison] @ definitions thy propositions;\n      val xml = XML.Elem ((\"finite_observation_contract\", [(\"function\", name)]), body);\n      val _ = Export.export thy (Path.binding0 (Path.explode (\"subjects/\" ^ Long_Name.base_name name ^ \".yxml\")))\n        [xml];\n    in thy end;\nend\n\\<close>\n\ntext \\<open>\n  Each owner registers checked theorems about its actual calculation and\n  subject maps. The exporter checks the observation constant in that\n  calculation against the source equation and checks the same map arguments\n  in the functionality theorem. It retains full typed terms and the reachable\n  kernel definitions. Constants with no definitional equation are recorded\n  explicitly as dependencies on the accepted Isabelle context.\n\n  The export presents existing theorems. It does not interpret registry prose,\n  prove an arbitrary host operation, or replace the checked theory context.\n\\<close>\n\nend\n",
