          "source": "theory Inference_Rounds\n  imports Inference_Development\nbegin\n\nsection \\<open>Finite dependency rounds expose work hidden by an immediate interface\\<close>\n\nfun inference_rounds ::\n  \"('a \\<Rightarrow> ('i\\<times>'a) set \\<Rightarrow> bool) \\<Rightarrow> 'a set \\<Rightarrow> nat \\<Rightarrow> 'a set\" where\n  \"inference_rounds R K 0=K\"\n| \"inference_rounds R K (Suc n)=K\\<union>inference_consequences R (inference_rounds R K n)\"\n\nlemma inference_rounds_seed:\n  \"K\\<subseteq>inference_rounds R K n\"\n  by (cases n) auto\n\nlemma inference_rounds_step:\n  assumes \"finite H\" \"single_valued H\" \"R a H\" \"rel_ran H\\<subseteq>inference_rounds R K n\"\n  shows \"a\\<in>inference_rounds R K (Suc n)\"\n  using assms by (auto simp: inference_consequences_def)\n\nlemma inference_rounds_ascending:\n  \"inference_rounds R K n\\<subseteq>inference_rounds R K (Suc n)\"\n  by (induction n) (auto simp: inference_consequences_def; blast)+\n\nlemma inference_rounds_mono:\n  assumes \"n\\<le>m\"\n  shows \"inference_rounds R K n\\<subseteq>inference_rounds R K m\"\nproof -\n  have grow: \"inference_rounds R K n\\<subseteq>inference_rounds R K (n+j)\" for j\n    by (induction j) (use inference_rounds_ascending[of R K] in auto)\n  have \"inference_rounds R K n\\<subseteq>inference_rounds R K (n+(m-n))\" by (rule grow)\n  then show ?thesis using assms by simp\nqed\n\nlemma inference_rounds_seed_mono:\n  \"K\\<subseteq>L \\<Longrightarrow> inference_rounds R K n\\<subseteq>inference_rounds R L n\"\n  by (induction n) (auto simp: inference_consequences_def; blast)+\n\nlemma inference_rounds_rule_mono:\n  assumes \"\\<And>a H. R a H \\<Longrightarrow> S a H\"\n  shows \"inference_rounds R K n\\<subseteq>inference_rounds S K n\"\n  by (induction n) (use assms in \\<open>auto simp: inference_consequences_def; blast\\<close>)+\n\nlemma inference_rounds_inside_closure:\n  \"inference_rounds R K n\\<subseteq>inference_closure R K\"\nproof (induction n)\n  case 0\n  show ?case by (simp only: inference_rounds.simps; rule inference_closure_seed)\nnext\n  case (Suc n)\n  have monotone: \"inference_consequences R (inference_rounds R K n)\\<subseteq>\n      inference_consequences R (inference_closure R K)\"\n    by (rule monoD[OF inference_consequences_mono Suc.IH])\n  have step: \"inference_consequences R (inference_rounds R K n)\\<subseteq>inference_closure R K\"\n    by (rule subset_trans[OF monotone inference_closure_closed])\n  show ?case by (simp only: inference_rounds.simps; rule Un_least[OF inference_closure_seed step])\nqed\n\nlemma inference_rounds_finite_bound:\n  assumes \"finite X\" \"X\\<subseteq>(\\<Union>n. inference_rounds R K n)\"\n  shows \"\\<exists>n. X\\<subseteq>inference_rounds R K n\"\n  using assms\nproof (induction X rule: finite_induct)\n  case empty\n  show ?case by auto\nnext\n  case (insert a X)\n  obtain i where head: \"a\\<in>inference_rounds R K i\" using insert.prems by blast\n  obtain j where tail: \"X\\<subseteq>inference_rounds R K j\"\n    using insert.IH insert.prems by blast\n  have left: \"i\\<le>max i j\" and right: \"j\\<le>max i j\" by (auto simp: max_def)\n  have first: \"a\\<in>inference_rounds R K (max i j)\"\n    by (rule subsetD[OF inference_rounds_mono[OF left] head])\n  have second: \"X\\<subseteq>inference_rounds R K (max i j)\"\n    by (rule subset_trans[OF tail inference_rounds_mono[OF right]])\n  show ?case by (rule exI[of _ \"max i j\"]) (use first second in blast)\nqed\n\ntheorem inference_closure_rounds:\n  \"inference_closure R K=(\\<Union>n. inference_rounds R K n)\"\nproof (rule equalityI)\n  let ?X=\"\\<Union>n. inference_rounds R K n\"\n  have seed: \"K\\<subseteq>?X\"\n  proof\n    fix a assume \"a\\<in>K\"\n    then have \"a\\<in>inference_rounds R K 0\" by simp\n    then show \"a\\<in>?X\" by blast\n  qed\n  have closed: \"inference_consequences R ?X\\<subseteq>?X\"\n  proof\n    fix a assume \"a\\<in>inference_consequences R ?X\"\n    then obtain H where formed: \"finite H\" \"single_valued H\" and rule: \"R a H\"\n      and support: \"rel_ran H\\<subseteq>?X\" by (auto simp: inference_consequences_def)\n    have finite: \"finite (rel_ran H)\" using formed(1) by (simp add: rel_ran_image)\n    obtain n where bound: \"rel_ran H\\<subseteq>inference_rounds R K n\"\n      using inference_rounds_finite_bound[OF finite support] by blast\n    have \"a\\<in>inference_rounds R K (Suc n)\" by (rule inference_rounds_step[OF formed rule bound])\n    then show \"a\\<in>?X\" by blast\n  qed\n  show \"inference_closure R K\\<subseteq>?X\" by (rule inference_closure_least[OF seed closed])\nnext\n  show \"(\\<Union>n. inference_rounds R K n)\\<subseteq>inference_closure R K\"\n    by (rule UN_least) (rule inference_rounds_inside_closure)\nqed\n\ntheorem inference_rounds_cut:\n  assumes \"X\\<subseteq>inference_rounds R K m\"\n  shows \"inference_rounds R X n\\<subseteq>inference_rounds R K (m+n)\"\nproof (induction n)\n  case 0\n  show ?case using assms by simp\nnext\n  case (Suc n)\n  have seeds: \"X\\<subseteq>inference_rounds R K (m+Suc n)\"\n    by (rule subset_trans[OF assms inference_rounds_mono]) simp\n  have step: \"inference_consequences R (inference_rounds R X n)\\<subseteq>\n      inference_consequences R (inference_rounds R K (m+n))\"\n    by (rule monoD[OF inference_consequences_mono Suc.IH])\n  show ?case using seeds step by auto\nqed\n\nsection \\<open>Every local simulation retains its dependency budget\\<close>\n\ndefinition inference_round_refines where\n  \"inference_round_refines R S \\<longleftrightarrow>\n    (\\<forall>K n. inference_rounds R K n\\<subseteq>inference_rounds S K n)\"\n\ntheorem inference_round_refines_iff_rules:\n  \"inference_round_refines R S \\<longleftrightarrow>\n    (\\<forall>a H. finite H \\<longrightarrow> single_valued H \\<longrightarrow> R a H \\<longrightarrow>\n      a\\<in>inference_rounds S (rel_ran H) 1)\"\nproof\n  assume comparison: \"inference_round_refines R S\"\n  show \"\\<forall>a H. finite H \\<longrightarrow> single_valued H \\<longrightarrow> R a H \\<longrightarrow>\n      a\\<in>inference_rounds S (rel_ran H) 1\"\n  proof (intro allI impI)\n    fix a H assume formed: \"finite H\" \"single_valued H\" and rule: \"R a H\"\n    have first: \"a\\<in>inference_rounds R (rel_ran H) 1\"\n      using inference_rounds_step[where R=R and H=H and a=a and K=\"rel_ran H\" and n=0, OF formed rule]\n      by simp\n    have included: \"inference_rounds R (rel_ran H) 1\\<subseteq>inference_rounds S (rel_ran H) 1\"\n      using comparison by (simp only: inference_round_refines_def; blast)\n    show \"a\\<in>inference_rounds S (rel_ran H) 1\"\n      by (rule subsetD[OF included first])\n  qed\nnext\n  assume local: \"\\<forall>a H. finite H \\<longrightarrow> single_valued H \\<longrightarrow> R a H \\<longrightarrow>\n    a\\<in>inference_rounds S (rel_ran H) 1\"\n  have comparison: \"inference_rounds R K n\\<subseteq>inference_rounds S K n\" for K n\n  proof (induction n)\n    case 0\n    show ?case by simp\n  next\n    case (Suc n)\n    show ?case\n    proof\n      fix a assume member: \"a\\<in>inference_rounds R K (Suc n)\"\n      show \"a\\<in>inference_rounds S K (Suc n)\"\n      proof (cases \"a\\<in>K\")\n        case True\n        show ?thesis by (rule subsetD[OF inference_rounds_seed True])\n      next\n        case False\n        obtain H where formed: \"finite H\" \"single_valued H\" and rule: \"R a H\"\n          and support: \"rel_ran H\\<subseteq>inference_rounds R K n\"\n          using member False by (auto simp: inference_consequences_def)\n        have seed: \"rel_ran H\\<subseteq>inference_rounds S K n\"\n          by (rule subset_trans[OF support Suc.IH])\n        have result: \"a\\<in>inference_rounds S (rel_ran H) 1\"\n          using local formed rule by blast\n        have \"a\\<in>inference_rounds S K (n+1)\"\n          by (rule subsetD[OF inference_rounds_cut[OF seed] result])\n        then show ?thesis by simp\n      qed\n    qed\n  qed\n  show \"inference_round_refines R S\" using comparison by (simp add: inference_round_refines_def)\nqed\n\ntheorem inference_round_refines_closure:\n  \"inference_round_refines R S \\<Longrightarrow> inference_refines R S\"\n  by (auto simp: inference_round_refines_def inference_refines_def inference_closure_rounds; blast)\n\ntheorem bounded_inferences_rounds_complete:\n  assumes \"\\<And>a H. finite H \\<Longrightarrow> single_valued H \\<Longrightarrow> R a H \\<Longrightarrow> card H\\<le>k\"\n  shows \"inference_rounds (bounded_inferences k R) K n=inference_rounds R K n\"\n  by (induction n) (use assms in \\<open>auto simp: inference_consequences_def bounded_inferences_def; blast\\<close>)+\n\ndefinition inference_round_capability where\n  \"inference_round_capability k R={(n,K,a). a\\<in>inference_rounds (bounded_inferences k R) K n}\"\n\ntheorem inference_round_capability_comparison:\n  \"inference_round_capability k R\\<subseteq>inference_round_capability l S \\<longleftrightarrow>\n    inference_round_refines (bounded_inferences k R) (bounded_inferences l S)\"\n  by (auto simp: inference_round_capability_def inference_round_refines_def)\n\ntheorem conditional_capability_is_the_round_projection:\n  \"inference_capability k R=snd ` inference_round_capability k R\"\n  by (auto simp: inference_capability_def inference_round_capability_def inference_closure_rounds image_iff)\n\ntheorem round_capability_preserves_conditional_capability:\n  assumes \"inference_round_capability k R\\<subseteq>inference_round_capability l S\"\n  shows \"inference_capability k R\\<subseteq>inference_capability l S\"\n  using assms by (auto simp: conditional_capability_is_the_round_projection)\n\ndefinition inference_depth_observations where\n  \"inference_depth_observations k f R=\n    (if f then Inr ` inference_round_capability k R else Inl ` inference_capability k R)\"\n\nlemma inference_depth_observation_comparison:\n  \"(\\<forall>f\\<in>{True}. inference_depth_observations k f R\\<subseteq>inference_depth_observations k f S)\n    \\<longleftrightarrow> inference_round_refines (bounded_inferences k R) (bounded_inferences k S)\"\n  by (auto simp: inference_depth_observations_def inference_round_capability_comparison[symmetric] image_iff)\n\nlemma rounds_already_retain_conditional_capability:\n  \"(\\<forall>f\\<in>{False,True}. inference_depth_observations k f R\\<subseteq>inference_depth_observations k f S)\n    \\<longleftrightarrow> inference_round_refines (bounded_inferences k R) (bounded_inferences k S)\"\n  using round_capability_preserves_conditional_capability[where k=k and l=k and R=R and S=S]\n  by (auto simp: inference_depth_observations_def inference_round_capability_comparison[symmetric] image_iff)\n\ntext \\<open>\n  A round exposes one layer of actual inference dependencies. Its complete\n  finite premise family must be available from the previous round. The union\n  of all rounds is exactly the original finite-derivation closure, so this\n  observation preserves the earlier unbounded account while retaining more\n  information. Conditional simulation at every round has an exact local rule\n  criterion and therefore enters the same method-evaluation machinery.\n\n  A round is not elapsed time, total proof size, or the cost of establishing a\n  proposed derived rule. These questions remain separate observations. The\n  new criterion is used to demonstrate a relevant distinction omitted by the\n  earlier premise-bound comparison, not to appoint another universal scalar\n  measure of depth.\n\\<close>\n\nend\n",
