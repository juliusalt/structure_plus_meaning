          "theory": "Factor_Observation_Scope_Presentations",
          "source": "theory Factor_Observation_Scope_Presentations\n  imports Factor_Observation_Scope_Rows\nbegin\n\nsection \\<open>Declared scopes and their table have one complete product boundary\\<close>\n\nabbreviation observation_scopes_presents where\n  \"observation_scopes_presents \\<equiv> factor_pair_presents observation_facets_presents\n    (factor_pair_presents observation_facets_presents observation_facets_presents)\"\n\nabbreviation observation_scope_record_presents where\n  \"observation_scope_record_presents \\<equiv> factor_pair_presents observation_scopes_presents observation_table_presents\"\n\nabbreviation observation_scopes_domain where\n  \"observation_scopes_domain z \\<equiv> observation_facets_domain (fst z) \\<and>\n    observation_facets_domain (fst (snd z)) \\<and> observation_facets_domain (snd (snd z))\"\n\nabbreviation observation_scope_record_domain where\n  \"observation_scope_record_domain z \\<equiv>\n    observation_scopes_domain (fst z) \\<and> observation_table_domain (snd z)\"\n\nabbreviation observation_scope_domain where\n  \"observation_scope_domain z \\<equiv> observation_scope_subject_formed (fst (fst z))\n    (fst (snd (fst z))) (snd (snd (fst z))) (snd z)\"\n\nabbreviation observation_scope_presents where\n  \"observation_scope_presents z t \\<equiv> observation_scope_domain z \\<and> observation_scope_record_presents z t\"\n\nlemma observation_scopes_class:\n  \"presentation_class observation_scopes_presents observation_scopes_domain\n    (\\<lambda>p. \\<exists>z. observation_scopes_presents z p)\"\nproof -\n  have source: \"presentation_class observation_scopes_presents observation_scopes_domain\n      (\\<lambda>p. \\<exists>x y. (\\<exists>C. observation_facets_presents C x) \\<and>\n        (\\<exists>u f. (\\<exists>U. observation_facets_presents U u) \\<and>\n          (\\<exists>F. observation_facets_presents F f) \\<and> y=Pair_Term u f) \\<and> p=Pair_Term x y)\"\n    by (rule factor_pair_class[OF observation_facets_class\n      factor_pair_class[OF observation_facets_class observation_facets_class]])\n  show ?thesis by (rule presentation_class.recovered_admission[OF source])\nqed\n\nlemma observation_scope_record_class:\n  \"presentation_class observation_scope_record_presents observation_scope_record_domain\n    (\\<lambda>p. \\<exists>z. observation_scope_record_presents z p)\"\nproof -\n  have source: \"presentation_class observation_scope_record_presents observation_scope_record_domain\n      (\\<lambda>p. \\<exists>x y. (\\<exists>z. observation_scopes_presents z x) \\<and>\n        (\\<exists>T. observation_table_presents T y) \\<and> p=Pair_Term x y)\"\n    by (rule factor_pair_class[OF observation_scopes_class observation_table_class])\n  show ?thesis by (rule presentation_class.recovered_admission[OF source])\nqed\n\ninterpretation observation_scope_records: presentation_class observation_scope_record_presents\n  observation_scope_record_domain \"\\<lambda>p. \\<exists>z. observation_scope_record_presents z p\"\n  by (rule observation_scope_record_class)\n\ntheorem observation_scope_class:\n  \"presentation_class observation_scope_presents observation_scope_domain\n    (\\<lambda>p. \\<exists>z. observation_scope_presents z p)\"\n  by (rule presentation_class_subdomain[OF observation_scope_record_class])\n    (auto simp: observation_scope_subject_formed_def)\n\nlemma observation_scopes_fields:\n  assumes \"observation_scopes_presents (C,(U,F)) p\"\n  obtains cs us fs where \"data_elements cs\" \"data_elements us\" \"data_elements fs\"\n    \"fset_of_list cs=C\" \"fset_of_list us=U\" \"fset_of_list fs=F\"\n    \"p=observation_scope_context (data_list_term cs) (data_list_term us) (data_list_term fs)\"\nproof -\n  obtain cp uf where outer: \"observation_facets_presents C cp\"\n    \"factor_pair_presents observation_facets_presents observation_facets_presents (U,F) uf\"\n    \"p=Pair_Term cp uf\"\n    using assms by (simp only: factor_pair_presents_def fst_conv snd_conv) blast\n  obtain up fp where inner: \"observation_facets_presents U up\" \"observation_facets_presents F fp\"\n    \"uf=Pair_Term up fp\"\n    using outer(2) by (simp only: factor_pair_presents_def fst_conv snd_conv) blast\n  obtain cs where cs: \"data_elements cs\" \"fset_of_list cs=C\" \"cp=data_list_term cs\"\n    using outer(1) by (simp only: observation_facets_fields) blast\n  obtain us where us: \"data_elements us\" \"fset_of_list us=U\" \"up=data_list_term us\"\n    using inner(1) by (simp only: observation_facets_fields) blast\n  obtain fs where fs: \"data_elements fs\" \"fset_of_list fs=F\" \"fp=data_list_term fs\"\n    using inner(2) by (simp only: observation_facets_fields) blast\n  show ?thesis by (rule that[OF cs(1) us(1) fs(1) cs(2) us(2) fs(2)])\n    (simp only: outer(3) inner(3) cs(3) us(3) fs(3))\nqed\n\nlemma observation_scope_record_fields:\n  assumes \"observation_scope_record_presents ((C,(U,F)),T) p\"\n  obtains cs us fs rows where \"data_elements cs\" \"data_elements us\" \"data_elements fs\"\n    \"observation_rows_data rows\" \"fset_of_list cs=C\" \"fset_of_list us=U\" \"fset_of_list fs=F\"\n    \"fset_of_list rows=T\" \"p=observation_scope_argument (data_list_term cs) (data_list_term us)\n      (data_list_term fs) (data_list_term (map observation_row_term rows))\"\nproof -\n  obtain ctx table where outer: \"observation_scopes_presents (C,(U,F)) ctx\"\n    \"observation_table_presents T table\" \"p=Pair_Term ctx table\"\n    using assms by (simp only: factor_pair_presents_def fst_conv snd_conv) blast\n  obtain cs us fs where ctx_fields: \"data_elements cs\" \"data_elements us\" \"data_elements fs\"\n    \"fset_of_list cs=C\" \"fset_of_list us=U\" \"fset_of_list fs=F\"\n    \"ctx=observation_scope_context (data_list_term cs) (data_list_term us) (data_list_term fs)\"\n    by (rule observation_scopes_fields[OF outer(1)]) blast\n  obtain rows where table: \"observation_rows_data rows\" \"fset_of_list rows=T\"\n    \"table=data_list_term (map observation_row_term rows)\"\n    using outer(2) by (simp only: observation_table_fields) blast\n  show ?thesis by (rule that[OF ctx_fields(1-3) table(1) ctx_fields(4-6) table(2)])\n    (simp only: outer(3) ctx_fields(7) table(3))\nqed\n\nlemma observation_scope_record_enumeration:\n  assumes \"data_elements cs\" \"data_elements us\" \"data_elements fs\" \"observation_rows_data rows\"\n  shows \"observation_scope_record_presents\n    ((fset_of_list cs,(fset_of_list us,fset_of_list fs)),fset_of_list rows)\n    (observation_scope_argument (data_list_term cs) (data_list_term us)\n      (data_list_term fs) (data_list_term (map observation_row_term rows)))\"\nproof -\n  have cs: \"observation_facets_presents (fset_of_list cs) (data_list_term cs)\"\n    by (simp only: observation_facets_fields; rule exI[of _ cs]) (use assms(1) in simp)\n  have us: \"observation_facets_presents (fset_of_list us) (data_list_term us)\"\n    by (simp only: observation_facets_fields; rule exI[of _ us]) (use assms(2) in simp)\n  have fs: \"observation_facets_presents (fset_of_list fs) (data_list_term fs)\"\n    by (simp only: observation_facets_fields; rule exI[of _ fs]) (use assms(3) in simp)\n  have rows: \"observation_table_presents (fset_of_list rows) (data_list_term (map observation_row_term rows))\"\n    by (simp only: observation_table_fields; rule exI[of _ rows]) (use assms(4) in simp)\n  show ?thesis using cs us fs rows by (auto simp: factor_pair_presents_def)\nqed\n\ntext \\<open>\n  The context and table use the existing complete finite-set and product\n  classes. The independent scope predicate restricts that complete record.\n  It introduces no preferred enumeration: every order and every repeated\n  occurrence of a displayed member remains a presentation of the same input.\n\\<close>\n\nend\n",
