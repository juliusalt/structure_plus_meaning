          "theory": "Factor_Definition_Encoding",
          "source": "theory Factor_Definition_Encoding\n  imports Factor_Definition_Frames\nbegin\n\nsection \\<open>Total native syntax for a complete interface and clause list\\<close>\n\ntheorem definition_list_syntax_total:\n  fixes Ss :: \"('a,'s,local_address option definition_site) factor_schema list\"\n  assumes pf: \"pattern_formed p\" and formed: \"\\<forall>S\\<in>set Ss. schema_formed S\"\n    and addresses: \"\\<forall>S\\<in>set Ss. \\<forall>d\\<in>schema_dependencies S. octets_formed (snd d)\"\n  shows \"\\<exists>T f ss As L C. exact_formed T \\<and> bag_count (object_data T) = (\\<lambda>_. 0) \\<and>\n    [] \\<in> rra_carrier (object_structure T) \\<and> inj_on f (pattern_variables p) \\<and>\n    length ss = length Ss \\<and> distinct ss \\<and> length As = length Ss \\<and>\n    (\\<forall>i<length Ss. schema_alpha_variant (Ss!i) (As!i)) \\<and>\n    reference_table_formed L C \\<and> rel_dom L \\<union> rel_dom C \\<subseteq> rra_carrier (object_structure T) \\<and>\n    rel_ran C = (\\<Union>S\\<in>set Ss. schema_dependencies S) \\<and>\n    (\\<forall>E u. environment_formed E \\<longrightarrow> artifact_at E u T \\<longrightarrow> syntax_references E u L C \\<longrightarrow>\n      native_definition_at E u [] (rename_pattern f p) (set (zip ss As)))\"\nproof -\n  obtain R :: exact_artifact and r :: local_address and f and L :: \"(local_address \\<times> exact_artifact) set\" where interface:\n    \"exact_formed R\" \"inj_on f (pattern_variables p)\" \"reference_table_formed L ({} :: (local_address \\<times> local_address option definition_site) set)\"\n    \"rel_dom L \\<subseteq> rra_carrier (object_structure R)\" \"bag_count (object_data R) = (\\<lambda>_. 0)\"\n    \"r \\<in> rra_carrier (object_structure R)\"\n    \"\\<forall>E :: local_address option artifact_environment. \\<forall>u.\n      environment_formed E \\<longrightarrow> artifact_at E u R \\<longrightarrow> syntax_references E u L {} \\<longrightarrow>\n      (\\<exists>I K. scoped_pattern_at E u r (rename_pattern f p) I K \\<and> rra_carrier (object_structure R) = I \\<union> K)\"\n    using interface_syntax_total[OF pf] by metis\n  obtain S :: exact_artifact and rs :: \"local_address list\" and As :: \"local_address option native_schema list\"\n    and A :: \"(local_address \\<times> exact_artifact) set\"\n    and B :: \"(local_address \\<times> local_address option definition_site) set\" where clauses:\n    \"exact_formed S\" \"bag_count (object_data S) = (\\<lambda>_. 0)\"\n    \"length rs = length Ss\" \"length As = length Ss\" \"reference_table_formed A B\"\n    \"rel_dom A \\<union> rel_dom B \\<subseteq> rra_carrier (object_structure S)\"\n    \"rel_ran B = (\\<Union>Q\\<in>set Ss. schema_dependencies Q)\" \"set rs \\<subseteq> rra_carrier (object_structure S)\"\n    \"\\<forall>i<length Ss. schema_alpha_variant (Ss!i) (As!i)\"\n    \"\\<forall>E u. environment_formed E \\<longrightarrow> artifact_at E u S \\<longrightarrow>\n      syntax_references E u A B \\<longrightarrow> (\\<forall>i<length Ss. native_schema_at E u (rs!i) (As!i))\"\n    using schema_forest_total[OF formed addresses] by metis\n  interpret frame: definition_frame R S r rs\n    by (rule definition_frame.intro[OF interface(1) clauses(1) interface(5) clauses(2) interface(6) clauses(8)])\n  let ?T = \"definition_wrapper R r S rs\"\n  let ?f = \"Cons 2 \\<circ> f\"\n  let ?ss = \"family_ports (length rs)\"\n  let ?As = \"map (rename_schema (Cons 3) (Cons 3) id) As\"\n  let ?L = \"map_slot_keys (Cons 2) L \\<union> map_slot_keys (Cons 3) A\"\n  let ?C = \"map_slot_keys (Cons 3) B\"\n  have left_inj: \"inj (Cons 2 :: local_address \\<Rightarrow> local_address)\"\n    and right_inj: \"inj (Cons 3 :: local_address \\<Rightarrow> local_address)\" by (simp add: inj_def)+\n  have finj: \"inj_on ?f (pattern_variables p)\" using interface(2) by (auto simp: inj_on_def)\n  have left_addr: \"finite_addressing (rra_carrier (object_structure R)) (Cons 2)\"\n    using interface(1) by (auto simp: finite_addressing_def inj_on_def exact_formed_def octets_formed_def)\n  have right_addr: \"finite_addressing (rra_carrier (object_structure S)) (Cons 3)\"\n    using clauses(1) by (auto simp: finite_addressing_def inj_on_def exact_formed_def octets_formed_def)\n  have profile: \"reference_table_formed ?L ?C\"\n    using reference_table_disjoint_copies[OF interface(3) clauses(5)] by (simp add: map_slot_keys_def)\n  have lbound: \"Cons 2 ` rel_dom L \\<subseteq> Cons 2 ` rra_carrier (object_structure R)\"\n    by (rule image_mono[OF interface(4)])\n  have rbound: \"Cons 3 ` (rel_dom A \\<union> rel_dom B) \\<subseteq> Cons 3 ` rra_carrier (object_structure S)\"\n    by (rule image_mono[OF clauses(6)])\n  have bounds: \"rel_dom ?L \\<union> rel_dom ?C \\<subseteq> rra_carrier (object_structure ?T)\"\n    using lbound rbound by (auto simp: rel_dom_union map_slot_keys_domain frame.carrier)\n  have range: \"rel_ran ?C = (\\<Union>Q\\<in>set Ss. schema_dependencies Q)\"\n    by (simp only: map_slot_keys_range clauses(7))\n  have alpha: \"\\<forall>i<length Ss. schema_alpha_variant (Ss!i) (?As!i)\"\n  proof (intro allI impI)\n    fix i assume index: \"i < length Ss\"\n    have source: \"schema_alpha_variant (Ss!i) (As!i)\" using clauses(9) index by blast\n    have copied: \"schema_alpha_variant (Ss!i) (rename_schema (Cons 3) (Cons 3) id (As!i))\"\n      by (rule schema_alpha_copy[OF source right_inj])\n    show \"schema_alpha_variant (Ss!i) (?As!i)\" using copied index clauses(4) by simp\n  qed\n  have recover: \"\\<forall>E u. environment_formed E \\<longrightarrow> artifact_at E u ?T \\<longrightarrow>\n    syntax_references E u ?L ?C \\<longrightarrow>\n    native_definition_at E u [] (rename_pattern ?f p) (set (zip ?ss ?As))\"\n  proof (intro allI impI)\n    fix E u assume ef: \"environment_formed E\" and source: \"artifact_at E u ?T\"\n      and refs: \"syntax_references E u ?L ?C\"\n    have left_refs: \"syntax_references E u (map_slot_keys (Cons 2) L) {}\"\n      by (rule syntax_references_mono[OF refs]) auto\n    have right_refs: \"syntax_references E u (map_slot_keys (Cons 3) A) (map_slot_keys (Cons 3) B)\"\n      by (rule syntax_references_mono[OF refs]) auto\n    obtain I K where scoped:\n      \"scoped_pattern_at E u (2#r) (rename_pattern (Cons 2) (rename_pattern f p)) I K\"\n      \"Cons 2 ` rra_carrier (object_structure R) = I \\<union> K\"\n      using compiled_interface_copy[OF interface(1,4,7) ef source left_inj left_addr frame.interface_reads left_refs] by blast\n    have schema_reads: \"\\<forall>i<length ?As. native_schema_at E u (map (Cons 3) rs ! i) (?As!i)\"\n    proof (intro allI impI)\n      fix i assume index: \"i < length ?As\"\n      have small: \"i < length Ss\" and ri: \"i < length rs\" using index clauses(3,4) by simp_all\n      have original: \"\\<forall>F v. environment_formed F \\<longrightarrow> artifact_at F v S \\<longrightarrow>\n        syntax_references F v A B \\<longrightarrow> native_schema_at F v (rs!i) (As!i)\"\n        using clauses(10) small by blast\n      have source_alpha: \"schema_alpha_variant (Ss!i) (As!i)\" using clauses(9) small by blast\n      have dep_equal: \"schema_dependencies (As!i) = schema_dependencies (Ss!i)\"\n        by (rule schema_alpha_dependencies[OF source_alpha])\n      have member: \"Ss!i \\<in> set Ss\" by (rule nth_mem[OF small])\n      have dependencies: \"schema_dependencies (As!i) \\<subseteq> rel_ran B\"\n        using clauses(7) dep_equal member by blast\n      have read: \"native_schema_at E u (3#(rs!i)) (rename_schema (Cons 3) (Cons 3) id (As!i))\"\n        by (rule compiled_schema_copy[OF clauses(1,6) original dependencies ef source right_inj right_addr\n            frame.clause_reads right_refs])\n      show \"native_schema_at E u (map (Cons 3) rs ! i) (?As!i)\" using read index ri by simp\n    qed\n    have lengths: \"length ?ss = length (map (Cons 3) rs)\" \"length ?ss = length ?As\"\n      using clauses(3,4) by simp_all\n    have family: \"native_schema_family_at E u [1,0] (set (zip ?ss ?As))\"\n      by (rule native_schema_family_from_list[OF ef source frame.clauses_read lengths\n          family_ports_distinct schema_reads])\n    have inside: \"I \\<subseteq> Cons 2 ` rra_carrier (object_structure R)\" using scoped(2) by blast\n    have top_separate: \"insert [] (set [[0,0],[0,1]]) \\<inter> (I \\<union> {[1,0]}) = {}\"\n      using inside by auto\n    have body_separate: \"[1,0] \\<notin> I\" using inside by auto\n    have interface_read: \"scoped_pattern_at E u (2#r) (rename_pattern ?f p) I K\"\n      using scoped(1) by (simp only: rename_pattern_composition)\n    show \"native_definition_at E u [] (rename_pattern ?f p) (set (zip ?ss ?As))\"\n      unfolding native_definition_at_def\n      by (rule conjI[OF ef], rule exI[of _ ?T], rule exI[of _ \"[[0,0],[0,1]]\"],\n          rule exI[of _ \"2#r\"], rule exI[of _ \"[1,0]\"], rule exI[of _ I], rule exI[of _ K])\n         (use source frame.record_read interface_read family top_separate body_separate in auto)\n  qed\n  show ?thesis by (rule exI[of _ ?T], rule exI[of _ ?f], rule exI[of _ ?ss], rule exI[of _ ?As],\n      rule exI[of _ ?L], rule exI[of _ ?C])\n    (use frame.formed frame.no_counts frame.root_inside finj clauses(3,4) alpha profile bounds range recover in auto)\nqed\n\ntext \\<open>\n  Every formed interface and complete finite clause list has native definition\n  syntax at the fixed empty local address. Its interface and each clause are\n  injective renamings of the source fields. Every callee requirement is derived\n  from the complete source list. Recovery is by the existing native definition\n  reader in the actual destination environment, including for zero clauses.\n\\<close>\n\nend\n",
