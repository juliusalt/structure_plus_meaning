          "theory": "Factor_Observation_Scope_Admission",
          "source": "theory Factor_Observation_Scope_Admission\n  imports Factor_Observation_Scope_Presentations\nbegin\n\nsection \\<open>Complete context admission uses the existing data list and subset operations\\<close>\n\nlemma observation_collection_subset_meaning:\n  \"(47,t)\\<in>positive_meaning observation_collection_system \\<longleftrightarrow>\n    (47,t)\\<in>positive_meaning data_subset_system\"\nproof -\n  have member: \"47\\<in>system_definitions data_set_comparison_system\"\n    using data_set_comparison_base_roots by auto\n  have retained: \"(47,t)\\<in>positive_meaning observation_collection_system \\<longleftrightarrow>\n      (47,t)\\<in>positive_meaning data_set_comparison_system\"\n    unfolding observation_collection_system_def\n    by (rule system_union_agree_right_locality(2)[OF observation_system_formed data_set_comparison_system_formed\n      observation_set_agreement member])\n  show ?thesis by (simp only: retained data_set_comparison_subset_meaning)\nqed\n\nlemma observation_scope_list_components:\n  \"(4,t)\\<in>positive_meaning observation_scope_system \\<longleftrightarrow>\n    (\\<exists>xs. t=data_list_term xs \\<and> data_elements xs)\"\n  \"(47,t)\\<in>positive_meaning observation_scope_system \\<longleftrightarrow>\n    (47,t)\\<in>positive_meaning data_subset_system\"\n  using observation_scope_base_meaning[of 4 t] observation_scope_base_meaning[of 47 t]\n    observation_collection_meaning[of 4 t] observation_components(3)[of t]\n    observation_collection_subset_meaning[of t] observation_base_roots\n  by auto\n\nlemma observation_scopes_valuation:\n  \"(310,t)\\<in>positive_meaning observation_scope_system \\<longleftrightarrow>\n    (\\<exists>h::nat\\<Rightarrow>factor_term. term_formed (h 0) \\<and> term_formed (h 1) \\<and> term_formed (h 2) \\<and>\n      t=observation_scope_context (h 0) (h 1) (h 2) \\<and>\n      (4,h 0)\\<in>positive_meaning observation_scope_system \\<and>\n      (47,Pair_Term (h 2) (h 1))\\<in>positive_meaning observation_scope_system)\"\nproof -\n  have family: \"((310,c),S)\\<in>system_clauses observation_scope_system \\<longleftrightarrow>\n      (c,S)\\<in>observation_scope_clause_family 310\" for c S\n    by (rule observation_scope_clause) simp\n  show ?thesis by (subst ordinary_positive_entry_valuation)\n    (auto simp: family observation_scope_clause_family_def observation_scopes_schema_def\n      schema_variables_def observation_scope_call)\nqed\n\nlemma observation_scopes_exact:\n  \"(310,t)\\<in>positive_meaning observation_scope_system \\<longleftrightarrow>\n    (\\<exists>C U F. data_elements C \\<and> data_elements U \\<and> data_elements F \\<and> set F\\<subseteq>set U \\<and>\n      t=observation_scope_context (data_list_term C) (data_list_term U) (data_list_term F))\"\nproof\n  assume \"(310,t)\\<in>positive_meaning observation_scope_system\"\n  then show \"\\<exists>C U F. data_elements C \\<and> data_elements U \\<and> data_elements F \\<and> set F\\<subseteq>set U \\<and>\n      t=observation_scope_context (data_list_term C) (data_list_term U) (data_list_term F)\"\n    by (auto simp: observation_scopes_valuation observation_scope_list_components data_subset_exact; blast)\nnext\n  assume \"\\<exists>C U F. data_elements C \\<and> data_elements U \\<and> data_elements F \\<and> set F\\<subseteq>set U \\<and>\n      t=observation_scope_context (data_list_term C) (data_list_term U) (data_list_term F)\"\n  then obtain C U F where parts: \"data_elements C\" \"data_elements U\" \"data_elements F\" \"set F\\<subseteq>set U\"\n    \"t=observation_scope_context (data_list_term C) (data_list_term U) (data_list_term F)\" by blast\n  show \"(310,t)\\<in>positive_meaning observation_scope_system\"\n    by (simp only: observation_scopes_valuation;\n      rule exI[of _ \"\\<lambda>i::nat. if i=0 then data_list_term C else if i=1 then data_list_term U else data_list_term F\"])\n      (use parts in \\<open>auto simp: observation_scope_list_components data_subset_lists data_list_term_formed\\<close>)\nqed\n\ninterpretation observation_scope_admission: admitted_context_profile observation_scope_system 311 310 309\n  by (rule admitted_context_profile.intro[OF observation_scope_system_formed])\n    (auto simp: observation_scope_clause observation_scope_clause_family_def observation_scope_call)\n\ntheorem observation_scope_encoded:\n  \"(311,observation_scope_argument (data_list_term C) (data_list_term U) (data_list_term F)\n    (data_list_term (map observation_row_term rows)))\\<in>positive_meaning observation_scope_system \\<longleftrightarrow>\n    observation_scope_subject_formed (fset_of_list C) (fset_of_list U) (fset_of_list F) (fset_of_list rows)\"\n  by (simp only: observation_scope_admission.lists[OF observation_scope_rows.context_list_profile_axioms])\n    (auto simp: observation_scopes_exact observation_scope_row_exact observation_scope_subject_lists\n      data_list_term_injective data_list_term_formed split: prod.splits)\n\nsection \\<open>Every accepted argument recovers the whole scope and table\\<close>\n\nlemma observation_scope_input:\n  assumes \"(311,t)\\<in>positive_meaning observation_scope_system\"\n  obtains C U F rows where \"data_elements C\" \"data_elements U\" \"data_elements F\" \"observation_rows_data rows\"\n    \"t=observation_scope_argument (data_list_term C) (data_list_term U) (data_list_term F)\n      (data_list_term (map observation_row_term rows))\"\nproof -\n  obtain p table where parts: \"t=Pair_Term p table\" \"(310,p)\\<in>positive_meaning observation_scope_system\"\n    \"(309,Pair_Term p table)\\<in>positive_meaning observation_scope_system\"\n    using assms by (simp only: observation_scope_admission.exact) blast\n  obtain C U F where ctx_fields: \"data_elements C\" \"data_elements U\" \"data_elements F\"\n    \"p=observation_scope_context (data_list_term C) (data_list_term U) (data_list_term F)\"\n    using parts(2) by (simp only: observation_scopes_exact) blast\n  obtain ts where table: \"table=data_list_term ts\"\n    \"\\<forall>x\\<in>set ts. (308,Pair_Term p x)\\<in>positive_meaning observation_scope_system\"\n    using parts(3) by (auto simp only: observation_scope_rows.exact factor_term.inject)\n  have rows_admitted: \"\\<forall>x\\<in>set ts. observation_row_admitted x\"\n    using table(2) by (auto simp: observation_scope_row_exact; blast)\n  obtain rows where rows: \"ts=map observation_row_term rows\" \"observation_rows_data rows\"\n    using rows_admitted by (simp only: observation_rows_present) blast\n  show ?thesis by (rule that[OF ctx_fields(1-3) rows(2)])\n    (simp only: parts(1) ctx_fields(4) table(1) rows(1))\nqed\n\nabbreviation observation_scope_result where\n  \"observation_scope_result t \\<equiv> \\<exists>C U F rows.\n    observation_scope_subject_formed (fset_of_list C) (fset_of_list U) (fset_of_list F) (fset_of_list rows) \\<and>\n    t=observation_scope_argument (data_list_term C) (data_list_term U) (data_list_term F)\n      (data_list_term (map observation_row_term rows))\"\n\ntheorem observation_scope_exact:\n  \"(311,t)\\<in>positive_meaning observation_scope_system \\<longleftrightarrow> observation_scope_result t\"\nproof\n  assume holds: \"(311,t)\\<in>positive_meaning observation_scope_system\"\n  obtain C U F rows where source: \"t=observation_scope_argument (data_list_term C) (data_list_term U)\n      (data_list_term F) (data_list_term (map observation_row_term rows))\"\n    by (rule observation_scope_input[OF holds]) blast\n  have formed: \"observation_scope_subject_formed (fset_of_list C) (fset_of_list U) (fset_of_list F) (fset_of_list rows)\"\n    using holds by (simp only: source observation_scope_encoded)\n  show \"observation_scope_result t\" using formed source by blast\nnext\n  assume \"observation_scope_result t\"\n  then obtain C U F rows where parts:\n    \"observation_scope_subject_formed (fset_of_list C) (fset_of_list U) (fset_of_list F) (fset_of_list rows)\"\n    \"t=observation_scope_argument (data_list_term C) (data_list_term U) (data_list_term F)\n      (data_list_term (map observation_row_term rows))\" by blast\n  show \"(311,t)\\<in>positive_meaning observation_scope_system\"\n    by (simp only: parts(2) observation_scope_encoded parts(1))\nqed\n\ntheorem observation_scope_presented:\n  \"(311,t)\\<in>positive_meaning observation_scope_system \\<longleftrightarrow>\n    presented_predicate observation_scope_record_presents observation_scope_domain t\"\nproof\n  assume holds: \"(311,t)\\<in>positive_meaning observation_scope_system\"\n  obtain C U F rows where parts:\n    \"observation_scope_subject_formed (fset_of_list C) (fset_of_list U) (fset_of_list F) (fset_of_list rows)\"\n    \"t=observation_scope_argument (data_list_term C) (data_list_term U) (data_list_term F)\n      (data_list_term (map observation_row_term rows))\"\n    using holds by (simp only: observation_scope_exact) blast\n  have data: \"data_elements C\" \"data_elements U\" \"data_elements F\" \"observation_rows_data rows\"\n    using parts(1) by (auto simp only: observation_scope_subject_lists)\n  have read: \"observation_scope_record_presents\n      ((fset_of_list C,(fset_of_list U,fset_of_list F)),fset_of_list rows) t\"\n    using observation_scope_record_enumeration[OF data] by (simp only: parts(2))\n  show \"presented_predicate observation_scope_record_presents observation_scope_domain t\"\n    by (simp only: presented_predicate_def; rule exI[of _\n      \"((fset_of_list C,(fset_of_list U,fset_of_list F)),fset_of_list rows)\"])\n      (use read parts(1) in simp)\nnext\n  assume \"presented_predicate observation_scope_record_presents observation_scope_domain t\"\n  then obtain z where presented: \"observation_scope_record_presents z t\" \"observation_scope_domain z\"\n    by (simp only: presented_predicate_def) blast\n  obtain ctx T where z: \"z=(ctx,T)\" by (cases z) auto\n  obtain C rest where ctx: \"ctx=(C,rest)\" by (cases ctx) auto\n  obtain U F where rest: \"rest=(U,F)\" by (cases rest) auto\n  have read: \"observation_scope_record_presents ((C,(U,F)),T) t\"\n    and formed: \"observation_scope_subject_formed C U F T\"\n    using presented by (simp_all only: z ctx rest fst_conv snd_conv)\n  obtain cs us fs rows where fields: \"fset_of_list cs=C\" \"fset_of_list us=U\"\n    \"fset_of_list fs=F\" \"fset_of_list rows=T\"\n    \"t=observation_scope_argument (data_list_term cs) (data_list_term us) (data_list_term fs)\n      (data_list_term (map observation_row_term rows))\"\n    by (rule observation_scope_record_fields[OF read]) blast\n  show \"(311,t)\\<in>positive_meaning observation_scope_system\"\n    by (simp only: fields(5) observation_scope_encoded fields(1-4) formed)\nqed\n\ncorollary observation_scope_at:\n  assumes \"observation_scope_record_presents z p\"\n  shows \"(311,p)\\<in>positive_meaning observation_scope_system \\<longleftrightarrow> observation_scope_domain z\"\n  unfolding observation_scope_presented\n  by (rule observation_scope_records.predicate_at[OF assms])\n\ncorollary observation_scope_invariance:\n  assumes \"observation_scope_record_presents z p\" \"observation_scope_record_presents z q\"\n  shows \"(311,p)\\<in>positive_meaning observation_scope_system \\<longleftrightarrow>\n    (311,q)\\<in>positive_meaning observation_scope_system\"\n  by (rule observation_scope_records.predicate_invariance[OF assms observation_scope_presented])\n\nend\n",
