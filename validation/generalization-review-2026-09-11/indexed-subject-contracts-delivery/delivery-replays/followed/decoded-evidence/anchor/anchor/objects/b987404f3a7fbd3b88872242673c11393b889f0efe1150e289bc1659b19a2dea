          "theory": "Factor_Scope_Computation_Contracts",
          "source": "theory Factor_Scope_Computation_Contracts\n  imports Factor_Observation_Scope_Admission Presentation_Function_Witnesses\nbegin\n\nsection \\<open>A complete admitted scope retains its whole enumerated input\\<close>\n\nlemma observation_scope_subject_list_data:\n  assumes \"observation_scope_subject_formed (fset_of_list cs) (fset_of_list us) (fset_of_list fs) (fset_of_list rows)\"\n  shows \"data_elements cs\" \"data_elements us\" \"data_elements fs\" \"observation_rows_data rows\"\nproof -\n  have fields: \"data_elements cs \\<and> data_elements us \\<and> data_elements fs \\<and> observation_rows_data rows \\<and>\n      (\\<forall>(f,c,w)\\<in>set rows. f\\<in>set us \\<and> c\\<in>set cs) \\<and> set fs\\<subseteq>set us\"\n    by (rule iffD1[OF observation_scope_subject_lists assms])\n  show \"data_elements cs\" by (rule conjunct1[OF fields])\n  show \"data_elements us\" by (rule conjunct1[OF conjunct2[OF fields]])\n  show \"data_elements fs\" by (rule conjunct1[OF conjunct2[OF conjunct2[OF fields]]])\n  show \"observation_rows_data rows\" by (rule conjunct1[OF conjunct2[OF conjunct2[OF conjunct2[OF fields]]]])\nqed\n\nlemma observation_scope_enumerated:\n  assumes \"observation_scope_presents z p\"\n  obtains cs us fs rows where \"data_elements cs\" \"data_elements us\" \"data_elements fs\" \"observation_rows_data rows\"\n    \"observation_scope_subject_formed (fset_of_list cs) (fset_of_list us) (fset_of_list fs) (fset_of_list rows)\"\n    \"z=((fset_of_list cs,(fset_of_list us,fset_of_list fs)),fset_of_list rows)\"\n    \"p=observation_scope_argument (data_list_term cs) (data_list_term us) (data_list_term fs)\n      (data_list_term (map observation_row_term rows))\"\nproof -\n  obtain C U F T where shape: \"z=((C,(U,F)),T)\" by (cases z; case_tac a; case_tac b; auto)\n  have source_fields: \"observation_scope_subject_formed C U F T \\<and>\n      observation_scope_record_presents ((C,(U,F)),T) p\"\n    using assms by (simp only: shape fst_conv snd_conv)\n  have record_read: \"observation_scope_record_presents ((C,(U,F)),T) p\" by (rule conjunct2[OF source_fields])\n  have scope: \"observation_scope_subject_formed C U F T\" by (rule conjunct1[OF source_fields])\n  obtain cs us fs rows where fields: \"data_elements cs\" \"data_elements us\" \"data_elements fs\" \"observation_rows_data rows\"\n    \"fset_of_list cs=C\" \"fset_of_list us=U\" \"fset_of_list fs=F\" \"fset_of_list rows=T\"\n    \"p=observation_scope_argument (data_list_term cs) (data_list_term us) (data_list_term fs)\n      (data_list_term (map observation_row_term rows))\"\n    by (rule observation_scope_record_fields[OF record_read]) blast\n  have admitted: \"observation_scope_subject_formed (fset_of_list cs) (fset_of_list us) (fset_of_list fs) (fset_of_list rows)\"\n    by (simp only: fields(5-8) scope)\n  have subject: \"z=((fset_of_list cs,(fset_of_list us,fset_of_list fs)),fset_of_list rows)\"\n    by (simp only: shape fields(5-8))\n  show ?thesis by (rule that[OF fields(1-4) admitted subject fields(9)])\nqed\n\nsection \\<open>Admission and a returned value establish a complete function witness\\<close>\n\ntheorem observation_scope_computed_witness:\n  assumes target: \"presentation_class S E B\"\n    and boundary: \"\\<And>p q. operation p q \\<Longrightarrow> (311,p)\\<in>positive_meaning observation_scope_system\"\n    and computation: \"\\<And>cs us fs rows q. operation\n      (observation_scope_argument (data_list_term cs) (data_list_term us) (data_list_term fs)\n        (data_list_term (map observation_row_term rows))) q \\<longleftrightarrow>\n      observation_scope_subject_formed (fset_of_list cs) (fset_of_list us) (fset_of_list fs) (fset_of_list rows) \\<and>\n      q=h cs us fs rows\"\n    and returned: \"\\<And>cs us fs rows. data_elements cs \\<Longrightarrow> data_elements us \\<Longrightarrow> data_elements fs \\<Longrightarrow>\n      observation_rows_data rows \\<Longrightarrow>\n      S (f ((fset_of_list cs,(fset_of_list us,fset_of_list fs)),fset_of_list rows)) (h cs us fs rows)\"\n  shows \"presented_function_witness observation_scope_presents observation_scope_domain\n    (\\<lambda>p. \\<exists>z. observation_scope_presents z p) S E B f operation\"\nproof (rule presented_function_witness.intro[OF observation_scope_class target]; unfold_locales)\n  fix p q assume \"operation p q\"\n  then have \"(311,p)\\<in>positive_meaning observation_scope_system\" by (rule boundary)\n  then show \"\\<exists>z. observation_scope_presents z p\"\n    by (simp only: observation_scope_presented presented_predicate_def; blast)\nnext\n  fix z p q assume read: \"observation_scope_presents z p\" and run: \"operation p q\"\n  obtain cs us fs rows where fields: \"data_elements cs\" \"data_elements us\" \"data_elements fs\" \"observation_rows_data rows\"\n    \"z=((fset_of_list cs,(fset_of_list us,fset_of_list fs)),fset_of_list rows)\"\n    \"p=observation_scope_argument (data_list_term cs) (data_list_term us) (data_list_term fs)\n      (data_list_term (map observation_row_term rows))\"\n    by (rule observation_scope_enumerated[OF read]) blast\n  have result: \"q=h cs us fs rows\" using run by (simp only: fields(6) computation; blast)\n  show \"S (f z) q\" by (simp only: fields(5) result; rule returned[OF fields(1-4)])\nnext\n  fix p assume \"\\<exists>z. observation_scope_presents z p\"\n  then obtain z where read: \"observation_scope_presents z p\" by blast\n  obtain cs us fs rows where fields:\n    \"observation_scope_subject_formed (fset_of_list cs) (fset_of_list us) (fset_of_list fs) (fset_of_list rows)\"\n    \"p=observation_scope_argument (data_list_term cs) (data_list_term us) (data_list_term fs)\n      (data_list_term (map observation_row_term rows))\"\n    by (rule observation_scope_enumerated[OF read]) blast\n  show \"\\<exists>q. operation p q\"\n    by (rule exI[of _ \"h cs us fs rows\"])\n      (simp only: fields(2) computation; rule conjI[OF fields(1) refl])\nqed\n\ntext \\<open>\n  The source remains the independently admitted observation scope. The\n  calculation supplies its actual input boundary, its equation on every\n  complete enumeration, and the presentation of its returned value. These\n  contracts establish soundness and totality for every admitted input term.\n  The returned witness may depend on input order or repetition; its represented\n  subject depends only on the complete scope. A downstream complete comparison\n  can then admit every presentation of that same value.\n\\<close>\n\nend\n",
