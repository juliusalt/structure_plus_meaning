s_meaning[of 24 \"Pair_Term a b\"] binding_entry_exact[OF read, of b] by auto\n\ntheorem binding_entries_exact:\n  assumes read: \"data_collection_presents environment_artifact_entry_presents A a\"\n  shows \"(25,Pair_Term a b)\\<in>positive_meaning binding_entries_system \\<longleftrightarrow>\n    (\\<exists>zs. b=data_list_term (map binding_data zs) \\<and> (\\<forall>z\\<in>set zs. binding_supported A z))\"\nproof -\n  have formed: \"term_formed a\"\n    by (rule data_collection_presents_formed[OF read]) (meson environment_artifact_entry_formed)\n  have elements: \"(24,Pair_Term a t)\\<in>positive_meaning binding_entries_system \\<longleftrightarrow>\n    (\\<exists>z. t=binding_data z \\<and> binding_supported A z)\" for t\n    by (rule binding_entries_element[OF read])\n  have lists: \"(25,Pair_Term a b)\\<in>positive_meaning binding_entries_system \\<longleftrightarrow>\n    (\\<exists>ts. b=data_list_term ts \\<and> (\\<forall>t\\<in>set ts. \\<exists>z. t=binding_data z \\<and> binding_supported A z))\"\n    using formed by (auto simp: binding_lists.exact elements)\n  show ?thesis using lists by (simp only: list_range_restricted_witnesses) blast\nqed\n\nlemma binding_entries_data:\n  assumes \"(25,Pair_Term a (data_list_term (map binding_data zs)))\\<in>positive_meaning binding_entries_system\"\n  shows \"data_elements (map binding_data zs)\"\n  using schema_call_formed_target[OF positive_meaning_formed[OF assms]]\n  by (auto simp: data_list_term_formed)\n\nlemma admitted_artifact_table:\n  \"(23,a)\\<in>positive_meaning artifact_entries_system \\<and> (21,a)\\<in>positive_meaning keyed_list_system \\<longleftrightarrow>\n    (\\<exists>A. data_collection_presents environment_artifact_entry_presents A a \\<and> single_valued A)\"\nproof -\n  have keys: \"(21,data_list_term ts)\\<in>positive_meaning keyed_list_system \\<longleftrightarrow>\n    distinct xs \\<and> single_valued (set xs)\"\n    if read: \"list_all2 environment_artifact_entry_presents xs ts\" 