          "source": "theory Factor_Pattern_Forests\n  imports Factor_Pattern_Encoding RRA_Bound_Forests\nbegin\n\nsection \\<open>Finite collections of bodies sharing one declared scope\\<close>\n\ndefinition pattern_forest_variables :: \"'a term_pattern list \\<Rightarrow> 'a set\" where\n  \"pattern_forest_variables ps = (\\<Union>p\\<in>set ps. pattern_variables p)\"\n\nlemma pattern_forest_variables_simps [simp]:\n  \"pattern_forest_variables [] = {}\"\n  \"pattern_forest_variables (p#ps) = pattern_variables p \\<union> pattern_forest_variables ps\"\n  by (auto simp: pattern_forest_variables_def)\n\nlemma pattern_forest_variables_finite [simp]: \"finite (pattern_forest_variables ps)\"\n  by (simp add: pattern_forest_variables_def)\n\nfun pattern_forest_syntax :: \"('a \\<Rightarrow> local_address) \\<Rightarrow> 'a term_pattern list \\<Rightarrow> exact_artifact\" where\n  \"pattern_forest_syntax f [] = empty_artifact\"\n| \"pattern_forest_syntax f (p#ps) = bound_union (pattern_syntax f p) (pattern_forest_syntax f ps)\"\n\nfun pattern_forest_interior :: \"'a term_pattern list \\<Rightarrow> local_address set\" where\n  \"pattern_forest_interior [] = {}\"\n| \"pattern_forest_interior (p#ps) = Cons 2 ` pattern_syntax_interior p \\<union> Cons 3 ` pattern_forest_interior ps\"\n\nfun pattern_forest_bindings :: \"'a term_pattern list \\<Rightarrow> (local_address \\<times> exact_artifact) set\" where\n  \"pattern_forest_bindings [] = {}\"\n| \"pattern_forest_bindings (p#ps) =\n    (\\<lambda>(k,R). (2#k,R)) ` pattern_literal_bindings p \\<union>\n    (\\<lambda>(k,R). (3#k,R)) ` pattern_forest_bindings ps\"\n\nfun pattern_forest_roots :: \"'a term_pattern list \\<Rightarrow> local_address list\" where\n  \"pattern_forest_roots [] = []\"\n| \"pattern_forest_roots (p#ps) = [2] # map (Cons 3) (pattern_forest_roots ps)\"\n\nlemma pattern_forest_slots [simp]:\n  \"rel_dom (pattern_forest_bindings []) = {}\"\n  \"rel_dom (pattern_forest_bindings (p#ps)) =\n    Cons 2 ` rel