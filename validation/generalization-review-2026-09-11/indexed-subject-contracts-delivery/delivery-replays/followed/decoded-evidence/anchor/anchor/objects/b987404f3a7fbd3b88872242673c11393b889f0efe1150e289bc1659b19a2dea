          "theory": "Factor_Self_Contained_Terms",
          "source": "theory Factor_Self_Contained_Terms\n  imports Factor_Finite_Presentations\nbegin\n\nsection \\<open>Terms whose recovery needs no external target\\<close>\n\nfun self_contained_term :: \"factor_term \\<Rightarrow> bool\" where\n  \"self_contained_term (Target_Term t) = False\"\n| \"self_contained_term (Payload_Term v) = True\"\n| \"self_contained_term (Pair_Term x y) =\n    (self_contained_term x \\<and> self_contained_term y)\"\n\nlemma self_contained_syntax_nonroot:\n  assumes closed: \"self_contained_term t\"\n    and member: \"a\\<in>rra_carrier (object_structure (term_syntax t))\" and nonroot: \"a\\<noteq>[]\"\n  shows \"a\\<in>participation_occurrences (object_structure (term_syntax t)) \\<union>\n    reached_occurrences (object_structure (term_syntax t))\"\n  using closed member nonroot\nproof (induction t arbitrary: a)\n  case (Target_Term t)\n  then show ?case by simp\nnext\n  case (Payload_Term v)\n  then show ?case by simp\nnext\n  case (Pair_Term x y)\n  let ?L=\"object_structure (term_syntax x)\"\n  let ?R=\"object_structure (term_syntax y)\"\n  let ?S=\"object_structure (pair_syntax (term_syntax x) (term_syntax y))\"\n  let ?U=\"participation_occurrences ?S \\<union> reached_occurrences ?S\"\n  have xf: \"self_contained_term x\" and yf: \"self_contained_term y\"\n    using Pair_Term.prems(1) by auto\n  have left: \"Cons 2 ` rra_carrier ?L \\<subseteq> ?U\"\n  proof\n    fix a assume \"a\\<in>Cons 2 ` rra_carrier ?L\"\n    then obtain b where position: \"a=2#b\" and inside: \"b\\<in>rra_carrier ?L\" by blast\n    show \"a\\<in>?U\"\n    proof (cases \"b=[]\")\n      case True\n      then show ?thesis using position by (simp add: pair_syntax_projections)\n    next\n      case False\n      have covered: \"b\\<in>participation_occurrences ?L \\<union> reached_occurrences ?L\"\n        by (rule Pair_Term.IH(1)[OF xf inside False])\n      show ?thesis using covered position by (auto simp: pair_syntax_projections)\n    qed\n  qed\n  have right: \"Cons 3 ` rra_carrier ?R \\<subseteq> ?U\"\n  proof\n    fix a assume \"a\\<in>Cons 3 ` rra_carrier ?R\"\n    then obtain b where position: \"a=3#b\" and inside: \"b\\<in>rra_carrier ?R\" by blast\n    show \"a\\<in>?U\"\n    proof (cases \"b=[]\")\n      case True\n      then show ?thesis using position by (simp add: pair_syntax_projections)\n    next\n      case False\n      have covered: \"b\\<in>participation_occurrences ?R \\<union> reached_occurrences ?R\"\n        by (rule Pair_Term.IH(2)[OF yf inside False])\n      show ?thesis using covered position by (auto simp: pair_syntax_projections)\n    qed\n  qed\n  have slots: \"[0]\\<in>?U\" \"[1]\\<in>?U\" by (simp_all add: pair_syntax_projections)\n  show ?case using Pair_Term.prems(2,3) left right slots\n    by (auto simp: pair_syntax_carrier)\nqed\n\nlemma self_contained_syntax_unreferenced:\n  assumes closed: \"self_contained_term t\"\n  shows \"rra_carrier (object_structure (term_syntax t)) -\n    (participation_occurrences (object_structure (term_syntax t)) \\<union>\n     reached_occurrences (object_structure (term_syntax t))) = {[]}\"\nproof -\n  have root: \"[]\\<notin>participation_occurrences (object_structure (term_syntax t)) \\<union>\n    reached_occurrences (object_structure (term_syntax t))\"\n    using closed by (cases t) (auto simp: pair_syntax_projections)\n  have covered: \"\\<And>a. a\\<in>rra_carrier (object_structure (term_syntax t)) \\<Longrightarrow> a\\<noteq>[] \\<Longrightarrow>\n    a\\<in>participation_occurrences (object_structure (term_syntax t)) \\<union>\n      reached_occurrences (object_structure (term_syntax t))\"\n    by (rule self_contained_syntax_nonroot[OF closed])\n  show ?thesis using root covered by auto\nqed\n\nlemma self_contained_term_literals_empty:\n  assumes \"self_contained_term t\"\n  shows \"term_literal_bindings t={}\"\n  using assms by (induction t) auto\n\nlemma self_contained_quotation_no_slots:\n  assumes quote: \"term_quoted_at E u r t I K\" and closed: \"self_contained_term t\"\n  shows \"K={}\"\n  using quote closed by (induction rule: term_quoted_at.induct) auto\n\ntheorem self_contained_quotation_transfer:\n  fixes E :: \"'u artifact_environment\" and F :: \"'v artifact_environment\"\n  assumes quote: \"term_quoted_at E u r t I K\" and closed: \"self_contained_term t\"\n    and source: \"artifact_at E u R\"\n    and ff: \"environment_formed F\" and destination: \"artifact_at F v R\"\n  shows \"term_quoted_at F v r t I K\"\n  using quote closed source destination\nproof (induction arbitrary: R rule: term_quoted_at.induct)\n  case (target u S r c I t)\n  then show ?case by simp\nnext\n  case (pair u S r ps l q x L A y Q B)\n  have same: \"S=R\" by (rule environment_artifact_unique[OF pair.hyps(1,2) pair.prems(2)])\n  have xf: \"self_contained_term x\" and yf: \"self_contained_term y\"\n    using pair.prems(1) by auto\n  have rec: \"record_at R r ps [l,q]\" using pair.hyps(3) same by simp\n  have left: \"term_quoted_at F v l x L A\" by (rule pair.IH(1)[OF xf pair.prems(2,3)])\n  have right: \"term_quoted_at F v q y Q B\" by (rule pair.IH(2)[OF yf pair.prems(2,3)])\n  show ?case by (rule term_quoted_at.pair[OF ff pair.prems(3) rec left right pair.hyps(6-8)])\nnext\n  case (payload u S r x)\n  have same: \"S=R\" by (rule environment_artifact_unique[OF payload.hyps(1,2) payload.prems(2)])\n  have leaf: \"payload_leaf_at R r x\" using payload.hyps(3) same by simp\n  show ?case by (rule term_quoted_at.payload[OF ff payload.prems(3) leaf])\nqed\n\ndefinition self_contained_quoted_at ::\n  \"exact_artifact \\<Rightarrow> local_address \\<Rightarrow> factor_term \\<Rightarrow> local_address set \\<Rightarrow> bool\" where\n  \"self_contained_quoted_at R r t I \\<longleftrightarrow>\n    self_contained_term t \\<and> term_quoted_at (singleton_environment R) () r t I {}\"\n\nlemma self_contained_quoted_unique:\n  assumes \"self_contained_quoted_at R r t I\" \"self_contained_quoted_at R r v J\"\n  shows \"t=v \\<and> I=J\"\nproof -\n  have first: \"term_quoted_at (singleton_environment R) () r t I {}\"\n    and second: \"term_quoted_at (singleton_environment R) () r v J {}\"\n    using assms by (simp_all add: self_contained_quoted_at_def)\n  show ?thesis using term_quoted_unique[OF first second] by blast\nqed\n\nlemma self_contained_quoted_formed:\n  assumes \"self_contained_quoted_at R r t I\"\n  shows \"exact_formed R \\<and> term_formed t\"\nproof -\n  have read: \"term_quoted_at (singleton_environment R) () r t I {}\"\n    using assms by (simp add: self_contained_quoted_at_def)\n  have ef: \"environment_formed (singleton_environment R)\"\n    by (rule term_quoted_environment_formed[OF read])\n  have source: \"artifact_at (singleton_environment R) () R\"\n    by (simp add: singleton_environment_def artifact_at_def)\n  have rf: \"exact_formed R\" using ef source by (simp add: environment_formed_def)\n  show ?thesis using rf term_quoted_formed[OF read] by blast\nqed\n\nlemma self_contained_quoted_in_environment:\n  assumes read: \"self_contained_quoted_at R r t I\"\n    and ef: \"environment_formed E\" and source: \"artifact_at E u R\"\n  shows \"term_quoted_at E u r t I {}\"\nproof -\n  have quote: \"term_quoted_at (singleton_environment R) () r t I {}\"\n    and closed: \"self_contained_term t\"\n    using read by (simp_all add: self_contained_quoted_at_def)\n  have art: \"artifact_at (singleton_environment R) () R\"\n    by (simp add: singleton_environment_def artifact_at_def)\n  show ?thesis by (rule self_contained_quotation_transfer[OF quote closed art ef source])\nqed\n\ntheorem self_contained_quotation_total:\n  assumes formed: \"term_formed t\" and closed: \"self_contained_term t\"\n  shows \"self_contained_quoted_at (term_syntax t) [] t (term_syntax_interior t)\"\n    \"exact_formed (term_syntax t)\"\n    \"rra_carrier (object_structure (term_syntax t))=term_syntax_interior t\"\nproof -\n  have rf: \"exact_formed (term_syntax t)\" by (rule term_syntax_formed[OF formed])\n  have slots: \"term_literal_bindings t={}\" by (rule self_contained_term_literals_empty[OF closed])\n  have quote: \"term_quoted_at (term_environment t) None [] t (term_syntax_interior t) {}\"\n    using term_syntax_recovers[OF formed] slots by simp\n  have ef: \"environment_formed (singleton_environment (term_syntax t))\"\n    using singleton_environment_closed[OF rf] by (simp add: environment_closed_def)\n  have art: \"artifact_at (singleton_environment (term_syntax t)) () (term_syntax t)\"\n    by (simp add: singleton_environment_def artifact_at_def)\n  have recovered: \"term_quoted_at (singleton_environment (term_syntax t)) ()\n    [] t (term_syntax_interior t) {}\"\n    by (rule self_contained_quotation_transfer[OF quote closed term_environment_source ef art])\n  show \"self_contained_quoted_at (term_syntax t) [] t (term_syntax_interior t)\"\n    using closed recovered by (simp add: self_contained_quoted_at_def)\n  show \"exact_formed (term_syntax t)\" by (rule rf)\n  show \"rra_carrier (object_structure (term_syntax t))=term_syntax_interior t\"\n    using term_syntax_carrier[of t] slots by simp\nqed\n\nsection \\<open>Complete finite collections carried by payloads and pairs\\<close>\n\nfun data_list_term :: \"factor_term list \\<Rightarrow> factor_term\" where\n  \"data_list_term [] = Payload_Term []\"\n| \"data_list_term (t#ts) = Pair_Term t (data_list_term ts)\"\n\nlemma data_list_term_injective:\n  \"data_list_term xs=data_list_term ys \\<longleftrightarrow> xs=ys\"\n  by (induction xs arbitrary: ys) (case_tac ys; auto)+\n\nlemma data_list_term_formed:\n  \"term_formed (data_list_term ts) \\<longleftrightarrow> (\\<forall>t\\<in>set ts. term_formed t)\"\n  by (induction ts) (auto simp: octets_formed_def)\n\nlemma data_list_term_self_contained:\n  \"self_contained_term (data_list_term ts) \\<longleftrightarrow>\n    (\\<forall>t\\<in>set ts. self_contained_term t)\"\n  by (induction ts) auto\n\nlemma data_list_term_member_height:\n  assumes \"x\\<in>set xs\"\n  shows \"term_height x<term_height (data_list_term xs)\"\n  using assms\nproof (induction xs)\n  case Nil\n  then show ?case by simp\nnext\n  case (Cons y ys)\n  show ?case\n  proof (cases \"x=y\")\n    case True\n    then show ?thesis by simp\n  next\n    case False\n    have inside: \"x\\<in>set ys\" using Cons.prems False by simp\n    have smaller: \"term_height x<term_height (data_list_term ys)\" by (rule Cons.IH[OF inside])\n    show ?thesis by (rule less_le_trans[OF smaller]) simp\n  qed\nqed\n\nlemma injective_mapped_lists:\n  assumes \"inj f\"\n  shows \"map f xs=map f ys \\<longleftrightarrow> xs=ys\"\n  using assms by (induction xs arbitrary: ys) (case_tac ys; auto dest: injD)+\n\ndefinition data_collection_presents ::\n  \"('a \\<Rightarrow> factor_term \\<Rightarrow> bool) \\<Rightarrow> 'a set \\<Rightarrow> factor_term \\<Rightarrow> bool\" where\n  \"data_collection_presents read A t \\<longleftrightarrow>\n    (\\<exists>xs ts. distinct xs \\<and> set xs=A \\<and> list_all2 read xs ts \\<and> t=data_list_term ts)\"\n\nlemma data_collection_presents_finite:\n  assumes \"data_collection_presents read A t\"\n  shows \"finite A\"\n  using assms by (auto simp: data_collection_presents_def)\n\nlemma data_collection_presents_mono [mono]:\n  assumes order: \"P\\<le>Q\"\n  shows \"data_collection_presents P\\<le>data_collection_presents Q\"\nproof (intro le_funI le_boolI)\n  fix A v\n  assume present: \"data_collection_presents P A v\"\n  obtain xs ts where entries: \"distinct xs\" \"set xs=A\" \"list_all2 P xs ts\" \"v=data_list_term ts\"\n    using present unfolding data_collection_presents_def by blast\n  have \"list_all2 Q xs ts\" by (rule list_all2_mono[OF entries(3)])\n    (use order in \\<open>auto simp: le_fun_def\\<close>)\n  then show \"data_collection_presents Q A v\" using entries(1,2,4)\n    unfolding data_collection_presents_def by blast\nqed\n\nlemma data_collection_presents_sources:\n  assumes present: \"data_collection_presents read A t\"\n  shows \"\\<forall>a\\<in>A. \\<exists>v. read a v\"\nproof -\n  obtain xs ts where entries: \"set xs=A\" \"list_all2 read xs ts\"\n    using present unfolding data_collection_presents_def by blast\n  show ?thesis\n  proof (intro ballI)\n    fix a assume \"a\\<in>A\"\n    then obtain i where index: \"i<length xs\" \"a=xs!i\"\n      using entries(1) by (auto simp: in_set_conv_nth)\n    have \"read (xs!i) (ts!i)\" by (rule list_all2_nthD[OF entries(2) index(1)])\n    then show \"\\<exists>v. read a v\" using index(2) by auto\n  qed\nqed\n\nlemma data_collection_presents_map:\n  assumes \"distinct xs\" \"set xs=A\" \"\\<And>x. x\\<in>A \\<Longrightarrow> read x (f x)\"\n  shows \"data_collection_presents read A (data_list_term (map f xs))\"\n  unfolding data_collection_presents_def\n  by (rule exI[of _ xs], rule exI[of _ \"map f xs\"])\n     (use assms in \\<open>simp add: list_all2_map2 list_all2_same\\<close>)\n\nlemma data_collection_presents_recover_map:\n  assumes present: \"data_collection_presents read A (data_list_term (map code xs))\"\n    and recover: \"\\<And>x a. x\\<in>set xs \\<Longrightarrow> read a (code x) \\<Longrightarrow> a=decode x\"\n  shows \"A=set (map decode xs)\"\nproof -\n  obtain ys ts where source: \"set ys=A\" \"list_all2 read ys ts\"\n    \"data_list_term (map code xs)=data_list_term ts\"\n    using present by (auto simp: data_collection_presents_def)\n  have reads: \"list_all2 read ys (map code xs)\"\n    using source(2,3) by (simp add: data_list_term_injective)\n  have inverse: \"ys=map decode xs\" using reads recover\n  proof (induction xs arbitrary: ys)\n    case Nil\n    then show ?case by simp\n  next\n    case (Cons x xs)\n    obtain y zs where shape: \"ys=y#zs\" and head: \"read y (code x)\"\n      and tail: \"list_all2 read zs (map code xs)\"\n      using Cons.prems(1) by (auto simp: list_all2_Cons2)\n    have first: \"y=decode x\" using Cons.prems(2) head by simp\n    have rest: \"zs=map decode xs\" by (rule Cons.IH[OF tail]) (use Cons.prems(2) in auto)\n    show ?case using shape first rest by simp\n  qed\n  show ?thesis using source(1) inverse by simp\nqed\n\nlemma data_collection_presents_function:\n  \"data_collection_presents (\\<lambda>a u. u=f a) A t \\<longleftrightarrow>\n    (\\<exists>xs. distinct xs \\<and> set xs=A \\<and> t=data_list_term (map f xs))\"\n  by (simp add: data_collection_presents_def list_all2_function)\n\nlemma data_collection_presents_total:\n  assumes fin: \"finite A\" and each: \"\\<forall>a\\<in>A. \\<exists>t. read a t\"\n  shows \"\\<exists>t. data_collection_presents read A t\"\nproof -\n  obtain xs where enumeration: \"distinct xs\" \"set xs=A\"\n    using finite_distinct_list[OF fin] by blast\n  obtain f where chosen: \"\\<forall>a\\<in>A. read a (f a)\" using bchoice[OF each] by blast\n  have \"data_collection_presents read A (data_list_term (map f xs))\"\n    by (rule data_collection_presents_map[OF enumeration]) (use chosen in blast)\n  then show ?thesis by blast\nqed\n\nlemma data_collection_presents_unique:\n  assumes first: \"data_collection_presents read A t\"\n    and second: \"data_collection_presents read B t\"\n    and unique: \"\\<And>a b u. a\\<in>A \\<Longrightarrow> b\\<in>B \\<Longrightarrow>\n      read a u \\<Longrightarrow> read b u \\<Longrightarrow> a=b\"\n  shows \"A=B\"\nproof -\n  obtain xs ts where left: \"distinct xs\" \"set xs=A\" \"list_all2 read xs ts\" \"t=data_list_term ts\"\n    using first unfolding data_collection_presents_def by blast\n  obtain ys us where right: \"distinct ys\" \"set ys=B\" \"list_all2 read ys us\" \"t=data_list_term us\"\n    using second unfolding data_collection_presents_def by blast\n  have same: \"ts=us\" using left(4) right(4) by (simp add: data_list_term_injective)\n  have a: \"finite_collection_presents read A (enumeration_term ts)\"\n    using left(1-3) unfolding finite_collection_presents_def by blast\n  have b: \"finite_collection_presents read B (enumeration_term ts)\"\n    using right(1-3) same unfolding finite_collection_presents_def by blast\n  show ?thesis by (rule finite_collection_presents_unique[OF a b unique])\nqed\n\nlemma data_collection_presents_elements:\n  assumes present: \"data_collection_presents read A t\"\n    and each: \"\\<And>a u. a\\<in>A \\<Longrightarrow> read a u \\<Longrightarrow> Q u\"\n  shows \"\\<exists>ts. t=data_list_term ts \\<and> (\\<forall>u\\<in>set ts. Q u)\"\nproof -\n  obtain xs ts where entries: \"set xs=A\" \"list_all2 read xs ts\" \"t=data_list_term ts\"\n    using present unfolding data_collection_presents_def by blast\n  have all: \"\\<forall>u\\<in>set ts. Q u\"\n  proof (intro ballI)\n    fix u assume \"u\\<in>set ts\"\n    then obtain i where index: \"i<length ts\" \"u=ts!i\" by (auto simp: in_set_conv_nth)\n    have bound: \"i<length xs\" using entries(2) index(1) list_all2_lengthD by metis\n    have inside: \"xs!i\\<in>A\" using nth_mem[OF bound] entries(1) by simp\n    have read: \"read (xs!i) (ts!i)\" by (rule list_all2_nthD[OF entries(2) bound])\n    show \"Q u\" using each[OF inside read] index(2) by simp\n  qed\n  show ?thesis using entries(3) all by blast\nqed\n\nlemma data_collection_presents_formed:\n  assumes present: \"data_collection_presents read A t\"\n    and each: \"\\<And>a u. a\\<in>A \\<Longrightarrow> read a u \\<Longrightarrow> term_formed u\"\n  shows \"term_formed t\"\nproof -\n  have \"\\<exists>ts. t=data_list_term ts \\<and> (\\<forall>u\\<in>set ts. term_formed u)\"\n    by (rule data_collection_presents_elements[OF present]) (rule each; assumption)\n  then show ?thesis by (auto simp: data_list_term_formed)\nqed\n\nlemma data_collection_presents_self_contained:\n  assumes present: \"data_collection_presents read A t\"\n    and each: \"\\<And>a u. a\\<in>A \\<Longrightarrow> read a u \\<Longrightarrow> self_contained_term u\"\n  shows \"self_contained_term t\"\nproof -\n  have \"\\<exists>ts. t=data_list_term ts \\<and> (\\<forall>u\\<in>set ts. self_contained_term u)\"\n    by (rule data_collection_presents_elements[OF present]) (rule each; assumption)\n  then show ?thesis by (auto simp: data_list_term_self_contained)\nqed\n\ntext \\<open>\n  These are derived profiles of the existing term and quotation relations.\n  Every payload-and-pair term has a complete native presentation with no\n  external slots; its recovery is independent of all outgoing bindings.\n  The data-list profile uses an empty payload as its terminator so that list\n  termination itself needs no target citation. Pair structure distinguishes\n  a cons cell from termination.\n\n  Collections include every actual member exactly once and admit every order\n  and every permitted presentation of each member. Unique recovery does not\n  equate their ordinary term values or assert order-invariant semantic truth.\n\\<close>\n\nend\n",
