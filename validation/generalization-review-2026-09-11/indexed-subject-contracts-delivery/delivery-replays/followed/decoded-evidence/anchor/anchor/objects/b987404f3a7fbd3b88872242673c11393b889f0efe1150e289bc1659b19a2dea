          "source": "theory Factor_Admission_Installation\n  imports Factor_Admission_Plans\nbegin\n\nsection \\<open>Construction retains every original definition\\<close>\n\ndefinition admission_extension :: \"(nat,nat,nat,nat) schema_system \\<Rightarrow>\n    (nat,nat,nat,nat) schema_system \\<Rightarrow> bool\" where\n  \"admission_extension P Q \\<longleftrightarrow> schema_system_formed P \\<and> schema_system_formed Q \\<and>\n    system_definitions P\\<subseteq>system_definitions Q \\<and>\n    systems_agree_on P Q (system_definitions P)\"\n\ndefinition admission_source :: \"(nat,nat,nat,nat) schema_system \\<Rightarrow> nat \\<Rightarrow> bool\" where\n  \"admission_source P n \\<longleftrightarrow> schema_system_formed P \\<and> (\\<forall>d\\<in>system_definitions P. d<n)\"\n\nlemma admission_source_weaken:\n  \"admission_source P n \\<Longrightarrow> n\\<le>m \\<Longrightarrow> admission_source P m\"\n  by (auto simp: admission_source_def)\n\nlemma admission_extension_refl:\n  \"schema_system_formed P \\<Longrightarrow> admission_extension P P\"\n  by (auto simp: admission_extension_def systems_agree_on_def)\n\nlemma admission_extension_trans:\n  \"admission_extension P Q \\<Longrightarrow> admission_extension Q R \\<Longrightarrow> admission_extension P R\"\n  by (auto simp: admission_extension_def systems_agree_on_def; blast)\n\nlemma admission_extension_meaning:\n  assumes extension: \"admission_extension P Q\" and member: \"d\\<in>system_definitions P\"\n  shows \"(d,t)\\<in>positive_meaning Q \\<longleftrightarrow> (d,t)\\<in>positive_meaning P\"\nproof -\n  have formed: \"schema_system_formed P\" \"schema_system_formed Q\"\n    and agree: \"systems_agree_on P Q (system_definitions P)\"\n    using extension by (auto simp: admission_extension_def)\n  have closed: \"system_dependency_closed P (system_definitions P)\"\n    using system_dependency_boundary(1)[OF formed(1)]\n    by (auto simp: system_dependency_closed_def)\n  show ?thesis using positive_meaning_dependency_locality[OF formed agree closed member] by blast\nqed\n\nlemma admission_extension_goal:\n  assumes \"admission_extension P Q\" \"admission_goal_sites g\\<subseteq>system_definitions P\"\n  shows \"admission_goal_holds (positive_meaning Q) g t \\<longleftrightarrow>\n    admission_goal_holds (positive_meaning P) g t\"\n  by (rule admission_goal_holds_agreement)\n    (use admission_extension_meaning[OF assms(1)] assms(2) in blast)\n\nlemma admission_fresh_extension:\n  assumes source: \"admission_source P n\"\n    and target: \"schema_system_formed (add_view_definition P n data_x C)\"\n  shows \"admission_source (add_view_definition P n data_x C) (Suc n)\"\n    and \"admission_extension P (add_view_definition P n data_x C)\"\n  using source target\n  by (auto simp: admission_source_def admission_extension_def systems_agree_on_def)\n\nlemma admission_fresh_call:\n  assumes \"admission_source P n\" \"schema_system_formed (add_view_definition P n data_x C)\"\n  shows \"schema_call_formed (add_view_definition P n data_x C) n t \\<longleftrightarrow> term_formed t\"\nproof -\n  have absent: \"(n,p)\\<notin>system_interfaces P\" for p\n    using assms(1) by (auto simp: admission_source_def system_definitions_def rel_dom_def)\n  show ?thesis by (simp only: schema_call_formed_def assms(2) added_view_interfaces)\n    (use absent in auto)\nqed\n\nlemma admission_fresh_family:\n  assumes \"admission_source P n\"\n  shows \"((n,c),S)\\<in>system_clauses (add_view_definition P n data_x C) \\<longleftrightarrow> (c,S)\\<in>C\"\nproof -\n  have absent: \"((n,c),S)\\<notin>system_clauses P\"\n    using assms by (auto simp: admission_source_def schema_system_formed_def)\n  show ?thesis by (simp add: absent)\nqed\n\nsection \\<open>Each installed constructor has its complete meaning\\<close>\n\nlocale install_admission_pair =\n  fixes P :: \"(nat,nat,nat,nat) schema_system\" and n a b :: nat\n  assumes source: \"admission_source P n\"\n    and first: \"a\\<in>system_definitions P\" and second: \"b\\<in>system_definitions P\"\nbegin\n\nabbreviation target where \"target \\<equiv> add_view_definition P n data_x {(0,admitted_pair_schema a b)}\"\n\nlemma formed: \"schema_system_formed target\"\n  by (rule add_recursive_definition_formed)\n    (use source first second in \\<open>auto simp: admission_source_def single_valued_def\\<close>)\n\nlemma extension: \"admission_extension P target\"\n  by (rule admission_fresh_extension(2)[OF source formed])\n\nlemma next_source: \"admission_source target (Suc n)\"\n  by (rule admission_fresh_extension(1)[OF source formed])\n\ninterpretation profile: admitted_pair_profile target n a b\nproof\n  show \"schema_system_formed target\" by (rule formed)\n  show \"((n,c),S)\\<in>system_clauses target \\<longleftrightarrow> c=0 \\<and> S=admitted_pair_schema a b\" for c S\n    by (simp only: admission_fresh_family[OF source]; auto)\n  show \"schema_call_formed target n t \\<longleftrightarrow> term_formed t\" for t\n    by (rule admission_fresh_call[OF source formed])\nqed\n\ntheorem exact:\n  \"(n,t)\\<in>positive_meaning target \\<longleftrightarrow>\n    (\\<exists>x y. t=Pair_Term x y \\<and> (a,x)\\<in>positive_meaning P \\<and> (b,y)\\<in>positive_meaning P)\"\n  by (simp only: profile.exact admission_extension_meaning[OF extension first]\n    admission_extension_meaning[OF extension second])\n\nend\n\nlocale install_admission_list =\n  fixes P :: \"(nat,nat,nat,nat) schema_system\" and n a :: nat\n  assumes source: \"admission_source P n\" and element: \"a\\<in>system_definitions P\"\nbegin\n\nabbreviation target where \"target \\<equiv> add_view_definition P n data_x (list_profile_clauses a n)\"\n\nlemma formed: \"schema_system_formed target\"\n  by (rule add_recursive_definition_formed)\n    (use source element in \\<open>auto simp: admission_source_def list_profile_clauses_def\n      data_list_nil_schema_def list_step_schema_def schema_formed_def single_valued_def\n      schema_dependencies_def rel_ran_image octets_formed_def\\<close>)\n\nlemma extension: \"admission_extension P target\"\n  by (rule admission_fresh_extension(2)[OF source formed])\n\nlemma next_source: \"admission_source target (Suc n)\"\n  by (rule admission_fresh_extension(1)[OF source formed])\n\ninterpretation profile: list_profile target a n\nproof\n  show \"schema_system_formed target\" by (rule formed)\n  show \"((n,c),S)\\<in>system_clauses target \\<longleftrightarrow> (c,S)\\<in>list_profile_clauses a n\" for c S\n    by (rule admission_fresh_family[OF source])\n  show \"schema_call_formed target n t \\<longleftrightarrow> term_formed t\" for t\n    by (rule admission_fresh_call[OF source formed])\nqed\n\ntheorem exact:\n  \"(n,t)\\<in>positive_meaning target \\<longleftrightarrow>\n    (\\<exists>xs. t=data_list_term xs \\<and> (\\<forall>x\\<in>set xs. (a,x)\\<in>positive_meaning P))\"\n  by (simp only: profile.exact admission_extension_meaning[OF extension element])\n\nend\n\nend\n",
