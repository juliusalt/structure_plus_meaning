          "source": "theory Factor_Premise_Construction\n  imports Factor_Prospective_Encoding Factor_Record_Construction Factor_Cloned_Transport\nbegin\n\nsection \\<open>Explicit references required by a body under construction\\<close>\n\ndefinition map_slot_keys :: \"(local_address \\<Rightarrow> local_address) \\<Rightarrow> (local_address \\<times> 'a) set \\<Rightarrow> (local_address \\<times> 'a) set\" where\n  \"map_slot_keys f M = (\\<lambda>(k,x). (f k,x)) ` M\"\n\nlemma map_slot_keys_domain:\n  \"rel_dom (map_slot_keys f M) = f ` rel_dom M\"\n  by (simp add: map_slot_keys_def pair_image_domain)\n\nlemma map_slot_keys_range:\n  \"rel_ran (map_slot_keys f M) = rel_ran M\"\n  by (auto simp: map_slot_keys_def rel_ran_def intro: rev_image_eqI)\n\nlemma map_slot_keys_identity [simp]: \"map_slot_keys id M = M\"\n  by (simp add: map_slot_keys_def)\n\nlemma map_slot_keys_member:\n  assumes \"(k,x) \\<in> M\"\n  shows \"(f k,x) \\<in> map_slot_keys f M\"\n  using imageI[OF assms, of \"\\<lambda>(k,x). (f k,x)\"] by (simp add: map_slot_keys_def)\n\ndefinition syntax_references ::\n  \"'u artifact_environment \\<Rightarrow> 'u \\<Rightarrow> (local_address \\<times> exact_artifact) set \\<Rightarrow>\n    (local_address \\<times> 'u definition_site) set \\<Rightarrow> bool\" where\n  \"syntax_references E u L C \\<longleftrightarrow>\n    (\\<forall>k R. (k,R) \\<in> L \\<longrightarrow> external_slot_values E u k = {R}) \\<and>\n    (\\<forall>k d. (k,d) \\<in> C \\<longrightarrow> binds_slot E u k (fst d) \\<and>\n      (\\<exists>R. artifact_at E (fst d) R \\<and> anchor_formed (R,snd d)))\"\n\nlemma syntax_references_mono:\n  assumes \"syntax_references E u L C\" \"A \\<subseteq> L\" \"B \\<subseteq> C\"\n  shows \"syntax_references E u A B\"\n  using assms unfolding syntax_references_def by blast\n\nlemma reference_literal_fibre:\n  assumes refs: \"syntax_references E u (map_slot_keys f L) C\" and sv: \"single_valued L\"\n    and member: \"k \\<in> rel_dom L\"\n  shows \"external_slot_values E u (f k) = {R. (k,R) \\<in> L}\"\nproof -\n  obtain R where entry: \"(k,R) \\<in> L\" using member by (auto simp: rel_dom_def)\n  have mapped: \"(f k,R) \\<in> map_slot_keys f L\" by (rule map_slot_keys_member[OF entry])\n  have literal: \"external_slot_values E u (f k) = {R}\"\n    using refs mapped unfolding syntax_references_def by blast\n  show ?thesis using literal single_valued_fibre[OF sv entry] by simp\nqed\n\nlemma reference_literal_values:\n  assumes \"syntax_references E u L C\" \"single_valued L\" \"k \\<in> rel_dom L\"\n  shows \"external_slot_values E u k = {R. (k,R) \\<in> L}\"\n  using reference_literal_fibre[of E u id L C k] assms by simp\n\nlemma cloned_syntax_references:\n  assumes ef: \"environment_formed E\" and fresh: \"z \\<notin> environment_uses E\"\n    and bounds: \"rel_dom L \\<union> rel_dom C \\<subseteq> rra_carrier (object_structure R)\"\n    and refs: \"syntax_references E u (map_slot_keys f L) (map_slot_keys f C)\"\n  shows \"syntax_references (clone_source_environment E u R f z) z L C\"\nproof -\n  have literals: \"\\<forall>k T. (k,T) \\<in> L \\<longrightarrow>\n    external_slot_values (clone_source_environment E u R f z) z k = {T}\"\n  proof (intro allI impI)\n    fix k T assume entry: \"(k,T) \\<in> L\"\n    have inside: \"k \\<in> rra_carrier (object_structure R)\" using bounds entry by (auto simp: rel_dom_def)\n    have mapped: \"(f k,T) \\<in> map_slot_keys f L\" by (rule map_slot_keys_member[OF entry])\n    have actual: \"external_slot_values E u (f k) = {T}\" using refs mapped unfolding syntax_references_def by blast\n    show \"external_slot_values (clone_source_environment E u R f z) z k = {T}\"\n      using clone_source_literal_values[OF ef fresh inside] actual by simp\n  qed\n  have callees: \"\\<forall>k d. (k,d) \\<in> C \\<longrightarrow>\n    binds_slot (clone_source_environment E u R f z) z k (fst d) \\<and>\n    (\\<exists>T. artifact_at (clone_source_environment E u R f z) (fst d) T \\<and> anchor_formed (T,snd d))\"\n  proof (intro allI impI)\n    fix k d assume entry: \"(k,d) \\<in> C\"\n    have key: \"k \\<in> rel_dom C\" by (rule rel_domI[OF entry])\n    have inside: \"k \\<in> rra_carrier (object_structure R)\" using bounds key by blast\n    have mapped: \"(f k,d) \\<in> map_slot_keys f C\" by (rule map_slot_keys_member[OF entry])\n    have actual: \"binds_slot E u (f k) (fst d)\" \"\\<exists>T. artifact_at E (fst d) T \\<and> anchor_formed (T,snd d)\"\n      using refs mapped unfolding syntax_references_def by blast+\n    show \"binds_slot (clone_source_environment E u R f z) z k (fst d) \\<and>\n      (\\<exists>T. artifact_at (clone_source_environment E u R f z) (fst d) T \\<and> anchor_formed (T,snd d))\"\n      using actual inside by (auto simp: clone_source_binding[OF ef fresh] clone_artifact_iff)\n  qed\n  show ?thesis using literals callees by (simp add: syntax_references_def)\nqed\n\ntype_synonym ('a,'u) premise_template = \"('u definition_site \\<times> 'a term_pattern) + 'a material_pattern\"\n\nfun template_variables :: \"('a,'u) premise_template \\<Rightarrow> 'a set\" where\n  \"template_variables (Inl (d,p)) = pattern_variables p\"\n| \"template_variables (Inr M) = material_variables M\"\n\nlemma template_variables_case:\n  \"template_variables t = (case t of Inl dp \\<Rightarrow> pattern_variables (snd dp)\n    | Inr M \\<Rightarrow> material_variables M)\"\n  by (cases t) (auto split: prod.splits)\n\nfun template_formed :: \"('a,'u) premise_template \\<Rightarrow> bool\" where\n  \"template_formed (Inl (d,p)) = (octets_formed (snd d) \\<and> pattern_formed p)\"\n| \"template_formed (Inr M) = material_pattern_formed M\"\n\nfun template_projection :: \"('a \\<Rightarrow> local_address) \\<Rightarrow> ('a,'u) premise_template \\<Rightarrow> 'u native_premise\" where\n  \"template_projection f (Inl (d,p)) = Inl (d,rename_pattern f p)\"\n| \"template_projection f (Inr M) = Inr (rename_material_pattern f M)\"\n\nfun templ