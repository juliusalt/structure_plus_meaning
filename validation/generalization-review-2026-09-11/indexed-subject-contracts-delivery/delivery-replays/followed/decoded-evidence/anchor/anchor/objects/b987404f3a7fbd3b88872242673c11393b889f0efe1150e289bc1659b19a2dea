          "source": "theory Factor_Observation_Scope_Clauses\n  imports Factor_Observation_Components Factor_Admitted_Context\nbegin\n\nsection \\<open>Each table row is checked against its declared scopes\\<close>\n\ndefinition observation_scope_row_schema :: \"(nat,nat,nat) factor_schema\" where\n  \"observation_scope_row_schema=data_rule\n    (Pattern_Pair (Pattern_Pair data_x (Pattern_Pair data_y data_z))\n      (Pattern_Pair data_w (Pattern_Pair (Pattern_Variable 4) (Pattern_Variable 5))))\n    {(0,303,Pattern_Pair data_x (Pattern_Variable 4)),\n     (1,303,Pattern_Pair data_y data_w),(2,2,Pattern_Variable 5)}\"\n\ndefinition observation_scopes_schema :: \"(nat,nat,nat) factor_schema\" where\n  \"observation_scopes_schema=data_rule (Pattern_Pair data_x (Pattern_Pair data_y data_z))\n    {(0,4,data_x),(1,47,Pattern_Pair data_z data_y)}\"\n\ndefinition observation_scope_clause_family :: \"nat \\<Rightarrow> (nat\\<times>(nat,nat,nat) factor_schema) set\" where\n  \"observation_scope_clause_family d=(if d=308 then {(0,observation_scope_row_schema)}\n    else if d=309 then context_list_clauses 308 309\n    else if d=310 then {(0,observation_scopes_schema)}\n    else if d=311 then {(0,admitted_context_schema 310 309)} else {})\"\n\ndefinition observation_scope_group_system :: \"(nat,nat,nat,nat) schema_system\" where\n  \"observation_scope_group_system=\\<lparr>system_interfaces={(308,data_x),(309,data_x),(310,data_x),(311,data_x)},\n    system_clauses={((308,0),observation_scope_row_schema),((309,0),context_list_nil_schema),\n      ((309,1),context_list_step_schema 308 309),\n      ((310,0),observation_scopes_schema),((311,0),admitted_context_schema 310 309)}\\<rparr>\"\n\nlemma observation_scope_group_definitions [simp]:\n  \"system_definitions observation_scope_group_system={308,309,310,311}\"\n  by (auto simp: observation_scope_group_system_def system_definitions_def rel_dom_def)\n\nlemma observation_scope_group_interfaces [simp]:\n  \"(d,p)\\<in>system_interfaces observation_scope_group_system \\<longleftrightarrow> d\\<in>{308,309,310,311} \\<and> p=data_x\"\n  by (auto simp: observation_scope_group_system_def)\n\nlemma observation_scope_group_clauses [simp]:\n  \"((d,c),S)\\<in>system_clauses observation_scope_group_system \\<longleftrightarrow>\n    d\\<in>{308,309,310,311} \\<and> (c,S)\\<in>observation_scope_clause_family d\"\n  by (auto simp: observation_scope_group_system_def observation_scope_clause_family_def context_list_clauses_def)\n\nlemma observation_scope_group_formed_over:\n  \"schema_system_formed_over {2,4,47,303} observation_scope_group_system\"\n  by (simp only: schema_system_formed_over_def observation_scope_group_definitions)\n    (auto simp: observation_scope_group_system_def observation_scope_row_schema_def observation_scopes_schema_def admitted_context_schema_def\n      context_list_clauses_def context_list_nil_schema_def context_list_step_schema_def\n      schema_formed_def schema_dependencies_def single_valued_def rel_dom_def rel_ran_def octets_formed_def)\n\nlemma observation_scope_external_dependencies:\n  \"system_external_dependencies observation_scope_group_system={2,4,47,303}\"\n  by (simp only: system_external_dependencies_clauses observation_scope_group_definitions)\n    (auto simp: observation_scope_group_system_def observation_scope_row_schema_def observation_scopes_schema_def admitted_context_schema_def\n      context_list_clauses_def context_list_nil_schema_def context_list_step_schema_def\n      schema_dependencies_def rel_ran_image)\n\ndefinition observation_scope_base_system :: \"(nat,nat,nat,nat) schema_system\" where\n  \"observation_scope_base_system=rooted_system observation_collection_system\n    (system_external_dependencies observation_scope_group_system)\"\n\nlemma observation_scope_base_formed [simp]: \"schema_system_formed observation_scope_base_system\"\n  unfolding observation_scope_base_system_def by (rule rooted_system_formed[OF observation_collection_formed])\n\nlemma observation_scope_base_subdomain:\n  \"system_definitions observation_scope_base_system\\<subseteq>system_definitions observation_collection_system\"\n  unfolding observation_scope_base_system_def by (rule rooted_system_subdomain)\n\nlemma observation_scope_base_roots:\n  \"{2,4,47,303}\\<subseteq>system_definitions observation_scope_base_system\"\n  unfolding observation_scope_base_system_def observation_scope_external_dependencies\n  by (rule rooted_system_roots[OF observation_collection_formed])\n    (use observation_base_roots data_set_comparison_base_roots in auto)\n\nlemma observation_scope_base_least:\n  assumes \"{2,4,47,303}\\<subseteq>U\" \"system_dependency_closed observation_collection_system U\"\n  shows \"system_definitions observation_scope_base_system\\<subseteq>U\"\n  unfolding observation_scope_base_system_def observation_scope_external_dependencies\n  by (rule rooted_system_least[OF observation_collection_formed _ assms])\n    (use observation_base_roots data_set_comparison_base_roots in auto)\n\nlemma observation_scope_base_call:\n  \"schema_call_formed observation_scope_base_system d t \\<longleftrightarrow>\n    d\\<in>system_definitions observation_scope_base_system \\<and> term_formed t\"\n  unfolding observation_scope_base_system_def\n  by (rule rooted_system_variable_calls[OF observation_collection_formed observation_collection_call])\n\ninterpretation observation_scope_group:\n  positive_definition_group observation_scope_base_system observation_scope_group_system\nproof (rule positive_definition_group.intro)\n  show \"schema_system_formed observation_scope_base_system\" by simp\n  show \"schema_system_formed_over (system_definitions observation_scope_base_system) observation_scope_group_system\"\n    by (rule schema_system_formed_over_mono[OF observation_scope_group_formed_over observation_scope_base_roots])\n  have boundary: \"system_definitions observation_collection_system\\<inter>{308,309,310,311}={}\"\n    using observation_base_subdomain data_set_comparison_base_subdomain by auto\n  show \"system_definitions observation_scope_base_system\\<inter>system_definitions observation_scope_group_system={}\"\n    using boundary observation_scope_base_subdomain by auto\nqed\n\ndefinition observation_scope_system :: \"(nat,nat,nat,nat) schema_system\" where\n  \"observation_scope_system=system_union observation_scope_base_system observation_scope_group_system\"\n\nlemma observation_scope_system_formed [simp]: \"schema_system_formed observation_scope_system\"\n  using observation_scope_group.formed by (simp only: observation_scope_system_def)\n\nlemma observation_scope_definitions [simp]:\n  \"system_definitions observation_scope_system=system_definitions observation_scope_base_system\\<union>{308,309,310,311}\"\n  by (simp add: observation_scope_system_def)\n\nlemma observation_scope_call:\n  \"schema_call_formed observation_scope_system d t \\<longleftrightarrow>\n    d\\<in>system_definitions observation_scope_system \\<and> term_formed t\"\n  unfolding observation_scope_system_def\n  by (rule observation_scope_group.variable_calls[where D=\"{308,309,310,311}\" and a=0,\n    OF observation_scope_base_call]) auto\n\nlemma observation_scope_clause:\n  assumes \"d\\<in>{308,309,310,311}\"\n  shows \"((d,c),S)\\<in>system_clauses observation_scope_system \\<longleftrightarrow>\n    (c,S)\\<in>observation_scope_clause_family d\"\n  using observation_scope_group.group_clauses[of d c S] assms\n  by (simp only: observation_scope_system_def observation_scope_group_clauses\n    observation_scope_group_definitions; blast)\n\nlemma observation_scope_base_meaning:\n  assumes \"d\\<in>{2,4,47,303}\"\n  shows \"(d,t)\\<in>positive_meaning observation_scope_system \\<longleftrightarrow>\n    (d,t)\\<in>positive_meaning observation_collection_system\"\nproof -\n  have member: \"d\\<in>system_definitions observation_scope_base_system\"\n    using observation_scope_base_roots assms by blast\n  show ?thesis using observation_scope_group.old_meaning[OF member, of t]\n    rooted_system_meaning_at[OF observation_collection_formed member[unfolded observation_scope_base_system_def], of t]\n    by (simp only: observation_scope_system_def observation_scope_base_system_def)\nqed\n\nend\n",
