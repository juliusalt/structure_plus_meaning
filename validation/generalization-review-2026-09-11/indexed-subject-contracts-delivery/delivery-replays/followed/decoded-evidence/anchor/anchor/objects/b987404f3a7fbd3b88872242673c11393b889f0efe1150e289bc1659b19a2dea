          "source": "theory Inference_Development\n  imports Inference_Closure Bootstrap_Finite_Closure\nbegin\n\nsection \\<open>A local premise bound measures conditional capability\\<close>\n\ndefinition bounded_inferences ::\n  \"nat \\<Rightarrow> ('a \\<Rightarrow> ('i \\<times> 'a) set \\<Rightarrow> bool) \\<Rightarrow>\n    'a \\<Rightarrow> ('i \\<times> 'a) set \\<Rightarrow> bool\" where\n  \"bounded_inferences k R a H \\<longleftrightarrow> R a H \\<and> card H\\<le>k\"\n\ndefinition inference_capability ::\n  \"nat \\<Rightarrow> ('a \\<Rightarrow> ('i \\<times> 'a) set \\<Rightarrow> bool) \\<Rightarrow>\n    ('a set \\<times> 'a) set\" where\n  \"inference_capability k R={(K,a). a\\<in>inference_closure (bounded_inferences k R) K}\"\n\nlemma inference_capability_comparison:\n  \"inference_capability k R\\<subseteq>inference_capability l S \\<longleftrightarrow>\n    inference_refines (bounded_inferences k R) (bounded_inferences l S)\"\n  by (auto simp: inference_capability_def inference_refines_def)\n\nlemma bounded_inferences_sound:\n  \"inference_sound T R \\<Longrightarrow> inference_sound T (bounded_inferences k R)\"\n  by (auto simp: inference_sound_def bounded_inferences_def)\n\ntheorem bounded_inferences_complete:\n  assumes \"\\<And>a H. finite H \\<Longrightarrow> single_valued H \\<Longrightarrow> R a H \\<Longrightarrow> card H\\<le>k\"\n  shows \"inference_closure (bounded_inferences k R) K=inference_closure R K\"\nproof -\n  have first: \"inference_refines (bounded_inferences k R) R\"\n    by (rule inference_refines_by_inclusion) (simp add: bounded_inferences_def)\n  have second: \"inference_refines R (bounded_inferences k R)\"\n    unfolding inference_refines_iff_rules\n  proof (intro allI impI)\n    fix a H\n    assume fin: \"finite H\" and formed: \"single_valued H\" and source: \"R a H\"\n    have bounded: \"bounded_inferences k R a H\"\n      using source assms[OF fin formed source] by (simp add: bounded_inferences_def)\n    show \"a\\<in>inference_closure (bounded_inferences k R) (rel_ran H)\"\n      by (rule inference_closure_step[where H=H and R=\"bounded_inferences k R\"])\n        (rule fin, rule formed, rule bounded, rule inference_closure_seed)\n  qed\n  show ?thesis using first second by (auto simp: inference_refines_def)\nqed\n\ntheorem larger_local_bound_preserves_capability:\n  assumes \"k\\<le>l\"\n  shows \"inference_capability k R\\<subseteq>inference_capability l R\"\n  unfolding inference_capability_comparison\n  by (rule inference_refines_by_inclusion)\n    (use assms in \\<open>auto simp: bounded_inferences_def\\<close>)\n\nsection \\<open>Selection and stopping quantify their complete candidate scope\\<close>\n\ndefinition maximal_candidate ::\n  \"'c set \\<Rightarrow> ('c \\<Rightarrow> 'a set) \\<Rightarrow> 'c \\<Rightarrow> bool\" where\n  \"maximal_candidate C ability c \\<longleftrightarrow>\n    c\\<in>C \\<and> (\\<forall>d\\<in>C. ability c\\<subseteq>ability d \\<longrightarrow> ability d\\<subseteq>ability c)\"\n\ndefinition complete_candidate ::\n  \"'c set \\<Rightarrow> ('c \\<Rightarrow> 'a set) \\<Rightarrow> 'c \\<Rightarrow> bool\" where\n  \"complete_candidate C ability c \\<longleftrightarrow>\n    c\\<in>C \\<and> (\\<forall>d\\<in>C. ability d\\<subseteq>ability c)\"\n\ndefinition candidate_cover ::\n  \"'c set \\<Rightarrow> ('c \\<Rightarrow> 'a set) \\<Rightarrow> 'c set \\<Rightarrow> bool\" where\n  \"candidate_cover C ability F \\<longleftrightarrow>\n    F\\<subseteq>C \\<and> (\\<forall>c\\<in>C. \\<exists>d\\<in>F. ability c\\<subseteq>ability d)\"\n\ntheorem finite_candidate_selection:\n  assumes \"finite C\" \"c\\<in>C\"\n  shows \"\\<exists>d. maximal_candidate C ability d \\<and> ability c\\<subseteq>ability d\"\nproof -\n  have fin: \"finite (ability ` C)\" by (rule finite_imageI[OF assms(1)])\n  have start: \"ability c\\<in>ability ` C\" by (rule imageI[OF assms(2)])\n  obtain M where member: \"M\\<in>ability ` C\" and improves: \"ability c\\<subseteq>M\"\n    and maximal: \"\\<forall>N\\<in>ability ` C. M\\<subseteq>N \\<longrightarrow> M=N\"\n    using finite_has_maximal2[OF fin start] by blast\n  obtain d where d: \"d\\<in>C\" \"ability d=M\" using member by blast\n  show ?thesis\n    by (rule exI[of _ d]) (use d improves maximal in \\<open>auto simp: maximal_candidate_def\\<close>)\nqed\n\nlemma complete_candidate_maximal:\n  \"complete_candidate C ability c \\<Longrightarrow> maximal_candidate C ability c\"\n  by (auto simp: complete_candidate_def maximal_candidate_def)\n\ntheorem complete_candidate_from_cover:\n  assumes \"candidate_cover C ability F\"\n  shows \"complete_candidate C ability c \\<longleftrightarrow>\n    c\\<in>C \\<and> (\\<forall>d\\<in>F. ability d\\<subseteq>ability c)\"\n  using assms by (auto simp: candidate_cover_def complete_candidate_def; blast)\n\ntheorem maximal_candidate_from_cover:\n  assumes \"candidate_cover C ability F\"\n  shows \"maximal_candidate C ability c \\<longleftrightarrow>\n    c\\<in>C \\<and> (\\<forall>d\\<in>F. ability c\\<subseteq>ability d \\<longrightarrow> ability d\\<subseteq>ability c)\"\n  using assms by (auto simp: candidate_cover_def maximal_candidate_def; blast)\n\ndefinition development_scope :: \"('c \\<times> 'c) set \\<Rightarrow> 'c \\<Rightarrow> 'c set\" where\n  \"development_scope E c={d. (c,d)\\<in>E\\<^sup>*}\"\n\ntheorem development_scope_bound:\n  assumes initial: \"c\\<in>C\"\n    and closed: \"\\<And>a b. a\\<in>C \\<Longrightarrow> (a,b)\\<in>E \\<Longrightarrow> b\\<in>C\"\n  shows \"development_scope E c\\<subseteq>C\"\nproof\n  fix d assume \"d\\<in>development_scope E c\"\n  then have \"(c,d)\\<in>E\\<^sup>*\" by (simp add: development_scope_def)\n  then show \"d\\<in>C\"\n  proof (induction rule: rtrancl_induct)\n    case base\n    show ?case by (rule initial)\n  next\n    case (step a b)\n    show ?case by (rule closed[OF step.IH step.hyps(2)])\n  qed\nqed\n\ntheorem development_scope_exact:\n  assumes \"c\\<in>C\" \"\\<And>a b. a\\<in>C \\<Longrightarrow> (a,b)\\<in>E \\<Longrightarrow> b\\<in>C\"\n    \"C\\<subseteq>development_scope E c\"\n  shows \"development_scope E c=C\"\nproof (rule equalityI)\n  show \"development_scope E c\\<subseteq>C\"\n    by (rule development_scope_bound[OF assms(1)]) (rule assms(2))\n  show \"C\\<subseteq>development_scope E c\" by (rule assms(3))\nqed\n\ntheorem finite_development_scope:\n  \"development_scope (fset E) c=fset (finite_reachable_outputs id E c)\"\nproof (rule set_eqI)\n  fix d\n  have right: \"d\\<in>fset (finite_reachable_outputs id E c) \\<longleftrightarrow>\n      d=c \\<or> (\\<exists>a. (a,d)\\<in>fset E \\<and> (c,a)\\<in>(fset E)\\<^sup>*)\"\n    by (simp add: finite_reachable_outputs_member finite_transition_keys_def)\n  show \"d\\<in>development_scope (fset E) c \\<longleftrightarrow> d\\<in>fset (finite_reachable_outputs id E c)\"\n    unfolding right development_scope_def\n    by (auto elim: rtranclE intro: rtrancl.rtrancl_into_rtrancl)\nqed\n\nsection \\<open>A semantic upper bound can justify stopping over infinitely many methods\\<close>\n\ndefinition model_consequences :: \"'a set set \\<Rightarrow> 'a set \\<Rightarrow> 'a set\" where\n  \"model_consequences M K={a. \\<forall>T\\<in>M. K\\<subseteq>T \\<longrightarrow> a\\<in>T}\"\n\ntheorem model_consequences_bound:\n  assumes \"\\<And>T. T\\<in>M \\<Longrightarrow> inference_sound (\\<lambda>a. a\\<in>T) R\"\n  shows \"inference_closure R K\\<subseteq>model_consequences M K\"\n  using inference_closure_sound assms by (auto simp: model_consequences_def; blast)\n\ntheorem model_complete_method_dominates:\n  assumes sound: \"\\<And>T. T\\<in>M \\<Longrightarrow> inference_sound (\\<lambda>a. a\\<in>T) R\"\n    and complete: \"\\<And>K. inference_closure S K=model_consequences M K\"\n  shows \"inference_refines R S\"\n  using model_consequences_bound[OF sound] complete by (simp add: inference_refines_def)\n\ntheorem model_complete_candidate:\n  assumes member: \"R\\<in>C\"\n    and sound: \"\\<And>S T. S\\<in>C \\<Longrightarrow> T\\<in>M \\<Longrightarrow> inference_sound (\\<lambda>a. a\\<in>T) S\"\n    and complete: \"\\<And>K. inference_closure (bounded_inferences k R) K=model_consequences M K\"\n  shows \"complete_candidate C (inference_capability k) R\"\nproof -\n  have comparison: \"inference_refines (bounded_inferences k S) (bounded_inferences k R)\" if \"S\\<in>C\" for S\n    by (rule model_complete_method_dominates[OF _ complete])\n      (use sound[OF that] bounded_inferences_sound in blast)\n  show ?thesis using member comparison\n    by (simp add: complete_candidate_def inference_capability_comparison)\nqed\n\nsection \\<open>Limits of stopping claims\\<close>\n\ntheorem an_immediate_plateau_can_hide_improvement:\n  defines \"E \\<equiv> {(0::nat,1),(1,2)}\"\n    and \"ability \\<equiv> (\\<lambda>n::nat. if n=2 then {()} else {})\"\n  shows \"(\\<forall>d. (0,d)\\<in>E \\<longrightarrow> ability d=ability 0) \\<and>\n    2\\<in>development_scope E 0 \\<and> ability 0\\<subset>ability 2\"\nproof -\n  have path: \"(0,2)\\<in>E\\<^sup>*\"\n  proof -\n    have \"(0,1)\\<in>E\" \"(1,2)\\<in>E\" by (simp_all add: E_def)\n    then show ?thesis by (meson r_into_rtrancl rtrancl_trans)\n  qed\n  show ?thesis using path by (auto simp: E_def ability_def development_scope_def)\nqed\n\ntheorem a_complete_candidate_can_leave_obligations:\n  defines \"R \\<equiv> (\\<lambda>_::bool. \\<lambda>_::(unit\\<times>bool) set. False)\"\n  shows \"complete_candidate {R} (inference_capability 2) R \\<and>\n    remaining_obligations (inference_closure R {}) {((),False)}={((),False)}\"\nproof -\n  have closed: \"inference_closure R {}={}\"\n    by (rule unsupported_inference_cycle) (simp add: R_def)\n  show ?thesis by (auto simp: complete_candidate_def closed remaining_obligations_def)\nqed\n\ntheorem an_unbounded_scope_need_not_have_a_maximal_candidate:\n  \"\\<not>(\\<exists>n::nat. maximal_candidate UNIV (\\<lambda>n. {..<n}) n)\"\nproof\n  assume \"\\<exists>n::nat. maximal_candidate UNIV (\\<lambda>n. {..<n}) n\"\n  then obtain n :: nat where maximal: \"maximal_candidate UNIV (\\<lambda>n. {..<n}) n\" by blast\n  have successor: \"{..<n}\\<subseteq>{..<Suc n} \\<longrightarrow> {..<Suc n}\\<subseteq>{..<n}\"\n    using maximal unfolding maximal_candidate_def by blast\n  show False using successor by auto\nqed\n\ntext \\<open>\n  A candidate can be supplied externally. Its capability is the set of\n  conditional uses justified by its finite rules within a declared immediate\n  premise bound. Inclusion preserves every earlier use; strict inclusion\n  supplies an actual new use. It does not attach a score to the candidate's name.\n\n  A maximal candidate has no dominating alternative in the declared scope;\n  incomparable alternatives can remain. A complete candidate covers every\n  alternative's capability. A smaller frontier supports either claim only\n  through a proved dominating cover. Reachability includes paths through\n  plateaus. Finite supplied edge relations have an exact finite closure, but\n  their completeness for an intended search relation is a separate condition.\n\n  Model completeness supplies a different stopping proof over an infinite\n  class of sound methods. Neither stopping criterion proves an unrelated goal,\n  and no theorem promises a maximal candidate in an arbitrary infinite scope.\n  The premise bound counts explicit immediate interfaces. It does not bound\n  the complexity hidden in an undeveloped condition or in choosing the models,\n  intended scope, or candidate. Those choices can themselves become inputs to\n  the same obligation-reduction account.\n\\<close>\n\nend\n",
