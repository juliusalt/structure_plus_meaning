          "source": "theory Factor_Investigation_Input_Contracts\n  imports Factor_Investigation_Input_Clauses Factor_Scope_Computation_Contracts\nbegin\n\nsection \\<open>Existing component classes determine every native input field\\<close>\n\nlemma investigation_input_components:\n  \"(2,t)\\<in>positive_meaning investigation_input_system \\<longleftrightarrow> data_term_boundary t\"\n  \"(311,t)\\<in>positive_meaning investigation_input_system \\<longleftrightarrow> (311,t)\\<in>positive_meaning observation_scope_system\"\n  using investigation_input_base_meaning[of 2 t] investigation_input_base_meaning[of 311 t]\n    observation_scope_components(1)[of t] by auto\n\ninterpretation investigation_input_pair: admitted_pair_profile investigation_input_system 336 2 2\n  by (unfold_locales) (auto simp: investigation_input_clause investigation_input_clause_family_def\n    investigation_input_call admitted_data_pair_schema)\n\ninterpretation investigation_input_pairs: list_profile investigation_input_system 336 337\n  by (unfold_locales) (auto simp: investigation_input_clause investigation_input_clause_family_def investigation_input_call)\n\ninterpretation investigation_input_fields: admitted_pair_profile investigation_input_system 338 311 337\n  by (unfold_locales) (auto simp: investigation_input_clause investigation_input_clause_family_def investigation_input_call)\n\nlemma investigation_input_data_class:\n  \"presentation_class data_term_presents data_term_boundary (\\<lambda>t. (2,t)\\<in>positive_meaning investigation_input_system)\"\n  by (simp only: investigation_input_components; rule data_term_class)\n\nlemma investigation_input_pair_class:\n  \"presentation_class data_pair_presents data_pair_domain (\\<lambda>t. (336,t)\\<in>positive_meaning investigation_input_system)\"\nproof -\n  have domain: \"(\\<lambda>z. data_term_boundary (fst z) \\<and> data_term_boundary (snd z))=data_pair_domain\"\n    by (rule ext) (auto split: prod.splits)\n  show ?thesis using investigation_input_pair.presentation_class[OF investigation_input_data_class investigation_input_data_class]\n    by (simp only: domain)\nqed\n\nlemma investigation_input_pairs_class:\n  \"presentation_class data_pair_finite_set_presents data_pair_finite_set_domain\n    (\\<lambda>t. (337,t)\\<in>positive_meaning investigation_input_system)\"\n  by (rule investigation_input_pairs.finite_set_class[OF investigation_input_pair_class])\n\nlemma investigation_input_scope_class:\n  \"presentation_class observation_scope_presents observation_scope_domain\n    (\\<lambda>t. (311,t)\\<in>positive_meaning investigation_input_system)\"\n  by (simp only: investigation_input_components observation_scope_admitted_class; rule observation_scope_class)\n\ntheorem investigation_input_native_class:\n  \"presentation_class investigation_input_presents investigation_input_domain\n    (\\<lambda>t. (338,t)\\<in>positive_meaning investigation_input_system)\"\n  by (rule investigation_input_fields.presentation_class[OF investigation_input_scope_class investigation_input_pairs_class])\n\ntheorem investigation_input_exact:\n  \"(338,t)\\<in>positive_meaning investigation_input_system \\<longleftrightarrow> (\\<exists>z. investigation_input_presents z t)\"\n  by (rule presentation_class.admissible_iff[OF investigation_input_native_class])\n\ntheorem investigation_input_presented:\n  \"(338,t)\\<in>positive_meaning investigation_input_system \\<longleftrightarrow>\n    presented_predicate investigation_input_record_presents investigation_input_domain t\"\n  by (simp only: investigation_input_exact investigation_input_restriction presented_predicate_def; blast)\n\ninterpretation investigation_input_records: presentation_class investigation_input_record_presents\n  investigation_input_record_domain \"\\<lambda>p. \\<exists>z. investigation_input_record_presents z p\"\n  by (rule investigation_input_record_class)\n\ncorollary investigation_input_at:\n  assumes \"investigation_input_record_presents z p\"\n  shows \"(338,p)\\<in>positive_meaning investigation_input_system \\<longleftrightarrow> investigation_input_domain z\"\n  by (simp only: investigation_input_presented investigation_input_records.predicate_at[where property=investigation_input_domain, OF assms])\n\ncorollary investigation_input_invariance:\n  assumes \"investigation_input_record_presents z p\" \"investigation_input_record_presents z q\"\n  shows \"((338,p)\\<in>positive_meaning investigation_input_system)=((338,q)\\<in>positive_meaning investigation_input_system)\"\n  by (simp only: investigation_input_at[OF assms(1)] investigation_input_at[OF assms(2)])\n\nsection \\<open>Complete enumerations expose the original whole-input boundary\\<close>\n\nlemma investigation_input_pairs_encoded:\n  \"(337,data_list_term (map data_pair_term relation))\\<in>positive_meaning investigation_input_system \\<longleftrightarrow>\n    (\\<forall>(c,d)\\<in>set relation. data_elements [c,d])\"\n  by (simp only: investigation_input_pairs.lists)\n    (auto simp: investigation_input_pair.at_pair investigation_input_components split: prod.splits)\n\nlemma investigation_input_encoded:\n  \"(338,Pair_Term (observation_scope_argument (data_list_term C) (data_list_term U) (data_list_term F)\n      (data_list_term (map observation_row_term rows))) (data_list_term (map data_pair_term relation)))\n      \\<in>positive_meaning investigation_input_system \\<longleftrightarrow>\n    investigation_input_subject_formed (fset_of_list C) (fset_of_list U) (fset_of_list F) (fset_of_list rows) (fset_of_list relation)\"\n  by (simp only: investigation_input_fields.at_pair investigation_input_components observation_scope_encoded\n    investigation_input_pairs_encoded investigation_input_subject_lists)\n\nlemma investigation_input_enumerated:\n  assumes \"investigation_input_presents z p\"\n  obtains C U F rows relation where\n    \"data_elements C\" \"data_elements U\" \"data_elements F\" \"observation_rows_data rows\"\n    \"\\<forall>(c,d)\\<in>set relation. data_elements [c,d]\"\n    \"z=(((fset_of_list C,(fset_of_list U,fset_of_list F)),fset_of_list rows),fset_of_list relation)\"\n    \"p=Pair_Term (observation_scope_argument (data_list_term C) (data_list_term U) (data_list_term F)\n      (data_list_term (map observation_row_term rows))) (data_list_term (map data_pair_term relation))\"\n    \"investigation_input_subject_formed (fset_of_list C) (fset_of_list U) (fset_of_list F) (fset_of_list rows) (fset_of_list relation)\"\nproof -\n  obtain a b where fields: \"observation_scope_presents (fst z) a\" \"data_pair_finite_set_presents (snd z) b\"\n    \"p=Pair_Term a b\" using assms by (simp only: factor_pair_presents_def) blast\n  obtain C U F rows where scope: \"data_elements C\" \"data_elements U\" \"data_elements F\" \"observation_rows_data rows\"\n    \"observation_scope_subject_formed (fset_of_list C) (fset_of_list U) (fset_of_list F) (fset_of_list rows)\"\n    \"fst z=((fset_of_list C,(fset_of_list U,fset_of_list F)),fset_of_list rows)\"\n    \"a=observation_scope_argument (data_list_term C) (data_list_term U) (data_list_term F)\n      (data_list_term (map observation_row_term rows))\"\n    by (rule observation_scope_enumerated[OF fields(1)]) blast\n  obtain relation where comparison: \"\\<forall>(c,d)\\<in>set relation. data_elements [c,d]\"\n    \"fset_of_list relation=snd z\" \"b=data_list_term (map data_pair_term relation)\"\n    using fields(2) by (simp only: data_pair_finite_set_fields) blast\n  have subject: \"z=(((fset_of_list C,(fset_of_list U,fset_of_list F)),fset_of_list rows),fset_of_list relation)\"\n    using scope(6) comparison(2) by (cases z) auto\n  have boundary: \"investigation_input_subject_formed (fset_of_list C) (fset_of_list U) (fset_of_list F) (fset_of_list rows) (fset_of_list relation)\"\n    using scope(5) comparison(1) by (simp only: investigation_input_subject_lists)\n  show ?thesis by (rule that[OF scope(1-4) comparison(1) subject _ boundary])\n    (simp only: fields(3) scope(7) comparison(3))\nqed\n\nsection \\<open>The whole admitted input has a quotation and one fixed native checker\\<close>\n\ntheorem investigation_input_complete_quotation:\n  assumes \"(338,t)\\<in>positive_meaning investigation_input_system\"\n  shows \"complete_data_quoted_at (term_syntax t) [] t\"\nproof -\n  obtain p q where parts: \"t=Pair_Term p q\" \"(311,p)\\<in>positive_meaning observation_scope_system\"\n    \"(337,q)\\<in>positive_meaning investigation_input_system\"\n    using assms by (simp only: investigation_input_fields.exact investigation_input_components) blast\n  have source: \"complete_data_quoted_at (term_syntax p) [] p\" by (rule observation_scope_complete_quotation[OF parts(2)])\n  have target: \"data_term_boundary q\"\n    using parts(3) presentation_class.admitted[OF investigation_input_pairs_class]\n      data_pair_finite_set_presented_data by blast\n  have data: \"term_formed t\" \"self_contained_term t\"\n    using complete_data_quotation_formed[OF source] target by (auto simp only: parts(1) term_formed.simps self_contained_term.simps)\n  show ?thesis using complete_data_quotation_total[OF data] by blast\nqed\n\ntheorem native_investigation_input:\n  \"\\<exists>E :: local_address option artifact_environment. \\<exists>pu Q g.\n    closed_native_package_at E pu [] Q \\<and> native_package_environment E pu []=E \\<and>\n    inj_on g {338::nat} \\<and>\n    (\\<forall>d\\<in>{338}. \\<forall>t. term_formed t \\<longrightarrow>\n      (\\<exists>F au I K. environment_formed F \\<and> environment_included E F \\<and> au\\<notin>environment_uses E \\<and>\n        native_package_at F pu [] Q \\<and> native_application_at F au [] (g d) t I K \\<and>\n        native_package_environment F pu []=E \\<and> native_application_formed F pu [] au [] \\<and>\n        (native_positive_holds F pu [] au [] \\<longleftrightarrow> (\\<exists>z. investigation_input_presents z t)) \\<and>\n        (\\<forall>v\\<in>environment_uses E. \\<forall>R. artifact_at F v R \\<longleftrightarrow> artifact_at E v R) \\<and>\n        (\\<forall>v\\<in>environment_uses E. \\<forall>k w. binds_slot F v k w \\<longleftrightarrow> binds_slot E v k w)))\"\nproof -\n  have selected: \"{338}\\<subseteq>system_definitions investigation_input_system\" by auto\n  have calls: \"schema_call_formed investigation_input_system d t \\<longleftrightarrow> term_formed t\"\n    if \"d\\<in>{338}\" for d t using investigation_input_call[of d t] selected that by blast\n  have result: \"(d,t)\\<in>positive_meaning investigation_input_system \\<longleftrightarrow> (\\<exists>z. investigation_input_presents z t)\"\n    if \"d\\<in>{338}\" for d t using that by (simp only: singleton_iff investigation_input_exact; blast)\n  show ?thesis by (rule compiled_exact_operations[OF investigation_input_system_formed selected calls result])\nqed\n\ntext \\<open>\n  Native field and list admission consume complete locally owned classes.\n  The resulting predicate is exact on every term. On the broader class of\n  complete data records it preserves both admission and refusal, including\n  failed facet inclusion or observation scope. Comparison endpoints retain\n  their data boundary without an additional candidate-scope restriction.\n  The whole query is quoted, and one closed native package precedes every\n  future formed input. Mathematical-proof checking remains a further task.\n\\<close>\n\nend\n",
