          "theory": "Factor_Observation_Presentations",
          "source": "theory Factor_Observation_Presentations\n  imports Factor_Observation_Admission Factor_Data_Set_Comparison_Contracts Presentation_Function_Witnesses\n    Factor_Data_Term_Presentations\nbegin\n\nsection \\<open>Finite observation subjects use the existing complete class constructions\\<close>\n\nabbreviation observation_datum :: \"factor_term \\<Rightarrow> bool\" where\n  \"observation_datum x \\<equiv> data_term_boundary x\"\n\nabbreviation observation_datum_presents :: \"factor_term \\<Rightarrow> factor_term \\<Rightarrow> bool\" where\n  \"observation_datum_presents x p \\<equiv> data_term_presents x p\"\n\nabbreviation observation_value_presents where\n  \"observation_value_presents \\<equiv> data_pair_presents\"\n\nabbreviation observation_row_presents where\n  \"observation_row_presents \\<equiv> factor_pair_presents observation_datum_presents\n    (factor_pair_presents observation_datum_presents observation_datum_presents)\"\n\nabbreviation observation_facets_presents where\n  \"observation_facets_presents \\<equiv> data_list_fset_presents observation_datum_presents\"\n\nabbreviation observation_values_presents where\n  \"observation_values_presents \\<equiv> data_pair_finite_set_presents\"\n\nabbreviation observation_table_presents where\n  \"observation_table_presents \\<equiv> data_list_fset_presents observation_row_presents\"\n\nabbreviation observation_context_presents where\n  \"observation_context_presents R \\<equiv> factor_pair_presents observation_facets_presents R\"\n\nabbreviation observation_query_presents where\n  \"observation_query_presents R z p \\<equiv>\n    observation_context_presents R (fst z) (fst p) \\<and> observation_table_presents (snd z) (snd p)\"\n\nabbreviation observation_facets_domain where\n  \"observation_facets_domain F \\<equiv> \\<forall>f\\<in>fset F. observation_datum f\"\n\nabbreviation observation_values_domain where\n  \"observation_values_domain V \\<equiv> \\<forall>(f,w)\\<in>fset V. data_elements [f,w]\"\n\nabbreviation observation_table_domain where\n  \"observation_table_domain T \\<equiv> \\<forall>(f,c,w)\\<in>fset T. data_elements [f,c,w]\"\n\nabbreviation observation_query_domain where\n  \"observation_query_domain D z \\<equiv> observation_facets_domain (fst (fst z)) \\<and>\n    D (snd (fst z)) \\<and> observation_table_domain (snd z)\"\n\nlemma observation_datum_class:\n  \"presentation_class observation_datum_presents observation_datum observation_datum\"\n  by (rule data_term_class)\n\nlemma observation_value_class:\n  \"presentation_class observation_value_presents (\\<lambda>(f,w). data_elements [f,w])\n    (\\<lambda>p. \\<exists>f w. observation_value_presents (f,w) p)\"\n  using data_pair_class by (simp only: split_paired_Ex)\n\nlemma observation_row_class:\n  \"presentation_class observation_row_presents (\\<lambda>(f,c,w). data_elements [f,c,w]) observation_row_admitted\"\n  using factor_pair_class[OF observation_datum_class observation_value_class]\n  by (auto simp: presentation_class_def factor_pair_presents_def split: prod.splits)\n\nlemma observation_facets_class:\n  \"presentation_class observation_facets_presents observation_facets_domain\n    (\\<lambda>p. \\<exists>F. observation_facets_presents F p)\"\nproof -\n  have source: \"presentation_class observation_facets_presents observation_facets_domain\n      (\\<lambda>p. \\<exists>xs. data_elements xs \\<and> p=data_list_term xs)\"\n    by (rule data_list_fset_presentation_class[OF observation_datum_class])\n  show ?thesis by (rule presentation_class.recovered_admission[OF source])\nqed\n\nlemma observation_values_class:\n  \"presentation_class observation_values_presents observation_values_domain\n    (\\<lambda>p. \\<exists>V. observation_values_presents V p)\"\n  by (rule data_pair_finite_set_class)\n\nlemma observation_table_class:\n  \"presentation_class observation_table_presents observation_table_domain\n    (\\<lambda>p. \\<exists>T. observation_table_presents T p)\"\nproof -\n  have source: \"presentation_class observation_table_presents observation_table_domain\n      (\\<lambda>p. \\<exists>xs. (\\<forall>x\\<in>set xs. observation_row_admitted x) \\<and> p=data_list_term xs)\"\n    by (rule data_list_fset_presentation_class[OF observation_row_class])\n  show ?thesis by (rule presentation_class.recovered_admission[OF source])\nqed\n\nlemma observation_context_class:\n  assumes element: \"presentation_class R D A\"\n  shows \"presentation_class (observation_context_presents R)\n    (\\<lambda>z. observation_facets_domain (fst z) \\<and> D (snd z))\n    (\\<lambda>p. \\<exists>z. observation_context_presents R z p)\"\nproof -\n  have source: \"presentation_class (observation_context_presents R)\n      (\\<lambda>z. observation_facets_domain (fst z) \\<and> D (snd z))\n      (\\<lambda>p. \\<exists>F c. (\\<exists>V. observation_facets_presents V F) \\<and> A c \\<and> p=Pair_Term F c)\"\n    by (rule factor_pair_class[OF observation_facets_class element])\n  show ?thesis by (rule presentation_class.recovered_admission[OF source])\nqed\n\nlemma observation_query_class:\n  assumes element: \"presentation_class R D A\"\n  shows \"presentation_class (observation_query_presents R) (observation_query_domain D)\n    (\\<lambda>p. \\<exists>z. observation_query_presents R z p)\"\nproof -\n  have source: \"presentation_class (observation_query_presents R) (observation_query_domain D)\n      (\\<lambda>p. (\\<exists>z. observation_context_presents R z (fst p)) \\<and> (\\<exists>T. observation_table_presents T (snd p)))\"\n    using presentation_class_product[OF observation_context_class[OF element] observation_table_class]\n    by (simp only: conj_assoc)\n  show ?thesis by (rule presentation_class.recovered_admission[OF source])\nqed\n\nsection \\<open>The classes retain every displayed enumeration of their subjects\\<close>\n\nlemma observation_value_graph:\n  \"observation_value_presents=(\\<lambda>z p. (case z of (f,w) \\<Rightarrow> data_elements [f,w]) \\<and> p=observation_value_term z)\"\n  by (rule data_pair_graph)\n\nlemma observation_row_graph:\n  \"observation_row_presents=(\\<lambda>z p. (case z of (f,c,w) \\<Rightarrow> data_elements [f,c,w]) \\<and> p=observation_row_term z)\"\n  by (intro ext) (auto simp: factor_pair_presents_def split: prod.splits)\n\nlemma observation_values_fields:\n  \"observation_values_presents V p \\<longleftrightarrow>\n    (\\<exists>xs. (\\<forall>(f,w)\\<in>set xs. data_elements [f,w]) \\<and> fset_of_list xs=V \\<and>\n      p=data_list_term (map observation_value_term xs))\"\n  by (rule data_pair_finite_set_fields)\n\nlemma observation_values_presented_data:\n  assumes \"observation_values_presents V q\"\n  shows \"observation_datum q\"\n  by (rule data_pair_finite_set_presented_data[OF assms])\n\nlemma observation_facets_fields:\n  \"observation_facets_presents F p \\<longleftrightarrow>\n    (\\<exists>fs. data_elements fs \\<and> fset_of_list fs=F \\<and> p=data_list_term fs)\"\n  using data_list_fset_presents_function[where D=observation_datum and f=\"\\<lambda>a. a\" and S=F and t=p]\n  by simp\n\nlemma observation_table_fields:\n  \"observation_table_presents T p \\<longleftrightarrow>\n    (\\<exists>rows. observation_rows_data rows \\<and> fset_of_list rows=T \\<and>\n      p=data_list_term (map observation_row_term rows))\"\n  by (simp only: observation_row_graph data_list_fset_presents_function)\n\nlemma observation_query_fields:\n  \"observation_query_presents R ((F,c),T) (p,table) \\<longleftrightarrow>\n    (\\<exists>fs rows k. data_elements fs \\<and> R c k \\<and> observation_rows_data rows \\<and>\n      fset_of_list fs=F \\<and> fset_of_list rows=T \\<and>\n      p=Pair_Term (data_list_term fs) k \\<and> table=data_list_term (map observation_row_term rows))\"\nproof\n  assume read: \"observation_query_presents R ((F,c),T) (p,table)\"\n  have ctx: \"factor_pair_presents observation_facets_presents R (F,c) p\"\n    and table: \"observation_table_presents T table\" using read by simp_all\n  obtain ps k where pair: \"observation_facets_presents F ps\" \"R c k\" \"p=Pair_Term ps k\"\n    using ctx by (simp only: factor_pair_presents_def fst_conv snd_conv) blast\n  obtain fs where facets: \"data_elements fs\" \"fset_of_list fs=F\" \"ps=data_list_term fs\"\n    using pair(1) by (simp only: observation_facets_fields) blast\n  obtain rows where rows: \"observation_rows_data rows\" \"fset_of_list rows=T\"\n    \"table=data_list_term (map observation_row_term rows)\"\n    using table by (simp only: observation_table_fields) blast\n  show \"\\<exists>fs rows k. data_elements fs \\<and> R c k \\<and> observation_rows_data rows \\<and>\n      fset_of_list fs=F \\<and> fset_of_list rows=T \\<and>\n      p=Pair_Term (data_list_term fs) k \\<and> table=data_list_term (map observation_row_term rows)\"\n    by (intro exI[of _ fs] exI[of _ rows] exI[of _ k]) (use pair facets rows in blast)\nnext\n  assume \"\\<exists>fs rows k. data_elements fs \\<and> R c k \\<and> observation_rows_data rows \\<and>\n      fset_of_list fs=F \\<and> fset_of_list rows=T \\<and>\n      p=Pair_Term (data_list_term fs) k \\<and> table=data_list_term (map observation_row_term rows)\"\n  then obtain fs rows k where parts: \"data_elements fs\" \"R c k\" \"observation_rows_data rows\"\n    \"fset_of_list fs=F\" \"fset_of_list rows=T\"\n    \"p=Pair_Term (data_list_term fs) k\" \"table=data_list_term (map observation_row_term rows)\"\n    by (elim exE conjE) (rule that; assumption)\n  have facets: \"observation_facets_presents F (data_list_term fs)\"\n    by (simp only: observation_facets_fields; rule exI[of _ fs]) (use parts in blast)\n  have table: \"observation_table_presents T table\"\n    by (simp only: observation_table_fields; rule exI[of _ rows]) (use parts in blast)\n  have ctx: \"factor_pair_presents observation_facets_presents R (F,c) p\"\n    by (simp only: factor_pair_presents_def fst_conv snd_conv;\n      intro exI[of _ \"data_list_term fs\"] exI[of _ k]) (use parts facets in blast)\n  show \"observation_query_presents R ((F,c),T) (p,table)\" using ctx table by simp\nqed\n\ntext \\<open>\n  Facets, table rows, and result rows use finite-set subjects with complete\n  displayed list presentations. Pair and product classes preserve the actual\n  shared context and every field. No chosen order, duplicate count, or numeric\n  identifier is used to determine the represented subject.\n\\<close>\n\nend\n",
          "sha256": "dc190da79879f9a254ee4e4e111191b51c24633921bc950a95bf3ffb7df219ea"
        },
