          "source": "theory Factor_Result_Comparison\n  imports Factor_Related_Lists Presentation_Function_Witnesses\nbegin\n\nsection \\<open>A private computed result is compared with the supplied result\\<close>\n\ndefinition context_result_comparison_schema :: \"nat \\<Rightarrow> nat \\<Rightarrow> (nat,nat,nat) factor_schema\" where\n  \"context_result_comparison_schema compute compare=data_rule (context_relation_pattern data_x data_y data_z)\n    {(0,compute,context_relation_pattern data_x data_y data_w),\n     (1,compare,Pattern_Pair data_w data_z)}\"\n\nlemma context_result_comparison_formed [simp]:\n  \"schema_formed (context_result_comparison_schema compute compare)\"\n  by (auto simp: context_result_comparison_schema_def schema_formed_def single_valued_def)\n\nlemma context_result_comparison_dependencies [simp]:\n  \"schema_dependencies (context_result_comparison_schema compute compare)={compute,compare}\"\n  by (auto simp: context_result_comparison_schema_def schema_dependencies_def rel_ran_image)\n\nlemma context_result_comparison_variables [simp]:\n  \"schema_variables (context_result_comparison_schema compute compare)={0,1,2,3}\"\n  by (auto simp: context_result_comparison_schema_def schema_variables_def)\n\nlocale context_result_comparison_profile =\n  fixes P :: \"(nat,nat,nat,nat) schema_system\" and entry compute compare :: nat\n  assumes system_formed: \"schema_system_formed P\"\n    and family: \"\\<And>c S. ((entry,c),S)\\<in>system_clauses P \\<longleftrightarrow>\n      c=0 \\<and> S=context_result_comparison_schema compute compare\"\n    and call: \"\\<And>t. schema_call_formed P entry t \\<longleftrightarrow> term_formed t\"\nbegin\n\nlemma valuation:\n  \"(entry,t)\\<in>positive_meaning P \\<longleftrightarrow>\n    (\\<exists>h::nat\\<Rightarrow>factor_term. term_formed (h 0) \\<and> term_formed (h 1) \\<and>\n      term_formed (h 2) \\<and> term_formed (h 3) \\<and>\n      t=context_relation_argument (h 0) (h 1) (h 2) \\<and>\n      (compute,context_relation_argument (h 0) (h 1) (h 3))\\<in>positive_meaning P \\<and>\n      (compare,Pair_Term (h 3) (h 2))\\<in>positive_meaning P)\"\n  by (subst ordinary_positive_entry_valuation)\n    (auto simp: family context_result_comparison_schema_def schema_variables_def call)\n\ntheorem exact:\n  \"(entry,t)\\<in>positive_meaning P \\<longleftrightarrow>\n    (\\<exists>p input result witness. t=context_relation_argument p input result \\<and>\n      (compute,context_relation_argument p input witness)\\<in>positive_meaning P \\<and>\n      (compare,Pair_Term witness result)\\<in>positive_meaning P)\"\nproof\n  assume \"(entry,t)\\<in>positive_meaning P\"\n  then show \"\\<exists>p input result witness. t=context_relation_argument p input result \\<and>\n      (compute,context_relation_argument p input witness)\\<in>positive_meaning P \\<and>\n      (compare,Pair_Term witness result)\\<in>positive_meaning P\"\n    by (simp only: valuation) blast\nnext\n  assume \"\\<exists>p input result witness. t=context_relation_argument p input result \\<and>\n      (compute,context_relation_argument p input witness)\\<in>positive_meaning P \\<and>\n      (compare,Pair_Term witness result)\\<in>positive_meaning P\"\n  then obtain p input result witness where parts: \"t=context_relation_argument p input result\"\n    \"(compute,context_relation_argument p input witness)\\<in>positive_meaning P\"\n    \"(compare,Pair_Term witness result)\\<in>positive_meaning P\" by blast\n  have formed: \"term_formed p\" \"term_formed input\" \"term_formed result\" \"term_formed witness\"\n    using schema_call_formed_target[OF positive_meaning_formed[OF parts(2)]]\n      schema_call_formed_target[OF positive_meaning_formed[OF parts(3)]] by auto\n  let ?h=\"\\<lambda>i::nat. if i=0 then p else if i=1 then input else if i=2 then result else witness\"\n  show \"(entry,t)\\<in>positive_meaning P\"\n    by (simp only: valuation; rule exI[of _ ?h]) (use parts formed in auto)\nqed\n\ncorollary at_input:\n  \"(entry,context_relation_argument p input result)\\<in>positive_meaning P \\<longleftrightarrow>\n    (\\<exists>witness. (compute,context_relation_argument p input witness)\\<in>positive_meaning P \\<and>\n      (compare,Pair_Term witness result)\\<in>positive_meaning P)\"\n  by (auto simp only: exact factor_term.inject)\n\nlemma at_determined_result:\n  assumes computation: \"\\<And>w. (compute,context_relation_argument p input w)\\<in>positive_meaning P\n      \\<longleftrightarrow> admitted \\<and> w=witness\"\n    and comparison: \"admitted \\<Longrightarrow> ((compare,Pair_Term witness result)\\<in>positive_meaning P \\<longleftrightarrow> condition)\"\n  shows \"(entry,context_relation_argument p input result)\\<in>positive_meaning P \\<longleftrightarrow> admitted \\<and> condition\"\n  by (simp only: at_input computation) (use comparison in blast)\n\ntheorem presented_contract:\n  assumes computation: \"presented_function_witness R D A S E B f\n      (\\<lambda>p q. (compute,context_relation_argument (fst p) (snd p) q)\\<in>positive_meaning P)\"\n    and comparison: \"\\<And>b q r. S b q \\<Longrightarrow>\n      ((compare,Pair_Term q r)\\<in>positive_meaning P \\<longleftrightarrow> S b r)\"\n  shows \"presented_function_contract R D A S E B f\n    (\\<lambda>p r. (entry,context_relation_argument (fst p) (snd p) r)\\<in>positive_meaning P)\"\nproof -\n  have completed: \"presented_function_contract R D A S E B f\n      (\\<lambda>p r. \\<exists>q. (compute,context_relation_argument (fst p) (snd p) q)\\<in>positive_meaning P \\<and>\n        (compare,Pair_Term q r)\\<in>positive_meaning P)\"\n    by (rule presented_function_witness.completion_by_comparison[OF computation comparison])\n  show ?thesis using completed by (simp only: at_input)\nqed\n\nend\n\ntext \\<open>\n  The computed result has its own premise-only variable. The public result\n  occurs in the comparison call. Requiring the computation to produce the\n  public result literally would retain the earlier order restriction.\n  Both callees and both premise sockets are actual parts of this ordinary\n  schema. The contract applies to their meanings in the complete program.\n\\<close>\n\nend\n",
