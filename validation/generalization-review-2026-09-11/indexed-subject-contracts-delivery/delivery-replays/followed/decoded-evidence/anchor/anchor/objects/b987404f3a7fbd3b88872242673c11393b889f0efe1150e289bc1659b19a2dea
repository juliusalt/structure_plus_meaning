          "theory": "Factor_Definition_Code",
          "source": "theory Factor_Definition_Code\n  imports Factor_Definition_Compilation Factor_Reference_Environments\nbegin\n\nsection \\<open>Finite compiler results for simultaneous program construction\\<close>\n\nrecord definition_code =\n  code_artifact :: exact_artifact\n  code_interface :: \"local_address term_pattern\"\n  code_clauses :: \"(local_address \\<times> local_address option native_schema) set\"\n  code_literals :: \"(local_address \\<times> exact_artifact) set\"\n  code_callees :: \"(local_address \\<times> local_address option definition_site) set\"\n\ndefinition definition_code_for ::\n  \"'a term_pattern \\<Rightarrow> ('c \\<times> ('a,'s,local_address option definition_site) factor_schema) set \\<Rightarrow>\n    definition_code \\<Rightarrow> bool\" where\n  \"definition_code_for p Cs K \\<longleftrightarrow> exact_formed (code_artifact K) \\<and>\n    bag_count (object_data (code_artifact K)) = (\\<lambda>_. 0) \\<and>\n    [] \\<in> rra_carrier (object_structure (code_artifact K)) \\<and>\n    (\\<exists>f h. inj_on f (pattern_variables p) \\<and> code_interface K = rename_pattern f p \\<and>\n      schema_family_variant h Cs (code_clauses K)) \\<and>\n    reference_table_formed (code_literals K) (code_callees K) \\<and>\n    rel_dom (code_literals K) \\<union> rel_dom (code_callees K) \\<subseteq> rra_carrier (object_structure (code_artifact K)) \\<and>\n    rel_ran (code_callees K) = (\\<Union>S\\<in>rel_ran Cs. schema_dependencies S) \\<and>\n    (\\<forall>E u. environment_formed E \\<longrightarrow> artifact_at E u (code_artifact K) \\<longrightarrow>\n      syntax_references E u (code_literals K) (code_callees K) \\<longrightarrow>\n      native_definition_at E u [] (code_interface K) (code_clauses K))\"\n\nlemma definition_code_properties:\n  assumes \"definition_code_for p Cs K\"\n  shows \"exact_formed (code_artifact K)\" \"bag_count (object_data (code_artifact K)) = (\\<lambda>_. 0)\"\n    \"[] \\<in> rra_carrier (object_structure (code_artifact K))\"\n    \"\\<exists>f h. inj_on f (pattern_variables p) \\<and> code_interface K = rename_pattern f p \\<and>\n      schema_family_variant h Cs (code_clauses K)\"\n    \"reference_table_formed (code_literals K) (code_callees K)\"\n    \"rel_dom (code_literals K) \\<union> rel_dom (code_callees K) \\<subseteq> rra_carrier (object_structure (code_artifact K))\"\n    \"rel_ran (code_callees K) = (\\<Union>S\\<in>rel_ran Cs. schema_dependencies S)\"\n    \"\\<forall>E u. environment_formed E \\<longrightarrow> artifact_at E u (code_artifact K) \\<longrightarrow>\n      syntax_references E u (code_literals K) (code_callees K) \\<longrightarrow>\n      native_definition_at E u [] (code_interface K) (code_clauses K)\"\n  using assms by (auto simp: definition_code_for_def)\n\nlemma definition_code_dependencies:\n  assumes \"definition_code_for p Cs K\"\n  shows \"(\\<Union>S\\<in>rel_ran (code_clauses K). schema_dependencies S) = rel_ran (code_callees K)\"\nproof -\n  obtain h where variant: \"schema_family_variant h Cs (code_clauses K)\"\n    using definition_code_properties(4)[OF assms] by blast\n  show ?thesis using schema_family_variant_dependencies[OF variant] definition_code_properties(7)[OF assms] by simp\nqed\n\ntheorem definition_code_total:\n  fixes p :: \"'a term_pattern\"\n    and Cs :: \"('c \\<times> ('a,'s,local_address option definition_site) factor_schema) set\"\n  assumes pf: \"pattern_formed p\" and fin: \"finite Cs\" and sv: \"single_valued Cs\"\n    and formed: \"\\<forall>S\\<in>rel_ran Cs. schema_formed S\"\n    and addresses: \"\\<forall>S\\<in>rel_ran Cs. \\<forall>d\\<in>schema_dependencies S. octets_formed (snd d)\"\n  shows \"\\<exists>K. definition_code_for p Cs K\"\nproof -\n  obtain R :: exact_artifact and f :: \"'a \\<Rightarrow> local_address\" and h :: \"'c \\<Rightarrow> local_address\"\n    and D :: \"(local_address \\<times> local_address option native_schema) set\"\n    and L :: \"(local_address \\<times> exact_artifact) set\"\n    and C :: \"(local_address \\<times> local_address option definition_site) set\" where built:\n    \"exact_formed R\" \"bag_count (object_data R) = (\\<lambda>_. 0)\" \"[] \\<in> rra_carrier (object_structure R)\"\n    \"inj_on f (pattern_variables p)\" \"schema_family_variant h Cs D\" \"reference_table_formed L C\"\n    \"rel_dom L \\<union> rel_dom C \\<subseteq> rra_carrier (object_structure R)\"\n    \"rel_ran C = (\\<Union>S\\<in>rel_ran Cs. schema_dependencies S)\"\n    \"\\<forall>E u. environment_formed E \\<longrightarrow> artifact_at E u R \\<longrightarrow> syntax_references E u L C \\<longrightarrow>\n      native_definition_at E u [] (rename_pattern f p) D\"\n    using definition_compilation_total[OF pf fin sv formed addresses] by metis\n  let ?K = \"\\<lparr>code_artifact=R, code_interface=rename_pattern f p, code_clauses=D, code_literals=L, code_callees=C\\<rparr>\"\n  show ?thesis by (rule exI[of _ ?K]) (use built in \\<open>auto simp: definition_code_for_def\\<close>)\nqed\n\nlemma definition_code_included_recovers:\n  assumes code: \"definition_code_for p Cs K\"\n    and ff: \"environment_formed F\" and included: \"environment_included E F\"\n    and source: \"artifact_at E u (code_artifact K)\"\n    and refs: \"syntax_references E u (code_literals K) (code_callees K)\"\n  shows \"native_definition_at F u [] (code_interface K) (code_clauses K)\"\n  using definition_code_properties(8)[OF code] ff included_artifact[OF included source]\n    syntax_references_included[OF ff included refs] by blast\n\ntext \\<open>\n  This record packages a finite compiler result for simultaneous construction.\n  Its interface and clause fields are proved projections used by the existence\n  proof. They are not additional fields of native definition syntax. The native\n  object is the artifact placed in its reference environment; the existing\n  native reader recovers its interface and clauses there.\n\\<close>\n\nend\n",
