          "theory": "Factor_Alpha_Semantics",
          "source": "theory Factor_Alpha_Semantics\n  imports Factor_Schema_Renaming\nbegin\n\nsection \\<open>Coordinate changes preserve and reflect complete rule instances\\<close>\n\ndefinition schema_rule_instance ::\n  \"('a,'s,'d) factor_schema \\<Rightarrow> ('d \\<times> factor_term) set \\<Rightarrow> factor_term \\<Rightarrow> bool\" where\n  \"schema_rule_instance S X t \\<longleftrightarrow> (\\<exists>V Q. schema_instance S V t Q \\<and>\n    schema_material_satisfied S V \\<and> (\\<forall>s d x. (s,d,x) \\<in> Q \\<longrightarrow> (d,x) \\<in> X))\"\n\nlemma schema_rule_instance_renaming:\n  assumes rule: \"schema_rule_instance S X t\"\n    and binders: \"inj_on f (schema_variables S)\" and sockets: \"inj_on h (schema_sockets S)\"\n  shows \"schema_rule_instance (rename_schema f h id S) X t\"\nproof -\n  obtain V Q where old: \"schema_instance S V t Q\" \"schema_material_satisfied S V\"\n    \"\\<forall>s d x. (s,d,x) \\<in> Q \\<longrightarrow> (d,x) \\<in> X\"\n    using rule by (auto simp: schema_rule_instance_def)\n  have instance_read: \"schema_instance (rename_schema f h id S) (rename_term_bindings f V) t (map_socket_graph h id id Q)\"\n    by (rule schema_instance_renaming[OF old(1) binders sockets])\n  have bindings: \"term_bindings_formed (schema_variables S) V\" using old(1) by (simp add: schema_instance_def)\n  have material: \"schema_material_satisfied (rename_schema f h id S) (rename_term_bindings f V)\"\n    using schema_material_satisfied_renaming[OF bindings binders] old(2) by blast\n  have body: \"\\<forall>s d x. (s,d,x) \\<in> map_socket_graph h id id Q \\<longrightarrow> (d,x) \\<in> X\"\n    using old(3) by (auto simp: map_socket_graph_member)\n  show ?thesis unfolding schema_rule_instance_def\n    by (rule exI[of _ \"rename_term_bindings f V\"], rule exI[of _ \"map_socket_graph h id id Q\"])\n       (use instance_read material body in blast)\nqed\n\ntheorem schema_rule_instance_alpha:\n  assumes binders: \"inj_on f (schema_variables S)\" and sockets: \"inj_on h (schema_sockets S)\"\n  shows \"schema_rule_instance (rename_schema f h id S) X t \\<longleftrightarrow> schema_rule_instance S X t\"\nproof\n  let ?fi = \"inv_into (schema_variables S) f\"\n  let ?hi = \"inv_into (schema_sockets S) h\"\n  let ?A = \"rename_schema f h id S\"\n  assume renamed: \"schema_rule_instance ?A X t\"\n  have invf: \"inj_on ?fi (schema_variables ?A)\"\n    by (rule inj_on_inv_into) (simp add: renamed_schema_variables)\n  have invh: \"inj_on ?hi (schema_sockets ?A)\"\n    by (rule inj_on_inv_into) (simp add: renamed_schema_sockets)\n  have inverse_result: \"schema_rule_instance (rename_schema ?fi ?hi id ?A) X t\"\n    by (rule schema_rule_instance_renaming[OF renamed invf invh])\n  have restored: \"rename_schema ?fi ?hi id ?A = S\"\n    by (rule rename_schema_cancels) (use binders sockets in auto)\n  show \"schema_rule_instance S X t\" using inverse_result restored by simp\nnext\n  assume \"schema_rule_instance S X t\"\n  then show \"schema_rule_instance (rename_schema f h id S) X t\"\n    by (rule schema_rule_instance_renaming[OF _ binders sockets])\nqed\n\nlemma schema_rule_instance_map:\n  assumes rule: \"schema_rule_instance S X t\"\n    and binders: \"inj_on f (schema_variables S)\" and sockets: \"inj_on h (schema_sockets S)\"\n  shows \"schema_rule_instance (rename_schema f h g S) (map_prod g id ` X) t\"\nproof -\n  obtain V Q where old: \"schema_instance S V t Q\" \"schema_material_satisfied S V\"\n    \"\\<forall>s d x. (s,d,x) \\<in> Q \\<longrightarrow> (d,x) \\<in> X\"\n    using rule unfolding schema_rule_instance_def by blast\n  have instance_read: \"schema_instance (rename_schema f h g S) (rename_term_bindings f V) t (map_socket_graph h g id Q)\"\n    by (rule schema_instance_renaming[OF old(1) binders sockets])\n  have bindings: \"term_bindings_formed (schema_variables S) V\" using old(1) by (simp add: schema_instance_def)\n  have material: \"schema_material_satisfied (rename_schema f h g S) (rename_term_bindings f V)\"\n    using schema_material_satisfied_renaming[OF bindings binders] old(2) by blast\n  have body: \"\\<forall>s d x. (s,d,x) \\<in> map_socket_graph h g id Q \\<longrightarrow> (d,x) \\<in> map_prod g id ` X\"\n  proof (intro allI impI)\n    fix s d x assume entry: \"(s,d,x) \\<in> map_socket_graph h g id Q\"\n    obtain q e y where origin: \"(q,e,y) \\<in> Q\" \"s=h q\" \"d=g e\" \"x=y\"\n      using entry by (auto simp: map_socket_graph_member)\n    have supported: \"(e,y) \\<in> X\" using old(3) origin(1) by blast\n    have mapped: \"map_prod g id (e,y) \\<in> map_prod g id ` X\" by (rule imageI[OF supported])\n    show \"(d,x) \\<in> map_prod g id ` X\" using mapped origin(3,4) by simp\n  qed\n  show ?thesis unfolding schema_rule_instance_def\n    by (rule exI[of _ \"rename_term_bindings f V\"], rule exI[of _ \"map_socket_graph h g id Q\"])\n       (use instance_read material body in blast)\nqed\n\ntheorem schema_rule_instance_callee_image:\n  fixes S :: \"('a,'s,'d) factor_schema\" and g :: \"'d \\<Rightarrow> 'e\"\n    and X :: \"('d \\<times> factor_term) set\"\n  assumes injective: \"inj_on g D\" and dependencies: \"schema_dependencies S \\<subseteq> D\"\n    and support: \"X \\<subseteq> D \\<times> UNIV\"\n  shows \"schema_rule_instance (rename_schema id id g S) (map_prod g id ` X) t \\<longleftrightarrow>\n    schema_rule_instance S X t\"\nproof\n  let ?h = \"inv_into D g\"\n  let ?T = \"rename_schema id id g S\"\n  assume renamed: \"schema_rule_instance ?T (map_prod g id ` X) t\"\n  have inverse_rule: \"schema_rule_instance (rename_schema id id ?h ?T) (map_prod ?h id ` (map_prod g id ` X)) t\"\n    by (rule schema_rule_instance_map[OF renamed]) simp_all\n  have restored: \"rename_schema id id ?h ?T = S\"\n    by (rule rename_schema_cancels) (use injective dependencies in auto)\n  have point: \"\\<And>q. q \\<in> X \\<Longrightarrow> map_prod ?h id (map_prod g id q) = q\"\n  proof -\n    fix q :: \"'d \\<times> factor_term\" assume member: \"q \\<in> X\"\n    obtain d x where shape: \"q=(d,x)\" by (cases q)\n    have inside: \"d \\<in> D\" using support member shape by auto\n    have inverse: \"?h (g d) = d\" by (rule inv_into_f_f[OF injective inside])\n    show \"map_prod ?h id (map_prod g id q) = q\" by (simp add: shape inverse)\n  qed\n  have support_back: \"map_prod ?h id ` (map_prod g id ` X) = X\"\n  proof -\n    have \"map_prod ?h id ` (map_prod g id ` X) = (\\<lambda>q. map_prod ?h id (map_prod g id q)) ` X\"\n      by (simp only: image_image)\n    also have \"\\<dots> = id ` X\" by (rule image_cong[OF refl]) (use point in simp)\n    also have \"\\<dots> = X\" by simp\n    finally show ?thesis .\n  qed\n  show \"schema_rule_instance S X t\" using inverse_rule restored support_back by simp\nnext\n  assume original: \"schema_rule_instance S X t\"\n  show \"schema_rule_instance (rename_schema id id g S) (map_prod g id ` X) t\"\n    by (rule schema_rule_instance_map[OF original]) simp_all\nqed\n\ndefinition schema_alpha_variant ::\n  \"('a,'s,'d) factor_schema \\<Rightarrow> ('b,'t,'d) factor_schema \\<Rightarrow> bool\" where\n  \"schema_alpha_variant S T \\<longleftrightarrow> (\\<exists>f h. inj_on f (schema_variables S) \\<and>\n    inj_on h (schema_sockets S) \\<and> T = rename_schema f h id S)\"\n\nlemma schema_alpha_dependencies:\n  assumes \"schema_alpha_variant S T\"\n  shows \"schema_dependencies T = schema_dependencies S\"\n  using assms by (auto simp: schema_alpha_variant_def renamed_schema_dependencies)\n\nlemma schema_alpha_formed:\n  assumes \"schema_alpha_variant S T\" \"schema_formed S\"\n  shows \"schema_formed T\"\n  using assms renamed_schema_formed by (auto simp: schema_alpha_variant_def)\n\nlemma schema_alpha_rule_instance:\n  assumes \"schema_alpha_variant S T\"\n  shows \"schema_rule_instance T X t \\<longleftrightarrow> schema_rule_instance S X t\"\nproof -\n  obtain f h where renaming: \"inj_on f (schema_variables S)\" \"inj_on h (schema_sockets S)\"\n    \"T = rename_schema f h id S\" using assms by (auto simp: schema_alpha_variant_def)\n  show ?thesis using schema_rule_instance_alpha[OF renaming(1,2)] renaming(3) by simp\nqed\n\nlemma schema_alpha_copy:\n  assumes alpha: \"schema_alpha_variant S T\" and injective: \"inj f\"\n  shows \"schema_alpha_variant S (rename_schema f f id T)\"\nproof -\n  obtain a h where old: \"inj_on a (schema_variables S)\" \"inj_on h (schema_sockets S)\"\n    \"T = rename_schema a h id S\" using alpha by (auto simp: schema_alpha_variant_def)\n  have binders: \"inj_on (f \\<circ> a) (schema_variables S)\"\n    and sockets: \"inj_on (f \\<circ> h) (schema_sockets S)\"\n    using old(1,2) injective by (auto simp: inj_on_def)\n  show ?thesis unfolding schema_alpha_variant_def\n    by (rule exI[of _ \"f \\<circ> a\"], rule exI[of _ \"f \\<circ> h\"])\n       (use binders sockets old(3) in \\<open>simp add: rename_schema_composition\\<close>)\nqed\n\nsection \\<open>Complete identified families of independently renamed schemas\\<close>\n\ndefinition schema_family_variant ::\n  \"('c \\<Rightarrow> 'e) \\<Rightarrow> ('c \\<times> ('a,'s,'d) factor_schema) set \\<Rightarrow>\n    ('e \\<times> ('b,'t,'d) factor_schema) set \\<Rightarrow> bool\" where\n  \"schema_family_variant h C D \\<longleftrightarrow> inj_on h (rel_dom C) \\<and> finite D \\<and> single_valued D \\<and>\n    rel_dom D = h ` rel_dom C \\<and>\n    (\\<forall>c S. (c,S) \\<in> C \\<longrightarrow> (\\<exists>T. (h c,T) \\<in> D \\<and> schema_alpha_variant S T))\"\n\nlemma schema_family_variant_entry:\n  assumes \"schema_family_variant h C D\" \"(c,S) \\<in> C\"\n  shows \"\\<exists>T. (h c,T) \\<in> D \\<and> schema_alpha_variant S T\"\n  using assms by (auto simp: schema_family_variant_def)\n\nlemma schema_family_variant_origin:\n  assumes variant: \"schema_family_variant h C D\" and entry: \"(c,T) \\<in> D\"\n  shows \"\\<exists>s S. (s,S) \\<in> C \\<and> c=h s \\<and> schema_alpha_variant S T\"\nproof -\n  have key: \"c \\<in> h ` rel_dom C\" using variant rel_domI[OF entry] by (simp add: schema_family_variant_def)\n  obtain s where source: \"s \\<in> rel_dom C\" \"c=h s\" using key by blast\n  obtain S where original: \"(s,S) \\<in> C\" using source(1) by (auto simp: rel_dom_def)\n  obtain A where projected: \"(h s,A) \\<in> D\" \"schema_alpha_variant S A\"\n    using schema_family_variant_entry[OF variant original] by blast\n  have sv: \"single_valued D\" using variant by (simp add: schema_family_variant_def)\n  have other: \"(c,A) \\<in> D\" using projected(1) source(2) by simp\n  have same: \"A=T\" by (rule single_valued_outputs[OF sv other entry])\n  show ?thesis using original source(2) projected(2) same by blast\nqed\n\nlemma schema_family_variant_singleton:\n  assumes variant: \"schema_family_variant h {(c,S)} D\"\n  shows \"\\<exists>T. D={(h c,T)} \\<and> schema_alpha_variant S T\"\nproof -\n  obtain T where entry: \"(h c,T)\\<in>D\" \"schema_alpha_variant S T\"\n    using schema_family_variant_entry[OF variant, of c S] by auto\n  have functional: \"single_valued D\" using variant by (simp add: schema_family_variant_def)\n  have subset: \"D\\<subseteq>{(h c,T)}\"\n  proof\n    fix q assume member: \"q\\<in>D\"\n    obtain d U where shape: \"q=(d,U)\" by (cases q)\n    have row: \"(d,U)\\<in>D\" using member shape by simp\n    have key: \"d=h c\" using schema_family_variant_origin[OF variant row] by auto\n    have same: \"U=T\" using single_valued_outputs[OF functional row] entry(1) key by blast\n    show \"q\\<in>{(h c,T)}\" using shape key same by simp\n  qed\n  show ?thesis by (rule exI[of _ T]) (use subset entry in auto)\nqed\n\nlemma schema_family_variant_rules:\n  assumes variant: \"schema_family_variant h C D\"\n  shows \"(\\<exists>c T. (c,T) \\<in> D \\<and> schema_rule_instance T X t) \\<longleftrightarrow>\n    (\\<exists>s S. (s,S) \\<in> C \\<and> schema_rule_instance S X t)\"\nproof\n  assume \"\\<exists>c T. (c,T) \\<in> D \\<and> schema_rule_instance T X t\"\n  then obtain c T where entry: \"(c,T) \\<in> D\" \"schema_rule_instance T X t\" by blast\n  obtain s S where source: \"(s,S) \\<in> C\" \"schema_alpha_variant S T\"\n    using schema_family_variant_origin[OF variant entry(1)] by blast\n  have rule: \"schema_rule_instance S X t\" using schema_alpha_rule_instance[OF source(2)] entry(2) by blast\n  show \"\\<exists>s S. (s,S) \\<in> C \\<and> schema_rule_instance S X t\" using source(1) rule by blast\nnext\n  assume \"\\<exists>s S. (s,S) \\<in> C \\<and> schema_rule_instance S X t\"\n  then obtain s S where entry: \"(s,S) \\<in> C\" \"schema_rule_instance S X t\" by blast\n  obtain T where target: \"(h s,T) \\<in> D\" \"schema_alpha_variant S T\"\n    using schema_family_variant_entry[OF variant entry(1)] by blast\n  have rule: \"schema_rule_instance T X t\" using schema_alpha_rule_instance[OF target(2)] entry(2) by blast\n  show \"\\<exists>c T. (c,T) \\<in> D \\<and> schema_rule_instance T X t\" using target(1) rule by blast\nqed\n\nlemma schema_family_variant_dependencies:\n  assumes variant: \"schema_family_variant h C D\"\n  shows \"(\\<Union>T\\<in>rel_ran D. schema_dependencies T) = (\\<Union>S\\<in>rel_ran C. schema_dependencies S)\"\nproof (rule set_eqI, rule iffI)\n  fix d assume \"d \\<in> (\\<Union>T\\<in>rel_ran D. schema_dependencies T)\"\n  then obtain c T where entry: \"(c,T) \\<in> D\" \"d \\<in> schema_dependencies T\" by (auto simp: rel_ran_def)\n  obtain s S where source: \"(s,S) \\<in> C\" \"schema_alpha_variant S T\"\n    using schema_family_variant_origin[OF variant entry(1)] by blast\n  have dependency: \"d \\<in> schema_dependencies S\" using schema_alpha_dependencies[OF source(2)] entry(2) by simp\n  show \"d \\<in> (\\<Union>S\\<in>rel_ran C. schema_dependencies S)\" using source(1) dependency by (auto simp: rel_ran_def)\nnext\n  fix d assume \"d \\<in> (\\<Union>S\\<in>rel_ran C. schema_dependencies S)\"\n  then obtain s S where entry: \"(s,S) \\<in> C\" \"d \\<in> schema_dependencies S\" by (auto simp: rel_ran_def)\n  obtain T where target: \"(h s,T) \\<in> D\" \"schema_alpha_variant S T\"\n    using schema_family_variant_entry[OF variant entry(1)] by blast\n  have dependency: \"d \\<in> schema_dependencies T\" using schema_alpha_dependencies[OF target(2)] entry(2) by simp\n  show \"d \\<in> (\\<Union>T\\<in>rel_ran D. schema_dependencies T)\" using target(1) dependency by (auto simp: rel_ran_def)\nqed\n\nlemma pattern_accepts_renaming_forward:\n  assumes accepted: \"pattern_accepts p t\" and injective: \"inj_on f (pattern_variables p)\"\n  shows \"pattern_accepts (rename_pattern f p) t\"\nproof -\n  obtain V where old: \"term_formed t\" \"term_bindings_formed (pattern_variables p) V\" \"pattern_instance V p t\"\n    using accepted by (auto simp: pattern_accepts_def)\n  have dom: \"rel_dom V = pattern_variables p\" using old(2) by (simp add: term_bindings_formed_def)\n  have finj: \"inj_on f (rel_dom V)\" using injective dom by simp\n  have scope: \"pattern_variables p \\<subseteq> rel_dom V\" using dom by simp\n  have instance_read: \"pattern_instance (rename_term_bindings f V) (rename_pattern f p) t\"\n    using pattern_instance_renaming[OF finj scope] old(3) by blast\n  have bindings: \"term_bindings_formed (pattern_variables (rename_pattern f p)) (rename_term_bindings f V)\"\n    using renamed_term_bindings_formed[OF old(2) injective] by (simp add: rename_pattern_variables)\n  show ?thesis using old(1) instance_read bindings unfolding pattern_accepts_def by blast\nqed\n\ntheorem pattern_accepts_alpha:\n  assumes injective: \"inj_on f (pattern_variables p)\"\n  shows \"pattern_accepts (rename_pattern f p) t \\<longleftrightarrow> pattern_accepts p t\"\nproof\n  let ?g = \"inv_into (pattern_variables p) f\"\n  assume accepted: \"pattern_accepts (rename_pattern f p) t\"\n  have inverse: \"inj_on ?g (pattern_variables (rename_pattern f p))\"\n    by (rule inj_on_inv_into) (simp add: rename_pattern_variables)\n  have inverse_result: \"pattern_accepts (rename_pattern ?g (rename_pattern f p)) t\"\n    by (rule pattern_accepts_renaming_forward[OF accepted inverse])\n  have same: \"rename_pattern (?g \\<circ> f) p = rename_pattern id p\"\n    by (rule rename_pattern_agreement) (use injective in auto)\n  have restored: \"rename_pattern ?g (rename_pattern f p) = p\"\n    using same by (simp add: rename_pattern_composition)\n  show \"pattern_accepts p t\" using inverse_result restored by simp\nnext\n  assume \"pattern_accepts p t\"\n  then show \"pattern_accepts (rename_pattern f p) t\" by (rule pattern_accepts_renaming_forward[OF _ injective])\nqed\n\ntext \\<open>\n  The complete rule-instance relation is derived from schema instantiation,\n  every material check, and support for every identified premise. It introduces\n  no additional inference form. Injective binder and socket changes preserve\n  and reflect this relation for every supporting relation, and also preserve\n  and reflect application-interface acceptance. Thus copying cannot create\n  additional instances through a change of variable or socket coordinates.\n\\<close>\n\nend\n",
