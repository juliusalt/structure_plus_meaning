          "source": "theory Factor_Schema_Bodies\n  imports Factor_Premise_Forests\nbegin\n\nsection \\<open>Conclusion and mixed premises under one binder boundary\\<close>\n\ndefinition schema_body_variables :: \"'a term_pattern \\<Rightarrow> ('a,'u) premise_template list \\<Rightarrow> 'a set\" where\n  \"schema_body_variables p ts = pattern_variables p \\<union> template_list_variables ts\"\n\ndefinition schema_body_syntax ::\n  \"('a \\<Rightarrow> local_address) \\<Rightarrow> 'a term_pattern \\<Rightarrow> ('a,'u) premise_template list \\<Rightarrow> exact_artifact\" where\n  \"schema_body_syntax f p ts = bound_union (pattern_syntax f p) (premise_forest_syntax f ts)\"\n\ndefinition schema_body_literals ::\n  \"'a term_pattern \\<Rightarrow> ('a,'u) premise_template list \\<Rightarrow> (local_address \\<times> exact_artifact) set\" where\n  \"schema_body_literals p ts = map_slot_keys (syntax_prefix 2) (pattern_literal_bindings p) \\<union>\n    map_slot_keys (syntax_prefix 3) (premise_forest_literals ts)\"\n\ndefinition schema_body_callees ::\n  \"('a,'u) premise_template list \\<Rightarrow> (local_address \\<times> 'u definition_site) set\" where\n  \"schema_body_callees ts = map_slot_keys (syntax_prefix 3) (premise_forest_callees ts)\"\n\ndefinition schema_body_roots :: \"('a,'u) premise_template list \\<Rightarrow> local_address list\" where\n  \"schema_body_roots ts = map (\\<lambda>i. syntax_prefix 3 (premise_branch i [])) [0..<length ts]\"\n\nlemma schema_body_roots_length [simp]: \"length (schema_body_roots ts) = length ts\"\n  by (simp add: schema_body_roots_def)\n\nlemma schema_body_root_nth:\n  assumes \"i < length ts\"\n  shows \"schema_body_roots ts ! i = syntax_prefix 3 (premise_branch i [])\"\n  using assms by (simp add: schema_body_roots_def)\n\nlemma premise_forest_root_inside:\n  assumes \"i < length ts\"\n  shows \"premise_branch i [] \\<in> rra_carrier (object_structure (premise_forest_syntax f ts))\"\n  using assms\nproof (induction ts arbitrary: i)\n  case Nil\n  then show ?case by simp\nnext\n  case (Cons t ts)\n  show ?case\n  proof (cases i)\n    case 0\n    have present: \"syntax_prefix 2 [] \\<in> syntax_prefix 2 ` rra_carrier (object_structure (template_syntax f t))\"\n      by (rule imageI[OF template_syntax_properties(1)])\n    show ?thesis using present\n      by (simp only: 0 premise_branch.simps premise_forest_syntax.simps bound_union_def\n          structured_object.select_convs rra_structure.select_convs) blast\n  next\n    case (Suc n)\n    have small: \"n < length ts\" using Cons.prems Suc by simp\n    have old: \"premise_branch n [] \\<in> rra_carrier (object_structure (premise_forest_syntax f ts))\"\n      by (rule Cons.IH[OF small])\n    have present: \"syntax_prefix 3 (premise_branch n []) \\<in>\n      syntax_prefix 3 ` rra_carrier (object_structure (premise_forest_syntax f ts))\"\n      by (rule imageI[OF old])\n    show ?thesis using present\n      by (simp only: Suc premise_branch.simps premise_forest_syntax.simps bound_union_def\n          structured_object.select_convs rra_structure.select_convs) blast\n  qed\nqed\n\nlocale schema_bodies =\n  fixes f :: \"'a \\<Rightarrow> local_address\" and p :: \"'a term_pattern\"\n    and ts :: \"('a,local_address option) premise_template list\"\n  assumes conclusion_formed: \"pattern_formed p\"\n    and templates_formed: \"\\<forall>t\\<in>set ts. template_formed t\"\n    and addressing: \"binder_addressing (schema_body_variables p ts) f\"\nbegin\n\nabbreviation body where \"body \\<equiv> schema_body_syntax f p ts\"\nabbreviation variables where \"variables \\<equiv> f ` schema_body_variables p ts\"\nabbreviation literals where \"literals \\<equiv> schema_body_literals p ts\"\nabbreviation callees where \"callees \\<equiv> schema_body_callees ts\"\n\nlemma conclusion_addressing: \"binder_addressing (pattern_variables p) f\"\n  by (rule binder_addressing_mono[OF addressing]) (auto simp: schema_body_variables_def)\n\nlemma premise_addressing: \"binder_addressing (template_list_variables ts) f\"\n  by (rule binder_addressing_mono[OF addressing]) (auto simp: schema_body_variables_def)\n\nlemma boundary: \"variables \\<subseteq> binder_addresses\"\n  using addressing by (simp add: binder_addressing_def)\n\nlemma conclusion_scope: \"f ` pattern_variables p \\<subseteq> variables\"\n  by (auto simp: schema_body_variables_def)\n\nlemma premise_scope: \"f ` template_list_variables ts \\<subseteq> variables\"\n  by (auto simp: schema_body_variables_def)\n\nlemma conclusion_code_formed: \"exact_formed (pattern_syntax f p)\"\n  by (rule pattern_syntax_formed[OF conclusion_formed conclusion_addressing])\n\nlemma premise_code_formed: \"exact_formed (premise_forest_syntax f ts)\"\n  by (rule premise_forest_formed[OF templates_formed premise_addressing])\n\nlemma formed: \"exact_formed body\"\n  unfolding schema_body_syntax_def\n  by (rule bound_union_formed[OF conclusion_code_formed premise_code_formed\n        pattern_syntax_silent premise_forest_silent])\n\nlemma silent: \"binder_silent body\"\n  unfolding schema_body_syntax_def\n  by (rule bound_union_silent[OF pattern_syntax_silent premise_forest_silent])\n\nlemma carrier:\n  \"rra_carrier (object_structure body) =\n    syntax_prefix 2 ` rra_carrier (object_structure (pattern_syntax f p)) \\<union>\n    syntax_prefix 3 ` rra_carrier (object_structure (premise_forest_syntax f ts))\"\n  by (simp add: schema_body_syntax_def bound_union_def)\n\nlemma variables_inside: \"variables \\<subseteq> rra_carrier (object_structure body)\"\nproof -\n  have pvars: \"f ` pattern_variables p \\<subseteq> rra_carrier (object_structure (pattern_syntax f p))\"\n    by (simp add: pattern_syntax_carrier[OF conclusion_addressing])\n  have tvars: \"f ` template_list_variables ts \\<subseteq> rra_carrier (object_structure (premise_forest_syntax f ts))\"\n    by (simp add: premise_forest_carrier[OF premise_addressing])\n  have pimage: \"syntax_prefix 2 ` (f ` pattern_variables p) \\<subseteq>\n    syntax_prefix 2 ` rra_carrier (object_structure (pattern_syntax f p))\"\n    by (rule image_mono[OF pvars])\n  have timage: \"syntax_prefix 3 ` (f ` template_list_variables ts) \\<subseteq>\n    syntax_prefix 3 ` rra_carrier (object_structure (premise_forest_syntax f ts))\"\n    by (rule image_mono[OF tvars])\n  have pfix: \"syntax_prefix 2 ` (f ` pattern_variables p) = f ` pattern_variables p\"\n    by (rule syntax_prefix_image_binders[OF subset_trans[OF conclusion_scope boundary]])\n  have tfix: \"syntax_prefix 3 ` (f ` template_list_variables ts) = f ` template_list_variables ts\"\n    by (rule syntax_prefix_image_binders[OF subset_trans[OF premise_scope boundary]])\n  show ?thesis using pimage timage\n    by (simp only: pfix tfix carrier schema_body_variables_def image_Un) blast\nqed\n\nlemma conclusion_inside: \"[2] \\<in> rra_carrier (object_structure body)\"\nproof -\n  have present: \"syntax_prefix 2 [] \\<in> syntax_prefix 2 ` rra_carrier (object_structure (pattern_syntax f p))\"\n    by (rule imageI[OF pattern_syntax_root])\n  show ?thesis using present by (simp add: carrier)\nqed\n\nlemma premise_roots_inside: \"set (schema_body_roots ts) \\<subseteq> rra_carrier (object_structure body)\"\n  using premise_forest_root_inside[of _ ts f]\n  by (auto simp: schema_body_roots_def carrier)\n\nlemma conclusion_reads:\n  \"object_reads_agree (push_object (syntax_prefix 2) (pattern_syntax f p)) body\n    (syntax_prefix 2 ` rra_carrier (object_structure (pattern_syntax f p)))\"\n  unfolding schema_body_syntax_def\n  by (rule bound_union_reads_left[OF pattern_syntax_no_counts premise_forest_silent])\n\nlemma premise_reads:\n  \"object_reads_agree (push_object (syntax_prefix 3) (premise_forest_syntax f ts)) body\n    (syntax_prefix 3 ` rra_carrier (object_structure (premise_forest_syntax f ts)))\"\n  unfolding schema_body_syntax_def\n  by (rule bound_union_reads_right[OF premise_forest_no_counts pattern_syntax_silent])\n\nlemma conclusion_recovers:\n  assumes ef: \"environment_formed E\" and source: \"artifact_at E u S\"\n    and reads: \"object_reads_agree body S (rra_carrier (object_structure body))\"\n    and refs: \"syntax_references E u literals callees\"\n  shows \"pattern_quoted_at E u variables [2] (rename_pattern f p)\n    (syntax_prefix 2 ` pattern_syntax_interior p) (syntax_prefix 2 ` rel_dom (pattern_literal_bindings p))\"\nproof -\n  have original: \"pattern_quoted_at (pattern_environment f p) None variables [] (rename_pattern f p)\n    (pattern_syntax_interior p) (rel_dom (pattern_literal_bindings p))\"\n    by (rule pattern_syntax_recovers[OF conclusion_formed conclusion_addressing conclusion_scope boundary])\n  have addr: \"finite_addressing (rra_carrier (object_structure (pattern_syntax f p))) (syntax_prefix 2)\"\n    by (rule syntax_prefix_addressing[OF conclusion_code_formed]) simp_all\n  have copied_reads: \"object_reads_agree (push_object (syntax_prefix 2) (pattern_syntax f p)) S\n    (syntax_prefix 2 ` rra_carrier (object_structure (pattern_syntax f p)))\"\n    by (rule object_reads_agree_extend[OF conclusion_reads reads])\n  have interior_bound: \"pattern_syntax_interior p \\<subseteq> rra_carrier (object_structure (pattern_syntax f p))\"\n    by (auto simp: pattern_syntax_carrier[OF conclusion_addressing])\n  have interior_reads: \"object_reads_agree (push_object (syntax_prefix 2) (pattern_syntax f p)) S\n    (syntax_prefix 2 ` pattern_syntax_interior p)\"\n    by (rule object_reads_agree_mono[OF copied_reads image_mono[OF interior_bound]])\n  have left_refs: \"syntax_references E u (map_slot_keys (syntax_prefix 2) (pattern_literal_bindings p)) callees\"\n    by (rule syntax_references_mono[OF refs]) (auto simp: schema_body_literals_def)\n  have slots: \"\\<forall>k\\<in>rel_dom (pattern_literal_bindings p).\n    external_slot_values (pattern_environment f p) None k = external_slot_values E u (syntax_prefix 2 k)\"\n    using reference_literal_fibre[OF left_refs pattern_literal_bindings_functional] by auto\n  have injective: \"inj (syntax_prefix 2)\" by (rule syntax_prefix_injective) simp\n  have copied: \"pattern_quoted_at E u (syntax_prefix 2 ` variables) (syntax_prefix 2 [])\n    (rename_pattern (syntax_prefix 2) (rename_pattern f p))\n    (syntax_prefix 2 ` pattern_syntax_interior p) (syntax_prefix 2 ` rel_dom (pattern_literal_bindings p))\"\n    by (rule pattern_quotation_transport[OF original pattern_environment_source addr interior_reads slots injective ef source])\n  show ?thesis using copied\n    by (simp only: syntax_prefix_root syntax_prefix_image_binders[OF boundary]\n        renamed_pattern_prefix[OF conclusion_addressing])\nqed\n\nlemma premises_recovers:\n  fixes E :: \"local_address option artifact_environment\"\n  assumes ef: \"environment_formed E\" and source: \"artifact_at E u S\"\n    and reads: \"object_reads_agree body S (rra_carrier (object_structure body))\"\n    and refs: \"syntax_references E u literals callees\"\n  shows \"\\<forall>i<length ts. \\<exists>I K. native_premise_at E u variables (schema_body_roots ts ! i)\n    (template_projection f (ts!i)) I K\"\nproof -\n  let ?R = \"premise_forest_syntax f ts\"\n  let ?z = \"clone_source_use E u\"\n  let ?F = \"clone_source_environment E u ?R (syntax_prefix 3) ?z\"\n  have fresh: \"?z \\<notin> environment_uses E\" by (rule clone_source_use_fresh[OF ef])\n  have ff: \"environment_formed ?F\" by (rule clone_environment_formed[OF ef premise_code_formed fresh])\n  have src: \"artifact_at ?F ?z ?R\" by (simp add: clone_artifact_iff)\n  have bounds: \"rel_dom (premise_forest_literals ts) \\<union> rel_dom (premise_forest_callees ts) \\<subseteq>\n    rra_carrier (object_structure ?R)\"\n    by (auto simp: premise_forest_carrier[OF premise_addressing])\n  have right_refs: \"syntax_references E u (map_slot_keys (syntax_prefix 3) (premise_forest_literals ts))\n    (map_slot_keys (syntax_prefix 3) (premise_forest_callees ts))\"\n    by (rule syntax_references_mono[OF refs]) (auto simp: schema_body_literals_def schema_body_callees_def)\n  have clone_refs: \"syntax_references ?F ?z (premise_forest_literals ts) (premise_forest_callees ts)\"\n    by (rule cloned_syntax_references[OF ef fresh bounds right_refs])\n  have originals: \"\\<forall>i<length ts. native_premise_at ?F ?z variables (premise_branch i [])\n    (template_projection f (ts!i)) (premise_branch i ` template_interior (ts!i))\n    (premise_branch i ` (rel_dom (template_literals (ts!i)) \\<union> rel_dom (template_callees (ts!i))))\"\n    by (rule premise_forest_recovers[OF templates_formed premise_addressing premise_scope boundary ff src clone_refs])\n  have addr: \"finite_addressing (rra_carrier (object_structure ?R)) (syntax_prefix 3)\"\n    by (rule syntax_prefix_addressing[OF premise_code_formed]) simp_all\n  have injective: \"inj (syntax_prefix 3)\" by (rule syntax_prefix_injective) simp\n  have copied_reads: \"object_reads_agree (push_object (syntax_prefix 3) ?R) S\n    (syntax_prefix 3 ` rra_carrier (object_structure ?R))\"\n    by (rule object_reads_agree_extend[OF premise_reads reads])\n  have copy: \"native_syntax_copy ?F ?z ?R E u S (syntax_prefix 3) (relocated_site ?z u (syntax_prefix 3))\"\n    by (rule clone_environment_is_native_copy[OF ef premise_code_formed fresh source injective addr copied_reads])\n  show ?thesis\n  proof (intro allI impI)\n    fix i assume index: \"i < length ts\"\n    have member: \"ts!i \\<in> set ts\" by (rule nth_mem[OF index])\n    have taddr: \"binder_addressing (template_variables (ts!i)) f\"\n      by (rule binder_addressing_mono[OF premise_addressing])\n         (use member in \\<open>auto simp: template_list_variables_def\\<close>)\n    have nonlocal: \"\\<forall>k d. (k,d) \\<in> template_callees (ts!i) \\<longrightarrow> fst d \\<noteq> ?z\"\n    proof (intro allI impI)\n      fix k d assume entry: \"(k,d) \\<in> template_callees (ts!i)\"\n      obtain j where in_forest: \"(j,d) \\<in> premise_forest_callees ts\"\n        using premise_forest_callee_origin[OF member entry] by blast\n      show \"fst d \\<noteq> ?z\" by (rule cloned_reference_site_outside[OF ef fresh clone_refs in_forest])\n    qed\n    have projection: \"map_native_premise (syntax_prefix 3) (relocated_site ?z u (syntax_prefix 3))\n      (template_projection f (ts!i)) = template_projection f (ts!i)\"\n      by (rule template_projection_prefix[OF taddr nonlocal])\n    have original: \"native_premise_at ?F ?z variables (premise_branch i [])\n      (template_projection f (ts!i)) (premise_branch i ` template_interior (ts!i))\n      (premise_branch i ` (rel_dom (template_literals (ts!i)) \\<union> rel_dom (template_callees (ts!i))))\"\n      using originals index by blast\n    show \"\\<exists>I K. native_premise_at E u variables (schema_body_roots ts ! i) (template_projection f (ts!i)) I K\"\n      using native_syntax_copy.copy_premise[OF copy original]\n      by (simp only: schema_body_root_nth[OF index] syntax_prefix_image_binders[OF boundary] projection) blast\n  qed\nqed\n\nend\n\nend\n",
