          "theory": "Factor_Root_Syntax",
          "source": "theory Factor_Root_Syntax\n  imports Factor_Reference_Forests Factor_Reference_Environments Factor_Packages\nbegin\n\nsection \\<open>A complete family of external occurrence citations\\<close>\n\nlocale root_family_construction =\n  fixes ds :: \"'u definition_site list\"\n  assumes addresses: \"\\<forall>d\\<in>set ds. octets_formed (snd d)\"\nbegin\n\nabbreviation children where \"children \\<equiv> map (\\<lambda>d. external_occurrence_syntax (snd d)) ds\"\nabbreviation body where \"body \\<equiv> syntax_forest children\"\nabbreviation ports where \"ports \\<equiv> family_ports (length ds)\"\nabbreviation nodes where \"nodes \\<equiv> map (\\<lambda>i. syntax_branch i []) [0..<length ds]\"\nabbreviation members where \"members \\<equiv> set (zip ports nodes)\"\nabbreviation tables where \"tables \\<equiv> map (\\<lambda>d. {([4],d)}) ds\"\nabbreviation callees where \"callees \\<equiv> syntax_forest_table tables\"\nabbreviation framed where \"framed \\<equiv> family_wrapper body [] members\"\n\nlemma children_formed: \"\\<forall>R\\<in>set children. exact_formed R\"\n  using addresses by (auto intro: external_occurrence_syntax_formed)\n\nlemma children_counts: \"\\<forall>R\\<in>set children. bag_count (object_data R) = (\\<lambda>_. 0)\"\n  by (simp add: external_occurrence_syntax_properties(2))\n\nlemma body_formed: \"exact_formed body\" by (rule syntax_forest_formed[OF children_formed])\n\nlemma member_domain: \"rel_dom members = set ports\" by (rule zip_domain) simp\nlemma member_range: \"rel_ran members = set nodes\" by (rule zip_range) simp\n\nlemma nodes_inside: \"set nodes \\<subseteq> rra_carrier (object_structure body)\"\nproof\n  fix a assume member: \"a \\<in> set nodes\"\n  obtain i where index: \"i < length ds\" \"a=syntax_branch i []\" using member by auto\n  have small: \"i < length children\" using index(1) by simp\n  have root: \"[] \\<in> rra_carrier (object_structure (children!i))\"\n    using index(1) by (simp add: external_occurrence_syntax_properties(1))\n  show \"a \\<in> rra_carrier (object_structure body)\"\n    using syntax_forest_child_inside[OF small root] index(2) by simp\nqed\n\nlemma headers_fresh: \"insert [] (rel_dom members) \\<inter> rra_carrier (object_structure body) = {}\"\n  by (simp only: member_domain) (auto simp: family_ports_def)\n\nlemma headers_separate: \"[] \\<notin> rel_dom members\"\n  by (simp only: member_domain) (auto simp: family_ports_def)\n\nlemma member_addresses: \"\\<forall>a\\<in>insert [] (rel_dom members \\<union> rel_ran members). octets_formed a\"\nproof -\n  have targets: \"\\<forall>a\\<in>rel_ran members. octets_formed a\"\n    using nodes_inside body_formed by (auto simp: member_range exact_formed_def)\n  show ?thesis using targets family_ports_formed[of \"length ds\"]\n    by (simp only: member_domain) (auto simp: octets_formed_def)\nqed\n\nlemma formed: \"exact_formed framed\"\n  by (rule family_wrapper_formed[OF body_formed _ member_addresses]) simp\n\nlemma family_read: \"family_at framed [] members\"\n  by (rule family_wrapper_fresh_recovers[OF body_formed formed _ _ headers_separate headers_fresh])\n     (simp_all add: single_valued_zip)\n\nlemma reads: \"object_reads_agree body framed (rra_carrier (object_structure body))\"\n  by (rule family_wrapper_reads) (use headers_fresh in blast)\n\nlemma reference_table: \"reference_table_formed {} callees\"\nproof -\n  let ?Ls = \"replicate (length ds) ({} :: (local_address \\<times> exact_artifact) set)\"\n  have singleton: \"\\<And>d. reference_table_formed ({} :: (local_address \\<times> exact_artifact) set) {([4],d)}\"\n    by (rule reference_table_callees) (auto simp: single_valued_def)\n  have len: \"length ?Ls = length tables\" by simp\n  have each: \"\\<forall>i<length ?Ls. reference_table_formed (?Ls!i) (tables!i)\" by (simp add: singleton)\n  show ?thesis using reference_table_forest[OF len each] by simp\nqed\n\nlemma reference_bounds: \"rel_dom callees \\<subseteq> rra_carrier (object_structure framed)\"\nproof -\n  have len: \"length tables = length children\" by simp\n  have each: \"\\<forall>i<length children. rel_dom (tables!i) \\<subseteq> rra_carrier (object_structure (children!i))\"\n    by (auto simp: external_occurrence_syntax_def rel_dom_def)\n  have body_bound: \"rel_dom callees \\<subseteq> rra_carrier (object_structure body)\"\n    by (rule syntax_forest_table_bounds[OF len each])\n  have inclusion: \"rra_carrier (object_structure body) \\<subseteq> rra_carrier (object_structure framed)\"\n    using reads by (simp add: object_reads_agree_def)\n  show ?thesis by (rule subset_trans[OF body_bound inclusion])\nqed\n\nlemma reference_range: \"rel_ran callees = set ds\"\n  by (simp only: syntax_forest_table_range) (auto simp: rel_ran_def)\n\nlemma locations:\n  assumes ef: \"environment_formed E\" and source: \"artifact_at E u framed\" and refs: \"syntax_references E u {} callees\"\n  shows \"\\<forall>i<length ds. located_at E u (nodes!i) (fst (ds!i)) (snd (ds!i))\"\nproof (intro allI impI)\n  fix i assume index: \"i < length ds\"\n  let ?d = \"ds!i\"\n  let ?R = \"external_occurrence_syntax (snd ?d)\"\n  have address: \"octets_formed (snd ?d)\" using addresses nth_mem[OF index] by blast\n  have rf: \"exact_formed ?R\" by (rule external_occurrence_syntax_formed[OF address])\n  have original: \"citation_at ?R [] (External [4] (snd ?d)) {[],[5]}\"\n    by (rule external_occurrence_syntax_recovers[OF address])\n  have addressing: \"finite_addressing (rra_carrier (object_structure ?R)) (syntax_branch i)\"\n    by (rule syntax_branch_addressing[OF rf])\n  have copied: \"citation_at (push_object (syntax_branch i) ?R) (syntax_branch i [])\n    (External (syntax_branch i [4]) (snd ?d)) (syntax_branch i ` {[],[5]})\"\n    using citation_at_push[OF original addressing] by simp\n  have small: \"i < length children\" using index by simp\n  have child_reads: \"object_reads_agree (push_object (syntax_branch i) ?R) body\n    (syntax_branch i ` rra_carrier (object_structure ?R))\"\n    using syntax_forest_child_reads[OF children_formed children_counts small] index by simp\n  have whole_reads: \"object_reads_agree (push_object (syntax_branch i) ?R) framed\n    (syntax_branch i ` rra_carrier (object_structure ?R))\"\n    by (rule object_reads_agree_extend[OF child_reads reads])\n  have interior: \"syntax_branch i ` {[],[5]} \\<subseteq> syntax_branch i ` rra_carrier (object_structure ?R)\"\n    by (rule image_mono) (simp add: external_occurrence_syntax_def)\n  have citation_reads: \"object_reads_agree (push_object (syntax_branch i) ?R) framed (syntax_branch i ` {[],[5]})\"\n    by (rule object_reads_agree_mono[OF whole_reads interior])\n  have citation: \"citation_at framed (syntax_branch i []) (External (syntax_branch i [4]) (snd ?d))\n    (syntax_branch i ` {[],[5]})\"\n    by (rule citation_at_read_transport[OF copied formed citation_reads])\n  have ti: \"i < length tables\" using index by simp\n  have entry: \"([4],?d) \\<in> tables!i\" using index by simp\n  have reference: \"(syntax_branch i [4],?d) \\<in> callees\" by (rule syntax_forest_table_member[OF ti entry])\n  have actual: \"binds_slot E u (syntax_branch i [4]) (fst ?d) \\<and>\n    (\\<exists>T. artifact_at E (fst ?d) T \\<and> anchor_formed (T,snd ?d))\"\n    using refs reference unfolding syntax_references_def by blast\n  have location: \"citation_location E u (External (syntax_branch i [4]) (snd ?d)) (fst ?d) (snd ?d)\"\n    using actual by simp\n  have located: \"located_at E u (syntax_branch i []) (fst ?d) (snd ?d)\"\n    using source citation location unfolding located_at_def by blast\n  show \"located_at E u (nodes!i) (fst ?d) (snd ?d)\" using located index by simp\nqed\n\ntheorem recovers:\n  assumes ef: \"environment_formed E\" and source: \"artifact_at E u framed\" and refs: \"syntax_references E u {} callees\"\n  shows \"native_root_family_at E u [] (set (zip ports ds))\"\nproof -\n  have finite: \"finite (set (zip ports ds))\" by simp\n  have functional: \"single_valued (set (zip ports ds))\" by (rule single_valued_zip) simp\n  have domain: \"rel_dom (set (zip ports ds)) = rel_dom members\"\n    using zip_domain[of ports ds] member_domain by simp\n  have each: \"\\<forall>s a. (s,a) \\<in> members \\<longrightarrow>\n    (\\<exists>d. (s,d) \\<in> set (zip ports ds) \\<and> located_at E u a (fst d) (snd d))\"\n  proof (intro allI impI)\n    fix s a assume entry: \"(s,a) \\<in> members\"\n    obtain i where index: \"i < length ports\" \"i < length nodes\" \"s=ports!i\" \"a=nodes!i\"\n      using entry by (auto simp: in_set_zip)\n    have small: \"i < length ds\" using index(1) by simp\n    have target: \"(s,ds!i) \\<in> set (zip ports ds)\" using index(1,3) small by (auto simp: in_set_zip)\n    have located: \"located_at E u a (fst (ds!i)) (snd (ds!i))\"\n      using locations[OF ef source refs] small index(4) by blast\n    show \"\\<exists>d. (s,d) \\<in> set (zip ports ds) \\<and> located_at E u a (fst d) (snd d)\"\n      using target located by blast\n  qed\n  show ?thesis using ef source family_read finite functional domain each unfolding native_root_family_at_def by blast\nqed\n\nend\n\ntheorem root_family_syntax_total:\n  assumes \"\\<forall>d\\<in>set ds. octets_formed (snd d)\"\n  shows \"\\<exists>R C. exact_formed R \\<and> reference_table_formed {} C \\<and>\n    rel_dom C \\<subseteq> rra_carrier (object_structure R) \\<and> rel_ran C = set ds \\<and>\n    (\\<forall>E u. environment_formed E \\<longrightarrow> artifact_at E u R \\<longrightarrow> syntax_references E u {} C \\<longrightarrow>\n      native_root_family_at E u [] (set (zip (family_ports (length ds)) ds)))\"\nproof -\n  interpret construction: root_family_construction ds by (rule root_family_construction.intro[OF assms])\n  show ?thesis by (rule exI[of _ construction.framed], rule exI[of _ construction.callees])\n    (use construction.formed construction.reference_table construction.reference_bounds construction.reference_range construction.recovers in blast)\nqed\n\ntext \\<open>\n  Every finite list of target sites has a complete structural citation family.\n  The family recovers actual target uses and addresses from its environment,\n  while every reference slot has a source citation. The empty list produces\n  an empty native root family. No definition names or semantic tags are stored.\n\\<close>\n\nend\n",
