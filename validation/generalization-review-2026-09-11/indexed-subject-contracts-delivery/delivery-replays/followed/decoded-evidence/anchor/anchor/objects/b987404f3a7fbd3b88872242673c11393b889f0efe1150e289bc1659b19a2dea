          "source": "theory Factor_Artifact_Comparison\n  imports Factor_Bag_Comparison Factor_Artifact_Values\nbegin\n\nsection \\<open>Equality of complete artifact presentations\\<close>\n\nlemma injective_mapped_multisets:\n  assumes injective: \"inj f\"\n  shows \"mset (map f xs)=mset (map f ys) \\<longleftrightarrow> mset xs=mset ys\"\nproof\n  assume same: \"mset (map f xs)=mset (map f ys)\"\n  have inverse: \"map (inv f) (map f zs)=zs\" for zs\n    by (simp add: map_map comp_def inv_f_f[OF injective])\n  have \"image_mset (inv f) (mset (map f xs))=image_mset (inv f) (mset (map f ys))\"\n    using same by simp\n  then show \"mset xs=mset ys\" by (simp only: mset_map[symmetric] inverse)\nnext\n  assume \"mset xs=mset ys\"\n  then show \"mset (map f xs)=mset (map f ys)\" by simp\nqed\n\ntheorem artifact_enumeration_multisets:\n  assumes left: \"artifact_enumeration R A E B F\"\n    and right: \"artifact_enumeration S A' E' B' F'\"\n  shows \"R=S \\<longleftrightarrow> mset A=mset A' \\<and> mset E=mset E' \\<and> mset B=mset B' \\<and> mset F=mset F'\"\nproof -\n  have distinct: \"distinct A\" \"distinct A'\" \"distinct E\" \"distinct E'\" \"distinct F\" \"distinct F'\"\n    using left right by (auto simp: artifact_enumeration_def)\n  have sources: \"R=enumerated_artifact A E B F\" \"S=enumerated_artifact A' E' B' F'\"\n    using left right by (auto simp: artifact_enumeration_def)\n  have same: \"R=S \\<longleftrightarrow> set A=set A' \\<and> set E=set E' \\<and> count_list B=count_list B' \\<and> set F=set F'\"\n    by (simp add: sources exact_identity_iff rra_identity basis_identity enumerated_artifact_def)\n  have counts: \"count_list B=count_list B' \\<longleftrightarrow> mset B=mset B'\"\n    by (simp add: fun_eq_iff multiset_eq_iff count_mset)\n  show ?thesis by (simp only: same counts set_eq_iff_mset_eq_distinct[OF distinct(1,2)]\n    set_eq_iff_mset_eq_distinct[OF distinct(3,4)] set_eq_iff_mset_eq_distinct[OF distinct(5,6)])\nqed\n\nabbreviation artifact_fields_term ::\n  \"factor_term \\<Rightarrow> factor_term \\<Rightarrow> factor_term \\<Rightarrow> factor_term \\<Rightarrow> factor_term\" where\n  \"artifact_fields_term a e b f \\<equiv> Pair_Term a (Pair_Term e (Pair_Term b f))\"\n\ndefinition artifact_comparison_schema :: \"(nat,nat,nat) factor_schema\" where\n  \"artifact_comparison_schema=data_rule\n    (Pattern_Pair\n      (Pattern_Pair (Pattern_Variable 0) (Pattern_Pair (Pattern_Variable 1)\n        (Pattern_Pair (Pattern_Variable 2) (Pattern_Variable 3))))\n      (Pattern_Pair (Pattern_Variable 4) (Pattern_Pair (Pattern_Variable 5)\n        (Pattern_Pair (Pattern_Variable 6) (Pattern_Variable 7)))))\n    {(0,6,Pattern_Pair (Pattern_Variable 0) (Pattern_Variable 4)),\n     (1,6,Pattern_Pair (Pattern_Variable 1) (Pattern_Variable 5)),\n     (2,6,Pattern_Pair (Pattern_Variable 2) (Pattern_Variable 6)),\n     (3,6,Pattern_Pair (Pattern_Variable 3) (Pattern_Variable 7))}\"\n\ndefinition artifact_comparison_system :: \"(nat,nat,nat,nat) schema_system\" where\n  \"artifact_comparison_system=add_view_definition bag_comparison_system 7 data_x {(0,artifact_comparison_schema)}\"\n\ninterpretation artifact_comparison_view: positive_view bag_comparison_system 7 data_x \"{(0,artifact_comparison_schema)}\"\n  by (rule positive_view.intro)\n    (auto simp: artifact_comparison_schema_def schema_formed_def schema_dependencies_def\n      single_valued_def rel_dom_def rel_ran_def)\n\nlemma artifact_comparison_system_formed [simp]: \"schema_system_formed artifact_comparison_system\"\n  using artifact_comparison_view.formed by (simp only: artifact_comparison_system_def)\n\nlemma artifact_comparison_definitions [simp]:\n  \"system_definitions artifact_comparison_system={0,1,2,3,4,5,6,7}\"\n  by (auto simp: artifact_comparison_system_def)\n\nlemma artifact_comparison_call:\n  \"schema_call_formed artifact_comparison_system 7 t \\<longleftrightarrow> term_formed t\"\n  using artifact_comparison_view.view_call[of t] by (simp add: artifact_comparison_system_def)\n\ntheorem artifact_comparison_old_meaning:\n  assumes \"d\\<in>{0,1,2,3,4,5,6}\"\n  shows \"(d,t)\\<in>positive_meaning artifact_comparison_system \\<longleftrightarrow>\n    (d,t)\\<in>positive_meaning bag_comparison_system\"\n  using artifact_comparison_view.old_meaning[of d t] assms by (simp add: artifact_comparison_system_def)\n\nlemma artifact_comparison_clause [simp]:\n  \"((7,c),S)\\<in>system_clauses artifact_comparison_system \\<longleftrightarrow> c=0 \\<and> S=artifact_comparison_schema\"\n  using artifact_comparison_view.no_old_clause[of c S] by (auto simp: artifact_comparison_system_def)\n\ntheorem artifact_comparison_fields:\n  \"(7,Pair_Term (artifact_fields_term a e b f) (artifact_fields_term a' e' b' f'))\n    \\<in>positive_meaning artifact_comparison_system \\<longleftrightarrow>\n    (6,Pair_Term a a')\\<in>positive_meaning bag_comparison_system \\<and>\n    (6,Pair_Term e e')\\<in>positive_meaning bag_comparison_system \\<and>\n    (6,Pair_Term b b')\\<in>positive_meaning bag_comparison_system \\<and>\n    (6,Pair_Term f f')\\<in>positive_meaning bag_comparison_system\"\nproof\n  assume holds: \"(7,Pair_Term (artifact_fields_term a e b f) (artifact_fields_term a' e' b' f'))\n    \\<in>positive_meaning artifact_comparison_system\"\n  have consequence: \"(7,Pair_Term (artifact_fields_term a e b f) (artifact_fields_term a' e' b' f'))\n    \\<in>schema_consequences artifact_comparison_system (positive_meaning artifact_comparison_system)\"\n    using holds positive_meaning_unfold[of artifact_comparison_system] by blast\n  obtain c S v where clause: \"((7,c),S)\\<in>system_clauses artifact_comparison_system\"\n    and head: \"Pair_Term (artifact_fields_term a e b f) (artifact_fields_term a' e' b' f')=\n      evaluate_pattern v (schema_conclusion S)\"\n    and support: \"\\<forall>s d p. (s,d,p)\\<in>schema_premises S \\<longrightarrow>\n      (d,evaluate_pattern v p)\\<in>positive_meaning artifact_comparison_system\"\n    using schema_consequences_valuationD[OF consequence] by blast\n  have schema: \"S=artifact_comparison_schema\" using clause by simp\n  have fields: \"v 0=a\" \"v 1=e\" \"v 2=b\" \"v 3=f\" \"v 4=a'\" \"v 5=e'\" \"v 6=b'\" \"v 7=f'\"\n    using head by (auto simp: schema artifact_comparison_schema_def)\n  show \"(6,Pair_Term a a')\\<in>positive_meaning bag_comparison_system \\<and>\n    (6,Pair_Term e e')\\<in>positive_meaning bag_comparison_system \\<and>\n    (6,Pair_Term b b')\\<in>positive_meaning bag_comparison_system \\<and>\n    (6,Pair_Term f f')\\<in>positive_meaning bag_comparison_system\"\n    using support artifact_comparison_old_meaning[of 6]\n    by (auto simp: schema artifact_comparison_schema_def fields[simplified])\nnext\n  assume comparisons: \"(6,Pair_Term a a')\\<in>positive_meaning bag_comparison_system \\<and>\n    (6,Pair_Term e e')\\<in>positive_meaning bag_comparison_system \\<and>\n    (6,Pair_Term b b')\\<in>positive_meaning bag_comparison_system \\<and>\n    (6,Pair_Term f f')\\<in>positive_meaning bag_comparison_system\"\n  have formed: \"term_formed a\" \"term_formed e\" \"term_formed b\" \"term_formed f\"\n    \"term_formed a'\" \"term_formed e'\" \"term_formed b'\" \"term_formed f'\"\n    using comparisons by (auto dest: positive_meaning_formed simp: bag_comparison_call)\n  have lifted: \"(6,Pair_Term a a')\\<in>positive_meaning artifact_comparison_system\"\n    \"(6,Pair_Term e e')\\<in>positive_meaning artifact_comparison_system\"\n    \"(6,Pair_Term b b')\\<in>positive_meaning artifact_comparison_system\"\n    \"(6,Pair_Term f f')\\<in>positive_meaning artifact_comparison_system\"\n    using comparisons artifact_comparison_old_meaning[of 6] by auto\n  let ?v=\"\\<lambda>i::nat. if i=0 then a else if i=1 then e else if i=2 then b else if i=3 then f\n    else if i=4 then a' else if i=5 then e' else if i=6 then b' else f'\"\n  have result: \"(7,evaluate_pattern ?v (schema_conclusion artifact_comparison_schema))\n    \\<in>positive_meaning artifact_comparison_system\"\n    by (rule ordinary_positive_valuation_step[where c=0])\n      (use formed lifted in \\<open>auto simp: artifact_comparison_schema_def schema_variables_def artifact_comparison_call\\<close>)\n  show \"(7,Pair_Term (artifact_fields_term a e b f) (artifact_fields_term a' e' b' f'))\n    \\<in>positive_meaning artifact_comparison_system\"\n    using result by (simp add: artifact_comparison_schema_def)\nqed\n\ntheorem artifact_comparison_exact:\n  assumes left: \"artifact_value_presents R x\" and right: \"artifact_value_presents S y\"\n  shows \"(7,Pair_Term x y)\\<in>positive_meaning artifact_comparison_system \\<longleftrightarrow> R=S\"\nproof -\n  obtain A E B F where first: \"artifact_enumeration R A E B F\" \"x=artifact_data_term A E B F\"\n    using left unfolding artifact_value_presents_def by blast\n  obtain A' E' B' F' where second: \"artifact_enumeration S A' E' B' F'\" \"y=artifact_data_term A' E' B' F'\"\n    using right unfolding artifact_value_presents_def by blast\n  have fields: \"data_elements (map Payload_Term A)\" \"data_elements (map incidence_data E)\"\n    \"data_elements (map address_pair_data B)\" \"data_elements (map address_pair_data F)\"\n    \"data_elements (map Payload_Term A')\" \"data_elements (map incidence_data E')\"\n    \"data_elements (map address_pair_data B')\" \"data_elements (map address_pair_data F')\"\n    using artifact_data_term_formed[OF first(1)] artifact_data_term_formed[OF second(1)]\n      artifact_data_term_self_contained[of A E B F] artifact_data_term_self_contained[of A' E' B' F']\n    by (auto simp: artifact_data_term_def data_list_term_formed data_list_term_self_contained)\n  have payload_injective: \"inj Payload_Term\" by (rule injI) simp\n  have comparison: \"(7,Pair_Term x y)\\<in>positive_meaning artifact_comparison_system \\<longleftrightarrow>\n    mset A=mset A' \\<and> mset E=mset E' \\<and> mset B=mset B' \\<and> mset F=mset F'\"\n    using fields\n    by (simp only: first(2) second(2) artifact_data_term_def artifact_comparison_fields bag_comparison_lists\n      injective_mapped_multisets[OF payload_injective]\n      injective_mapped_multisets[OF incidence_data_injective]\n      injective_mapped_multisets[OF address_pair_data_injective]; blast)\n  show ?thesis using comparison artifact_enumeration_multisets[OF first(1) second(1)] by blast\nqed\n\ncorollary artifact_comparison_presentation_invariance:\n  assumes \"artifact_value_presents R x\" \"artifact_value_presents R x'\"\n    \"artifact_value_presents S y\" \"artifact_value_presents S y'\"\n  shows \"(7,Pair_Term x y)\\<in>positive_meaning artifact_comparison_system \\<longleftrightarrow>\n    (7,Pair_Term x' y')\\<in>positive_meaning artifact_comparison_system\"\n  using artifact_comparison_exact[OF assms(1,3)] artifact_comparison_exact[OF assms(2,4)] by blast\n\ntheorem native_artifact_comparison:\n  \"\\<exists>E :: local_address option artifact_environment. \\<exists>pu Q d. closed_native_package_at E pu [] Q \\<and>\n    (\\<forall>R S x y. artifact_value_presents R x \\<longrightarrow> artifact_value_presents S y \\<longrightarrow>\n      (\\<exists>F au I K. environment_formed F \\<and> environment_included E F \\<and> au\\<notin>environment_uses E \\<and>\n        native_package_at F pu [] Q \\<and> native_application_at F au [] d (Pair_Term x y) I K \\<and>\n        native_package_environment F pu []=E \\<and> native_application_formed F pu [] au [] \\<and>\n        (native_positive_holds F pu [] au [] \\<longleftrightarrow> R=S)))\"\nproof -\n  obtain g :: \"nat \\<Rightarrow> local_address option definition_site\"\n    and E :: \"local_address option artifact_environment\" and pu Q\n    where closed: \"closed_native_package_at E pu [] Q\"\n    and future: \"\\<forall>d\\<in>system_definitions artifact_comparison_system. \\<forall>t. term_formed t \\<longrightarrow>\n      (\\<exists>F au I K. environment_formed F \\<and> environment_included E F \\<and> au\\<notin>environment_uses E \\<and>\n        native_package_at F pu [] Q \\<and> native_application_at F au [] (g d) t I K \\<and>\n        native_package_environment F pu []=E \\<and>\n        (native_application_formed F pu [] au [] \\<longleftrightarrow> schema_call_formed artifact_comparison_system d t) \\<and>\n        (native_positive_holds F pu [] au [] \\<longleftrightarrow> (d,t)\\<in>positive_meaning artifact_comparison_system) \\<and>\n        (\\<forall>v\\<in>environment_uses E. \\<forall>R. artifact_at F v R \\<longleftrightarrow> artifact_at E v R) \\<and>\n        (\\<forall>v\\<in>environment_uses E. \\<forall>k w. binds_slot F v k w \\<longleftrightarrow> binds_slot E v k w))\"\n    using compiled_program_future_applications[OF artifact_comparison_system_formed] by blast\n  have member: \"7\\<in>system_definitions artifact_comparison_system\" by simp\n  show ?thesis\n  proof (rule exI[of _ E], rule exI[of _ pu], rule exI[of _ Q], rule exI[of _ \"g 7\"], intro conjI allI impI)\n    show \"closed_native_package_at E pu [] Q\" by (rule closed)\n  next\n    fix R S x y assume left: \"artifact_value_presents R x\" and right: \"artifact_value_presents S y\"\n    have tf: \"term_formed (Pair_Term x y)\"\n      using artifact_value_presents_formed[OF left] artifact_value_presents_formed[OF right] by simp\n    obtain F au I K where parts: \"environment_formed F\" \"environment_included E F\" \"au\\<notin>environment_uses E\"\n      \"native_package_at F pu [] Q\" \"native_application_at F au [] (g 7) (Pair_Term x y) I K\"\n      \"native_package_environment F pu []=E\"\n      \"native_application_formed F pu [] au [] \\<longleftrightarrow> schema_call_formed artifact_comparison_system 7 (Pair_Term x y)\"\n      \"native_positive_holds F pu [] au [] \\<longleftrightarrow> (7,Pair_Term x y)\\<in>positive_meaning artifact_comparison_system\"\n      using future[rule_format, OF member tf] by blast\n    show \"\\<exists>F au I K. environment_formed F \\<and> environment_included E F \\<and> au\\<notin>environment_uses E \\<and>\n      native_package_at F pu [] Q \\<and> native_application_at F au [] (g 7) (Pair_Term x y) I K \\<and>\n      native_package_environment F pu []=E \\<and> native_application_formed F pu [] au [] \\<and>\n      (native_positive_holds F pu [] au [] \\<longleftrightarrow> R=S)\"\n      by (rule exI[of _ F], rule exI[of _ au], rule exI[of _ I], rule exI[of _ K])\n        (use parts tf artifact_comparison_exact[OF left right]\n          in \\<open>auto simp: artifact_comparison_call\\<close>)\n  qed\nqed\n\ntext \\<open>\n  One ordinary definition compares the four supplied artifact fields through\n  four separately identified calls to the bag program. The exact-identity\n  theorem covers every complete presentation of both artifacts. Set fields\n  have distinct source entries; their bag comparisons therefore recover set\n  equality. The counted field retains all repetitions. The address, incidence,\n  and attachment encodings are injective, so no original coordinate or opaque\n  value is identified with a different one.\n\n  This comparison gives exact artifact equality, including across different\n  enumeration orders. It does not identify readdressed isomorphic artifacts.\n  Its four-field rule is not an artifact-admission checker: the theorem assumes\n  complete formed artifact presentations, and other proper data-field tuples\n  can satisfy the displayed rule. All old meanings remain fixed. A single\n  closed native program serves every future pair of presented artifacts.\n\\<close>\n\nend\n",
