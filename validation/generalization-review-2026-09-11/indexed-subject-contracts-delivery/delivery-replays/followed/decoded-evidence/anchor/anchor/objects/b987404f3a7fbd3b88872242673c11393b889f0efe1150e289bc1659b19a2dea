          "theory": "Factor_Observation_Results",
          "source": "theory Factor_Observation_Results\n  imports Factor_Observation_Result_Clauses Factor_Observation_Presentations\nbegin\n\nsection \\<open>The public operations compare the sets of computed result rows\\<close>\n\nlemma observation_profile_result_lists:\n  \"(302,context_relation_argument (Pair_Term (data_list_term F) c)\n    (data_list_term (map observation_row_term rows)) (data_list_term output))\\<in>positive_meaning observation_result_system\n    \\<longleftrightarrow> data_elements F \\<and> observation_datum c \\<and> observation_rows_data rows \\<and>\n      data_elements output \\<and> set output=set (map observation_value_term (observation_profile_list F rows c))\"\nproof -\n  let ?input=\"data_list_term (map observation_row_term rows)\"\n  let ?value=\"data_list_term (map observation_value_term (observation_profile_list F rows c))\"\n  have computation: \"(301,context_relation_argument (Pair_Term (data_list_term F) c) ?input w)\\<in>positive_meaning observation_result_system\\<longleftrightarrow>\n      (data_elements F \\<and> observation_datum c \\<and> observation_rows_data rows) \\<and> w=?value\" for w\n    by (simp only: observation_result_components observation_encoded_profile conj_assoc)\n  have comparison: \"(219,Pair_Term ?value (data_list_term output))\\<in>positive_meaning observation_result_system \\<longleftrightarrow>\n      data_elements output \\<and> set output=set (map observation_value_term (observation_profile_list F rows c))\"\n    if valid: \"data_elements F \\<and> observation_datum c \\<and> observation_rows_data rows\"\n  proof -\n    have rows: \"observation_rows_data rows\" using valid by blast\n    have data: \"data_elements (map observation_value_term (observation_profile_list F rows c))\"\n      by (rule observation_profile_data[OF rows])\n    show ?thesis using data\n      by (simp only: observation_result_components data_set_comparison_lists) auto\n  qed\n  show ?thesis using observation_profile_comparison.at_determined_result[OF computation comparison]\n    by blast\nqed\n\nlemma observation_losses_result_lists:\n  \"(307,context_relation_argument (Pair_Term (data_list_term F) (Pair_Term c d))\n    (data_list_term (map observation_row_term rows)) (data_list_term output))\\<in>positive_meaning observation_result_system\n    \\<longleftrightarrow> data_elements F \\<and> data_elements [c,d] \\<and> observation_rows_data rows \\<and>\n      data_elements output \\<and> set output=set (map observation_value_term (observation_losses_list F rows c d))\"\nproof -\n  let ?input=\"data_list_term (map observation_row_term rows)\"\n  let ?value=\"data_list_term (map observation_value_term (observation_losses_list F rows c d))\"\n  have computation: \"(306,context_relation_argument (Pair_Term (data_list_term F) (Pair_Term c d)) ?input w)\\<in>positive_meaning observation_result_system\\<longleftrightarrow>\n      (data_elements F \\<and> data_elements [c,d] \\<and> observation_rows_data rows) \\<and> w=?value\" for w\n    by (simp only: observation_result_components observation_encoded_losses conj_assoc)\n  have comparison: \"(219,Pair_Term ?value (data_list_term output))\\<in>positive_meaning observation_result_system \\<longleftrightarrow>\n      data_elements output \\<and> set output=set (map observation_value_term (observation_losses_list F rows c d))\"\n    if valid: \"data_elements F \\<and> data_elements [c,d] \\<and> observation_rows_data rows\"\n  proof -\n    have rows: \"observation_rows_data rows\" using valid by blast\n    have data: \"data_elements (map observation_value_term (observation_losses_list F rows c d))\"\n      using observation_profile_data[OF rows, of F c] by (auto simp: observation_losses_list_def)\n    show ?thesis using data\n      by (simp only: observation_result_components data_set_comparison_lists) auto\n  qed\n  show ?thesis using observation_losses_comparison.at_determined_result[OF computation comparison]\n    by blast\nqed\n\nlemma observation_value_term_injective: \"inj observation_value_term\"\n  by (auto simp: inj_on_def split: prod.splits)\n\nlemma observation_values_comparison:\n  assumes \"\\<forall>(f,w)\\<in>set xs. data_elements [f,w]\"\n  shows \"(219,Pair_Term (data_list_term (map observation_value_term xs)) q)\n      \\<in>positive_meaning data_set_comparison_system \\<longleftrightarrow>\n    observation_values_presents (fset_of_list xs) q\"\nproof -\n  have data: \"term_formed (observation_value_term z) \\<and> self_contained_term (observation_value_term z)\"\n    if \"case z of (f,w) \\<Rightarrow> data_elements [f,w]\" for z\n    using that by (cases z) auto\n  show ?thesis\n    using data_set_comparison_to_list_fset[OF observation_value_term_injective assms data, of q]\n    by (simp only: observation_value_graph)\nqed\n\nlemma observation_profile_values_data:\n  assumes \"observation_rows_data rows\"\n  shows \"\\<forall>(f,w)\\<in>set (observation_profile_list F rows c). data_elements [f,w]\"\n  using assms by (auto simp: observation_profile_list_def split: prod.splits)\n\nlemma observation_losses_values_data:\n  assumes \"observation_rows_data rows\"\n  shows \"\\<forall>(f,w)\\<in>set (observation_losses_list F rows c d). data_elements [f,w]\"\n  using observation_profile_values_data[OF assms, of F c]\n  by (auto simp: observation_losses_list_def split: prod.splits)\n\nlemma observation_profile_result_encoded:\n  \"(302,context_relation_argument (Pair_Term (data_list_term F) c)\n    (data_list_term (map observation_row_term rows)) q)\\<in>positive_meaning observation_result_system \\<longleftrightarrow>\n    data_elements F \\<and> observation_datum c \\<and> observation_rows_data rows \\<and>\n    observation_values_presents (finite_candidate_profile (fset_of_list F) (fset_of_list rows) c) q\"\nproof -\n  let ?input=\"data_list_term (map observation_row_term rows)\"\n  let ?value=\"data_list_term (map observation_value_term (observation_profile_list F rows c))\"\n  have computation: \"(301,context_relation_argument (Pair_Term (data_list_term F) c) ?input w)\\<in>positive_meaning observation_result_system\\<longleftrightarrow>\n      (data_elements F \\<and> observation_datum c \\<and> observation_rows_data rows) \\<and> w=?value\" for w\n    by (simp only: observation_result_components observation_encoded_profile conj_assoc)\n  have comparison: \"(219,Pair_Term ?value q)\\<in>positive_meaning observation_result_system \\<longleftrightarrow>\n      observation_values_presents (finite_candidate_profile (fset_of_list F) (fset_of_list rows) c) q\"\n    if valid: \"data_elements F \\<and> observation_datum c \\<and> observation_rows_data rows\"\n  proof -\n    have rows: \"observation_rows_data rows\" using valid by blast\n    show ?thesis using observation_values_comparison[OF observation_profile_values_data[OF rows, of F c], of q]\n      by (simp only: observation_result_components observation_profile_list_fset)\n  qed\n  show ?thesis using observation_profile_comparison.at_determined_result[OF computation comparison]\n    by blast\nqed\n\nlemma observation_losses_result_encoded:\n  \"(307,context_relation_argument (Pair_Term (data_list_term F) (Pair_Term c d))\n    (data_list_term (map observation_row_term rows)) q)\\<in>positive_meaning observation_result_system \\<longleftrightarrow>\n    data_elements F \\<and> data_elements [c,d] \\<and> observation_rows_data rows \\<and>\n    observation_values_presents (finite_candidate_losses (fset_of_list F) (fset_of_list rows) c d) q\"\nproof -\n  let ?input=\"data_list_term (map observation_row_term rows)\"\n  let ?value=\"data_list_term (map observation_value_term (observation_losses_list F rows c d))\"\n  have computation: \"(306,context_relation_argument (Pair_Term (data_list_term F) (Pair_Term c d)) ?input w)\\<in>positive_meaning observation_result_system\\<longleftrightarrow>\n      (data_elements F \\<and> data_elements [c,d] \\<and> observation_rows_data rows) \\<and> w=?value\" for w\n    by (simp only: observation_result_components observation_encoded_losses conj_assoc)\n  have comparison: \"(219,Pair_Term ?value q)\\<in>positive_meaning observation_result_system \\<longleftrightarrow>\n      observation_values_presents (finite_candidate_losses (fset_of_list F) (fset_of_list rows) c d) q\"\n    if valid: \"data_elements F \\<and> data_elements [c,d] \\<and> observation_rows_data rows\"\n  proof -\n    have rows: \"observation_rows_data rows\" using valid by blast\n    show ?thesis using observation_values_comparison[OF observation_losses_values_data[OF rows, of F c d], of q]\n      by (simp only: observation_result_components observation_losses_list_fset)\n  qed\n  show ?thesis using observation_losses_comparison.at_determined_result[OF computation comparison]\n    by blast\nqed\n\nend\n",
