          "theory": "Factor_Reference_Tables",
          "source": "theory Factor_Reference_Tables\n  imports Factor_Schema_Bodies\nbegin\n\nsection \\<open>Finite compatible reference tables generated by syntax construction\\<close>\n\ndefinition reference_table_formed ::\n  \"(local_address \\<times> exact_artifact) set \\<Rightarrow> (local_address \\<times> 'a) set \\<Rightarrow> bool\" where\n  \"reference_table_formed L C \\<longleftrightarrow> finite (socket_sum L C) \\<and>\n    single_valued (socket_sum L C) \\<and> (\\<forall>k R. (k,R) \\<in> L \\<longrightarrow> exact_formed R)\"\n\nlemma reference_table_properties:\n  assumes \"reference_table_formed L C\"\n  shows \"finite L\" \"finite C\" \"single_valued L\" \"single_valued C\"\n    \"rel_dom L \\<inter> rel_dom C = {}\" \"\\<forall>k R. (k,R) \\<in> L \\<longrightarrow> exact_formed R\"\n  using assms by (auto simp only: reference_table_formed_def socket_sum_finite socket_sum_single_valued)\n\nlemma reference_table_empty [simp]: \"reference_table_formed {} {}\"\n  by (simp only: reference_table_formed_def socket_sum_finite socket_sum_single_valued)\n     (simp add: single_valued_def)\n\nlemma reference_table_literals:\n  assumes \"finite L\" \"single_valued L\" \"\\<forall>k R. (k,R) \\<in> L \\<longrightarrow> exact_formed R\"\n  shows \"reference_table_formed L {}\"\n  using assms by (simp only: reference_table_formed_def socket_sum_finite socket_sum_single_valued)\n     (simp add: single_valued_def)\n\nlemma reference_table_callees:\n  assumes \"finite C\" \"single_valued C\"\n  shows \"reference_table_formed {} C\"\n  using assms by (simp only: reference_table_formed_def socket_sum_finite socket_sum_single_valued)\n     (simp add: single_valued_def)\n\nlemma mapped_reference_sum:\n  \"socket_sum (map_slot_keys f L) (map_slot_keys f C) = map_slot_keys f (socket_sum L C)\"\n  by (simp add: socket_sum_def map_slot_keys_def image_Un image_image split_def)\n\nlemma reference_table_map:\n  assumes formed: \"reference_table_formed L C\" and injective: \"inj f\"\n  shows \"reference_table_formed (map_slot_keys f L) (map_slot_keys f C)\"\nproof -\n  have sv: \"single_valued (socket_sum L C)\" and fin: \"finite (socket_sum L C)\"\n    using formed by (auto simp: reference_table_formed_def)\n  have inj: \"inj_on f (rel_dom (socket_sum L C))\" using injective by (auto simp: inj_on_def)\n  have mapped: \"single_valued (map_slot_keys f (socket_sum L C))\"\n    using single_valued_pair_image[OF sv inj, where g=id] by (simp add: map_slot_keys_def)\n  show ?thesis using mapped fin formed\n    by (simp only: reference_table_formed_def mapped_reference_sum) (auto simp: map_slot_keys_def)\nqed\n\nlemma socket_sum_unions:\n  \"socket_sum (L\\<union>A) (C\\<union>B) = socket_sum L C \\<union> socket_sum A B\"\n  by (auto simp: socket_sum_def)\n\nlemma reference_table_union:\n  assumes first: \"reference_table_formed L C\" and second: \"reference_table_formed A B\"\n    and separate: \"(rel_dom L \\<union> rel_dom C) \\<inter> (rel_dom A \\<union> rel_dom B) = {}\"\n  shows \"reference_table_formed (L\\<union>A) (C\\<union>B)\"\nproof -\n  have lsv: \"single_valued (socket_sum L C)\" and rsv: \"single_valued (socket_sum A B)\"\n    using first second by (auto simp: reference_table_formed_def)\n  have disjoint: \"rel_dom (socket_sum L C) \\<inter> rel_dom (socket_sum A B) = {}\"\n    using separate by simp\n  have cross: \"\\<forall>x y z. (x,y) \\<in> socket_sum L C \\<longrightarrow> (x,z) \\<in> socket_sum A B \\<longrightarrow> y=z\"\n  proof (intro allI impI)\n    fix x y z assume left: \"(x,y) \\<in> socket_sum L C\" and right: \"(x,z) \\<in> socket_sum A B\"\n    have a: \"x \\<in> rel_dom (socket_sum L C)\" by (rule rel_domI[OF left])\n    have b: \"x \\<in> rel_dom (socket_sum A B)\" by (rule rel_domI[OF right])\n    show \"y=z\" using disjoint a b by blast\n  qed\n  have sv: \"single_valued (socket_sum L C \\<union> socket_sum A B)\"\n    using single_valued_union_iff[OF lsv rsv] cross by blast\n  show ?thesis using first second sv\n    by (auto simp: reference_table_formed_def socket_sum_unions)\nqed\n\nlemma reference_table_prefix_union:\n  assumes first: \"reference_table_formed L C\" and second: \"reference_table_formed A B\"\n    and left_boundary: \"(rel_dom L \\<union> rel_dom C) \\<inter> binder_addresses = {}\"\n    and right_boundary: \"(rel_dom A \\<union> rel_dom B) \\<inter> binder_addresses = {}\"\n  shows \"reference_table_formed\n    (map_slot_keys (syntax_prefix 2) L \\<union> map_slot_keys (syntax_prefix 3) A)\n    (map_slot_keys (syntax_prefix 2) C \\<union> map_slot_keys (syntax_prefix 3) B)\"\nproof -\n  have left_inj: \"inj (syntax_prefix 2)\" and right_inj: \"inj (syntax_prefix 3)\"\n    by (rule syntax_prefix_injective, simp)+\n  have left: \"reference_table_formed (map_slot_keys (syntax_prefix 2) L) (map_slot_keys (syntax_prefix 2) C)\"\n    by (rule reference_table_map[OF first left_inj])\n  have right: \"reference_table_formed (map_slot_keys (syntax_prefix 3) A) (map_slot_keys (syntax_prefix 3) B)\"\n    by (rule reference_table_map[OF second right_inj])\n  have separate: \"(rel_dom (map_slot_keys (syntax_prefix 2) L) \\<union> rel_dom (map_slot_keys (syntax_prefix 2) C)) \\<inter>\n    (rel_dom (map_slot_keys (syntax_prefix 3) A) \\<union> rel_dom (map_slot_keys (syntax_prefix 3) B)) = {}\"\n    by (simp only: map_slot_keys_domain image_Un[symmetric]\n        syntax_prefix_image_outside[OF left_boundary] syntax_prefix_image_outside[OF right_boundary]) auto\n  show ?thesis by (rule reference_table_union[OF left right separate])\nqed\n\nlemma template_reference_table:\n  assumes formed: \"template_formed t\"\n  shows \"reference_table_formed (template_literals t) (template_callees t)\"\nproof (cases t)\n  case (Inl dp)\n  obtain d p where shape: \"dp=(d,p)\" by (cases dp)\n  have pf: \"pattern_formed p\" using formed Inl shape by simp\n  have literal_targets: \"\\<forall>k R. (k,R) \\<in> pattern_literal_bindings p \\<longrightarrow> exact_formed R\"\n    by (rule pattern_literal_bindings_formed[OF pf])\n  have base: \"reference_table_formed (pattern_literal_bindings p) {}\"\n    by (rule reference_table_literals[OF pattern_literal_bindings_finite pattern_literal_bindings_functional literal_targets])\n  have left: \"reference_table_formed (map_slot_keys (Cons 3) (pattern_literal_bindings p)) {}\"\n    using reference_table_map[OF base, of \"Cons 3\"] by (simp add: map_slot_keys_def)\n  have right: \"reference_table_formed {} {([2,4],d)}\"\n    by (rule reference_table_callees) (auto simp: single_valued_def)\n  have separate: \"(rel_dom (map_slot_keys (Cons 3) (pattern_literal_bindings p)) \\<union> rel_dom {}) \\<inter>\n    (rel_dom {} \\<union> rel_dom {([2,4],d)}) = {}\"\n    by (auto simp: map_slot_keys_def rel_dom_def)\n  show ?thesis using reference_table_union[OF left right separate] by (simp add: Inl shape)\nnext\n  case (Inr M)\n  have fields: \"\\<forall>p\\<in>set (material_fields M). pattern_formed p\"\n    using formed Inr by (simp add: material_pattern_formed_def)\n  have literal_targets: \"\\<forall>k R. (k,R) \\<in> pattern_forest_bindings (material_fields M) \\<longrightarrow> exact_formed R\"\n    by (rule pattern_forest_bindings_formed[OF fields])\n  show ?thesis by (simp only: Inr template_literals.simps template_callees.simps)\n    (rule reference_table_literals[OF pattern_forest_bindings_finite pattern_forest_bindings_functional literal_targets])\nqed\n\nlemma premise_forest_reference_table:\n  assumes formed: \"\\<forall>t\\<in>set ts. template_formed t\"\n  shows \"reference_table_formed (premise_forest_literals ts) (premise_forest_callees ts)\"\n  using formed\nproof (induction ts)\n  case Nil\n  show ?case by simp\nnext\n  case (Cons t ts)\n  have head: \"reference_table_formed (template_literals t) (template_callees t)\"\n    by (rule template_reference_table) (use Cons.prems in simp)\n  have tail: \"reference_table_formed (premise_forest_literals ts) (premise_forest_callees ts)\"\n    by (rule Cons.IH) (use Cons.prems in simp)\n  show ?case by (simp only: premise_forest_literals.simps premise_forest_callees.simps)\n    (rule reference_table_prefix_union[OF head tail template_reference_slots_outside premise_forest_reference_slots_outside])\nqed\n\nlemma template_callee_range_left:\n  \"rel_ran (template_callees (Inl dp)) = {fst dp}\"\n  by (cases dp) (auto simp: rel_ran_def)\n\nlemma premise_forest_callee_range:\n  \"rel_ran (premise_forest_callees ts) = (\\<Union>t\\<in>set ts. rel_ran (template_callees t))\"\n  by (induction ts) (simp_all add: rel_ran_union map_slot_keys_range)\n\nlemma (in schema_bodies) reference_table:\n  \"reference_table_formed literals callees\"\nproof -\n  have literal_targets: \"\\<forall>k R. (k,R) \\<in> pattern_literal_bindings p \\<longrightarrow> exact_formed R\"\n    by (rule pattern_literal_bindings_formed[OF conclusion_formed])\n  have head: \"reference_table_formed (pattern_literal_bindings p) {}\"\n    by (rule reference_table_literals[OF pattern_literal_bindings_finite pattern_literal_bindings_functional literal_targets])\n  have tail: \"reference_table_formed (premise_forest_literals ts) (premise_forest_callees ts)\"\n    by (rule premise_forest_reference_table[OF templates_formed])\n  have outside: \"(rel_dom (pattern_literal_bindings p) \\<union> rel_dom {}) \\<inter> binder_addresses = {}\"\n    using pattern_literal_slots_outside[of p] by simp\n  show ?thesis using reference_table_prefix_union[OF head tail outside premise_forest_reference_slots_outside]\n    by (simp add: schema_body_literals_def schema_body_callees_def map_slot_keys_def)\nqed\n\nlemma (in schema_bodies) reference_slots_inside:\n  \"rel_dom literals \\<union> rel_dom callees \\<subseteq> rra_carrier (object_structure body)\"\nproof -\n  have pbound: \"rel_dom (pattern_literal_bindings p) \\<subseteq> rra_carrier (object_structure (pattern_syntax f p))\"\n    by (auto simp: pattern_syntax_carrier[OF conclusion_addressing])\n  have tbound: \"rel_dom (premise_forest_literals ts) \\<union> rel_dom (premise_forest_callees ts) \\<subseteq>\n    rra_carrier (object_structure (premise_forest_syntax f ts))\"\n    by (auto simp: premise_forest_carrier[OF premise_addressing])\n  have left: \"syntax_prefix 2 ` rel_dom (pattern_literal_bindings p) \\<subseteq>\n    syntax_prefix 2 ` rra_carrier (object_structure (pattern_syntax f p))\"\n    by (rule image_mono[OF pbound])\n  have right: \"syntax_prefix 3 ` (rel_dom (premise_forest_literals ts) \\<union> rel_dom (premise_forest_callees ts)) \\<subseteq>\n    syntax_prefix 3 ` rra_carrier (object_structure (premise_forest_syntax f ts))\"\n    by (rule image_mono[OF tbound])\n  show ?thesis using left right\n    by (auto simp: schema_body_literals_def schema_body_callees_def rel_dom_union map_slot_keys_domain carrier)\nqed\n\ntext \\<open>\n  Every generated literal and callee table is finite and functional, and the two\n  kinds of reference occupy disjoint slots. Literal targets are formed exact\n  artifacts. Every slot belongs to the source body carrier. These are derived\n  properties of the constructors, used to build actual finite environments;\n  they are not additional stored fields or a semantic acceptance predicate.\n\\<close>\n\nend\n",
