          "source": "theory RRA_Record_Chains\n  imports RRA_Structural_Syntax\nbegin\n\nsection \\<open>Complete successor heads determine the socket path\\<close>\n\nfun record_socket_chain ::\n  \"('a,'v) structured_object \\<Rightarrow> 'a \\<Rightarrow> 'a list \\<Rightarrow> bool\" where\n  \"record_socket_chain R r [] = True\"\n| \"record_socket_chain R r (p#ps) \\<longleftrightarrow>\n    p\\<noteq>r \\<and> p\\<in>rra_carrier (object_structure R) \\<and>\n    headed_incidence (object_structure R) p=(if ps=[] then {} else {(p,hd ps)}) \\<and>\n    restrict_basis {p} (object_data R)=empty_basis \\<and> record_socket_chain R r ps\"\n\nlemma record_socket_chain_same_start:\n  assumes \"record_socket_chain R r (p#ps)\" \"record_socket_chain R r (p#qs)\"\n  shows \"ps=qs\"\n  using assms\nproof (induction ps arbitrary: p qs)\n  case Nil\n  then show ?case by (cases qs) auto\nnext\n  case (Cons a ps)\n  obtain b bs where qs: \"qs=b#bs\" using Cons.prems by (cases qs) auto\n  have same: \"a=b\" using Cons.prems by (simp add: qs)\n  have tail: \"ps=bs\" by (rule Cons.IH[of a bs]) (use Cons.prems in \\<open>auto simp: qs same\\<close>)\n  show ?case using qs same tail by simp\nqed\n\nlemma record_socket_chain_suffix:\n  assumes \"record_socket_chain R r (xs@ys)\"\n  shows \"record_socket_chain R r ys\"\n  using assms by (induction xs) auto\n\nlemma record_socket_chain_distinct:\n  assumes \"record_socket_chain R r ps\"\n  shows \"distinct ps\"\n  using assms\nproof (induction ps)\n  case Nil\n  then show ?case by simp\nnext\n  case (Cons p ps)\n  have tail: \"record_socket_chain R r ps\" using Cons.prems by simp\n  have absent: \"p\\<notin>set ps\"\n  proof\n    assume \"p\\<in>set ps\"\n    then obtain xs ys where split: \"ps=xs@p#ys\" by (meson split_list)\n    have suffix: \"record_socket_chain R r (p#ys)\"\n      using record_socket_chain_suffix[of R r xs \"p#ys\"] tail split by simp\n    have same: \"ps=ys\" by (rule record_socket_chain_same_start[OF Cons.prems suffix])\n    have \"length ps=length xs+Suc (length ys)\" using split by simp\n    then show False using same by simp\n  qed\n  show ?case using absent Cons.IH[OF tail] by simp\nqed\n\nlemma record_socket_chain_boundary:\n  assumes \"record_socket_chain R r ps\"\n  shows \"r\\<notin>set ps\" \"set ps\\<subseteq>rra_carrier (object_structure R)\"\n    \"restrict_basis (set ps) (object_data R)=empty_basis\"\n  using assms by (induction ps) (auto simp: empty_restriction_iff)\n\nlemma record_path_socket_chain:\n  assumes path: \"record_path (object_structure R) r p ps xs\"\n    and formed: \"object_formed R\"\n    and data: \"restrict_basis (set ps) (object_data R)=empty_basis\"\n  shows \"record_socket_chain R r ps\"\n  using path data\nproof (induction rule: record_path.induct)\n  case (path_last p x)\n  have member: \"p\\<in>rra_carrier (object_structure R)\"\n    using field_endpoint_incident[OF path_last.hyps(3)] formed\n    by (auto simp: object_formed_def rra_formed_def)\n  show ?case using path_last member by simp\nnext\n  case (path_slot p q x ps xs)\n  have member: \"p\\<in>rra_carrier (object_structure R)\"\n    using field_endpoint_incident[OF path_slot.hyps(3)] formed\n    by (auto simp: object_formed_def rra_formed_def)\n  have first: \"ps\\<noteq>[] \\<and> hd ps=q\" by (rule record_path_first[OF path_slot.hyps(4)])\n  have tail_data: \"restrict_basis (set ps) (object_data R)=empty_basis\"\n    and first_data: \"restrict_basis {p} (object_data R)=empty_basis\"\n    using path_slot.prems by (auto simp: empty_restriction_iff)\n  show ?case using path_slot.hyps(1,2) member first first_data path_slot.IH[OF tail_data] by simp\nqed\n\nlemma record_path_from_socket_chain:\n  assumes chain: \"record_socket_chain R r ps\" and nonempty: \"ps\\<noteq>[]\"\n    and length: \"length ps=length xs\"\n    and fields: \"\\<forall>(p,x)\\<in>set (zip ps xs). field_endpoint (object_structure R) r p x\"\n  shows \"record_path (object_structure R) r (hd ps) ps xs\"\n  using chain nonempty length fields\nproof (induction ps arbitrary: xs)\n  case Nil\n  then show ?case by simp\nnext\n  case (Cons p ps)\n  obtain x ys where xs: \"xs=x#ys\" using Cons.prems(3) by (cases xs) auto\n  have field: \"field_endpoint (object_structure R) r p x\" using Cons.prems(4) by (simp add: xs)\n  show ?case\n  proof (cases \"ps=[]\")\n    case True\n    have \"ys=[]\" using Cons.prems(3) by (simp add: xs True)\n    show ?thesis using Cons.prems(1) field\n      by (auto simp: xs True \\<open>ys=[]\\<close> intro: record_path.path_last)\n  next\n    case False\n    have tail: \"record_path (object_structure R) r (hd ps) ps ys\"\n      by (rule Cons.IH[OF _ False]) (use Cons.prems in \\<open>auto simp: xs\\<close>)\n    show ?thesis using Cons.prems(1) field tail False\n      by (auto simp: xs intro: record_path.path_slot)\n  qed\nqed\n\ntheorem record_at_socket_chain:\n  \"record_at R r ps xs \\<longleftrightarrow>\n    object_formed R \\<and> r\\<in>rra_carrier (object_structure R) \\<and> length ps=length xs \\<and>\n    headed_incidence (object_structure R) r=set (zip ps xs) \\<and>\n    restrict_basis {r} (object_data R)=empty_basis \\<and> record_socket_chain R r ps\"\nproof\n  assume read: \"record_at R r ps xs\"\n  have formed: \"object_formed R\" and member: \"r\\<in>rra_carrier (object_structure R)\"\n    and raw: \"raw_record_at (object_structure R) r ps xs\"\n    and data: \"restrict_basis (insert r (set ps)) (object_data R)=empty_basis\"\n    using read by (auto simp: record_at_def)\n  have length: \"length ps=length xs\" by (rule raw_record_lengths[OF raw])\n  have head: \"headed_incidence (object_structure R) r=set (zip ps xs)\"\n    using raw by (auto simp: raw_record_at_def)\n  have root_data: \"restrict_basis {r} (object_data R)=empty_basis\"\n    and path_data: \"restrict_basis (set ps) (object_data R)=empty_basis\"\n    using data by (auto simp: empty_restriction_iff)\n  have chain: \"record_socket_chain R r ps\"\n    using raw record_path_socket_chain[OF _ formed path_data]\n    by (auto simp: raw_record_at_def)\n  show \"object_formed R \\<and> r\\<in>rra_carrier (object_structure R) \\<and> length ps=length xs \\<and>\n    headed_incidence (object_structure R) r=set (zip ps xs) \\<and>\n    restrict_basis {r} (object_data R)=empty_basis \\<and> record_socket_chain R r ps\"\n    using formed member length head root_data chain by blast\nnext\n  assume \"object_formed R \\<and> r\\<in>rra_carrier (object_structure R) \\<and> length ps=length xs \\<and>\n    headed_incidence (object_structure R) r=set (zip ps xs) \\<and>\n    restrict_basis {r} (object_data R)=empty_basis \\<and> record_socket_chain R r ps\"\n  then have formed: \"object_formed R\" and member: \"r\\<in>rra_carrier (object_structure R)\"\n    and length: \"length ps=length xs\" and head: \"headed_incidence (object_structure R) r=set (zip ps xs)\"\n    and root_data: \"restrict_basis {r} (object_data R)=empty_basis\" and chain: \"record_socket_chain R r ps\"\n    by auto\n  have distinct: \"distinct ps\" by (rule record_socket_chain_distinct[OF chain])\n  have keys: \"distinct (map fst (zip ps xs))\" using distinct length by simp\n  have functional: \"single_valued (set (zip ps xs))\" using keys by (simp add: distinct_keys_iff)\n  have fields: \"\\<forall>(p,x)\\<in>set (zip ps xs). field_endpoint (object_structure R) r p x\"\n    using functional by (auto simp: field_endpoint_from_head head single_valued_def)\n  have raw: \"raw_record_at (object_structure R) r ps xs\"\n    using record_path_from_socket_chain[OF chain _ length fields] head length\n    by (cases \"ps=[]\") (auto simp: raw_record_at_def)\n  have data: \"restrict_basis (insert r (set ps)) (object_data R)=empty_basis\"\n    using root_data record_socket_chain_boundary(3)[OF chain] by (auto simp: empty_restriction_iff)\n  show \"record_at R r ps xs\" using formed member raw data by (simp add: record_at_def)\nqed\n\ntext \\<open>\n  The chain checks every socket head and its empty local data. A repeated\n  socket would give two different finite tails from the same complete head;\n  deterministic succession and the terminal empty head rule that out.\n  Distinct sockets are therefore a theorem, not a second admission test.\n\n  Combining this chain with the complete root incidence recovers exactly\n  the existing record relation. Endpoints may repeat or share other syntax.\n  The empty record still requires an actual formed root with empty headed\n  incidence and data. No condition forbids incoming edges or other material.\n\\<close>\n\nend\n",
