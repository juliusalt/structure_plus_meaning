          "source": "theory Factor_Citation_Resolution\n  imports Factor_Environment_Lookup\nbegin\n\nsection \\<open>The resolved use remains separate from the exact target\\<close>\n\nabbreviation citation_route ::\n  \"'u artifact_environment \\<Rightarrow> 'u \\<Rightarrow> citation \\<Rightarrow> 'u \\<Rightarrow> bool\" where\n  \"citation_route E u c v \\<equiv>\n    (citation_slots c={} \\<longrightarrow> v=u) \\<and> (\\<forall>k\\<in>citation_slots c. binds_slot E u k v)\"\n\nlemma citation_route_unique:\n  assumes \"environment_formed E\" \"citation_route E u c v\" \"citation_route E u c w\"\n  shows \"v=w\"\n  using assms by (cases c) (auto dest: environment_binding_unique)\n\nlemma citation_route_artifact:\n  assumes \"environment_formed E\" \"citation_route E u c v\" \"interpret_citation E u c x\"\n  shows \"artifact_at E v (target_artifact x)\"\nproof (cases c)\n  case (Local r)\n  then show ?thesis using assms by auto\nnext\n  case (External k r)\n  have chosen: \"binds_slot E u k v\" using assms(2) External by simp\n  obtain w R where parts: \"binds_slot E u k w\" \"artifact_at E w R\" \"x=Occurrence_Anchor (R,r)\"\n    using assms(3) External by auto\n  have same: \"v=w\" by (rule environment_binding_unique[OF assms(1) chosen parts(1)])\n  show ?thesis using parts(2,3) same by simp\nnext\n  case Local_Whole\n  then show ?thesis using assms by auto\nnext\n  case (External_Whole k)\n  have chosen: \"binds_slot E u k v\" using assms(2) External_Whole by simp\n  obtain w R where parts: \"binds_slot E u k w\" \"artifact_at E w R\" \"x=Whole_Artifact R\"\n    using assms(3) External_Whole by auto\n  have same: \"v=w\" by (rule environment_binding_unique[OF assms(1) chosen parts(1)])\n  show ?thesis using parts(2,3) same by simp\nqed\n\nlemma citation_route_exists:\n  assumes \"interpret_citation E u c x\"\n  shows \"\\<exists>v. citation_route E u c v\"\n  using assms by (cases c) auto\n\nlemma citation_route_location:\n  assumes formed: \"environment_formed E\"\n  shows \"citation_route E u c v \\<and> interpret_citation E u c (Occurrence_Anchor (R,r)) \\<longleftrightarrow>\n    citation_location E u c v r \\<and> artifact_at E v R\"\n  using formed by (cases c) (auto dest: environment_binding_unique environment_artifact_unique)\n\nlemma citation_route_data:\n  assumes \"citation_route E u c v\" \"interpret_citation E u c x\"\n  shows \"(citation_data_term c=Pair_Term (Payload_Term []) (optional_payload_term (target_occurrence x)) \\<and> v=u) \\<or>\n    (\\<exists>k. citation_data_term c=Pair_Term (Pair_Term (Payload_Term k) (Payload_Term []))\n      (optional_payload_term (target_occurrence x)) \\<and> binds_slot E u k v)\"\n  using assms by (cases c) auto\n\nabbreviation citation_observation_argument ::\n  \"factor_term \\<Rightarrow> factor_term \\<Rightarrow> factor_term \\<Rightarrow> factor_term \\<Rightarrow> factor_term\" where\n  \"citation_observation_argument e u c x \\<equiv> Pair_Term (Pair_Term e u) (Pair_Term c x)\"\n\nabbreviation citation_observation_pattern ::\n  \"'a term_pattern \\<Rightarrow> 'a term_pattern \\<Rightarrow> 'a term_pattern \\<Rightarrow> 'a term_pattern \\<Rightarrow> 'a term_pattern\" where\n  \"citation_observation_pattern e u c x \\<equiv> Pattern_Pair (Pattern_Pair e u) (Pattern_Pair c x)\"\n\nabbreviation citation_resolution_argument ::\n  \"factor_term \\<Rightarrow> factor_term \\<Rightarrow> factor_term \\<Rightarrow> factor_term \\<Rightarrow> factor_term \\<Rightarrow> factor_term\" where\n  \"citation_resolution_argument e u c v x \\<equiv> citation_observation_argument e u c (Pair_Term v x)\"\n\nabbreviation citation_resolution_pattern ::\n  \"'a term_pattern \\<Rightarrow> 'a term_pattern \\<Rightarrow> 'a term_pattern \\<Rightarrow> 'a term_pattern \\<Rightarrow> 'a term_pattern \\<Rightarrow> 'a term_pattern\" where\n  \"citation_resolution_pattern e u c v x \\<equiv> citation_observation_pattern e u c (Pattern_Pair v x)\"\n\nsection \\<open>Two ordinary clauses share the optional target operand\\<close>\n\ndefinition citation_resolve_local_schema :: \"(nat,nat,nat) factor_schema\" where\n  \"citation_resolve_local_schema=data_rule\n    (citation_resolution_pattern data_x data_y (Pattern_Pair (Pattern_Payload []) data_w)\n      data_y (Pattern_Pair data_z data_w))\n    {(0,37,artifact_lookup_pattern data_x data_y data_z),(1,35,Pattern_Pair data_z data_w)}\"\n\ndefinition citation_resolve_external_schema :: \"(nat,nat,nat) factor_schema\" where\n  \"citation_resolve_external_schema=data_rule\n    (citation_resolution_pattern data_x data_y (Pattern_Pair (Pattern_Pair data_z (Pattern_Payload [])) (Pattern_Variable 5))\n      data_w (Pattern_Pair (Pattern_Variable 4) (Pattern_Variable 5)))\n    {(0,38,binding_lookup_pattern data_x data_y data_z data_w),\n     (1,37,artifact_lookup_pattern data_x data_w (Pattern_Variable 4)),\n     (2,35,Pattern_Pair (Pattern_Variable 4) (Pattern_Variable 5))}\"\n\ndefinition citation_resolution_clauses :: \"(nat \\<times> (nat,nat,nat) factor_schema) set\" where\n  \"citation_resolution_clauses={(0,citation_resolve_local_schema),(1,citation_resolve_external_schema)}\"\n\ndefinition citation_resolution_system :: \"(nat,nat,nat,nat) schema_system\" where\n  \"citation_resolution_system=add_view_definition binding_lookup_system 39 data_x citation_resolution_clauses\"\n\ninterpretation citation_resolution_view: positive_view binding_lookup_system 39 data_x \"citation_resolution_clauses\"\n  by (rule positive_view.intro)\n    (auto simp: citation_resolution_clauses_def citation_resolve_local_schema_def citation_resolve_external_schema_def schema_formed_def schema_dependencies_def\n      single_valued_def rel_dom_def rel_ran_def octets_formed_def)\n\nlemma citation_resolution_system_formed [simp]: \"schema_system_formed citation_resolution_system\"\n  using citation_resolution_view.formed by (simp only: citation_resolution_system_def)\n\nlemma citation_resolution_definitions [simp]:\n  \"system_de