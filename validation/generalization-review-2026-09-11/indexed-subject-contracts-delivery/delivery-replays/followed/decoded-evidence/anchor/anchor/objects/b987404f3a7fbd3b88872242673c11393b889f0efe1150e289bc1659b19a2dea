          "source": "theory RRA_Read_Transport\n  imports RRA_Structural_Syntax\nbegin\n\nsection \\<open>Agreement on the observations used by structural readers\\<close>\n\ndefinition object_reads_agree ::\n  \"('a,'v) structured_object \\<Rightarrow> ('a,'v) structured_object \\<Rightarrow> 'a set \\<Rightarrow> bool\" where\n  \"object_reads_agree obj other I \\<longleftrightarrow>\n    I \\<subseteq> rra_carrier (object_structure obj) \\<and> I \\<subseteq> rra_carrier (object_structure other) \\<and>\n    (\\<forall>a\\<in>I. headed_incidence (object_structure obj) a = headed_incidence (object_structure other) a) \\<and>\n    restrict_basis I (object_data obj) = restrict_basis I (object_data other)\"\n\nlemma basis_restriction_agreement_mono:\n  assumes same: \"restrict_basis I D = restrict_basis I E\" and subset: \"J \\<subseteq> I\"\n  shows \"restrict_basis J D = restrict_basis J E\"\nproof -\n  have inter: \"J \\<inter> I = J\" using subset by blast\n  have \"restrict_basis J D = restrict_basis J (restrict_basis I D)\"\n    by (simp add: restriction_composes inter)\n  also have \"\\<dots> = restrict_basis J (restrict_basis I E)\"\n    by (rule arg_cong[where f=\"restrict_basis J\", OF same])\n  also have \"\\<dots> = restrict_basis J E\" by (simp add: restriction_composes inter)\n  finally show ?thesis .\nqed\n\nlemma object_reads_agree_mono:\n  assumes agree: \"object_reads_agree obj other I\" and subset: \"J \\<subseteq> I\"\n  shows \"object_reads_agree obj other J\"\nproof -\n  have data: \"restrict_basis I (object_data obj) = restrict_basis I (object_data other)\"\n    using agree by (simp add: object_reads_agree_def)\n  have restricted: \"restrict_basis J (object_data obj) = restrict_basis J (object_data other)\"\n    by (rule basis_restriction_agreement_mono[OF data subset])\n  show ?thesis using agree subset restricted by (auto simp: object_reads_agree_def)\nqed\n\nlemma object_reads_agree_symmetric:\n  \"object_reads_agree obj other I \\<longleftrightarrow> object_reads_agree other obj I\"\n  by (auto simp: object_reads_agree_def)\n\nlemma object_reads_agree_trans:\n  assumes \"object_reads_agree R S I\" \"object_reads_agree S T I\"\n  shows \"object_reads_agree R T I\"\n  using assms by (auto simp: object_reads_agree_def)\n\nlemma object_reads_agree_extend:\n  assumes first: \"object_reads_agree R S I\"\n    and second: \"object_reads_agree S T (rra_carrier (object_structure S))\"\n  shows \"object_reads_agree R T I\"\nproof -\n  have inside: \"I \\<subseteq> rra_carrier (object_structure S)\"\n    using first by (simp add: object_reads_agree_def)\n  show ?thesis by (rule object_reads_agree_trans[OF first object_reads_agree_mono[OF second inside]])\nqed\n\nlemma object_reads_agree_push_on:\n  assumes rf: \"object_formed R\" and sf: \"object_formed S\"\n    and rinj: \"inj_on f (rra_carrier (object_structure R))\"\n    and sinj: \"inj_on f (rra_carrier (object_structure S))\"\n    and reads: \"object_reads_agree R S I\"\n  shows \"object_reads_agree (push_object f R) (push_object f S) (f ` I)\"\nproof -\n  let ?U = \"rra_carrier (object_structure R)\"\n  let ?W = \"rra_carrier (object_structure S)\"\n  have rstructure: \"rra_formed (object_structure R)\" and sstructure: \"rra_formed (object_structure S)\"\n    and rdata: \"basis_formed ?U (object_data R)\" and sdata: \"basis_formed ?W (object_data S)\"\n    and rfinite: \"finite ?U\" and sfinite: \"finite ?W\"\n    using rf sf by (auto simp: object_formed_def rra_formed_def)\n  have ri: \"I \\<subseteq> ?U\" and si: \"I \\<subseteq> ?W\"\n    and original_data: \"restrict_basis I (object_data R) = restrict_basis I (object_data S)\"\n    using reads by (auto simp: object_reads_agree_def)\n  have heads: \"\\<forall>a\\<in>I. headed_incidence (object_structure (push_object f R)) (f a) =\n    headed_incidence (object_structure (push_object f S)) (f a)\"\n  proof (intro ballI)\n    fix a assume inside: \"a \\<in> I\"\n    have r: \"a \\<in> ?U\" and s: \"a \\<in> ?W\" using inside ri si by blast+\n    have equal: \"headed_incidence (object_structure R) a = headed_incidence (object_structure S) a\"\n      using reads inside by (auto simp: object_reads_agree_def)\n    show \"headed_incidence (object_structure (push_object f R)) (f a) =\n      headed_incidence (object_structure (push_object f S)) (f a)\"\n      by (simp only: push_object_def structured_object.select_convs\n          headed_incidence_push[OF rstructure rinj r] headed_incidence_push[OF sstructure sinj s] equal)\n  qed\n  have counts: \"\\<And>a v. a \\<in> I \\<Longrightarrow>\n    bag_count (object_data (push_object f R)) (f a,v) = bag_count (object_data (push_object f S)) (f a,v)\"\n  proof -\n    fix a v assume inside: \"a \\<in> I\"\n    have r: \"a \\<in> ?U\" and s: \"a \\<in> ?W\" using inside ri si by blast+\n    have restricted: \"bag_count (restrict_basis I (object_data R)) (a,v) =\n      bag_count (restrict_basis I (object_data S)) (a,v)\"\n      by (rule arg_cong[where f=\"\\<lambda>D. bag_count D (a,v)\", OF original_data])\n    have equal: \"bag_count (object_data R) (a,v) = bag_count (object_data S) (a,v)\"\n      using restricted inside by (simp add: restrict_basis_def)\n    show \"bag_count (object_data (push_object f R)) (f a,v) = bag_count (object_data (push_object f S)) (f a,v)\"\n      by (simp add: push_object_def push_basis_def\n          pushed_count_injective[OF rfinite rinj r] pushed_count_injective[OF sfinite sinj s] equal)\n  qed\n  have bindings: \"\\<And>a v. a \\<in> I \\<Longrightarrow>\n    ((f a,v) \\<in> functional_bindings (object_data (push_object f R))) =\n    ((f a,v) \\<in> functional_bindings (object_data (push_object f S)))\"\n  proof -\n    fix a v assume inside: \"a \\<in> I\"\n    have r: \"a \\<in> ?U\" and s: \"a \\<in> ?W\" using inside ri si by blast+\n    have restricted: \"((a,v) \\<in> functional_bindings (restrict_basis I (object_data R))) =\n      ((a,v) \\<in> functional_bindings (restrict_basis I (object_data S)))\"\n      by (rule arg_cong[where f=\"\\<lambda>D. (a,v) \\<in> functional_bindings D\", OF original_data])\n    have equal: \"((a,v) \\<in> functional_bindings (object_data R)) = ((a,v) \\<in> functional_bindings (object_data S))\"\n      using restricted inside by simp\n    show \"((f a,v) \\<in> functional_bindings (object_data (push_object f R))) =\n      ((f a,v) \\<in> functional_bindings (object_data (push_object f S)))\"\n      by (simp only: push_object_def structured_object.select_convs\n          functional_at_injective[OF rdata rinj r] functional_at_injective[OF sdata sinj s] equal)\n  qed\n  have data: \"restrict_basis (f ` I) (object_data (push_object f R)) =\n    restrict_basis (f ` I) (object_data (push_object f S))\"\n    using counts bindings by (auto simp: basis_identity restrict_basis_def fun_eq_iff)\n  show ?thesis using ri si heads data\n    by (auto simp: object_reads_agree_def push_object_def push_structure_def)\nqed\n\nlemma object_reads_agree_push:\n  assumes rf: \"object_formed R\" and sf: \"object_formed S\"\n    and injective: \"inj f\" and reads: \"object_reads_agree R S I\"\n  shows \"object_reads_agree (push_object f R) (push_object f S) (f ` I)\"\n  by (rule object_reads_agree_push_on[OF rf sf _ _ reads])\n    (use injective in \\<open>auto simp: inj_on_def\\<close>)\n\nlemma object_reads_agree_union:\n  assumes \"object_reads_agree R S I\" \"object_reads_agree R S J\"\n  shows \"object_reads_agree R S (I\\<union>J)\"\nproof -\n  have first: \"restrict_basis I (object_data R)=restrict_basis I (object_data S)\"\n    and second: \"restrict_basis J (object_data R)=restrict_basis J (object_data S)\"\n    using assms by (simp_all add: object_reads_agree_def)\n  have count: \"bag_count (object_data R) (a,b)=bag_count (object_data S) (a,b)\"\n    if equal: \"restrict_basis U (object_data R)=restrict_basis U (object_data S)\" and inside: \"a\\<in>U\"\n    for U a b\n    using arg_cong[OF equal, of \"\\<lambda>D. bag_count D (a,b)\"] inside\n    by (simp add: restrict_basis_def)\n  have left_count: \"bag_count (object_data R) (a,b)=bag_count (object_data S) (a,b)\"\n    if \"a\\<in>I\" for a b by (rule count[OF first that])\n  have right_count: \"bag_count (object_data R) (a,b)=bag_count (object_data S) (a,b)\"\n    if \"a\\<in>J\" for a b by (rule count[OF second that])\n  show ?thesis using assms\n    by (auto simp: object_reads_agree_def basis_identity restrict_basis_def fun_eq_iff\n      intro: left_count right_count)\nqed\n\nlemma object_reads_agree_complete:\n  assumes rf: \"object_formed R\" and sf: \"object_formed S\"\n    and carrier: \"rra_carrier (object_structure R)=rra_carrier (object_structure S)\"\n    and reads: \"object_reads_agree R S (rra_carrier (object_structure R))\"\n  shows \"R=S\"\nproof -\n  let ?U=\"rra_carrier (object_structure R)\"\n  have heads: \"\\<And>a. a\\<in>?U \\<Longrightarrow>\n    headed_incidence (object_structure R) a=headed_incidence (object_structure S) a\"\n    using reads by (simp add: object_reads_agree_def)\n  have edges: \"rra_incidence (object_structure R)=rra_incidence (object_structure S)\"\n  proof (rule set_eqI)\n    fix z\n    show \"z\\<in>rra_incidence (object_structure R) \\<longleftrightarrow>\n      z\\<in>rra_incidence (object_structure S)\"\n    proof -\n      obtain a b c where shape: \"z=(a,b,c)\" by (cases z)\n      have inside: \"a\\<in>?U\" if \"z\\<in>rra_incidence (object_structure R) \\<or>\n        z\\<in>rra_incidence (object_structure S)\"\n        using that rf sf carrier by (auto simp: shape object_formed_def rra_formed_def)\n      show ?thesis using heads inside by (auto simp: shape headed_incidence_def)\n    qed\n  qed\n  have structural: \"object_structure R=object_structure S\"\n    using carrier edges by (simp add: rra_identity)\n  have rb: \"basis_formed ?U (object_data R)\" and sb: \"basis_formed ?U (object_data S)\"\n    using rf sf carrier by (auto simp: object_formed_def)\n  have data: \"object_data R=object_data S\"\n    using reads by (simp add: object_reads_agree_def restrict_basis_carrier[OF rb]\n      restrict_basis_carrier[OF sb])\n  show ?thesis using structural data by (simp add: object_identity)\nqed\n\nlemma object_reads_payload:\n  assumes agree: \"object_reads_agree obj other I\" and member: \"a \\<in> I\"\n  shows \"payload_at obj a v \\<longleftrightarrow> payload_at other a v\"\nproof -\n  have small: \"object_reads_agree obj other {a}\"\n    by (rule object_reads_agree_mono[OF agree]) (use member in simp)\n  have data: \"restrict_basis {a} (object_data obj) = restrict_basis {a} (object_data other)\"\n    using small by (simp add: object_reads_agree_def)\n  show ?thesis by (simp only: payload_at_def data)\nqed\n\nlemma payload_leaf_read_transport:\n  assumes leaf: \"payload_leaf_at obj a v\" and formed: \"object_formed other\"\n    and agree: \"object_reads_agree obj other I\" and member: \"a \\<in> I\"\n  shows \"payload_leaf_at other a v\"\nproof -\n  have data: \"payload_at other a v\"\n    using object_reads_payload[OF agree member, of v] leaf by (simp add: payload_leaf_at_def)\n  have head: \"headed_incidence (object_structure other) a = {}\"\n    using agree member leaf by (auto simp: object_reads_agree_def payload_leaf_at_def)\n  show ?thesis using formed data head by (simp add: payload_leaf_at_def)\nqed\n\nlemma record_at_read_transport:\n  assumes source: \"record_at obj r ps xs\" and target: \"object_formed other\"\n    and agree: \"object_reads_agree obj other I\" and inside: \"insert r (set ps) \\<subseteq> I\"\n  shows \"record_at other r ps xs\"\nproof -\n  have small: \"object_reads_agree obj other (insert r (set ps))\"\n    by (rule object_reads_agree_mono[OF agree inside])\n  have root: \"r \\<in> rra_carrier (object_structure other)\"\n    and heads: \"\\<And>a. a \\<in> insert r (set ps) \\<Longrightarrow>\n      headed_incidence (object_structure obj) a = headed_incidence (object_structure other) a\"\n    using small by (auto simp: object_reads_agree_def)\n  have source_data: \"restrict_basis (insert r (set ps)) (object_data obj) = empty_basis\"\n    using source by (simp add: record_at_def)\n  have target_data: \"restrict_basis (insert r (set ps)) (object_data other) = empty_basis\"\n    using small source_data by (simp add: object_reads_agree_def)\n  show ?thesis by (rule record_at_same_heads[OF source target root heads target_data])\nqed\n\nlemma family_at_read_transport:\n  assumes source: \"family_at R r M\" and formed: \"object_formed S\"\n    and agree: \"object_reads_agree R S I\" and inside: \"insert r (rel_dom M) \\<subseteq> I\"\n  shows \"family_at S r M\"\nproof -\n  have small: \"object_reads_agree R S (insert r (rel_dom M))\"\n    by (rule object_reads_agree_mono[OF agree inside])\n  show ?thesis using source formed small\n    by (auto simp: family_at_def object_reads_agree_def)\nqed\n\nlemma citation_at_read_transport:\n  assumes cite: \"citation_at R r c I\" and formed: \"exact_formed S\"\n    and agree: \"object_reads_agree R S I\"\n  shows \"citation_at S r c I\"\nproof -\n  have raw: \"raw_citation_at R r c I\"\n    and empty: \"restrict_basis {r} (object_data R) = empty_basis\"\n    using cite by (auto simp: citation_at_def)\n  have root: \"r \\<in> I\" by (rule raw_citation_interior(2)[OF raw])\n  have heads: \"\\<And>a. a \\<in> I \\<Longrightarrow>\n    headed_incidence (object_structure R) a = headed_incidence (object_structure S) a\"\n    using agree by (simp add: object_reads_agree_def)\n  have payloads: \"\\<And>a v. a \\<in> I \\<Longrightarrow> payload_at R a v = payload_at S a v\"\n    by (rule object_reads_payload[OF agree])\n  have carrier: \"r \\<in> rra_carrier (object_structure S)\"\n    using agree root by (auto simp: object_reads_agree_def)\n  have small: \"object_reads_agree R S {r}\"\n    by (rule object_reads_agree_mono[OF agree]) (use root in simp)\n  have data: \"restrict_basis {r} (object_data S) = empty_basis\"\n    using small empty by (simp add: object_reads_agree_def)\n  have recovered: \"raw_citation_at S r c I\"\n  proof (cases rule: raw_citation_at.cases[OF raw, case_names local local_whole external_whole external])\n    case (local a)\n    have \"raw_citation_at S r (Local a) {r}\"\n      by (rule raw_citation_at.local) (use local heads[OF root] in simp)\n    then show ?thesis using local by simp\n  next\n    case local_whole\n    have \"raw_citation_at S r Local_Whole {r}\"\n      by (rule raw_citation_at.local_whole) (use local_whole heads[OF root] in simp)\n    then show ?thesis using local_whole by simp\n  next\n    case (external_whole k)\n    have \"raw_citation_at S r (External_Whole k) {r}\"\n      by (rule raw_citation_at.external_whole) (use external_whole heads[OF root] in auto)\n    then show ?thesis using external_whole by simp\n  next\n    case (external k d a)\n    have member: \"d \\<in> I\" using external by simp\n    have \"raw_citation_at S r (External k a) {r,d}\"\n      by (rule raw_citation_at.external)\n         (use external heads[OF root] heads[OF member] payloads[OF member, of a] in auto)\n    then show ?thesis using external by simp\n  qed\n  show ?thesis using formed carrier data recovered by (simp add: citation_at_def)\nqed\n\nlemma citation_at_copy_into:\n  assumes cite: \"citation_at R r c I\" and target: \"exact_formed S\"\n    and addressing: \"finite_addressing (rra_carrier (object_structure R)) f\"\n    and reads: \"object_reads_agree (push_object f R) S\n      (f ` rra_carrier (object_structure R))\"\n  shows \"citation_at S (f r) (map_citation_positions f c) (f ` I)\"\nproof -\n  have copied: \"citation_at (push_object f R) (f r) (map_citation_positions f c) (f ` I)\"\n    by (rule citation_at_push[OF cite addressing])\n  have inside: \"f ` I \\<subseteq> f ` rra_carrier (object_structure R)\"\n    using citation_interior_in_carrier[OF cite] by blast\n  show ?thesis by (rule citation_at_read_transport[\n    OF copied target object_reads_agree_mono[OF reads inside]])\nqed\n\ntext \\<open>\n  This agreement describes the fields read by the syntax recognizers. It is\n  weaker than complete incident-star equality: an enclosing record can add\n  incoming incidences at a quoted root. Those incidences remain part of the\n  target's explicit footprint boundary. Agreement on a proper read region\n  need not identify exact artifacts. For formed objects with the same carrier,\n  agreement over that whole carrier entails exact equality. Semantic agreement on\n  observed exact targets requires its own linked interpretation argument.\n\\<close>\n\nend\n",
