          "source": "theory Factor_Citation_Reading\n  imports Factor_Citation_Interpretation\nbegin\n\nsection \\<open>Structural citation reading in the supplied environment\\<close>\n\nabbreviation citation_reading_argument ::\n  \"factor_term \\<Rightarrow> factor_term \\<Rightarrow> factor_term \\<Rightarrow> factor_term \\<Rightarrow> factor_term \\<Rightarrow> factor_term\" where\n  \"citation_reading_argument e u r c i \\<equiv> citation_observation_argument e u r (Pair_Term c i)\"\n\nabbreviation citation_reading_pattern ::\n  \"'a term_pattern \\<Rightarrow> 'a term_pattern \\<Rightarrow> 'a term_pattern \\<Rightarrow>\n    'a term_pattern \\<Rightarrow> 'a term_pattern \\<Rightarrow> 'a term_pattern\" where\n  \"citation_reading_pattern e u r c i \\<equiv> citation_observation_pattern e u r (Pattern_Pair c i)\"\n\ndefinition citation_reading_schema :: \"(nat,nat,nat) factor_schema\" where\n  \"citation_reading_schema=data_rule\n    (citation_reading_pattern data_x data_y data_z data_w (Pattern_Variable 4))\n    {(0,37,artifact_lookup_pattern data_x data_y (Pattern_Variable 5)),\n     (1,36,citation_admission_pattern (Pattern_Variable 5) data_z data_w (Pattern_Variable 4))}\"\n\ndefinition citation_reading_system :: \"(nat,nat,nat,nat) schema_system\" where\n  \"citation_reading_system=add_view_definition citation_location_system 42 data_x {(0,citation_reading_schema)}\"\n\ninterpretation citation_reading_view: positive_view citation_location_system 42 data_x \"{(0,citation_reading_schema)}\"\n  by (rule positive_view.intro)\n    (auto simp: citation_reading_schema_def schema_formed_def schema_dependencies_def\n      single_valued_def rel_dom_def rel_ran_def octets_formed_def)\n\nlemma citation_reading_system_formed [simp]: \"schema_system_formed citation_reading_system\"\n  using citation_reading_view.formed by (simp only: citation_reading_system_def)\n\nlemma citation_reading_definitions [simp]:\n  \"system_definitions citation_reading_system=insert 42 (system_definitions citation_location_system)\"\n  by (simp add: citation_reading_system_def)\n\nlemma citation_reading_call:\n  \"schema_call_formed citation_reading_system d t \\<longleftrightarrow>\n    d\\<in>system_definitions citation_reading_system \\<and> term_formed t\"\n  using added_variable_calls[OF citation_location_system_formed\n    citation_reading_system_formed[unfolded citation_reading_system_def] citation_location_call]\n  by (simp only: citation_reading_system_def[symmetric])\n\nlemma citation_reading_old_meaning:\n  assumes \"d\\<in>system_definitions citation_location_system\"\n  shows \"(d,t)\\<in>positive_meaning citation_reading_system \\<longleftrightarrow>\n    (d,t)\\<in>positive_meaning citation_location_system\"\n  using citation_reading_view.old_meaning[OF assms, of t] by (simp only: citation_reading_system_def)\n\nlemma citation_reading_clause [simp]:\n  \"((42,c),S)\\<in>system_clauses citation_reading_system \\<longleftrightarrow> (c,S)\\<in>{(0,citation_reading_schema)}\"\n  using citation_reading_view.no_old_clause[of c S] by (auto simp: citation_reading_system_def)\n\nlemma citation_reading_components:\n  \"(36,t)\\<in>positive_meaning citation_reading_system \\<longleftrightarrow> (36,t)\\<in>positive_meaning citation_admission_system\"\n  \"(37,t)\\<in>positive_meaning citation_reading_system \\<longleftrightarrow> (37,t)\\<in>positive_meaning artifact_lookup_system\"\n  \"(40,t)\\<in>positive_meaning citation_reading_system \\<longleftrightarrow> (40,t)\\<in>positive_meaning citation_interpretation_system\"\n  \"(41,t)\\<in>positive_meaning citation_reading_system \\<longleftrightarrow> (41,t)\\<in>positive_meaning citation_location_system\"\n  using citation_reading_old_meaning[of 36 t] citation_location_old_meaning[of 36 t]\n    citation_interpretation_old_meaning[of 36 t] citation_resolution_old_meaning[of 36 t]\n    binding_lookup_old_meaning[of 36 t] artifact_lookup_old_meaning[of 36 t]\n    citation_reading_old_meaning[of 37 t] citation_location_previous_entries(1)[of t]\n    citation_reading_old_meaning[of 40 t] citation_location_previous_entries(3)[of t]\n    citation_reading_old_meaning[of 41 t] by auto\n\nlemma citation_reading_valuation:\n  \"(42,t)\\<in>positive_meaning citation_reading_system \\<longleftrightarrow>\n    (\\<exists>h::nat\\<Rightarrow>factor_term. (\\<forall>i\\<in>{0,1,2,3,4,5}. term_formed (h i)) \\<and>\n      t=citation_reading_argument (h 0) (h 1) (h 2) (h 3) (h 4) \\<and>\n      (37,artifact_lookup_argument (h 0) (h 1) (h 5))\\<in>positive_meaning artifact_lookup_system \\<and>\n      (36,citation_admission_argument (h 5) (h 2) (h 3) (h 4))\\<in>positive_meaning citation_admission_system)\"\n  by (subst ordinary_positive_entry_valuation)\n    (auto simp: citation_reading_schema_def schema_variables_def citation_reading_call citation_reading_components)\n\nlemma citation_reading_fields:\n  \"(42,t)\\<in>positive_meaning citation_reading_system \\<longleftrightarrow>\n    (\\<exists>e u r c i a. t=citation_reading_argument e u r c i \\<and>\n      (37,artifact_lookup_argument e u a)\\<in>positive_meaning artifact_lookup_system \\<and>\n      (36,citation_admission_argument a r c i)\\<in>positive_meaning citation_admission_system)\"\nproof\n  assume \"(42,t)\\<in>positive_meaning citation_reading_system\"\n  then show \"\\<exists>e u r c i a. t=citation_reading_argument e u r c i \\<and>\n      (37,artifact_lookup_argument e u a)\\<in>positive_meaning artifact_lookup_system \\<and>\n      (36,citation_admission_argument a r c i)\\<in>positive_meaning citation_admission_system\"\n    by (auto simp: citation_reading_valuation)\nnext\n  assume \"\\<exists>e u r c i a. t=citation_reading_argument e u r c i \\<and>\n      (37,artifact_lookup_argument e u a)\\<in>positive_meaning artifact_lookup_system \\<and>\n      (36,citation_admission_argument a r c i)\\<in>positive_meaning citation_admission_system\"\n  then obtain e u r c i a where parts: \"t=citation_reading_argument e u r c i\"\n    \"(37,artifact_lookup_argument e u a)\\<in>positive_meaning artifact_lookup_system\"\n    \"(36,citation_admission_argument a r c i)\\<in>positive_meaning citation_admission_system\" by blast\n  have formed: \"term_formed e\" \"term_formed u\" \"term_formed r\" \"term_formed c\" \"term_formed i\" \"term_formed a\"\n    using schema_call_formed_target[OF positive_meaning_formed[OF parts(2)]]\n      schema_call_formed_target[OF positive_meaning_formed[OF parts(3)]] by auto\n  show \"(42,t)\\<in>positive_meaning citation_reading_system\"\n    by (simp only: citation_reading_valuation,\n      rule exI[of _ \"\\<lambda>j::nat. if j=0 then e else if j=1 then u else if j=2 then r else if j=3 then c else if j=4 then i else a\"])\n      (use parts formed in auto)\nqed\n\ntheorem citation_reading_sound:\n  assumes \"(42,t)\\<in>positive_meaning citation_reading_system\"\n  shows \"\\<exists>E e u r c xs R. t=citation_reading_argument e (use_data_term u) (Payload_Term r)\n    (citation_data_term c) (data_list_term (map Payload_Term xs)) \\<and>\n    environment_value_presents E e \\<and> distinct xs \\<and> artifact_at E u R \\<and> citation_at R r c (set xs)\"\nproof -\n  obtain e u k c i a where fields: \"t=citation_reading_argument e u k c i\"\n    \"(37,artifact_lookup_argument e u a)\\<in>positive_meaning artifact_lookup_system\"\n    \"(36,citation_admission_argument a k c i)\\<in>positive_meaning citation_admission_system\"\n    using assms by (auto simp: citation_reading_fields)\n  obtain E q R where lookup: \"environment_value_presents E e\" \"u=use_data_term q\"\n    \"artifact_at E q R\" \"artifact_value_presents R a\"\n    using fields(2) by (auto simp: artifact_lookup_exact)\n  obtain r d xs where reading: \"k=Payload_Term r\" \"c=citation_data_term d\"\n    \"i=data_list_term (map Payload_Term xs)\" \"distinct xs\" \"citation_at R r d (set xs)\"\n    using fields(3) by (auto simp: citation_admission_at_source[OF lookup(4)])\n  show ?thesis using fields(1) lookup reading by blast\nqed\n\ntheorem citation_reading_complete:\n  assumes source: \"environment_value_presents E e\" and actual: \"artifact_at E u R\"\n    and order: \"distinct xs\" and reading: \"citation_at R r c (set xs)\"\n  shows \"(42,citation_reading_argument e (use_data_term u) (Payload_Term r)\n    (citation_data_term c) (data_list_term (map Payload_Term xs)))\\<in>positive_meaning citation_reading_system\"\nproof -\n  have rf: \"exact_formed R\" using reading by (simp add: citation_at_def)\n  obtain a where material: \"artifact_value_presents R a\" using artifact_value_presents_total[OF rf] by blast\n  have lookup: \"(37,artifact_lookup_argument e (use_data_term u) a)\\<in>positive_meaning artifact_lookup_system\"\n    using source actual material by (auto simp: artifact_lookup_exact)\n  have citation: \"(36,citation_admission_argument a (Payload_Term r) (citation_data_term c)\n    (data_list_term (map Payload_Term xs)))\\<in>positive_meaning citation_admission_system\"\n    by (rule citation_admission_complete[OF material order reading])\n  show ?thesis using lookup citation by (auto simp: citation_reading_fields)\nqed\n\ntheorem citation_reading_exact:\n  \"(42,t)\\<in>positive_meaning citation_reading_system \\<longleftrightarrow>\n    (\\<exists>E e u r c xs R. t=citation_reading_argument e (use_data_term u) (Payload_Term r)\n      (citation_data_term c) (data_list_term (map Payload_Term xs)) \\<and>\n      environment_value_presents E e \\<and> distinct xs \\<and> artifact_at E u R \\<and> citation_at R r c (set xs))\"\n  using citation_reading_sound citation_reading_complete by blast\n\ncorollary citation_reading_at_source:\n  assumes source: \"environment_value_presents E e\"\n  shows \"(42,citation_reading_argument e u k c i)\\<in>positive_meaning citation_reading_system \\<longleftrightarrow>\n    (\\<exists>q r d xs R. u=use_data_term q \\<and> k=Payload_Term r \\<and> c=citation_data_term d \\<and>\n      i=data_list_term (map Payload_Term xs) \\<and> distinct xs \\<and> artifact_at E q R \\<and> citation_at R r d (set xs))\"\nproof\n  assume holds: \"(42,citation_reading_argument e u k c i)\\<in>positive_meaning citation_reading_system\"\n  obtain F q r d xs R where parts: \"environment_value_presents F e\" \"u=use_data_term q\"\n    \"k=Payload_Term r\" \"c=citation_data_term d\" \"i=data_list_term (map Payload_Term xs)\"\n    \"distinct xs\" \"artifact_at F q R\" \"citation_at R r d (set xs)\"\n    using holds by (auto simp: citation_reading_exact)\n  have same: \"F=E\" by (rule environment_value_presents_unique[OF parts(1) source])\n  show \"\\<exists>q r d xs R. u=use_data_term q \\<and> k=Payload_Term r \\<and> c=citation_data_term d \\<and>\n      i=data_list_term (map Payload_Term xs) \\<and> distinct xs \\<and> artifact_at E q R \\<and> citation_at R r d (set xs)\"\n    using parts same by blast\nnext\n  assume \"\\<exists>q r d xs R. u=use_data_term q \\<and> k=Payload_Term r \\<and> c=citation_data_term d \\<and>\n      i=data_list_term (map Payload_Term xs) \\<and> distinct xs \\<and> artifact_at E q R \\<and> citation_at R r d (set xs)\"\n  then show \"(42,citation_reading_argument e u k c i)\\<in>positive_meaning citation_reading_system\"\n    using source citation_reading_complete by blast\nqed\n\ncorollary citation_reading_on_values:\n  assumes source: \"environment_value_presents E e\"\n  shows \"(42,citation_reading_argument e (use_data_term u) (Payload_Term r)\n    (citation_data_term c) (data_list_term (map Payload_Term xs)))\\<in>positive_meaning citation_reading_system \\<longleftrightarrow>\n    distinct xs \\<and> (\\<exists>R. artifact_at E u R \\<and> citation_at R r c (set xs))\"\n  by (auto simp: citation_reading_at_source[OF source] data_list_term_injective\n    injective_mapped_lists[OF payload_term_inj]\n    dest: injD[OF use_data_term_injective] injD[OF citation_data_term_injective])\n\ncorollary citation_reading_presentation_invariance:\n  assumes \"environment_value_presents E e\" \"environment_value_presents E f\"\n  shows \"(42,citation_reading_argument e u r c i)\\<in>positive_meaning citation_reading_system \\<longleftrightarrow>\n    (42,citation_reading_argument f u r c i)\\<in>positive_meaning citation_reading_system\"\n  by (simp only: citation_reading_at_source[OF assms(1)] citation_reading_at_source[OF assms(2)])\n\ncorollary citation_reading_result_unique:\n  assumes source: \"environment_value_presents E e\"\n    and first: \"(42,citation_reading_argument e u k c i)\\<in>positive_meaning citation_reading_system\"\n    and second: \"(42,citation_reading_argument e u k d j)\\<in>positive_meaning citation_reading_system\"\n  shows \"c=d \\<and> (6,Pair_Term i j)\\<in>positive_meaning bag_comparison_system\"\nproof -\n  obtain q r b xs R where left: \"u=use_data_term q\" \"k=Payload_Term r\" \"c=citation_data_term b\"\n    \"i=data_list_term (map Payload_Term xs)\" \"distinct xs\" \"artifact_at E q R\" \"citation_at R r b (set xs)\"\n    using first by (auto simp: citation_reading_at_source[OF source])\n  obtain z ys S where right: \"d=citation_data_term z\" \"j=data_list_term (map Payload_Term ys)\"\n    \"distinct ys\" \"artifact_at E q S\" \"citation_at S r z (set ys)\"\n    using second left(1,2) by (auto simp: citation_reading_at_source[OF source] dest: injD[OF use_data_term_injective])\n  have ef: \"environment_formed E\" using environment_value_presents_formed[OF source] by blast\n  have same_artifact: \"S=R\" by (rule environment_artifact_unique[OF ef right(4) left(6)])\n  have same: \"b=z\" \"set xs=set ys\"\n    using citation_at_unique[OF left(7)] right(5) same_artifact by blast+\n  have multisets: \"mset xs=mset ys\"\n    using left(5) right(3) same(2) set_eq_iff_mset_eq_distinct[of xs ys] by auto\n  have formed: \"term_formed i\" \"term_formed j\"\n    using schema_call_formed_target[OF positive_meaning_formed[OF first]]\n      schema_call_formed_target[OF positive_meaning_formed[OF second]] by auto\n  show ?thesis using left(3,4) right(1,2) same(1) formed multisets\n    by (simp add: bag_comparison_lists data_list_term_formed injective_mapped_multisets[OF payload_term_inj])\nqed\n\ntext \\<open>\n  The source artifact is recovered at the actual supplied use, and its complete\n  data presentation is an internal witness shared by lookup and citation\n  admission. The result retains the structural citation and its exact interior.\n  It does not require the citation to resolve: structural recognition remains\n  available independently of interpretation. Different complete interior\n  orders are permitted, while a repeated interior occurrence is rejected.\n\\<close>\n\nend\n",
