          "theory": "Factor_Schema_Encoding",
          "source": "theory Factor_Schema_Encoding\n  imports Factor_Reference_Tables Factor_Schema_Lists\nbegin\n\nsection \\<open>Recovery of the complete native schema\\<close>\n\nlemma native_premise_family_from_list:\n  assumes ef: \"environment_formed E\" and source: \"artifact_at E u R\"\n    and raw: \"family_at R m (set (zip ss xs))\"\n    and lengths: \"length ss = length xs\" \"length ss = length ts\"\n    and distinct: \"distinct ss\"\n    and bodies: \"\\<forall>i<length ts. \\<exists>I K. native_premise_at E u V (xs!i) (template_projection f (ts!i)) I K\"\n  shows \"native_premise_family_at E u V m\n    (schema_premises (schema_list_projection f p ss ts))\n    (schema_material_premises (schema_list_projection f p ss ts))\"\nproof -\n  let ?Q = \"set (zip ss (map (template_projection f) ts))\"\n  have finite: \"finite ?Q\" by simp\n  have functional: \"single_valued ?Q\" by (rule single_valued_zip[OF distinct])\n  have domain: \"rel_dom ?Q = rel_dom (set (zip ss xs))\"\n    using zip_domain[OF lengths(1)] zip_domain[of ss \"map (template_projection f) ts\"] lengths(2) by simp\n  have readings: \"\\<forall>s a. (s,a) \\<in> set (zip ss xs) \\<longrightarrow>\n    (\\<exists>q I K. (s,q) \\<in> ?Q \\<and> native_premise_at E u V a q I K)\"\n  proof (intro allI impI)\n    fix s a assume entry: \"(s,a) \\<in> set (zip ss xs)\"\n    obtain i where index: \"i < length ss\" \"i < length xs\" \"s = ss!i\" \"a = xs!i\"\n      using entry by (auto simp: in_set_zip)\n    have small: \"i < length ts\" using index(1) lengths(2) by simp\n    have projected: \"(s,template_projection f (ts!i)) \\<in> ?Q\"\n      using index small by (auto simp: in_set_zip)\n    obtain I K where read: \"native_premise_at E u V a (template_projection f (ts!i)) I K\"\n      using bodies small index(4) by blast\n    show \"\\<exists>q I K. (s,q) \\<in> ?Q \\<and> native_premise_at E u V a q I K\"\n      using projected read by blast\n  qed\n  show ?thesis unfolding native_premise_family_at_def\n    by (simp only: schema_list_socket_sum)\n       (use ef source raw finite functional domain readings in blast)\nqed\n\ntheorem schema_syntax_recovers:\n  fixes ts :: \"('a,local_address option) premise_template list\"\n  assumes bodies: \"schema_bodies f p ts\"\n    and frame: \"schema_frame (schema_body_syntax f p ts) (f ` schema_body_variables p ts)\n      [2] b m r ps (set (zip ss (schema_body_roots ts)))\"\n    and len: \"length ss = length ts\" and sockets: \"distinct ss\"\n    and ef: \"environment_formed E\"\n    and source: \"artifact_at E u (schema_wrapper (schema_body_syntax f p ts)\n      (f ` schema_body_variables p ts) [2] b m r ps (set (zip ss (schema_body_roots ts))))\"\n    and refs: \"syntax_references E u (schema_body_literals p ts) (schema_body_callees ts)\"\n  shows \"native_schema_at E u r (schema_list_projection f p ss ts)\"\nproof -\n  interpret body: schema_bodies f p ts by (rule bodies)\n  interpret frame: schema_frame \"schema_body_syntax f p ts\" \"f ` schema_body_variables p ts\"\n    \"[2]\" b m r ps \"set (zip ss (schema_body_roots ts))\" by (rule frame)\n  let ?R = \"schema_body_syntax f p ts\"\n  let ?V = \"f ` schema_body_variables p ts\"\n  let ?S = \"schema_wrapper ?R ?V [2] b m r ps (set (zip ss (schema_body_roots ts)))\"\n  let ?P = \"schema_list_projection f p ss ts\"\n  let ?I = \"syntax_prefix 2 ` pattern_syntax_interior p\"\n  let ?K = \"syntax_prefix 2 ` rel_dom (pattern_literal_bindings p)\"\n  have concl: \"pattern_quoted_at E u ?V [2] (schema_conclusion ?P) ?I ?K\"\n    using body.conclusion_recovers[OF ef source frame.reads refs]\n    by (simp add: schema_list_projection_def)\n  have premise_reads: \"\\<forall>i<length ts. \\<exists>I K. native_premise_at E u ?V\n    (schema_body_roots ts ! i) (template_projection f (ts!i)) I K\"\n    by (rule body.premises_recovers[OF ef source frame.reads refs])\n  have family: \"native_premise_family_at E u ?V m (schema_premises ?P) (schema_material_premises ?P)\"\n    by (rule native_premise_family_from_list[OF ef source frame.family_read _ len sockets premise_reads])\n       (use len in simp)\n  have variables: \"?V = schema_variables ?P\"\n    using schema_list_variables[OF len, of f p] by (simp add: schema_body_variables_def)\n  have original_interior: \"pattern_syntax_interior p \\<subseteq>\n    rra_carrier (object_structure (pattern_syntax f p))\"\n    by (auto simp: pattern_syntax_carrier[OF body.conclusion_addressing])\n  have mapped_interior: \"?I \\<subseteq> syntax_prefix 2 ` rra_carrier (object_structure (pattern_syntax f p))\"\n    by (rule image_mono[OF original_interior])\n  have interior: \"?I \\<subseteq> rra_carrier (object_structure ?R)\"\n    using mapped_interior by (auto simp only: body.carrier)\n  have outside: \"?I \\<inter> binder_addresses = {}\"\n    using pattern_syntax_interior_outside[of p]\n    by (auto simp: syntax_prefix_def split: if_splits)\n  have record_boundary: \"insert r (set ps) \\<inter> (insert b ?V \\<union> ?I \\<union> {m}) = {}\"\n    using frame.headers_fresh frame.headers_distinct body.variables_inside interior by auto\n  have scope_boundary: \"insert b ?V \\<inter> ?I = {}\"\n    using frame.headers_fresh interior body.boundary outside by auto\n  have distinct_roots: \"b \\<noteq> m\" using frame.headers_distinct by simp\n  have body_boundary: \"m \\<notin> ?I\" using frame.headers_fresh interior by auto\n  have witness: \"\\<exists>R ps b c m V I K. artifact_at E u R \\<and> record_at R r ps [b,c,m] \\<and>\n    binder_scope_at R b V \\<and> pattern_quoted_at E u V c (schema_conclusion ?P) I K \\<and>\n    native_premise_family_at E u V m (schema_premises ?P) (schema_material_premises ?P) \\<and>\n    V = schema_variables ?P \\<and>\n    insert r (set ps) \\<inter> (insert b V \\<union> I \\<union> {m}) = {} \\<and>\n    insert b V \\<inter> I = {} \\<and> b \\<noteq> m \\<and> m \\<notin> I\"\n    by (rule exI[of _ ?S], rule exI[of _ ps], rule exI[of _ b], rule exI[of _ \"[2]\"],\n        rule exI[of _ m], rule exI[of _ ?V], rule exI[of _ ?I], rule exI[of _ ?K])\n       (use source frame.record_read frame.binder_read concl family variables\n          record_boundary scope_boundary distinct_roots body_boundary in auto)\n  show ?thesis using ef witness by (simp only: native_schema_at_def)\nqed\n\ntheorem schema_syntax_total:\n  fixes ts :: \"('a,local_address option) premise_template list\"\n  assumes bodies: \"schema_bodies f p ts\"\n  shows \"\\<exists>R r ss. exact_formed R \\<and> length ss = length ts \\<and> distinct ss \\<and>\n    (\\<forall>E u. environment_formed E \\<longrightarrow> artifact_at E u R \\<longrightarrow>\n      syntax_references E u (schema_body_literals p ts) (schema_body_callees ts) \\<longrightarrow>\n      native_schema_at E u r (schema_list_projection f p ss ts)) \\<and>\n    reference_table_formed (schema_body_literals p ts) (schema_body_callees ts) \\<and>\n    rel_dom (schema_body_literals p ts) \\<union> rel_dom (schema_body_callees ts) \\<subseteq> rra_carrier (object_structure R) \\<and>\n    bag_count (object_data R) = (\\<lambda>_. 0) \\<and> r \\<in> rra_carrier (object_structure R) \\<and>\n    set ss \\<inter> f ` schema_body_variables p ts = {} \\<and>\n    set ss \\<union> f ` schema_body_variables p ts \\<subseteq> rra_carrier (object_structure R)\"\nproof -\n  interpret body: schema_bodies f p ts by (rule bodies)\n  obtain b m r :: local_address and ps ss :: \"local_address list\" where fresh:\n    \"length ss = length (schema_body_roots ts)\" \"distinct ss\"\n    \"schema_frame (schema_body_syntax f p ts) (f ` schema_body_variables p ts)\n      [2] b m r ps (set (zip ss (schema_body_roots ts)))\"\n    using schema_frame_total[OF body.formed body.silent body.variables_inside body.boundary\n        body.conclusion_inside body.premise_roots_inside]\n    by metis\n  let ?R = \"schema_wrapper (schema_body_syntax f p ts) (f ` schema_body_variables p ts)\n    [2] b m r ps (set (zip ss (schema_body_roots ts)))\"\n  have len: \"length ss = length ts\" using fresh(1) by simp\n  have formed: \"exact_formed ?R\" by (rule schema_frame.formed[OF fresh(3)])\n  have read: \"\\<forall>E u. environment_formed E \\<longrightarrow> artifact_at E u ?R \\<longrightarrow>\n    syntax_references E u (schema_body_literals p ts) (schema_body_callees ts) \\<longrightarrow>\n    native_schema_at E u r (schema_list_projection f p ss ts)\"\n    by (intro allI impI) (rule schema_syntax_recovers[OF bodies fresh(3) len fresh(2)]; assumption)\n  have carrier_included: \"rra_carrier (object_structure (schema_body_syntax f p ts)) \\<subseteq>\n    rra_carrier (object_structure ?R)\"\n    using schema_frame.reads[OF fresh(3)] by (simp add: object_reads_agree_def)\n  have reference_bounds: \"rel_dom (schema_body_literals p ts) \\<union> rel_dom (schema_body_callees ts) \\<subseteq>\n    rra_carrier (object_structure ?R)\"\n    by (rule subset_trans[OF body.reference_slots_inside carrier_included])\n  have counts: \"bag_count (object_data ?R) = (\\<lambda>_. 0)\"\n    by (simp only: schema_frame.data[OF fresh(3)]) (simp add: schema_body_syntax_def)\n  have root: \"r \\<in> rra_carrier (object_structure ?R)\"\n    by (simp add: schema_frame.carrier[OF fresh(3)])\n  have separate: \"set ss \\<inter> f ` schema_body_variables p ts = {}\"\n    using schema_frame.headers_fresh[OF fresh(3)] body.variables_inside len\n      zip_domain[of ss \"schema_body_roots ts\"] by auto\n  have inside: \"set ss \\<union> f ` schema_body_variables p ts \\<subseteq>\n      rra_carrier (object_structure ?R)\"\n    using body.variables_inside len zip_domain[of ss \"schema_body_roots ts\"]\n    by (auto simp: schema_frame.carrier[OF fresh(3)])\n  show ?thesis by (rule exI[of _ ?R], rule exI[of _ r], rule exI[of _ ss])\n    (use formed len fresh(2) read body.reference_table reference_bounds counts root separate inside in blast)\nqed\n\ntext \\<open>\n  Every finite mixed schema body has a finite enclosing syntax artifact.\n  Recovery uses the existing native schema reader, with the exact shared\n  binder scope, conclusion, and complete identified premise family. External\n  literals and callees must resolve in the actual destination environment;\n  this theorem does not replace that requirement by a semantic assumption.\n\\<close>\n\nend\n",
