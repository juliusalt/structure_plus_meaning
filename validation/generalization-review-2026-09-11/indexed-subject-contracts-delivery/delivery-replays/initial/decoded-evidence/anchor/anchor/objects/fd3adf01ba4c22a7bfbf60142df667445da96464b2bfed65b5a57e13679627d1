"""Compare the actual failed and proved dependency contexts for the same consumer."""
from pathlib import Path
import hashlib
import json
import sys
b=Path(__file__).parent
root=Path('/home/julius/structure_and_semantics')
sys.path.insert(0,str(root/'tools'))
import investigate
raw=Path('/tmp/native-investigation-report-diagnostic-indexeddownstream1')
old=json.loads((b/'main-check1/build.json').read_text())
new=json.loads((raw/'result.json').read_text())
subjects=[]
for receipt, source_root, main in [(old,root/'theories',True),(new,raw/'original-sources',False)]:
    sources=[]
    for name in sorted(new['sources']):
        path=source_root/(name+'.thy');data=path.read_bytes()
        sha=hashlib.sha256(data).hexdigest()
        assert receipt['sources'][('theories/'+name+'.thy') if main else name]==sha
        sources.append({'theory':name,'source':data.decode(),'sha256':sha})
    satisfied=(receipt['status']=='accepted' and receipt['exit_code']==0 and receipt['sources_unchanged'])
    subjects.append({'roots':new['roots'],'complete_dependency_sources':sources,
                     'actual_checker_command':receipt['command'],'actual_result':receipt,
                     'actual_log':((b/'main-check1/build.log') if main else raw/'build.log').read_text(),
                     'satisfied':satisfied})
observations=[[0,c,0] for c,s in enumerate(subjects) if s['satisfied']]
profiles=[{w for f,d,w in observations if c==d} for c in [0,1]]
relation=[[c,d] for c in [0,1] for d in [0,1] if profiles[c]<=profiles[d]]
subject={'problem':'Make the existing generated-input proof consume the factored complete-input subject without changing its statement or native calculation.',
         'condition':'The actual Isabelle invocation checks the complete required dependency sources successfully and those sources remain unchanged.',
         'subjects':subjects,'observations':observations,'relation':relation,
         'boundary':'The source inventories, complete sources, actual checker operations and returned results are retained. The finite decision consumes this derived host-check condition. It is not native checking of Isabelle proofs, and a passing isolated context does not replace the later full repository check.'}
p=b/'downstream-repair-subjects.json';p.write_text(json.dumps(subject,indent=2)+'\n')
case={'schema':investigate.SCHEMA,'kind':'basis','question':subject['problem'],
      'candidates':[0,1],'facets':[0],'selected':[],'observations':observations,'relation':relation,
      'scope':{'candidates':{'0':'Original consumer proof on its complete dependency context','1':'Consumer proof instantiating the shared subject definitions'},
               'facets':{'0':subject['condition']},'subjects':str(p)},'semantic_boundary':subject['boundary'],
      'evidence':[{'path':str(q),'sha256':investigate.file_hash(q)} for q in [p,Path(__file__),raw/'result.json']]}
spec={'question':subject['problem'],'boundary':subject['boundary'],
      'problems':[{'name':'generated-input-subject-contract','case':case,'required_observations':[[0,0]]}]}
(b/'downstream-repair-specification.json').write_text(json.dumps(spec,indent=2)+'\n')
print({'checked_dependency_sources':len(new['sources']),'observations':observations,'relation':relation})
