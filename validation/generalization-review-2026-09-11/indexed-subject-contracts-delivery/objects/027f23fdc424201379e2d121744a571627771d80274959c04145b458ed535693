theorem binding_entry_raw:
  "(24,t)\<in>positive_meaning binding_entry_system \<longleftrightarrow>
    (\<exists>a u slot v carrier rest target.
      t=Pair_Term a (Pair_Term (Pair_Term u slot) v) \<and>
      selected_data_member (Pair_Term u (Pair_Term carrier rest)) a \<and>
      selected_data_member (Pair_Term v target) a \<and> selected_data_member slot carrier)"
proof
  assume holds: "(24,t)\<in>positive_meaning binding_entry_system"
  have consequence: "(24,t)\<in>schema_consequences binding_entry_system (positive_meaning binding_entry_system)"
    using holds positive_meaning_unfold[of binding_entry_system] by blast
  obtain c S f where clause: "((24,c),S)\<in>system_clauses binding_entry_system"
    and head: "t=evaluate_pattern f (schema_conclusion S)"
    and support: "\<forall>s d p. (s,d,p)\<in>schema_premises S \<longrightarrow>
      (d,evaluate_pattern f p)\<in>positive_meaning binding_entry_system"
    using schema_consequences_valuationD[OF consequence] by blast
  have schema: "S=binding_entry_schema" using clause by simp
  have source: "selected_data_member (Pair_Term (f 1) (Pair_Term (f 4) (f 5))) (f 0)"
    and target: "selected_data_member (Pair_Term (f 3) (f 7)) (f 0)"
    and slot: "selected_data_member (f 2) (f 4)"
    using support by (auto simp: schema binding_entry_schema_def binding_entry_selection)
  show "\<exists>a u slot v carrier rest target.
    t=Pair_Term a (Pair_Term (Pair_Term u slot) v) \<and>
    selected_data_member (Pair_Term u (Pair_Term carrier rest)) a \<and>
    selected_data_member (Pair_Term v target) a \<and> selected_data_member slot carrier"
    using head source target slot by (auto simp: schema binding_entry_schema_def)
next
  assume "\<exists>a u slot v carrier rest target.
    t=Pair_Term a (Pair_Term (Pair_Term u slot) v) \<and>
    selected_data_member (Pair_Term u (Pair_Term carrier rest)) a \<and>
    selected_data_member (Pair_Term v target) a \<and> selected_data_member slot carrier"
  then obtain a u slot v carrier rest target r s q where
    shape: "t=Pair_Term a (Pair_Term (Pair_Term u slot) v)"
    and children:
      "(5,Pair_Term (Pair_Term u (Pair_Term carrier rest)) (Pair_Term a r))\<in>positive_meaning bag_comparison_system"
      "(5,Pair_Term (Pair_Term v target) (Pair_Term a s))\<in>positive_meaning bag_comparison_system"
      "(5,Pair_Term slot (Pair_Term carrier q))\<in>positive_meaning bag_comparison_system" by blast
  have formed: "term_formed a" "term_formed u" "term_formed slot" "term_formed v" "term_formed carrier"
    "term_formed rest" "term_formed r" "term_formed target" "term_formed s" "term_formed q"
    using schema_call_formed_target[OF positive_meaning_formed[OF children(1)]]
      schema_call_formed_target[OF positive_meaning_formed[OF children(2)]]
      schema_call_formed_target[OF positive_meaning_formed[OF children(3)]] by auto
  let ?f="\<lambda>i::nat. if i=0 then a else if i=1 then u else if i=2 then slot else if i=3 then v
    else if i=4 then carrier else if i=5 then rest else if i=6 then r else if i=7 then target else if i=8 then s else q"
  have result: "(24,evaluate_pattern ?f (schema_conclusion binding_entry_schema))\<in>positive_meaning binding_entry_system"
    by (rule ordinary_positive_valuation_step[where c=0])
      (use formed children in \<open>auto simp: binding_entry_schema_def schema_variables_def binding_entry_call binding_entry_selection\<close>)
  show "(24,t)\<in>positive_meaning binding_entry_system" using result by (simp add: shape binding_entry_schema_def)
qed

lemma artifact_carrier_selection:
  assumes read: "artifact_value_presents R (Pair_Term a rest)"
  shows "selected_data_member slot a \<longleftrightarrow>
    (\<exists>k. slot=Payload_Term k \<and> k\<in>rra_carrier (object_structure R))"
proof -
  obtain A E B F where enumeration: "artifact_enumeration R A E B F"
    and shape: "Pair_Term a rest=artifact_data_term A E B F"
    using read unfolding artifact_value_presents_def by blast
  have carrier: "set A=rra_carrier (object_structure R)"
    using artifact_enumeration_material[OF enumeration] by blast
  have field: "a=data_list_term (map Payload_Term A)" using shape by (simp add: artifact_data_term_def)
  have formed: "term_formed a" using artifact_value_presents_formed[OF read] by simp
  have data: "data_elements (map Payload_Term A)"
    using formed by (auto simp: field data_list_term_formed)
  show ?thesis using data carrier
    by (auto simp: selected_data_member_exact field data_list_term_injective)
qed

abbreviation binding_supported ::
  "(local_address option\<times>exact_artifact) set \<Rightarrow>
    ((local_address option\<times>local_address)\<times>local_address option) \<Rightarrow> bool" where
  "binding_supported A z \<equiv>
    (\<exists>R. (fst (fst z),R)\<in>A \<and> snd (fst z)\<in>rra_carrier (object_structure R)) \<and> snd z\<in>rel_dom A"

theorem binding_entry_exact:
  assumes read: "data_collection_presents environment_artifact_entry_presents A a"
  shows "(24,Pair_Term a b)\<in>positive_meaning binding_entry_system \<longleftrightarrow>
    (\<exists>z. b=binding_data z \<and> binding_supported A z)"
proof -
  have rows: "(\<forall>z\<in>A. \<exists>t. selected_data_member t a \<and> environment_artifact_entry_presents z t) \<and>
    (\<forall>t. selected_data_member t a \<longrightarrow> (\<exists>z\<in>A. environment_artifact_entry_presents z t))"
    by (rule data_collection_selection[OF read]) (meson environment_artifact_entry_formed)
  show ?thesis
  proof
    assume holds: "(24,Pair_Term a b)\<in>positive_meaning binding_entry_system"
    obtain u slot v carrier rest target where shape: "b=Pair_Term (Pair_Term u slot) v"
      and selected: "selected_data_member (Pair_Term u (Pair_Term carrier rest)) a"
        "selected_data_member (Pair_Term v target) a" "selected_data_member slot carrier"
      using holds by (auto simp: binding_entry_raw; blast)
    obtain z w where entries: "z\<in>A" "environment_artifact_entry_presents z (Pair_Term u (Pair_Term carrier rest))"
      "w\<in>A" "environment_artifact_entry_presents w (Pair_Term v target)"
      using rows selected(1,2) by blast
    have source: "u=use_data_term (fst z)" "artifact_value_presents (snd z) (Pair_Term carrier rest)"
      and target_use: "v=use_data_term (fst w)"
      using entries(2,4) by (auto simp: environment_artifact_entry_presents_def)
    obtain k where slot: "slot=Payload_Term k" "k\<in>rra_carrier (object_structure (snd z))"
      using selected(3) artifact_carrier_selection[OF source(2), of slot] by blast
    have source_supported: "\<exists>R. (fst z,R)\<in>A \<and> k\<in>rra_carrier (object_structure R)"
      by (rule exI[of _ "snd z"]) (use entries(1) slot(2) in auto)
    have target_supported: "fst w\<in>rel_dom A"
      by (rule rel_domI[where y="snd w"]) (use entries(3) in simp)
    show "\<exists>z. b=binding_data z \<and> binding_supported A z"
      by (intro exI[of _ "((fst z,k),fst w)"])
        (use shape source(1) target_use slot(1) source_supported target_supported in \<open>auto simp: binding_data_def\<close>)
  next
    assume "\<exists>z. b=binding_data z \<and> binding_supported A z"
    then obtain z where binding: "b=binding_data z" "binding_supported A z" by blast
    obtain u k v where row: "z=((u,k),v)" by (cases z) auto
    obtain R T where source: "(u,R)\<in>A" "k\<in>rra_carrier (object_structure R)"
      and target: "(v,T)\<in>A" using binding(2) by (auto simp: row rel_dom_def)
    obtain x y where first: "selected_data_member x a" "environment_artifact_entry_presents (u,R) x"
      and second: "selected_data_member y a" "environment_artifact_entry_presents (v,T) y"
      using rows source(1) target by blast
    obtain actual where artifact_read: "artifact_value_presents R actual"
      and entry_shape: "x=Pair_Term (use_data_term u) actual"
      using first(2) by (auto simp: environment_artifact_entry_presents_def)
    obtain carrier rest where fields: "actual=Pair_Term carrier rest"
      using artifact_read unfolding artifact_value_presents_def artifact_data_term_def by blast
    have material: "artifact_value_presents R (Pair_Term carrier rest)"
      using artifact_read fields by simp
    have source_shape: "x=Pair_Term (use_data_term u) (Pair_Term carrier rest)"
      using entry_shape fields by simp
    obtain target_value where target_shape: "y=Pair_Term (use_data_term v) target_value"
      using second(2) by (auto simp: environment_artifact_entry_presents_def)
    have slot: "selected_data_member (Payload_Term k) carrier"
      using source(2) by (simp add: artifact_carrier_selection[OF material])
    show "(24,Pair_Term a b)\<in>positive_meaning binding_entry_system"
      using first(1) second(1) slot
      by (auto simp: binding_entry_raw binding(1) row binding_data_def source_shape target_shape)
  qed
qed

