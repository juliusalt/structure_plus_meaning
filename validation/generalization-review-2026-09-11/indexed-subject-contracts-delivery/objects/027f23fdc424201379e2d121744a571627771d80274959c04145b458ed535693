  "(27,t)\<in>positive_meaning environment_identity_system \<longleftrightarrow>
    (\<exists>E x y. t=Pair_Term x y \<and> environment_value_presents E x \<and> environment_value_presents E y)"
proof
  assume holds: "(27,t)\<in>positive_meaning environment_identity_system"
  have consequence: "(27,t)\<in>schema_consequences environment_identity_system (positive_meaning environment_identity_system)"
    using holds positive_meaning_unfold[of environment_identity_system] by blast
  obtain c S f where clause: "((27,c),S)\<in>system_clauses environment_identity_system"
