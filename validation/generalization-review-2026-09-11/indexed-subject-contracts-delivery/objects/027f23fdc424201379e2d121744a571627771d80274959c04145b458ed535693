theorem artifact_entry_admission_exact:
  "(22,t)\<in>positive_meaning artifact_entry_admission_system \<longleftrightarrow>
    (\<exists>z. environment_artifact_entry_presents z t)"
proof
  assume holds: "(22,t)\<in>positive_meaning artifact_entry_admission_system"
  have consequence: "(22,t)\<in>schema_consequences artifact_entry_admission_system
    (positive_meaning artifact_entry_admission_system)"
    using holds positive_meaning_unfold[of artifact_entry_admission_system] by blast
  obtain c S f where clause: "((22,c),S)\<in>system_clauses artifact_entry_admission_system"
    and head: "t=evaluate_pattern f (schema_conclusion S)"
    and support: "\<forall>s d p. (s,d,p)\<in>schema_premises S \<longrightarrow>
      (d,evaluate_pattern f p)\<in>positive_meaning artifact_entry_admission_system"
    using schema_consequences_valuationD[OF consequence] by blast
  have schema: "S=artifact_entry_admission_schema" using clause by simp
  have children: "(19,f 0)\<in>positive_meaning artifact_entry_admission_system"
    "(11,f 1)\<in>positive_meaning artifact_entry_admission_system"
    using support[rule_format, of 0 19 data_x] support[rule_format, of 1 11 data_y] schema
    by (simp_all add: artifact_entry_admission_schema_def)
  obtain u R where fields: "f 0=use_data_term u" "artifact_value_presents R (f 1)"
    using children by (auto simp: artifact_entry_admission_coordinate artifact_entry_admission_artifact)
  show "\<exists>z. environment_artifact_entry_presents z t"
    by (intro exI[of _ "(u,R)"])
      (use head fields in \<open>auto simp: schema artifact_entry_admission_schema_def environment_artifact_entry_presents_def\<close>)
next
  assume "\<exists>z. environment_artifact_entry_presents z t"
  then obtain z v where material: "artifact_value_presents (snd z) v"
    and shape: "t=Pair_Term (use_data_term (fst z)) v"
    unfolding environment_artifact_entry_presents_def by blast
  have formed: "term_formed v" using artifact_value_presents_formed[OF material] by blast
  have children: "(19,use_data_term (fst z))\<in>positive_meaning artifact_entry_admission_system"
    "(11,v)\<in>positive_meaning artifact_entry_admission_system"
    using material by (auto simp: artifact_entry_admission_coordinate artifact_entry_admission_artifact)
  let ?f="\<lambda>i::nat. if i=0 then use_data_term (fst z) else v"
  have result: "(22,evaluate_pattern ?f (schema_conclusion artifact_entry_admission_schema))
    \<in>positive_meaning artifact_entry_admission_system"
    by (rule ordinary_positive_valuation_step[where c=0])
      (use formed children in \<open>auto simp: artifact_entry_admission_schema_def schema_variables_def artifact_entry_admission_call\<close>)
  show "(22,t)\<in>positive_meaning artifact_entry_admission_system"
    using result by (simp add: shape artifact_entry_admission_schema_def)
qed

