  have children: "(26,x)\<in>positive_meaning environment_identity_system"
    "(26,y)\<in>positive_meaning environment_identity_system"
    "(16,Pair_Term x y)\<in>positive_meaning environment_identity_system"
    using first second environment_comparison_exact[OF first second]
      environment_identity_old_meaning[of 16 "Pair_Term x y"] by (auto simp: environment_identity_admission)
  let ?f="\<lambda>i::nat. if i=0 then x else y"
  have result: "(27,evaluate_pattern ?f (schema_conclusion environment_identity_schema))\<in>positive_meaning environment_identity_system"
    by (rule ordinary_positive_valuation_step[where c=0])
      (use formed children in \<open>auto simp: environment_identity_schema_def schema_variables_def environment_identity_call\<close>)
  show "(27,t)\<in>positive_meaning environment_identity_system" using result by (simp add: shape environment_identity_schema_def)
qed

corollary admitted_environment_comparison:
  assumes "environment_value_presents E x" "environment_value_presents F y"
  shows "(27,Pair_Term x y)\<in>positive_meaning environment_identity_system \<longleftrightarrow> E=F"
  using assms environment_value_presents_unique by (auto simp: environment_identity_exact; blast)

lemma environment_checking_exact:
  assumes "d\<in>{26,27}"
  shows "(d,t)\<in>positive_meaning environment_identity_system \<longleftrightarrow>
    (d=26 \<and> (\<exists>E. environment_value_presents E t)) \<or>
    (d=27 \<and> (\<exists>E x y. t=Pair_Term x y \<and> environment_value_presents E x \<and> environment_value_presents E y))"
  using assms by (auto simp: environment_identity_admission environment_identity_exact)

section \<open>One closed native program for all future admission and equality calls\<close>

theorem native_environment_checking:
  "\<exists>E :: local_address option artifact_environment. \<exists>pu Q g.
    closed_native_package_at E pu [] Q \<and> inj_on g {26::nat,27} \<and>
    (\<forall>d\<in>{26,27}. \<forall>t. term_formed t \<longrightarrow>
      (\<exists>F au I K. environment_formed F \<and> environment_included E F \<and> au\<notin>environment_uses E \<and>
        native_package_at F pu [] Q \<and> native_application_at F au [] (g d) t I K \<and>
        native_package_environment F pu []=E \<and> native_application_formed F pu [] au [] \<and>
        (native_positive_holds F pu [] au [] \<longleftrightarrow>
          (d=26 \<and> (\<exists>R. environment_value_presents R t)) \<or>
          (d=27 \<and> (\<exists>R x y. t=Pair_Term x y \<and> environment_value_presents R x \<and> environment_value_presents R y)))))"
proof -
  obtain g :: "nat \<Rightarrow> local_address option definition_site"
    and E :: "local_address option artifact_environment" and pu Q
    where injective: "inj_on g (system_definitions environment_identity_system)"
    and closed: "closed_native_package_at E pu [] Q"
    and future: "\<forall>d\<in>system_definitions environment_identity_system. \<forall>t. term_formed t \<longrightarrow>
      (\<exists>F au I K. environment_formed F \<and> environment_included E F \<and> au\<notin>environment_uses E \<and>
        native_package_at F pu [] Q \<and> native_application_at F au [] (g d) t I K \<and>
        native_package_environment F pu []=E \<and>
        (native_application_formed F pu [] au [] \<longleftrightarrow> schema_call_formed environment_identity_system d t) \<and>
        (native_positive_holds F pu [] au [] \<longleftrightarrow> (d,t)\<in>positive_meaning environment_identity_system) \<and>
        (\<forall>v\<in>environment_uses E. \<forall>R. artifact_at F v R \<longleftrightarrow> artifact_at E v R) \<and>
        (\<forall>v\<in>environment_uses E. \<forall>k w. binds_slot F v k w \<longleftrightarrow> binds_slot E v k w))"
    using compiled_program_future_applications[OF environment_identity_system_formed] by blast
  have sites: "inj_on g {26,27}" using injective by (auto simp: inj_on_def)
  show ?thesis
  proof (rule exI[of _ E], rule exI[of _ pu], rule exI[of _ Q], rule exI[of _ g], intro conjI ballI allI impI)
    show "closed_native_package_at E pu [] Q" by (rule closed)
    show "inj_on g {26,27}" by (rule sites)
  next
    fix d :: nat and t :: factor_term
    assume selected: "d\<in>{26,27}" and tf: "term_formed t"
    have member: "d\<in>system_definitions environment_identity_system" using selected by auto
    obtain F au I K where parts: "environment_formed F" "environment_included E F" "au\<notin>environment_uses E"
      "native_package_at F pu [] Q" "native_application_at F au [] (g d) t I K"
      "native_package_environment F pu []=E"
      "native_application_formed F pu [] au [] \<longleftrightarrow> schema_call_formed environment_identity_system d t"
      "native_positive_holds F pu [] au [] \<longleftrightarrow> (d,t)\<in>positive_meaning environment_identity_system"
      using future[rule_format, OF member tf] by blast
    show "\<exists>F au I K. environment_formed F \<and> environment_included E F \<and> au\<notin>environment_uses E \<and>
      native_package_at F pu [] Q \<and> native_application_at F au [] (g d) t I K \<and>
      native_package_environment F pu []=E \<and> native_application_formed F pu [] au [] \<and>
      (native_positive_holds F pu [] au [] \<longleftrightarrow>
        (d=26 \<and> (\<exists>R. environment_value_presents R t)) \<or>
        (d=27 \<and> (\<exists>R x y. t=Pair_Term x y \<and> environment_value_presents R x \<and> environment_value_presents R y)))"
      by (rule exI[of _ F], rule exI[of _ au], rule exI[of _ I], rule exI[of _ K])
        (use parts tf member environment_checking_exact[OF selected] in \<open>auto simp: environment_identity_call\<close>)
  qed
qed

text \<open>
  Admission is an ordinary program over the existing complete environment
  data presentation. It checks every artifact value, every optional use
  coordinate, unique use keys, unique source-slot keys, and all source,
  target, and source-carrier conditions. Empty tables and finite binding
  cycles follow the same environment formation laws.

  The source-row, target-row, and slot selections have distinct sockets.
  All ten variables of that clause, including the three selected-list
  remainders, belong to its ordinary finite assignment. Completeness uses
  rows actually selected from the supplied artifact presentation; a different
  presentation of an equal artifact is never silently substituted into it.

  The complete program has twenty-eight definitions and fifty clauses.
  Earlier meanings and interfaces are preserved. Admission and admitted
  identity occupy distinct definitions in one fixed closed native program,
  selected before any future formed input is supplied. This checks complete
  environment data; grammar-derived closure, application checking, policy
  authority, and amendment adoption remain separate obligations.
\<close>

