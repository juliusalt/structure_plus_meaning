  have admissions: "(26,f 0)\<in>positive_meaning environment_identity_system"
    "(26,f 1)\<in>positive_meaning environment_identity_system"
    using support[rule_format, of 0 26 data_x] support[rule_format, of 1 26 data_y] schema
    by (simp_all add: environment_identity_schema_def)
  obtain E F where first: "environment_value_presents E (f 0)" and second: "environment_value_presents F (f 1)"
    using admissions by (auto simp: environment_identity_admission)
  have comparison: "(16,Pair_Term (f 0) (f 1))\<in>positive_meaning environment_comparison_system"
    using support[rule_format, of 2 16 "Pattern_Pair data_x data_y"]
      environment_identity_old_meaning[of 16 "Pair_Term (f 0) (f 1)"]
    by (auto simp: schema environment_identity_schema_def)
  have same: "E=F" by (rule iffD1[OF environment_comparison_exact[OF first second] comparison])
  show "\<exists>E x y. t=Pair_Term x y \<and> environment_value_presents E x \<and> environment_value_presents E y"
    using head first second same by (auto simp: schema environment_identity_schema_def)
