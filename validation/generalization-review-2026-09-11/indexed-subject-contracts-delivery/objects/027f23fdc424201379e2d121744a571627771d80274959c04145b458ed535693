lemma admitted_artifact_table:
  "(23,a)\<in>positive_meaning artifact_entries_system \<and> (21,a)\<in>positive_meaning keyed_list_system \<longleftrightarrow>
    (\<exists>A. data_collection_presents environment_artifact_entry_presents A a \<and> single_valued A)"
proof -
  have keys: "(21,data_list_term ts)\<in>positive_meaning keyed_list_system \<longleftrightarrow>
    distinct xs \<and> single_valued (set xs)"
    if read: "list_all2 environment_artifact_entry_presents xs ts" for xs ts
  proof (rule keyed_list_encoded_keys[OF read environment_artifact_list_data[OF read] use_data_term_injective])
    fix z t assume "environment_artifact_entry_presents z t"
    then show "\<exists>v. t=Pair_Term (use_data_term (fst z)) v"
      by (auto simp: environment_artifact_entry_presents_def)
  qed
  show ?thesis
  proof
    assume holds: "(23,a)\<in>positive_meaning artifact_entries_system \<and> (21,a)\<in>positive_meaning keyed_list_system"
    obtain xs ts where rows: "a=data_list_term ts" "list_all2 environment_artifact_entry_presents xs ts"
      using holds by (auto simp: artifact_entries_exact)
    have unique: "distinct xs \<and> single_valued (set xs)" using holds rows(1) keys[OF rows(2)] by simp
    show "\<exists>A. data_collection_presents environment_artifact_entry_presents A a \<and> single_valued A"
      by (intro exI[of _ "set xs"]) (use rows unique in \<open>auto simp: data_collection_presents_def\<close>)
  next
    assume "\<exists>A. data_collection_presents environment_artifact_entry_presents A a \<and> single_valued A"
    then obtain A xs ts where rows: "distinct xs" "set xs=A" "list_all2 environment_artifact_entry_presents xs ts"
      "a=data_list_term ts" "single_valued A" unfolding data_collection_presents_def by blast
    show "(23,a)\<in>positive_meaning artifact_entries_system \<and> (21,a)\<in>positive_meaning keyed_list_system"
      using rows keys[OF rows(3)] by (auto simp: artifact_entries_exact)
  qed
qed

lemma admitted_binding_table:
  assumes read: "data_collection_presents environment_artifact_entry_presents A a"
  shows "(25,Pair_Term a b)\<in>positive_meaning binding_entries_system \<and> (21,b)\<in>positive_meaning keyed_list_system
    \<longleftrightarrow> (\<exists>B. data_collection_presents (\<lambda>z t. t=binding_data z) B b \<and>
      single_valued B \<and> (\<forall>z\<in>B. binding_supported A z))"
proof -
  have injective: "inj (case_prod site_data_term)"
    by (rule injI; rename_tac z w; case_tac z; case_tac w) simp
  have keys: "(21,data_list_term (map binding_data zs))\<in>positive_meaning keyed_list_system \<longleftrightarrow>
    distinct zs \<and> single_valued (set zs)"
    if data: "data_elements (map binding_data zs)" for zs
  proof (rule keyed_list_encoded_keys[OF _ data injective])
    show "list_all2 (\<lambda>z t. t=binding_data z) zs (map binding_data zs)"
      by (simp add: list_all2_function)
  next
    fix z t assume "t=binding_data z"
    then show "\<exists>v. t=Pair_Term (case_prod site_data_term (fst z)) v"
      by (auto simp: binding_data_def site_data_term_def split: prod.splits)
  qed
  show ?thesis
  proof
    assume holds: "(25,Pair_Term a b)\<in>positive_meaning binding_entries_system \<and> (21,b)\<in>positive_meaning keyed_list_system"
    obtain zs where rows: "b=data_list_term (map binding_data zs)" "\<forall>z\<in>set zs. binding_supported A z"
      using holds by (auto simp: binding_entries_exact[OF read])
    have data: "data_elements (map binding_data zs)"
      by (rule binding_entries_data[of a]) (use holds rows(1) in simp)
    have unique: "distinct zs \<and> single_valued (set zs)" using keys[OF data] holds rows(1) by simp
    show "\<exists>B. data_collection_presents (\<lambda>z t. t=binding_data z) B b \<and>
      single_valued B \<and> (\<forall>z\<in>B. binding_supported A z)"
      by (intro exI[of _ "set zs"])
        (use rows unique in \<open>auto simp: data_collection_presents_function\<close>)
  next
    assume "\<exists>B. data_collection_presents (\<lambda>z t. t=binding_data z) B b \<and>
      single_valued B \<and> (\<forall>z\<in>B. binding_supported A z)"
    then obtain B zs where rows: "distinct zs" "set zs=B" "b=data_list_term (map binding_data zs)"
      "single_valued B" "\<forall>z\<in>B. binding_supported A z"
      by (auto simp: data_collection_presents_function)
    have holds: "(25,Pair_Term a b)\<in>positive_meaning binding_entries_system"
      using rows by (auto simp: binding_entries_exact[OF read])
    have data: "data_elements (map binding_data zs)"
      by (rule binding_entries_data[of a]) (use holds rows(3) in simp)
    show "(25,Pair_Term a b)\<in>positive_meaning binding_entries_system \<and> (21,b)\<in>positive_meaning keyed_list_system"
      using holds keys[OF data] rows by simp
  qed
qed

