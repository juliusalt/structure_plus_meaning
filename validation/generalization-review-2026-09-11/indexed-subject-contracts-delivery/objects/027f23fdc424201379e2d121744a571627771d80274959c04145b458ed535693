theorem environment_admission_raw:
  "(26,t)\<in>positive_meaning environment_admission_system \<longleftrightarrow>
    (\<exists>a b. t=Pair_Term a b \<and> (23,a)\<in>positive_meaning artifact_entries_system \<and>
      (21,a)\<in>positive_meaning keyed_list_system \<and>
      (25,Pair_Term a b)\<in>positive_meaning binding_entries_system \<and>
      (21,b)\<in>positive_meaning keyed_list_system)"
proof
  assume holds: "(26,t)\<in>positive_meaning environment_admission_system"
  have consequence: "(26,t)\<in>schema_consequences environment_admission_system (positive_meaning environment_admission_system)"
    using holds positive_meaning_unfold[of environment_admission_system] by blast
  obtain c S f where clause: "((26,c),S)\<in>system_clauses environment_admission_system"
    and head: "t=evaluate_pattern f (schema_conclusion S)"
    and support: "\<forall>s d p. (s,d,p)\<in>schema_premises S \<longrightarrow>
      (d,evaluate_pattern f p)\<in>positive_meaning environment_admission_system"
    using schema_consequences_valuationD[OF consequence] by blast
  have schema: "S=environment_admission_schema" using clause by simp
  show "\<exists>a b. t=Pair_Term a b \<and> (23,a)\<in>positive_meaning artifact_entries_system \<and>
    (21,a)\<in>positive_meaning keyed_list_system \<and>
    (25,Pair_Term a b)\<in>positive_meaning binding_entries_system \<and>
    (21,b)\<in>positive_meaning keyed_list_system"
    using head support by (auto simp: schema environment_admission_schema_def environment_admission_components)
next
  assume "\<exists>a b. t=Pair_Term a b \<and> (23,a)\<in>positive_meaning artifact_entries_system \<and>
    (21,a)\<in>positive_meaning keyed_list_system \<and>
    (25,Pair_Term a b)\<in>positive_meaning binding_entries_system \<and>
    (21,b)\<in>positive_meaning keyed_list_system"
  then obtain a b where shape: "t=Pair_Term a b" and children:
    "(23,a)\<in>positive_meaning artifact_entries_system" "(21,a)\<in>positive_meaning keyed_list_system"
    "(25,Pair_Term a b)\<in>positive_meaning binding_entries_system" "(21,b)\<in>positive_meaning keyed_list_system" by blast
  have formed: "term_formed a" "term_formed b"
    using schema_call_formed_target[OF positive_meaning_formed[OF children(2)]]
      schema_call_formed_target[OF positive_meaning_formed[OF children(4)]] by auto
  let ?f="\<lambda>i::nat. if i=0 then a else b"
  have result: "(26,evaluate_pattern ?f (schema_conclusion environment_admission_schema))
    \<in>positive_meaning environment_admission_system"
    by (rule ordinary_positive_valuation_step[where c=0])
      (use formed children in \<open>auto simp: environment_admission_schema_def schema_variables_def
        environment_admission_call environment_admission_components\<close>)
  show "(26,t)\<in>positive_meaning environment_admission_system" using result by (simp add: shape environment_admission_schema_def)
qed

theorem environment_admission_exact:
  "(26,t)\<in>positive_meaning environment_admission_system \<longleftrightarrow> (\<exists>E. environment_value_presents E t)"
proof
  assume holds: "(26,t)\<in>positive_meaning environment_admission_system"
  obtain a b where shape: "t=Pair_Term a b"
    and artifacts: "(23,a)\<in>positive_meaning artifact_entries_system" "(21,a)\<in>positive_meaning keyed_list_system"
    and bindings: "(25,Pair_Term a b)\<in>positive_meaning binding_entries_system" "(21,b)\<in>positive_meaning keyed_list_system"
    using holds by (auto simp: environment_admission_raw)
  obtain A where first: "data_collection_presents environment_artifact_entry_presents A a" "single_valued A"
    using artifacts admitted_artifact_table[of a] by blast
  obtain B where second: "data_collection_presents (\<lambda>z v. v=binding_data z) B b"
    "single_valued B" "\<forall>z\<in>B. binding_supported A z"
    using bindings admitted_binding_table[OF first(1), of b] by blast
  have finite: "finite A" "finite B" using data_collection_presents_finite[OF first(1)]
    data_collection_presents_finite[OF second(1)] by auto
  have material: "exact_formed R" if member: "(u,R)\<in>A" for u R
  proof -
    obtain v where entry: "environment_artifact_entry_presents (u,R) v"
      using data_collection_presents_sources[OF first(1), rule_format, OF member] by blast
    obtain w where read: "artifact_value_presents R w"
      using entry by (auto simp: environment_artifact_entry_presents_def)
    show ?thesis using artifact_value_presents_formed[OF read] by blast
  qed
  have supported: "(\<exists>R. (u,R)\<in>A \<and> k\<in>rra_carrier (object_structure R)) \<and> v\<in>rel_dom A"
    if member: "((u,k),v)\<in>B" for u k v
    using second(3)[rule_format, OF member] by simp
  let ?E="\<lparr>environment_artifacts=A,environment_bindings=B\<rparr>"
  have formed: "environment_formed ?E"
    using finite first(2) second(2) material supported
    by (auto simp: environment_formed_def artifact_at_def binds_slot_def environment_uses_def)
  have present: "environment_value_presents ?E t" using formed first(1) second(1) shape
    by (auto simp: environment_value_presents_def)
  show "\<exists>E. environment_value_presents E t" using present by blast
next
  assume "\<exists>E. environment_value_presents E t"
  then obtain E a b where formed: "environment_formed E" and shape: "t=Pair_Term a b"
    and first: "data_collection_presents environment_artifact_entry_presents (environment_artifacts E) a"
    and second: "data_collection_presents (\<lambda>z v. v=binding_data z) (environment_bindings E) b"
    unfolding environment_value_presents_def by blast
  have unique: "single_valued (environment_artifacts E)" "single_valued (environment_bindings E)"
    using formed by (auto simp: environment_formed_def)
  have supported: "\<forall>z\<in>environment_bindings E. binding_supported (environment_artifacts E) z"
  proof (intro ballI)
    fix z assume member: "z\<in>environment_bindings E"
    obtain u k v where row: "z=((u,k),v)" by (cases z) auto
    have binding: "binds_slot E u k v" using member by (simp add: row binds_slot_def)
    have support: "(\<exists>R. artifact_at E u R \<and> k\<in>rra_carrier (object_structure R)) \<and>
      v\<in>environment_uses E"
      using formed binding unfolding environment_formed_def by blast
    show "binding_supported (environment_artifacts E) z"
      using support by (simp add: row artifact_at_def environment_uses_def)
  qed
  have artifacts: "(23,a)\<in>positive_meaning artifact_entries_system \<and> (21,a)\<in>positive_meaning keyed_list_system"
    using first unique(1) by (auto simp: admitted_artifact_table)
  have bindings: "(25,Pair_Term a b)\<in>positive_meaning binding_entries_system \<and> (21,b)\<in>positive_meaning keyed_list_system"
    using second unique(2) supported admitted_binding_table[OF first, of b] by blast
  show "(26,t)\<in>positive_meaning environment_admission_system"
    using artifacts bindings by (auto simp: shape environment_admission_raw)
qed

