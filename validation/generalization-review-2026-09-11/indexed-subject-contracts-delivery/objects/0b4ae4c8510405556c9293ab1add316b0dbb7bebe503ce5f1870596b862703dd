theory Factor_Future_Applications
  imports "Factor_Native_Meaning" "Factor_Application_Encoding" "RRA_Fresh_Uses"
begin

section \<open>Application recovery commutes with use placement and inclusion\<close>

lemma native_application_use_renaming:
  assumes app: "native_application_at E u r d t I K" and injective: "inj h"
  shows "native_application_at (rename_environment h E) (h u) r (h (fst d),snd d) t I K"
proof -
  let ?F = "rename_environment h E"
  have ef: "environment_formed E" using app by (simp add: native_application_at_def)
  have ff: "environment_formed ?F" by (rule environment_renaming_formed[OF ef injective])
  obtain R ps c a cite C J A where parts:
    "artifact_at E u R" "record_at R r ps [c,a]" "citation_at R c cite C"
    "citation_location E u cite (fst d) (snd d)" "term_quoted_at E u a t J A"
    "insert r (set ps) \<inter> (C \<union> J) = {}" "C \<inter> J = {}"
    "I=insert r (set ps \<union> C \<union> J)" "K=citation_slots cite \<union> A" "I \<inter> K = {}"
    using app by (auto simp: native_application_at_def)
  have art: "artifact_at ?F (h u) R"
    using artifact_at_renamed_use[OF injective, of E u R] parts(1) by simp
  have loc: "citation_location ?F (h u) cite (h (fst d)) (snd d)"
    using citation_location_use_renaming[OF injective, of E u cite "fst d" "snd d"] parts(4) by simp
  have quote: "term_quoted_at ?F (h u) a t J A" by (rule term_quoted_use_renaming[OF parts(5) injective])
  show ?thesis unfolding native_application_at_def
    by (rule conjI[OF ff], rule exI[of _ R], rule exI[of _ ps],
        rule exI[of _ c], rule exI[of _ a], rule exI[of _ cite],
        rule exI[of _ C], rule exI[of _ J], rule exI[of _ A])
       (use art loc quote parts(2,3,6-10) in auto)
qed

lemma native_application_included:
  assumes app: "native_application_at E u r d t I K" and included: "environment_included E F"
    and ff: "environment_formed F"
  shows "native_application_at F u r d t I K"
proof -
  obtain R ps c a cite C J A where parts:
    "artifact_at E u R" "record_at R r ps [c,a]" "citation_at R c cite C"
    "citation_location E u cite (fst d) (snd d)" "term_quoted_at E u a t J A"
    "insert r (set ps) \<inter> (C \<union> J) = {}" "C \<inter> J = {}"
    "I=insert r (set ps \<union> C \<union> J)" "K=citation_slots cite \<union> A" "I \<inter> K = {}"
    using app by (auto simp: native_application_at_def)
  have art: "artifact_at F u R" by (rule included_artifact[OF included parts(1)])
  have loc: "citation_location F u cite (fst d) (snd d)" by (rule included_location[OF included parts(4)])
  have quote: "term_quoted_at F u a t J A" by (rule term_quoted_included[OF parts(5) included ff])
  show ?thesis using ff art loc quote parts(2,3,6-10)
    unfolding native_application_at_def by blast
qed

lemma call_environment_binding_source:
  assumes "binds_slot (call_environment R a t) u k v"
  shows "u=Some []"
proof -
  obtain x y where source: "u=call_use x"
    and binding: "binds_slot (term_environment (Pair_Term (Target_Term (Occurrence_Anchor (R,a))) t)) x k y"
    using assms by (auto simp: call_environment_def binds_slot_renaming)
  have "x=None" using binding by (cases x) (auto simp: term_environment_def)
  then show ?thesis using source by simp
qed

lemma call_environment_target_passive:
  "\<not> binds_slot (call_environment R a t) None k v"
  using call_environment_binding_source by fastforce

section \<open>Every formed future term can be added to an existing environment\<close>

definition future_call_environment ::
  "local_address option artifact_environment \<Rightarrow> local_address option \<Rightarrow> exact_artifact \<Rightarrow>
    local_address \<Rightarrow> factor_term \<Rightarrow> local_address option artifact_environment" where
  "future_call_environment E u R a t = graft_environment E u (call_environment R a t)"

definition future_call_use ::
  "local_address option artifact_environment \<Rightarrow> local_address option \<Rightarrow> local_address option" where
  "future_call_use E u = fresh_use_map (environment_uses E) u (Some [])"

lemma future_call_use_fresh:
  assumes "environment_formed E"
  shows "future_call_use E u \<notin> environment_uses E"
  using fresh_use_map_outside[OF environment_uses_finite[OF assms], of u "[]"]
  by (simp add: future_call_use_def)

lemma future_call_includes_existing:
  "environment_included E (future_call_environment E u R a t)"
  unfolding future_call_environment_def by (rule graft_includes_existing)

theorem future_call_environment_formed:
  assumes ef: "environment_formed E" and source: "artifact_at E u R"
    and anchor: "anchor_formed (R,a)" and arg: "term_formed t"
  shows "environment_formed (future_call_environment E u R a t)"
  unfolding future_call_environment_def
  by (rule graft_environment_formed[OF ef call_environment_formed[OF anchor arg] source
        call_environment_target call_environment_target_passive])

theorem future_call_existing_artifacts:
  assumes ef: "environment_formed E" and source: "artifact_at E u R"
    and anchor: "anchor_formed (R,a)" and arg: "term_formed t" and member: "v \<in> environment_uses E"
  shows "artifact_at (future_call_environment E u R a t) v S \<longleftrightarrow> artifact_at E v S"
  unfolding future_call_environment_def
  by (rule graft_existing_artifacts_unchanged[OF ef call_environment_formed[OF anchor arg]
        source call_environment_target member])

theorem future_call_existing_bindings:
  assumes ef: "environment_formed E" and member: "v \<in> environment_uses E"
  shows "binds_slot (future_call_environment E u R a t) v k w \<longleftrightarrow> binds_slot E v k w"
  unfolding future_call_environment_def
  by (rule graft_existing_bindings_unchanged[OF ef call_environment_target_passive member])

theorem future_call_representation:
  assumes ef: "environment_formed E" and source: "artifact_at E u R"
    and anchor: "anchor_formed (R,a)" and arg: "term_formed t"
  shows "\<exists>I K. native_application_at (future_call_environment E u R a t) (future_call_use E u) [] (u,a) t I K \<and>
    rra_carrier (object_structure (call_syntax R a t)) = I \<union> K"
proof -
  let ?C = "call_environment R a t"
  let ?h = "fresh_use_map (environment_uses E) u"
  let ?F = "future_call_environment E u R a t"
  let ?I = "term_syntax_interior (Pair_Term (Target_Term (Occurrence_Anchor (R,a))) t)"
  let ?K = "rel_dom (term_literal_bindings (Pair_Term (Target_Term (Occurrence_Anchor (R,a))) t))"
  have injective: "inj ?h" by (rule fresh_use_map_injective[OF environment_uses_finite[OF ef]])
  have original: "native_application_at ?C (Some []) [] (None,a) t ?I ?K"
    by (rule native_application_representation[OF anchor arg])
  have placed: "native_application_at (rename_environment ?h ?C) (future_call_use E u) [] (u,a) t ?I ?K"
    using native_application_use_renaming[OF original injective]
    by (simp add: future_call_use_def)
  have included: "environment_included (rename_environment ?h ?C) ?F"
    unfolding future_call_environment_def by (rule graft_includes_imported)
  have ff: "environment_formed ?F" by (rule future_call_environment_formed[OF assms])
  have recovered: "native_application_at ?F (future_call_use E u) [] (u,a) t ?I ?K"
    by (rule native_application_included[OF placed included ff])
  show ?thesis using recovered native_application_complete_carrier[of R a t] by blast
qed

theorem future_call_preserves_program:
  assumes package: "native_package_at E pu pr P" and source: "artifact_at E u R"
    and anchor: "anchor_formed (R,a)" and arg: "term_formed t"
  shows "native_package_at (future_call_environment E u R a t) pu pr P"
    and "native_package_environment (future_call_environment E u R a t) pu pr = native_package_environment E pu pr"
proof -
  have ef: "environment_formed E"
    using native_package_projection(1)[OF package] by (simp add: native_package_formed_def)
  have ff: "environment_formed (future_call_environment E u R a t)"
    by (rule future_call_environment_formed[OF ef source anchor arg])
  show "native_package_at (future_call_environment E u R a t) pu pr P"
    by (rule native_package_included[OF package future_call_includes_existing ff])
  show "native_package_environment (future_call_environment E u R a t) pu pr = native_package_environment E pu pr"
    by (rule native_package_environment_extension[OF package future_call_includes_existing ff])
qed

theorem future_call_truth:
  assumes package: "native_package_at E pu pr P" and source: "artifact_at E u R"
    and anchor: "anchor_formed (R,a)" and arg: "term_formed t"
  shows "native_positive_holds (future_call_environment E u R a t) pu pr (future_call_use E u) []
    \<longleftrightarrow> ((u,a),t) \<in> positive_meaning P"
proof -
  have ef: "environment_formed E"
    using native_package_projection(1)[OF package] by (simp add: native_package_formed_def)
  have preserved: "native_package_at (future_call_environment E u R a t) pu pr P"
    by (rule future_call_preserves_program(1)[OF assms])
  obtain I K where app: "native_application_at (future_call_environment E u R a t) (future_call_use E u) [] (u,a) t I K"
    using future_call_representation[OF ef source anchor arg] by blast
  show ?thesis by (rule native_positive_holds_with_reads[OF preserved app])
qed

theorem future_call_formed_against_interface:
  assumes package: "native_package_at E pu pr P" and source: "artifact_at E u R"
    and anchor: "anchor_formed (R,a)" and arg: "term_formed t"
    and call: "schema_call_formed P (u,a) t"
  shows "native_application_formed (future_call_environment E u R a t) pu pr (future_call_use E u) []"
proof -
  have ef: "environment_formed E"
    using native_package_projection(1)[OF package] by (simp add: native_package_formed_def)
  have preserved: "native_package_at (future_call_environment E u R a t) pu pr P"
    by (rule future_call_preserves_program(1)[OF package source anchor arg])
  obtain I K where app: "native_application_at (future_call_environment E u R a t) (future_call_use E u) [] (u,a) t I K"
    using future_call_representation[OF ef source anchor arg] by blast
  show ?thesis using preserved app call unfolding native_application_formed_def by blast
qed

lemma future_call_arguments_distinct:
  assumes ef: "environment_formed E" and source: "artifact_at E u R" and anchor: "anchor_formed (R,a)"
    and tf: "term_formed t" and sf: "term_formed s"
    and same: "future_call_environment E u R a t = future_call_environment E u R a s"
  shows "t=s"
proof -
  obtain I K where first: "native_application_at (future_call_environment E u R a t) (future_call_use E u) [] (u,a) t I K"
    using future_call_representation[OF ef source anchor tf] by blast
  obtain J W where second: "native_application_at (future_call_environment E u R a s) (future_call_use E u) [] (u,a) s J W"
    using future_call_representation[OF ef source anchor sf] by blast
  have other: "native_application_at (future_call_environment E u R a t) (future_call_use E u) [] (u,a) s J W"
    using second same by simp
  show ?thesis using native_application_unique[OF first other] by blast
qed

theorem future_call_environment_family_infinite:
  assumes ef: "environment_formed E" and source: "artifact_at E u R" and anchor: "anchor_formed (R,a)"
  shows "infinite (future_call_environment E u R a ` {t. term_formed t})"
proof
  assume finite: "finite (future_call_environment E u R a ` {t. term_formed t})"
  have injective: "inj_on (future_call_environment E u R a) {t. term_formed t}"
    by (rule inj_onI) (auto intro: future_call_arguments_distinct[OF ef source anchor])
  have "finite {t. term_formed t}" by (rule finite_imageD[OF finite injective])
  then show False using future_term_domain_is_infinite by blast
qed

text \<open>
  This construction permits arbitrary existing outgoing bindings at the callee
  use. The separate call package contributes none there. Its other uses are
  fresh, and every old artifact value and binding remains exact. Repeating the
  construction with the resulting finite environment allocates further fresh
  occurrences in the same unbounded carrier.

  Program closure is identical before and after the extension. Applications
  recover their ordinary arguments and check the original interface; truth is
  the original program's independent meaning. No proof, retention, adoption,
  or foundation-wide resource rule is added by supplying a future argument.
\<close>

end
