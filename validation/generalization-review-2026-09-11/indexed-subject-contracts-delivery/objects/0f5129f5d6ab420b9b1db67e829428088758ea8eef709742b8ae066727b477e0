theory Inference_Closure
  imports "Obligation_Reductions"
begin

section \<open>Local inference rules determine their least consequences\<close>

definition inference_consequences ::
  "('a \<Rightarrow> ('i \<times> 'a) set \<Rightarrow> bool) \<Rightarrow> 'a set \<Rightarrow> 'a set" where
  "inference_consequences R X={a. \<exists>H. finite H \<and> single_valued H \<and>
    R a H \<and> rel_ran H\<subseteq>X}"

lemma inference_consequences_mono:
  "mono (inference_consequences R)"
  by (auto simp: mono_def inference_consequences_def)

definition inference_closure ::
  "('a \<Rightarrow> ('i \<times> 'a) set \<Rightarrow> bool) \<Rightarrow> 'a set \<Rightarrow> 'a set" where
  "inference_closure R K=lfp (\<lambda>X. K\<union>inference_consequences R X)"

lemma inference_closure_unfold:
  "inference_closure R K=K\<union>inference_consequences R (inference_closure R K)"
  unfolding inference_closure_def
  by (rule lfp_unfold) (use inference_consequences_mono in \<open>auto simp: mono_def\<close>)

lemma inference_closure_seed:
  "K\<subseteq>inference_closure R K"
  by (subst inference_closure_unfold) blast

lemma inference_closure_step:
  assumes "finite H" "single_valued H" "R a H" "rel_ran H\<subseteq>inference_closure R K"
  shows "a\<in>inference_closure R K"
  by (subst inference_closure_unfold)
    (use assms in \<open>auto simp: inference_consequences_def\<close>)

theorem inference_closure_least:
  assumes "K\<subseteq>X" "inference_consequences R X\<subseteq>X"
  shows "inference_closure R K\<subseteq>X"
  unfolding inference_closure_def
  by (rule lfp_lowerbound) (use assms in blast)

lemma inference_closure_closed:
  "inference_consequences R (inference_closure R K)\<subseteq>inference_closure R K"
  using inference_closure_unfold[of R K] by blast

theorem inference_closure_mono:
  assumes "K\<subseteq>L"
  shows "inference_closure R K\<subseteq>inference_closure R L"
  by (rule inference_closure_least)
    (use assms inference_closure_seed[of L R] inference_closure_closed[of R L] in blast)+

theorem inference_closure_idempotent:
  "inference_closure R (inference_closure R K)=inference_closure R K"
proof (rule equalityI)
  show "inference_closure R (inference_closure R K)\<subseteq>inference_closure R K"
    by (rule inference_closure_least[OF subset_refl inference_closure_closed])
  show "inference_closure R K\<subseteq>inference_closure R (inference_closure R K)"
    by (rule inference_closure_seed)
qed

theorem inference_closure_cut:
  assumes "a\<in>inference_closure R H" "H\<subseteq>inference_closure R K"
  shows "a\<in>inference_closure R K"
proof -
  have enlarged: "inference_closure R H\<subseteq>inference_closure R (inference_closure R K)"
    by (rule inference_closure_mono[OF assms(2)])
  have included: "inference_closure R H\<subseteq>inference_closure R K"
    using enlarged by (simp only: inference_closure_idempotent)
  show ?thesis by (rule subsetD[OF included assms(1)])
qed

theorem inference_closure_accumulate:
  "inference_closure R (inference_closure R K\<union>L)=inference_closure R (K\<union>L)"
proof (rule equalityI)
  have "inference_closure R K\<union>L\<subseteq>inference_closure R (K\<union>L)"
    using inference_closure_mono[of K "K\<union>L" R]
      inference_closure_seed[of "K\<union>L" R] by blast
  then show "inference_closure R (inference_closure R K\<union>L)\<subseteq>
      inference_closure R (K\<union>L)"
    using inference_closure_mono by (metis inference_closure_idempotent)
next
  show "inference_closure R (K\<union>L)\<subseteq>
      inference_closure R (inference_closure R K\<union>L)"
    by (rule inference_closure_mono) (use inference_closure_seed[of K R] in blast)
qed

section \<open>Finite derivation and semantic soundness remain distinct\<close>

inductive finite_inference ::
  "('a \<Rightarrow> ('i \<times> 'a) set \<Rightarrow> bool) \<Rightarrow> 'a set \<Rightarrow> 'a \<Rightarrow> bool"
  for R K where
  seed: "a\<in>K \<Longrightarrow> finite_inference R K a"
| step: "finite H \<Longrightarrow> single_valued H \<Longrightarrow> R a H \<Longrightarrow>
    (\<forall>b\<in>rel_ran H. finite_inference R K b) \<Longrightarrow> finite_inference R K a"

theorem finite_inference_sound:
  "finite_inference R K a \<Longrightarrow> a\<in>inference_closure R K"
proof (induction rule: finite_inference.induct)
  case (seed a)
  show ?case by (rule subsetD[OF inference_closure_seed seed])
next
  case (step H a)
  show ?case by (rule inference_closure_step[where H=H and R=R])
    (rule step.hyps(1), rule step.hyps(2), rule step.hyps(3), use step.IH in blast)
qed

theorem finite_inference_complete:
  "a\<in>inference_closure R K \<Longrightarrow> finite_inference R K a"
proof -
  have "inference_closure R K\<subseteq>{a. finite_inference R K a}"
    by (rule inference_closure_least)
      (auto simp: inference_consequences_def intro: finite_inference.intros)
  then show "a\<in>inference_closure R K \<Longrightarrow> finite_inference R K a" by blast
qed

theorem finite_inference_exact:
  "finite_inference R K a \<longleftrightarrow> a\<in>inference_closure R K"
  by (rule iffI, erule finite_inference_sound, erule finite_inference_complete)

definition inference_sound ::
  "('a \<Rightarrow> bool) \<Rightarrow> ('a \<Rightarrow> ('i \<times> 'a) set \<Rightarrow> bool) \<Rightarrow> bool" where
  "inference_sound T R \<longleftrightarrow>
    (\<forall>a H. finite H \<longrightarrow> single_valued H \<longrightarrow> R a H \<longrightarrow>
      rel_ran H\<subseteq>{b. T b} \<longrightarrow> T a)"

theorem inference_closure_sound:
  assumes "inference_sound T R" "K\<subseteq>{a. T a}"
  shows "inference_closure R K\<subseteq>{a. T a}"
  by (rule inference_closure_least[OF assms(2)])
    (use assms(1) in \<open>auto simp: inference_sound_def inference_consequences_def\<close>)

theorem inference_supplies_reduction:
  assumes "inference_sound T R"
    "\<And>a. a\<in>D \<Longrightarrow> a\<in>inference_closure R (rel_ran (F a))"
  shows "obligation_reduction D T T F"
  using assms inference_closure_sound by (auto simp: obligation_reduction_def; blast)

theorem inference_discharges_residual:
  assumes rules: "inference_sound T R" and known: "K\<subseteq>{a. T a}"
    and reduction: "obligation_reduction D P T F"
  shows "obligation_reduction D P T
    (\<lambda>a. remaining_obligations (inference_closure R K) (F a))"
  by (rule obligation_reduction_residual[OF reduction inference_closure_sound[OF rules known]])

theorem unsupported_inference_cycle:
  assumes "\<And>a H. finite H \<Longrightarrow> single_valued H \<Longrightarrow> R a H \<Longrightarrow> H\<noteq>{}"
  shows "inference_closure R {}={}"
proof -
  have "inference_consequences R {}\<subseteq>{}"
    by (auto simp: inference_consequences_def rel_ran_def dest: assms)
  then show ?thesis using inference_closure_least[of "{}" "{}" R] by blast
qed

section \<open>A method comparison reduces to its immediate rules\<close>

definition inference_refines ::
  "('a \<Rightarrow> ('i \<times> 'a) set \<Rightarrow> bool) \<Rightarrow>
    ('a \<Rightarrow> ('j \<times> 'a) set \<Rightarrow> bool) \<Rightarrow> bool" where
  "inference_refines R S \<longleftrightarrow> (\<forall>K. inference_closure R K\<subseteq>inference_closure S K)"

lemma inference_refines_refl:
  "inference_refines R R"
  by (simp add: inference_refines_def)

lemma inference_refines_trans:
  "inference_refines R S \<Longrightarrow> inference_refines S T \<Longrightarrow> inference_refines R T"
  by (auto simp: inference_refines_def)

theorem inference_refines_iff_rules:
  "inference_refines R S \<longleftrightarrow>
    (\<forall>a H. finite H \<longrightarrow> single_valued H \<longrightarrow> R a H \<longrightarrow>
      a\<in>inference_closure S (rel_ran H))"
proof
  assume refinement: "inference_refines R S"
  show "\<forall>a H. finite H \<longrightarrow> single_valued H \<longrightarrow> R a H \<longrightarrow>
      a\<in>inference_closure S (rel_ran H)"
  proof (intro allI impI)
    fix a H
    assume fin: "finite H" and formed: "single_valued H" and rule: "R a H"
    have source: "a\<in>inference_closure R (rel_ran H)"
      by (rule inference_closure_step[where H=H and R=R])
        (rule fin, rule formed, rule rule, rule inference_closure_seed)
    have included: "inference_closure R (rel_ran H)\<subseteq>inference_closure S (rel_ran H)"
      using refinement by (auto simp: inference_refines_def)
    show "a\<in>inference_closure S (rel_ran H)" by (rule subsetD[OF included source])
  qed
next
  assume local: "\<forall>a H. finite H \<longrightarrow> single_valued H \<longrightarrow> R a H \<longrightarrow>
    a\<in>inference_closure S (rel_ran H)"
  have closed: "inference_consequences R (inference_closure S K)\<subseteq>inference_closure S K" for K
  proof
    fix a assume "a\<in>inference_consequences R (inference_closure S K)"
    then obtain H where fin: "finite H" and formed: "single_valued H"
      and rule: "R a H" and support: "rel_ran H\<subseteq>inference_closure S K"
      by (auto simp: inference_consequences_def)
    have reduced: "a\<in>inference_closure S (rel_ran H)"
      using local fin formed rule by blast
    show "a\<in>inference_closure S K" by (rule inference_closure_cut[OF reduced support])
  qed
  show "inference_refines R S"
    using inference_closure_least[OF inference_closure_seed closed]
    by (simp add: inference_refines_def)
qed

theorem inference_refines_by_inclusion:
  assumes "\<And>a H. R a H \<Longrightarrow> S a H"
  shows "inference_refines R S"
  unfolding inference_refines_iff_rules
proof (intro allI impI)
  fix a H
  assume fin: "finite H" and formed: "single_valued H" and source: "R a H"
  have target: "S a H" by (rule assms[OF source])
  show "a\<in>inference_closure S (rel_ran H)"
    by (rule inference_closure_step[where H=H and R=S])
      (rule fin, rule formed, rule target, rule inference_closure_seed)
qed

theorem inference_refines_residuals:
  assumes "inference_refines R S"
  shows "remaining_obligations (inference_closure S K) H\<subseteq>
    remaining_obligations (inference_closure R K) H"
  by (rule remaining_obligations_antimono) (use assms in \<open>auto simp: inference_refines_def\<close>)

theorem inference_refines_strict_witness:
  assumes "inference_refines R S"
  shows "\<not>inference_refines S R \<longleftrightarrow>
    (\<exists>K a. a\<in>inference_closure S K \<and> a\<notin>inference_closure R K)"
  by (auto simp: inference_refines_def)

theorem inference_extension_conservative_iff:
  "inference_refines (\<lambda>a H. R a H \<or> S a H) R \<longleftrightarrow> inference_refines S R"
  by (auto simp: inference_refines_iff_rules
    intro: inference_closure_step[OF _ _ _ inference_closure_seed])

text \<open>
  The least closure accounts for finite derivations from supplied assumptions.
  Finite functional premise families retain distinct uses of equal claims.
  A rule's validity is proved against an independently fixed truth predicate;
  merely adding a rule or reaching a fixed point does not establish soundness.
  An unsupported cycle cannot supply its own premise.

  Refinement means inclusion of conditional capabilities for every assumption
  set, not just success on one example. Its exact recognition criterion checks
  each immediate source rule using the target method. Transitivity, residual
  discharge, and conservative extension then follow without reopening client
  proofs. Remaining occurrences are derived from the original obligation family.
\<close>

end
