theory Inference_Demands
  imports "Inference_Development"
begin

section \<open>Backward demand retains the actual rule and every premise occurrence\<close>

definition inference_premise_use where
  "inference_premise_use R a H i b \<longleftrightarrow>
    finite H \<and> single_valued H \<and> R a H \<and> (i,b)\<in>H"

definition inference_demand_edges where
  "inference_demand_edges R K={(a,b). a\<notin>K \<and> (\<exists>H i. inference_premise_use R a H i b)}"

definition inference_demand where
  "inference_demand R K A={b. \<exists>a\<in>A. (a,b)\<in>(inference_demand_edges R K)\<^sup>*}"

lemma inference_demand_member:
  "b\<in>inference_demand R K A \<longleftrightarrow>
    (\<exists>a\<in>A. (a,b)\<in>(inference_demand_edges R K)\<^sup>*)"
  by (auto simp: inference_demand_def)

lemma inference_demand_initial:
  "A\<subseteq>inference_demand R K A"
  by (auto simp: inference_demand_def)

lemma inference_demand_step:
  assumes demanded: "a\<in>inference_demand R K A" and unsettled: "a\<notin>K"
    and premise: "inference_premise_use R a H i b"
  shows "b\<in>inference_demand R K A"
proof -
  obtain q where initial: "q\<in>A" and path: "(q,a)\<in>(inference_demand_edges R K)\<^sup>*"
    using demanded by (auto simp: inference_demand_member)
  have edge: "(a,b)\<in>inference_demand_edges R K"
    using unsettled premise by (auto simp: inference_demand_edges_def)
  have "(q,b)\<in>(inference_demand_edges R K)\<^sup>*"
    by (rule rtrancl.rtrancl_into_rtrancl[OF path edge])
  then show ?thesis using initial by (auto simp: inference_demand_member)
qed

lemma inference_demand_premises:
  assumes "a\<in>inference_demand R K A" "a\<notin>K" "finite H" "single_valued H" "R a H"
  shows "rel_ran H\<subseteq>inference_demand R K A"
  using inference_demand_step[OF assms(1,2)] assms(3-5)
  by (auto simp: inference_premise_use_def rel_ran_def)

theorem inference_demand_origin:
  assumes "b\<in>inference_demand R K A" "b\<notin>A"
  shows "\<exists>a H i. a\<in>inference_demand R K A \<and> a\<notin>K \<and>
    inference_premise_use R a H i b"
proof -
  obtain q where initial: "q\<in>A" and path: "(q,b)\<in>(inference_demand_edges R K)\<^sup>*"
    using assms(1) by (auto simp: inference_demand_member)
  obtain a where previous: "(q,a)\<in>(inference_demand_edges R K)\<^sup>*"
    and edge: "(a,b)\<in>inference_demand_edges R K"
    using path assms(2) initial by (cases rule: rtranclE) auto
  have demanded: "a\<in>inference_demand R K A"
    using previous initial by (auto simp: inference_demand_member)
  show ?thesis using demanded edge by (auto simp: inference_demand_edges_def)
qed

lemma inference_demand_known_antimono:
  assumes "K\<subseteq>L"
  shows "inference_demand R L A\<subseteq>inference_demand R K A"
proof -
  have edges: "inference_demand_edges R L\<subseteq>inference_demand_edges R K"
    using assms by (auto simp: inference_demand_edges_def)
  have paths: "(inference_demand_edges R L)\<^sup>*\<subseteq>(inference_demand_edges R K)\<^sup>*"
    by (rule rtrancl_mono[OF edges])
  show ?thesis using paths by (auto simp: inference_demand_def)
qed

definition guided_inferences where
  "guided_inferences R K A a H \<longleftrightarrow> R a H \<and> a\<in>inference_demand R K A"

theorem inference_restriction_on_closed_demand:
  assumes closed: "\<And>a H. a\<in>D \<Longrightarrow> a\<notin>K \<Longrightarrow>
    finite H \<Longrightarrow> single_valued H \<Longrightarrow> R a H \<Longrightarrow> rel_ran H\<subseteq>D"
    and inside: "a\<in>D"
  shows "a\<in>inference_closure (\<lambda>a H. R a H \<and> a\<in>D) K \<longleftrightarrow>
    a\<in>inference_closure R K"
proof
  assume "a\<in>inference_closure (\<lambda>a H. R a H \<and> a\<in>D) K"
  then show "a\<in>inference_closure R K"
    using inference_refines_by_inclusion[where R="\<lambda>a H. R a H \<and> a\<in>D" and S=R]
    by (auto simp: inference_refines_def)
next
  assume original: "a\<in>inference_closure R K"
  have transfer: "finite_inference R K b \<Longrightarrow> b\<in>D \<Longrightarrow>
      finite_inference (\<lambda>a H. R a H \<and> a\<in>D) K b" for b
  proof (induction rule: finite_inference.induct)
    case (seed b)
    show ?case by (rule finite_inference.seed[OF seed.hyps])
  next
    case (step H b)
    show ?case
    proof (cases "b\<in>K")
      case True
      show ?thesis by (rule finite_inference.seed[OF True])
    next
      case False
      have support: "rel_ran H\<subseteq>D"
        by (rule closed[OF step.prems False step.hyps(1-3)])
      show ?thesis by (rule finite_inference.step[OF step.hyps(1,2)])
        (use step.hyps(3) step.prems step.IH support in auto)
    qed
  qed
  show "a\<in>inference_closure (\<lambda>a H. R a H \<and> a\<in>D) K"
    by (rule finite_inference_sound[OF transfer[OF finite_inference_complete[OF original] inside]])
qed

theorem guided_inference_exact:
  assumes "a\<in>inference_demand R K A"
  shows "a\<in>inference_closure (guided_inferences R K A) K \<longleftrightarrow>
    a\<in>inference_closure R K"
  unfolding guided_inferences_def
  by (rule inference_restriction_on_closed_demand[OF inference_demand_premises assms])

theorem guided_goal_residual_exact:
  assumes "rel_ran H\<subseteq>A"
  shows "remaining_obligations (inference_closure (guided_inferences R K A) K) H=
    remaining_obligations (inference_closure R K) H"
  using assms inference_demand_initial[of A R K] guided_inference_exact[of _ R K A]
  by (auto simp: remaining_obligations_def rel_ran_def)

theorem guided_inferences_sound:
  "inference_sound T R \<Longrightarrow> inference_sound T (guided_inferences R K A)"
  by (auto simp: inference_sound_def guided_inferences_def)

theorem a_route_retains_every_unsettled_use:
  assumes route: "finite H" "single_valued H" "R a H"
  shows "(i,b)\<in>remaining_obligations K H \<longleftrightarrow>
      inference_premise_use R a H i b \<and> b\<notin>K"
    and "remaining_obligations K H={} \<Longrightarrow> a\<in>inference_closure R K"
proof -
  show "(i,b)\<in>remaining_obligations K H \<longleftrightarrow>
      inference_premise_use R a H i b \<and> b\<notin>K"
    using route by (simp add: inference_premise_use_def)
  assume "remaining_obligations K H={}"
  then have known: "rel_ran H\<subseteq>K" by (simp only: remaining_obligations_empty)
  have supported: "rel_ran H\<subseteq>inference_closure R K"
    by (rule subset_trans[OF known inference_closure_seed])
  show "a\<in>inference_closure R K"
    by (rule inference_closure_step[where R=R and H=H, OF route supported])
qed

theorem equal_conditions_keep_their_distinct_reasons:
  assumes "i\<noteq>j" "inference_premise_use R a H i b" "inference_premise_use R a H j b" "b\<notin>K"
  shows "(i,b)\<in>remaining_obligations K H \<and> (j,b)\<in>remaining_obligations K H \<and> (i,b)\<noteq>(j,b)"
  using assms by (auto simp: inference_premise_use_def)

theorem demand_reachability_does_not_discharge_a_goal:
  defines "R \<equiv> (\<lambda>a::bool. \<lambda>H::(unit\<times>bool) set. H={((),a)})"
  shows "True\<in>inference_demand R {} {True} \<and> True\<notin>inference_closure R {}"
proof -
  have empty: "inference_closure R {}={}"
    by (rule unsupported_inference_cycle) (simp add: R_def)
  show ?thesis using inference_demand_initial[of "{True}" R "{}"] by (simp add: empty)
qed

text \<open>
  A demanded condition expands through the actual available inference rules.
  Each reason retains the rule's complete premise family and the particular
  premise occurrence. Established conditions end their own expansion.
  Alternatives remain separate rules; their premises remain conjunctive.

  Backward reachability only identifies relevant work. Restricting inference
  to this complete demand preserves every original answer to the requested
  goals and their exact residual occurrences. The soundness of the rules and
  the truth of the seeds remain separate obligations. A reachable unsupported
  cycle is explicitly not a proof.

  This construction supplies search guidance from the conditions produced by
  an assessment. It uses neither a premise-count cutoff nor an immediate
  improvement test to decide which deeper dependencies may matter.
\<close>

end
