theory Factor_Schema_Bodies
  imports "Factor_Premise_Forests"
begin

section \<open>Conclusion and mixed premises under one binder boundary\<close>

definition schema_body_variables :: "'a term_pattern \<Rightarrow> ('a,'u) premise_template list \<Rightarrow> 'a set" where
  "schema_body_variables p ts = pattern_variables p \<union> template_list_variables ts"

definition schema_body_syntax ::
  "('a \<Rightarrow> local_address) \<Rightarrow> 'a term_pattern \<Rightarrow> ('a,'u) premise_template list \<Rightarrow> exact_artifact" where
  "schema_body_syntax f p ts = bound_union (pattern_syntax f p) (premise_forest_syntax f ts)"

definition schema_body_literals ::
  "'a term_pattern \<Rightarrow> ('a,'u) premise_template list \<Rightarrow> (local_address \<times> exact_artifact) set" where
  "schema_body_literals p ts = map_slot_keys (syntax_prefix 2) (pattern_literal_bindings p) \<union>
    map_slot_keys (syntax_prefix 3) (premise_forest_literals ts)"

definition schema_body_callees ::
  "('a,'u) premise_template list \<Rightarrow> (local_address \<times> 'u definition_site) set" where
  "schema_body_callees ts = map_slot_keys (syntax_prefix 3) (premise_forest_callees ts)"

definition schema_body_roots :: "('a,'u) premise_template list \<Rightarrow> local_address list" where
  "schema_body_roots ts = map (\<lambda>i. syntax_prefix 3 (premise_branch i [])) [0..<length ts]"

lemma schema_body_roots_length [simp]: "length (schema_body_roots ts) = length ts"
  by (simp add: schema_body_roots_def)

lemma schema_body_root_nth:
  assumes "i < length ts"
  shows "schema_body_roots ts ! i = syntax_prefix 3 (premise_branch i [])"
  using assms by (simp add: schema_body_roots_def)

lemma premise_forest_root_inside:
  assumes "i < length ts"
  shows "premise_branch i [] \<in> rra_carrier (object_structure (premise_forest_syntax f ts))"
  using assms
proof (induction ts arbitrary: i)
  case Nil
  then show ?case by simp
next
  case (Cons t ts)
  show ?case
  proof (cases i)
    case 0
    have present: "syntax_prefix 2 [] \<in> syntax_prefix 2 ` rra_carrier (object_structure (template_syntax f t))"
      by (rule imageI[OF template_syntax_properties(1)])
    show ?thesis using present
      by (simp only: 0 premise_branch.simps premise_forest_syntax.simps bound_union_def
          structured_object.select_convs rra_structure.select_convs) blast
  next
    case (Suc n)
    have small: "n < length ts" using Cons.prems Suc by simp
    have old: "premise_branch n [] \<in> rra_carrier (object_structure (premise_forest_syntax f ts))"
      by (rule Cons.IH[OF small])
    have present: "syntax_prefix 3 (premise_branch n []) \<in>
      syntax_prefix 3 ` rra_carrier (object_structure (premise_forest_syntax f ts))"
      by (rule imageI[OF old])
    show ?thesis using present
      by (simp only: Suc premise_branch.simps premise_forest_syntax.simps bound_union_def
          structured_object.select_convs rra_structure.select_convs) blast
  qed
qed

locale schema_bodies =
  fixes f :: "'a \<Rightarrow> local_address" and p :: "'a term_pattern"
    and ts :: "('a,local_address option) premise_template list"
  assumes conclusion_formed: "pattern_formed p"
    and templates_formed: "\<forall>t\<in>set ts. template_formed t"
    and addressing: "binder_addressing (schema_body_variables p ts) f"
begin

abbreviation body where "body \<equiv> schema_body_syntax f p ts"
abbreviation variables where "variables \<equiv> f ` schema_body_variables p ts"
abbreviation literals where "literals \<equiv> schema_body_literals p ts"
abbreviation callees where "callees \<equiv> schema_body_callees ts"

lemma conclusion_addressing: "binder_addressing (pattern_variables p) f"
  by (rule binder_addressing_mono[OF addressing]) (auto simp: schema_body_variables_def)

lemma premise_addressing: "binder_addressing (template_list_variables ts) f"
  by (rule binder_addressing_mono[OF addressing]) (auto simp: schema_body_variables_def)

lemma boundary: "variables \<subseteq> binder_addresses"
  using addressing by (simp add: binder_addressing_def)

lemma conclusion_scope: "f ` pattern_variables p \<subseteq> variables"
  by (auto simp: schema_body_variables_def)

lemma premise_scope: "f ` template_list_variables ts \<subseteq> variables"
  by (auto simp: schema_body_variables_def)

lemma conclusion_code_formed: "exact_formed (pattern_syntax f p)"
  by (rule pattern_syntax_formed[OF conclusion_formed conclusion_addressing])

lemma premise_code_formed: "exact_formed (premise_forest_syntax f ts)"
  by (rule premise_forest_formed[OF templates_formed premise_addressing])

lemma formed: "exact_formed body"
  unfolding schema_body_syntax_def
  by (rule bound_union_formed[OF conclusion_code_formed premise_code_formed
        pattern_syntax_silent premise_forest_silent])

lemma silent: "binder_silent body"
  unfolding schema_body_syntax_def
  by (rule bound_union_silent[OF pattern_syntax_silent premise_forest_silent])

lemma carrier:
  "rra_carrier (object_structure body) =
    syntax_prefix 2 ` rra_carrier (object_structure (pattern_syntax f p)) \<union>
    syntax_prefix 3 ` rra_carrier (object_structure (premise_forest_syntax f ts))"
  by (simp add: schema_body_syntax_def bound_union_def)

lemma variables_inside: "variables \<subseteq> rra_carrier (object_structure body)"
proof -
  have pvars: "f ` pattern_variables p \<subseteq> rra_carrier (object_structure (pattern_syntax f p))"
    by (simp add: pattern_syntax_carrier[OF conclusion_addressing])
  have tvars: "f ` template_list_variables ts \<subseteq> rra_carrier (object_structure (premise_forest_syntax f ts))"
    by (simp add: premise_forest_carrier[OF premise_addressing])
  have pimage: "syntax_prefix 2 ` (f ` pattern_variables p) \<subseteq>
    syntax_prefix 2 ` rra_carrier (object_structure (pattern_syntax f p))"
    by (rule image_mono[OF pvars])
  have timage: "syntax_prefix 3 ` (f ` template_list_variables ts) \<subseteq>
    syntax_prefix 3 ` rra_carrier (object_structure (premise_forest_syntax f ts))"
    by (rule image_mono[OF tvars])
  have pfix: "syntax_prefix 2 ` (f ` pattern_variables p) = f ` pattern_variables p"
    by (rule syntax_prefix_image_binders[OF subset_trans[OF conclusion_scope boundary]])
  have tfix: "syntax_prefix 3 ` (f ` template_list_variables ts) = f ` template_list_variables ts"
    by (rule syntax_prefix_image_binders[OF subset_trans[OF premise_scope boundary]])
  show ?thesis using pimage timage
    by (simp only: pfix tfix carrier schema_body_variables_def image_Un) blast
qed

lemma conclusion_inside: "[2] \<in> rra_carrier (object_structure body)"
proof -
  have present: "syntax_prefix 2 [] \<in> syntax_prefix 2 ` rra_carrier (object_structure (pattern_syntax f p))"
    by (rule imageI[OF pattern_syntax_root])
  show ?thesis using present by (simp add: carrier)
qed

lemma premise_roots_inside: "set (schema_body_roots ts) \<subseteq> rra_carrier (object_structure body)"
  using premise_forest_root_inside[of _ ts f]
  by (auto simp: schema_body_roots_def carrier)

lemma conclusion_reads:
  "object_reads_agree (push_object (syntax_prefix 2) (pattern_syntax f p)) body
    (syntax_prefix 2 ` rra_carrier (object_structure (pattern_syntax f p)))"
  unfolding schema_body_syntax_def
  by (rule bound_union_reads_left[OF pattern_syntax_no_counts premise_forest_silent])

lemma premise_reads:
  "object_reads_agree (push_object (syntax_prefix 3) (premise_forest_syntax f ts)) body
    (syntax_prefix 3 ` rra_carrier (object_structure (premise_forest_syntax f ts)))"
  unfolding schema_body_syntax_def
  by (rule bound_union_reads_right[OF premise_forest_no_counts pattern_syntax_silent])

lemma conclusion_recovers:
  assumes ef: "environment_formed E" and source: "artifact_at E u S"
    and reads: "object_reads_agree body S (rra_carrier (object_structure body))"
    and refs: "syntax_references E u literals callees"
  shows "pattern_quoted_at E u variables [2] (rename_pattern f p)
    (syntax_prefix 2 ` pattern_syntax_interior p) (syntax_prefix 2 ` rel_dom (pattern_literal_bindings p))"
proof -
  have original: "pattern_quoted_at (pattern_environment f p) None variables [] (rename_pattern f p)
    (pattern_syntax_interior p) (rel_dom (pattern_literal_bindings p))"
    by (rule pattern_syntax_recovers[OF conclusion_formed conclusion_addressing conclusion_scope boundary])
  have addr: "finite_addressing (rra_carrier (object_structure (pattern_syntax f p))) (syntax_prefix 2)"
    by (rule syntax_prefix_addressing[OF conclusion_code_formed]) simp_all
  have copied_reads: "object_reads_agree (push_object (syntax_prefix 2) (pattern_syntax f p)) S
    (syntax_prefix 2 ` rra_carrier (object_structure (pattern_syntax f p)))"
    by (rule object_reads_agree_extend[OF conclusion_reads reads])
  have interior_bound: "pattern_syntax_interior p \<subseteq> rra_carrier (object_structure (pattern_syntax f p))"
    by (auto simp: pattern_syntax_carrier[OF conclusion_addressing])
  have interior_reads: "object_reads_agree (push_object (syntax_prefix 2) (pattern_syntax f p)) S
    (syntax_prefix 2 ` pattern_syntax_interior p)"
    by (rule object_reads_agree_mono[OF copied_reads image_mono[OF interior_bound]])
  have left_refs: "syntax_references E u (map_slot_keys (syntax_prefix 2) (pattern_literal_bindings p)) callees"
    by (rule syntax_references_mono[OF refs]) (auto simp: schema_body_literals_def)
  have slots: "\<forall>k\<in>rel_dom (pattern_literal_bindings p).
    external_slot_values (pattern_environment f p) None k = external_slot_values E u (syntax_prefix 2 k)"
    using reference_literal_fibre[OF left_refs pattern_literal_bindings_functional] by auto
  have injective: "inj (syntax_prefix 2)" by (rule syntax_prefix_injective) simp
  have copied: "pattern_quoted_at E u (syntax_prefix 2 ` variables) (syntax_prefix 2 [])
    (rename_pattern (syntax_prefix 2) (rename_pattern f p))
    (syntax_prefix 2 ` pattern_syntax_interior p) (syntax_prefix 2 ` rel_dom (pattern_literal_bindings p))"
    by (rule pattern_quotation_transport[OF original pattern_environment_source addr interior_reads slots injective ef source])
  show ?thesis using copied
    by (simp only: syntax_prefix_root syntax_prefix_image_binders[OF boundary]
        renamed_pattern_prefix[OF conclusion_addressing])
qed

lemma premises_recovers:
  fixes E :: "local_address option artifact_environment"
  assumes ef: "environment_formed E" and source: "artifact_at E u S"
    and reads: "object_reads_agree body S (rra_carrier (object_structure body))"
    and refs: "syntax_references E u literals callees"
  shows "\<forall>i<length ts. \<exists>I K. native_premise_at E u variables (schema_body_roots ts ! i)
    (template_projection f (ts!i)) I K"
proof -
  let ?R = "premise_forest_syntax f ts"
  let ?z = "clone_source_use E u"
  let ?F = "clone_source_environment E u ?R (syntax_prefix 3) ?z"
  have fresh: "?z \<notin> environment_uses E" by (rule clone_source_use_fresh[OF ef])
  have ff: "environment_formed ?F" by (rule clone_environment_formed[OF ef premise_code_formed fresh])
  have src: "artifact_at ?F ?z ?R" by (simp add: clone_artifact_iff)
  have bounds: "rel_dom (premise_forest_literals ts) \<union> rel_dom (premise_forest_callees ts) \<subseteq>
    rra_carrier (object_structure ?R)"
    by (auto simp: premise_forest_carrier[OF premise_addressing])
  have right_refs: "syntax_references E u (map_slot_keys (syntax_prefix 3) (premise_forest_literals ts))
    (map_slot_keys (syntax_prefix 3) (premise_forest_callees ts))"
    by (rule syntax_references_mono[OF refs]) (auto simp: schema_body_literals_def schema_body_callees_def)
  have clone_refs: "syntax_references ?F ?z (premise_forest_literals ts) (premise_forest_callees ts)"
    by (rule cloned_syntax_references[OF ef fresh bounds right_refs])
  have originals: "\<forall>i<length ts. native_premise_at ?F ?z variables (premise_branch i [])
    (template_projection f (ts!i)) (premise_branch i ` template_interior (ts!i))
    (premise_branch i ` (rel_dom (template_literals (ts!i)) \<union> rel_dom (template_callees (ts!i))))"
    by (rule premise_forest_recovers[OF templates_formed premise_addressing premise_scope boundary ff src clone_refs])
  have addr: "finite_addressing (rra_carrier (object_structure ?R)) (syntax_prefix 3)"
    by (rule syntax_prefix_addressing[OF premise_code_formed]) simp_all
  have injective: "inj (syntax_prefix 3)" by (rule syntax_prefix_injective) simp
  have copied_reads: "object_reads_agree (push_object (syntax_prefix 3) ?R) S
    (syntax_prefix 3 ` rra_carrier (object_structure ?R))"
    by (rule object_reads_agree_extend[OF premise_reads reads])
  have copy: "native_syntax_copy ?F ?z ?R E u S (syntax_prefix 3) (relocated_site ?z u (syntax_prefix 3))"
    by (rule clone_environment_is_native_copy[OF ef premise_code_formed fresh source injective addr copied_reads])
  show ?thesis
  proof (intro allI impI)
    fix i assume index: "i < length ts"
    have member: "ts!i \<in> set ts" by (rule nth_mem[OF index])
    have taddr: "binder_addressing (template_variables (ts!i)) f"
      by (rule binder_addressing_mono[OF premise_addressing])
         (use member in \<open>auto simp: template_list_variables_def\<close>)
    have nonlocal: "\<forall>k d. (k,d) \<in> template_callees (ts!i) \<longrightarrow> fst d \<noteq> ?z"
    proof (intro allI impI)
      fix k d assume entry: "(k,d) \<in> template_callees (ts!i)"
      obtain j where in_forest: "(j,d) \<in> premise_forest_callees ts"
        using premise_forest_callee_origin[OF member entry] by blast
      show "fst d \<noteq> ?z" by (rule cloned_reference_site_outside[OF ef fresh clone_refs in_forest])
    qed
    have projection: "map_native_premise (syntax_prefix 3) (relocated_site ?z u (syntax_prefix 3))
      (template_projection f (ts!i)) = template_projection f (ts!i)"
      by (rule template_projection_prefix[OF taddr nonlocal])
    have original: "native_premise_at ?F ?z variables (premise_branch i [])
      (template_projection f (ts!i)) (premise_branch i ` template_interior (ts!i))
      (premise_branch i ` (rel_dom (template_literals (ts!i)) \<union> rel_dom (template_callees (ts!i))))"
      using originals index by blast
    show "\<exists>I K. native_premise_at E u variables (schema_body_roots ts ! i) (template_projection f (ts!i)) I K"
      using native_syntax_copy.copy_premise[OF copy original]
      by (simp only: schema_body_root_nth[OF index] syntax_prefix_image_binders[OF boundary] projection) blast
  qed
qed

end

