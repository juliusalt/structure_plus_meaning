theory Factor_Alpha_Semantics
  imports "Factor_Schema_Renaming"
begin

section \<open>Coordinate changes preserve and reflect complete rule instances\<close>

definition schema_rule_instance ::
  "('a,'s,'d) factor_schema \<Rightarrow> ('d \<times> factor_term) set \<Rightarrow> factor_term \<Rightarrow> bool" where
  "schema_rule_instance S X t \<longleftrightarrow> (\<exists>V Q. schema_instance S V t Q \<and>
    schema_material_satisfied S V \<and> (\<forall>s d x. (s,d,x) \<in> Q \<longrightarrow> (d,x) \<in> X))"

lemma schema_rule_instance_renaming:
  assumes rule: "schema_rule_instance S X t"
    and binders: "inj_on f (schema_variables S)" and sockets: "inj_on h (schema_sockets S)"
  shows "schema_rule_instance (rename_schema f h id S) X t"
proof -
  obtain V Q where old: "schema_instance S V t Q" "schema_material_satisfied S V"
    "\<forall>s d x. (s,d,x) \<in> Q \<longrightarrow> (d,x) \<in> X"
    using rule by (auto simp: schema_rule_instance_def)
  have instance_read: "schema_instance (rename_schema f h id S) (rename_term_bindings f V) t (map_socket_graph h id id Q)"
    by (rule schema_instance_renaming[OF old(1) binders sockets])
  have bindings: "term_bindings_formed (schema_variables S) V" using old(1) by (simp add: schema_instance_def)
  have material: "schema_material_satisfied (rename_schema f h id S) (rename_term_bindings f V)"
    using schema_material_satisfied_renaming[OF bindings binders] old(2) by blast
  have body: "\<forall>s d x. (s,d,x) \<in> map_socket_graph h id id Q \<longrightarrow> (d,x) \<in> X"
    using old(3) by (auto simp: map_socket_graph_member)
  show ?thesis unfolding schema_rule_instance_def
    by (rule exI[of _ "rename_term_bindings f V"], rule exI[of _ "map_socket_graph h id id Q"])
       (use instance_read material body in blast)
qed

theorem schema_rule_instance_alpha:
  assumes binders: "inj_on f (schema_variables S)" and sockets: "inj_on h (schema_sockets S)"
  shows "schema_rule_instance (rename_schema f h id S) X t \<longleftrightarrow> schema_rule_instance S X t"
proof
  let ?fi = "inv_into (schema_variables S) f"
  let ?hi = "inv_into (schema_sockets S) h"
  let ?A = "rename_schema f h id S"
  assume renamed: "schema_rule_instance ?A X t"
  have invf: "inj_on ?fi (schema_variables ?A)"
    by (rule inj_on_inv_into) (simp add: renamed_schema_variables)
  have invh: "inj_on ?hi (schema_sockets ?A)"
    by (rule inj_on_inv_into) (simp add: renamed_schema_sockets)
  have inverse_result: "schema_rule_instance (rename_schema ?fi ?hi id ?A) X t"
    by (rule schema_rule_instance_renaming[OF renamed invf invh])
  have restored: "rename_schema ?fi ?hi id ?A = S"
    by (rule rename_schema_cancels) (use binders sockets in auto)
  show "schema_rule_instance S X t" using inverse_result restored by simp
next
  assume "schema_rule_instance S X t"
  then show "schema_rule_instance (rename_schema f h id S) X t"
    by (rule schema_rule_instance_renaming[OF _ binders sockets])
qed

lemma schema_rule_instance_map:
  assumes rule: "schema_rule_instance S X t"
    and binders: "inj_on f (schema_variables S)" and sockets: "inj_on h (schema_sockets S)"
  shows "schema_rule_instance (rename_schema f h g S) (map_prod g id ` X) t"
proof -
  obtain V Q where old: "schema_instance S V t Q" "schema_material_satisfied S V"
    "\<forall>s d x. (s,d,x) \<in> Q \<longrightarrow> (d,x) \<in> X"
    using rule unfolding schema_rule_instance_def by blast
  have instance_read: "schema_instance (rename_schema f h g S) (rename_term_bindings f V) t (map_socket_graph h g id Q)"
    by (rule schema_instance_renaming[OF old(1) binders sockets])
  have bindings: "term_bindings_formed (schema_variables S) V" using old(1) by (simp add: schema_instance_def)
  have material: "schema_material_satisfied (rename_schema f h g S) (rename_term_bindings f V)"
    using schema_material_satisfied_renaming[OF bindings binders] old(2) by blast
  have body: "\<forall>s d x. (s,d,x) \<in> map_socket_graph h g id Q \<longrightarrow> (d,x) \<in> map_prod g id ` X"
  proof (intro allI impI)
    fix s d x assume entry: "(s,d,x) \<in> map_socket_graph h g id Q"
    obtain q e y where origin: "(q,e,y) \<in> Q" "s=h q" "d=g e" "x=y"
      using entry by (auto simp: map_socket_graph_member)
    have supported: "(e,y) \<in> X" using old(3) origin(1) by blast
    have mapped: "map_prod g id (e,y) \<in> map_prod g id ` X" by (rule imageI[OF supported])
    show "(d,x) \<in> map_prod g id ` X" using mapped origin(3,4) by simp
  qed
  show ?thesis unfolding schema_rule_instance_def
    by (rule exI[of _ "rename_term_bindings f V"], rule exI[of _ "map_socket_graph h g id Q"])
       (use instance_read material body in blast)
qed

theorem schema_rule_instance_callee_image:
  fixes S :: "('a,'s,'d) factor_schema" and g :: "'d \<Rightarrow> 'e"
    and X :: "('d \<times> factor_term) set"
  assumes injective: "inj_on g D" and dependencies: "schema_dependencies S \<subseteq> D"
    and support: "X \<subseteq> D \<times> UNIV"
  shows "schema_rule_instance (rename_schema id id g S) (map_prod g id ` X) t \<longleftrightarrow>
    schema_rule_instance S X t"
proof
  let ?h = "inv_into D g"
  let ?T = "rename_schema id id g S"
  assume renamed: "schema_rule_instance ?T (map_prod g id ` X) t"
  have inverse_rule: "schema_rule_instance (rename_schema id id ?h ?T) (map_prod ?h id ` (map_prod g id ` X)) t"
    by (rule schema_rule_instance_map[OF renamed]) simp_all
  have restored: "rename_schema id id ?h ?T = S"
    by (rule rename_schema_cancels) (use injective dependencies in auto)
  have point: "\<And>q. q \<in> X \<Longrightarrow> map_prod ?h id (map_prod g id q) = q"
  proof -
    fix q :: "'d \<times> factor_term" assume member: "q \<in> X"
    obtain d x where shape: "q=(d,x)" by (cases q)
    have inside: "d \<in> D" using support member shape by auto
    have inverse: "?h (g d) = d" by (rule inv_into_f_f[OF injective inside])
    show "map_prod ?h id (map_prod g id q) = q" by (simp add: shape inverse)
  qed
  have support_back: "map_prod ?h id ` (map_prod g id ` X) = X"
  proof -
    have "map_prod ?h id ` (map_prod g id ` X) = (\<lambda>q. map_prod ?h id (map_prod g id q)) ` X"
      by (simp only: image_image)
    also have "\<dots> = id ` X" by (rule image_cong[OF refl]) (use point in simp)
    also have "\<dots> = X" by simp
    finally show ?thesis .
  qed
  show "schema_rule_instance S X t" using inverse_rule restored support_back by simp
next
  assume original: "schema_rule_instance S X t"
  show "schema_rule_instance (rename_schema id id g S) (map_prod g id ` X) t"
    by (rule schema_rule_instance_map[OF original]) simp_all
qed

definition schema_alpha_variant ::
  "('a,'s,'d) factor_schema \<Rightarrow> ('b,'t,'d) factor_schema \<Rightarrow> bool" where
  "schema_alpha_variant S T \<longleftrightarrow> (\<exists>f h. inj_on f (schema_variables S) \<and>
    inj_on h (schema_sockets S) \<and> T = rename_schema f h id S)"

lemma schema_alpha_dependencies:
  assumes "schema_alpha_variant S T"
  shows "schema_dependencies T = schema_dependencies S"
  using assms by (auto simp: schema_alpha_variant_def renamed_schema_dependencies)

lemma schema_alpha_formed:
  assumes "schema_alpha_variant S T" "schema_formed S"
  shows "schema_formed T"
  using assms renamed_schema_formed by (auto simp: schema_alpha_variant_def)

lemma schema_alpha_rule_instance:
  assumes "schema_alpha_variant S T"
  shows "schema_rule_instance T X t \<longleftrightarrow> schema_rule_instance S X t"
proof -
  obtain f h where renaming: "inj_on f (schema_variables S)" "inj_on h (schema_sockets S)"
    "T = rename_schema f h id S" using assms by (auto simp: schema_alpha_variant_def)
  show ?thesis using schema_rule_instance_alpha[OF renaming(1,2)] renaming(3) by simp
qed

lemma schema_alpha_copy:
  assumes alpha: "schema_alpha_variant S T" and injective: "inj f"
  shows "schema_alpha_variant S (rename_schema f f id T)"
proof -
  obtain a h where old: "inj_on a (schema_variables S)" "inj_on h (schema_sockets S)"
    "T = rename_schema a h id S" using alpha by (auto simp: schema_alpha_variant_def)
  have binders: "inj_on (f \<circ> a) (schema_variables S)"
    and sockets: "inj_on (f \<circ> h) (schema_sockets S)"
    using old(1,2) injective by (auto simp: inj_on_def)
  show ?thesis unfolding schema_alpha_variant_def
    by (rule exI[of _ "f \<circ> a"], rule exI[of _ "f \<circ> h"])
       (use binders sockets old(3) in \<open>simp add: rename_schema_composition\<close>)
qed

section \<open>Complete identified families of independently renamed schemas\<close>

definition schema_family_variant ::
  "('c \<Rightarrow> 'e) \<Rightarrow> ('c \<times> ('a,'s,'d) factor_schema) set \<Rightarrow>
    ('e \<times> ('b,'t,'d) factor_schema) set \<Rightarrow> bool" where
  "schema_family_variant h C D \<longleftrightarrow> inj_on h (rel_dom C) \<and> finite D \<and> single_valued D \<and>
    rel_dom D = h ` rel_dom C \<and>
    (\<forall>c S. (c,S) \<in> C \<longrightarrow> (\<exists>T. (h c,T) \<in> D \<and> schema_alpha_variant S T))"

lemma schema_family_variant_entry:
  assumes "schema_family_variant h C D" "(c,S) \<in> C"
  shows "\<exists>T. (h c,T) \<in> D \<and> schema_alpha_variant S T"
  using assms by (auto simp: schema_family_variant_def)

lemma schema_family_variant_origin:
  assumes variant: "schema_family_variant h C D" and entry: "(c,T) \<in> D"
  shows "\<exists>s S. (s,S) \<in> C \<and> c=h s \<and> schema_alpha_variant S T"
proof -
  have key: "c \<in> h ` rel_dom C" using variant rel_domI[OF entry] by (simp add: schema_family_variant_def)
  obtain s where source: "s \<in> rel_dom C" "c=h s" using key by blast
  obtain S where original: "(s,S) \<in> C" using source(1) by (auto simp: rel_dom_def)
  obtain A where projected: "(h s,A) \<in> D" "schema_alpha_variant S A"
    using schema_family_variant_entry[OF variant original] by blast
  have sv: "single_valued D" using variant by (simp add: schema_family_variant_def)
  have other: "(c,A) \<in> D" using projected(1) source(2) by simp
  have same: "A=T" by (rule single_valued_outputs[OF sv other entry])
  show ?thesis using original source(2) projected(2) same by blast
qed

lemma schema_family_variant_singleton:
  assumes variant: "schema_family_variant h {(c,S)} D"
  shows "\<exists>T. D={(h c,T)} \<and> schema_alpha_variant S T"
proof -
  obtain T where entry: "(h c,T)\<in>D" "schema_alpha_variant S T"
    using schema_family_variant_entry[OF variant, of c S] by auto
  have functional: "single_valued D" using variant by (simp add: schema_family_variant_def)
  have subset: "D\<subseteq>{(h c,T)}"
  proof
    fix q assume member: "q\<in>D"
    obtain d U where shape: "q=(d,U)" by (cases q)
    have row: "(d,U)\<in>D" using member shape by simp
    have key: "d=h c" using schema_family_variant_origin[OF variant row] by auto
    have same: "U=T" using single_valued_outputs[OF functional row] entry(1) key by blast
    show "q\<in>{(h c,T)}" using shape key same by simp
  qed
  show ?thesis by (rule exI[of _ T]) (use subset entry in auto)
qed

lemma schema_family_variant_rules:
  assumes variant: "schema_family_variant h C D"
  shows "(\<exists>c T. (c,T) \<in> D \<and> schema_rule_instance T X t) \<longleftrightarrow>
    (\<exists>s S. (s,S) \<in> C \<and> schema_rule_instance S X t)"
proof
  assume "\<exists>c T. (c,T) \<in> D \<and> schema_rule_instance T X t"
  then obtain c T where entry: "(c,T) \<in> D" "schema_rule_instance T X t" by blast
  obtain s S where source: "(s,S) \<in> C" "schema_alpha_variant S T"
    using schema_family_variant_origin[OF variant entry(1)] by blast
  have rule: "schema_rule_instance S X t" using schema_alpha_rule_instance[OF source(2)] entry(2) by blast
  show "\<exists>s S. (s,S) \<in> C \<and> schema_rule_instance S X t" using source(1) rule by blast
next
  assume "\<exists>s S. (s,S) \<in> C \<and> schema_rule_instance S X t"
  then obtain s S where entry: "(s,S) \<in> C" "schema_rule_instance S X t" by blast
  obtain T where target: "(h s,T) \<in> D" "schema_alpha_variant S T"
    using schema_family_variant_entry[OF variant entry(1)] by blast
  have rule: "schema_rule_instance T X t" using schema_alpha_rule_instance[OF target(2)] entry(2) by blast
  show "\<exists>c T. (c,T) \<in> D \<and> schema_rule_instance T X t" using target(1) rule by blast
qed

lemma schema_family_variant_dependencies:
  assumes variant: "schema_family_variant h C D"
  shows "(\<Union>T\<in>rel_ran D. schema_dependencies T) = (\<Union>S\<in>rel_ran C. schema_dependencies S)"
proof (rule set_eqI, rule iffI)
  fix d assume "d \<in> (\<Union>T\<in>rel_ran D. schema_dependencies T)"
  then obtain c T where entry: "(c,T) \<in> D" "d \<in> schema_dependencies T" by (auto simp: rel_ran_def)
  obtain s S where source: "(s,S) \<in> C" "schema_alpha_variant S T"
    using schema_family_variant_origin[OF variant entry(1)] by blast
  have dependency: "d \<in> schema_dependencies S" using schema_alpha_dependencies[OF source(2)] entry(2) by simp
  show "d \<in> (\<Union>S\<in>rel_ran C. schema_dependencies S)" using source(1) dependency by (auto simp: rel_ran_def)
next
  fix d assume "d \<in> (\<Union>S\<in>rel_ran C. schema_dependencies S)"
  then obtain s S where entry: "(s,S) \<in> C" "d \<in> schema_dependencies S" by (auto simp: rel_ran_def)
  obtain T where target: "(h s,T) \<in> D" "schema_alpha_variant S T"
    using schema_family_variant_entry[OF variant entry(1)] by blast
  have dependency: "d \<in> schema_dependencies T" using schema_alpha_dependencies[OF target(2)] entry(2) by simp
  show "d \<in> (\<Union>T\<in>rel_ran D. schema_dependencies T)" using target(1) dependency by (auto simp: rel_ran_def)
qed

lemma pattern_accepts_renaming_forward:
  assumes accepted: "pattern_accepts p t" and injective: "inj_on f (pattern_variables p)"
  shows "pattern_accepts (rename_pattern f p) t"
proof -
  obtain V where old: "term_formed t" "term_bindings_formed (pattern_variables p) V" "pattern_instance V p t"
    using accepted by (auto simp: pattern_accepts_def)
  have dom: "rel_dom V = pattern_variables p" using old(2) by (simp add: term_bindings_formed_def)
  have finj: "inj_on f (rel_dom V)" using injective dom by simp
  have scope: "pattern_variables p \<subseteq> rel_dom V" using dom by simp
  have instance_read: "pattern_instance (rename_term_bindings f V) (rename_pattern f p) t"
    using pattern_instance_renaming[OF finj scope] old(3) by blast
  have bindings: "term_bindings_formed (pattern_variables (rename_pattern f p)) (rename_term_bindings f V)"
    using renamed_term_bindings_formed[OF old(2) injective] by (simp add: rename_pattern_variables)
  show ?thesis using old(1) instance_read bindings unfolding pattern_accepts_def by blast
qed

theorem pattern_accepts_alpha:
  assumes injective: "inj_on f (pattern_variables p)"
  shows "pattern_accepts (rename_pattern f p) t \<longleftrightarrow> pattern_accepts p t"
proof
  let ?g = "inv_into (pattern_variables p) f"
  assume accepted: "pattern_accepts (rename_pattern f p) t"
  have inverse: "inj_on ?g (pattern_variables (rename_pattern f p))"
    by (rule inj_on_inv_into) (simp add: rename_pattern_variables)
  have inverse_result: "pattern_accepts (rename_pattern ?g (rename_pattern f p)) t"
    by (rule pattern_accepts_renaming_forward[OF accepted inverse])
  have same: "rename_pattern (?g \<circ> f) p = rename_pattern id p"
    by (rule rename_pattern_agreement) (use injective in auto)
  have restored: "rename_pattern ?g (rename_pattern f p) = p"
    using same by (simp add: rename_pattern_composition)
  show "pattern_accepts p t" using inverse_result restored by simp
next
  assume "pattern_accepts p t"
  then show "pattern_accepts (rename_pattern f p) t" by (rule pattern_accepts_renaming_forward[OF _ injective])
qed

text \<open>
  The complete rule-instance relation is derived from schema instantiation,
  every material check, and support for every identified premise. It introduces
  no additional inference form. Injective binder and socket changes preserve
  and reflect this relation for every supporting relation, and also preserve
  and reflect application-interface acceptance. Thus copying cannot create
  additional instances through a change of variable or socket coordinates.
\<close>

end
