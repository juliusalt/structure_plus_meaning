theory Factor_Self_Contained_Terms
  imports "Factor_Finite_Presentations"
begin

section \<open>Terms whose recovery needs no external target\<close>

fun self_contained_term :: "factor_term \<Rightarrow> bool" where
  "self_contained_term (Target_Term t) = False"
| "self_contained_term (Payload_Term v) = True"
| "self_contained_term (Pair_Term x y) =
    (self_contained_term x \<and> self_contained_term y)"

lemma self_contained_syntax_nonroot:
  assumes closed: "self_contained_term t"
    and member: "a\<in>rra_carrier (object_structure (term_syntax t))" and nonroot: "a\<noteq>[]"
  shows "a\<in>participation_occurrences (object_structure (term_syntax t)) \<union>
    reached_occurrences (object_structure (term_syntax t))"
  using closed member nonroot
proof (induction t arbitrary: a)
  case (Target_Term t)
  then show ?case by simp
next
  case (Payload_Term v)
  then show ?case by simp
next
  case (Pair_Term x y)
  let ?L="object_structure (term_syntax x)"
  let ?R="object_structure (term_syntax y)"
  let ?S="object_structure (pair_syntax (term_syntax x) (term_syntax y))"
  let ?U="participation_occurrences ?S \<union> reached_occurrences ?S"
  have xf: "self_contained_term x" and yf: "self_contained_term y"
    using Pair_Term.prems(1) by auto
  have left: "Cons 2 ` rra_carrier ?L \<subseteq> ?U"
  proof
    fix a assume "a\<in>Cons 2 ` rra_carrier ?L"
    then obtain b where position: "a=2#b" and inside: "b\<in>rra_carrier ?L" by blast
    show "a\<in>?U"
    proof (cases "b=[]")
      case True
      then show ?thesis using position by (simp add: pair_syntax_projections)
    next
      case False
      have covered: "b\<in>participation_occurrences ?L \<union> reached_occurrences ?L"
        by (rule Pair_Term.IH(1)[OF xf inside False])
      show ?thesis using covered position by (auto simp: pair_syntax_projections)
    qed
  qed
  have right: "Cons 3 ` rra_carrier ?R \<subseteq> ?U"
  proof
    fix a assume "a\<in>Cons 3 ` rra_carrier ?R"
    then obtain b where position: "a=3#b" and inside: "b\<in>rra_carrier ?R" by blast
    show "a\<in>?U"
    proof (cases "b=[]")
      case True
      then show ?thesis using position by (simp add: pair_syntax_projections)
    next
      case False
      have covered: "b\<in>participation_occurrences ?R \<union> reached_occurrences ?R"
        by (rule Pair_Term.IH(2)[OF yf inside False])
      show ?thesis using covered position by (auto simp: pair_syntax_projections)
    qed
  qed
  have slots: "[0]\<in>?U" "[1]\<in>?U" by (simp_all add: pair_syntax_projections)
  show ?case using Pair_Term.prems(2,3) left right slots
    by (auto simp: pair_syntax_carrier)
qed

lemma self_contained_syntax_unreferenced:
  assumes closed: "self_contained_term t"
  shows "rra_carrier (object_structure (term_syntax t)) -
    (participation_occurrences (object_structure (term_syntax t)) \<union>
     reached_occurrences (object_structure (term_syntax t))) = {[]}"
proof -
  have root: "[]\<notin>participation_occurrences (object_structure (term_syntax t)) \<union>
    reached_occurrences (object_structure (term_syntax t))"
    using closed by (cases t) (auto simp: pair_syntax_projections)
  have covered: "\<And>a. a\<in>rra_carrier (object_structure (term_syntax t)) \<Longrightarrow> a\<noteq>[] \<Longrightarrow>
    a\<in>participation_occurrences (object_structure (term_syntax t)) \<union>
      reached_occurrences (object_structure (term_syntax t))"
    by (rule self_contained_syntax_nonroot[OF closed])
  show ?thesis using root covered by auto
qed

lemma self_contained_term_literals_empty:
  assumes "self_contained_term t"
  shows "term_literal_bindings t={}"
  using assms by (induction t) auto

lemma self_contained_quotation_no_slots:
  assumes quote: "term_quoted_at E u r t I K" and closed: "self_contained_term t"
  shows "K={}"
  using quote closed by (induction rule: term_quoted_at.induct) auto

theorem self_contained_quotation_transfer:
  fixes E :: "'u artifact_environment" and F :: "'v artifact_environment"
  assumes quote: "term_quoted_at E u r t I K" and closed: "self_contained_term t"
    and source: "artifact_at E u R"
    and ff: "environment_formed F" and destination: "artifact_at F v R"
  shows "term_quoted_at F v r t I K"
  using quote closed source destination
proof (induction arbitrary: R rule: term_quoted_at.induct)
  case (target u S r c I t)
  then show ?case by simp
next
  case (pair u S r ps l q x L A y Q B)
  have same: "S=R" by (rule environment_artifact_unique[OF pair.hyps(1,2) pair.prems(2)])
  have xf: "self_contained_term x" and yf: "self_contained_term y"
    using pair.prems(1) by auto
  have rec: "record_at R r ps [l,q]" using pair.hyps(3) same by simp
  have left: "term_quoted_at F v l x L A" by (rule pair.IH(1)[OF xf pair.prems(2,3)])
  have right: "term_quoted_at F v q y Q B" by (rule pair.IH(2)[OF yf pair.prems(2,3)])
  show ?case by (rule term_quoted_at.pair[OF ff pair.prems(3) rec left right pair.hyps(6-8)])
next
  case (payload u S r x)
  have same: "S=R" by (rule environment_artifact_unique[OF payload.hyps(1,2) payload.prems(2)])
  have leaf: "payload_leaf_at R r x" using payload.hyps(3) same by simp
  show ?case by (rule term_quoted_at.payload[OF ff payload.prems(3) leaf])
qed

definition self_contained_quoted_at ::
  "exact_artifact \<Rightarrow> local_address \<Rightarrow> factor_term \<Rightarrow> local_address set \<Rightarrow> bool" where
  "self_contained_quoted_at R r t I \<longleftrightarrow>
    self_contained_term t \<and> term_quoted_at (singleton_environment R) () r t I {}"

lemma self_contained_quoted_unique:
  assumes "self_contained_quoted_at R r t I" "self_contained_quoted_at R r v J"
  shows "t=v \<and> I=J"
proof -
  have first: "term_quoted_at (singleton_environment R) () r t I {}"
    and second: "term_quoted_at (singleton_environment R) () r v J {}"
    using assms by (simp_all add: self_contained_quoted_at_def)
  show ?thesis using term_quoted_unique[OF first second] by blast
qed

lemma self_contained_quoted_formed:
  assumes "self_contained_quoted_at R r t I"
  shows "exact_formed R \<and> term_formed t"
proof -
  have read: "term_quoted_at (singleton_environment R) () r t I {}"
    using assms by (simp add: self_contained_quoted_at_def)
  have ef: "environment_formed (singleton_environment R)"
    by (rule term_quoted_environment_formed[OF read])
  have source: "artifact_at (singleton_environment R) () R"
    by (simp add: singleton_environment_def artifact_at_def)
  have rf: "exact_formed R" using ef source by (simp add: environment_formed_def)
  show ?thesis using rf term_quoted_formed[OF read] by blast
qed

lemma self_contained_quoted_in_environment:
  assumes read: "self_contained_quoted_at R r t I"
    and ef: "environment_formed E" and source: "artifact_at E u R"
  shows "term_quoted_at E u r t I {}"
proof -
  have quote: "term_quoted_at (singleton_environment R) () r t I {}"
    and closed: "self_contained_term t"
    using read by (simp_all add: self_contained_quoted_at_def)
  have art: "artifact_at (singleton_environment R) () R"
    by (simp add: singleton_environment_def artifact_at_def)
  show ?thesis by (rule self_contained_quotation_transfer[OF quote closed art ef source])
qed

theorem self_contained_quotation_total:
  assumes formed: "term_formed t" and closed: "self_contained_term t"
  shows "self_contained_quoted_at (term_syntax t) [] t (term_syntax_interior t)"
    "exact_formed (term_syntax t)"
    "rra_carrier (object_structure (term_syntax t))=term_syntax_interior t"
proof -
  have rf: "exact_formed (term_syntax t)" by (rule term_syntax_formed[OF formed])
  have slots: "term_literal_bindings t={}" by (rule self_contained_term_literals_empty[OF closed])
  have quote: "term_quoted_at (term_environment t) None [] t (term_syntax_interior t) {}"
    using term_syntax_recovers[OF formed] slots by simp
  have ef: "environment_formed (singleton_environment (term_syntax t))"
    using singleton_environment_closed[OF rf] by (simp add: environment_closed_def)
  have art: "artifact_at (singleton_environment (term_syntax t)) () (term_syntax t)"
    by (simp add: singleton_environment_def artifact_at_def)
  have recovered: "term_quoted_at (singleton_environment (term_syntax t)) ()
    [] t (term_syntax_interior t) {}"
    by (rule self_contained_quotation_transfer[OF quote closed term_environment_source ef art])
  show "self_contained_quoted_at (term_syntax t) [] t (term_syntax_interior t)"
    using closed recovered by (simp add: self_contained_quoted_at_def)
  show "exact_formed (term_syntax t)" by (rule rf)
  show "rra_carrier (object_structure (term_syntax t))=term_syntax_interior t"
    using term_syntax_carrier[of t] slots by simp
qed

section \<open>Complete finite collections carried by payloads and pairs\<close>

fun data_list_term :: "factor_term list \<Rightarrow> factor_term" where
  "data_list_term [] = Payload_Term []"
| "data_list_term (t#ts) = Pair_Term t (data_list_term ts)"

lemma data_list_term_injective:
  "data_list_term xs=data_list_term ys \<longleftrightarrow> xs=ys"
  by (induction xs arbitrary: ys) (case_tac ys; auto)+

lemma data_list_term_formed:
  "term_formed (data_list_term ts) \<longleftrightarrow> (\<forall>t\<in>set ts. term_formed t)"
  by (induction ts) (auto simp: octets_formed_def)

lemma data_list_term_self_contained:
  "self_contained_term (data_list_term ts) \<longleftrightarrow>
    (\<forall>t\<in>set ts. self_contained_term t)"
  by (induction ts) auto

lemma data_list_term_member_height:
  assumes "x\<in>set xs"
  shows "term_height x<term_height (data_list_term xs)"
  using assms
proof (induction xs)
  case Nil
  then show ?case by simp
next
  case (Cons y ys)
  show ?case
  proof (cases "x=y")
    case True
    then show ?thesis by simp
  next
    case False
    have inside: "x\<in>set ys" using Cons.prems False by simp
    have smaller: "term_height x<term_height (data_list_term ys)" by (rule Cons.IH[OF inside])
    show ?thesis by (rule less_le_trans[OF smaller]) simp
  qed
qed

lemma injective_mapped_lists:
  assumes "inj f"
  shows "map f xs=map f ys \<longleftrightarrow> xs=ys"
  using assms by (induction xs arbitrary: ys) (case_tac ys; auto dest: injD)+

definition data_collection_presents ::
  "('a \<Rightarrow> factor_term \<Rightarrow> bool) \<Rightarrow> 'a set \<Rightarrow> factor_term \<Rightarrow> bool" where
  "data_collection_presents read A t \<longleftrightarrow>
    (\<exists>xs ts. distinct xs \<and> set xs=A \<and> list_all2 read xs ts \<and> t=data_list_term ts)"

lemma data_collection_presents_finite:
  assumes "data_collection_presents read A t"
  shows "finite A"
  using assms by (auto simp: data_collection_presents_def)

lemma data_collection_presents_mono [mono]:
  assumes order: "P\<le>Q"
  shows "data_collection_presents P\<le>data_collection_presents Q"
proof (intro le_funI le_boolI)
  fix A v
  assume present: "data_collection_presents P A v"
  obtain xs ts where entries: "distinct xs" "set xs=A" "list_all2 P xs ts" "v=data_list_term ts"
    using present unfolding data_collection_presents_def by blast
  have "list_all2 Q xs ts" by (rule list_all2_mono[OF entries(3)])
    (use order in \<open>auto simp: le_fun_def\<close>)
  then show "data_collection_presents Q A v" using entries(1,2,4)
    unfolding data_collection_presents_def by blast
qed

lemma data_collection_presents_sources:
  assumes present: "data_collection_presents read A t"
  shows "\<forall>a\<in>A. \<exists>v. read a v"
proof -
  obtain xs ts where entries: "set xs=A" "list_all2 read xs ts"
    using present unfolding data_collection_presents_def by blast
  show ?thesis
  proof (intro ballI)
    fix a assume "a\<in>A"
    then obtain i where index: "i<length xs" "a=xs!i"
      using entries(1) by (auto simp: in_set_conv_nth)
    have "read (xs!i) (ts!i)" by (rule list_all2_nthD[OF entries(2) index(1)])
    then show "\<exists>v. read a v" using index(2) by auto
  qed
qed

lemma data_collection_presents_map:
  assumes "distinct xs" "set xs=A" "\<And>x. x\<in>A \<Longrightarrow> read x (f x)"
  shows "data_collection_presents read A (data_list_term (map f xs))"
  unfolding data_collection_presents_def
  by (rule exI[of _ xs], rule exI[of _ "map f xs"])
     (use assms in \<open>simp add: list_all2_map2 list_all2_same\<close>)

lemma data_collection_presents_recover_map:
  assumes present: "data_collection_presents read A (data_list_term (map code xs))"
    and recover: "\<And>x a. x\<in>set xs \<Longrightarrow> read a (code x) \<Longrightarrow> a=decode x"
  shows "A=set (map decode xs)"
proof -
  obtain ys ts where source: "set ys=A" "list_all2 read ys ts"
    "data_list_term (map code xs)=data_list_term ts"
    using present by (auto simp: data_collection_presents_def)
  have reads: "list_all2 read ys (map code xs)"
    using source(2,3) by (simp add: data_list_term_injective)
  have inverse: "ys=map decode xs" using reads recover
  proof (induction xs arbitrary: ys)
    case Nil
    then show ?case by simp
  next
    case (Cons x xs)
    obtain y zs where shape: "ys=y#zs" and head: "read y (code x)"
      and tail: "list_all2 read zs (map code xs)"
      using Cons.prems(1) by (auto simp: list_all2_Cons2)
    have first: "y=decode x" using Cons.prems(2) head by simp
    have rest: "zs=map decode xs" by (rule Cons.IH[OF tail]) (use Cons.prems(2) in auto)
    show ?case using shape first rest by simp
  qed
  show ?thesis using source(1) inverse by simp
qed

lemma data_collection_presents_function:
  "data_collection_presents (\<lambda>a u. u=f a) A t \<longleftrightarrow>
    (\<exists>xs. distinct xs \<and> set xs=A \<and> t=data_list_term (map f xs))"
  by (simp add: data_collection_presents_def list_all2_function)

lemma data_collection_presents_total:
  assumes fin: "finite A" and each: "\<forall>a\<in>A. \<exists>t. read a t"
  shows "\<exists>t. data_collection_presents read A t"
proof -
  obtain xs where enumeration: "distinct xs" "set xs=A"
    using finite_distinct_list[OF fin] by blast
  obtain f where chosen: "\<forall>a\<in>A. read a (f a)" using bchoice[OF each] by blast
  have "data_collection_presents read A (data_list_term (map f xs))"
    by (rule data_collection_presents_map[OF enumeration]) (use chosen in blast)
  then show ?thesis by blast
qed

lemma data_collection_presents_unique:
  assumes first: "data_collection_presents read A t"
    and second: "data_collection_presents read B t"
    and unique: "\<And>a b u. a\<in>A \<Longrightarrow> b\<in>B \<Longrightarrow>
      read a u \<Longrightarrow> read b u \<Longrightarrow> a=b"
  shows "A=B"
proof -
  obtain xs ts where left: "distinct xs" "set xs=A" "list_all2 read xs ts" "t=data_list_term ts"
    using first unfolding data_collection_presents_def by blast
  obtain ys us where right: "distinct ys" "set ys=B" "list_all2 read ys us" "t=data_list_term us"
    using second unfolding data_collection_presents_def by blast
  have same: "ts=us" using left(4) right(4) by (simp add: data_list_term_injective)
  have a: "finite_collection_presents read A (enumeration_term ts)"
    using left(1-3) unfolding finite_collection_presents_def by blast
  have b: "finite_collection_presents read B (enumeration_term ts)"
    using right(1-3) same unfolding finite_collection_presents_def by blast
  show ?thesis by (rule finite_collection_presents_unique[OF a b unique])
qed

lemma data_collection_presents_elements:
  assumes present: "data_collection_presents read A t"
    and each: "\<And>a u. a\<in>A \<Longrightarrow> read a u \<Longrightarrow> Q u"
  shows "\<exists>ts. t=data_list_term ts \<and> (\<forall>u\<in>set ts. Q u)"
proof -
  obtain xs ts where entries: "set xs=A" "list_all2 read xs ts" "t=data_list_term ts"
    using present unfolding data_collection_presents_def by blast
  have all: "\<forall>u\<in>set ts. Q u"
  proof (intro ballI)
    fix u assume "u\<in>set ts"
    then obtain i where index: "i<length ts" "u=ts!i" by (auto simp: in_set_conv_nth)
    have bound: "i<length xs" using entries(2) index(1) list_all2_lengthD by metis
    have inside: "xs!i\<in>A" using nth_mem[OF bound] entries(1) by simp
    have read: "read (xs!i) (ts!i)" by (rule list_all2_nthD[OF entries(2) bound])
    show "Q u" using each[OF inside read] index(2) by simp
  qed
  show ?thesis using entries(3) all by blast
qed

lemma data_collection_presents_formed:
  assumes present: "data_collection_presents read A t"
    and each: "\<And>a u. a\<in>A \<Longrightarrow> read a u \<Longrightarrow> term_formed u"
  shows "term_formed t"
proof -
  have "\<exists>ts. t=data_list_term ts \<and> (\<forall>u\<in>set ts. term_formed u)"
    by (rule data_collection_presents_elements[OF present]) (rule each; assumption)
  then show ?thesis by (auto simp: data_list_term_formed)
qed

lemma data_collection_presents_self_contained:
  assumes present: "data_collection_presents read A t"
    and each: "\<And>a u. a\<in>A \<Longrightarrow> read a u \<Longrightarrow> self_contained_term u"
  shows "self_contained_term t"
proof -
  have "\<exists>ts. t=data_list_term ts \<and> (\<forall>u\<in>set ts. self_contained_term u)"
    by (rule data_collection_presents_elements[OF present]) (rule each; assumption)
  then show ?thesis by (auto simp: data_list_term_self_contained)
qed

text \<open>
  These are derived profiles of the existing term and quotation relations.
  Every payload-and-pair term has a complete native presentation with no
  external slots; its recovery is independent of all outgoing bindings.
  The data-list profile uses an empty payload as its terminator so that list
  termination itself needs no target citation. Pair structure distinguishes
  a cons cell from termination.

  Collections include every actual member exactly once and admit every order
  and every permitted presentation of each member. Unique recovery does not
  equate their ordinary term values or assert order-invariant semantic truth.
\<close>

end
