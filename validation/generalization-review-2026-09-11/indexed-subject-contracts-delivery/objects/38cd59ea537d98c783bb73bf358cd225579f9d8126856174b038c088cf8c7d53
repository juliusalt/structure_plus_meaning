theory Inference_Development
  imports "Inference_Closure" "Bootstrap_Finite_Closure"
begin

section \<open>A local premise bound measures conditional capability\<close>

definition bounded_inferences ::
  "nat \<Rightarrow> ('a \<Rightarrow> ('i \<times> 'a) set \<Rightarrow> bool) \<Rightarrow>
    'a \<Rightarrow> ('i \<times> 'a) set \<Rightarrow> bool" where
  "bounded_inferences k R a H \<longleftrightarrow> R a H \<and> card H\<le>k"

definition inference_capability ::
  "nat \<Rightarrow> ('a \<Rightarrow> ('i \<times> 'a) set \<Rightarrow> bool) \<Rightarrow>
    ('a set \<times> 'a) set" where
  "inference_capability k R={(K,a). a\<in>inference_closure (bounded_inferences k R) K}"

lemma inference_capability_comparison:
  "inference_capability k R\<subseteq>inference_capability l S \<longleftrightarrow>
    inference_refines (bounded_inferences k R) (bounded_inferences l S)"
  by (auto simp: inference_capability_def inference_refines_def)

lemma bounded_inferences_sound:
  "inference_sound T R \<Longrightarrow> inference_sound T (bounded_inferences k R)"
  by (auto simp: inference_sound_def bounded_inferences_def)

theorem bounded_inferences_complete:
  assumes "\<And>a H. finite H \<Longrightarrow> single_valued H \<Longrightarrow> R a H \<Longrightarrow> card H\<le>k"
  shows "inference_closure (bounded_inferences k R) K=inference_closure R K"
proof -
  have first: "inference_refines (bounded_inferences k R) R"
    by (rule inference_refines_by_inclusion) (simp add: bounded_inferences_def)
  have second: "inference_refines R (bounded_inferences k R)"
    unfolding inference_refines_iff_rules
  proof (intro allI impI)
    fix a H
    assume fin: "finite H" and formed: "single_valued H" and source: "R a H"
    have bounded: "bounded_inferences k R a H"
      using source assms[OF fin formed source] by (simp add: bounded_inferences_def)
    show "a\<in>inference_closure (bounded_inferences k R) (rel_ran H)"
      by (rule inference_closure_step[where H=H and R="bounded_inferences k R"])
        (rule fin, rule formed, rule bounded, rule inference_closure_seed)
  qed
  show ?thesis using first second by (auto simp: inference_refines_def)
qed

theorem larger_local_bound_preserves_capability:
  assumes "k\<le>l"
  shows "inference_capability k R\<subseteq>inference_capability l R"
  unfolding inference_capability_comparison
  by (rule inference_refines_by_inclusion)
    (use assms in \<open>auto simp: bounded_inferences_def\<close>)

section \<open>Selection and stopping quantify their complete candidate scope\<close>

definition maximal_candidate ::
  "'c set \<Rightarrow> ('c \<Rightarrow> 'a set) \<Rightarrow> 'c \<Rightarrow> bool" where
  "maximal_candidate C ability c \<longleftrightarrow>
    c\<in>C \<and> (\<forall>d\<in>C. ability c\<subseteq>ability d \<longrightarrow> ability d\<subseteq>ability c)"

definition complete_candidate ::
  "'c set \<Rightarrow> ('c \<Rightarrow> 'a set) \<Rightarrow> 'c \<Rightarrow> bool" where
  "complete_candidate C ability c \<longleftrightarrow>
    c\<in>C \<and> (\<forall>d\<in>C. ability d\<subseteq>ability c)"

definition candidate_cover ::
  "'c set \<Rightarrow> ('c \<Rightarrow> 'a set) \<Rightarrow> 'c set \<Rightarrow> bool" where
  "candidate_cover C ability F \<longleftrightarrow>
    F\<subseteq>C \<and> (\<forall>c\<in>C. \<exists>d\<in>F. ability c\<subseteq>ability d)"

theorem finite_candidate_selection:
  assumes "finite C" "c\<in>C"
  shows "\<exists>d. maximal_candidate C ability d \<and> ability c\<subseteq>ability d"
proof -
  have fin: "finite (ability ` C)" by (rule finite_imageI[OF assms(1)])
  have start: "ability c\<in>ability ` C" by (rule imageI[OF assms(2)])
  obtain M where member: "M\<in>ability ` C" and improves: "ability c\<subseteq>M"
    and maximal: "\<forall>N\<in>ability ` C. M\<subseteq>N \<longrightarrow> M=N"
    using finite_has_maximal2[OF fin start] by blast
  obtain d where d: "d\<in>C" "ability d=M" using member by blast
  show ?thesis
    by (rule exI[of _ d]) (use d improves maximal in \<open>auto simp: maximal_candidate_def\<close>)
qed

lemma complete_candidate_maximal:
  "complete_candidate C ability c \<Longrightarrow> maximal_candidate C ability c"
  by (auto simp: complete_candidate_def maximal_candidate_def)

theorem complete_candidate_from_cover:
  assumes "candidate_cover C ability F"
  shows "complete_candidate C ability c \<longleftrightarrow>
    c\<in>C \<and> (\<forall>d\<in>F. ability d\<subseteq>ability c)"
  using assms by (auto simp: candidate_cover_def complete_candidate_def; blast)

theorem maximal_candidate_from_cover:
  assumes "candidate_cover C ability F"
  shows "maximal_candidate C ability c \<longleftrightarrow>
    c\<in>C \<and> (\<forall>d\<in>F. ability c\<subseteq>ability d \<longrightarrow> ability d\<subseteq>ability c)"
  using assms by (auto simp: candidate_cover_def maximal_candidate_def; blast)

definition development_scope :: "('c \<times> 'c) set \<Rightarrow> 'c \<Rightarrow> 'c set" where
  "development_scope E c={d. (c,d)\<in>E\<^sup>*}"

theorem development_scope_bound:
  assumes initial: "c\<in>C"
    and closed: "\<And>a b. a\<in>C \<Longrightarrow> (a,b)\<in>E \<Longrightarrow> b\<in>C"
  shows "development_scope E c\<subseteq>C"
proof
  fix d assume "d\<in>development_scope E c"
  then have "(c,d)\<in>E\<^sup>*" by (simp add: development_scope_def)
  then show "d\<in>C"
  proof (induction rule: rtrancl_induct)
    case base
    show ?case by (rule initial)
  next
    case (step a b)
    show ?case by (rule closed[OF step.IH step.hyps(2)])
  qed
qed

theorem development_scope_exact:
  assumes "c\<in>C" "\<And>a b. a\<in>C \<Longrightarrow> (a,b)\<in>E \<Longrightarrow> b\<in>C"
    "C\<subseteq>development_scope E c"
  shows "development_scope E c=C"
proof (rule equalityI)
  show "development_scope E c\<subseteq>C"
    by (rule development_scope_bound[OF assms(1)]) (rule assms(2))
  show "C\<subseteq>development_scope E c" by (rule assms(3))
qed

theorem finite_development_scope:
  "development_scope (fset E) c=fset (finite_reachable_outputs id E c)"
proof (rule set_eqI)
  fix d
  have right: "d\<in>fset (finite_reachable_outputs id E c) \<longleftrightarrow>
      d=c \<or> (\<exists>a. (a,d)\<in>fset E \<and> (c,a)\<in>(fset E)\<^sup>*)"
    by (simp add: finite_reachable_outputs_member finite_transition_keys_def)
  show "d\<in>development_scope (fset E) c \<longleftrightarrow> d\<in>fset (finite_reachable_outputs id E c)"
    unfolding right development_scope_def
    by (auto elim: rtranclE intro: rtrancl.rtrancl_into_rtrancl)
qed

section \<open>A semantic upper bound can justify stopping over infinitely many methods\<close>

definition model_consequences :: "'a set set \<Rightarrow> 'a set \<Rightarrow> 'a set" where
  "model_consequences M K={a. \<forall>T\<in>M. K\<subseteq>T \<longrightarrow> a\<in>T}"

theorem model_consequences_bound:
  assumes "\<And>T. T\<in>M \<Longrightarrow> inference_sound (\<lambda>a. a\<in>T) R"
  shows "inference_closure R K\<subseteq>model_consequences M K"
  using inference_closure_sound assms by (auto simp: model_consequences_def; blast)

theorem model_complete_method_dominates:
  assumes sound: "\<And>T. T\<in>M \<Longrightarrow> inference_sound (\<lambda>a. a\<in>T) R"
    and complete: "\<And>K. inference_closure S K=model_consequences M K"
  shows "inference_refines R S"
  using model_consequences_bound[OF sound] complete by (simp add: inference_refines_def)

theorem model_complete_candidate:
  assumes member: "R\<in>C"
    and sound: "\<And>S T. S\<in>C \<Longrightarrow> T\<in>M \<Longrightarrow> inference_sound (\<lambda>a. a\<in>T) S"
    and complete: "\<And>K. inference_closure (bounded_inferences k R) K=model_consequences M K"
  shows "complete_candidate C (inference_capability k) R"
proof -
  have comparison: "inference_refines (bounded_inferences k S) (bounded_inferences k R)" if "S\<in>C" for S
    by (rule model_complete_method_dominates[OF _ complete])
      (use sound[OF that] bounded_inferences_sound in blast)
  show ?thesis using member comparison
    by (simp add: complete_candidate_def inference_capability_comparison)
qed

section \<open>Limits of stopping claims\<close>

theorem an_immediate_plateau_can_hide_improvement:
  defines "E \<equiv> {(0::nat,1),(1,2)}"
    and "ability \<equiv> (\<lambda>n::nat. if n=2 then {()} else {})"
  shows "(\<forall>d. (0,d)\<in>E \<longrightarrow> ability d=ability 0) \<and>
    2\<in>development_scope E 0 \<and> ability 0\<subset>ability 2"
proof -
  have path: "(0,2)\<in>E\<^sup>*"
  proof -
    have "(0,1)\<in>E" "(1,2)\<in>E" by (simp_all add: E_def)
    then show ?thesis by (meson r_into_rtrancl rtrancl_trans)
  qed
  show ?thesis using path by (auto simp: E_def ability_def development_scope_def)
qed

theorem a_complete_candidate_can_leave_obligations:
  defines "R \<equiv> (\<lambda>_::bool. \<lambda>_::(unit\<times>bool) set. False)"
  shows "complete_candidate {R} (inference_capability 2) R \<and>
    remaining_obligations (inference_closure R {}) {((),False)}={((),False)}"
proof -
  have closed: "inference_closure R {}={}"
    by (rule unsupported_inference_cycle) (simp add: R_def)
  show ?thesis by (auto simp: complete_candidate_def closed remaining_obligations_def)
qed

theorem an_unbounded_scope_need_not_have_a_maximal_candidate:
  "\<not>(\<exists>n::nat. maximal_candidate UNIV (\<lambda>n. {..<n}) n)"
proof
  assume "\<exists>n::nat. maximal_candidate UNIV (\<lambda>n. {..<n}) n"
  then obtain n :: nat where maximal: "maximal_candidate UNIV (\<lambda>n. {..<n}) n" by blast
  have successor: "{..<n}\<subseteq>{..<Suc n} \<longrightarrow> {..<Suc n}\<subseteq>{..<n}"
    using maximal unfolding maximal_candidate_def by blast
  show False using successor by auto
qed

text \<open>
  A candidate can be supplied externally. Its capability is the set of
  conditional uses justified by its finite rules within a declared immediate
  premise bound. Inclusion preserves every earlier use; strict inclusion
  supplies an actual new use. It does not attach a score to the candidate's name.

  A maximal candidate has no dominating alternative in the declared scope;
  incomparable alternatives can remain. A complete candidate covers every
  alternative's capability. A smaller frontier supports either claim only
  through a proved dominating cover. Reachability includes paths through
  plateaus. Finite supplied edge relations have an exact finite closure, but
  their completeness for an intended search relation is a separate condition.

  Model completeness supplies a different stopping proof over an infinite
  class of sound methods. Neither stopping criterion proves an unrelated goal,
  and no theorem promises a maximal candidate in an arbitrary infinite scope.
  The premise bound counts explicit immediate interfaces. It does not bound
  the complexity hidden in an undeveloped condition or in choosing the models,
  intended scope, or candidate. Those choices can themselves become inputs to
  the same obligation-reduction account.
\<close>

end
