theory Factor_Admission_Installation
  imports "Factor_Admission_Plans"
begin

section \<open>Construction retains every original definition\<close>

definition admission_extension :: "(nat,nat,nat,nat) schema_system \<Rightarrow>
    (nat,nat,nat,nat) schema_system \<Rightarrow> bool" where
  "admission_extension P Q \<longleftrightarrow> schema_system_formed P \<and> schema_system_formed Q \<and>
    system_definitions P\<subseteq>system_definitions Q \<and>
    systems_agree_on P Q (system_definitions P)"

definition admission_source :: "(nat,nat,nat,nat) schema_system \<Rightarrow> nat \<Rightarrow> bool" where
  "admission_source P n \<longleftrightarrow> schema_system_formed P \<and> (\<forall>d\<in>system_definitions P. d<n)"

lemma admission_source_weaken:
  "admission_source P n \<Longrightarrow> n\<le>m \<Longrightarrow> admission_source P m"
  by (auto simp: admission_source_def)

lemma admission_extension_refl:
  "schema_system_formed P \<Longrightarrow> admission_extension P P"
  by (auto simp: admission_extension_def systems_agree_on_def)

lemma admission_extension_trans:
  "admission_extension P Q \<Longrightarrow> admission_extension Q R \<Longrightarrow> admission_extension P R"
  by (auto simp: admission_extension_def systems_agree_on_def; blast)

lemma admission_extension_meaning:
  assumes extension: "admission_extension P Q" and member: "d\<in>system_definitions P"
  shows "(d,t)\<in>positive_meaning Q \<longleftrightarrow> (d,t)\<in>positive_meaning P"
proof -
  have formed: "schema_system_formed P" "schema_system_formed Q"
    and agree: "systems_agree_on P Q (system_definitions P)"
    using extension by (auto simp: admission_extension_def)
  have closed: "system_dependency_closed P (system_definitions P)"
    using system_dependency_boundary(1)[OF formed(1)]
    by (auto simp: system_dependency_closed_def)
  show ?thesis using positive_meaning_dependency_locality[OF formed agree closed member] by blast
qed

lemma admission_extension_goal:
  assumes "admission_extension P Q" "admission_goal_sites g\<subseteq>system_definitions P"
  shows "admission_goal_holds (positive_meaning Q) g t \<longleftrightarrow>
    admission_goal_holds (positive_meaning P) g t"
  by (rule admission_goal_holds_agreement)
    (use admission_extension_meaning[OF assms(1)] assms(2) in blast)

lemma admission_fresh_extension:
  assumes source: "admission_source P n"
    and target: "schema_system_formed (add_view_definition P n data_x C)"
  shows "admission_source (add_view_definition P n data_x C) (Suc n)"
    and "admission_extension P (add_view_definition P n data_x C)"
  using source target
  by (auto simp: admission_source_def admission_extension_def systems_agree_on_def)

lemma admission_fresh_call:
  assumes "admission_source P n" "schema_system_formed (add_view_definition P n data_x C)"
  shows "schema_call_formed (add_view_definition P n data_x C) n t \<longleftrightarrow> term_formed t"
proof -
  have absent: "(n,p)\<notin>system_interfaces P" for p
    using assms(1) by (auto simp: admission_source_def system_definitions_def rel_dom_def)
  show ?thesis by (simp only: schema_call_formed_def assms(2) added_view_interfaces)
    (use absent in auto)
qed

lemma admission_fresh_family:
  assumes "admission_source P n"
  shows "((n,c),S)\<in>system_clauses (add_view_definition P n data_x C) \<longleftrightarrow> (c,S)\<in>C"
proof -
  have absent: "((n,c),S)\<notin>system_clauses P"
    using assms by (auto simp: admission_source_def schema_system_formed_def)
  show ?thesis by (simp add: absent)
qed

section \<open>Each installed constructor has its complete meaning\<close>

locale install_admission_pair =
  fixes P :: "(nat,nat,nat,nat) schema_system" and n a b :: nat
  assumes source: "admission_source P n"
    and first: "a\<in>system_definitions P" and second: "b\<in>system_definitions P"
begin

abbreviation target where "target \<equiv> add_view_definition P n data_x {(0,admitted_pair_schema a b)}"

lemma formed: "schema_system_formed target"
  by (rule add_recursive_definition_formed)
    (use source first second in \<open>auto simp: admission_source_def single_valued_def\<close>)

lemma extension: "admission_extension P target"
  by (rule admission_fresh_extension(2)[OF source formed])

lemma next_source: "admission_source target (Suc n)"
  by (rule admission_fresh_extension(1)[OF source formed])

interpretation profile: admitted_pair_profile target n a b
proof
  show "schema_system_formed target" by (rule formed)
  show "((n,c),S)\<in>system_clauses target \<longleftrightarrow> c=0 \<and> S=admitted_pair_schema a b" for c S
    by (simp only: admission_fresh_family[OF source]; auto)
  show "schema_call_formed target n t \<longleftrightarrow> term_formed t" for t
    by (rule admission_fresh_call[OF source formed])
qed

theorem exact:
  "(n,t)\<in>positive_meaning target \<longleftrightarrow>
    (\<exists>x y. t=Pair_Term x y \<and> (a,x)\<in>positive_meaning P \<and> (b,y)\<in>positive_meaning P)"
  by (simp only: profile.exact admission_extension_meaning[OF extension first]
    admission_extension_meaning[OF extension second])

end

locale install_admission_list =
  fixes P :: "(nat,nat,nat,nat) schema_system" and n a :: nat
  assumes source: "admission_source P n" and element: "a\<in>system_definitions P"
begin

abbreviation target where "target \<equiv> add_view_definition P n data_x (list_profile_clauses a n)"

lemma formed: "schema_system_formed target"
  by (rule add_recursive_definition_formed)
    (use source element in \<open>auto simp: admission_source_def list_profile_clauses_def
      data_list_nil_schema_def list_step_schema_def schema_formed_def single_valued_def
      schema_dependencies_def rel_ran_image octets_formed_def\<close>)

lemma extension: "admission_extension P target"
  by (rule admission_fresh_extension(2)[OF source formed])

lemma next_source: "admission_source target (Suc n)"
  by (rule admission_fresh_extension(1)[OF source formed])

interpretation profile: list_profile target a n
proof
  show "schema_system_formed target" by (rule formed)
  show "((n,c),S)\<in>system_clauses target \<longleftrightarrow> (c,S)\<in>list_profile_clauses a n" for c S
    by (rule admission_fresh_family[OF source])
  show "schema_call_formed target n t \<longleftrightarrow> term_formed t" for t
    by (rule admission_fresh_call[OF source formed])
qed

theorem exact:
  "(n,t)\<in>positive_meaning target \<longleftrightarrow>
    (\<exists>xs. t=data_list_term xs \<and> (\<forall>x\<in>set xs. (a,x)\<in>positive_meaning P))"
  by (simp only: profile.exact admission_extension_meaning[OF extension element])

end

end
