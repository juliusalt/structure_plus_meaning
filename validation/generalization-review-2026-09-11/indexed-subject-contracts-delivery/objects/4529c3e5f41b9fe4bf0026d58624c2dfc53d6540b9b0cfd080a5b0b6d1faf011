"""Replay all retained stages and investigations without sharing Python imports."""
from concurrent.futures import ThreadPoolExecutor
import json
from pathlib import Path
import subprocess
import sys
b=Path(__file__).parent
archive=Path('/home/julius/structure_and_semantics/validation/generalization-review-2026-09-11/indexed-subject-contracts')
index=json.loads((archive/'index.json').read_text())
poly='/opt/isabelle/contrib/polyml-5.9.2-2/x86_64-linux/poly'
items=[('stage',name) for name in index['runs']]+[('investigation',name) for name in index['investigations']]
output=b/'replays1';output.mkdir(exist_ok=False)
def execute(item):
    kind,name=item
    command=[sys.executable,'-B',str(b/'worktree/tools/replay_reasoning_review.py'),'--archive',str(archive),
             '--'+kind,name,'--poly',poly,'--output',str(output/name)]
    with (output/(name+'.log')).open('w') as log:
        result=subprocess.run(command,stdout=log,stderr=subprocess.STDOUT)
    row={'kind':kind,'name':name,'exit_code':result.returncode,'command':command,'log':str(output/(name+'.log'))}
    print(json.dumps({k:v for k,v in row.items() if k not in ['command'] }),flush=True)
    return row
with ThreadPoolExecutor(max_workers=4) as pool:
    results=list(pool.map(execute,items))
(output/'summary.json').write_text(json.dumps(results,indent=2)+'\n')
raise SystemExit(int(any(row['exit_code'] for row in results)))
