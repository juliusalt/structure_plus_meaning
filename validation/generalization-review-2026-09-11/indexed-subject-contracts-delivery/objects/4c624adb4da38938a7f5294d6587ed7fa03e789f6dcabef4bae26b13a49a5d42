theory Factor_Premise_Construction
  imports "Factor_Prospective_Encoding" "Factor_Record_Construction" "Factor_Cloned_Transport"
begin

section \<open>Explicit references required by a body under construction\<close>

definition map_slot_keys :: "(local_address \<Rightarrow> local_address) \<Rightarrow> (local_address \<times> 'a) set \<Rightarrow> (local_address \<times> 'a) set" where
  "map_slot_keys f M = (\<lambda>(k,x). (f k,x)) ` M"

lemma map_slot_keys_domain:
  "rel_dom (map_slot_keys f M) = f ` rel_dom M"
  by (simp add: map_slot_keys_def pair_image_domain)

lemma map_slot_keys_range:
  "rel_ran (map_slot_keys f M) = rel_ran M"
  by (auto simp: map_slot_keys_def rel_ran_def intro: rev_image_eqI)

lemma map_slot_keys_identity [simp]: "map_slot_keys id M = M"
  by (simp add: map_slot_keys_def)

lemma map_slot_keys_member:
  assumes "(k,x) \<in> M"
  shows "(f k,x) \<in> map_slot_keys f M"
  using imageI[OF assms, of "\<lambda>(k,x). (f k,x)"] by (simp add: map_slot_keys_def)

definition syntax_references ::
  "'u artifact_environment \<Rightarrow> 'u \<Rightarrow> (local_address \<times> exact_artifact) set \<Rightarrow>
    (local_address \<times> 'u definition_site) set \<Rightarrow> bool" where
  "syntax_references E u L C \<longleftrightarrow>
    (\<forall>k R. (k,R) \<in> L \<longrightarrow> external_slot_values E u k = {R}) \<and>
    (\<forall>k d. (k,d) \<in> C \<longrightarrow> binds_slot E u k (fst d) \<and>
      (\<exists>R. artifact_at E (fst d) R \<and> anchor_formed (R,snd d)))"

lemma syntax_references_mono:
  assumes "syntax_references E u L C" "A \<subseteq> L" "B \<subseteq> C"
  shows "syntax_references E u A B"
  using assms unfolding syntax_references_def by blast

lemma reference_literal_fibre:
  assumes refs: "syntax_references E u (map_slot_keys f L) C" and sv: "single_valued L"
    and member: "k \<in> rel_dom L"
  shows "external_slot_values E u (f k) = {R. (k,R) \<in> L}"
proof -
  obtain R where entry: "(k,R) \<in> L" using member by (auto simp: rel_dom_def)
  have mapped: "(f k,R) \<in> map_slot_keys f L" by (rule map_slot_keys_member[OF entry])
  have literal: "external_slot_values E u (f k) = {R}"
    using refs mapped unfolding syntax_references_def by blast
  show ?thesis using literal single_valued_fibre[OF sv entry] by simp
qed

lemma reference_literal_values:
  assumes "syntax_references E u L C" "single_valued L" "k \<in> rel_dom L"
  shows "external_slot_values E u k = {R. (k,R) \<in> L}"
  using reference_literal_fibre[of E u id L C k] assms by simp

lemma cloned_syntax_references:
  assumes ef: "environment_formed E" and fresh: "z \<notin> environment_uses E"
    and bounds: "rel_dom L \<union> rel_dom C \<subseteq> rra_carrier (object_structure R)"
    and refs: "syntax_references E u (map_slot_keys f L) (map_slot_keys f C)"
  shows "syntax_references (clone_source_environment E u R f z) z L C"
proof -
  have literals: "\<forall>k T. (k,T) \<in> L \<longrightarrow>
    external_slot_values (clone_source_environment E u R f z) z k = {T}"
  proof (intro allI impI)
    fix k T assume entry: "(k,T) \<in> L"
    have inside: "k \<in> rra_carrier (object_structure R)" using bounds entry by (auto simp: rel_dom_def)
    have mapped: "(f k,T) \<in> map_slot_keys f L" by (rule map_slot_keys_member[OF entry])
    have actual: "external_slot_values E u (f k) = {T}" using refs mapped unfolding syntax_references_def by blast
    show "external_slot_values (clone_source_environment E u R f z) z k = {T}"
      using clone_source_literal_values[OF ef fresh inside] actual by simp
  qed
  have callees: "\<forall>k d. (k,d) \<in> C \<longrightarrow>
    binds_slot (clone_source_environment E u R f z) z k (fst d) \<and>
    (\<exists>T. artifact_at (clone_source_environment E u R f z) (fst d) T \<and> anchor_formed (T,snd d))"
  proof (intro allI impI)
    fix k d assume entry: "(k,d) \<in> C"
    have key: "k \<in> rel_dom C" by (rule rel_domI[OF entry])
    have inside: "k \<in> rra_carrier (object_structure R)" using bounds key by blast
    have mapped: "(f k,d) \<in> map_slot_keys f C" by (rule map_slot_keys_member[OF entry])
    have actual: "binds_slot E u (f k) (fst d)" "\<exists>T. artifact_at E (fst d) T \<and> anchor_formed (T,snd d)"
      using refs mapped unfolding syntax_references_def by blast+
    show "binds_slot (clone_source_environment E u R f z) z k (fst d) \<and>
      (\<exists>T. artifact_at (clone_source_environment E u R f z) (fst d) T \<and> anchor_formed (T,snd d))"
      using actual inside by (auto simp: clone_source_binding[OF ef fresh] clone_artifact_iff)
  qed
  show ?thesis using literals callees by (simp add: syntax_references_def)
qed

type_synonym ('a,'u) premise_template = "('u definition_site \<times> 'a term_pattern) + 'a material_pattern"

fun template_variables :: "('a,'u) premise_template \<Rightarrow> 'a set" where
  "template_variables (Inl (d,p)) = pattern_variables p"
| "template_variables (Inr M) = material_variables M"

lemma template_variables_case:
  "template_variables t = (case t of Inl dp \<Rightarrow> pattern_variables (snd dp)
    | Inr M \<Rightarrow> material_variables M)"
  by (cases t) (auto split: prod.splits)

fun template_formed :: "('a,'u) premise_template \<Rightarrow> bool" where
  "template_formed (Inl (d,p)) = (octets_formed (snd d) \<and> pattern_formed p)"
| "template_formed (Inr M) = material_pattern_formed M"

fun template_projection :: "('a \<Rightarrow> local_address) \<Rightarrow> ('a,'u) premise_template \<Rightarrow> 'u native_premise" where
  "template_projection f (Inl (d,p)) = Inl (d,rename_pattern f p)"
| "template_projection f (Inr M) = Inr (rename_material_pattern f M)"

fun template_syntax :: "('a \<Rightarrow> local_address) \<Rightarrow> ('a,'u) premise_template \<Rightarrow> exact_artifact" where
  "template_syntax f (Inl (d,p)) = prospective_syntax f (snd d) p"
| "template_syntax f (Inr M) = material_syntax f M"

fun template_interior :: "('a,'u) premise_template \<Rightarrow> local_address set" where
  "template_interior (Inl (d,p)) = prospective_interior p"
| "template_interior (Inr M) = pattern_record_interior (material_fields M)"

fun template_literals :: "('a,'u) premise_template \<Rightarrow> (local_address \<times> exact_artifact) set" where
  "template_literals (Inl (d,p)) = map_slot_keys (Cons 3) (pattern_literal_bindings p)"
| "template_literals (Inr M) = pattern_forest_bindings (material_fields M)"

fun template_callees :: "('a,'u) premise_template \<Rightarrow> (local_address \<times> 'u definition_site) set" where
  "template_callees (Inl (d,p)) = {([2,4],d)}"
| "template_callees (Inr M) = {}"

lemma template_variables_finite [simp]: "finite (template_variables t)"
  by (cases t) (auto split: prod.splits)

lemma template_syntax_properties:
  "[] \<in> rra_carrier (object_structure (template_syntax f t))"
  "bag_count (object_data (template_syntax f t)) = (\<lambda>_. 0)"
  "binder_silent (template_syntax f t)"
  by (cases t; auto split: prod.splits)+

lemma template_interior_outside:
  "template_interior t \<inter> binder_addresses = {}"
proof (cases t)
  case (Inl pair)
  obtain d p where shape: "pair=(d,p)" by (cases pair)
  show ?thesis by (simp only: Inl shape template_interior.simps) (rule prospective_interior_outside)
next
  case (Inr M)
  show ?thesis by (simp only: Inr template_interior.simps) (rule pattern_record_interior_outside)
qed

lemma template_reference_slots_outside:
  "(rel_dom (template_literals t) \<union> rel_dom (template_callees t)) \<inter> binder_addresses = {}"
proof (cases t)
  case (Inl pair)
  obtain d p where shape: "pair=(d,p)" by (cases pair)
  show ?thesis
    by (simp only: Inl shape template_literals.simps template_callees.simps map_slot_keys_domain)
       (auto simp: rel_dom_def)
next
  case (Inr M)
  show ?thesis by (simp only: Inr template_literals.simps template_callees.simps rel_dom_empty Un_empty_right)
    (rule pattern_forest_slots_outside)
qed

lemma template_syntax_formed:
  assumes "template_formed t" "binder_addressing (template_variables t) f"
  shows "exact_formed (template_syntax f t)"
  using assms by (cases t)
    (auto intro: prospective_syntax_formed material_syntax_formed split: prod.splits)

lemma template_syntax_carrier:
  assumes addressing: "binder_addressing (template_variables t) f"
  shows "rra_carrier (object_structure (template_syntax f t)) =
    template_interior t \<union> rel_dom (template_literals t) \<union> rel_dom (template_callees t) \<union> f ` template_variables t"
proof (cases t)
  case (Inl pair)
  obtain d p where shape: "pair=(d,p)" by (cases pair)
  have addr: "binder_addressing (pattern_variables p) f" using addressing Inl shape by simp
  show ?thesis using prospective_syntax_carrier[OF addr, of "snd d"]
    by (simp only: Inl shape template_syntax.simps template_interior.simps template_literals.simps
        template_callees.simps template_variables.simps map_slot_keys_domain)
       (auto simp: prospective_slots_def rel_dom_def)
next
  case (Inr M)
  have vars: "pattern_forest_variables (material_fields M) = material_variables M"
    by (simp add: pattern_forest_variables_def material_variables_def)
  have addr: "binder_addressing (pattern_forest_variables (material_fields M)) f"
    using addressing Inr vars by simp
  have carrier: "rra_carrier (object_structure (material_syntax f M)) =
    pattern_record_interior (material_fields M) \<union> rel_dom (pattern_forest_bindings (material_fields M)) \<union>
      f ` material_variables M"
    using pattern_record_syntax_carrier[OF addr] vars by (simp add: material_syntax_def)
  show ?thesis using carrier by (simp only: Inr template_syntax.simps template_interior.simps
      template_literals.simps template_callees.simps template_variables.simps) (simp add: rel_dom_def)
qed

theorem template_syntax_recovers:
  assumes formed: "template_formed t" and addressing: "binder_addressing (template_variables t) f"
    and scope: "f ` template_variables t \<subseteq> V" and boundary: "V \<subseteq> binder_addresses"
    and ef: "environment_formed E" and source: "artifact_at E u (template_syntax f t)"
    and refs: "syntax_references E u (template_literals t) (template_callees t)"
  shows "native_premise_at E u V [] (template_projection f t) (template_interior t)
    (rel_dom (template_literals t) \<union> rel_dom (template_callees t))"
proof (cases t)
  case (Inl pair)
  obtain d p where shape: "pair=(d,p)" by (cases pair)
  have pf: "pattern_formed p" and addr: "binder_addressing (pattern_variables p) f"
    and used: "f ` pattern_variables p \<subseteq> V"
    using formed addressing scope Inl shape by simp_all
  have src: "artifact_at E u (prospective_syntax f (snd d) p)" using source Inl shape by simp
  have needs: "syntax_references E u (map_slot_keys (Cons 3) (pattern_literal_bindings p)) {([2,4],d)}"
    using refs Inl shape by simp
  have literals: "\<forall>k\<in>rel_dom (pattern_literal_bindings p).
    external_slot_values E u (3#k) = {R. (k,R) \<in> pattern_literal_bindings p}"
    by (intro ballI) (rule reference_literal_fibre[OF needs pattern_literal_bindings_functional]; assumption)
  obtain R where callee: "binds_slot E u [2,4] (fst d)" "artifact_at E (fst d) R" "anchor_formed (R,snd d)"
    using needs by (auto simp: syntax_references_def)
  have call: "prospective_call_at E u V [] d (rename_pattern f p) (prospective_interior p) (prospective_slots p)"
    using prospective_syntax_recovers[OF pf addr used boundary ef src literals callee] by simp
  have native: "native_premise_at E u V [] (Inl (d,rename_pattern f p)) (prospective_interior p) (prospective_slots p)"
    by (rule native_premise_at.call[OF call])
  show ?thesis using native
    by (simp only: Inl shape template_projection.simps template_interior.simps template_literals.simps
        template_callees.simps map_slot_keys_domain) (auto simp: prospective_slots_def rel_dom_def)
next
  case (Inr M)
  have mf: "material_pattern_formed M" and addr: "binder_addressing (material_variables M) f"
    and used: "f ` material_variables M \<subseteq> V"
    using formed addressing scope Inr by simp_all
  have src: "artifact_at E u (material_syntax f M)" using source Inr by simp
  have needs: "syntax_references E u (pattern_forest_bindings (material_fields M)) {}" using refs Inr by simp
  have literals: "\<forall>k\<in>rel_dom (pattern_forest_bindings (material_fields M)).
    external_slot_values E u k = {R. (k,R) \<in> pattern_forest_bindings (material_fields M)}"
    by (intro ballI) (rule reference_literal_values[OF needs pattern_forest_bindings_functional]; assumption)
  have mat: "native_material_at E u V [] (rename_material_pattern f M)
    (pattern_record_interior (material_fields M)) (rel_dom (pattern_forest_bindings (material_fields M)))"
    by (rule material_syntax_recovers[OF mf addr used boundary ef src literals])
  have native: "native_premise_at E u V [] (Inr (rename_material_pattern f M))
    (pattern_record_interior (material_fields M)) (rel_dom (pattern_forest_bindings (material_fields M)))"
    by (rule native_premise_at.material[OF mat])
  show ?thesis using native by (simp only: Inr template_projection.simps template_interior.simps
      template_literals.simps template_callees.simps) (simp add: rel_dom_def)
qed

