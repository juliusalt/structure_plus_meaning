theory Presentation_Transport
  imports "Presentation_Closure"
begin

section \<open>Presentations of one independently fixed subject correspond\<close>

definition presentation_transport ::
  "('a \<Rightarrow> 'p \<Rightarrow> bool) \<Rightarrow> ('a \<Rightarrow> 'q \<Rightarrow> bool) \<Rightarrow>
    'p \<Rightarrow> 'q \<Rightarrow> bool" where
  "presentation_transport R S p q \<longleftrightarrow> (\<exists>a. R a p \<and> S a q)"

lemma presentation_transport_relation:
  "presentation_transport R S = presented_relation R S (=)"
  by (intro ext) (auto simp: presentation_transport_def presented_relation_def)

lemma presentation_transport_reverse:
  "presentation_transport R S p q \<longleftrightarrow> presentation_transport S R q p"
  by (auto simp: presentation_transport_def)

locale presentation_change =
  source: presentation_class R D A + target: presentation_class S D B
  for R :: "'a \<Rightarrow> 'p \<Rightarrow> bool" and D A
    and S :: "'a \<Rightarrow> 'q \<Rightarrow> bool" and B
begin

lemma at:
  assumes "R a p" "S b q"
  shows "presentation_transport R S p q \<longleftrightarrow> a=b"
  using assms source.recovery target.recovery
  by (auto simp: presentation_transport_def; blast)

lemma forward:
  assumes "R a p"
  shows "presentation_transport R S p q \<longleftrightarrow> S a q"
  using assms source.recovery by (auto simp: presentation_transport_def; blast)

lemma backward:
  assumes "S a q"
  shows "presentation_transport R S p q \<longleftrightarrow> R a p"
  using assms target.recovery by (auto simp: presentation_transport_def; blast)

theorem source_total:
  assumes "A p"
  shows "\<exists>q. presentation_transport R S p q"
  using source.admitted[OF assms] source.subject_boundary target.total
  by (auto simp: presentation_transport_def; blast)

theorem target_total:
  assumes "B q"
  shows "\<exists>p. presentation_transport R S p q"
  using target.admitted[OF assms] target.subject_boundary source.total
  by (auto simp: presentation_transport_def; blast)

lemma boundaries:
  assumes "presentation_transport R S p q"
  shows "A p \<and> B q"
  using assms source.presentation_boundary target.presentation_boundary
  by (auto simp: presentation_transport_def)

theorem predicate_transport:
  assumes "presentation_transport R S p q"
  shows "presented_predicate R P p \<longleftrightarrow> presented_predicate S P q"
  using assms source.recovery target.recovery
  by (auto simp: presentation_transport_def presented_predicate_def; blast)

theorem set_transport:
  "presented_set (presentation_transport R S) (presented_set R X) = presented_set S X"
  using source.recovery source.total target.subject_boundary
  by (auto simp: presented_set_def presentation_transport_def; blast)

end

theorem presentation_transport_identity:
  assumes "presentation_class R D A"
  shows "presentation_transport R R p p \<longleftrightarrow> A p"
  using presentation_class.admissible_iff[OF assms]
  by (auto simp: presentation_transport_def)

theorem presentation_transport_compose:
  assumes first: "presentation_class R D A" and middle: "presentation_class S D B"
  shows "(\<exists>q. presentation_transport R S p q \<and> presentation_transport S T q r)
    \<longleftrightarrow> presentation_transport R T p r"
proof -
  interpret first: presentation_class R D A by (rule first)
  interpret middle: presentation_class S D B by (rule middle)
  show ?thesis using first.subject_boundary middle.recovery middle.total
    by (auto simp: presentation_transport_def; blast)
qed

section \<open>Every relation transports through the same correspondence\<close>

theorem presented_relation_transport:
  assumes left: "presentation_class A D X" and left': "presentation_class A' D X'"
    and right: "presentation_class B E Y" and right': "presentation_class B' E Y'"
    and inputs: "presentation_transport A A' p p'" "presentation_transport B B' q q'"
  shows "presented_relation A B L p q \<longleftrightarrow> presented_relation A' B' L p' q'"
proof -
  interpret left: presentation_class A D X by (rule left)
  interpret left': presentation_class A' D X' by (rule left')
  interpret right: presentation_class B E Y by (rule right)
  interpret right': presentation_class B' E Y' by (rule right')
  show ?thesis using inputs left.recovery left'.recovery right.recovery right'.recovery
    by (auto simp: presentation_transport_def presented_relation_def; blast)
qed

theorem presented_relation_compose_across:
  assumes middle: "presentation_class B D X" and other: "presentation_class B' D X'"
  shows "(\<exists>q u. presented_relation A B L p q \<and> presentation_transport B B' q u \<and>
      presented_relation B' C M u r) \<longleftrightarrow>
    presented_relation A C (\<lambda>a c. \<exists>b. D b \<and> L a b \<and> M b c) p r"
proof -
  interpret middle: presentation_class B D X by (rule middle)
  interpret other: presentation_class B' D X' by (rule other)
  show ?thesis
  proof
    assume "\<exists>q u. presented_relation A B L p q \<and> presentation_transport B B' q u \<and>
      presented_relation B' C M u r"
    then obtain q u a b k h c where first: "A a p" "B b q" "L a b"
      and bridge: "B k q" "B' k u" and last: "B' h u" "C c r" "M h c"
      unfolding presentation_transport_def presented_relation_def by blast
    have same: "b=k" "k=h"
      using middle.recovery[OF first(2) bridge(1)] other.recovery[OF bridge(2) last(1)] by auto
    have domain: "D b" by (rule middle.subject_boundary[OF first(2)])
    show "presented_relation A C (\<lambda>a c. \<exists>b. D b \<and> L a b \<and> M b c) p r"
      using first last domain same unfolding presented_relation_def by blast
  next
    assume "presented_relation A C (\<lambda>a c. \<exists>b. D b \<and> L a b \<and> M b c) p r"
    then obtain a c b where parts: "A a p" "C c r" "D b" "L a b" "M b c"
      unfolding presented_relation_def by blast
    obtain q where first: "B b q" using middle.total[OF parts(3)] by blast
    obtain u where second: "B' b u" using other.total[OF parts(3)] by blast
    show "\<exists>q u. presented_relation A B L p q \<and> presentation_transport B B' q u \<and>
      presented_relation B' C M u r"
      by (rule exI[of _ q], rule exI[of _ u])
        (use parts first second in \<open>auto simp: presentation_transport_def presented_relation_def\<close>)
  qed
qed

section \<open>Specialization retains every presentation of the selected subjects\<close>

theorem presentation_transport_subdomain:
  assumes source: "presentation_class R D A"
  shows "presentation_transport (\<lambda>a p. E a \<and> R a p) (\<lambda>a q. E a \<and> S a q) p q
    \<longleftrightarrow> presentation_transport R S p q \<and> presented_predicate R E p"
proof -
  interpret source: presentation_class R D A by (rule source)
  show ?thesis using source.recovery
    by (auto simp: presentation_transport_def presented_predicate_def; blast)
qed

section \<open>Component correspondences compose without choosing representatives\<close>

lemma presentation_transport_product:
  "presentation_transport (\<lambda>z p. R (fst z) (fst p) \<and> S (snd z) (snd p))
      (\<lambda>z p. R' (fst z) (fst p) \<and> S' (snd z) (snd p)) (p,q) (p',q')
    \<longleftrightarrow> presentation_transport R R' p p' \<and> presentation_transport S S' q q'"
  by (auto simp: presentation_transport_def; metis fst_conv snd_conv)

lemma presentation_transport_lists:
  "presentation_transport (list_all2 R) (list_all2 S) ps qs \<longleftrightarrow>
    list_all2 (presentation_transport R S) ps qs"
proof (induction ps arbitrary: qs)
  case Nil
  then show ?case by (auto simp: presentation_transport_def list_all2_Nil2)
next
  case (Cons p ps)
  have tail: "presentation_transport (list_all2 R) (list_all2 S) ps us \<longleftrightarrow>
      list_all2 (presentation_transport R S) ps us" for us by (rule Cons.IH)
  have step: "presentation_transport (list_all2 R) (list_all2 S) (p#ps) (q#us) \<longleftrightarrow>
      presentation_transport R S p q \<and> presentation_transport (list_all2 R) (list_all2 S) ps us" for q us
    by (auto simp: presentation_transport_def list_all2_Cons2; blast)
  show ?case
  proof (cases qs)
    case Nil
    then show ?thesis by (auto simp: presentation_transport_def list_all2_Nil2)
  next
    case (Cons q us)
    then show ?thesis by (simp only: step tail list_all2_Cons)
  qed
qed

section \<open>Local recursive contracts give transport of the completed meanings\<close>

theorem presentation_transport_least_fixed_points:
  fixes F :: "'a set \<Rightarrow> 'a set"
    and G :: "'p set \<Rightarrow> 'p set" and H :: "'q set \<Rightarrow> 'q set"
  assumes source: "presentation_class R D A" and target: "presentation_class S D B"
    and semantic_mono: "mono F" and source_mono: "mono G" and target_mono: "mono H"
    and boundary: "\<And>X. X\<subseteq>{a. D a} \<Longrightarrow> F X\<subseteq>{a. D a}"
    and source_step: "\<And>X. X\<subseteq>{a. D a} \<Longrightarrow>
      G (presented_set R X)=presented_set R (F X)"
    and target_step: "\<And>X. X\<subseteq>{a. D a} \<Longrightarrow>
      H (presented_set S X)=presented_set S (F X)"
  shows "presented_set (presentation_transport R S) (lfp G)=lfp H"
proof -
  interpret change: presentation_change R D A S B by (rule presentation_change.intro[OF source target])
  have first: "lfp G=presented_set R (lfp F)"
    by (rule presented_least_fixed_point_on[OF semantic_mono source_mono boundary source_step])
  have second: "lfp H=presented_set S (lfp F)"
    by (rule presented_least_fixed_point_on[OF semantic_mono target_mono boundary target_step])
  show ?thesis by (simp only: first second change.set_transport)
qed

text \<open>
  The subject type and domain are fixed independently of a use. Two exact
  classes over that same domain supply a total correspondence in both
  directions. A correspondence contains every pair recovering the same
  subject. Its identity, reversal, composition, and relation laws therefore
  require no selected representative, matching raw syntax, or pair-specific
  semantic proof. Specialization restricts subjects and retains all their
  presentations; the existing subdomain class theorem supplies its coverage.

  This correspondence differs from composed_presentation: that construction
  recovers a complete intermediate presentation, as required by quotation.
  Correspondence instead allows intermediate material to vary while its
  independently fixed subject stays the same. The explicit reading relations
  remain part of the contract. Erasing their context does not give a sound
  union of overlapping raw grammars.

  The laws are mathematical transport contracts. Each actual reader establishes
  its own exact relation or consequence equation at the owning notion's
  boundary. These laws then transport its meaning uniformly. They do not
  compile arbitrary relations, execute a choice of representative, or change
  the actual body stored in a quoted source.
\<close>

end
