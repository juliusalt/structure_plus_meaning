theory Factor_Schema_Forests
  imports "Factor_Schema_Code"
begin

section \<open>Native recovery of independently scoped clause blocks\<close>

lemma schema_codes_forest_recovers:
  fixes E :: "local_address option artifact_environment"
  assumes lengths: "length rs = length Rs" "length As = length Rs" "length Ls = length Rs" "length Cs = length Rs"
    and codes: "\<forall>i<length Rs. schema_code (Rs!i) (rs!i) (As!i) (Ls!i) (Cs!i)"
    and ef: "environment_formed E" and target: "artifact_at E u T"
    and reads: "object_reads_agree (syntax_forest Rs) T (rra_carrier (object_structure (syntax_forest Rs)))"
    and refs: "syntax_references E u (syntax_forest_table Ls) (syntax_forest_table Cs)"
  shows "\<forall>i<length Rs. native_schema_at E u (syntax_branch i (rs!i))
    (rename_schema (syntax_branch i) (syntax_branch i) id (As!i))"
proof -
  have formed: "\<forall>R\<in>set Rs. exact_formed R"
  proof (intro ballI)
    fix R assume member: "R \<in> set Rs"
    obtain i where index: "i < length Rs" "R=Rs!i" using member by (metis in_set_conv_nth)
    have code: "schema_code (Rs!i) (rs!i) (As!i) (Ls!i) (Cs!i)" using codes index(1) by blast
    show "exact_formed R" using schema_code_properties(1)[OF code] index(2) by simp
  qed
  have counts: "\<forall>R\<in>set Rs. bag_count (object_data R) = (\<lambda>_. 0)"
  proof (intro ballI)
    fix R assume member: "R \<in> set Rs"
    obtain i where index: "i < length Rs" "R=Rs!i" using member by (metis in_set_conv_nth)
    have code: "schema_code (Rs!i) (rs!i) (As!i) (Ls!i) (Cs!i)" using codes index(1) by blast
    show "bag_count (object_data R) = (\<lambda>_. 0)" using schema_code_properties(2)[OF code] index(2) by simp
  qed
  show ?thesis
  proof (intro allI impI)
    fix i assume index: "i < length Rs"
    have code: "schema_code (Rs!i) (rs!i) (As!i) (Ls!i) (Cs!i)" using codes index by blast
    have dependencies: "schema_dependencies (As!i) \<subseteq> rel_ran (Cs!i)"
      using schema_code_properties(6)[OF code] by simp
    have li: "i < length Ls" and ci: "i < length Cs" using lengths index by simp_all
    have child_refs: "syntax_references E u (map_slot_keys (syntax_branch i) (Ls!i))
      (map_slot_keys (syntax_branch i) (Cs!i))"
      by (rule syntax_references_mono[OF refs syntax_forest_table_child[OF li] syntax_forest_table_child[OF ci]])
    have child_reads: "object_reads_agree (push_object (syntax_branch i) (Rs!i)) T
      (syntax_branch i ` rra_carrier (object_structure (Rs!i)))"
      by (rule object_reads_agree_extend[OF syntax_forest_child_reads[OF formed counts index] reads])
    show "native_schema_at E u (syntax_branch i (rs!i))
      (rename_schema (syntax_branch i) (syntax_branch i) id (As!i))"
      by (rule compiled_schema_copy[OF schema_code_properties(1,5,7)[OF code] dependencies ef target
          syntax_branch_injective syntax_branch_addressing[OF schema_code_properties(1)[OF code]]
          child_reads child_refs])
  qed
qed

theorem schema_forest_total:
  fixes Ss :: "('a,'s,local_address option definition_site) factor_schema list"
  assumes formed: "\<forall>S\<in>set Ss. schema_formed S"
    and addresses: "\<forall>S\<in>set Ss. \<forall>d\<in>schema_dependencies S. octets_formed (snd d)"
  shows "\<exists>R rs As L C. exact_formed R \<and> bag_count (object_data R) = (\<lambda>_. 0) \<and>
    length rs = length Ss \<and> length As = length Ss \<and> reference_table_formed L C \<and>
    rel_dom L \<union> rel_dom C \<subseteq> rra_carrier (object_structure R) \<and>
    rel_ran C = (\<Union>S\<in>set Ss. schema_dependencies S) \<and> set rs \<subseteq> rra_carrier (object_structure R) \<and>
    (\<forall>i<length Ss. schema_alpha_variant (Ss!i) (As!i)) \<and>
    (\<forall>E u. environment_formed E \<longrightarrow> artifact_at E u R \<longrightarrow>
      syntax_references E u L C \<longrightarrow>
      (\<forall>i<length Ss. native_schema_at E u (rs!i) (As!i)))"
proof -
  obtain Rs :: "exact_artifact list" and rs :: "local_address list"
    and As :: "local_address option native_schema list"
    and Ls :: "(local_address \<times> exact_artifact) set list"
    and Cs :: "(local_address \<times> local_address option definition_site) set list" where built:
    "length Rs = length Ss" "length rs = length Ss" "length As = length Ss"
    "length Ls = length Ss" "length Cs = length Ss"
    "\<forall>i<length Ss. schema_alpha_variant (Ss!i) (As!i) \<and> schema_code (Rs!i) (rs!i) (As!i) (Ls!i) (Cs!i)"
    using schema_code_list_total[OF formed addresses] by metis
  let ?R = "syntax_forest Rs"
  let ?rs = "map (\<lambda>i. syntax_branch i (rs!i)) [0..<length Ss]"
  let ?As = "map (\<lambda>i. rename_schema (syntax_branch i) (syntax_branch i) id (As!i)) [0..<length Ss]"
  let ?L = "syntax_forest_table Ls"
  let ?C = "syntax_forest_table Cs"
  have codes: "\<forall>i<length Rs. schema_code (Rs!i) (rs!i) (As!i) (Ls!i) (Cs!i)"
    using built(1,6) by simp
  have each_formed: "\<forall>R\<in>set Rs. exact_formed R"
    using codes schema_code_properties(1) by (metis in_set_conv_nth)
  have rf: "exact_formed ?R" by (rule syntax_forest_formed[OF each_formed])
  have profiles: "\<forall>i<length Ls. reference_table_formed (Ls!i) (Cs!i)"
    using built(1,4) codes schema_code_properties(4) by metis
  have lc_len: "length Ls = length Cs" using built(4,5) by simp
  have profile: "reference_table_formed ?L ?C" by (rule reference_table_forest[OF lc_len profiles])
  have ll: "length Ls = length Rs" and cl: "length Cs = length Rs" using built(1,4,5) by simp_all
  have lb: "\<forall>i<length Rs. rel_dom (Ls!i) \<subseteq> rra_carrier (object_structure (Rs!i))"
    and cb: "\<forall>i<length Rs. rel_dom (Cs!i) \<subseteq> rra_carrier (object_structure (Rs!i))"
    using codes schema_code_properties(5) by blast+
  have bounds: "rel_dom ?L \<union> rel_dom ?C \<subseteq> rra_carrier (object_structure ?R)"
    using syntax_forest_table_bounds[OF ll lb] syntax_forest_table_bounds[OF cl cb] by blast
  have dependencies: "\<forall>i<length Ss. rel_ran (Cs!i) = schema_dependencies (Ss!i)"
  proof (intro allI impI)
    fix i assume index: "i < length Ss"
    have alpha: "schema_alpha_variant (Ss!i) (As!i)"
      and code: "schema_code (Rs!i) (rs!i) (As!i) (Ls!i) (Cs!i)" using built(6) index by blast+
    show "rel_ran (Cs!i) = schema_dependencies (Ss!i)"
      using schema_code_properties(6)[OF code] schema_alpha_dependencies[OF alpha] by simp
  qed
  have mapped_dependencies: "map rel_ran Cs = map schema_dependencies Ss"
    using dependencies built(5) by (intro nth_equalityI) auto
  have ranges: "(\<Union>M\<in>set Cs. rel_ran M) = (\<Union>S\<in>set Ss. schema_dependencies S)"
  proof -
    have "(\<Union>M\<in>set Cs. rel_ran M) = \<Union>(set (map rel_ran Cs))" by simp
    also have "\<dots> = \<Union>(set (map schema_dependencies Ss))" by (simp only: mapped_dependencies)
    also have "\<dots> = (\<Union>S\<in>set Ss. schema_dependencies S)" by simp
    finally show ?thesis .
  qed
  have range: "rel_ran ?C = (\<Union>S\<in>set Ss. schema_dependencies S)"
    by (simp only: syntax_forest_table_range ranges)
  have roots: "set ?rs \<subseteq> rra_carrier (object_structure ?R)"
  proof
    fix a assume member: "a \<in> set ?rs"
    obtain i where index: "i < length Ss" "a=syntax_branch i (rs!i)" using member by auto
    have code: "schema_code (Rs!i) (rs!i) (As!i) (Ls!i) (Cs!i)" using built(6) index(1) by blast
    have small: "i < length Rs" using index(1) built(1) by simp
    show "a \<in> rra_carrier (object_structure ?R)"
      using syntax_forest_child_inside[OF small schema_code_properties(3)[OF code]] index(2) by simp
  qed
  have alpha: "\<forall>i<length Ss. schema_alpha_variant (Ss!i) (?As!i)"
  proof (intro allI impI)
    fix i assume index: "i < length Ss"
    have original: "schema_alpha_variant (Ss!i) (As!i)" using built(6) index by blast
    have copied: "schema_alpha_variant (Ss!i) (rename_schema (syntax_branch i) (syntax_branch i) id (As!i))"
      by (rule schema_alpha_copy[OF original syntax_branch_injective])
    show "schema_alpha_variant (Ss!i) (?As!i)" using copied index by simp
  qed
  have lengths: "length rs = length Rs" "length As = length Rs" "length Ls = length Rs" "length Cs = length Rs"
    using built(1-5) by simp_all
  have identity_reads: "object_reads_agree ?R ?R (rra_carrier (object_structure ?R))"
    by (simp add: object_reads_agree_def)
  have recover: "\<forall>E u. environment_formed E \<longrightarrow> artifact_at E u ?R \<longrightarrow>
    syntax_references E u ?L ?C \<longrightarrow> (\<forall>i<length Ss. native_schema_at E u (?rs!i) (?As!i))"
  proof (rule allI, rule allI, rule impI, rule impI, rule impI)
    fix E u assume ef: "environment_formed E" and source: "artifact_at E u ?R"
      and refs: "syntax_references E u ?L ?C"
    have reads: "\<forall>i<length Rs. native_schema_at E u (syntax_branch i (rs!i))
      (rename_schema (syntax_branch i) (syntax_branch i) id (As!i))"
      by (rule schema_codes_forest_recovers[OF lengths codes ef source identity_reads refs])
    show "\<forall>i<length Ss. native_schema_at E u (?rs!i) (?As!i)" using reads built(1) by simp
  qed
  show ?thesis by (rule exI[of _ ?R], rule exI[of _ ?rs], rule exI[of _ ?As], rule exI[of _ ?L], rule exI[of _ ?C])
    (use rf profile bounds range roots alpha recover in auto)
qed

text \<open>
  Every complete finite source clause list has a finite syntax forest. Its
  clauses retain their individual variable-sharing patterns, and all private
  scopes are copied disjointly. The forest recovers every corresponding native
  schema in the actual environment. Each schema is an injective binder and
  socket renaming of its source, and the combined callee set is exactly the
  union of the source dependencies, including for an empty clause list.
\<close>

end
