theory Factor_Observation_Clauses
  imports "Factor_Context_Filters" "Factor_Related_List_Maps" "Factor_List_Set_Presentations"
begin

section \<open>Membership and omission have the same complete data boundary\<close>

definition observation_member_schema :: "(nat,nat,nat) factor_schema" where
  "observation_member_schema=data_rule (Pattern_Pair data_x data_y)
    {(0,5,Pattern_Pair data_y (Pattern_Pair data_x data_z))}"

definition observation_absent_schema :: "(nat,nat,nat) factor_schema" where
  "observation_absent_schema=data_rule (Pattern_Pair data_x data_y)
    {(0,2,data_y),(1,132,Pattern_Pair data_y data_x)}"

definition observation_context_schema :: "(nat,nat,nat) factor_schema" where
  "observation_context_schema=data_rule (Pattern_Pair data_x data_y)
    {(0,4,data_x),(1,2,data_y)}"

section \<open>Every observation row retains its facet, candidate, and witness\<close>

definition observation_keep_schema :: "(nat,nat,nat) factor_schema" where
  "observation_keep_schema=data_rule
    (Pattern_Pair (Pattern_Pair data_x data_y) (Pattern_Pair data_z (Pattern_Pair data_y data_w)))
    {(0,303,Pattern_Pair data_x data_z),(1,2,data_y),(2,2,data_w)}"

definition observation_other_candidate_schema :: "(nat,nat,nat) factor_schema" where
  "observation_other_candidate_schema=data_rule
    (Pattern_Pair (Pattern_Pair data_x data_y)
      (Pattern_Pair data_z (Pattern_Pair data_w (Pattern_Variable 4))))
    {(0,4,data_x),(1,3,Pattern_Pair data_y data_w),(2,2,data_z),(3,2,Pattern_Variable 4)}"

definition observation_other_facet_schema :: "(nat,nat,nat) factor_schema" where
  "observation_other_facet_schema=data_rule
    (Pattern_Pair (Pattern_Pair data_x data_y)
      (Pattern_Pair data_z (Pattern_Pair data_w (Pattern_Variable 4))))
    {(0,304,Pattern_Pair data_x data_z),(1,2,data_y),(2,2,data_w),(3,2,Pattern_Variable 4)}"

definition observation_pair_schema :: "(nat,nat,nat) factor_schema" where
  "observation_pair_schema=data_rule
    (context_relation_pattern data_x (Pattern_Pair data_y (Pattern_Pair data_z data_w))
      (Pattern_Pair data_y data_w))
    {(0,2,data_y),(1,2,data_z),(2,2,data_w)}"

definition observation_profile_schema :: "(nat,nat,nat) factor_schema" where
  "observation_profile_schema=data_rule (context_relation_pattern data_x data_y data_z)
    {(0,298,context_relation_pattern data_x data_y data_w),
     (1,300,context_relation_pattern data_x data_w data_z)}"

definition observation_losses_schema :: "(nat,nat,nat) factor_schema" where
  "observation_losses_schema=data_rule
    (context_relation_pattern (Pattern_Pair data_x (Pattern_Pair data_y data_z)) data_w (Pattern_Variable 4))
    {(0,301,context_relation_pattern (Pattern_Pair data_x data_y) data_w (Pattern_Variable 5)),
     (1,301,context_relation_pattern (Pattern_Pair data_x data_z) data_w (Pattern_Variable 6)),
     (2,305,context_relation_pattern (Pattern_Variable 6) (Pattern_Variable 5) (Pattern_Variable 4))}"

lemmas observation_schema_defs=observation_member_schema_def observation_absent_schema_def
  observation_context_schema_def observation_keep_schema_def observation_other_candidate_schema_def
  observation_other_facet_schema_def observation_pair_schema_def observation_profile_schema_def observation_losses_schema_def

definition observation_clause_family :: "nat \<Rightarrow> (nat\<times>(nat,nat,nat) factor_schema) set" where
  "observation_clause_family d=(if d=295 then {(0,observation_context_schema)}
    else if d=296 then {(0,observation_keep_schema)}
    else if d=297 then {(0,observation_other_candidate_schema),(1,observation_other_facet_schema)}
    else if d=298 then context_filter_clauses 295 296 297 298
    else if d=299 then {(0,observation_pair_schema)}
    else if d=300 then related_list_clauses 299 300
    else if d=301 then {(0,observation_profile_schema)}
    else if d=303 then {(0,observation_member_schema)}
    else if d=304 then {(0,observation_absent_schema)}
    else if d=305 then context_filter_clauses 4 304 303 305
    else if d=306 then {(0,observation_losses_schema)} else {})"

section \<open>The complete ordinary group depends only on actual collection operations\<close>

definition observation_group_system :: "(nat,nat,nat,nat) schema_system" where
  "observation_group_system=\<lparr>
    system_interfaces={(d,data_x) |d. d\<in>{295,296,297,298,299,300,301,303,304,305,306}},
    system_clauses={((d,c),S). d\<in>{295,296,297,298,299,300,301,303,304,305,306} \<and>
      (c,S)\<in>observation_clause_family d}\<rparr>"

lemma observation_group_definitions [simp]:
  "system_definitions observation_group_system={295,296,297,298,299,300,301,303,304,305,306}"
  by (auto simp: observation_group_system_def system_definitions_def rel_dom_def)

lemma observation_group_interfaces [simp]:
  "(d,p)\<in>system_interfaces observation_group_system \<longleftrightarrow>
    d\<in>system_definitions observation_group_system \<and> p=data_x"
  by (simp only: observation_group_definitions; auto simp: observation_group_system_def)

lemma observation_group_clauses [simp]:
  "((d,c),S)\<in>system_clauses observation_group_system \<longleftrightarrow>
    d\<in>system_definitions observation_group_system \<and> (c,S)\<in>observation_clause_family d"
  by (simp only: observation_group_definitions; auto simp: observation_group_system_def)

lemma observation_group_formed_over:
  "schema_system_formed_over {2,3,4,5,132} observation_group_system"
proof -
  have finite: "finite (observation_clause_family d)" for d
    by (simp add: observation_clause_family_def context_filter_clauses_def related_list_clauses_def)
  have functional: "single_valued (observation_clause_family d)" for d
    by (auto simp: observation_clause_family_def context_filter_clauses_def related_list_clauses_def
      single_valued_def split: if_splits)
  have schemas: "schema_formed S \<and> schema_dependencies S\<subseteq>
      {2,3,4,5,132}\<union>system_definitions observation_group_system"
    if "(c,S)\<in>observation_clause_family d" for c S d
    using that by (auto simp: observation_clause_family_def observation_schema_defs
      context_filter_clauses_def context_filter_nil_schema_def context_filter_keep_schema_def
      context_filter_drop_schema_def related_list_clauses_def related_list_nil_schema_def related_list_step_schema_def
      schema_formed_def schema_dependencies_def single_valued_def rel_dom_def rel_ran_def octets_formed_def
      split: if_splits)
  show ?thesis
  proof (rule schema_system_formed_over_families[where D="{295,296,297,298,299,300,301,303,304,305,306}"
      and p="\<lambda>_. data_x" and C=observation_clause_family])
    show "system_interfaces observation_group_system=
      {(d,data_x) |d. d\<in>{295,296,297,298,299,300,301,303,304,305,306}}"
      by (simp add: observation_group_system_def)
    show "system_clauses observation_group_system=
      {((d,c),S). d\<in>{295,296,297,298,299,300,301,303,304,305,306} \<and> (c,S)\<in>observation_clause_family d}"
      by (simp add: observation_group_system_def)
    show "finite {295::nat,296,297,298,299,300,301,303,304,305,306}" by simp
    show "pattern_formed data_x" if "d\<in>{295::nat,296,297,298,299,300,301,303,304,305,306}" for d by simp
    show "finite (observation_clause_family d)" if "d\<in>{295,296,297,298,299,300,301,303,304,305,306}" for d
      by (rule finite)
    show "single_valued (observation_clause_family d)" if "d\<in>{295,296,297,298,299,300,301,303,304,305,306}" for d
      by (rule functional)
    show "schema_formed S \<and> schema_dependencies S\<subseteq>
      {2,3,4,5,132}\<union>{295,296,297,298,299,300,301,303,304,305,306}"
      if "d\<in>{295,296,297,298,299,300,301,303,304,305,306}" "(c,S)\<in>observation_clause_family d" for d c S
      using schemas[OF that(2)] by (simp only: observation_group_definitions)
  qed
qed

lemma observation_external_dependencies:
  "system_external_dependencies observation_group_system={2,3,4,5,132}"
proof -
  have bounded: "system_external_dependencies observation_group_system\<subseteq>{2,3,4,5,132}"
    by (rule system_external_dependencies_boundary[OF observation_group_formed_over])
  have reached: "e\<in>system_external_dependencies observation_group_system"
    if "((d,c),S)\<in>system_clauses observation_group_system" "e\<in>schema_dependencies S"
      "e\<notin>system_definitions observation_group_system" for d c S e
  proof -
    have member: "e\<in>(\<Union>row\<in>system_clauses observation_group_system. schema_dependencies (snd row))"
      by (rule UN_I[OF that(1)]) (use that(2) in simp)
    show ?thesis using member that(3) by (simp only: system_external_dependencies_clauses Diff_iff; blast)
  qed
  have two: "2\<in>system_external_dependencies observation_group_system"
    by (rule reached[where d=295 and c=0 and S=observation_context_schema])
      (auto simp: observation_clause_family_def observation_context_schema_def schema_dependencies_def rel_ran_image)
  have three: "3\<in>system_external_dependencies observation_group_system"
    by (rule reached[where d=297 and c=0 and S=observation_other_candidate_schema])
      (auto simp: observation_clause_family_def observation_other_candidate_schema_def schema_dependencies_def rel_ran_image)
  have four: "4\<in>system_external_dependencies observation_group_system"
    by (rule reached[where d=295 and c=0 and S=observation_context_schema])
      (auto simp: observation_clause_family_def observation_context_schema_def schema_dependencies_def rel_ran_image)
  have five: "5\<in>system_external_dependencies observation_group_system"
    by (rule reached[where d=303 and c=0 and S=observation_member_schema])
      (auto simp: observation_clause_family_def observation_member_schema_def schema_dependencies_def rel_ran_image)
  have absence: "132\<in>system_external_dependencies observation_group_system"
    by (rule reached[where d=304 and c=0 and S=observation_absent_schema])
      (auto simp: observation_clause_family_def observation_absent_schema_def schema_dependencies_def rel_ran_image)
  show ?thesis using bounded two three four five absence by blast
qed

definition observation_base_system :: "(nat,nat,nat,nat) schema_system" where
  "observation_base_system=rooted_system data_absence_system (system_external_dependencies observation_group_system)"

lemma observation_base_formed [simp]: "schema_system_formed observation_base_system"
  unfolding observation_base_system_def by (rule rooted_system_formed[OF data_absence_system_formed])

lemma observation_base_subdomain:
  "system_definitions observation_base_system\<subseteq>system_definitions data_absence_system"
  unfolding observation_base_system_def by (rule rooted_system_subdomain)

lemma observation_base_roots:
  "{2,3,4,5,132}\<subseteq>system_definitions observation_base_system"
  unfolding observation_base_system_def observation_external_dependencies
  by (rule rooted_system_roots[OF data_absence_system_formed]) auto

lemma observation_base_least:
  assumes "{2,3,4,5,132}\<subseteq>U" "system_dependency_closed data_absence_system U"
  shows "system_definitions observation_base_system\<subseteq>U"
  unfolding observation_base_system_def observation_external_dependencies
  by (rule rooted_system_least[OF data_absence_system_formed _ assms]) auto

lemma observation_base_call:
  "schema_call_formed observation_base_system d t \<longleftrightarrow>
    d\<in>system_definitions observation_base_system \<and> term_formed t"
  unfolding observation_base_system_def
  by (rule rooted_system_variable_calls[OF data_absence_system_formed data_absence_call])

interpretation observation_group: positive_definition_group observation_base_system observation_group_system
proof (rule positive_definition_group.intro)
  show "schema_system_formed observation_base_system" by simp
  show "schema_system_formed_over (system_definitions observation_base_system) observation_group_system"
    by (rule schema_system_formed_over_mono[OF observation_group_formed_over observation_base_roots])
  show "system_definitions observation_base_system\<inter>system_definitions observation_group_system={}"
    using observation_base_subdomain by auto
qed

definition observation_system :: "(nat,nat,nat,nat) schema_system" where
  "observation_system=system_union observation_base_system observation_group_system"

lemma observation_system_formed [simp]: "schema_system_formed observation_system"
  using observation_group.formed by (simp only: observation_system_def)

lemma observation_definitions [simp]:
  "system_definitions observation_system=system_definitions observation_base_system\<union>system_definitions observation_group_system"
  by (simp add: observation_system_def)

lemma observation_call:
  "schema_call_formed observation_system d t \<longleftrightarrow>
    d\<in>system_definitions observation_system \<and> term_formed t"
  unfolding observation_system_def
  by (rule observation_group.variable_calls[where D="system_definitions observation_group_system" and a=0,
    OF observation_base_call]) (simp only: observation_group_interfaces)

lemma observation_clause:
  assumes "d\<in>system_definitions observation_group_system"
  shows "((d,c),S)\<in>system_clauses observation_system \<longleftrightarrow> (c,S)\<in>observation_clause_family d"
  using observation_group.group_clauses[OF assms, of c S]
  by (simp only: observation_system_def observation_group_clauses; use assms in simp)

lemma observation_base_meaning:
  assumes "d\<in>{2,3,4,5,132}"
  shows "(d,t)\<in>positive_meaning observation_system \<longleftrightarrow> (d,t)\<in>positive_meaning data_absence_system"
proof -
  have member: "d\<in>system_definitions observation_base_system" using observation_base_roots assms by blast
  show ?thesis
    using observation_group.old_meaning[OF member, of t]
      rooted_system_meaning_at[OF data_absence_system_formed member[unfolded observation_base_system_def], of t]
    by (simp only: observation_system_def observation_base_system_def; blast)
qed

end
