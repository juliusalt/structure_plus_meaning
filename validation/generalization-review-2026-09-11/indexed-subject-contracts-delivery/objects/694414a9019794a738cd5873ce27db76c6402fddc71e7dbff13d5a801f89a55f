theory Factor_Root_Syntax
  imports "Factor_Reference_Forests" "Factor_Reference_Environments" "Factor_Packages"
begin

section \<open>A complete family of external occurrence citations\<close>

locale root_family_construction =
  fixes ds :: "'u definition_site list"
  assumes addresses: "\<forall>d\<in>set ds. octets_formed (snd d)"
begin

abbreviation children where "children \<equiv> map (\<lambda>d. external_occurrence_syntax (snd d)) ds"
abbreviation body where "body \<equiv> syntax_forest children"
abbreviation ports where "ports \<equiv> family_ports (length ds)"
abbreviation nodes where "nodes \<equiv> map (\<lambda>i. syntax_branch i []) [0..<length ds]"
abbreviation members where "members \<equiv> set (zip ports nodes)"
abbreviation tables where "tables \<equiv> map (\<lambda>d. {([4],d)}) ds"
abbreviation callees where "callees \<equiv> syntax_forest_table tables"
abbreviation framed where "framed \<equiv> family_wrapper body [] members"

lemma children_formed: "\<forall>R\<in>set children. exact_formed R"
  using addresses by (auto intro: external_occurrence_syntax_formed)

lemma children_counts: "\<forall>R\<in>set children. bag_count (object_data R) = (\<lambda>_. 0)"
  by (simp add: external_occurrence_syntax_properties(2))

lemma body_formed: "exact_formed body" by (rule syntax_forest_formed[OF children_formed])

lemma member_domain: "rel_dom members = set ports" by (rule zip_domain) simp
lemma member_range: "rel_ran members = set nodes" by (rule zip_range) simp

lemma nodes_inside: "set nodes \<subseteq> rra_carrier (object_structure body)"
proof
  fix a assume member: "a \<in> set nodes"
  obtain i where index: "i < length ds" "a=syntax_branch i []" using member by auto
  have small: "i < length children" using index(1) by simp
  have root: "[] \<in> rra_carrier (object_structure (children!i))"
    using index(1) by (simp add: external_occurrence_syntax_properties(1))
  show "a \<in> rra_carrier (object_structure body)"
    using syntax_forest_child_inside[OF small root] index(2) by simp
qed

lemma headers_fresh: "insert [] (rel_dom members) \<inter> rra_carrier (object_structure body) = {}"
  by (simp only: member_domain) (auto simp: family_ports_def)

lemma headers_separate: "[] \<notin> rel_dom members"
  by (simp only: member_domain) (auto simp: family_ports_def)

lemma member_addresses: "\<forall>a\<in>insert [] (rel_dom members \<union> rel_ran members). octets_formed a"
proof -
  have targets: "\<forall>a\<in>rel_ran members. octets_formed a"
    using nodes_inside body_formed by (auto simp: member_range exact_formed_def)
  show ?thesis using targets family_ports_formed[of "length ds"]
    by (simp only: member_domain) (auto simp: octets_formed_def)
qed

lemma formed: "exact_formed framed"
  by (rule family_wrapper_formed[OF body_formed _ member_addresses]) simp

lemma family_read: "family_at framed [] members"
  by (rule family_wrapper_fresh_recovers[OF body_formed formed _ _ headers_separate headers_fresh])
     (simp_all add: single_valued_zip)

lemma reads: "object_reads_agree body framed (rra_carrier (object_structure body))"
  by (rule family_wrapper_reads) (use headers_fresh in blast)

lemma reference_table: "reference_table_formed {} callees"
proof -
  let ?Ls = "replicate (length ds) ({} :: (local_address \<times> exact_artifact) set)"
  have singleton: "\<And>d. reference_table_formed ({} :: (local_address \<times> exact_artifact) set) {([4],d)}"
    by (rule reference_table_callees) (auto simp: single_valued_def)
  have len: "length ?Ls = length tables" by simp
  have each: "\<forall>i<length ?Ls. reference_table_formed (?Ls!i) (tables!i)" by (simp add: singleton)
  show ?thesis using reference_table_forest[OF len each] by simp
qed

lemma reference_bounds: "rel_dom callees \<subseteq> rra_carrier (object_structure framed)"
proof -
  have len: "length tables = length children" by simp
  have each: "\<forall>i<length children. rel_dom (tables!i) \<subseteq> rra_carrier (object_structure (children!i))"
    by (auto simp: external_occurrence_syntax_def rel_dom_def)
  have body_bound: "rel_dom callees \<subseteq> rra_carrier (object_structure body)"
    by (rule syntax_forest_table_bounds[OF len each])
  have inclusion: "rra_carrier (object_structure body) \<subseteq> rra_carrier (object_structure framed)"
    using reads by (simp add: object_reads_agree_def)
  show ?thesis by (rule subset_trans[OF body_bound inclusion])
qed

lemma reference_range: "rel_ran callees = set ds"
  by (simp only: syntax_forest_table_range) (auto simp: rel_ran_def)

lemma locations:
  assumes ef: "environment_formed E" and source: "artifact_at E u framed" and refs: "syntax_references E u {} callees"
  shows "\<forall>i<length ds. located_at E u (nodes!i) (fst (ds!i)) (snd (ds!i))"
proof (intro allI impI)
  fix i assume index: "i < length ds"
  let ?d = "ds!i"
  let ?R = "external_occurrence_syntax (snd ?d)"
  have address: "octets_formed (snd ?d)" using addresses nth_mem[OF index] by blast
  have rf: "exact_formed ?R" by (rule external_occurrence_syntax_formed[OF address])
  have original: "citation_at ?R [] (External [4] (snd ?d)) {[],[5]}"
    by (rule external_occurrence_syntax_recovers[OF address])
  have addressing: "finite_addressing (rra_carrier (object_structure ?R)) (syntax_branch i)"
    by (rule syntax_branch_addressing[OF rf])
  have copied: "citation_at (push_object (syntax_branch i) ?R) (syntax_branch i [])
    (External (syntax_branch i [4]) (snd ?d)) (syntax_branch i ` {[],[5]})"
    using citation_at_push[OF original addressing] by simp
  have small: "i < length children" using index by simp
  have child_reads: "object_reads_agree (push_object (syntax_branch i) ?R) body
    (syntax_branch i ` rra_carrier (object_structure ?R))"
    using syntax_forest_child_reads[OF children_formed children_counts small] index by simp
  have whole_reads: "object_reads_agree (push_object (syntax_branch i) ?R) framed
    (syntax_branch i ` rra_carrier (object_structure ?R))"
    by (rule object_reads_agree_extend[OF child_reads reads])
  have interior: "syntax_branch i ` {[],[5]} \<subseteq> syntax_branch i ` rra_carrier (object_structure ?R)"
    by (rule image_mono) (simp add: external_occurrence_syntax_def)
  have citation_reads: "object_reads_agree (push_object (syntax_branch i) ?R) framed (syntax_branch i ` {[],[5]})"
    by (rule object_reads_agree_mono[OF whole_reads interior])
  have citation: "citation_at framed (syntax_branch i []) (External (syntax_branch i [4]) (snd ?d))
    (syntax_branch i ` {[],[5]})"
    by (rule citation_at_read_transport[OF copied formed citation_reads])
  have ti: "i < length tables" using index by simp
  have entry: "([4],?d) \<in> tables!i" using index by simp
  have reference: "(syntax_branch i [4],?d) \<in> callees" by (rule syntax_forest_table_member[OF ti entry])
  have actual: "binds_slot E u (syntax_branch i [4]) (fst ?d) \<and>
    (\<exists>T. artifact_at E (fst ?d) T \<and> anchor_formed (T,snd ?d))"
    using refs reference unfolding syntax_references_def by blast
  have location: "citation_location E u (External (syntax_branch i [4]) (snd ?d)) (fst ?d) (snd ?d)"
    using actual by simp
  have located: "located_at E u (syntax_branch i []) (fst ?d) (snd ?d)"
    using source citation location unfolding located_at_def by blast
  show "located_at E u (nodes!i) (fst ?d) (snd ?d)" using located index by simp
qed

theorem recovers:
  assumes ef: "environment_formed E" and source: "artifact_at E u framed" and refs: "syntax_references E u {} callees"
  shows "native_root_family_at E u [] (set (zip ports ds))"
proof -
  have finite: "finite (set (zip ports ds))" by simp
  have functional: "single_valued (set (zip ports ds))" by (rule single_valued_zip) simp
  have domain: "rel_dom (set (zip ports ds)) = rel_dom members"
    using zip_domain[of ports ds] member_domain by simp
  have each: "\<forall>s a. (s,a) \<in> members \<longrightarrow>
    (\<exists>d. (s,d) \<in> set (zip ports ds) \<and> located_at E u a (fst d) (snd d))"
  proof (intro allI impI)
    fix s a assume entry: "(s,a) \<in> members"
    obtain i where index: "i < length ports" "i < length nodes" "s=ports!i" "a=nodes!i"
      using entry by (auto simp: in_set_zip)
    have small: "i < length ds" using index(1) by simp
    have target: "(s,ds!i) \<in> set (zip ports ds)" using index(1,3) small by (auto simp: in_set_zip)
    have located: "located_at E u a (fst (ds!i)) (snd (ds!i))"
      using locations[OF ef source refs] small index(4) by blast
    show "\<exists>d. (s,d) \<in> set (zip ports ds) \<and> located_at E u a (fst d) (snd d)"
      using target located by blast
  qed
  show ?thesis using ef source family_read finite functional domain each unfolding native_root_family_at_def by blast
qed

end

theorem root_family_syntax_total:
  assumes "\<forall>d\<in>set ds. octets_formed (snd d)"
  shows "\<exists>R C. exact_formed R \<and> reference_table_formed {} C \<and>
    rel_dom C \<subseteq> rra_carrier (object_structure R) \<and> rel_ran C = set ds \<and>
    (\<forall>E u. environment_formed E \<longrightarrow> artifact_at E u R \<longrightarrow> syntax_references E u {} C \<longrightarrow>
      native_root_family_at E u [] (set (zip (family_ports (length ds)) ds)))"
proof -
  interpret construction: root_family_construction ds by (rule root_family_construction.intro[OF assms])
  show ?thesis by (rule exI[of _ construction.framed], rule exI[of _ construction.callees])
    (use construction.formed construction.reference_table construction.reference_bounds construction.reference_range construction.recovers in blast)
qed

text \<open>
  Every finite list of target sites has a complete structural citation family.
  The family recovers actual target uses and addresses from its environment,
  while every reference slot has a source citation. The empty list produces
  an empty native root family. No definition names or semantic tags are stored.
\<close>

end
