theory Factor_Observation_Scope_Presentations
  imports "Factor_Observation_Scope_Rows"
begin

section \<open>Declared scopes and their table have one complete product boundary\<close>

abbreviation observation_scopes_presents where
  "observation_scopes_presents \<equiv> factor_pair_presents observation_facets_presents
    (factor_pair_presents observation_facets_presents observation_facets_presents)"

abbreviation observation_scope_record_presents where
  "observation_scope_record_presents \<equiv> factor_pair_presents observation_scopes_presents observation_table_presents"

abbreviation observation_scopes_domain where
  "observation_scopes_domain z \<equiv> observation_facets_domain (fst z) \<and>
    observation_facets_domain (fst (snd z)) \<and> observation_facets_domain (snd (snd z))"

abbreviation observation_scope_record_domain where
  "observation_scope_record_domain z \<equiv>
    observation_scopes_domain (fst z) \<and> observation_table_domain (snd z)"

abbreviation observation_scope_domain where
  "observation_scope_domain z \<equiv> observation_scope_subject_formed (fst (fst z))
    (fst (snd (fst z))) (snd (snd (fst z))) (snd z)"

abbreviation observation_scope_presents where
  "observation_scope_presents z t \<equiv> observation_scope_domain z \<and> observation_scope_record_presents z t"

lemma observation_scopes_class:
  "presentation_class observation_scopes_presents observation_scopes_domain
    (\<lambda>p. \<exists>z. observation_scopes_presents z p)"
proof -
  have source: "presentation_class observation_scopes_presents observation_scopes_domain
      (\<lambda>p. \<exists>x y. (\<exists>C. observation_facets_presents C x) \<and>
        (\<exists>u f. (\<exists>U. observation_facets_presents U u) \<and>
          (\<exists>F. observation_facets_presents F f) \<and> y=Pair_Term u f) \<and> p=Pair_Term x y)"
    by (rule factor_pair_class[OF observation_facets_class
      factor_pair_class[OF observation_facets_class observation_facets_class]])
  show ?thesis by (rule presentation_class.recovered_admission[OF source])
qed

lemma observation_scope_record_class:
  "presentation_class observation_scope_record_presents observation_scope_record_domain
    (\<lambda>p. \<exists>z. observation_scope_record_presents z p)"
proof -
  have source: "presentation_class observation_scope_record_presents observation_scope_record_domain
      (\<lambda>p. \<exists>x y. (\<exists>z. observation_scopes_presents z x) \<and>
        (\<exists>T. observation_table_presents T y) \<and> p=Pair_Term x y)"
    by (rule factor_pair_class[OF observation_scopes_class observation_table_class])
  show ?thesis by (rule presentation_class.recovered_admission[OF source])
qed

interpretation observation_scope_records: presentation_class observation_scope_record_presents
  observation_scope_record_domain "\<lambda>p. \<exists>z. observation_scope_record_presents z p"
  by (rule observation_scope_record_class)

theorem observation_scope_class:
  "presentation_class observation_scope_presents observation_scope_domain
    (\<lambda>p. \<exists>z. observation_scope_presents z p)"
  by (rule presentation_class_subdomain[OF observation_scope_record_class])
    (auto simp: observation_scope_subject_formed_def)

lemma observation_scopes_fields:
  assumes "observation_scopes_presents (C,(U,F)) p"
  obtains cs us fs where "data_elements cs" "data_elements us" "data_elements fs"
    "fset_of_list cs=C" "fset_of_list us=U" "fset_of_list fs=F"
    "p=observation_scope_context (data_list_term cs) (data_list_term us) (data_list_term fs)"
proof -
  obtain cp uf where outer: "observation_facets_presents C cp"
    "factor_pair_presents observation_facets_presents observation_facets_presents (U,F) uf"
    "p=Pair_Term cp uf"
    using assms by (simp only: factor_pair_presents_def fst_conv snd_conv) blast
  obtain up fp where inner: "observation_facets_presents U up" "observation_facets_presents F fp"
    "uf=Pair_Term up fp"
    using outer(2) by (simp only: factor_pair_presents_def fst_conv snd_conv) blast
  obtain cs where cs: "data_elements cs" "fset_of_list cs=C" "cp=data_list_term cs"
    using outer(1) by (simp only: observation_facets_fields) blast
  obtain us where us: "data_elements us" "fset_of_list us=U" "up=data_list_term us"
    using inner(1) by (simp only: observation_facets_fields) blast
  obtain fs where fs: "data_elements fs" "fset_of_list fs=F" "fp=data_list_term fs"
    using inner(2) by (simp only: observation_facets_fields) blast
  show ?thesis by (rule that[OF cs(1) us(1) fs(1) cs(2) us(2) fs(2)])
    (simp only: outer(3) inner(3) cs(3) us(3) fs(3))
qed

lemma observation_scope_record_fields:
  assumes "observation_scope_record_presents ((C,(U,F)),T) p"
  obtains cs us fs rows where "data_elements cs" "data_elements us" "data_elements fs"
    "observation_rows_data rows" "fset_of_list cs=C" "fset_of_list us=U" "fset_of_list fs=F"
    "fset_of_list rows=T" "p=observation_scope_argument (data_list_term cs) (data_list_term us)
      (data_list_term fs) (data_list_term (map observation_row_term rows))"
proof -
  obtain ctx table where outer: "observation_scopes_presents (C,(U,F)) ctx"
    "observation_table_presents T table" "p=Pair_Term ctx table"
    using assms by (simp only: factor_pair_presents_def fst_conv snd_conv) blast
  obtain cs us fs where ctx_fields: "data_elements cs" "data_elements us" "data_elements fs"
    "fset_of_list cs=C" "fset_of_list us=U" "fset_of_list fs=F"
    "ctx=observation_scope_context (data_list_term cs) (data_list_term us) (data_list_term fs)"
    by (rule observation_scopes_fields[OF outer(1)]) blast
  obtain rows where table: "observation_rows_data rows" "fset_of_list rows=T"
    "table=data_list_term (map observation_row_term rows)"
    using outer(2) by (simp only: observation_table_fields) blast
  show ?thesis by (rule that[OF ctx_fields(1-3) table(1) ctx_fields(4-6) table(2)])
    (simp only: outer(3) ctx_fields(7) table(3))
qed

lemma observation_scope_record_enumeration:
  assumes "data_elements cs" "data_elements us" "data_elements fs" "observation_rows_data rows"
  shows "observation_scope_record_presents
    ((fset_of_list cs,(fset_of_list us,fset_of_list fs)),fset_of_list rows)
    (observation_scope_argument (data_list_term cs) (data_list_term us)
      (data_list_term fs) (data_list_term (map observation_row_term rows)))"
proof -
  have cs: "observation_facets_presents (fset_of_list cs) (data_list_term cs)"
    by (simp only: observation_facets_fields; rule exI[of _ cs]) (use assms(1) in simp)
  have us: "observation_facets_presents (fset_of_list us) (data_list_term us)"
    by (simp only: observation_facets_fields; rule exI[of _ us]) (use assms(2) in simp)
  have fs: "observation_facets_presents (fset_of_list fs) (data_list_term fs)"
    by (simp only: observation_facets_fields; rule exI[of _ fs]) (use assms(3) in simp)
  have rows: "observation_table_presents (fset_of_list rows) (data_list_term (map observation_row_term rows))"
    by (simp only: observation_table_fields; rule exI[of _ rows]) (use assms(4) in simp)
  show ?thesis using cs us fs rows by (auto simp: factor_pair_presents_def)
qed

text \<open>
  The context and table use the existing complete finite-set and product
  classes. The independent scope predicate restricts that complete record.
  It introduces no preferred enumeration: every order and every repeated
  occurrence of a displayed member remains a presentation of the same input.
\<close>

end
