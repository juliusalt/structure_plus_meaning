theory Factor_Artifact_Comparison
  imports "Factor_Bag_Comparison" "Factor_Artifact_Values"
begin

section \<open>Equality of complete artifact presentations\<close>

lemma injective_mapped_multisets:
  assumes injective: "inj f"
  shows "mset (map f xs)=mset (map f ys) \<longleftrightarrow> mset xs=mset ys"
proof
  assume same: "mset (map f xs)=mset (map f ys)"
  have inverse: "map (inv f) (map f zs)=zs" for zs
    by (simp add: map_map comp_def inv_f_f[OF injective])
  have "image_mset (inv f) (mset (map f xs))=image_mset (inv f) (mset (map f ys))"
    using same by simp
  then show "mset xs=mset ys" by (simp only: mset_map[symmetric] inverse)
next
  assume "mset xs=mset ys"
  then show "mset (map f xs)=mset (map f ys)" by simp
qed

theorem artifact_enumeration_multisets:
  assumes left: "artifact_enumeration R A E B F"
    and right: "artifact_enumeration S A' E' B' F'"
  shows "R=S \<longleftrightarrow> mset A=mset A' \<and> mset E=mset E' \<and> mset B=mset B' \<and> mset F=mset F'"
proof -
  have distinct: "distinct A" "distinct A'" "distinct E" "distinct E'" "distinct F" "distinct F'"
    using left right by (auto simp: artifact_enumeration_def)
  have sources: "R=enumerated_artifact A E B F" "S=enumerated_artifact A' E' B' F'"
    using left right by (auto simp: artifact_enumeration_def)
  have same: "R=S \<longleftrightarrow> set A=set A' \<and> set E=set E' \<and> count_list B=count_list B' \<and> set F=set F'"
    by (simp add: sources exact_identity_iff rra_identity basis_identity enumerated_artifact_def)
  have counts: "count_list B=count_list B' \<longleftrightarrow> mset B=mset B'"
    by (simp add: fun_eq_iff multiset_eq_iff count_mset)
  show ?thesis by (simp only: same counts set_eq_iff_mset_eq_distinct[OF distinct(1,2)]
    set_eq_iff_mset_eq_distinct[OF distinct(3,4)] set_eq_iff_mset_eq_distinct[OF distinct(5,6)])
qed

abbreviation artifact_fields_term ::
  "factor_term \<Rightarrow> factor_term \<Rightarrow> factor_term \<Rightarrow> factor_term \<Rightarrow> factor_term" where
  "artifact_fields_term a e b f \<equiv> Pair_Term a (Pair_Term e (Pair_Term b f))"

definition artifact_comparison_schema :: "(nat,nat,nat) factor_schema" where
  "artifact_comparison_schema=data_rule
    (Pattern_Pair
      (Pattern_Pair (Pattern_Variable 0) (Pattern_Pair (Pattern_Variable 1)
        (Pattern_Pair (Pattern_Variable 2) (Pattern_Variable 3))))
      (Pattern_Pair (Pattern_Variable 4) (Pattern_Pair (Pattern_Variable 5)
        (Pattern_Pair (Pattern_Variable 6) (Pattern_Variable 7)))))
    {(0,6,Pattern_Pair (Pattern_Variable 0) (Pattern_Variable 4)),
     (1,6,Pattern_Pair (Pattern_Variable 1) (Pattern_Variable 5)),
     (2,6,Pattern_Pair (Pattern_Variable 2) (Pattern_Variable 6)),
     (3,6,Pattern_Pair (Pattern_Variable 3) (Pattern_Variable 7))}"

definition artifact_comparison_system :: "(nat,nat,nat,nat) schema_system" where
  "artifact_comparison_system=add_view_definition bag_comparison_system 7 data_x {(0,artifact_comparison_schema)}"

interpretation artifact_comparison_view: positive_view bag_comparison_system 7 data_x "{(0,artifact_comparison_schema)}"
  by (rule positive_view.intro)
    (auto simp: artifact_comparison_schema_def schema_formed_def schema_dependencies_def
      single_valued_def rel_dom_def rel_ran_def)

lemma artifact_comparison_system_formed [simp]: "schema_system_formed artifact_comparison_system"
  using artifact_comparison_view.formed by (simp only: artifact_comparison_system_def)

lemma artifact_comparison_definitions [simp]:
  "system_definitions artifact_comparison_system={0,1,2,3,4,5,6,7}"
  by (auto simp: artifact_comparison_system_def)

lemma artifact_comparison_call:
  "schema_call_formed artifact_comparison_system 7 t \<longleftrightarrow> term_formed t"
  using artifact_comparison_view.view_call[of t] by (simp add: artifact_comparison_system_def)

theorem artifact_comparison_old_meaning:
  assumes "d\<in>{0,1,2,3,4,5,6}"
  shows "(d,t)\<in>positive_meaning artifact_comparison_system \<longleftrightarrow>
    (d,t)\<in>positive_meaning bag_comparison_system"
  using artifact_comparison_view.old_meaning[of d t] assms by (simp add: artifact_comparison_system_def)

lemma artifact_comparison_clause [simp]:
  "((7,c),S)\<in>system_clauses artifact_comparison_system \<longleftrightarrow> c=0 \<and> S=artifact_comparison_schema"
  using artifact_comparison_view.no_old_clause[of c S] by (auto simp: artifact_comparison_system_def)

theorem artifact_comparison_fields:
  "(7,Pair_Term (artifact_fields_term a e b f) (artifact_fields_term a' e' b' f'))
    \<in>positive_meaning artifact_comparison_system \<longleftrightarrow>
    (6,Pair_Term a a')\<in>positive_meaning bag_comparison_system \<and>
    (6,Pair_Term e e')\<in>positive_meaning bag_comparison_system \<and>
    (6,Pair_Term b b')\<in>positive_meaning bag_comparison_system \<and>
    (6,Pair_Term f f')\<in>positive_meaning bag_comparison_system"
proof
  assume holds: "(7,Pair_Term (artifact_fields_term a e b f) (artifact_fields_term a' e' b' f'))
    \<in>positive_meaning artifact_comparison_system"
  have consequence: "(7,Pair_Term (artifact_fields_term a e b f) (artifact_fields_term a' e' b' f'))
    \<in>schema_consequences artifact_comparison_system (positive_meaning artifact_comparison_system)"
    using holds positive_meaning_unfold[of artifact_comparison_system] by blast
  obtain c S v where clause: "((7,c),S)\<in>system_clauses artifact_comparison_system"
    and head: "Pair_Term (artifact_fields_term a e b f) (artifact_fields_term a' e' b' f')=
      evaluate_pattern v (schema_conclusion S)"
    and support: "\<forall>s d p. (s,d,p)\<in>schema_premises S \<longrightarrow>
      (d,evaluate_pattern v p)\<in>positive_meaning artifact_comparison_system"
    using schema_consequences_valuationD[OF consequence] by blast
  have schema: "S=artifact_comparison_schema" using clause by simp
  have fields: "v 0=a" "v 1=e" "v 2=b" "v 3=f" "v 4=a'" "v 5=e'" "v 6=b'" "v 7=f'"
    using head by (auto simp: schema artifact_comparison_schema_def)
  show "(6,Pair_Term a a')\<in>positive_meaning bag_comparison_system \<and>
    (6,Pair_Term e e')\<in>positive_meaning bag_comparison_system \<and>
    (6,Pair_Term b b')\<in>positive_meaning bag_comparison_system \<and>
    (6,Pair_Term f f')\<in>positive_meaning bag_comparison_system"
    using support artifact_comparison_old_meaning[of 6]
    by (auto simp: schema artifact_comparison_schema_def fields[simplified])
next
  assume comparisons: "(6,Pair_Term a a')\<in>positive_meaning bag_comparison_system \<and>
    (6,Pair_Term e e')\<in>positive_meaning bag_comparison_system \<and>
    (6,Pair_Term b b')\<in>positive_meaning bag_comparison_system \<and>
    (6,Pair_Term f f')\<in>positive_meaning bag_comparison_system"
  have formed: "term_formed a" "term_formed e" "term_formed b" "term_formed f"
    "term_formed a'" "term_formed e'" "term_formed b'" "term_formed f'"
    using comparisons by (auto dest: positive_meaning_formed simp: bag_comparison_call)
  have lifted: "(6,Pair_Term a a')\<in>positive_meaning artifact_comparison_system"
    "(6,Pair_Term e e')\<in>positive_meaning artifact_comparison_system"
    "(6,Pair_Term b b')\<in>positive_meaning artifact_comparison_system"
    "(6,Pair_Term f f')\<in>positive_meaning artifact_comparison_system"
    using comparisons artifact_comparison_old_meaning[of 6] by auto
  let ?v="\<lambda>i::nat. if i=0 then a else if i=1 then e else if i=2 then b else if i=3 then f
    else if i=4 then a' else if i=5 then e' else if i=6 then b' else f'"
  have result: "(7,evaluate_pattern ?v (schema_conclusion artifact_comparison_schema))
    \<in>positive_meaning artifact_comparison_system"
    by (rule ordinary_positive_valuation_step[where c=0])
      (use formed lifted in \<open>auto simp: artifact_comparison_schema_def schema_variables_def artifact_comparison_call\<close>)
  show "(7,Pair_Term (artifact_fields_term a e b f) (artifact_fields_term a' e' b' f'))
    \<in>positive_meaning artifact_comparison_system"
    using result by (simp add: artifact_comparison_schema_def)
qed

theorem artifact_comparison_exact:
  assumes left: "artifact_value_presents R x" and right: "artifact_value_presents S y"
  shows "(7,Pair_Term x y)\<in>positive_meaning artifact_comparison_system \<longleftrightarrow> R=S"
proof -
  obtain A E B F where first: "artifact_enumeration R A E B F" "x=artifact_data_term A E B F"
    using left unfolding artifact_value_presents_def by blast
  obtain A' E' B' F' where second: "artifact_enumeration S A' E' B' F'" "y=artifact_data_term A' E' B' F'"
    using right unfolding artifact_value_presents_def by blast
  have fields: "data_elements (map Payload_Term A)" "data_elements (map incidence_data E)"
    "data_elements (map address_pair_data B)" "data_elements (map address_pair_data F)"
    "data_elements (map Payload_Term A')" "data_elements (map incidence_data E')"
    "data_elements (map address_pair_data B')" "data_elements (map address_pair_data F')"
    using artifact_data_term_formed[OF first(1)] artifact_data_term_formed[OF second(1)]
      artifact_data_term_self_contained[of A E B F] artifact_data_term_self_contained[of A' E' B' F']
    by (auto simp: artifact_data_term_def data_list_term_formed data_list_term_self_contained)
  have payload_injective: "inj Payload_Term" by (rule injI) simp
  have comparison: "(7,Pair_Term x y)\<in>positive_meaning artifact_comparison_system \<longleftrightarrow>
    mset A=mset A' \<and> mset E=mset E' \<and> mset B=mset B' \<and> mset F=mset F'"
    using fields
    by (simp only: first(2) second(2) artifact_data_term_def artifact_comparison_fields bag_comparison_lists
      injective_mapped_multisets[OF payload_injective]
      injective_mapped_multisets[OF incidence_data_injective]
      injective_mapped_multisets[OF address_pair_data_injective]; blast)
  show ?thesis using comparison artifact_enumeration_multisets[OF first(1) second(1)] by blast
qed

corollary artifact_comparison_presentation_invariance:
  assumes "artifact_value_presents R x" "artifact_value_presents R x'"
    "artifact_value_presents S y" "artifact_value_presents S y'"
  shows "(7,Pair_Term x y)\<in>positive_meaning artifact_comparison_system \<longleftrightarrow>
    (7,Pair_Term x' y')\<in>positive_meaning artifact_comparison_system"
  using artifact_comparison_exact[OF assms(1,3)] artifact_comparison_exact[OF assms(2,4)] by blast

theorem native_artifact_comparison:
  "\<exists>E :: local_address option artifact_environment. \<exists>pu Q d. closed_native_package_at E pu [] Q \<and>
    (\<forall>R S x y. artifact_value_presents R x \<longrightarrow> artifact_value_presents S y \<longrightarrow>
      (\<exists>F au I K. environment_formed F \<and> environment_included E F \<and> au\<notin>environment_uses E \<and>
        native_package_at F pu [] Q \<and> native_application_at F au [] d (Pair_Term x y) I K \<and>
        native_package_environment F pu []=E \<and> native_application_formed F pu [] au [] \<and>
        (native_positive_holds F pu [] au [] \<longleftrightarrow> R=S)))"
proof -
  obtain g :: "nat \<Rightarrow> local_address option definition_site"
    and E :: "local_address option artifact_environment" and pu Q
    where closed: "closed_native_package_at E pu [] Q"
    and future: "\<forall>d\<in>system_definitions artifact_comparison_system. \<forall>t. term_formed t \<longrightarrow>
      (\<exists>F au I K. environment_formed F \<and> environment_included E F \<and> au\<notin>environment_uses E \<and>
        native_package_at F pu [] Q \<and> native_application_at F au [] (g d) t I K \<and>
        native_package_environment F pu []=E \<and>
        (native_application_formed F pu [] au [] \<longleftrightarrow> schema_call_formed artifact_comparison_system d t) \<and>
        (native_positive_holds F pu [] au [] \<longleftrightarrow> (d,t)\<in>positive_meaning artifact_comparison_system) \<and>
        (\<forall>v\<in>environment_uses E. \<forall>R. artifact_at F v R \<longleftrightarrow> artifact_at E v R) \<and>
        (\<forall>v\<in>environment_uses E. \<forall>k w. binds_slot F v k w \<longleftrightarrow> binds_slot E v k w))"
    using compiled_program_future_applications[OF artifact_comparison_system_formed] by blast
  have member: "7\<in>system_definitions artifact_comparison_system" by simp
  show ?thesis
  proof (rule exI[of _ E], rule exI[of _ pu], rule exI[of _ Q], rule exI[of _ "g 7"], intro conjI allI impI)
    show "closed_native_package_at E pu [] Q" by (rule closed)
  next
    fix R S x y assume left: "artifact_value_presents R x" and right: "artifact_value_presents S y"
    have tf: "term_formed (Pair_Term x y)"
      using artifact_value_presents_formed[OF left] artifact_value_presents_formed[OF right] by simp
    obtain F au I K where parts: "environment_formed F" "environment_included E F" "au\<notin>environment_uses E"
      "native_package_at F pu [] Q" "native_application_at F au [] (g 7) (Pair_Term x y) I K"
      "native_package_environment F pu []=E"
      "native_application_formed F pu [] au [] \<longleftrightarrow> schema_call_formed artifact_comparison_system 7 (Pair_Term x y)"
      "native_positive_holds F pu [] au [] \<longleftrightarrow> (7,Pair_Term x y)\<in>positive_meaning artifact_comparison_system"
      using future[rule_format, OF member tf] by blast
    show "\<exists>F au I K. environment_formed F \<and> environment_included E F \<and> au\<notin>environment_uses E \<and>
      native_package_at F pu [] Q \<and> native_application_at F au [] (g 7) (Pair_Term x y) I K \<and>
      native_package_environment F pu []=E \<and> native_application_formed F pu [] au [] \<and>
      (native_positive_holds F pu [] au [] \<longleftrightarrow> R=S)"
      by (rule exI[of _ F], rule exI[of _ au], rule exI[of _ I], rule exI[of _ K])
        (use parts tf artifact_comparison_exact[OF left right]
          in \<open>auto simp: artifact_comparison_call\<close>)
  qed
qed

text \<open>
  One ordinary definition compares the four supplied artifact fields through
  four separately identified calls to the bag program. The exact-identity
  theorem covers every complete presentation of both artifacts. Set fields
  have distinct source entries; their bag comparisons therefore recover set
  equality. The counted field retains all repetitions. The address, incidence,
  and attachment encodings are injective, so no original coordinate or opaque
  value is identified with a different one.

  This comparison gives exact artifact equality, including across different
  enumeration orders. It does not identify readdressed isomorphic artifacts.
  Its four-field rule is not an artifact-admission checker: the theorem assumes
  complete formed artifact presentations, and other proper data-field tuples
  can satisfy the displayed rule. All old meanings remain fixed. A single
  closed native program serves every future pair of presented artifacts.
\<close>

end
