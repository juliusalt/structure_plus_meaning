theory Factor_Bag_Comparison
  imports "Factor_Data_Comparison"
begin

section \<open>Complete lists and removal of one occurrence\<close>

abbreviation data_elements :: "factor_term list \<Rightarrow> bool" where
  "data_elements xs \<equiv> \<forall>x\<in>set xs. term_formed x \<and> self_contained_term x"

definition data_list_nil_schema :: "(nat,nat,nat) factor_schema" where
  "data_list_nil_schema=data_rule (Pattern_Payload []) {}"

definition list_step_schema :: "nat \<Rightarrow> nat \<Rightarrow> (nat,nat,nat) factor_schema" where
  "list_step_schema element list=data_rule (Pattern_Pair data_x data_y)
    {(0,element,data_x),(1,list,data_y)}"

definition data_list_cons_schema :: "(nat,nat,nat) factor_schema" where
  "data_list_cons_schema=list_step_schema 2 4"

definition data_list_clauses :: "(nat \<times> (nat,nat,nat) factor_schema) set" where
  "data_list_clauses={(0,data_list_nil_schema),(1,data_list_cons_schema)}"

definition data_list_system :: "(nat,nat,nat,nat) schema_system" where
  "data_list_system=add_view_definition data_comparison_system 4 data_x data_list_clauses"

definition data_selection_here_schema :: "(nat,nat,nat) factor_schema" where
  "data_selection_here_schema=data_rule
    (Pattern_Pair data_x (Pattern_Pair (Pattern_Pair data_x data_y) data_y))
    {(0,2,data_x),(1,4,data_y)}"

definition selection_later_schema :: "nat \<Rightarrow> nat \<Rightarrow> (nat,nat,nat) factor_schema" where
  "selection_later_schema data select=data_rule
    (Pattern_Pair data_x (Pattern_Pair (Pattern_Pair data_z data_y) (Pattern_Pair data_z data_w)))
    {(0,data,data_z),(1,select,Pattern_Pair data_x (Pattern_Pair data_y data_w))}"

definition data_selection_later_schema :: "(nat,nat,nat) factor_schema" where
  "data_selection_later_schema=selection_later_schema 2 5"

definition data_selection_clauses :: "(nat \<times> (nat,nat,nat) factor_schema) set" where
  "data_selection_clauses={(0,data_selection_here_schema),(1,data_selection_later_schema)}"

definition data_selection_system :: "(nat,nat,nat,nat) schema_system" where
  "data_selection_system=add_view_definition data_list_system 5 data_x data_selection_clauses"

definition bag_nil_schema :: "(nat,nat,nat) factor_schema" where
  "bag_nil_schema=data_rule (Pattern_Pair (Pattern_Payload []) (Pattern_Payload [])) {}"

definition bag_step_schema :: "nat \<Rightarrow> nat \<Rightarrow> (nat,nat,nat) factor_schema" where
  "bag_step_schema select bag=data_rule (Pattern_Pair (Pattern_Pair data_x data_y) data_z)
    {(0,select,Pattern_Pair data_x (Pattern_Pair data_z data_w)),
     (1,bag,Pattern_Pair data_y data_w)}"

definition bag_cons_schema :: "(nat,nat,nat) factor_schema" where
  "bag_cons_schema=bag_step_schema 5 6"

definition bag_comparison_clauses :: "(nat \<times> (nat,nat,nat) factor_schema) set" where
  "bag_comparison_clauses={(0,bag_nil_schema),(1,bag_cons_schema)}"

definition bag_comparison_system :: "(nat,nat,nat,nat) schema_system" where
  "bag_comparison_system=add_view_definition data_selection_system 6 data_x bag_comparison_clauses"

lemmas data_list_schema_defs = data_list_nil_schema_def data_list_cons_schema_def list_step_schema_def
lemmas data_selection_schema_defs = data_selection_here_schema_def data_selection_later_schema_def selection_later_schema_def
lemmas bag_schema_defs = bag_nil_schema_def bag_cons_schema_def bag_step_schema_def
lemmas bag_system_defs = bag_comparison_system_def data_selection_system_def data_list_system_def

lemma data_list_system_formed [simp]: "schema_system_formed data_list_system"
  unfolding data_list_system_def
  by (rule add_recursive_definition_formed[OF data_comparison_system_formed])
    (auto simp: data_list_clauses_def data_list_schema_defs schema_formed_def
      schema_dependencies_def single_valued_def rel_dom_def rel_ran_def octets_formed_def)

lemma data_list_definitions [simp]: "system_definitions data_list_system={0,1,2,3,4}"
  by (auto simp: data_list_system_def)

lemma data_selection_system_formed [simp]: "schema_system_formed data_selection_system"
  unfolding data_selection_system_def
  by (rule add_recursive_definition_formed[OF data_list_system_formed])
    (auto simp: data_selection_clauses_def data_selection_schema_defs schema_formed_def
      schema_dependencies_def single_valued_def rel_dom_def rel_ran_def)

lemma data_selection_definitions [simp]: "system_definitions data_selection_system={0,1,2,3,4,5}"
  by (auto simp: data_selection_system_def)

lemma bag_comparison_system_formed [simp]: "schema_system_formed bag_comparison_system"
  unfolding bag_comparison_system_def
  by (rule add_recursive_definition_formed[OF data_selection_system_formed])
    (auto simp: bag_comparison_clauses_def bag_schema_defs schema_formed_def
      schema_dependencies_def single_valued_def rel_dom_def rel_ran_def octets_formed_def)

lemma bag_comparison_definitions [simp]: "system_definitions bag_comparison_system={0,1,2,3,4,5,6}"
  by (auto simp: bag_comparison_system_def)

lemma bag_comparison_call:
  "schema_call_formed bag_comparison_system d t \<longleftrightarrow> d\<in>{0,1,2,3,4,5,6} \<and> term_formed t"
  by (simp only: schema_call_formed_def bag_comparison_system_formed)
    (auto simp: bag_system_defs data_comparison_system_def data_recognition_system_def
      distinct_payloads_system_def)

lemma data_list_old_meaning:
  assumes "d\<in>{0,1,2,3}"
  shows "(d,t)\<in>positive_meaning data_list_system \<longleftrightarrow>
    (d,t)\<in>positive_meaning data_comparison_system"
  using added_definition_preserves_old(2)[OF data_comparison_system_formed
    data_list_system_formed[unfolded data_list_system_def], of d t] assms
  by (auto simp: data_list_system_def)

lemma data_selection_old_meaning:
  assumes "d\<in>{0,1,2,3,4}"
  shows "(d,t)\<in>positive_meaning data_selection_system \<longleftrightarrow>
    (d,t)\<in>positive_meaning data_list_system"
  using added_definition_preserves_old(2)[OF data_list_system_formed
    data_selection_system_formed[unfolded data_selection_system_def], of d t] assms
  by (auto simp: data_selection_system_def)

lemma bag_comparison_previous_meaning:
  assumes "d\<in>{0,1,2,3,4,5}"
  shows "(d,t)\<in>positive_meaning bag_comparison_system \<longleftrightarrow>
    (d,t)\<in>positive_meaning data_selection_system"
  using added_definition_preserves_old(2)[OF data_selection_system_formed
    bag_comparison_system_formed[unfolded bag_comparison_system_def], of d t] assms
  by (auto simp: bag_comparison_system_def)

theorem bag_comparison_old_meaning:
  assumes "d\<in>{0,1,2,3}"
  shows "(d,t)\<in>positive_meaning bag_comparison_system \<longleftrightarrow>
    (d,t)\<in>positive_meaning data_comparison_system"
  using bag_comparison_previous_meaning[of d t] data_selection_old_meaning[of d t]
    data_list_old_meaning[OF assms, of t] assms by auto

lemma bag_comparison_recognizes:
  "(2,t)\<in>positive_meaning bag_comparison_system \<longleftrightarrow> term_formed t \<and> self_contained_term t"
  using bag_comparison_old_meaning[of 2 t] data_comparison_recognizes[of t] by auto

lemma bag_comparison_new_clauses [simp]:
  "((4,c),S)\<in>system_clauses bag_comparison_system \<longleftrightarrow> (c,S)\<in>data_list_clauses"
  "((5,c),S)\<in>system_clauses bag_comparison_system \<longleftrightarrow> (c,S)\<in>data_selection_clauses"
  "((6,c),S)\<in>system_clauses bag_comparison_system \<longleftrightarrow> (c,S)\<in>bag_comparison_clauses"
proof -
  have owned: "((d,c),S)\<in>system_clauses data_comparison_system \<Longrightarrow>
    d\<in>system_definitions data_comparison_system" for d c S
    using data_comparison_system_formed unfolding schema_system_formed_def by blast
  have absent: "d\<in>{4,5,6} \<Longrightarrow> ((d,c),S)\<notin>system_clauses data_comparison_system" for d c S
    by (auto dest: owned)
  show "((4,c),S)\<in>system_clauses bag_comparison_system \<longleftrightarrow> (c,S)\<in>data_list_clauses"
    "((5,c),S)\<in>system_clauses bag_comparison_system \<longleftrightarrow> (c,S)\<in>data_selection_clauses"
    "((6,c),S)\<in>system_clauses bag_comparison_system \<longleftrightarrow> (c,S)\<in>bag_comparison_clauses"
    using absent by (auto simp: bag_system_defs)
qed

lemma bag_comparison_rule:
  assumes clause: "((d,c),S)\<in>system_clauses bag_comparison_system"
    and ordinary: "schema_material_premises S={}"
    and assignment: "\<forall>a\<in>schema_variables S. term_formed (f a)"
    and support: "\<forall>s e p. (s,e,p)\<in>schema_premises S \<longrightarrow>
      (e,evaluate_pattern f p)\<in>positive_meaning bag_comparison_system"
  shows "(d,evaluate_pattern f (schema_conclusion S))\<in>positive_meaning bag_comparison_system"
proof -
  have sf: "schema_formed S" and member: "d\<in>system_definitions bag_comparison_system"
    using clause bag_comparison_system_formed by (auto simp: schema_system_formed_def)
  have tf: "term_formed (evaluate_pattern f (schema_conclusion S))"
    by (rule evaluate_pattern_formed)
      (use sf assignment in \<open>auto simp: schema_formed_def schema_variables_def\<close>)
  have call: "schema_call_formed bag_comparison_system d (evaluate_pattern f (schema_conclusion S))"
    using member tf by (simp add: bag_comparison_call)
  show ?thesis by (rule ordinary_positive_valuation_step[OF clause ordinary assignment call support])
qed

section \<open>Exact recognition of the entire list boundary\<close>

theorem data_list_sound:
  assumes holds: "(4,t)\<in>positive_meaning bag_comparison_system"
  shows "\<exists>xs. t=data_list_term xs \<and> data_elements xs"
proof -
  have invariant: "(4::nat)=4 \<longrightarrow> (\<exists>xs. t=data_list_term xs \<and> data_elements xs)"
  proof (rule positive_valuation_induct[OF holds, where property="\<lambda>d t.
      d=4 \<longrightarrow> (\<exists>xs. t=data_list_term xs \<and> data_elements xs)"])
    fix d c S f
    assume clause: "((d,c),S)\<in>system_clauses bag_comparison_system"
      and assignment: "\<forall>a\<in>schema_variables S. term_formed (f a)"
      and call: "schema_call_formed bag_comparison_system d (evaluate_pattern f (schema_conclusion S))"
      and support: "\<forall>s e p. (s,e,p)\<in>schema_premises S \<longrightarrow>
        (e,evaluate_pattern f p)\<in>positive_meaning bag_comparison_system \<and>
        (e=4 \<longrightarrow> (\<exists>xs. evaluate_pattern f p=data_list_term xs \<and> data_elements xs))"
    show "d=4 \<longrightarrow> (\<exists>xs. evaluate_pattern f (schema_conclusion S)=data_list_term xs \<and> data_elements xs)"
    proof
      assume "d=4"
      then have cases: "S=data_list_nil_schema \<or> S=data_list_cons_schema"
        using clause by (auto simp: data_list_clauses_def)
      then show "\<exists>xs. evaluate_pattern f (schema_conclusion S)=data_list_term xs \<and> data_elements xs"
      proof
        assume "S=data_list_nil_schema"
        then show ?thesis by (intro exI[of _ "[]"]) (simp add: data_list_nil_schema_def)
      next
        assume schema: "S=data_list_cons_schema"
        have head: "term_formed (f 0) \<and> self_contained_term (f 0)"
          using support schema bag_comparison_recognizes[of "f 0"]
          by (auto simp: data_list_cons_schema_def list_step_schema_def)
        obtain xs where tail: "f 1=data_list_term xs" "data_elements xs"
          using support[rule_format, of 1 4 data_y] schema by (auto simp: data_list_cons_schema_def list_step_schema_def)
        show ?thesis by (intro exI[of _ "f 0#xs"])
          (use head tail in \<open>simp add: schema data_list_cons_schema_def list_step_schema_def\<close>)
      qed
    qed
  qed
  show ?thesis using invariant by simp
qed

theorem data_list_complete:
  assumes "data_elements xs"
  shows "(4,data_list_term xs)\<in>positive_meaning bag_comparison_system"
  using assms
proof (induction xs)
  case Nil
  have result: "(4,evaluate_pattern (\<lambda>_. Payload_Term []) (schema_conclusion data_list_nil_schema))
    \<in>positive_meaning bag_comparison_system"
    by (rule bag_comparison_rule[where c=0])
      (auto simp: data_list_clauses_def data_list_nil_schema_def schema_variables_def)
  show ?case using result by (simp add: data_list_nil_schema_def)
next
  case (Cons x xs)
  have tail: "(4,data_list_term xs)\<in>positive_meaning bag_comparison_system" using Cons by auto
  have head: "(2,x)\<in>positive_meaning bag_comparison_system"
    using Cons.prems by (simp add: bag_comparison_recognizes)
  let ?f="\<lambda>a::nat. if a=0 then x else data_list_term xs"
  have result: "(4,evaluate_pattern ?f (schema_conclusion data_list_cons_schema))
    \<in>positive_meaning bag_comparison_system"
    by (rule bag_comparison_rule[where c=1])
      (use Cons.prems head tail in \<open>auto simp: data_list_clauses_def data_list_cons_schema_def list_step_schema_def
        schema_variables_def data_list_term_formed\<close>)
  show ?case using result by (simp add: data_list_cons_schema_def list_step_schema_def)
qed

theorem data_list_exact:
  "(4,t)\<in>positive_meaning bag_comparison_system \<longleftrightarrow>
    (\<exists>xs. t=data_list_term xs \<and> data_elements xs)"
  using data_list_sound data_list_complete by blast

section \<open>Each selection removes exactly one matching occurrence\<close>

theorem data_selection_sound:
  assumes holds: "(5,t)\<in>positive_meaning bag_comparison_system"
  shows "\<exists>x pre post. t=Pair_Term x
    (Pair_Term (data_list_term (pre@x#post)) (data_list_term (pre@post))) \<and>
    data_elements (pre@x#post)"
proof -
  let ?Q="\<lambda>t. \<exists>x pre post. t=Pair_Term x
    (Pair_Term (data_list_term (pre@x#post)) (data_list_term (pre@post))) \<and>
    data_elements (pre@x#post)"
  have invariant: "(5::nat)=5 \<longrightarrow> ?Q t"
  proof (rule positive_valuation_induct[OF holds, where property="\<lambda>d t. d=5 \<longrightarrow> ?Q t"])
    fix d c S f
    assume clause: "((d,c),S)\<in>system_clauses bag_comparison_system"
      and assignment: "\<forall>a\<in>schema_variables S. term_formed (f a)"
      and call: "schema_call_formed bag_comparison_system d (evaluate_pattern f (schema_conclusion S))"
      and support: "\<forall>s e p. (s,e,p)\<in>schema_premises S \<longrightarrow>
        (e,evaluate_pattern f p)\<in>positive_meaning bag_comparison_system \<and>
        (e=5 \<longrightarrow> ?Q (evaluate_pattern f p))"
    show "d=5 \<longrightarrow> ?Q (evaluate_pattern f (schema_conclusion S))"
    proof
      assume "d=5"
      then have cases: "S=data_selection_here_schema \<or> S=data_selection_later_schema"
        using clause by (auto simp: data_selection_clauses_def)
      then show "?Q (evaluate_pattern f (schema_conclusion S))"
      proof
        assume schema: "S=data_selection_here_schema"
        have head: "term_formed (f 0) \<and> self_contained_term (f 0)"
          using support schema bag_comparison_recognizes[of "f 0"]
          by (auto simp: data_selection_here_schema_def)
        have list: "(4,f 1)\<in>positive_meaning bag_comparison_system"
          using support schema by (auto simp: data_selection_here_schema_def)
        obtain post where tail: "f 1=data_list_term post" "data_elements post"
          using data_list_sound[OF list] by blast
        show ?thesis by (intro exI[of _ "f 0"] exI[of _ "[]"] exI[of _ post])
          (use head tail in \<open>simp add: schema data_selection_here_schema_def\<close>)
      next
        assume schema: "S=data_selection_later_schema"
        have skipped: "term_formed (f 2) \<and> self_contained_term (f 2)"
          using support schema bag_comparison_recognizes[of "f 2"]
          by (auto simp: data_selection_later_schema_def selection_later_schema_def)
        obtain pre post where tail: "f 1=data_list_term (pre@f 0#post)"
          "f 3=data_list_term (pre@post)" "data_elements (pre@f 0#post)"
          using support[rule_format, of 1 5 "Pattern_Pair data_x (Pattern_Pair data_y data_w)"] schema
          by (auto simp: data_selection_later_schema_def selection_later_schema_def)
        show ?thesis by (intro exI[of _ "f 0"] exI[of _ "f 2#pre"] exI[of _ post])
          (use skipped tail in \<open>simp add: schema data_selection_later_schema_def selection_later_schema_def\<close>)
      qed
    qed
  qed
  show ?thesis using invariant by simp
qed

theorem data_selection_complete:
  assumes "data_elements (pre@x#post)"
  shows "(5,Pair_Term x (Pair_Term (data_list_term (pre@x#post)) (data_list_term (pre@post))))
    \<in>positive_meaning bag_comparison_system"
  using assms
proof (induction pre)
  case Nil
  have head: "(2,x)\<in>positive_meaning bag_comparison_system"
    using Nil.prems by (simp add: bag_comparison_recognizes)
  have tail: "(4,data_list_term post)\<in>positive_meaning bag_comparison_system"
    by (rule data_list_complete) (use Nil.prems in auto)
  let ?f="\<lambda>a::nat. if a=0 then x else data_list_term post"
  have result: "(5,evaluate_pattern ?f (schema_conclusion data_selection_here_schema))
    \<in>positive_meaning bag_comparison_system"
    by (rule bag_comparison_rule[where c=0])
      (use Nil.prems head tail in \<open>auto simp: data_selection_clauses_def data_selection_here_schema_def
        schema_variables_def data_list_term_formed\<close>)
  show ?case using result by (simp add: data_selection_here_schema_def)
next
  case (Cons z pre)
  have skipped: "(2,z)\<in>positive_meaning bag_comparison_system"
    using Cons.prems by (simp add: bag_comparison_recognizes)
  have tail: "(5,Pair_Term x (Pair_Term (data_list_term (pre@x#post)) (data_list_term (pre@post))))
    \<in>positive_meaning bag_comparison_system" using Cons by auto
  let ?f="\<lambda>a::nat. if a=0 then x else if a=1 then data_list_term (pre@x#post)
    else if a=2 then z else data_list_term (pre@post)"
  have result: "(5,evaluate_pattern ?f (schema_conclusion data_selection_later_schema))
    \<in>positive_meaning bag_comparison_system"
    by (rule bag_comparison_rule[where c=1])
      (use Cons.prems skipped tail in \<open>auto simp: data_selection_clauses_def data_selection_later_schema_def selection_later_schema_def
        schema_variables_def data_list_term_formed\<close>)
  show ?case using result by (simp add: data_selection_later_schema_def selection_later_schema_def)
qed

theorem data_selection_exact:
  "(5,Pair_Term x (Pair_Term (data_list_term xs) (data_list_term ys)))
    \<in>positive_meaning bag_comparison_system \<longleftrightarrow>
    data_elements xs \<and> (\<exists>pre post. xs=pre@x#post \<and> ys=pre@post)"
proof
  assume holds: "(5,Pair_Term x (Pair_Term (data_list_term xs) (data_list_term ys)))
    \<in>positive_meaning bag_comparison_system"
  show "data_elements xs \<and> (\<exists>pre post. xs=pre@x#post \<and> ys=pre@post)"
    using data_selection_sound[OF holds] by (auto simp: data_list_term_injective)
next
  assume "data_elements xs \<and> (\<exists>pre post. xs=pre@x#post \<and> ys=pre@post)"
  then show "(5,Pair_Term x (Pair_Term (data_list_term xs) (data_list_term ys)))
    \<in>positive_meaning bag_comparison_system"
    using data_selection_complete by blast
qed

abbreviation selected_data_member :: "factor_term \<Rightarrow> factor_term \<Rightarrow> bool" where
  "selected_data_member x t \<equiv>
    \<exists>r. (5,Pair_Term x (Pair_Term t r))\<in>positive_meaning bag_comparison_system"

lemma selected_data_member_exact:
  "selected_data_member x t \<longleftrightarrow>
    (\<exists>xs. t=data_list_term xs \<and> data_elements xs \<and> x\<in>set xs)"
proof
  assume "selected_data_member x t"
  then obtain r where step: "(5,Pair_Term x (Pair_Term t r))\<in>positive_meaning bag_comparison_system" by blast
  obtain pre post where parts: "t=data_list_term (pre@x#post)" "data_elements (pre@x#post)"
    using data_selection_sound[OF step] by auto
  show "\<exists>xs. t=data_list_term xs \<and> data_elements xs \<and> x\<in>set xs"
    by (intro exI[of _ "pre@x#post"]) (use parts in auto)
next
  assume "\<exists>xs. t=data_list_term xs \<and> data_elements xs \<and> x\<in>set xs"
  then obtain xs where parts: "t=data_list_term xs" "data_elements xs" "x\<in>set xs" by blast
  obtain pre post where split: "xs=pre@x#post" using split_list[OF parts(3)] by blast
  have step: "(5,Pair_Term x (Pair_Term t (data_list_term (pre@post))))\<in>positive_meaning bag_comparison_system"
    using data_selection_complete[of pre x post] parts(1,2) split by simp
  show "selected_data_member x t" using step by blast
qed

lemma selected_data_member_formed:
  assumes "selected_data_member x t"
  shows "term_formed x \<and> self_contained_term x \<and> term_formed t \<and> self_contained_term t"
  using assms by (auto simp: selected_data_member_exact data_list_term_formed data_list_term_self_contained)

lemma data_collection_selection:
  assumes read: "data_collection_presents R A a"
    and formed: "\<And>z t. z\<in>A \<Longrightarrow> R z t \<Longrightarrow> term_formed t \<and> self_contained_term t"
  shows "(\<forall>z\<in>A. \<exists>t. selected_data_member t a \<and> R z t) \<and>
    (\<forall>t. selected_data_member t a \<longrightarrow> (\<exists>z\<in>A. R z t))"
proof -
  obtain xs ts where parts: "set xs=A" "list_all2 R xs ts" "a=data_list_term ts"
    using read unfolding data_collection_presents_def by blast
  have members: "(\<forall>z\<in>A. \<exists>t\<in>set ts. R z t) \<and>
    (\<forall>t\<in>set ts. \<exists>z\<in>A. R z t)" using list_all2_members[OF parts(2)] parts(1) by simp
  have data: "data_elements ts" using formed members by blast
  have actual: "selected_data_member t a \<longleftrightarrow> t\<in>set ts" for t
    using data by (auto simp: selected_data_member_exact parts(3) data_list_term_injective)
  show ?thesis using members by (auto simp only: actual)
qed

section \<open>The recursive comparison preserves every multiplicity\<close>

theorem bag_comparison_sound:
  assumes holds: "(6,t)\<in>positive_meaning bag_comparison_system"
  shows "\<exists>xs ys. t=Pair_Term (data_list_term xs) (data_list_term ys) \<and>
    data_elements xs \<and> data_elements ys \<and> mset xs=mset ys"
proof -
  let ?Q="\<lambda>t. \<exists>xs ys. t=Pair_Term (data_list_term xs) (data_list_term ys) \<and>
    data_elements xs \<and> data_elements ys \<and> mset xs=mset ys"
  have invariant: "(6::nat)=6 \<longrightarrow> ?Q t"
  proof (rule positive_valuation_induct[OF holds, where property="\<lambda>d t. d=6 \<longrightarrow> ?Q t"])
    fix d c S f
    assume clause: "((d,c),S)\<in>system_clauses bag_comparison_system"
      and assignment: "\<forall>a\<in>schema_variables S. term_formed (f a)"
      and call: "schema_call_formed bag_comparison_system d (evaluate_pattern f (schema_conclusion S))"
      and support: "\<forall>s e p. (s,e,p)\<in>schema_premises S \<longrightarrow>
        (e,evaluate_pattern f p)\<in>positive_meaning bag_comparison_system \<and>
        (e=6 \<longrightarrow> ?Q (evaluate_pattern f p))"
    show "d=6 \<longrightarrow> ?Q (evaluate_pattern f (schema_conclusion S))"
    proof
      assume "d=6"
      then have cases: "S=bag_nil_schema \<or> S=bag_cons_schema"
        using clause by (auto simp: bag_comparison_clauses_def)
      then show "?Q (evaluate_pattern f (schema_conclusion S))"
      proof
        assume "S=bag_nil_schema"
        then show ?thesis by (intro exI[of _ "[]"] exI[of _ "[]"]) (simp add: bag_nil_schema_def)
      next
        assume schema: "S=bag_cons_schema"
        have selection: "(5,Pair_Term (f 0) (Pair_Term (f 2) (f 3)))
          \<in>positive_meaning bag_comparison_system"
          using support schema by (auto simp: bag_cons_schema_def bag_step_schema_def)
        obtain pre post where selected: "f 2=data_list_term (pre@f 0#post)"
          "f 3=data_list_term (pre@post)" "data_elements (pre@f 0#post)"
          using data_selection_sound[OF selection] by auto
        obtain xs zs where compared: "f 1=data_list_term xs" "f 3=data_list_term zs"
          "data_elements xs" "data_elements zs" "mset xs=mset zs"
          using support[rule_format, of 1 6 "Pattern_Pair data_y data_w"] schema
          by (auto simp: bag_cons_schema_def bag_step_schema_def)
        have residual: "zs=pre@post" using selected(2) compared(2)
          by (simp add: data_list_term_injective)
        show ?thesis by (intro exI[of _ "f 0#xs"] exI[of _ "pre@f 0#post"])
          (use selected compared residual in \<open>auto simp: schema bag_cons_schema_def bag_step_schema_def\<close>)
      qed
    qed
  qed
  show ?thesis using invariant by simp
qed

theorem bag_comparison_complete:
  assumes "data_elements xs" "data_elements ys" "mset xs=mset ys"
  shows "(6,Pair_Term (data_list_term xs) (data_list_term ys))\<in>positive_meaning bag_comparison_system"
  using assms
proof (induction xs arbitrary: ys)
  case Nil
  have empty: "ys=[]" using Nil.prems by simp
  have result: "(6,evaluate_pattern (\<lambda>_. Payload_Term []) (schema_conclusion bag_nil_schema))
    \<in>positive_meaning bag_comparison_system"
    by (rule bag_comparison_rule[where c=0])
      (auto simp: bag_comparison_clauses_def bag_nil_schema_def schema_variables_def)
  show ?case using result empty by (simp add: bag_nil_schema_def)
next
  case (Cons x xs)
  have inside: "x\<in>set ys" using mset_eq_setD[OF Cons.prems(3)] by auto
  obtain pre post where split: "ys=pre@x#post" using split_list[OF inside] by blast
  have residual: "mset xs=mset (pre@post)" using Cons.prems(3) by (simp add: split)
  have data: "data_elements (pre@x#post)" using Cons.prems(2) split by simp
  have selection: "(5,Pair_Term x (Pair_Term (data_list_term ys) (data_list_term (pre@post))))
    \<in>positive_meaning bag_comparison_system"
    using data_selection_complete[OF data] split by simp
  have tail: "(6,Pair_Term (data_list_term xs) (data_list_term (pre@post)))
    \<in>positive_meaning bag_comparison_system"
    by (rule Cons.IH) (use Cons.prems(1) data residual in auto)
  let ?f="\<lambda>a::nat. if a=0 then x else if a=1 then data_list_term xs
    else if a=2 then data_list_term ys else data_list_term (pre@post)"
  have result: "(6,evaluate_pattern ?f (schema_conclusion bag_cons_schema))
    \<in>positive_meaning bag_comparison_system"
    by (rule bag_comparison_rule[where c=1])
      (use Cons.prems(1,2) data selection tail in \<open>auto simp: bag_comparison_clauses_def
        bag_cons_schema_def bag_step_schema_def schema_variables_def data_list_term_formed\<close>)
  show ?case using result by (simp add: bag_cons_schema_def bag_step_schema_def)
qed

theorem bag_comparison_exact:
  "(6,t)\<in>positive_meaning bag_comparison_system \<longleftrightarrow>
    (\<exists>xs ys. t=Pair_Term (data_list_term xs) (data_list_term ys) \<and>
      data_elements xs \<and> data_elements ys \<and> mset xs=mset ys)"
  using bag_comparison_sound bag_comparison_complete by blast

corollary bag_comparison_lists:
  "(6,Pair_Term (data_list_term xs) (data_list_term ys))\<in>positive_meaning bag_comparison_system
    \<longleftrightarrow> data_elements xs \<and> data_elements ys \<and> mset xs=mset ys"
  by (auto simp: bag_comparison_exact data_list_term_injective)

corollary bag_comparison_counts:
  assumes "data_elements xs" "data_elements ys"
  shows "(6,Pair_Term (data_list_term xs) (data_list_term ys))\<in>positive_meaning bag_comparison_system
    \<longleftrightarrow> count_list xs=count_list ys"
  using assms by (simp add: bag_comparison_lists multiset_eq_iff count_mset fun_eq_iff)

theorem native_bag_comparison:
  "\<exists>E :: local_address option artifact_environment. \<exists>pu Q d. closed_native_package_at E pu [] Q \<and>
    (\<forall>t. term_formed t \<longrightarrow> (\<exists>F au I K. environment_formed F \<and> environment_included E F \<and>
      au\<notin>environment_uses E \<and> native_package_at F pu [] Q \<and> native_application_at F au [] d t I K \<and>
      native_package_environment F pu []=E \<and> native_application_formed F pu [] au [] \<and>
      (native_positive_holds F pu [] au [] \<longleftrightarrow>
        (\<exists>xs ys. t=Pair_Term (data_list_term xs) (data_list_term ys) \<and>
          data_elements xs \<and> data_elements ys \<and> mset xs=mset ys))))"
proof -
  obtain g :: "nat \<Rightarrow> local_address option definition_site"
    and E :: "local_address option artifact_environment" and pu Q
    where closed: "closed_native_package_at E pu [] Q"
    and future: "\<forall>d\<in>system_definitions bag_comparison_system. \<forall>t. term_formed t \<longrightarrow>
      (\<exists>F au I K. environment_formed F \<and> environment_included E F \<and> au\<notin>environment_uses E \<and>
        native_package_at F pu [] Q \<and> native_application_at F au [] (g d) t I K \<and>
        native_package_environment F pu []=E \<and>
        (native_application_formed F pu [] au [] \<longleftrightarrow> schema_call_formed bag_comparison_system d t) \<and>
        (native_positive_holds F pu [] au [] \<longleftrightarrow> (d,t)\<in>positive_meaning bag_comparison_system) \<and>
        (\<forall>v\<in>environment_uses E. \<forall>R. artifact_at F v R \<longleftrightarrow> artifact_at E v R) \<and>
        (\<forall>v\<in>environment_uses E. \<forall>k w. binds_slot F v k w \<longleftrightarrow> binds_slot E v k w))"
    using compiled_program_future_applications[OF bag_comparison_system_formed] by blast
  have member: "6\<in>system_definitions bag_comparison_system" by simp
  show ?thesis
  proof (rule exI[of _ E], rule exI[of _ pu], rule exI[of _ Q], rule exI[of _ "g 6"], intro conjI allI impI)
    show "closed_native_package_at E pu [] Q" by (rule closed)
  next
    fix t assume tf: "term_formed t"
    obtain F au I K where parts: "environment_formed F" "environment_included E F" "au\<notin>environment_uses E"
      "native_package_at F pu [] Q" "native_application_at F au [] (g 6) t I K"
      "native_package_environment F pu []=E"
      "native_application_formed F pu [] au [] \<longleftrightarrow> schema_call_formed bag_comparison_system 6 t"
      "native_positive_holds F pu [] au [] \<longleftrightarrow> (6,t)\<in>positive_meaning bag_comparison_system"
      using future[rule_format, OF member tf] by blast
    show "\<exists>F au I K. environment_formed F \<and> environment_included E F \<and> au\<notin>environment_uses E \<and>
      native_package_at F pu [] Q \<and> native_application_at F au [] (g 6) t I K \<and>
      native_package_environment F pu []=E \<and> native_application_formed F pu [] au [] \<and>
      (native_positive_holds F pu [] au [] \<longleftrightarrow>
        (\<exists>xs ys. t=Pair_Term (data_list_term xs) (data_list_term ys) \<and>
          data_elements xs \<and> data_elements ys \<and> mset xs=mset ys))"
      by (rule exI[of _ F], rule exI[of _ au], rule exI[of _ I], rule exI[of _ K])
        (use parts tf in \<open>auto simp: bag_comparison_call bag_comparison_exact\<close>)
  qed
qed

text \<open>
  The three new definitions are complete finite ordinary clause families.
  Their coordinates are relocated by native compilation. Shared occurrences
  of one bound variable enforce exact element equality. Selection may pass
  over an equal element and remove a later occurrence; no first-match order
  is imposed. The remaining list is an ordinary existentially instantiated
  premise argument, checked by both selected calls.

  All list elements and the final empty tail are checked. The independently
  defined positive meaning is exactly equality of all element counts.
  Multisets occur only in this comparison theorem, not in a new truth rule or
  an implicit edit of ordinary premise families. Each premise keeps its own
  socket, including when evaluated calls coincide. One fixed closed native
  program handles every future formed argument.
\<close>

end
