theory Factor_Collection_Comparisons
  imports "Factor_Key_Fibres" "Factor_Finite_Set_Presentations"
begin

section \<open>One complete encoded collection determines every compared output\<close>

theorem encoded_collection_comparison:
  assumes injective: "inj f"
    and source: "data_collection_presents (\<lambda>a t. D a \<and> t=f a) A p"
    and data: "\<And>a. a\<in>A \<Longrightarrow> term_formed (f a) \<and> self_contained_term (f a)"
  shows "(6,Pair_Term p q)\<in>positive_meaning bag_comparison_system \<longleftrightarrow>
    data_collection_presents (\<lambda>a t. D a \<and> t=f a) A q"
proof -
  have reading: "data_collection_presents (\<lambda>a t. D a \<and> t=f a) A t \<longleftrightarrow>
      (\<exists>xs. distinct xs \<and> set xs=A \<and> (\<forall>a\<in>set xs. D a) \<and>
        t=data_list_term (map f xs))" for t
    by (auto simp: data_collection_presents_constrain data_collection_presents_function)
  obtain xs where first: "distinct xs" "set xs=A" "\<forall>a\<in>set xs. D a"
    "p=data_list_term (map f xs)" using source by (simp only: reading; blast)
  have fields: "data_elements (map f xs)" using data first(2) by auto
  have compared: "(6,Pair_Term p q)\<in>positive_meaning bag_comparison_system \<longleftrightarrow>
      (\<exists>ys. q=data_list_term (map f ys) \<and> mset xs=mset ys)"
    by (simp only: first(4) bag_comparison_encoded[OF injective fields])
  show ?thesis
  proof (simp only: compared reading, rule iffI)
    assume "\<exists>ys. q=data_list_term (map f ys) \<and> mset xs=mset ys"
    then obtain ys where second: "q=data_list_term (map f ys)" "mset xs=mset ys" by blast
    have same: "set xs=set ys" "distinct xs=distinct ys"
      using mset_eq_setD[OF second(2)] mset_eq_imp_distinct_iff[OF second(2)] by blast+
    show "\<exists>ys. distinct ys \<and> set ys=A \<and> (\<forall>a\<in>set ys. D a) \<and>
        q=data_list_term (map f ys)"
      by (rule exI[of _ ys]) (use first second same in blast)
  next
    assume "\<exists>ys. distinct ys \<and> set ys=A \<and> (\<forall>a\<in>set ys. D a) \<and>
        q=data_list_term (map f ys)"
    then obtain ys where second: "distinct ys" "set ys=A" "q=data_list_term (map f ys)" by blast
    have same: "mset xs=mset ys"
      using set_eq_iff_mset_eq_distinct[OF first(1) second(1)] first(2) second(2) by blast
    show "\<exists>ys. q=data_list_term (map f ys) \<and> mset xs=mset ys"
      using second(3) same by blast
  qed
qed

text \<open>
  The existing bag comparison accounts for every output term. For an injective
  element encoding and a complete distinct source enumeration, equality of
  bags gives exactly every enumeration of the same finite collection. The
  element domain and data formation remain explicit. This derived law does
  not identify equal-looking presentations of different element notions.
\<close>

end
