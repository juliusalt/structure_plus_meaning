theory Factor_Scope_Computation_Contracts
  imports "Factor_Observation_Scope_Admission" "Presentation_Function_Witnesses"
begin

section \<open>A complete admitted scope retains its whole enumerated input\<close>

lemma observation_scope_subject_list_data:
  assumes "observation_scope_subject_formed (fset_of_list cs) (fset_of_list us) (fset_of_list fs) (fset_of_list rows)"
  shows "data_elements cs" "data_elements us" "data_elements fs" "observation_rows_data rows"
proof -
  have fields: "data_elements cs \<and> data_elements us \<and> data_elements fs \<and> observation_rows_data rows \<and>
      (\<forall>(f,c,w)\<in>set rows. f\<in>set us \<and> c\<in>set cs) \<and> set fs\<subseteq>set us"
    by (rule iffD1[OF observation_scope_subject_lists assms])
  show "data_elements cs" by (rule conjunct1[OF fields])
  show "data_elements us" by (rule conjunct1[OF conjunct2[OF fields]])
  show "data_elements fs" by (rule conjunct1[OF conjunct2[OF conjunct2[OF fields]]])
  show "observation_rows_data rows" by (rule conjunct1[OF conjunct2[OF conjunct2[OF conjunct2[OF fields]]]])
qed

lemma observation_scope_enumerated:
  assumes "observation_scope_presents z p"
  obtains cs us fs rows where "data_elements cs" "data_elements us" "data_elements fs" "observation_rows_data rows"
    "observation_scope_subject_formed (fset_of_list cs) (fset_of_list us) (fset_of_list fs) (fset_of_list rows)"
    "z=((fset_of_list cs,(fset_of_list us,fset_of_list fs)),fset_of_list rows)"
    "p=observation_scope_argument (data_list_term cs) (data_list_term us) (data_list_term fs)
      (data_list_term (map observation_row_term rows))"
proof -
  obtain C U F T where shape: "z=((C,(U,F)),T)" by (cases z; case_tac a; case_tac b; auto)
  have source_fields: "observation_scope_subject_formed C U F T \<and>
      observation_scope_record_presents ((C,(U,F)),T) p"
    using assms by (simp only: shape fst_conv snd_conv)
  have record_read: "observation_scope_record_presents ((C,(U,F)),T) p" by (rule conjunct2[OF source_fields])
  have scope: "observation_scope_subject_formed C U F T" by (rule conjunct1[OF source_fields])
  obtain cs us fs rows where fields: "data_elements cs" "data_elements us" "data_elements fs" "observation_rows_data rows"
    "fset_of_list cs=C" "fset_of_list us=U" "fset_of_list fs=F" "fset_of_list rows=T"
    "p=observation_scope_argument (data_list_term cs) (data_list_term us) (data_list_term fs)
      (data_list_term (map observation_row_term rows))"
    by (rule observation_scope_record_fields[OF record_read]) blast
  have admitted: "observation_scope_subject_formed (fset_of_list cs) (fset_of_list us) (fset_of_list fs) (fset_of_list rows)"
    by (simp only: fields(5-8) scope)
  have subject: "z=((fset_of_list cs,(fset_of_list us,fset_of_list fs)),fset_of_list rows)"
    by (simp only: shape fields(5-8))
  show ?thesis by (rule that[OF fields(1-4) admitted subject fields(9)])
qed

section \<open>Admission and a returned value establish a complete function witness\<close>

theorem observation_scope_computed_witness:
  assumes target: "presentation_class S E B"
    and boundary: "\<And>p q. operation p q \<Longrightarrow> (311,p)\<in>positive_meaning observation_scope_system"
    and computation: "\<And>cs us fs rows q. operation
      (observation_scope_argument (data_list_term cs) (data_list_term us) (data_list_term fs)
        (data_list_term (map observation_row_term rows))) q \<longleftrightarrow>
      observation_scope_subject_formed (fset_of_list cs) (fset_of_list us) (fset_of_list fs) (fset_of_list rows) \<and>
      q=h cs us fs rows"
    and returned: "\<And>cs us fs rows. data_elements cs \<Longrightarrow> data_elements us \<Longrightarrow> data_elements fs \<Longrightarrow>
      observation_rows_data rows \<Longrightarrow>
      S (f ((fset_of_list cs,(fset_of_list us,fset_of_list fs)),fset_of_list rows)) (h cs us fs rows)"
  shows "presented_function_witness observation_scope_presents observation_scope_domain
    (\<lambda>p. \<exists>z. observation_scope_presents z p) S E B f operation"
proof (rule presented_function_witness.intro[OF observation_scope_class target]; unfold_locales)
  fix p q assume "operation p q"
  then have "(311,p)\<in>positive_meaning observation_scope_system" by (rule boundary)
  then show "\<exists>z. observation_scope_presents z p"
    by (simp only: observation_scope_presented presented_predicate_def; blast)
next
  fix z p q assume read: "observation_scope_presents z p" and run: "operation p q"
  obtain cs us fs rows where fields: "data_elements cs" "data_elements us" "data_elements fs" "observation_rows_data rows"
    "z=((fset_of_list cs,(fset_of_list us,fset_of_list fs)),fset_of_list rows)"
    "p=observation_scope_argument (data_list_term cs) (data_list_term us) (data_list_term fs)
      (data_list_term (map observation_row_term rows))"
    by (rule observation_scope_enumerated[OF read]) blast
  have result: "q=h cs us fs rows" using run by (simp only: fields(6) computation; blast)
  show "S (f z) q" by (simp only: fields(5) result; rule returned[OF fields(1-4)])
next
  fix p assume "\<exists>z. observation_scope_presents z p"
  then obtain z where read: "observation_scope_presents z p" by blast
  obtain cs us fs rows where fields:
    "observation_scope_subject_formed (fset_of_list cs) (fset_of_list us) (fset_of_list fs) (fset_of_list rows)"
    "p=observation_scope_argument (data_list_term cs) (data_list_term us) (data_list_term fs)
      (data_list_term (map observation_row_term rows))"
    by (rule observation_scope_enumerated[OF read]) blast
  show "\<exists>q. operation p q"
    by (rule exI[of _ "h cs us fs rows"])
      (simp only: fields(2) computation; rule conjI[OF fields(1) refl])
qed

text \<open>
  The source remains the independently admitted observation scope. The
  calculation supplies its actual input boundary, its equation on every
  complete enumeration, and the presentation of its returned value. These
  contracts establish soundness and totality for every admitted input term.
  The returned witness may depend on input order or repetition; its represented
  subject depends only on the complete scope. A downstream complete comparison
  can then admit every presentation of that same value.
\<close>

end
