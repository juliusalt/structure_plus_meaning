theory Factor_Result_Comparison
  imports "Factor_Related_Lists" "Presentation_Function_Witnesses"
begin

section \<open>A private computed result is compared with the supplied result\<close>

definition context_result_comparison_schema :: "nat \<Rightarrow> nat \<Rightarrow> (nat,nat,nat) factor_schema" where
  "context_result_comparison_schema compute compare=data_rule (context_relation_pattern data_x data_y data_z)
    {(0,compute,context_relation_pattern data_x data_y data_w),
     (1,compare,Pattern_Pair data_w data_z)}"

lemma context_result_comparison_formed [simp]:
  "schema_formed (context_result_comparison_schema compute compare)"
  by (auto simp: context_result_comparison_schema_def schema_formed_def single_valued_def)

lemma context_result_comparison_dependencies [simp]:
  "schema_dependencies (context_result_comparison_schema compute compare)={compute,compare}"
  by (auto simp: context_result_comparison_schema_def schema_dependencies_def rel_ran_image)

lemma context_result_comparison_variables [simp]:
  "schema_variables (context_result_comparison_schema compute compare)={0,1,2,3}"
  by (auto simp: context_result_comparison_schema_def schema_variables_def)

locale context_result_comparison_profile =
  fixes P :: "(nat,nat,nat,nat) schema_system" and entry compute compare :: nat
  assumes system_formed: "schema_system_formed P"
    and family: "\<And>c S. ((entry,c),S)\<in>system_clauses P \<longleftrightarrow>
      c=0 \<and> S=context_result_comparison_schema compute compare"
    and call: "\<And>t. schema_call_formed P entry t \<longleftrightarrow> term_formed t"
begin

lemma valuation:
  "(entry,t)\<in>positive_meaning P \<longleftrightarrow>
    (\<exists>h::nat\<Rightarrow>factor_term. term_formed (h 0) \<and> term_formed (h 1) \<and>
      term_formed (h 2) \<and> term_formed (h 3) \<and>
      t=context_relation_argument (h 0) (h 1) (h 2) \<and>
      (compute,context_relation_argument (h 0) (h 1) (h 3))\<in>positive_meaning P \<and>
      (compare,Pair_Term (h 3) (h 2))\<in>positive_meaning P)"
  by (subst ordinary_positive_entry_valuation)
    (auto simp: family context_result_comparison_schema_def schema_variables_def call)

theorem exact:
  "(entry,t)\<in>positive_meaning P \<longleftrightarrow>
    (\<exists>p input result witness. t=context_relation_argument p input result \<and>
      (compute,context_relation_argument p input witness)\<in>positive_meaning P \<and>
      (compare,Pair_Term witness result)\<in>positive_meaning P)"
proof
  assume "(entry,t)\<in>positive_meaning P"
  then show "\<exists>p input result witness. t=context_relation_argument p input result \<and>
      (compute,context_relation_argument p input witness)\<in>positive_meaning P \<and>
      (compare,Pair_Term witness result)\<in>positive_meaning P"
    by (simp only: valuation) blast
next
  assume "\<exists>p input result witness. t=context_relation_argument p input result \<and>
      (compute,context_relation_argument p input witness)\<in>positive_meaning P \<and>
      (compare,Pair_Term witness result)\<in>positive_meaning P"
  then obtain p input result witness where parts: "t=context_relation_argument p input result"
    "(compute,context_relation_argument p input witness)\<in>positive_meaning P"
    "(compare,Pair_Term witness result)\<in>positive_meaning P" by blast
  have formed: "term_formed p" "term_formed input" "term_formed result" "term_formed witness"
    using schema_call_formed_target[OF positive_meaning_formed[OF parts(2)]]
      schema_call_formed_target[OF positive_meaning_formed[OF parts(3)]] by auto
  let ?h="\<lambda>i::nat. if i=0 then p else if i=1 then input else if i=2 then result else witness"
  show "(entry,t)\<in>positive_meaning P"
    by (simp only: valuation; rule exI[of _ ?h]) (use parts formed in auto)
qed

corollary at_input:
  "(entry,context_relation_argument p input result)\<in>positive_meaning P \<longleftrightarrow>
    (\<exists>witness. (compute,context_relation_argument p input witness)\<in>positive_meaning P \<and>
      (compare,Pair_Term witness result)\<in>positive_meaning P)"
  by (auto simp only: exact factor_term.inject)

lemma at_determined_result:
  assumes computation: "\<And>w. (compute,context_relation_argument p input w)\<in>positive_meaning P
      \<longleftrightarrow> admitted \<and> w=witness"
    and comparison: "admitted \<Longrightarrow> ((compare,Pair_Term witness result)\<in>positive_meaning P \<longleftrightarrow> condition)"
  shows "(entry,context_relation_argument p input result)\<in>positive_meaning P \<longleftrightarrow> admitted \<and> condition"
  by (simp only: at_input computation) (use comparison in blast)

theorem presented_contract:
  assumes computation: "presented_function_witness R D A S E B f
      (\<lambda>p q. (compute,context_relation_argument (fst p) (snd p) q)\<in>positive_meaning P)"
    and comparison: "\<And>b q r. S b q \<Longrightarrow>
      ((compare,Pair_Term q r)\<in>positive_meaning P \<longleftrightarrow> S b r)"
  shows "presented_function_contract R D A S E B f
    (\<lambda>p r. (entry,context_relation_argument (fst p) (snd p) r)\<in>positive_meaning P)"
proof -
  have completed: "presented_function_contract R D A S E B f
      (\<lambda>p r. \<exists>q. (compute,context_relation_argument (fst p) (snd p) q)\<in>positive_meaning P \<and>
        (compare,Pair_Term q r)\<in>positive_meaning P)"
    by (rule presented_function_witness.completion_by_comparison[OF computation comparison])
  show ?thesis using completed by (simp only: at_input)
qed

end

text \<open>
  The computed result has its own premise-only variable. The public result
  occurs in the comparison call. Requiring the computation to produce the
  public result literally would retain the earlier order restriction.
  Both callees and both premise sockets are actual parts of this ordinary
  schema. The contract applies to their meanings in the complete program.
\<close>

end
