theory Factor_Observation_Results
  imports "Factor_Observation_Result_Clauses" "Factor_Observation_Presentations"
begin

section \<open>The public operations compare the sets of computed result rows\<close>

lemma observation_profile_result_lists:
  "(302,context_relation_argument (Pair_Term (data_list_term F) c)
    (data_list_term (map observation_row_term rows)) (data_list_term output))\<in>positive_meaning observation_result_system
    \<longleftrightarrow> data_elements F \<and> observation_datum c \<and> observation_rows_data rows \<and>
      data_elements output \<and> set output=set (map observation_value_term (observation_profile_list F rows c))"
proof -
  let ?input="data_list_term (map observation_row_term rows)"
  let ?value="data_list_term (map observation_value_term (observation_profile_list F rows c))"
  have computation: "(301,context_relation_argument (Pair_Term (data_list_term F) c) ?input w)\<in>positive_meaning observation_result_system\<longleftrightarrow>
      (data_elements F \<and> observation_datum c \<and> observation_rows_data rows) \<and> w=?value" for w
    by (simp only: observation_result_components observation_encoded_profile conj_assoc)
  have comparison: "(219,Pair_Term ?value (data_list_term output))\<in>positive_meaning observation_result_system \<longleftrightarrow>
      data_elements output \<and> set output=set (map observation_value_term (observation_profile_list F rows c))"
    if valid: "data_elements F \<and> observation_datum c \<and> observation_rows_data rows"
  proof -
    have rows: "observation_rows_data rows" using valid by blast
    have data: "data_elements (map observation_value_term (observation_profile_list F rows c))"
      by (rule observation_profile_data[OF rows])
    show ?thesis using data
      by (simp only: observation_result_components data_set_comparison_lists) auto
  qed
  show ?thesis using observation_profile_comparison.at_determined_result[OF computation comparison]
    by blast
qed

lemma observation_losses_result_lists:
  "(307,context_relation_argument (Pair_Term (data_list_term F) (Pair_Term c d))
    (data_list_term (map observation_row_term rows)) (data_list_term output))\<in>positive_meaning observation_result_system
    \<longleftrightarrow> data_elements F \<and> data_elements [c,d] \<and> observation_rows_data rows \<and>
      data_elements output \<and> set output=set (map observation_value_term (observation_losses_list F rows c d))"
proof -
  let ?input="data_list_term (map observation_row_term rows)"
  let ?value="data_list_term (map observation_value_term (observation_losses_list F rows c d))"
  have computation: "(306,context_relation_argument (Pair_Term (data_list_term F) (Pair_Term c d)) ?input w)\<in>positive_meaning observation_result_system\<longleftrightarrow>
      (data_elements F \<and> data_elements [c,d] \<and> observation_rows_data rows) \<and> w=?value" for w
    by (simp only: observation_result_components observation_encoded_losses conj_assoc)
  have comparison: "(219,Pair_Term ?value (data_list_term output))\<in>positive_meaning observation_result_system \<longleftrightarrow>
      data_elements output \<and> set output=set (map observation_value_term (observation_losses_list F rows c d))"
    if valid: "data_elements F \<and> data_elements [c,d] \<and> observation_rows_data rows"
  proof -
    have rows: "observation_rows_data rows" using valid by blast
    have data: "data_elements (map observation_value_term (observation_losses_list F rows c d))"
      using observation_profile_data[OF rows, of F c] by (auto simp: observation_losses_list_def)
    show ?thesis using data
      by (simp only: observation_result_components data_set_comparison_lists) auto
  qed
  show ?thesis using observation_losses_comparison.at_determined_result[OF computation comparison]
    by blast
qed

lemma observation_value_term_injective: "inj observation_value_term"
  by (auto simp: inj_on_def split: prod.splits)

lemma observation_values_comparison:
  assumes "\<forall>(f,w)\<in>set xs. data_elements [f,w]"
  shows "(219,Pair_Term (data_list_term (map observation_value_term xs)) q)
      \<in>positive_meaning data_set_comparison_system \<longleftrightarrow>
    observation_values_presents (fset_of_list xs) q"
proof -
  have data: "term_formed (observation_value_term z) \<and> self_contained_term (observation_value_term z)"
    if "case z of (f,w) \<Rightarrow> data_elements [f,w]" for z
    using that by (cases z) auto
  show ?thesis
    using data_set_comparison_to_list_fset[OF observation_value_term_injective assms data, of q]
    by (simp only: observation_value_graph)
qed

lemma observation_profile_values_data:
  assumes "observation_rows_data rows"
  shows "\<forall>(f,w)\<in>set (observation_profile_list F rows c). data_elements [f,w]"
  using assms by (auto simp: observation_profile_list_def split: prod.splits)

lemma observation_losses_values_data:
  assumes "observation_rows_data rows"
  shows "\<forall>(f,w)\<in>set (observation_losses_list F rows c d). data_elements [f,w]"
  using observation_profile_values_data[OF assms, of F c]
  by (auto simp: observation_losses_list_def split: prod.splits)

lemma observation_profile_result_encoded:
  "(302,context_relation_argument (Pair_Term (data_list_term F) c)
    (data_list_term (map observation_row_term rows)) q)\<in>positive_meaning observation_result_system \<longleftrightarrow>
    data_elements F \<and> observation_datum c \<and> observation_rows_data rows \<and>
    observation_values_presents (finite_candidate_profile (fset_of_list F) (fset_of_list rows) c) q"
proof -
  let ?input="data_list_term (map observation_row_term rows)"
  let ?value="data_list_term (map observation_value_term (observation_profile_list F rows c))"
  have computation: "(301,context_relation_argument (Pair_Term (data_list_term F) c) ?input w)\<in>positive_meaning observation_result_system\<longleftrightarrow>
      (data_elements F \<and> observation_datum c \<and> observation_rows_data rows) \<and> w=?value" for w
    by (simp only: observation_result_components observation_encoded_profile conj_assoc)
  have comparison: "(219,Pair_Term ?value q)\<in>positive_meaning observation_result_system \<longleftrightarrow>
      observation_values_presents (finite_candidate_profile (fset_of_list F) (fset_of_list rows) c) q"
    if valid: "data_elements F \<and> observation_datum c \<and> observation_rows_data rows"
  proof -
    have rows: "observation_rows_data rows" using valid by blast
    show ?thesis using observation_values_comparison[OF observation_profile_values_data[OF rows, of F c], of q]
      by (simp only: observation_result_components observation_profile_list_fset)
  qed
  show ?thesis using observation_profile_comparison.at_determined_result[OF computation comparison]
    by blast
qed

lemma observation_losses_result_encoded:
  "(307,context_relation_argument (Pair_Term (data_list_term F) (Pair_Term c d))
    (data_list_term (map observation_row_term rows)) q)\<in>positive_meaning observation_result_system \<longleftrightarrow>
    data_elements F \<and> data_elements [c,d] \<and> observation_rows_data rows \<and>
    observation_values_presents (finite_candidate_losses (fset_of_list F) (fset_of_list rows) c d) q"
proof -
  let ?input="data_list_term (map observation_row_term rows)"
  let ?value="data_list_term (map observation_value_term (observation_losses_list F rows c d))"
  have computation: "(306,context_relation_argument (Pair_Term (data_list_term F) (Pair_Term c d)) ?input w)\<in>positive_meaning observation_result_system\<longleftrightarrow>
      (data_elements F \<and> data_elements [c,d] \<and> observation_rows_data rows) \<and> w=?value" for w
    by (simp only: observation_result_components observation_encoded_losses conj_assoc)
  have comparison: "(219,Pair_Term ?value q)\<in>positive_meaning observation_result_system \<longleftrightarrow>
      observation_values_presents (finite_candidate_losses (fset_of_list F) (fset_of_list rows) c d) q"
    if valid: "data_elements F \<and> data_elements [c,d] \<and> observation_rows_data rows"
  proof -
    have rows: "observation_rows_data rows" using valid by blast
    show ?thesis using observation_values_comparison[OF observation_losses_values_data[OF rows, of F c d], of q]
      by (simp only: observation_result_components observation_losses_list_fset)
  qed
  show ?thesis using observation_losses_comparison.at_determined_result[OF computation comparison]
    by blast
qed

end
