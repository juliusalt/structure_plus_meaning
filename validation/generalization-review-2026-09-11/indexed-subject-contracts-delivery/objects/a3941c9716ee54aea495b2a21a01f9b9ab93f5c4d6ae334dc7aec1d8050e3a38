theory Factor_Observation_Scope_Clauses
  imports "Factor_Observation_Components" "Factor_Admitted_Context"
begin

section \<open>Each table row is checked against its declared scopes\<close>

definition observation_scope_row_schema :: "(nat,nat,nat) factor_schema" where
  "observation_scope_row_schema=data_rule
    (Pattern_Pair (Pattern_Pair data_x (Pattern_Pair data_y data_z))
      (Pattern_Pair data_w (Pattern_Pair (Pattern_Variable 4) (Pattern_Variable 5))))
    {(0,303,Pattern_Pair data_x (Pattern_Variable 4)),
     (1,303,Pattern_Pair data_y data_w),(2,2,Pattern_Variable 5)}"

definition observation_scopes_schema :: "(nat,nat,nat) factor_schema" where
  "observation_scopes_schema=data_rule (Pattern_Pair data_x (Pattern_Pair data_y data_z))
    {(0,4,data_x),(1,47,Pattern_Pair data_z data_y)}"

definition observation_scope_clause_family :: "nat \<Rightarrow> (nat\<times>(nat,nat,nat) factor_schema) set" where
  "observation_scope_clause_family d=(if d=308 then {(0,observation_scope_row_schema)}
    else if d=309 then context_list_clauses 308 309
    else if d=310 then {(0,observation_scopes_schema)}
    else if d=311 then {(0,admitted_context_schema 310 309)} else {})"

definition observation_scope_group_system :: "(nat,nat,nat,nat) schema_system" where
  "observation_scope_group_system=\<lparr>system_interfaces={(308,data_x),(309,data_x),(310,data_x),(311,data_x)},
    system_clauses={((308,0),observation_scope_row_schema),((309,0),context_list_nil_schema),
      ((309,1),context_list_step_schema 308 309),
      ((310,0),observation_scopes_schema),((311,0),admitted_context_schema 310 309)}\<rparr>"

lemma observation_scope_group_definitions [simp]:
  "system_definitions observation_scope_group_system={308,309,310,311}"
  by (auto simp: observation_scope_group_system_def system_definitions_def rel_dom_def)

lemma observation_scope_group_interfaces [simp]:
  "(d,p)\<in>system_interfaces observation_scope_group_system \<longleftrightarrow> d\<in>{308,309,310,311} \<and> p=data_x"
  by (auto simp: observation_scope_group_system_def)

lemma observation_scope_group_clauses [simp]:
  "((d,c),S)\<in>system_clauses observation_scope_group_system \<longleftrightarrow>
    d\<in>{308,309,310,311} \<and> (c,S)\<in>observation_scope_clause_family d"
  by (auto simp: observation_scope_group_system_def observation_scope_clause_family_def context_list_clauses_def)

lemma observation_scope_group_formed_over:
  "schema_system_formed_over {2,4,47,303} observation_scope_group_system"
  by (simp only: schema_system_formed_over_def observation_scope_group_definitions)
    (auto simp: observation_scope_group_system_def observation_scope_row_schema_def observation_scopes_schema_def admitted_context_schema_def
      context_list_clauses_def context_list_nil_schema_def context_list_step_schema_def
      schema_formed_def schema_dependencies_def single_valued_def rel_dom_def rel_ran_def octets_formed_def)

lemma observation_scope_external_dependencies:
  "system_external_dependencies observation_scope_group_system={2,4,47,303}"
  by (simp only: system_external_dependencies_clauses observation_scope_group_definitions)
    (auto simp: observation_scope_group_system_def observation_scope_row_schema_def observation_scopes_schema_def admitted_context_schema_def
      context_list_clauses_def context_list_nil_schema_def context_list_step_schema_def
      schema_dependencies_def rel_ran_image)

definition observation_scope_base_system :: "(nat,nat,nat,nat) schema_system" where
  "observation_scope_base_system=rooted_system observation_collection_system
    (system_external_dependencies observation_scope_group_system)"

lemma observation_scope_base_formed [simp]: "schema_system_formed observation_scope_base_system"
  unfolding observation_scope_base_system_def by (rule rooted_system_formed[OF observation_collection_formed])

lemma observation_scope_base_subdomain:
  "system_definitions observation_scope_base_system\<subseteq>system_definitions observation_collection_system"
  unfolding observation_scope_base_system_def by (rule rooted_system_subdomain)

lemma observation_scope_base_roots:
  "{2,4,47,303}\<subseteq>system_definitions observation_scope_base_system"
  unfolding observation_scope_base_system_def observation_scope_external_dependencies
  by (rule rooted_system_roots[OF observation_collection_formed])
    (use observation_base_roots data_set_comparison_base_roots in auto)

lemma observation_scope_base_least:
  assumes "{2,4,47,303}\<subseteq>U" "system_dependency_closed observation_collection_system U"
  shows "system_definitions observation_scope_base_system\<subseteq>U"
  unfolding observation_scope_base_system_def observation_scope_external_dependencies
  by (rule rooted_system_least[OF observation_collection_formed _ assms])
    (use observation_base_roots data_set_comparison_base_roots in auto)

lemma observation_scope_base_call:
  "schema_call_formed observation_scope_base_system d t \<longleftrightarrow>
    d\<in>system_definitions observation_scope_base_system \<and> term_formed t"
  unfolding observation_scope_base_system_def
  by (rule rooted_system_variable_calls[OF observation_collection_formed observation_collection_call])

interpretation observation_scope_group:
  positive_definition_group observation_scope_base_system observation_scope_group_system
proof (rule positive_definition_group.intro)
  show "schema_system_formed observation_scope_base_system" by simp
  show "schema_system_formed_over (system_definitions observation_scope_base_system) observation_scope_group_system"
    by (rule schema_system_formed_over_mono[OF observation_scope_group_formed_over observation_scope_base_roots])
  have boundary: "system_definitions observation_collection_system\<inter>{308,309,310,311}={}"
    using observation_base_subdomain data_set_comparison_base_subdomain by auto
  show "system_definitions observation_scope_base_system\<inter>system_definitions observation_scope_group_system={}"
    using boundary observation_scope_base_subdomain by auto
qed

definition observation_scope_system :: "(nat,nat,nat,nat) schema_system" where
  "observation_scope_system=system_union observation_scope_base_system observation_scope_group_system"

lemma observation_scope_system_formed [simp]: "schema_system_formed observation_scope_system"
  using observation_scope_group.formed by (simp only: observation_scope_system_def)

lemma observation_scope_definitions [simp]:
  "system_definitions observation_scope_system=system_definitions observation_scope_base_system\<union>{308,309,310,311}"
  by (simp add: observation_scope_system_def)

lemma observation_scope_call:
  "schema_call_formed observation_scope_system d t \<longleftrightarrow>
    d\<in>system_definitions observation_scope_system \<and> term_formed t"
  unfolding observation_scope_system_def
  by (rule observation_scope_group.variable_calls[where D="{308,309,310,311}" and a=0,
    OF observation_scope_base_call]) auto

lemma observation_scope_clause:
  assumes "d\<in>{308,309,310,311}"
  shows "((d,c),S)\<in>system_clauses observation_scope_system \<longleftrightarrow>
    (c,S)\<in>observation_scope_clause_family d"
  using observation_scope_group.group_clauses[of d c S] assms
  by (simp only: observation_scope_system_def observation_scope_group_clauses
    observation_scope_group_definitions; blast)

lemma observation_scope_base_meaning:
  assumes "d\<in>{2,4,47,303}"
  shows "(d,t)\<in>positive_meaning observation_scope_system \<longleftrightarrow>
    (d,t)\<in>positive_meaning observation_collection_system"
proof -
  have member: "d\<in>system_definitions observation_scope_base_system"
    using observation_scope_base_roots assms by blast
  show ?thesis using observation_scope_group.old_meaning[OF member, of t]
    rooted_system_meaning_at[OF observation_collection_formed member[unfolded observation_scope_base_system_def], of t]
    by (simp only: observation_scope_system_def observation_scope_base_system_def)
qed

end
