theory Factor_Definition_Code
  imports "Factor_Definition_Compilation" "Factor_Reference_Environments"
begin

section \<open>Finite compiler results for simultaneous program construction\<close>

record definition_code =
  code_artifact :: exact_artifact
  code_interface :: "local_address term_pattern"
  code_clauses :: "(local_address \<times> local_address option native_schema) set"
  code_literals :: "(local_address \<times> exact_artifact) set"
  code_callees :: "(local_address \<times> local_address option definition_site) set"

definition definition_code_for ::
  "'a term_pattern \<Rightarrow> ('c \<times> ('a,'s,local_address option definition_site) factor_schema) set \<Rightarrow>
    definition_code \<Rightarrow> bool" where
  "definition_code_for p Cs K \<longleftrightarrow> exact_formed (code_artifact K) \<and>
    bag_count (object_data (code_artifact K)) = (\<lambda>_. 0) \<and>
    [] \<in> rra_carrier (object_structure (code_artifact K)) \<and>
    (\<exists>f h. inj_on f (pattern_variables p) \<and> code_interface K = rename_pattern f p \<and>
      schema_family_variant h Cs (code_clauses K)) \<and>
    reference_table_formed (code_literals K) (code_callees K) \<and>
    rel_dom (code_literals K) \<union> rel_dom (code_callees K) \<subseteq> rra_carrier (object_structure (code_artifact K)) \<and>
    rel_ran (code_callees K) = (\<Union>S\<in>rel_ran Cs. schema_dependencies S) \<and>
    (\<forall>E u. environment_formed E \<longrightarrow> artifact_at E u (code_artifact K) \<longrightarrow>
      syntax_references E u (code_literals K) (code_callees K) \<longrightarrow>
      native_definition_at E u [] (code_interface K) (code_clauses K))"

lemma definition_code_properties:
  assumes "definition_code_for p Cs K"
  shows "exact_formed (code_artifact K)" "bag_count (object_data (code_artifact K)) = (\<lambda>_. 0)"
    "[] \<in> rra_carrier (object_structure (code_artifact K))"
    "\<exists>f h. inj_on f (pattern_variables p) \<and> code_interface K = rename_pattern f p \<and>
      schema_family_variant h Cs (code_clauses K)"
    "reference_table_formed (code_literals K) (code_callees K)"
    "rel_dom (code_literals K) \<union> rel_dom (code_callees K) \<subseteq> rra_carrier (object_structure (code_artifact K))"
    "rel_ran (code_callees K) = (\<Union>S\<in>rel_ran Cs. schema_dependencies S)"
    "\<forall>E u. environment_formed E \<longrightarrow> artifact_at E u (code_artifact K) \<longrightarrow>
      syntax_references E u (code_literals K) (code_callees K) \<longrightarrow>
      native_definition_at E u [] (code_interface K) (code_clauses K)"
  using assms by (auto simp: definition_code_for_def)

lemma definition_code_dependencies:
  assumes "definition_code_for p Cs K"
  shows "(\<Union>S\<in>rel_ran (code_clauses K). schema_dependencies S) = rel_ran (code_callees K)"
proof -
  obtain h where variant: "schema_family_variant h Cs (code_clauses K)"
    using definition_code_properties(4)[OF assms] by blast
  show ?thesis using schema_family_variant_dependencies[OF variant] definition_code_properties(7)[OF assms] by simp
qed

theorem definition_code_total:
  fixes p :: "'a term_pattern"
    and Cs :: "('c \<times> ('a,'s,local_address option definition_site) factor_schema) set"
  assumes pf: "pattern_formed p" and fin: "finite Cs" and sv: "single_valued Cs"
    and formed: "\<forall>S\<in>rel_ran Cs. schema_formed S"
    and addresses: "\<forall>S\<in>rel_ran Cs. \<forall>d\<in>schema_dependencies S. octets_formed (snd d)"
  shows "\<exists>K. definition_code_for p Cs K"
proof -
  obtain R :: exact_artifact and f :: "'a \<Rightarrow> local_address" and h :: "'c \<Rightarrow> local_address"
    and D :: "(local_address \<times> local_address option native_schema) set"
    and L :: "(local_address \<times> exact_artifact) set"
    and C :: "(local_address \<times> local_address option definition_site) set" where built:
    "exact_formed R" "bag_count (object_data R) = (\<lambda>_. 0)" "[] \<in> rra_carrier (object_structure R)"
    "inj_on f (pattern_variables p)" "schema_family_variant h Cs D" "reference_table_formed L C"
    "rel_dom L \<union> rel_dom C \<subseteq> rra_carrier (object_structure R)"
    "rel_ran C = (\<Union>S\<in>rel_ran Cs. schema_dependencies S)"
    "\<forall>E u. environment_formed E \<longrightarrow> artifact_at E u R \<longrightarrow> syntax_references E u L C \<longrightarrow>
      native_definition_at E u [] (rename_pattern f p) D"
    using definition_compilation_total[OF pf fin sv formed addresses] by metis
  let ?K = "\<lparr>code_artifact=R, code_interface=rename_pattern f p, code_clauses=D, code_literals=L, code_callees=C\<rparr>"
  show ?thesis by (rule exI[of _ ?K]) (use built in \<open>auto simp: definition_code_for_def\<close>)
qed

lemma definition_code_included_recovers:
  assumes code: "definition_code_for p Cs K"
    and ff: "environment_formed F" and included: "environment_included E F"
    and source: "artifact_at E u (code_artifact K)"
    and refs: "syntax_references E u (code_literals K) (code_callees K)"
  shows "native_definition_at F u [] (code_interface K) (code_clauses K)"
  using definition_code_properties(8)[OF code] ff included_artifact[OF included source]
    syntax_references_included[OF ff included refs] by blast

text \<open>
  This record packages a finite compiler result for simultaneous construction.
  Its interface and clause fields are proved projections used by the existence
  proof. They are not additional fields of native definition syntax. The native
  object is the artifact placed in its reference environment; the existing
  native reader recovers its interface and clauses there.
\<close>

end
