theory Factor_Target_Admission
  imports "Factor_Record_Admission" "Factor_Target_Values"
begin

section \<open>Whole artifacts and actual occurrence addresses\<close>

definition target_whole_schema :: "(nat,nat,nat) factor_schema" where
  "target_whole_schema=data_rule (Pattern_Pair data_x (Pattern_Payload [])) {(0,11,data_x)}"

definition target_occurrence_schema :: "(nat,nat,nat) factor_schema" where
  "target_occurrence_schema=data_rule
    (Pattern_Pair (Pattern_Pair data_x data_y) (Pattern_Pair data_z (Pattern_Payload [])))
    {(0,11,Pattern_Pair data_x data_y),(1,5,Pattern_Pair data_z (Pattern_Pair data_x data_w))}"

definition target_admission_clauses :: "(nat \<times> (nat,nat,nat) factor_schema) set" where
  "target_admission_clauses={(0,target_whole_schema),(1,target_occurrence_schema)}"

definition target_admission_system :: "(nat,nat,nat,nat) schema_system" where
  "target_admission_system=add_view_definition record_admission_system 35 data_x target_admission_clauses"

lemma target_admission_system_formed [simp]: "schema_system_formed target_admission_system"
  unfolding target_admission_system_def
  by (rule add_recursive_definition_formed[OF record_admission_system_formed])
    (auto simp: target_admission_clauses_def target_whole_schema_def target_occurrence_schema_def
      schema_formed_def schema_dependencies_def single_valued_def rel_dom_def rel_ran_def octets_formed_def)

lemma target_admission_definitions [simp]:
  "system_definitions target_admission_system=insert 35 (system_definitions record_admission_system)"
  by (simp add: target_admission_system_def)

lemma target_admission_call:
  "schema_call_formed target_admission_system d t \<longleftrightarrow>
    d\<in>system_definitions target_admission_system \<and> term_formed t"
  using added_variable_calls[OF record_admission_system_formed
    target_admission_system_formed[unfolded target_admission_system_def] record_admission_call]
  by (simp only: target_admission_system_def[symmetric])

lemma target_admission_old_meaning:
  assumes "d\<in>system_definitions record_admission_system"
  shows "(d,t)\<in>positive_meaning target_admission_system \<longleftrightarrow>
    (d,t)\<in>positive_meaning record_admission_system"
  using added_definition_preserves_old(2)[OF record_admission_system_formed
    target_admission_system_formed[unfolded target_admission_system_def], of d t] assms
  by (auto simp: target_admission_system_def)

lemma target_admission_clause [simp]:
  "((35,c),S)\<in>system_clauses target_admission_system \<longleftrightarrow> (c,S)\<in>target_admission_clauses"
proof -
  have owned: "((d,c),S)\<in>system_clauses record_admission_system \<Longrightarrow>
    d\<in>system_definitions record_admission_system" for d c S
    using record_admission_system_formed unfolding schema_system_formed_def by blast
  have absent: "((35,c),S)\<notin>system_clauses record_admission_system" by (auto dest: owned)
  show ?thesis using absent by (simp add: target_admission_system_def)
qed

lemma target_admission_headed_meaning:
  assumes "d\<in>system_definitions headed_material_system"
  shows "(d,t)\<in>positive_meaning target_admission_system \<longleftrightarrow>
    (d,t)\<in>positive_meaning headed_material_system"
  using target_admission_old_meaning[of d t] record_admission_old_meaning[of d t]
    socket_chain_old_meaning[of d t] family_admission_headed_meaning[OF assms, of t] assms by auto

lemma target_admission_components:
  "(11,t)\<in>positive_meaning target_admission_system \<longleftrightarrow> (\<exists>R. artifact_value_presents R t)"
  "(5,t)\<in>positive_meaning target_admission_system \<longleftrightarrow> (5,t)\<in>positive_meaning bag_comparison_system"
  using target_admission_headed_meaning[of 11 t] target_admission_headed_meaning[of 5 t]
    headed_material_components(1,2)[of t] by auto

lemma target_admission_valuation:
  "(35,t)\<in>positive_meaning target_admission_system \<longleftrightarrow>
    (\<exists>h::nat\<Rightarrow>factor_term. term_formed (h 0) \<and>
      t=Pair_Term (h 0) (Payload_Term []) \<and> (\<exists>R. artifact_value_presents R (h 0))) \<or>
    (\<exists>h::nat\<Rightarrow>factor_term. (\<forall>i\<in>{0,1,2,3}. term_formed (h i)) \<and>
      t=Pair_Term (Pair_Term (h 0) (h 1)) (Pair_Term (h 2) (Payload_Term [])) \<and>
      (\<exists>R. artifact_value_presents R (Pair_Term (h 0) (h 1))) \<and>
      (5,Pair_Term (h 2) (Pair_Term (h 0) (h 3)))\<in>positive_meaning bag_comparison_system)"
proof -
  have ordinary: "\<And>c S. ((35,c),S)\<in>system_clauses target_admission_system \<Longrightarrow>
    schema_material_premises S={}"
    by (auto simp: target_admission_clauses_def target_whole_schema_def target_occurrence_schema_def)
  have member: "35\<in>system_definitions target_admission_system" by simp
  let ?A="\<lambda>(S::(nat,nat,nat) factor_schema) (h::nat\<Rightarrow>factor_term).
    (\<forall>i\<in>schema_variables S. term_formed (h i)) \<and>
    t=evaluate_pattern h (schema_conclusion S) \<and> term_formed t \<and>
    (\<forall>s d p. (s,d,p)\<in>schema_premises S \<longrightarrow>
      (d,evaluate_pattern h p)\<in>positive_meaning target_admission_system)"
  have valuation: "(35,t)\<in>positive_meaning target_admission_system \<longleftrightarrow>
    (\<exists>c S. (c,S)\<in>target_admission_clauses \<and> (\<exists>h. ?A S h))"
    using ordinary_positive_entry_valuation[where P=target_admission_system and d=35 and t=t, OF ordinary]
    by (simp only: target_admission_clause target_admission_call member simp_thms ex_simps)
  have clauses: "(\<exists>c S. (c,S)\<in>target_admission_clauses \<and> P S) \<longleftrightarrow>
    P target_whole_schema \<or> P target_occurrence_schema" for P
    by (auto simp: target_admission_clauses_def)
  have whole: "?A target_whole_schema h \<longleftrightarrow>
    term_formed (h 0) \<and> t=Pair_Term (h 0) (Payload_Term []) \<and>
      (\<exists>R. artifact_value_presents R (h 0))" for h
    by (auto simp: target_whole_schema_def schema_variables_def target_admission_components octets_formed_def)
  have occurrence: "?A target_occurrence_schema h \<longleftrightarrow>
    (\<forall>i\<in>{0,1,2,3}. term_formed (h i)) \<and>
    t=Pair_Term (Pair_Term (h 0) (h 1)) (Pair_Term (h 2) (Payload_Term [])) \<and>
    (\<exists>R. artifact_value_presents R (Pair_Term (h 0) (h 1))) \<and>
    (5,Pair_Term (h 2) (Pair_Term (h 0) (h 3)))\<in>positive_meaning bag_comparison_system" for h
    by (auto simp: target_occurrence_schema_def schema_variables_def target_admission_components octets_formed_def)
  show ?thesis by (subst valuation) (simp only: clauses whole occurrence)
qed

lemma target_admission_fields:
  "(35,t)\<in>positive_meaning target_admission_system \<longleftrightarrow>
    (\<exists>R a. t=Pair_Term a (Payload_Term []) \<and> artifact_value_presents R a) \<or>
    (\<exists>R a b k. t=Pair_Term (Pair_Term a b) (Pair_Term k (Payload_Term [])) \<and>
      artifact_value_presents R (Pair_Term a b) \<and> selected_data_member k a)"
proof
  assume "(35,t)\<in>positive_meaning target_admission_system"
  then show "(\<exists>R a. t=Pair_Term a (Payload_Term []) \<and> artifact_value_presents R a) \<or>
    (\<exists>R a b k. t=Pair_Term (Pair_Term a b) (Pair_Term k (Payload_Term [])) \<and>
      artifact_value_presents R (Pair_Term a b) \<and> selected_data_member k a)"
    by (auto simp: target_admission_valuation)
next
  assume "(\<exists>R a. t=Pair_Term a (Payload_Term []) \<and> artifact_value_presents R a) \<or>
    (\<exists>R a b k. t=Pair_Term (Pair_Term a b) (Pair_Term k (Payload_Term [])) \<and>
      artifact_value_presents R (Pair_Term a b) \<and> selected_data_member k a)"
  then consider (whole) R a where "t=Pair_Term a (Payload_Term [])" "artifact_value_presents R a"
    | (occurrence) R a b k rest where
      "t=Pair_Term (Pair_Term a b) (Pair_Term k (Payload_Term []))"
      "artifact_value_presents R (Pair_Term a b)"
      "(5,Pair_Term k (Pair_Term a rest))\<in>positive_meaning bag_comparison_system" by blast
  then show "(35,t)\<in>positive_meaning target_admission_system"
  proof cases
    case whole
    have formed: "term_formed a" using artifact_value_presents_formed[OF whole(2)] by simp
    show ?thesis by (simp only: target_admission_valuation, rule disjI1, rule exI[of _ "\<lambda>_. a"])
      (use whole formed in blast)
  next
    case occurrence
    have formed: "term_formed a" "term_formed b" "term_formed k" "term_formed rest"
      using artifact_value_presents_formed[OF occurrence(2)]
        schema_call_formed_target[OF positive_meaning_formed[OF occurrence(3)]] by auto
    show ?thesis by (simp only: target_admission_valuation, rule disjI2,
      rule exI[of _ "\<lambda>i::nat. if i=0 then a else if i=1 then b else if i=2 then k else rest"])
      (use occurrence formed in auto)
  qed
qed

theorem target_admission_exact:
  "(35,t)\<in>positive_meaning target_admission_system \<longleftrightarrow> (\<exists>x. target_value_presents x t)"
proof
  assume holds: "(35,t)\<in>positive_meaning target_admission_system"
  then consider (whole) R a where "t=Pair_Term a (Payload_Term [])" "artifact_value_presents R a"
    | (occurrence) R a b k where "t=Pair_Term (Pair_Term a b) (Pair_Term k (Payload_Term []))"
      "artifact_value_presents R (Pair_Term a b)" "selected_data_member k a"
    by (simp only: target_admission_fields) blast
  then show "\<exists>x. target_value_presents x t"
  proof cases
    case whole
    show ?thesis by (rule exI[of _ "Whole_Artifact R"]) (use whole in \<open>auto simp: target_value_whole\<close>)
  next
    case occurrence
    obtain r where root: "k=Payload_Term r" "r\<in>rra_carrier (object_structure R)"
      using occurrence(3) by (simp only: artifact_carrier_selection[OF occurrence(2)]) blast
    show ?thesis by (rule exI[of _ "Occurrence_Anchor (R,r)"])
      (use occurrence root in \<open>auto simp: target_value_occurrence\<close>)
  qed
next
  assume "\<exists>x. target_value_presents x t"
  then obtain x where present: "target_value_presents x t" by blast
  show "(35,t)\<in>positive_meaning target_admission_system"
  proof (cases x)
    case (Whole_Artifact R)
    show ?thesis using present by (auto simp: Whole_Artifact target_value_whole target_admission_fields)
  next
    case (Occurrence_Anchor anchor)
    obtain R r where anchor: "anchor=(R,r)" by (cases anchor) auto
    obtain v where source: "artifact_value_presents R v"
      and shape: "t=Pair_Term v (Pair_Term (Payload_Term r) (Payload_Term []))"
      and root: "r\<in>rra_carrier (object_structure R)"
      using present by (auto simp: Occurrence_Anchor anchor target_value_occurrence)
    obtain a b where v: "v=Pair_Term a b"
      using source by (auto simp: artifact_value_presents_def artifact_data_term_def)
    have selected: "selected_data_member (Payload_Term r) a"
      using artifact_carrier_selection[OF source[unfolded v], of "Payload_Term r"] root by simp
    show ?thesis using source shape selected v by (auto simp: target_admission_fields)
  qed
qed

corollary target_admission_at_source:
  assumes source: "artifact_value_presents R a"
  shows "(35,Pair_Term a k)\<in>positive_meaning target_admission_system \<longleftrightarrow>
    (\<exists>s. k=optional_payload_term s \<and> set_option s\<subseteq>rra_carrier (object_structure R))"
proof -
  have shape: "target_value_presents x (Pair_Term a k) \<longleftrightarrow>
    target_artifact x=R \<and> target_formed x \<and> k=optional_payload_term (target_occurrence x)" for x
    using target_value_at_source[OF source, of x k] by blast
  have targets: "(\<exists>x. target_artifact x=R \<and> target_formed x \<and>
    k=optional_payload_term (target_occurrence x)) \<longleftrightarrow>
    (\<exists>s. k=optional_payload_term s \<and> set_option s\<subseteq>rra_carrier (object_structure R))"
  proof
    assume "\<exists>x. target_artifact x=R \<and> target_formed x \<and> k=optional_payload_term (target_occurrence x)"
    then obtain x where fields: "target_artifact x=R" "target_formed x" "k=optional_payload_term (target_occurrence x)" by blast
    have inside: "set_option (target_occurrence x)\<subseteq>rra_carrier (object_structure R)"
      using fields(1,2) by (cases x) (auto simp: anchor_formed_def)
    show "\<exists>s. k=optional_payload_term s \<and> set_option s\<subseteq>rra_carrier (object_structure R)"
      by (rule exI[of _ "target_occurrence x"]) (use fields(3) inside in blast)
  next
    assume "\<exists>s. k=optional_payload_term s \<and> set_option s\<subseteq>rra_carrier (object_structure R)"
    then obtain s where fields: "k=optional_payload_term s" "set_option s\<subseteq>rra_carrier (object_structure R)" by blast
    have rf: "exact_formed R" using artifact_value_presents_formed[OF source] by simp
    show "\<exists>x. target_artifact x=R \<and> target_formed x \<and> k=optional_payload_term (target_occurrence x)"
    proof (cases s)
      case None
      show ?thesis by (rule exI[of _ "Whole_Artifact R"]) (use fields rf None in simp)
    next
      case (Some r)
      show ?thesis by (rule exI[of _ "Occurrence_Anchor (R,r)"])
        (use fields rf Some in \<open>simp add: anchor_formed_def\<close>)
    qed
  qed
  show ?thesis by (simp only: target_admission_exact shape targets)
qed

corollary target_admission_presentation_invariance:
  assumes "artifact_value_presents R a" "artifact_value_presents R b"
  shows "(35,Pair_Term a k)\<in>positive_meaning target_admission_system \<longleftrightarrow>
    (35,Pair_Term b k)\<in>positive_meaning target_admission_system"
  by (simp only: target_admission_at_source[OF assms(1)] target_admission_at_source[OF assms(2)])

text \<open>
  Two ordinary clauses admit the complete artifact and, when present, select
  the exact occurrence from its actual carrier. A whole target permits an
  empty artifact. An occurrence target cannot name an absent address. The
  selected address remains opaque and no arbitrary natural-word restriction
  is introduced for environment uses.

  The contract covers every input term and every complete artifact
  presentation. All preceding entries retain their formation and meaning.
  The citation extension compiles both new admission entries together.
\<close>

end
