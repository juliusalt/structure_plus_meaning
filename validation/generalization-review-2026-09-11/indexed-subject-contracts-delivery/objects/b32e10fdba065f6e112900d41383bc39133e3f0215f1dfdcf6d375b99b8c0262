theory Factor_Investigation_Input_Contracts
  imports "Factor_Investigation_Input_Clauses" "Factor_Scope_Computation_Contracts"
begin

section \<open>Existing component classes determine every native input field\<close>

lemma investigation_input_components:
  "(2,t)\<in>positive_meaning investigation_input_system \<longleftrightarrow> data_term_boundary t"
  "(311,t)\<in>positive_meaning investigation_input_system \<longleftrightarrow> (311,t)\<in>positive_meaning observation_scope_system"
  using investigation_input_base_meaning[of 2 t] investigation_input_base_meaning[of 311 t]
    observation_scope_components(1)[of t] by auto

interpretation investigation_input_pair: admitted_pair_profile investigation_input_system 336 2 2
  by (unfold_locales) (auto simp: investigation_input_clause investigation_input_clause_family_def
    investigation_input_call admitted_data_pair_schema)

interpretation investigation_input_pairs: list_profile investigation_input_system 336 337
  by (unfold_locales) (auto simp: investigation_input_clause investigation_input_clause_family_def investigation_input_call)

interpretation investigation_input_fields: admitted_pair_profile investigation_input_system 338 311 337
  by (unfold_locales) (auto simp: investigation_input_clause investigation_input_clause_family_def investigation_input_call)

lemma investigation_input_data_class:
  "presentation_class data_term_presents data_term_boundary (\<lambda>t. (2,t)\<in>positive_meaning investigation_input_system)"
  by (simp only: investigation_input_components; rule data_term_class)

lemma investigation_input_pair_class:
  "presentation_class data_pair_presents data_pair_domain (\<lambda>t. (336,t)\<in>positive_meaning investigation_input_system)"
proof -
  have domain: "(\<lambda>z. data_term_boundary (fst z) \<and> data_term_boundary (snd z))=data_pair_domain"
    by (rule ext) (auto split: prod.splits)
  show ?thesis using investigation_input_pair.presentation_class[OF investigation_input_data_class investigation_input_data_class]
    by (simp only: domain)
qed

lemma investigation_input_pairs_class:
  "presentation_class data_pair_finite_set_presents data_pair_finite_set_domain
    (\<lambda>t. (337,t)\<in>positive_meaning investigation_input_system)"
  by (rule investigation_input_pairs.finite_set_class[OF investigation_input_pair_class])

lemma investigation_input_scope_class:
  "presentation_class observation_scope_presents observation_scope_domain
    (\<lambda>t. (311,t)\<in>positive_meaning investigation_input_system)"
  by (simp only: investigation_input_components observation_scope_admitted_class; rule observation_scope_class)

theorem investigation_input_native_class:
  "presentation_class investigation_input_presents investigation_input_domain
    (\<lambda>t. (338,t)\<in>positive_meaning investigation_input_system)"
  by (rule investigation_input_fields.presentation_class[OF investigation_input_scope_class investigation_input_pairs_class])

theorem investigation_input_exact:
  "(338,t)\<in>positive_meaning investigation_input_system \<longleftrightarrow> (\<exists>z. investigation_input_presents z t)"
  by (rule presentation_class.admissible_iff[OF investigation_input_native_class])

theorem investigation_input_presented:
  "(338,t)\<in>positive_meaning investigation_input_system \<longleftrightarrow>
    presented_predicate investigation_input_record_presents investigation_input_domain t"
  by (simp only: investigation_input_exact investigation_input_restriction presented_predicate_def; blast)

interpretation investigation_input_records: presentation_class investigation_input_record_presents
  investigation_input_record_domain "\<lambda>p. \<exists>z. investigation_input_record_presents z p"
  by (rule investigation_input_record_class)

corollary investigation_input_at:
  assumes "investigation_input_record_presents z p"
  shows "(338,p)\<in>positive_meaning investigation_input_system \<longleftrightarrow> investigation_input_domain z"
  by (simp only: investigation_input_presented investigation_input_records.predicate_at[where property=investigation_input_domain, OF assms])

corollary investigation_input_invariance:
  assumes "investigation_input_record_presents z p" "investigation_input_record_presents z q"
  shows "((338,p)\<in>positive_meaning investigation_input_system)=((338,q)\<in>positive_meaning investigation_input_system)"
  by (simp only: investigation_input_at[OF assms(1)] investigation_input_at[OF assms(2)])

section \<open>Complete enumerations expose the original whole-input boundary\<close>

lemma investigation_input_pairs_encoded:
  "(337,data_list_term (map data_pair_term relation))\<in>positive_meaning investigation_input_system \<longleftrightarrow>
    (\<forall>(c,d)\<in>set relation. data_elements [c,d])"
  by (simp only: investigation_input_pairs.lists)
    (auto simp: investigation_input_pair.at_pair investigation_input_components split: prod.splits)

lemma investigation_input_encoded:
  "(338,Pair_Term (observation_scope_argument (data_list_term C) (data_list_term U) (data_list_term F)
      (data_list_term (map observation_row_term rows))) (data_list_term (map data_pair_term relation)))
      \<in>positive_meaning investigation_input_system \<longleftrightarrow>
    investigation_input_subject_formed (fset_of_list C) (fset_of_list U) (fset_of_list F) (fset_of_list rows) (fset_of_list relation)"
  by (simp only: investigation_input_fields.at_pair investigation_input_components observation_scope_encoded
    investigation_input_pairs_encoded investigation_input_subject_lists)

lemma investigation_input_enumerated:
  assumes "investigation_input_presents z p"
  obtains C U F rows relation where
    "data_elements C" "data_elements U" "data_elements F" "observation_rows_data rows"
    "\<forall>(c,d)\<in>set relation. data_elements [c,d]"
    "z=(((fset_of_list C,(fset_of_list U,fset_of_list F)),fset_of_list rows),fset_of_list relation)"
    "p=Pair_Term (observation_scope_argument (data_list_term C) (data_list_term U) (data_list_term F)
      (data_list_term (map observation_row_term rows))) (data_list_term (map data_pair_term relation))"
    "investigation_input_subject_formed (fset_of_list C) (fset_of_list U) (fset_of_list F) (fset_of_list rows) (fset_of_list relation)"
proof -
  obtain a b where fields: "observation_scope_presents (fst z) a" "data_pair_finite_set_presents (snd z) b"
    "p=Pair_Term a b" using assms by (simp only: factor_pair_presents_def) blast
  obtain C U F rows where scope: "data_elements C" "data_elements U" "data_elements F" "observation_rows_data rows"
    "observation_scope_subject_formed (fset_of_list C) (fset_of_list U) (fset_of_list F) (fset_of_list rows)"
    "fst z=((fset_of_list C,(fset_of_list U,fset_of_list F)),fset_of_list rows)"
    "a=observation_scope_argument (data_list_term C) (data_list_term U) (data_list_term F)
      (data_list_term (map observation_row_term rows))"
    by (rule observation_scope_enumerated[OF fields(1)]) blast
  obtain relation where comparison: "\<forall>(c,d)\<in>set relation. data_elements [c,d]"
    "fset_of_list relation=snd z" "b=data_list_term (map data_pair_term relation)"
    using fields(2) by (simp only: data_pair_finite_set_fields) blast
  have subject: "z=(((fset_of_list C,(fset_of_list U,fset_of_list F)),fset_of_list rows),fset_of_list relation)"
    using scope(6) comparison(2) by (cases z) auto
  have boundary: "investigation_input_subject_formed (fset_of_list C) (fset_of_list U) (fset_of_list F) (fset_of_list rows) (fset_of_list relation)"
    using scope(5) comparison(1) by (simp only: investigation_input_subject_lists)
  show ?thesis by (rule that[OF scope(1-4) comparison(1) subject _ boundary])
    (simp only: fields(3) scope(7) comparison(3))
qed

section \<open>The whole admitted input has a quotation and one fixed native checker\<close>

theorem investigation_input_complete_quotation:
  assumes "(338,t)\<in>positive_meaning investigation_input_system"
  shows "complete_data_quoted_at (term_syntax t) [] t"
proof -
  obtain p q where parts: "t=Pair_Term p q" "(311,p)\<in>positive_meaning observation_scope_system"
    "(337,q)\<in>positive_meaning investigation_input_system"
    using assms by (simp only: investigation_input_fields.exact investigation_input_components) blast
  have source: "complete_data_quoted_at (term_syntax p) [] p" by (rule observation_scope_complete_quotation[OF parts(2)])
  have target: "data_term_boundary q"
    using parts(3) presentation_class.admitted[OF investigation_input_pairs_class]
      data_pair_finite_set_presented_data by blast
  have data: "term_formed t" "self_contained_term t"
    using complete_data_quotation_formed[OF source] target by (auto simp only: parts(1) term_formed.simps self_contained_term.simps)
  show ?thesis using complete_data_quotation_total[OF data] by blast
qed

theorem native_investigation_input:
  "\<exists>E :: local_address option artifact_environment. \<exists>pu Q g.
    closed_native_package_at E pu [] Q \<and> native_package_environment E pu []=E \<and>
    inj_on g {338::nat} \<and>
    (\<forall>d\<in>{338}. \<forall>t. term_formed t \<longrightarrow>
      (\<exists>F au I K. environment_formed F \<and> environment_included E F \<and> au\<notin>environment_uses E \<and>
        native_package_at F pu [] Q \<and> native_application_at F au [] (g d) t I K \<and>
        native_package_environment F pu []=E \<and> native_application_formed F pu [] au [] \<and>
        (native_positive_holds F pu [] au [] \<longleftrightarrow> (\<exists>z. investigation_input_presents z t)) \<and>
        (\<forall>v\<in>environment_uses E. \<forall>R. artifact_at F v R \<longleftrightarrow> artifact_at E v R) \<and>
        (\<forall>v\<in>environment_uses E. \<forall>k w. binds_slot F v k w \<longleftrightarrow> binds_slot E v k w)))"
proof -
  have selected: "{338}\<subseteq>system_definitions investigation_input_system" by auto
  have calls: "schema_call_formed investigation_input_system d t \<longleftrightarrow> term_formed t"
    if "d\<in>{338}" for d t using investigation_input_call[of d t] selected that by blast
  have result: "(d,t)\<in>positive_meaning investigation_input_system \<longleftrightarrow> (\<exists>z. investigation_input_presents z t)"
    if "d\<in>{338}" for d t using that by (simp only: singleton_iff investigation_input_exact; blast)
  show ?thesis by (rule compiled_exact_operations[OF investigation_input_system_formed selected calls result])
qed

text \<open>
  Native field and list admission consume complete locally owned classes.
  The resulting predicate is exact on every term. On the broader class of
  complete data records it preserves both admission and refusal, including
  failed facet inclusion or observation scope. Comparison endpoints retain
  their data boundary without an additional candidate-scope restriction.
  The whole query is quoted, and one closed native package precedes every
  future formed input. Mathematical-proof checking remains a further task.
\<close>

