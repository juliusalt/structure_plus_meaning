theory Presentation_Function_Witnesses
  imports "Presentation_Contract_Constructions"
begin

section \<open>A returned witness has a complete subject boundary\<close>

locale presented_function_witness =
  left: presentation_class R D A + right: presentation_class S E B
  for R :: "'a \<Rightarrow> 'p \<Rightarrow> bool" and D A
    and S :: "'b \<Rightarrow> 'q \<Rightarrow> bool" and E B +
  fixes f :: "'a \<Rightarrow> 'b" and operation :: "'p \<Rightarrow> 'q \<Rightarrow> bool"
  assumes input_boundary: "\<And>p q. operation p q \<Longrightarrow> A p"
    and sound: "\<And>a p q. R a p \<Longrightarrow> operation p q \<Longrightarrow> S (f a) q"
    and total: "\<And>p. A p \<Longrightarrow> \<exists>q. operation p q"
begin

theorem input_exact:
  "(\<exists>q. operation p q) \<longleftrightarrow> A p"
  using input_boundary total by blast

lemma image_boundary:
  assumes "D a"
  shows "E (f a)"
proof -
  obtain p where read: "R a p" using left.total[OF assms] by blast
  obtain q where result: "operation p q" using total[OF left.presentation_boundary[OF read]] by blast
  show ?thesis by (rule right.subject_boundary[OF sound[OF read result]])
qed

lemma output_boundary:
  assumes "operation p q"
  shows "B q"
proof -
  obtain a where read: "R a p" using left.admitted[OF input_boundary[OF assms]] by blast
  show ?thesis by (rule right.presentation_boundary[OF sound[OF read assms]])
qed

theorem output_equivalence:
  assumes "operation p q" "operation p r"
  shows "presentation_transport S S q r"
proof -
  obtain a where read: "R a p" using left.admitted[OF input_boundary[OF assms(1)]] by blast
  show ?thesis using sound[OF read assms(1)] sound[OF read assms(2)]
    by (auto simp: presentation_transport_def)
qed

section \<open>A complete downstream relation consumes any returned witness\<close>

theorem postrelation:
  assumes following: "presented_relation_contract S E B T F C L check"
  shows "presented_relation_contract R D A T F C (\<lambda>a c. L (f a) c)
    (\<lambda>p r. \<exists>q. operation p q \<and> check q r)"
proof -
  interpret following: presented_relation_contract S E B T F C L check by (rule following)
  have exact: "(\<exists>q. operation p q \<and> check q r) \<longleftrightarrow>
      presented_relation R T (\<lambda>a c. L (f a) c) p r" for p r
  proof
    assume "\<exists>q. operation p q \<and> check q r"
    then obtain q where run: "operation p q" and checked: "check q r" by blast
    obtain a where read: "R a p" using left.admitted[OF input_boundary[OF run]] by blast
    have result: "S (f a) q" by (rule sound[OF read run])
    obtain c where target: "T c r" and link: "L (f a) c"
      using checked by (simp only: following.at_source[OF result]; blast)
    show "presented_relation R T (\<lambda>a c. L (f a) c) p r"
      using read target link by (auto simp: presented_relation_def)
  next
    assume "presented_relation R T (\<lambda>a c. L (f a) c) p r"
    then obtain a c where read: "R a p" and target: "T c r" and link: "L (f a) c"
      by (auto simp: presented_relation_def)
    obtain q where run: "operation p q" using total[OF left.presentation_boundary[OF read]] by blast
    have result: "S (f a) q" by (rule sound[OF read run])
    have checked: "check q r" using link by (simp only: following.at[OF result target])
    show "\<exists>q. operation p q \<and> check q r" using run checked by blast
  qed
  show ?thesis using left.presentation_class_axioms following.right.presentation_class_axioms exact
    by (simp add: presented_relation_contract_def presented_relation_contract_axioms_def)
qed

theorem postcompose:
  assumes following: "presented_function_contract S E B T F C g check"
  shows "presented_function_contract R D A T F C (g\<circ>f)
    (\<lambda>p r. \<exists>q. operation p q \<and> check q r)"
proof -
  interpret following: presented_function_contract S E B T F C g check by (rule following)
  show ?thesis using postrelation[OF following.presented_relation_contract_axioms]
    image_boundary following.image_boundary
    by (simp add: presented_function_contract_def presented_function_contract_axioms_def)
qed

theorem completion:
  "presented_function_contract R D A S E B f
    (\<lambda>p r. \<exists>q. operation p q \<and> presentation_transport S S q r)"
  using postcompose[OF presentation_identity_function[OF right.presentation_class_axioms
      right.presentation_class_axioms]] by simp

theorem completion_by_comparison:
  assumes comparison: "\<And>b q r. S b q \<Longrightarrow> (check q r \<longleftrightarrow> S b r)"
  shows "presented_function_contract R D A S E B f (\<lambda>p r. \<exists>q. operation p q \<and> check q r)"
proof -
  have transport: "presentation_transport S S q r \<longleftrightarrow> S b r" if "S b q" for b q r
    using presented_function_contract.output[OF presentation_identity_function[
      OF right.presentation_class_axioms right.presentation_class_axioms] that] by simp
  have checked: "check q r \<longleftrightarrow> presentation_transport S S q r"
    if run: "operation p q" for p q r
  proof -
    obtain a where source: "R a p" using left.admitted[OF input_boundary[OF run]] by blast
    have computed: "S (f a) q" by (rule sound[OF source run])
    show ?thesis by (simp only: comparison[OF computed] transport[OF computed])
  qed
  have same: "(\<lambda>p r. \<exists>q. operation p q \<and> check q r)=
      (\<lambda>p r. \<exists>q. operation p q \<and> presentation_transport S S q r)"
    by (intro ext) (use checked in blast)
  show ?thesis using completion by (simp only: same)
qed

theorem predicate_transfer:
  assumes check: "\<And>b q. S b q \<Longrightarrow> (test q \<longleftrightarrow> L b)"
  shows "(\<exists>q. operation p q \<and> test q) \<longleftrightarrow>
    presented_predicate R (\<lambda>a. L (f a)) p"
proof
  assume "\<exists>q. operation p q \<and> test q"
  then obtain q where run: "operation p q" and checked: "test q" by blast
  obtain a where read: "R a p" using left.admitted[OF input_boundary[OF run]] by blast
  have link: "L (f a)" using checked check[OF sound[OF read run]] by blast
  show "presented_predicate R (\<lambda>a. L (f a)) p"
    using read link by (auto simp: presented_predicate_def)
next
  assume "presented_predicate R (\<lambda>a. L (f a)) p"
  then obtain a where read: "R a p" and link: "L (f a)" by (auto simp: presented_predicate_def)
  obtain q where run: "operation p q" using total[OF left.presentation_boundary[OF read]] by blast
  have checked: "test q" using link check[OF sound[OF read run]] by blast
  show "\<exists>q. operation p q \<and> test q" using run checked by blast
qed

section \<open>Restrictions and actual presentation changes remain local\<close>

theorem specialization:
  assumes boundary: "\<And>a. K a \<Longrightarrow> D a"
  shows "presented_function_witness (\<lambda>a p. K a \<and> R a p) K
    (presented_predicate R K) S E B f
    (\<lambda>p q. presented_predicate R K p \<and> operation p q)"
proof -
  have source: "presentation_class (\<lambda>a p. K a \<and> R a p) K (presented_predicate R K)"
    using presentation_class_subdomain[OF left.presentation_class_axioms boundary]
    by (simp only: presentation_class_def presented_predicate_def conj_commute)
  show ?thesis
  proof (rule presented_function_witness.intro[OF source right.presentation_class_axioms]; unfold_locales)
    fix p q assume "presented_predicate R K p \<and> operation p q"
    then show "presented_predicate R K p" by blast
  next
    fix a p q assume "K a \<and> R a p" "presented_predicate R K p \<and> operation p q"
    then show "S (f a) q" using sound by blast
  next
    fix p assume "presented_predicate R K p"
    then obtain a where read: "R a p" and selected: "K a" by (auto simp: presented_predicate_def)
    obtain q where run: "operation p q" using total[OF left.presentation_boundary[OF read]] by blast
    show "\<exists>q. presented_predicate R K p \<and> operation p q"
      using read selected run by (auto simp: presented_predicate_def)
  qed
qed

theorem output_restriction:
  assumes boundary: "\<And>b. K b \<Longrightarrow> E b"
    and image: "\<And>a. D a \<Longrightarrow> K (f a)"
  shows "presented_function_witness R D A (\<lambda>b q. K b \<and> S b q) K
    (presented_predicate S K) f operation"
proof -
  have target: "presentation_class (\<lambda>b q. K b \<and> S b q) K (presented_predicate S K)"
    using presentation_class_subdomain[OF right.presentation_class_axioms boundary]
    by (simp only: presentation_class_def presented_predicate_def conj_commute)
  show ?thesis using left.presentation_class_axioms target input_boundary sound total
    image left.subject_boundary
    by (unfold_locales) (auto simp: presentation_class_def)
qed

theorem input_presentation:
  assumes change: "presentation_class H X Y" and boundary: "\<And>p. A p \<Longrightarrow> X p"
  shows "presented_function_witness (composed_presentation R H) D
    (\<lambda>p. Y p \<and> (\<exists>x. A x \<and> H x p)) S E B f
    (\<lambda>p q. \<exists>x. H x p \<and> operation x q)"
proof -
  interpret change: presentation_class H X Y by (rule change)
  have source: "presentation_class (composed_presentation R H) D
      (\<lambda>p. Y p \<and> (\<exists>x. A x \<and> H x p))"
    by (rule presentation_class_compose_on[OF left.presentation_class_axioms change boundary])
  show ?thesis
  proof (rule presented_function_witness.intro[OF source right.presentation_class_axioms]; unfold_locales)
    fix p q assume "\<exists>x. H x p \<and> operation x q"
    then show "Y p \<and> (\<exists>x. A x \<and> H x p)"
      using input_boundary change.presentation_boundary by blast
  next
    fix a p q assume read: "composed_presentation R H a p"
      and run: "\<exists>x. H x p \<and> operation x q"
    obtain x y where parts: "R a x" "H x p" "H y p" "operation y q"
      using read run by (auto simp: composed_presentation_def)
    have same: "x=y" by (rule change.recovery[OF parts(2,3)])
    show "S (f a) q" using sound[OF parts(1)] parts(4) same by blast
  next
    fix p assume "Y p \<and> (\<exists>x. A x \<and> H x p)"
    then show "\<exists>q. \<exists>x. H x p \<and> operation x q" using total by blast
  qed
qed

section \<open>Commuting images transfer whole operations\<close>

theorem images:
  assumes source_boundary: "\<And>a. D a \<Longrightarrow> D' (h a)"
    and source_coverage: "\<And>u. D' u \<Longrightarrow> \<exists>a. D a \<and> h a=u"
    and target_boundary: "\<And>b. E b \<Longrightarrow> E' (k b)"
    and target_coverage: "\<And>v. E' v \<Longrightarrow> \<exists>b. E b \<and> k b=v"
    and commute: "\<And>a. D a \<Longrightarrow> k (f a)=g (h a)"
  shows "presented_function_witness (\<lambda>u p. \<exists>a. R a p \<and> h a=u) D' A
    (\<lambda>v q. \<exists>b. S b q \<and> k b=v) E' B g operation"
proof -
  have source: "presentation_class (\<lambda>u p. \<exists>a. R a p \<and> h a=u) D' A"
    by (rule presentation_class_image[where f=h and E=D', OF left.presentation_class_axioms])
      (rule source_boundary, assumption, rule source_coverage, assumption)
  have target: "presentation_class (\<lambda>v q. \<exists>b. S b q \<and> k b=v) E' B"
    by (rule presentation_class_image[where f=k and E=E', OF right.presentation_class_axioms])
      (rule target_boundary, assumption, rule target_coverage, assumption)
  show ?thesis
  proof (rule presented_function_witness.intro[OF source target]; unfold_locales)
    fix p q assume "operation p q"
    then show "A p" by (rule input_boundary)
  next
    fix u p q assume read: "\<exists>a. R a p \<and> h a=u" and run: "operation p q"
    then obtain a where source: "R a p" and image: "h a=u" by blast
    have result: "S (f a) q" by (rule sound[OF source run])
    have square: "k (f a)=g u" using commute[OF left.subject_boundary[OF source]] image by simp
    show "\<exists>b. S b q \<and> k b=g u" using result square by blast
  next
    fix p assume "A p"
    then show "\<exists>q. operation p q" by (rule total)
  qed
qed

end

context presented_function_contract
begin

theorem witness:
  "presented_function_witness R D A S E B f operation"
  using left.presentation_class_axioms right.presentation_class_axioms boundaries "output" total
  by (unfold_locales) (auto simp: presentation_class_def)

end

theorem literal_copy_witness:
  assumes source: "presentation_class R D A"
  shows "presented_function_witness R D A R D A id (\<lambda>p q. A p \<and> q=p)"
  using source by (unfold_locales) (auto simp: presentation_class_def)

theorem returned_witness_need_not_cover_every_output:
  "presented_function_witness (\<lambda>_::unit. \<lambda>_::bool. True) (\<lambda>_. True) (\<lambda>_. True)
    (\<lambda>_::unit. \<lambda>_::bool. True) (\<lambda>_. True) (\<lambda>_. True) id (=) \<and>
    \<not>presented_function_contract (\<lambda>_::unit. \<lambda>_::bool. True) (\<lambda>_. True) (\<lambda>_. True)
      (\<lambda>_::unit. \<lambda>_::bool. True) (\<lambda>_. True) (\<lambda>_. True) id (=)"
proof -
  have source: "presentation_class (\<lambda>_::unit. \<lambda>_::bool. True) (\<lambda>_. True) (\<lambda>_. True)"
    by (simp add: presentation_class_def)
  show ?thesis using literal_copy_witness[OF source] literal_copy_contract_iff[OF source]
    by (simp add: eq_commute fun_eq_iff; metis bool.distinct(1))
qed

theorem raw_tests_still_need_presentation_invariance:
  "(\<exists>q::bool. True=q \<and> q) \<and> \<not>(\<exists>q::bool. False=q \<and> q)"
  by (rule conjI, rule exI[of _ True]) auto

text \<open>
  The source and target remain complete presentation classes. A witness
  operation returns at least one presentation for every admitted input and
  every returned presentation has the independently specified value. It need
  not return every presentation of that value. Literal copying illustrates
  the distinction without changing either class or its subject domain.

  A complete downstream relation sees the recovered value of any returned
  witness. Existential composition therefore has the complete relation
  contract. Semantic identity completes the output correspondence as a special
  case. The predicate rule requires an independently justified observation;
  an arbitrary test of the copied boolean still distinguishes presentations.

  Restrictions retain their exact domains. An actual change of presentation
  uses the intermediate class's recovery, rather than silently allowing a
  different raw source. Covered images preserve the operation when the
  subject maps commute. Forgetting sequence order is one such image; the
  resulting operation can remain sound and total while its output order
  continues to depend on the supplied input presentation.
\<close>

end
