theory Factor_Pattern_Forests
  imports "Factor_Pattern_Encoding" "RRA_Bound_Forests"
begin

section \<open>Finite collections of bodies sharing one declared scope\<close>

definition pattern_forest_variables :: "'a term_pattern list \<Rightarrow> 'a set" where
  "pattern_forest_variables ps = (\<Union>p\<in>set ps. pattern_variables p)"

lemma pattern_forest_variables_simps [simp]:
  "pattern_forest_variables [] = {}"
  "pattern_forest_variables (p#ps) = pattern_variables p \<union> pattern_forest_variables ps"
  by (auto simp: pattern_forest_variables_def)

lemma pattern_forest_variables_finite [simp]: "finite (pattern_forest_variables ps)"
  by (simp add: pattern_forest_variables_def)

fun pattern_forest_syntax :: "('a \<Rightarrow> local_address) \<Rightarrow> 'a term_pattern list \<Rightarrow> exact_artifact" where
  "pattern_forest_syntax f [] = empty_artifact"
| "pattern_forest_syntax f (p#ps) = bound_union (pattern_syntax f p) (pattern_forest_syntax f ps)"

fun pattern_forest_interior :: "'a term_pattern list \<Rightarrow> local_address set" where
  "pattern_forest_interior [] = {}"
| "pattern_forest_interior (p#ps) = Cons 2 ` pattern_syntax_interior p \<union> Cons 3 ` pattern_forest_interior ps"

fun pattern_forest_bindings :: "'a term_pattern list \<Rightarrow> (local_address \<times> exact_artifact) set" where
  "pattern_forest_bindings [] = {}"
| "pattern_forest_bindings (p#ps) =
    (\<lambda>(k,R). (2#k,R)) ` pattern_literal_bindings p \<union>
    (\<lambda>(k,R). (3#k,R)) ` pattern_forest_bindings ps"

fun pattern_forest_roots :: "'a term_pattern list \<Rightarrow> local_address list" where
  "pattern_forest_roots [] = []"
| "pattern_forest_roots (p#ps) = [2] # map (Cons 3) (pattern_forest_roots ps)"

lemma pattern_forest_slots [simp]:
  "rel_dom (pattern_forest_bindings []) = {}"
  "rel_dom (pattern_forest_bindings (p#ps)) =
    Cons 2 ` rel_dom (pattern_literal_bindings p) \<union> Cons 3 ` rel_dom (pattern_forest_bindings ps)"
  by (auto simp: rel_dom_def intro: rev_image_eqI)

lemma pattern_forest_bindings_finite [simp]: "finite (pattern_forest_bindings ps)"
  by (induction ps) auto

lemma pattern_forest_bindings_functional:
  "single_valued (pattern_forest_bindings ps)"
proof (induction ps)
  case Nil
  show ?case by (simp add: single_valued_def)
next
  case (Cons p ps)
  have head: "single_valued (pattern_literal_bindings p)" by (rule pattern_literal_bindings_functional)
  show ?case using head Cons.IH by (auto simp: single_valued_def)
qed

lemma pattern_forest_bindings_formed:
  assumes "\<forall>p\<in>set ps. pattern_formed p"
  shows "\<forall>k R. (k,R) \<in> pattern_forest_bindings ps \<longrightarrow> exact_formed R"
  using assms
proof (induction ps)
  case Nil
  show ?case by simp
next
  case (Cons p ps)
  have pf: "pattern_formed p" and tail: "\<forall>p\<in>set ps. pattern_formed p" using Cons.prems by auto
  have head: "\<forall>k R. (k,R) \<in> pattern_literal_bindings p \<longrightarrow> exact_formed R"
    by (rule pattern_literal_bindings_formed[OF pf])
  show ?case using head Cons.IH[OF tail] by auto
qed

lemma pattern_forest_interior_finite [simp]: "finite (pattern_forest_interior ps)"
  by (induction ps) (simp_all add: pattern_syntax_interior_finite)

lemma pattern_forest_interior_outside:
  "pattern_forest_interior ps \<inter> binder_addresses = {}"
  by (cases ps) auto

lemma pattern_forest_slots_outside:
  "rel_dom (pattern_forest_bindings ps) \<inter> binder_addresses = {}"
  by (cases ps; simp only: pattern_forest_slots; auto)

lemma pattern_forest_slot_boundary:
  "pattern_forest_interior ps \<inter> rel_dom (pattern_forest_bindings ps) = {}"
proof (induction ps)
  case Nil
  show ?case by simp
next
  case (Cons p ps)
  show ?case using Cons.IH pattern_syntax_slot_boundary[of p]
    by (simp only: pattern_forest_interior.simps pattern_forest_slots) auto
qed

lemma pattern_forest_roots_inside:
  "set (pattern_forest_roots ps) \<subseteq> pattern_forest_interior ps"
  by (induction ps) (use pattern_syntax_interior_root in auto)

lemma pattern_forest_no_counts [simp]:
  "bag_count (object_data (pattern_forest_syntax f ps)) = (\<lambda>_. 0)"
  by (cases ps) (simp_all add: empty_artifact_def empty_basis_def)

lemma pattern_forest_silent [simp]: "binder_silent (pattern_forest_syntax f ps)"
  by (induction ps) (auto intro: bound_union_silent)

lemma pattern_forest_formed:
  assumes formed: "\<forall>p\<in>set ps. pattern_formed p"
    and addressing: "binder_addressing (pattern_forest_variables ps) f"
  shows "exact_formed (pattern_forest_syntax f ps)"
  using formed addressing
proof (induction ps)
  case Nil
  show ?case by simp
next
  case (Cons p ps)
  have pf: "pattern_formed p" and tail_formed: "\<forall>q\<in>set ps. pattern_formed q"
    using Cons.prems(1) by auto
  have paddr: "binder_addressing (pattern_variables p) f"
    and tail_addr: "binder_addressing (pattern_forest_variables ps) f"
    by (rule binder_addressing_mono[OF Cons.prems(2)], simp)+
  have left: "exact_formed (pattern_syntax f p)" by (rule pattern_syntax_formed[OF pf paddr])
  have right: "exact_formed (pattern_forest_syntax f ps)" by (rule Cons.IH[OF tail_formed tail_addr])
  show ?case using bound_union_formed[OF left right] by simp
qed

lemma pattern_forest_carrier:
  assumes addressing: "binder_addressing (pattern_forest_variables ps) f"
  shows "rra_carrier (object_structure (pattern_forest_syntax f ps)) =
    pattern_forest_interior ps \<union> rel_dom (pattern_forest_bindings ps) \<union> f ` pattern_forest_variables ps"
  using addressing
proof (induction ps)
  case Nil
  show ?case by (simp add: empty_artifact_def rel_dom_def)
next
  case (Cons p ps)
  have paddr: "binder_addressing (pattern_variables p) f"
    and tail_addr: "binder_addressing (pattern_forest_variables ps) f"
    by (rule binder_addressing_mono[OF Cons.prems], simp)+
  have pb: "f ` pattern_variables p \<subseteq> binder_addresses"
    and tb: "f ` pattern_forest_variables ps \<subseteq> binder_addresses"
    using paddr tail_addr by (auto simp: binder_addressing_def)
  have left: "syntax_prefix 2 ` rra_carrier (object_structure (pattern_syntax f p)) =
    Cons 2 ` pattern_syntax_interior p \<union> Cons 2 ` rel_dom (pattern_literal_bindings p) \<union> f ` pattern_variables p"
    by (simp only: pattern_syntax_carrier[OF paddr] image_Un
        syntax_prefix_image_outside[OF pattern_syntax_interior_outside]
        syntax_prefix_image_outside[OF pattern_literal_slots_outside]
        syntax_prefix_image_binders[OF pb])
  have right: "syntax_prefix 3 ` rra_carrier (object_structure (pattern_forest_syntax f ps)) =
    Cons 3 ` pattern_forest_interior ps \<union> Cons 3 ` rel_dom (pattern_forest_bindings ps) \<union>
      f ` pattern_forest_variables ps"
    by (simp only: Cons.IH[OF tail_addr] image_Un
        syntax_prefix_image_outside[OF pattern_forest_interior_outside]
        syntax_prefix_image_outside[OF pattern_forest_slots_outside]
        syntax_prefix_image_binders[OF tb])
  show ?case
    by (simp only: pattern_forest_syntax.simps pattern_forest_interior.simps pattern_forest_slots
        pattern_forest_variables_simps) (auto simp: bound_union_def left right image_Un)
qed

definition pattern_forest_environment ::
  "('a \<Rightarrow> local_address) \<Rightarrow> 'a term_pattern list \<Rightarrow> local_address option artifact_environment" where
  "pattern_forest_environment f ps = literal_environment (pattern_forest_syntax f ps) (pattern_forest_bindings ps)"

lemma pattern_forest_environment_formed:
  assumes "\<forall>p\<in>set ps. pattern_formed p" "binder_addressing (pattern_forest_variables ps) f"
  shows "environment_formed (pattern_forest_environment f ps)"
  unfolding pattern_forest_environment_def
  by (rule literal_environment_formed[OF pattern_forest_formed[OF assms]
        pattern_forest_bindings_finite pattern_forest_bindings_functional
        pattern_forest_bindings_formed[OF assms(1)]])
     (auto simp: pattern_forest_carrier[OF assms(2)])

lemma pattern_forest_environment_source [simp]:
  "artifact_at (pattern_forest_environment f ps) None (pattern_forest_syntax f ps)"
  by (simp add: pattern_forest_environment_def)

lemma pattern_forest_environment_slots [simp]:
  "external_slot_values (pattern_forest_environment f ps) None k = {R. (k,R) \<in> pattern_forest_bindings ps}"
  by (simp add: pattern_forest_environment_def)

lemma pattern_forest_cons_slots:
  assumes "k \<notin> binder_addresses"
  shows "external_slot_values (pattern_forest_environment f (p#ps)) None (syntax_prefix 2 k) =
      external_slot_values (pattern_environment f p) None k"
    "external_slot_values (pattern_forest_environment f (p#ps)) None (syntax_prefix 3 k) =
      external_slot_values (pattern_forest_environment f ps) None k"
  using assms by (auto simp: syntax_prefix_def)

lemma pattern_forest_roots_prefix:
  "map (syntax_prefix n) (pattern_forest_roots ps) = map (Cons n) (pattern_forest_roots ps)"
proof (rule map_cong[OF refl])
  fix a assume member: "a \<in> set (pattern_forest_roots ps)"
  have outside: "a \<notin> binder_addresses"
    using pattern_forest_roots_inside[of ps] pattern_forest_interior_outside[of ps] member by blast
  show "syntax_prefix n a = n#a" using outside by (simp add: syntax_prefix_def)
qed

lemma pattern_forest_renamed_prefix:
  assumes addressing: "binder_addressing (pattern_forest_variables ps) f"
  shows "map (rename_pattern (syntax_prefix n)) (map (rename_pattern f) ps) = map (rename_pattern f) ps"
proof -
  have each: "\<And>p. p \<in> set ps \<Longrightarrow>
    rename_pattern (syntax_prefix n) (rename_pattern f p) = rename_pattern f p"
  proof -
    fix p assume member: "p \<in> set ps"
    have paddr: "binder_addressing (pattern_variables p) f"
      by (rule binder_addressing_mono[OF addressing])
         (use member in \<open>auto simp: pattern_forest_variables_def\<close>)
    show "rename_pattern (syntax_prefix n) (rename_pattern f p) = rename_pattern f p"
      by (rule renamed_pattern_prefix[OF paddr])
  qed
  show ?thesis by (simp only: map_map) (rule map_cong[OF refl], use each in simp)
qed

theorem pattern_forest_recovers:
  assumes formed: "\<forall>p\<in>set ps. pattern_formed p"
    and addressing: "binder_addressing (pattern_forest_variables ps) f"
    and scope: "f ` pattern_forest_variables ps \<subseteq> V" and boundary: "V \<subseteq> binder_addresses"
  shows "pattern_vector_at (pattern_forest_environment f ps) None V (pattern_forest_roots ps)
    (map (rename_pattern f) ps) (pattern_forest_interior ps) (rel_dom (pattern_forest_bindings ps))"
  using formed addressing scope
proof (induction ps)
  case Nil
  have ef: "environment_formed (pattern_forest_environment f [])"
    by (rule pattern_forest_environment_formed[OF Nil.prems(1,2)])
  show ?case using pattern_vector_at.empty[OF ef, of None V] by (simp add: rel_dom_def)
next
  case (Cons p ps)
  let ?E = "pattern_forest_environment f (p#ps)"
  let ?R = "pattern_forest_syntax f (p#ps)"
  have pf: "pattern_formed p" and tail_formed: "\<forall>q\<in>set ps. pattern_formed q"
    using Cons.prems(1) by auto
  have paddr: "binder_addressing (pattern_variables p) f"
    and tail_addr: "binder_addressing (pattern_forest_variables ps) f"
    by (rule binder_addressing_mono[OF Cons.prems(2)], simp)+
  have pscope: "f ` pattern_variables p \<subseteq> V"
    and tail_scope: "f ` pattern_forest_variables ps \<subseteq> V"
    using Cons.prems(3) by auto
  have ef: "environment_formed ?E" by (rule pattern_forest_environment_formed[OF Cons.prems(1,2)])
  have art: "artifact_at ?E None ?R" by (simp add: pattern_forest_environment_def)
  have left_addressing: "finite_addressing (rra_carrier (object_structure (pattern_syntax f p))) (syntax_prefix 2)"
    by (rule syntax_prefix_addressing[OF pattern_syntax_formed[OF pf paddr]]) simp_all
  have right_addressing: "finite_addressing (rra_carrier (object_structure (pattern_forest_syntax f ps))) (syntax_prefix 3)"
    by (rule syntax_prefix_addressing[OF pattern_forest_formed[OF tail_formed tail_addr]]) simp_all
  have left_reads: "object_reads_agree (push_object (syntax_prefix 2) (pattern_syntax f p)) ?R
    (syntax_prefix 2 ` pattern_syntax_interior p)"
    by (simp only: pattern_forest_syntax.simps;
        rule object_reads_agree_mono[OF bound_union_reads_left[OF pattern_syntax_no_counts pattern_forest_silent]])
       (auto simp: pattern_syntax_carrier[OF paddr])
  have right_reads: "object_reads_agree (push_object (syntax_prefix 3) (pattern_forest_syntax f ps)) ?R
    (syntax_prefix 3 ` pattern_forest_interior ps)"
    by (simp only: pattern_forest_syntax.simps;
        rule object_reads_agree_mono[OF bound_union_reads_right[OF pattern_forest_no_counts pattern_syntax_silent]])
       (auto simp: pattern_forest_carrier[OF tail_addr])
  have left_slots: "\<forall>k\<in>rel_dom (pattern_literal_bindings p).
    external_slot_values (pattern_environment f p) None k = external_slot_values ?E None (syntax_prefix 2 k)"
  proof (intro ballI)
    fix k assume member: "k \<in> rel_dom (pattern_literal_bindings p)"
    have outside: "k \<notin> binder_addresses" using pattern_literal_slots_outside[of p] member by blast
    show "external_slot_values (pattern_environment f p) None k = external_slot_values ?E None (syntax_prefix 2 k)"
      using pattern_forest_cons_slots(1)[OF outside, where f=f and p=p and ps=ps] by simp
  qed
  have right_slots: "\<forall>k\<in>rel_dom (pattern_forest_bindings ps).
    external_slot_values (pattern_forest_environment f ps) None k = external_slot_values ?E None (syntax_prefix 3 k)"
  proof (intro ballI)
    fix k assume member: "k \<in> rel_dom (pattern_forest_bindings ps)"
    have outside: "k \<notin> binder_addresses" using pattern_forest_slots_outside[of ps] member by blast
    show "external_slot_values (pattern_forest_environment f ps) None k = external_slot_values ?E None (syntax_prefix 3 k)"
      using pattern_forest_cons_slots(2)[OF outside, where f=f and p=p and ps=ps] by simp
  qed
  have left_inj: "inj (syntax_prefix 2)" by (rule syntax_prefix_injective) simp
  have right_inj: "inj (syntax_prefix 3)" by (rule syntax_prefix_injective) simp
  have source_left: "pattern_quoted_at (pattern_environment f p) None V [] (rename_pattern f p)
    (pattern_syntax_interior p) (rel_dom (pattern_literal_bindings p))"
    by (rule pattern_syntax_recovers[OF pf paddr pscope boundary])
  have source_right: "pattern_vector_at (pattern_forest_environment f ps) None V (pattern_forest_roots ps)
    (map (rename_pattern f) ps) (pattern_forest_interior ps) (rel_dom (pattern_forest_bindings ps))"
    by (rule Cons.IH[OF tail_formed tail_addr tail_scope])
  have copied_left: "pattern_quoted_at ?E None (syntax_prefix 2 ` V) (syntax_prefix 2 [])
    (rename_pattern (syntax_prefix 2) (rename_pattern f p))
    (syntax_prefix 2 ` pattern_syntax_interior p) (syntax_prefix 2 ` rel_dom (pattern_literal_bindings p))"
    by (rule pattern_quotation_transport[OF source_left pattern_environment_source left_addressing
          left_reads left_slots left_inj ef art])
  have copied_right: "pattern_vector_at ?E None (syntax_prefix 3 ` V)
    (map (syntax_prefix 3) (pattern_forest_roots ps))
    (map (rename_pattern (syntax_prefix 3)) (map (rename_pattern f) ps))
    (syntax_prefix 3 ` pattern_forest_interior ps) (syntax_prefix 3 ` rel_dom (pattern_forest_bindings ps))"
    by (rule pattern_vector_transport[OF source_right pattern_forest_environment_source right_addressing
          right_reads right_slots right_inj ef art])
  have left: "pattern_quoted_at ?E None V [2] (rename_pattern f p)
    (Cons 2 ` pattern_syntax_interior p) (Cons 2 ` rel_dom (pattern_literal_bindings p))"
    using copied_left by (simp only: syntax_prefix_image_binders[OF boundary] syntax_prefix_root
        renamed_pattern_prefix[OF paddr] syntax_prefix_image_outside[OF pattern_syntax_interior_outside]
        syntax_prefix_image_outside[OF pattern_literal_slots_outside])
  have right: "pattern_vector_at ?E None V (map (Cons 3) (pattern_forest_roots ps)) (map (rename_pattern f) ps)
    (Cons 3 ` pattern_forest_interior ps) (Cons 3 ` rel_dom (pattern_forest_bindings ps))"
    using copied_right by (simp only: syntax_prefix_image_binders[OF boundary] pattern_forest_roots_prefix
        pattern_forest_renamed_prefix[OF tail_addr] syntax_prefix_image_outside[OF pattern_forest_interior_outside]
        syntax_prefix_image_outside[OF pattern_forest_slots_outside])
  have separate: "Cons 2 ` pattern_syntax_interior p \<inter> Cons 3 ` pattern_forest_interior ps = {}" by auto
  have slots_separate: "(Cons 2 ` pattern_syntax_interior p \<union> Cons 3 ` pattern_forest_interior ps) \<inter>
    (Cons 2 ` rel_dom (pattern_literal_bindings p) \<union> Cons 3 ` rel_dom (pattern_forest_bindings ps)) = {}"
    using pattern_syntax_slot_boundary[of p] pattern_forest_slot_boundary[of ps] by auto
  show ?case using pattern_vector_at.cons[OF left right separate slots_separate]
    by (simp only: pattern_forest_roots.simps pattern_forest_interior.simps pattern_forest_slots list.map)
qed

text \<open>
  All bodies share exactly their declared binder occurrences. The construction
  contributes no intermediate pair headers. Every occurrence belongs to a
  recovered body, an external literal slot, or a referenced binder. It works
  for every finite list, including the empty list, with unchanged literal values.
\<close>

end
