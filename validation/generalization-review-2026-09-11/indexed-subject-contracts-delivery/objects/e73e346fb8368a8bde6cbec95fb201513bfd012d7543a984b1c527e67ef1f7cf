theory RRA_Record_Chains
  imports "RRA_Structural_Syntax"
begin

section \<open>Complete successor heads determine the socket path\<close>

fun record_socket_chain ::
  "('a,'v) structured_object \<Rightarrow> 'a \<Rightarrow> 'a list \<Rightarrow> bool" where
  "record_socket_chain R r [] = True"
| "record_socket_chain R r (p#ps) \<longleftrightarrow>
    p\<noteq>r \<and> p\<in>rra_carrier (object_structure R) \<and>
    headed_incidence (object_structure R) p=(if ps=[] then {} else {(p,hd ps)}) \<and>
    restrict_basis {p} (object_data R)=empty_basis \<and> record_socket_chain R r ps"

lemma record_socket_chain_same_start:
  assumes "record_socket_chain R r (p#ps)" "record_socket_chain R r (p#qs)"
  shows "ps=qs"
  using assms
proof (induction ps arbitrary: p qs)
  case Nil
  then show ?case by (cases qs) auto
next
  case (Cons a ps)
  obtain b bs where qs: "qs=b#bs" using Cons.prems by (cases qs) auto
  have same: "a=b" using Cons.prems by (simp add: qs)
  have tail: "ps=bs" by (rule Cons.IH[of a bs]) (use Cons.prems in \<open>auto simp: qs same\<close>)
  show ?case using qs same tail by simp
qed

lemma record_socket_chain_suffix:
  assumes "record_socket_chain R r (xs@ys)"
  shows "record_socket_chain R r ys"
  using assms by (induction xs) auto

lemma record_socket_chain_distinct:
  assumes "record_socket_chain R r ps"
  shows "distinct ps"
  using assms
proof (induction ps)
  case Nil
  then show ?case by simp
next
  case (Cons p ps)
  have tail: "record_socket_chain R r ps" using Cons.prems by simp
  have absent: "p\<notin>set ps"
  proof
    assume "p\<in>set ps"
    then obtain xs ys where split: "ps=xs@p#ys" by (meson split_list)
    have suffix: "record_socket_chain R r (p#ys)"
      using record_socket_chain_suffix[of R r xs "p#ys"] tail split by simp
    have same: "ps=ys" by (rule record_socket_chain_same_start[OF Cons.prems suffix])
    have "length ps=length xs+Suc (length ys)" using split by simp
    then show False using same by simp
  qed
  show ?case using absent Cons.IH[OF tail] by simp
qed

lemma record_socket_chain_boundary:
  assumes "record_socket_chain R r ps"
  shows "r\<notin>set ps" "set ps\<subseteq>rra_carrier (object_structure R)"
    "restrict_basis (set ps) (object_data R)=empty_basis"
  using assms by (induction ps) (auto simp: empty_restriction_iff)

lemma record_path_socket_chain:
  assumes path: "record_path (object_structure R) r p ps xs"
    and formed: "object_formed R"
    and data: "restrict_basis (set ps) (object_data R)=empty_basis"
  shows "record_socket_chain R r ps"
  using path data
proof (induction rule: record_path.induct)
  case (path_last p x)
  have member: "p\<in>rra_carrier (object_structure R)"
    using field_endpoint_incident[OF path_last.hyps(3)] formed
    by (auto simp: object_formed_def rra_formed_def)
  show ?case using path_last member by simp
next
  case (path_slot p q x ps xs)
  have member: "p\<in>rra_carrier (object_structure R)"
    using field_endpoint_incident[OF path_slot.hyps(3)] formed
    by (auto simp: object_formed_def rra_formed_def)
  have first: "ps\<noteq>[] \<and> hd ps=q" by (rule record_path_first[OF path_slot.hyps(4)])
  have tail_data: "restrict_basis (set ps) (object_data R)=empty_basis"
    and first_data: "restrict_basis {p} (object_data R)=empty_basis"
    using path_slot.prems by (auto simp: empty_restriction_iff)
  show ?case using path_slot.hyps(1,2) member first first_data path_slot.IH[OF tail_data] by simp
qed

lemma record_path_from_socket_chain:
  assumes chain: "record_socket_chain R r ps" and nonempty: "ps\<noteq>[]"
    and length: "length ps=length xs"
    and fields: "\<forall>(p,x)\<in>set (zip ps xs). field_endpoint (object_structure R) r p x"
  shows "record_path (object_structure R) r (hd ps) ps xs"
  using chain nonempty length fields
proof (induction ps arbitrary: xs)
  case Nil
  then show ?case by simp
next
  case (Cons p ps)
  obtain x ys where xs: "xs=x#ys" using Cons.prems(3) by (cases xs) auto
  have field: "field_endpoint (object_structure R) r p x" using Cons.prems(4) by (simp add: xs)
  show ?case
  proof (cases "ps=[]")
    case True
    have "ys=[]" using Cons.prems(3) by (simp add: xs True)
    show ?thesis using Cons.prems(1) field
      by (auto simp: xs True \<open>ys=[]\<close> intro: record_path.path_last)
  next
    case False
    have tail: "record_path (object_structure R) r (hd ps) ps ys"
      by (rule Cons.IH[OF _ False]) (use Cons.prems in \<open>auto simp: xs\<close>)
    show ?thesis using Cons.prems(1) field tail False
      by (auto simp: xs intro: record_path.path_slot)
  qed
qed

theorem record_at_socket_chain:
  "record_at R r ps xs \<longleftrightarrow>
    object_formed R \<and> r\<in>rra_carrier (object_structure R) \<and> length ps=length xs \<and>
    headed_incidence (object_structure R) r=set (zip ps xs) \<and>
    restrict_basis {r} (object_data R)=empty_basis \<and> record_socket_chain R r ps"
proof
  assume read: "record_at R r ps xs"
  have formed: "object_formed R" and member: "r\<in>rra_carrier (object_structure R)"
    and raw: "raw_record_at (object_structure R) r ps xs"
    and data: "restrict_basis (insert r (set ps)) (object_data R)=empty_basis"
    using read by (auto simp: record_at_def)
  have length: "length ps=length xs" by (rule raw_record_lengths[OF raw])
  have head: "headed_incidence (object_structure R) r=set (zip ps xs)"
    using raw by (auto simp: raw_record_at_def)
  have root_data: "restrict_basis {r} (object_data R)=empty_basis"
    and path_data: "restrict_basis (set ps) (object_data R)=empty_basis"
    using data by (auto simp: empty_restriction_iff)
  have chain: "record_socket_chain R r ps"
    using raw record_path_socket_chain[OF _ formed path_data]
    by (auto simp: raw_record_at_def)
  show "object_formed R \<and> r\<in>rra_carrier (object_structure R) \<and> length ps=length xs \<and>
    headed_incidence (object_structure R) r=set (zip ps xs) \<and>
    restrict_basis {r} (object_data R)=empty_basis \<and> record_socket_chain R r ps"
    using formed member length head root_data chain by blast
next
  assume "object_formed R \<and> r\<in>rra_carrier (object_structure R) \<and> length ps=length xs \<and>
    headed_incidence (object_structure R) r=set (zip ps xs) \<and>
    restrict_basis {r} (object_data R)=empty_basis \<and> record_socket_chain R r ps"
  then have formed: "object_formed R" and member: "r\<in>rra_carrier (object_structure R)"
    and length: "length ps=length xs" and head: "headed_incidence (object_structure R) r=set (zip ps xs)"
    and root_data: "restrict_basis {r} (object_data R)=empty_basis" and chain: "record_socket_chain R r ps"
    by auto
  have distinct: "distinct ps" by (rule record_socket_chain_distinct[OF chain])
  have keys: "distinct (map fst (zip ps xs))" using distinct length by simp
  have functional: "single_valued (set (zip ps xs))" using keys by (simp add: distinct_keys_iff)
  have fields: "\<forall>(p,x)\<in>set (zip ps xs). field_endpoint (object_structure R) r p x"
    using functional by (auto simp: field_endpoint_from_head head single_valued_def)
  have raw: "raw_record_at (object_structure R) r ps xs"
    using record_path_from_socket_chain[OF chain _ length fields] head length
    by (cases "ps=[]") (auto simp: raw_record_at_def)
  have data: "restrict_basis (insert r (set ps)) (object_data R)=empty_basis"
    using root_data record_socket_chain_boundary(3)[OF chain] by (auto simp: empty_restriction_iff)
  show "record_at R r ps xs" using formed member raw data by (simp add: record_at_def)
qed

text \<open>
  The chain checks every socket head and its empty local data. A repeated
  socket would give two different finite tails from the same complete head;
  deterministic succession and the terminal empty head rule that out.
  Distinct sockets are therefore a theorem, not a second admission test.

  Combining this chain with the complete root incidence recovers exactly
  the existing record relation. Endpoints may repeat or share other syntax.
  The empty record still requires an actual formed root with empty headed
  incidence and data. No condition forbids incoming edges or other material.
\<close>

end
