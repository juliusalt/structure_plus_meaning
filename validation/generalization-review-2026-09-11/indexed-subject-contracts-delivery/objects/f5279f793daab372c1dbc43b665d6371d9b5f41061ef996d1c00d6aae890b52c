theory Factor_Observation_Presentations
  imports "Factor_Observation_Admission" "Factor_Data_Set_Comparison_Contracts" "Presentation_Function_Witnesses" "Factor_Data_Term_Presentations"
begin

section \<open>Finite observation subjects use the existing complete class constructions\<close>

abbreviation observation_datum :: "factor_term \<Rightarrow> bool" where
  "observation_datum x \<equiv> data_term_boundary x"

abbreviation observation_datum_presents :: "factor_term \<Rightarrow> factor_term \<Rightarrow> bool" where
  "observation_datum_presents x p \<equiv> data_term_presents x p"

abbreviation observation_value_presents where
  "observation_value_presents \<equiv> data_pair_presents"

abbreviation observation_row_presents where
  "observation_row_presents \<equiv> factor_pair_presents observation_datum_presents
    (factor_pair_presents observation_datum_presents observation_datum_presents)"

abbreviation observation_facets_presents where
  "observation_facets_presents \<equiv> data_list_fset_presents observation_datum_presents"

abbreviation observation_values_presents where
  "observation_values_presents \<equiv> data_pair_finite_set_presents"

abbreviation observation_table_presents where
  "observation_table_presents \<equiv> data_list_fset_presents observation_row_presents"

abbreviation observation_context_presents where
  "observation_context_presents R \<equiv> factor_pair_presents observation_facets_presents R"

abbreviation observation_query_presents where
  "observation_query_presents R z p \<equiv>
    observation_context_presents R (fst z) (fst p) \<and> observation_table_presents (snd z) (snd p)"

abbreviation observation_facets_domain where
  "observation_facets_domain F \<equiv> \<forall>f\<in>fset F. observation_datum f"

abbreviation observation_values_domain where
  "observation_values_domain V \<equiv> \<forall>(f,w)\<in>fset V. data_elements [f,w]"

abbreviation observation_table_domain where
  "observation_table_domain T \<equiv> \<forall>(f,c,w)\<in>fset T. data_elements [f,c,w]"

abbreviation observation_query_domain where
  "observation_query_domain D z \<equiv> observation_facets_domain (fst (fst z)) \<and>
    D (snd (fst z)) \<and> observation_table_domain (snd z)"

lemma observation_datum_class:
  "presentation_class observation_datum_presents observation_datum observation_datum"
  by (rule data_term_class)

lemma observation_value_class:
  "presentation_class observation_value_presents (\<lambda>(f,w). data_elements [f,w])
    (\<lambda>p. \<exists>f w. observation_value_presents (f,w) p)"
  using data_pair_class by (simp only: split_paired_Ex)

lemma observation_row_class:
  "presentation_class observation_row_presents (\<lambda>(f,c,w). data_elements [f,c,w]) observation_row_admitted"
  using factor_pair_class[OF observation_datum_class observation_value_class]
  by (auto simp: presentation_class_def factor_pair_presents_def split: prod.splits)

lemma observation_facets_class:
  "presentation_class observation_facets_presents observation_facets_domain
    (\<lambda>p. \<exists>F. observation_facets_presents F p)"
proof -
  have source: "presentation_class observation_facets_presents observation_facets_domain
      (\<lambda>p. \<exists>xs. data_elements xs \<and> p=data_list_term xs)"
    by (rule data_list_fset_presentation_class[OF observation_datum_class])
  show ?thesis by (rule presentation_class.recovered_admission[OF source])
qed

lemma observation_values_class:
  "presentation_class observation_values_presents observation_values_domain
    (\<lambda>p. \<exists>V. observation_values_presents V p)"
  by (rule data_pair_finite_set_class)

lemma observation_table_class:
  "presentation_class observation_table_presents observation_table_domain
    (\<lambda>p. \<exists>T. observation_table_presents T p)"
proof -
  have source: "presentation_class observation_table_presents observation_table_domain
      (\<lambda>p. \<exists>xs. (\<forall>x\<in>set xs. observation_row_admitted x) \<and> p=data_list_term xs)"
    by (rule data_list_fset_presentation_class[OF observation_row_class])
  show ?thesis by (rule presentation_class.recovered_admission[OF source])
qed

lemma observation_context_class:
  assumes element: "presentation_class R D A"
  shows "presentation_class (observation_context_presents R)
    (\<lambda>z. observation_facets_domain (fst z) \<and> D (snd z))
    (\<lambda>p. \<exists>z. observation_context_presents R z p)"
proof -
  have source: "presentation_class (observation_context_presents R)
      (\<lambda>z. observation_facets_domain (fst z) \<and> D (snd z))
      (\<lambda>p. \<exists>F c. (\<exists>V. observation_facets_presents V F) \<and> A c \<and> p=Pair_Term F c)"
    by (rule factor_pair_class[OF observation_facets_class element])
  show ?thesis by (rule presentation_class.recovered_admission[OF source])
qed

lemma observation_query_class:
  assumes element: "presentation_class R D A"
  shows "presentation_class (observation_query_presents R) (observation_query_domain D)
    (\<lambda>p. \<exists>z. observation_query_presents R z p)"
proof -
  have source: "presentation_class (observation_query_presents R) (observation_query_domain D)
      (\<lambda>p. (\<exists>z. observation_context_presents R z (fst p)) \<and> (\<exists>T. observation_table_presents T (snd p)))"
    using presentation_class_product[OF observation_context_class[OF element] observation_table_class]
    by (simp only: conj_assoc)
  show ?thesis by (rule presentation_class.recovered_admission[OF source])
qed

section \<open>The classes retain every displayed enumeration of their subjects\<close>

lemma observation_value_graph:
  "observation_value_presents=(\<lambda>z p. (case z of (f,w) \<Rightarrow> data_elements [f,w]) \<and> p=observation_value_term z)"
  by (rule data_pair_graph)

lemma observation_row_graph:
  "observation_row_presents=(\<lambda>z p. (case z of (f,c,w) \<Rightarrow> data_elements [f,c,w]) \<and> p=observation_row_term z)"
  by (intro ext) (auto simp: factor_pair_presents_def split: prod.splits)

lemma observation_values_fields:
  "observation_values_presents V p \<longleftrightarrow>
    (\<exists>xs. (\<forall>(f,w)\<in>set xs. data_elements [f,w]) \<and> fset_of_list xs=V \<and>
      p=data_list_term (map observation_value_term xs))"
  by (rule data_pair_finite_set_fields)

lemma observation_values_presented_data:
  assumes "observation_values_presents V q"
  shows "observation_datum q"
  by (rule data_pair_finite_set_presented_data[OF assms])

lemma observation_facets_fields:
  "observation_facets_presents F p \<longleftrightarrow>
    (\<exists>fs. data_elements fs \<and> fset_of_list fs=F \<and> p=data_list_term fs)"
  using data_list_fset_presents_function[where D=observation_datum and f="\<lambda>a. a" and S=F and t=p]
  by simp

lemma observation_table_fields:
  "observation_table_presents T p \<longleftrightarrow>
    (\<exists>rows. observation_rows_data rows \<and> fset_of_list rows=T \<and>
      p=data_list_term (map observation_row_term rows))"
  by (simp only: observation_row_graph data_list_fset_presents_function)

lemma observation_query_fields:
  "observation_query_presents R ((F,c),T) (p,table) \<longleftrightarrow>
    (\<exists>fs rows k. data_elements fs \<and> R c k \<and> observation_rows_data rows \<and>
      fset_of_list fs=F \<and> fset_of_list rows=T \<and>
      p=Pair_Term (data_list_term fs) k \<and> table=data_list_term (map observation_row_term rows))"
proof
  assume read: "observation_query_presents R ((F,c),T) (p,table)"
  have ctx: "factor_pair_presents observation_facets_presents R (F,c) p"
    and table: "observation_table_presents T table" using read by simp_all
  obtain ps k where pair: "observation_facets_presents F ps" "R c k" "p=Pair_Term ps k"
    using ctx by (simp only: factor_pair_presents_def fst_conv snd_conv) blast
  obtain fs where facets: "data_elements fs" "fset_of_list fs=F" "ps=data_list_term fs"
    using pair(1) by (simp only: observation_facets_fields) blast
  obtain rows where rows: "observation_rows_data rows" "fset_of_list rows=T"
    "table=data_list_term (map observation_row_term rows)"
    using table by (simp only: observation_table_fields) blast
  show "\<exists>fs rows k. data_elements fs \<and> R c k \<and> observation_rows_data rows \<and>
      fset_of_list fs=F \<and> fset_of_list rows=T \<and>
      p=Pair_Term (data_list_term fs) k \<and> table=data_list_term (map observation_row_term rows)"
    by (intro exI[of _ fs] exI[of _ rows] exI[of _ k]) (use pair facets rows in blast)
next
  assume "\<exists>fs rows k. data_elements fs \<and> R c k \<and> observation_rows_data rows \<and>
      fset_of_list fs=F \<and> fset_of_list rows=T \<and>
      p=Pair_Term (data_list_term fs) k \<and> table=data_list_term (map observation_row_term rows)"
  then obtain fs rows k where parts: "data_elements fs" "R c k" "observation_rows_data rows"
    "fset_of_list fs=F" "fset_of_list rows=T"
    "p=Pair_Term (data_list_term fs) k" "table=data_list_term (map observation_row_term rows)"
    by (elim exE conjE) (rule that; assumption)
  have facets: "observation_facets_presents F (data_list_term fs)"
    by (simp only: observation_facets_fields; rule exI[of _ fs]) (use parts in blast)
  have table: "observation_table_presents T table"
    by (simp only: observation_table_fields; rule exI[of _ rows]) (use parts in blast)
  have ctx: "factor_pair_presents observation_facets_presents R (F,c) p"
    by (simp only: factor_pair_presents_def fst_conv snd_conv;
      intro exI[of _ "data_list_term fs"] exI[of _ k]) (use parts facets in blast)
  show "observation_query_presents R ((F,c),T) (p,table)" using ctx table by simp
qed

text \<open>
  Facets, table rows, and result rows use finite-set subjects with complete
  displayed list presentations. Pair and product classes preserve the actual
  shared context and every field. No chosen order, duplicate count, or numeric
  identifier is used to determine the represented subject.
\<close>

end
