theory Finite_Observation_Contracts
  imports "Finite_Derived_Observations"
begin

section \<open>The runtime exports its checked observation equation\<close>

ML \<open>
structure Finite_Observation_Contracts =
struct
  type contract =
    {definition: thm, equation: thm, formation: thm,
     observation: thm, comparison: thm};

  structure Data = Theory_Data
  (
    type T = contract Symtab.table;
    val empty = Symtab.empty;
    val merge = Symtab.merge (fn (a, b) => eq_list Thm.eq_thm_prop
      ([#definition a, #equation a, #formation a, #observation a, #comparison a],
       [#definition b, #equation b, #formation b, #observation b, #comparison b]));
  );

  fun equation_sides th =
    let val prop = Thm.prop_of th
    in case try Logic.dest_equals prop of
      SOME pair => pair
    | NONE => HOLogic.dest_eq (HOLogic.dest_Trueprop prop)
    end;

  fun constant_name term = fst (dest_Const (Term.head_of term));

  fun compared_source th =
    let
      val (left, _) = HOLogic.dest_eq (HOLogic.dest_Trueprop
        (Logic.strip_assums_concl (Thm.prop_of th)));
      val (_, container) = HOLogic.dest_mem left;
    in case Term.strip_comb container of
      (Const (name, _), [source]) =>
        if name = @{const_name set} then source
        else error "The source theorem must concern the complete result list"
    | _ => error "The source theorem has no complete result list"
    end;

  fun components ({definition, equation, formation, observation, comparison}: contract) =
    let
      val (function, calculation) = equation_sides definition;
      val (basis, args) = Term.strip_comb calculation;
      val _ = if constant_name basis = @{const_name investigation_basis} andalso length args = 5
        then () else error "The investigation definition must apply the existing finite basis operation";
      val (encoded, derived) = equation_sides equation;
      val observer = (case Term.strip_comb encoded of
          (Const (name, _), [term]) =>
            if name = @{const_name fset_of_list} then term
            else error "The source equation must present the complete observation list"
        | _ => error "The source equation has no complete observation list");
      val (derive, subjects) = Term.strip_comb derived;
      val _ = if constant_name derive = @{const_name finite_derived_observations} andalso length subjects = 4
        then () else error "The source equation must use the derived-observation operation";
      val _ = if constant_name observer = constant_name (nth args 3)
        then () else error "The checked equation belongs to a different observation function";
      val _ = if constant_name (compared_source observation) = constant_name observer
          andalso constant_name (compared_source comparison) = constant_name (nth args 4)
        then () else error "The source theorems must concern these same observation and comparison functions";
      val (formed, maps) = Term.strip_comb (HOLogic.dest_Trueprop (Thm.prop_of formation));
      val _ = if constant_name formed = @{const_name finite_observation_subjects_formed}
          andalso eq_list (op aconv) (maps, take 3 subjects)
        then () else error "The functionality theorem must concern these same subject maps";
      val _ = if forall (null o Thm.hyps_of) [definition, equation, formation]
        then () else error "A source contract may not discharge unstated hypotheses";
    in (function, observer, nth args 4, subjects, take 2 args) end;

  fun register contract thy =
    let val (function, _, _, _, _) = components contract
    in Data.map (Symtab.update_new (constant_name function, contract)) thy end;

  fun term_element name term = XML.Elem ((name, []), Term_XML.Encode.term_raw term);
  fun theorem_element name th = term_element name (Thm.prop_of th);

  fun definitions thy seeds =
    let
      val by_constant = Symtab.make_list (Defs.dest_constdefs [] (Theory.defs_of thy));
      val axioms = Symtab.make (Theory.all_axioms_of thy);
      fun expand [] seen selected = (seen, selected)
        | expand (name :: pending) seen selected =
            if Symtab.defined seen name then expand pending seen selected
            else
              let
                val names = these (Symtab.lookup by_constant name);
                fun fetch def =
                  (case Symtab.lookup axioms def of SOME prop => (def, prop)
                  | NONE => error ("Missing kernel definition " ^ quote def));
                val equations = map fetch names;
                val more = maps (fn (_, prop) => Term.add_const_names prop []) equations;
              in expand (more @ pending) (Symtab.update (name, ()) seen)
                (fold Symtab.update equations selected) end;
      val (seen, selected) = expand (maps (fn t => Term.add_const_names t []) seeds)
        Symtab.empty Symtab.empty;
      val primitives = filter (fn name => not (Symtab.defined by_constant name)) (Symtab.keys seen);
    in
      XML.Elem (("definitions", []), map (fn (name, prop) =>
        XML.Elem (("definition", [("name", name)]), Term_XML.Encode.term_raw prop)) (Symtab.dest selected)) ::
      [XML.Elem (("context_constants", []), map (fn name =>
        term_element "constant" (Const (name, Sign.the_const_type thy name))) primitives)]
    end;

  fun export function thy =
    let
      val name = constant_name function;
      val contract = (case Symtab.lookup (Data.get thy) name of SOME value => value
        | NONE => error ("No checked observation contract for " ^ quote name));
      val (actual_function, observer, relation, subjects, domains) = components contract;
      val {definition, equation, formation, observation, comparison} = contract;
      val propositions = map Thm.prop_of [definition, equation, formation, observation, comparison];
      fun indices term = XML.Encode.list XML.Encode.int (map (snd o HOLogic.dest_number) (HOLogic.dest_list term));
      val body = [XML.Elem (("candidate_indices", []), indices (nth domains 0)),
        XML.Elem (("facet_indices", []), indices (nth domains 1)),
        term_element "function" actual_function, term_element "observer" observer,
        term_element "relation" relation,
        XML.Elem (("subjects", []), map (term_element "term") subjects),
        theorem_element "calculation" definition, theorem_element "observation_equation" equation,
        theorem_element "functional_maps" formation, theorem_element "at_subject" observation,
        theorem_element "comparison_at_subject" comparison] @ definitions thy propositions;
      val xml = XML.Elem (("finite_observation_contract", [("function", name)]), body);
      val _ = Export.export thy (Path.binding0 (Path.explode ("subjects/" ^ Long_Name.base_name name ^ ".yxml")))
        [xml];
    in thy end;
end
\<close>

text \<open>
  Each owner registers checked theorems about its actual calculation and
  subject maps. The exporter checks the observation constant in that
  calculation against the source equation and checks the same map arguments
  in the functionality theorem. It retains full typed terms and the reachable
  kernel definitions. Constants with no definitional equation are recorded
  explicitly as dependencies on the accepted Isabelle context.

  The export presents existing theorems. It does not interpret registry prose,
  prove an arbitrary host operation, or replace the checked theory context.
\<close>

end
