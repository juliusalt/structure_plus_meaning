theory Factor_Reasoning_Method_Investigation
  imports Factor_Reasoning_Premise_Admission Finite_Derived_Observations
begin

definition reasoning_workload_frontier :: "nat \<Rightarrow> (nat\<times>finite_factor_term) list" where
  "reasoning_workload_frontier w=(if w=0 then admission_pair_reasoning_frontier else reasoning_false_frontier)"

definition reasoning_workload_goal :: "nat \<Rightarrow> finite_factor_term" where
  "reasoning_workload_goal w=(if w=0 then admission_pair_reasoning_goal else reasoning_false_goal)"

definition reasoning_method_known where
  "reasoning_method_known (m::nat) C=(if m=0 then admitted_reasoning_frontier C
    else if m=1 then C else [])"

definition reasoning_method_report where
  "reasoning_method_report m w=finite_learned_investigation admission_pair_reasoning_library
    (reasoning_workload_frontier w)
    (fset_of_list (reasoning_method_known m (reasoning_workload_frontier w)))
    {|(0::nat,(341,reasoning_workload_goal w))|}"

definition reasoning_workload_native_goal where
  "reasoning_workload_native_goal w \<longleftrightarrow>
    (341,decode_finite_term (reasoning_workload_goal w))\<in>positive_meaning admission_plan_system"

lemma reasoning_workload_native_goal_code [code]:
  "reasoning_workload_native_goal w \<longleftrightarrow> w=0"
  by (simp add: reasoning_workload_native_goal_def reasoning_workload_goal_def
    reasoning_pair_goal_native reasoning_false_goal_not_native)

type_synonym reasoning_known_operation =
  "(nat\<times>finite_factor_term) list \<Rightarrow> (nat\<times>finite_factor_term) list"

type_synonym reasoning_problem_subject =
  "(nat\<times>(nat,nat,nat) finite_factor_schema\<times>(nat\<times>nat\<times>nat finite_term_pattern) list) list
    \<times>(nat\<times>finite_factor_term) list\<times>(nat\<times>finite_factor_term)"

definition reasoning_problem_subject :: "nat \<Rightarrow> reasoning_problem_subject" where
  "reasoning_problem_subject w=(admission_pair_reasoning_library,
    reasoning_workload_frontier w,(341,reasoning_workload_goal w))"

definition reasoning_subject_report where
  "reasoning_subject_report (method::reasoning_known_operation) (problem::reasoning_problem_subject)=
    (case problem of (L,C,q) \<Rightarrow>
      finite_learned_investigation L C (fset_of_list (method C)) {|(0::nat,q)|})"

definition reasoning_subject_condition where
  "reasoning_subject_condition f (method::reasoning_known_operation) (problem::reasoning_problem_subject)=
    (case problem of (L,C,q) \<Rightarrow>
      (let known=method C;
           residual_empty=(fst (snd (snd (reasoning_subject_report method problem)))={||});
           actual=(fst q,decode_finite_term (snd q))\<in>positive_meaning admission_plan_system
       in if f=0 then list_all (\<lambda>(d,t). d=340 \<and> finite_admission_counter_check t) known
          else if f=1 then (residual_empty \<longrightarrow> actual)
          else f=2 \<and> (residual_empty=actual)))"

definition reasoning_method_quality :: "nat \<Rightarrow> nat \<Rightarrow> nat \<Rightarrow> bool" where
  "reasoning_method_quality m w f=reasoning_subject_condition f
    (reasoning_method_known m) (reasoning_problem_subject w)"

lemma reasoning_subject_report_at:
  "reasoning_subject_report (reasoning_method_known m) (reasoning_problem_subject w)=reasoning_method_report m w"
  by (simp add: reasoning_subject_report_def reasoning_problem_subject_def reasoning_method_report_def)

lemma reasoning_method_quality_code [code]:
  "reasoning_method_quality m w f=
    (let known=reasoning_method_known m (reasoning_workload_frontier w);
         settled=(fst (snd (snd (reasoning_method_report m w)))={||});
         actual=reasoning_workload_native_goal w
     in if f=0 then list_all (\<lambda>(d,t). d=340 \<and> finite_admission_counter_check t) known
        else if f=1 then (settled \<longrightarrow> actual)
        else f=2 \<and> (settled=actual))"
  by (simp add: reasoning_method_quality_def reasoning_subject_condition_def
    reasoning_problem_subject_def reasoning_subject_report_def reasoning_method_report_def
    reasoning_workload_native_goal_def)

definition reasoning_method_investigation_observations :: "(nat\<times>nat\<times>nat) list" where
  "reasoning_method_investigation_observations=concat (map (\<lambda>q.
    concat (map (\<lambda>m. map (\<lambda>w. (q,m,w))
      (filter (\<lambda>w. reasoning_method_quality m w q) [0,1])) [0,1,2])) [0,1,2])"

definition reasoning_candidate_subjects where
  "reasoning_candidate_subjects=fimage (\<lambda>m. (m,reasoning_method_known m)) {|0::nat,1,2|}"

definition reasoning_condition_subjects where
  "reasoning_condition_subjects=fimage (\<lambda>f. (f,reasoning_subject_condition f)) {|0::nat,1,2|}"

definition reasoning_workload_subjects where
  "reasoning_workload_subjects=fimage (\<lambda>w. (w,reasoning_problem_subject w)) {|0::nat,1|}"

lemma reasoning_subject_maps_formed:
  "finite_observation_subjects_formed reasoning_candidate_subjects reasoning_condition_subjects reasoning_workload_subjects"
  unfolding reasoning_candidate_subjects_def reasoning_condition_subjects_def reasoning_workload_subjects_def
  by (rule finite_observation_function_graphs_formed)

lemma reasoning_observations_derived:
  "fset_of_list reasoning_method_investigation_observations=
    finite_derived_observations reasoning_candidate_subjects reasoning_condition_subjects
      reasoning_workload_subjects (\<lambda>condition method problem. condition method problem)"
  unfolding reasoning_candidate_subjects_def reasoning_condition_subjects_def reasoning_workload_subjects_def
  apply (rule finite_table_derived_from_function_graphs)
  by (simp only: fset_of_list.rep_eq reasoning_method_investigation_observations_def indexed_predicate_rows_member reasoning_method_quality_def; auto)

theorem reasoning_observation_at_subject:
  assumes "(m,method) |\<in>| reasoning_candidate_subjects"
    "(f,condition) |\<in>| reasoning_condition_subjects"
    "(w,problem) |\<in>| reasoning_workload_subjects"
  shows "(f,m,w)\<in>set reasoning_method_investigation_observations \<longleftrightarrow> condition method problem"
  using finite_derived_observation_at_subject[OF reasoning_subject_maps_formed assms, where P="\<lambda>condition method problem. condition method problem"]
  by (simp only: reasoning_observations_derived[symmetric] fset_of_list.rep_eq)

definition reasoning_method_investigation_relation :: "(nat\<times>nat) list" where
  "reasoning_method_investigation_relation=filter (\<lambda>(m,k).
    \<forall>w\<in>set [0,1]. \<forall>q\<in>set [0,1,2].
      reasoning_method_quality m w q \<longrightarrow> reasoning_method_quality k w q)
    (investigation_pairs [0,1,2])"

definition reasoning_method_investigation where
  "reasoning_method_investigation selected=investigation_basis [0,1,2] [0,1,2] selected
    reasoning_method_investigation_observations reasoning_method_investigation_relation"

definition reasoning_subject_comparison where
  "reasoning_subject_comparison method other \<longleftrightarrow>
    (\<forall>(f,condition)\<in>fset reasoning_condition_subjects. \<forall>(w,problem)\<in>fset reasoning_workload_subjects.
      condition method problem \<longrightarrow> condition other problem)"

theorem reasoning_comparison_at_subject:
  assumes "(c,method) |\<in>| reasoning_candidate_subjects"
    "(d,other) |\<in>| reasoning_candidate_subjects"
  shows "(c,d)\<in>set reasoning_method_investigation_relation \<longleftrightarrow> reasoning_subject_comparison method other"
  using assms by (auto simp: reasoning_candidate_subjects_def reasoning_condition_subjects_def
    reasoning_workload_subjects_def reasoning_subject_comparison_def reasoning_method_investigation_relation_def
    investigation_pairs_exact fimage.rep_eq reasoning_method_quality_def)

export_code reasoning_method_investigation reasoning_method_investigation_observations
  reasoning_method_investigation_relation checking SML

text \<open>
  The methods admit possible premises through their actual native predicate,
  trust every possible premise, or establish none. Each uses the same generated
  conditional rule family. The two workloads provide all valid counter facts
  or one formed false candidate premise. The conditions ask whether every
  known fact is admitted, whether settlement is sound, and whether the returned
  decision agrees with the independently established native goal outcome.
  The last condition distinguishes useful progress from never settling a goal.

  Observations and comparison are computed from the actual method reports and
  native tests. This is a development question about how to use information,
  evaluated by the same machinery. It covers these three methods and these two
  workloads; it does not decide every question about usefulness or reliability.
\<close>

end
