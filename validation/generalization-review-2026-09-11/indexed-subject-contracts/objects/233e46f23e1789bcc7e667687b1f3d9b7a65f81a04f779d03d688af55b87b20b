theory Indexed_Subject_Exports
  imports Factor_Reasoning_Method_Investigation Factor_Investigation_Input_Investigation Observation_Revision_Investigation Factor_Observation_Table_Investigation Factor_Pair_Scope_Investigation Factor_Observation_Collection_Investigation Factor_Observation_Scope_Investigation Factor_Observation_Investigation Presentation_Completion_Investigation Factor_Permission_Investigation Factor_Substitution_Investigation Factor_Proof_Probe_Investigation Factor_Schema_Socket_Investigation
begin

ML \<open>
local
  fun proposal equation formation observation comparison =
    {definition = @{thm reasoning_method_investigation_def}, equation = equation,
     formation = formation, observation = observation, comparison = comparison};
  val correct = proposal @{thm reasoning_observations_derived} @{thm reasoning_subject_maps_formed}
    @{thm reasoning_observation_at_subject} @{thm reasoning_comparison_at_subject};
  fun rejected message contract =
    (case Exn.capture Finite_Observation_Contracts.components contract of
      Exn.Exn (ERROR actual) =>
        if String.isSubstring message actual then () else error actual
    | _ => error "An unrelated source contract was accepted");
  val _ = Finite_Observation_Contracts.components correct;
  val _ = rejected "different observation function"
    (proposal @{thm revision_observations_derived} @{thm revision_subject_maps_formed}
      @{thm reasoning_observation_at_subject} @{thm reasoning_comparison_at_subject});
  val _ = rejected "same subject maps"
    (proposal @{thm reasoning_observations_derived} @{thm revision_subject_maps_formed}
      @{thm reasoning_observation_at_subject} @{thm reasoning_comparison_at_subject});
  val _ = rejected "same observation and comparison functions"
    (proposal @{thm reasoning_observations_derived} @{thm reasoning_subject_maps_formed}
      @{thm revision_observation_at_subject} @{thm reasoning_comparison_at_subject});
  val _ = rejected "same observation and comparison functions"
    (proposal @{thm reasoning_observations_derived} @{thm reasoning_subject_maps_formed}
      @{thm reasoning_observation_at_subject} @{thm revision_comparison_at_subject});
  val _ = rejected "different observation arguments"
    {definition = @{thm pattern_investigation_def},
     equation = @{thm pattern_observations_derived[of True]},
     formation = @{thm pattern_subject_maps_formed[of True]},
     observation = @{thm pattern_observation_at_subject[where collapsed=True]},
     comparison = @{thm pattern_comparison_at_subject}};
in val _ = writeln "SUBJECT_CONTRACT_CHECKS: valid source and five unrelated-source or argument rejections passed" end
\<close>

