theory Factor_Observation_Collection_Investigation
  imports Factor_Observation_Collection_Contracts Factor_Keyed_Set_Execution Finite_Observation_Contracts
begin

section \<open>Nested profiles retain both levels of finite-set identity\<close>

abbreviation collection_example_profile where
  "collection_example_profile \<equiv> [(0::nat,0::nat),(0,1)]"

abbreviation collection_example_other where
  "collection_example_other \<equiv> [(0::nat,2::nat)]"

definition collection_example_rows :: "nat \<Rightarrow> (nat\<times>(nat\<times>nat) list) list" where
  "collection_example_rows n=(if n=1 then [(0,rev collection_example_profile),(1,collection_example_other)]
    else if n=2 then [(0,collection_example_profile@[(0,0)]),(1,collection_example_other)]
    else if n=3 then [(1,collection_example_other),(0,collection_example_profile)]
    else if n=4 then [(0,collection_example_profile),(1,collection_example_other),(0,collection_example_profile)]
    else if n=5 then [(0,[(0,0)]),(1,collection_example_other)]
    else if n=6 then [(0,collection_example_profile),(0,rev collection_example_profile),(1,collection_example_other)]
    else [(0,collection_example_profile),(1,collection_example_other)])"

abbreviation collection_example_value where
  "collection_example_value z \<equiv> keyed_octet_pair z"

abbreviation collection_example_row where
  "collection_example_row z \<equiv> case z of (c,values) \<Rightarrow>
    Pair_Term (Payload_Term [c]) (data_list_term (map collection_example_value values))"

abbreviation collection_example_term where
  "collection_example_term n \<equiv> data_list_term (map collection_example_row (collection_example_rows n))"

abbreviation collection_example_table where
  "collection_example_table \<equiv> [(Payload_Term [0],Payload_Term [0],Payload_Term [0]),
    (Payload_Term [0],Payload_Term [0],Payload_Term [1]),
    (Payload_Term [0],Payload_Term [1],Payload_Term [2])]"

lemma collection_example_computed_profiles:
  assumes "c\<in>{0,1}"
  shows "(301,context_relation_argument (Pair_Term (data_list_term [Payload_Term [0]]) (Payload_Term [c]))
    (data_list_term (map observation_row_term collection_example_table))
    (data_list_term (map collection_example_value (if c=0 then collection_example_profile else collection_example_other))))
      \<in>positive_meaning observation_system"
  using assms by (simp only: observation_encoded_profile)
    (auto simp: observation_profile_list_def octets_formed_def)

definition collection_investigation_decision :: "nat \<Rightarrow> nat \<Rightarrow> bool" where
  "collection_investigation_decision f n=(if f=0 then
    (219,Pair_Term (collection_example_term 0) (collection_example_term n))
      \<in>positive_meaning data_set_comparison_system
    else (317,Pair_Term (collection_example_term 0) (collection_example_term n))
      \<in>positive_meaning keyed_set_system)"

lemma collection_example_value_injective: "inj collection_example_value"
  by (auto simp: inj_on_def split: prod.splits)

lemma collection_example_row_injective: "inj collection_example_row"
proof (rule injI)
  fix x y assume same: "collection_example_row x=collection_example_row y"
  have keys: "fst x=fst y" and value_lists:
    "map collection_example_value (snd x)=map collection_example_value (snd y)"
    using same by (cases x; cases y; auto simp: data_list_term_injective)+
  have "snd x=snd y" using value_lists
    by (simp only: inj_map_eq_map[OF collection_example_value_injective])
  then show "x=y" using keys by (simp add: prod_eq_iff)
qed

lemma collection_example_data:
  "data_elements (map collection_example_row (collection_example_rows n))"
  by (simp add: collection_example_rows_def octets_formed_def split: if_splits)

lemma collection_investigation_decision_code [code]:
  "collection_investigation_decision f n=(if f=0 then
    set (collection_example_rows 0)=set (collection_example_rows n)
    else keyed_octet_profiles (collection_example_rows 0) (collection_example_rows n))"
proof -
  have raw: "(219,Pair_Term (collection_example_term 0) (collection_example_term n))
      \<in>positive_meaning data_set_comparison_system \<longleftrightarrow>
      set (collection_example_rows 0)=set (collection_example_rows n)"
    by (simp only: data_set_comparison_mapped[OF collection_example_row_injective])
      (use collection_example_data[of 0] collection_example_data[of n] in blast)
  have encoded: "map collection_example_row xs=
      map keyed_set_row_term (map (map_prod keyed_octet (map keyed_octet_pair)) xs)" for xs
    by (induction xs) (auto simp: map_prod_def split: prod.splits)
  show ?thesis by (simp only: collection_investigation_decision_def raw; simp only: encoded keyed_octet_profiles_def)
qed

definition collection_example_subject where
  "collection_example_subject n=fset_of_list (map (map_prod id fset_of_list) (collection_example_rows n))"

definition collection_investigation_compare :: "nat \<Rightarrow> nat \<Rightarrow> bool" where
  "collection_investigation_compare c d \<longleftrightarrow> collection_example_subject c=collection_example_subject d"

definition collection_investigation_observations :: "(nat\<times>nat\<times>nat) list" where
  "collection_investigation_observations=concat (map (\<lambda>c.
    map (\<lambda>f. (f,c,if collection_investigation_decision f c then 1 else 0)) [0,1]) [0,1,2,3,4,5,6])"

definition collection_investigation_relation :: "(nat\<times>nat) list" where
  "collection_investigation_relation=filter (\<lambda>(c,d). collection_investigation_compare c d)
    (investigation_pairs [0,1,2,3,4,5,6])"

lemma collection_investigation_relation_exact:
  "(c,d)\<in>set collection_investigation_relation \<longleftrightarrow>
    c\<in>{0,1,2,3,4,5,6} \<and> d\<in>{0,1,2,3,4,5,6} \<and>
    collection_example_subject c=collection_example_subject d"
  by (simp only: collection_investigation_relation_def set_filter investigation_pairs_exact
    mem_Collect_eq case_prod_conv collection_investigation_compare_def list.set; blast)

definition collection_investigation where
  "collection_investigation selected=investigation_basis [0,1,2,3,4,5,6] [0,1] selected
    collection_investigation_observations collection_investigation_relation"

definition collection_subject_operation :: "nat \<Rightarrow> (nat\<times>(nat\<times>nat) list) list \<Rightarrow> bool" where
  "collection_subject_operation f rows=(if f=0 then
    (219,Pair_Term (collection_example_term 0) (data_list_term (map collection_example_row rows)))
      \<in>positive_meaning data_set_comparison_system
    else (317,Pair_Term (collection_example_term 0) (data_list_term (map collection_example_row rows)))
      \<in>positive_meaning keyed_set_system)"

lemma collection_subject_decision_at:
  "collection_subject_operation f (collection_example_rows c)=collection_investigation_decision f c"
  by (simp add: collection_subject_operation_def collection_investigation_decision_def)

definition collection_candidate_subjects where
  "collection_candidate_subjects=fimage (\<lambda>c. (c,collection_example_rows c)) {|0::nat,1,2,3,4,5,6|}"

definition collection_operation_subjects where
  "collection_operation_subjects=fimage (\<lambda>f. (f,collection_subject_operation f)) {|0::nat,1|}"

definition collection_value_subjects where
  "collection_value_subjects=fimage (\<lambda>w. (w,w=1)) {|0::nat,1|}"

lemma collection_subject_maps_formed:
  "finite_observation_subjects_formed collection_candidate_subjects collection_operation_subjects collection_value_subjects"
  unfolding collection_candidate_subjects_def collection_operation_subjects_def collection_value_subjects_def
  by (rule finite_observation_function_graphs_formed)

lemma collection_observations_derived:
  "fset_of_list collection_investigation_observations=
    finite_derived_observations collection_candidate_subjects collection_operation_subjects
      collection_value_subjects (\<lambda>operation subject value. value=operation subject)"
  unfolding collection_candidate_subjects_def collection_operation_subjects_def collection_value_subjects_def
  apply (rule finite_table_derived_from_function_graphs)
  by (simp only: fset_of_list.rep_eq collection_investigation_observations_def indexed_value_rows_member collection_subject_decision_at;
    auto split: if_splits)

theorem collection_observation_at_subject:
  assumes "(c,subject) |\<in>| collection_candidate_subjects"
    "(f,operation) |\<in>| collection_operation_subjects"
    "(w,value) |\<in>| collection_value_subjects"
  shows "(f,c,w)\<in>set collection_investigation_observations \<longleftrightarrow> value=operation subject"
  using finite_derived_observation_at_subject[OF collection_subject_maps_formed assms, where P="\<lambda>operation subject value. value=operation subject"]
  by (simp only: collection_observations_derived[symmetric] fset_of_list.rep_eq)

theorem collection_comparison_at_subject:
  assumes "(c,subject) |\<in>| collection_candidate_subjects"
    "(d,other) |\<in>| collection_candidate_subjects"
  shows "(c,d)\<in>set collection_investigation_relation \<longleftrightarrow> fset_of_list (map (map_prod id fset_of_list) subject)=fset_of_list (map (map_prod id fset_of_list) other)"
  using assms by (auto simp: collection_candidate_subjects_def fimage.rep_eq collection_investigation_relation_exact collection_example_subject_def)

setup \<open>Finite_Observation_Contracts.register
  {definition = @{thm collection_investigation_def},
   equation = @{thm collection_observations_derived},
   formation = @{thm collection_subject_maps_formed},
   observation = @{thm collection_observation_at_subject},
   comparison = @{thm collection_comparison_at_subject}}\<close>

export_code investigation_inference investigation_basis investigation_repairs investigation_extend collection_investigation
  collection_investigation_observations collection_investigation_relation nat_of_integer integer_of_nat
  in SML module_name Finite_Investigation file_prefix finite_investigation

text \<open>
  The source profiles are outputs of the actual native profile computation.
  The seven subjects vary inner order, inner repetition, outer order, outer
  repetition, and two different presentations of a repeated semantic row.
  One subject removes a profile member. The independent comparison keeps
  both finite-set levels. The first actual native observation compares literal
  outer rows; the second uses the complete keyed-set comparison. A successful Boolean reference test is not a general decoder
  of every possible collection identity.
\<close>

end
