      equal_nata d (nat_of_integer (340 : IntInf.int)) andalso
        finite_admission_counter_check t)
    c;

fun reasoning_method_known m c =
  (if equal_nata m zero_nata then admitted_reasoning_frontier c
    else (if equal_nata m one_nata then c else []));

val admission_pair_reasoning_goal : finite_factor_term =
  admission_direct_pair_head (one_nat, zero_nat)
    (fn a => fn b => Finite_Pair (a, b)) Finite_Payload
    (finite_admission_counter zero_nata) (finite_admission_counter one_nata)
    (finite_admission_counter (nat_of_integer (2 : IntInf.int)));

val admission_pair_reasoning_frontier : (nat * finite_factor_term) list =
  map (fn n => (nat_of_integer (340 : IntInf.int), finite_admission_counter n))
    [zero_nata, one_nata, nat_of_integer (2 : IntInf.int)];

fun reasoning_workload_frontier w =
  (if equal_nata w zero_nata then admission_pair_reasoning_frontier
    else reasoning_false_frontier);

val finite_admission_direct_pair_schema :
  (nat, nat, nat, unit) finite_factor_schema_ext
  = Finite_factor_schema_ext
      (admission_direct_pair_head (one_nat, zero_nat)
         (fn a => fn b => Finite_Pattern_Pair (a, b)) Finite_Pattern_Payload
         (Finite_Variable zero_nata) (Finite_Variable one_nata)
         (Finite_Variable (nat_of_integer (2 : IntInf.int))),
        fset_of_list
          [(zero_nata,
             (nat_of_integer (340 : IntInf.int), Finite_Variable zero_nata)),
            (one_nata,
              (nat_of_integer (340 : IntInf.int), Finite_Variable one_nata)),
            (nat_of_integer (2 : IntInf.int),
              (nat_of_integer (340 : IntInf.int),
                Finite_Variable (nat_of_integer (2 : IntInf.int))))],
        bot_fset, ());

fun admission_pair_reasoning_library A_ (B1_, B2_) C_ (D1_, D2_) =
  [(numeral A_ (Bit1 (Bit0 (Bit1 (Bit0 (Bit1 (Bit0 (Bit1 (Bit0 One)))))))),
     (finite_admission_direct_pair_schema,
       [(zero B1_,
          (numeral C_
             (Bit0 (Bit0 (Bit1 (Bit0 (Bit1 (Bit0 (Bit1 (Bit0 One)))))))),
            Finite_Variable (zero D1_))),
         (one (one_numeral B2_),
           (numeral C_
              (Bit0 (Bit0 (Bit1 (Bit0 (Bit1 (Bit0 (Bit1 (Bit0 One)))))))),
             Finite_Variable (one (one_numeral D2_)))),
         (numeral B2_ (Bit0 One),
           (numeral C_
              (Bit0 (Bit0 (Bit1 (Bit0 (Bit1 (Bit0 (Bit1 (Bit0 One)))))))),
             Finite_Variable (numeral D2_ (Bit0 One))))]))];

fun reasoning_workload_goal w =
  (if equal_nata w zero_nata then admission_pair_reasoning_goal
    else reasoning_false_goal);

fun reasoning_method_report m w =
  finite_learned_investigation equal_nat equal_nat equal_nat equal_nat
    (admission_pair_reasoning_library numeral_nat (zero_nat, numeral_nat)
      numeral_nat (zero_nat, numeral_nat))
    (reasoning_workload_frontier w)
    (fset_of_list (reasoning_method_known m (reasoning_workload_frontier w)))
    (finsert
      (equal_prod equal_nat (equal_prod equal_nat equal_finite_factor_term))
      (zero_nata,
        (nat_of_integer (341 : IntInf.int), reasoning_workload_goal w))
      bot_fset);

fun reasoning_workload_native_goal w = equal_nata w zero_nata;

fun reasoning_method_quality m w f =
  let
    val known = reasoning_method_known m (reasoning_workload_frontier w);
    val settled =
      equal_fseta
        (equal_prod equal_nat (equal_prod equal_nat equal_finite_factor_term))
        (fst (snd (snd (reasoning_method_report m w)))) bot_fset;
    val actual = reasoning_workload_native_goal w;
  in
    (if equal_nata f zero_nata
      then list_all
             (fn (d, t) =>
               equal_nata d (nat_of_integer (340 : IntInf.int)) andalso
                 finite_admission_counter_check t)
             known
      else (if equal_nata f one_nata then (if settled then actual else true)
             else equal_nata f (nat_of_integer (2 : IntInf.int)) andalso
                    equal_boola settled actual))
  end;

fun completion_investigation_test c =
  (if equal_nata c zero_nata then id else not);

fun completion_subject_operation f subject =
  let
    val (left, right) = subject;
  in
    (if equal_nata f zero_nata
      then saturate_observation enum_unit enum_bool (fn _ => fn _ => true) left
             false
      else (if equal_nata f one_nata
             then saturate_observation enum_unit enum_bool
                    (fn _ => fn _ => true) right false
             else saturate_observation enum_unit enum_bool
                    (fn _ => fn _ => true) (fn p => left p andalso right p)
                    false))
  end;

fun completion_investigation_observe f c =
  completion_subject_operation f (id, completion_investigation_test c);

val completion_investigation_observations : (nat * (nat * nat)) list =
  maps (fn f =>
         map_filter
           (fn x =>
             (if completion_investigation_observe f x
               then SOME (f, (x, zero_nata)) else NONE))
           [zero_nata, one_nata])
    [zero_nata, one_nata, nat_of_integer (2 : IntInf.int)];

val completion_investigation_relation : (nat * nat) list =
  filtera
    (fn (c, d) =>
      (if completion_investigation_observe (nat_of_integer (2 : IntInf.int)) c
        then completion_investigation_observe (nat_of_integer (2 : IntInf.int))
               d
        else true))
    (investigation_pairs [zero_nata, one_nata]);

fun completion_investigation selected =
  investigation_basis [zero_nata, one_nata]
    [zero_nata, one_nata, nat_of_integer (2 : IntInf.int)] selected
    completion_investigation_observations completion_investigation_relation;

fun socket_investigation_observation f c =
  (if equal_nata f zero_nata orelse equal_nata f one_nata then zero_nata
    else (if equal_nata c zero_nata then nat_of_integer (18 : IntInf.int)
           else nat_of_integer (19 : IntInf.int)));

val schema_sockets_investigation_observations : (nat * (nat * nat)) list =
  maps (fn c =>
         map (fn f => (f, (c, socket_investigation_observation f c)))
           [zero_nata, one_nata, nat_of_integer (2 : IntInf.int)])
    [zero_nata, one_nata];

fun socket_investigation_compare c d =
  equal_boola (equal_nata c zero_nata) (equal_nata d zero_nata);

val schema_sockets_investigation_relation : (nat * nat) list =
  filtera (fn (a, b) => socket_investigation_compare a b)
    (investigation_pairs [zero_nata, one_nata]);

fun schema_sockets_investigation selected =
  investigation_basis [zero_nata, one_nata]
    [zero_nata, one_nata, nat_of_integer (2 : IntInf.int)] selected
    schema_sockets_investigation_observations
    schema_sockets_investigation_relation;

fun collection_example_rows n =
  (if equal_nata n one_nata
    then [(zero_nata, rev [(zero_nata, zero_nata), (zero_nata, one_nata)]),
           (one_nata, [(zero_nata, nat_of_integer (2 : IntInf.int))])]
    else (if equal_nata n (nat_of_integer (2 : IntInf.int))
           then [(zero_nata,
                   [(zero_nata, zero_nata), (zero_nata, one_nata)] @
                     [(zero_nata, zero_nata)]),
                  (one_nata, [(zero_nata, nat_of_integer (2 : IntInf.int))])]
           else (if equal_nata n (nat_of_integer (3 : IntInf.int))
                  then [(one_nata,
                          [(zero_nata, nat_of_integer (2 : IntInf.int))]),
                         (zero_nata,
                           [(zero_nata, zero_nata), (zero_nata, one_nata)])]
                  else (if equal_nata n (nat_of_integer (4 : IntInf.int))
                         then [(zero_nata,
                                 [(zero_nata, zero_nata),
                                   (zero_nata, one_nata)]),
                                (one_nata,
                                  [(zero_nata,
                                     nat_of_integer (2 : IntInf.int))]),
                                (zero_nata,
                                  [(zero_nata, zero_nata),
                                    (zero_nata, one_nata)])]
                         else (if equal_nata n (nat_of_integer (5 : IntInf.int))
                                then [(zero_nata, [(zero_nata, zero_nata)]),
                                       (one_nata,
 [(zero_nata, nat_of_integer (2 : IntInf.int))])]
                                else (if equal_nata n
   (nat_of_integer (6 : IntInf.int))
                                       then [(zero_nata,
       [(zero_nata, zero_nata), (zero_nata, one_nata)]),
      (zero_nata, rev [(zero_nata, zero_nata), (zero_nata, one_nata)]),
      (one_nata, [(zero_nata, nat_of_integer (2 : IntInf.int))])]
                                       else [(zero_nata,
       [(zero_nata, zero_nata), (zero_nata, one_nata)]),
      (one_nata, [(zero_nata, nat_of_integer (2 : IntInf.int))])]))))));

fun collection_investigation_decision f n =
  (if equal_nata f zero_nata
    then equal_seta
           (equal_prod equal_nat (equal_list (equal_prod equal_nat equal_nat)))
           (Set (collection_example_rows zero_nata))
           (Set (collection_example_rows n))
    else keyed_octet_profiles (collection_example_rows zero_nata)
           (collection_example_rows n));

val collection_investigation_observations : (nat * (nat * nat)) list =
  maps (fn c =>
         map (fn f =>
               (f, (c, (if collection_investigation_decision f c then one_nata
                         else zero_nata))))
           [zero_nata, one_nata])
    [zero_nata, one_nata, nat_of_integer (2 : IntInf.int),
      nat_of_integer (3 : IntInf.int), nat_of_integer (4 : IntInf.int),
      nat_of_integer (5 : IntInf.int), nat_of_integer (6 : IntInf.int)];

fun collection_example_subject n =
  fset_of_list (map (map_prod id fset_of_list) (collection_example_rows n));

fun collection_investigation_compare c d =
  equal_fseta
    (equal_prod equal_nat (equal_fset (equal_prod equal_nat equal_nat)))
    (collection_example_subject c) (collection_example_subject d);

val collection_investigation_relation : (nat * nat) list =
  filtera (fn (a, b) => collection_investigation_compare a b)
    (investigation_pairs
      [zero_nata, one_nata, nat_of_integer (2 : IntInf.int),
        nat_of_integer (3 : IntInf.int), nat_of_integer (4 : IntInf.int),
        nat_of_integer (5 : IntInf.int), nat_of_integer (6 : IntInf.int)]);

fun collection_investigation selected =
  investigation_basis
    [zero_nata, one_nata, nat_of_integer (2 : IntInf.int),
      nat_of_integer (3 : IntInf.int), nat_of_integer (4 : IntInf.int),
      nat_of_integer (5 : IntInf.int), nat_of_integer (6 : IntInf.int)]
    [zero_nata, one_nata] selected collection_investigation_observations
