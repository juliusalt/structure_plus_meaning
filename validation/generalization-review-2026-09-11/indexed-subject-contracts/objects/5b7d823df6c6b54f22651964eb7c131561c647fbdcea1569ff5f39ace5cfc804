                   (fn (f, w) =>
                     less_nat f (nat_of_integer (256 : IntInf.int)) andalso
                       less_nat w (nat_of_integer (256 : IntInf.int)))
                   vs))
         end
           b)
       ys andalso
      equal_fseta
        (equal_prod (equal_prod equal_nat equal_nat)
          (equal_fset (equal_prod equal_nat equal_nat)))
        (fset_of_list (map (map_prod id fset_of_list) xs))
