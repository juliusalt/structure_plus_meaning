    (fn (m, k) =>
      list_all
        (fn w =>
          list_all
            (fn q =>
              (if reasoning_method_quality m w q
                then reasoning_method_quality k w q else true))
            [zero_nata, one_nata, nat_of_integer (2 : IntInf.int)])
        [zero_nata, one_nata])
    (investigation_pairs
      [zero_nata, one_nata, nat_of_integer (2 : IntInf.int)]);

