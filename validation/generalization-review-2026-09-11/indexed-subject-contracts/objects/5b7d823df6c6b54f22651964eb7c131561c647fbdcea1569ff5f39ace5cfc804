                (fn (f, w) =>
                  less_nat f (nat_of_integer (256 : IntInf.int)) andalso
                    less_nat w (nat_of_integer (256 : IntInf.int)))
                vs))
      end
        b)
    xs andalso
    (list_all
       (fn (a, b) =>
         let
           val (c, d) = a;
         in
           (fn vs =>
             less_nat c (nat_of_integer (256 : IntInf.int)) andalso
               (less_nat d (nat_of_integer (256 : IntInf.int)) andalso
