      (if equal_finite_structured_object_ext (equal_list equal_nat)
            (equal_list equal_nat) equal_unit c finite_empty_artifact
        then SOME [] else NONE)
    | Finite_Anchor (_, _) => NONE)
  | finite_enumeration_read read (Finite_Payload v) = NONE
  | finite_enumeration_read read (Finite_Pair (x, xs)) =
    (case read x of NONE => NONE
      | SOME a =>
        map_option (fn b => a :: b) (finite_enumeration_read read xs));

fun finite_material_observation (Finite_Target (Finite_Whole c)) atoms edges
  counts functions =
  (case (finite_enumeration_read (finite_atom_read c) atoms,
          (finite_enumeration_read (finite_incidence_read c) edges,
            (finite_enumeration_read (finite_attachment_read c) counts,
              finite_enumeration_read (finite_attachment_read c) functions)))
    of (NONE, _) => false | (SOME _, (NONE, _)) => false
    | (SOME _, (SOME _, (NONE, _))) => false
    | (SOME _, (SOME _, (SOME _, NONE))) => false
    | (SOME a, (SOME e, (SOME ba, SOME b))) =>
      finite_artifact_enumeration c a e ba b)
  | finite_material_observation (Finite_Target (Finite_Anchor (va, vb))) atoms
    edges counts functions = false
  | finite_material_observation (Finite_Payload v) atoms edges counts functions
    = false
  | finite_material_observation (Finite_Pair (v, va)) atoms edges counts
    functions = false;

fun finite_pattern_instances A_ v (Finite_Variable a) =
  fimage snd (ffilter (fn x => eq A_ (fst x) a) v)
  | finite_pattern_instances A_ v (Finite_Pattern_Target t) =
    (if finite_target_formed t
      then finsert equal_finite_factor_term (Finite_Target t) bot_fset
      else bot_fset)
  | finite_pattern_instances A_ va (Finite_Pattern_Payload v) =
    (if octets_formed v
      then finsert equal_finite_factor_term (Finite_Payload v) bot_fset
      else bot_fset)
  | finite_pattern_instances A_ v (Finite_Pattern_Pair (p, q)) =
    ffUnion equal_finite_factor_term
      (fimage
        (fn x =>
          fimage (fn a => Finite_Pair (x, a)) (finite_pattern_instances A_ v q))
        (finite_pattern_instances A_ v p));

fun finite_material_satisfied A_ v m =
  bex (fset (finite_pattern_instances A_ v (finite_material_source m)))
    (fn s =>
      bex (fset (finite_pattern_instances A_ v (finite_material_atoms m)))
        (fn a =>
          bex (fset (finite_pattern_instances A_ v (finite_material_edges m)))
            (fn e =>
              bex (fset (finite_pattern_instances A_ v
                          (finite_material_counts m)))
                (fn b =>
                  bex (fset (finite_pattern_instances A_ v
                              (finite_material_functions m)))
                    (finite_material_observation s a e b)))));

fun finite_schema_material_satisfied A_ s v =
  ball (fset (finite_schema_materials s))
    (fn (_, a) => finite_material_satisfied A_ v a);

fun finite_schema_generation A_ B_ C_ s ps k =
  (if finite_schema_formed A_ B_ C_ s andalso
        equal_seta
          (equal_prod B_ (equal_prod C_ (equal_finite_term_pattern A_)))
          (Set ps) (fset (finite_schema_premises s))
    then ffUnion
           (equal_prod equal_finite_factor_term
             (equal_prod (equal_fset (equal_prod A_ equal_finite_factor_term))
               (equal_fset
                 (equal_prod B_ (equal_prod C_ equal_finite_factor_term)))))
           (fimage
             (fn (v, h) =>
               fimage (fn t => (t, (v, h)))
                 (ffilter
                   (fn t =>
                     finite_schema_instance A_ B_ C_ s v t h andalso
                       finite_schema_material_satisfied A_ s v)
                   (finite_pattern_instances A_ v
                     (finite_schema_conclusion s))))
             (fset_of_list (finite_premise_joins B_ C_ A_ ps k)))
    else bot_fset);

fun pair_scope_example n =
  (if equal_nata n one_nata
    then [(zero_nata, zero_nata), (zero_nata, one_nata), (one_nata, zero_nata),
           (one_nata, one_nata)]
    else (if equal_nata n (nat_of_integer (2 : IntInf.int))
           then rev [(zero_nata, zero_nata), (zero_nata, one_nata),
                      (one_nata, zero_nata), (one_nata, one_nata)]
           else (if equal_nata n (nat_of_integer (3 : IntInf.int))
                  then [(zero_nata, zero_nata), (zero_nata, one_nata),
                         (one_nata, zero_nata), (one_nata, one_nata)] @
                         [(zero_nata, zero_nata)]
                  else (if equal_nata n (nat_of_integer (4 : IntInf.int))
                         then [(zero_nata, one_nata), (one_nata, zero_nata),
                                (one_nata, one_nata)]
                         else (if equal_nata n (nat_of_integer (5 : IntInf.int))
                                then [(zero_nata, zero_nata),
                                       (zero_nata, one_nata),
                                       (one_nata, zero_nata),
                                       (one_nata, one_nata)] @
                                       [(nat_of_integer (2 : IntInf.int),
  nat_of_integer (2 : IntInf.int))]
                                else (if equal_nata n
   (nat_of_integer (6 : IntInf.int))
                                       then [(zero_nata, zero_nata),
      (zero_nata, one_nata), (one_nata, zero_nata), (one_nata, one_nata)] @
      [(zero_nata, one_nata), (one_nata, zero_nata)]
                                       else [(zero_nata, zero_nata),
      (one_nata, one_nata)]))))));

fun investigation_atoms rules known goals =
  map snd goals @ known @ map fst rules @ maps (fn (_, a) => map snd a) rules;

fun investigation_select A_ xs a =
  filtera (fn x => member A_ x (fset a)) (remdups A_ xs);

fun investigation_profile selected observations c =
  investigation_select (equal_prod equal_nat equal_nat)
    (map (fn (f, (_, a)) => (f, a)) observations)
    (finite_candidate_profile equal_nat equal_nat (fset_of_list selected)
      (fset_of_list observations) c);

fun investigation_pairs candidates =
  maps (fn c => map (fn a => (c, a)) candidates) candidates;

fun investigation_basis candidates facets selected observations relation =
  let
    val c = fset_of_list candidates;
    val u = fset_of_list facets;
    val f = fset_of_list selected;
    val table = fset_of_list observations;
    val compare =
      (fn ca => fn d =>
        membera (equal_prod equal_nat equal_nat) relation (ca, d));
    val residual =
      finite_basis_residual equal_nat equal_nat equal_nat c f table compare;
  in
    (finite_basis_evaluation equal_nat equal_nat equal_nat c u f table compare
       residual,
      (investigation_select (equal_prod equal_nat equal_nat)
         (investigation_pairs candidates) residual,
        (map (fn ca => (ca, investigation_profile selected observations ca))
           candidates,
          map (fn (ca, d) =>
                (ca, (d, investigation_select (equal_prod equal_nat equal_nat)
                           (investigation_profile selected observations ca)
                           (finite_candidate_losses equal_nat equal_nat
                             equal_nat f table ca d))))
            (investigation_pairs candidates))))
  end;

fun investigation_rules rules =
  fset_of_list (map (fn (a, h) => (a, fset_of_list h)) rules);

fun observation_profile_list A_ B_ f rows c =
  map_filter
    (fn x =>
      (if let
            val (fa, (d, _)) = x;
          in
            membera A_ f fa andalso eq B_ d c
          end
        then SOME let
                    val (fa, (_, a)) = x;
                  in
                    (fa, a)
                  end
        else NONE))
    rows;

fun observation_losses_list A_ B_ C_ f rows c d =
  filtera
    (fn x =>
      not (membera (equal_prod A_ C_) (observation_profile_list A_ B_ f rows d)
            x))
    (observation_profile_list A_ B_ f rows c);

fun pair_scope_complete n =
  equal_seta (equal_prod equal_nat equal_nat) (Set (pair_scope_example n))
    (producta (insert equal_nat zero_nata (insert equal_nat one_nata bot_set))
      (insert equal_nat zero_nata (insert equal_nat one_nata bot_set)));

fun finite_inference_round A_ B_ f k x =
  sup_set A_ (fset k)
    (image fst
      (filter
        (fn (_, h) =>
          finite_premise_functional B_ A_ h andalso
            less_eq_set A_ (image snd (fset h)) x)
        (fset f)));

fun investigation_extend selected repairs =
  remdups equal_nat (selected @ map (fn (_, (_, (f, _))) => f) repairs);

fun finite_sound_observation_facets A_ B_ C_ c relation u table =
  ffilter
    (fn f =>
      ball (fset c)
        (fn ca =>
          ball (fset c)
            (fn d =>
              (if relation ca d
                then less_eq_set (equal_prod B_ C_)
                       (fset (finite_candidate_profile B_ A_
                               (finsert B_ f bot_fset) table ca))
                       (fset (finite_candidate_profile B_ A_
                               (finsert B_ f bot_fset) table d))
                else true))))
    u;

fun investigation_retain candidates facets selected observations relation =
  investigation_select equal_nat selected
    (finite_sound_observation_facets equal_nat equal_nat equal_nat
      (fset_of_list candidates)
      (fn c => fn d => membera (equal_prod equal_nat equal_nat) relation (c, d))
      (fset_of_list facets) (fset_of_list observations));

fun proof_probe_compare c d =
  equal_boola (equal_nata c zero_nata) (equal_nata d zero_nata);

fun finite_inference_formed A_ B_ f =
  ball (fset f) (fn (_, a) => finite_premise_functional B_ A_ a);

fun finite_inference_result A_ B_ f k =
  whilea
    (fn x => not (eq (equal_set A_) (finite_inference_round A_ B_ f k x) x))
    (finite_inference_round A_ B_ f k) bot_set;

fun finite_inference_demand_reasons A_ B_ f k a =
  let
    val demanded = finite_inference_demand A_ B_ f k a;
  in
    ffUnion
      (equal_prod A_
        (equal_prod (equal_fset (equal_prod B_ A_)) (equal_prod B_ A_)))
      (fimage
        (fn (aa, h) =>
          (if member A_ aa (fset demanded) andalso
                (not (member A_ aa (fset k)) andalso
                  finite_premise_functional B_ A_ h)
            then fimage (fn (i, b) => (aa, (h, (i, b)))) h else bot_fset))
        f)
  end;

fun investigation_reasons rules known demanded =
  maps (fn (a, h) =>
         (if member equal_nat a (fset demanded) andalso
               (not (membera equal_nat known a) andalso
                 finite_premise_functional equal_nat equal_nat (fset_of_list h))
           then map (fn (i, b) => (a, (h, (i, b)))) h else []))
    rules;

fun finite_available_observation_repairs A_ B_ C_ c relation u f table =
  let
    val a =
      ffilter (fn fa => not (member B_ fa (fset f)))
        (finite_sound_observation_facets A_ B_ C_ c relation u table);
  in
    ffUnion (equal_prod A_ (equal_prod A_ (equal_prod B_ C_)))
      (fimage
        (fn (ca, d) =>
          (if relation ca d then bot_fset
            else fimage (fn (fa, w) => (ca, (d, (fa, w))))
                   (finite_candidate_losses B_ A_ C_ a table ca d)))
        (finite_basis_residual A_ B_ C_ c f table relation))
  end;

fun finite_unrepairable_comparisons A_ B_ C_ c relation u table =
  finite_basis_residual A_ B_ C_ c
    (finite_sound_observation_facets A_ B_ C_ c relation u table) table
    relation;

fun finite_observation_conflicts A_ B_ C_ c relation f table =
  ffUnion (equal_prod A_ (equal_prod A_ (equal_prod B_ C_)))
    (fimage
      (fn ca =>
        ffUnion (equal_prod A_ (equal_prod A_ (equal_prod B_ C_)))
          (fimage
            (fn d =>
              (if relation ca d
                then fimage (fn (fa, w) => (ca, (d, (fa, w))))
                       (finite_candidate_losses B_ A_ C_ f table ca d)
                else bot_fset))
            c))
      c);

fun investigation_loss_rows candidates observations =
  maps (fn (c, d) => map (fn (f, (_, w)) => (c, (d, (f, w)))) observations)
    (investigation_pairs candidates);

fun investigation_repairs candidates facets selected observations relation =
  let
    val c = fset_of_list candidates;
    val u = fset_of_list facets;
    val f = fset_of_list selected;
    val table = fset_of_list observations;
    val compare =
      (fn ca => fn d =>
        membera (equal_prod equal_nat equal_nat) relation (ca, d));
    val loss_rows = investigation_loss_rows candidates observations;
  in
    (investigation_select equal_nat facets
       (finite_sound_observation_facets equal_nat equal_nat equal_nat c compare
         u table),
      (investigation_select
         (equal_prod equal_nat
           (equal_prod equal_nat (equal_prod equal_nat equal_nat)))
         loss_rows
         (finite_observation_conflicts equal_nat equal_nat equal_nat c compare f
           table),
        (investigation_select
           (equal_prod equal_nat
             (equal_prod equal_nat (equal_prod equal_nat equal_nat)))
           loss_rows
           (finite_available_observation_repairs equal_nat equal_nat equal_nat c
             compare u f table),
          investigation_select (equal_prod equal_nat equal_nat)
            (investigation_pairs candidates)
            (finite_unrepairable_comparisons equal_nat equal_nat equal_nat c
              compare u table))))
  end;

fun revision_workload i =
  ([zero_nata, one_nata],
    ((if equal_nata i (nat_of_integer (2 : IntInf.int))
       then [zero_nata, nat_of_integer (2 : IntInf.int),
              nat_of_integer (3 : IntInf.int)]
       else [zero_nata, one_nata, nat_of_integer (2 : IntInf.int),
              nat_of_integer (3 : IntInf.int)]),
      ((if equal_nata i one_nata
         then [one_nata, nat_of_integer (2 : IntInf.int)]
         else (if equal_nata i (nat_of_integer (3 : IntInf.int))
                then [nat_of_integer (2 : IntInf.int)]
                else (if equal_nata i (nat_of_integer (4 : IntInf.int)) then []
                       else [zero_nata, nat_of_integer (2 : IntInf.int)]))),
        ([(zero_nata, (zero_nata, zero_nata)),
           (zero_nata, (one_nata, one_nata))] @
           (if equal_nata i (nat_of_integer (2 : IntInf.int)) then []
             else [(one_nata, (one_nata, zero_nata))]) @
             [(nat_of_integer (2 : IntInf.int), (zero_nata, zero_nata)),
               (nat_of_integer (2 : IntInf.int), (one_nata, zero_nata)),
               (nat_of_integer (3 : IntInf.int), (zero_nata, zero_nata)),
               (nat_of_integer (3 : IntInf.int), (one_nata, zero_nata))],
          [(zero_nata, zero_nata), (zero_nata, one_nata),
            (one_nata, one_nata)]))));

fun investigation_revision candidates facets selected observations relation =
  let
    val retained =
      investigation_retain candidates facets selected observations relation;
    val withdrawn =
      filtera (fn f => not (membera equal_nat retained f))
        (remdups equal_nat selected);
    val repairs =
      fst (snd (snd (investigation_repairs candidates facets retained
                      observations relation)));
    val revised = investigation_extend retained repairs;
    val residual =
      fst (snd (investigation_basis candidates facets revised observations
                 relation));
  in
    (retained, (withdrawn, (repairs, (revised, residual))))
  end;

fun finite_inference_residual A_ B_ C_ f k h =
  (if equal_fseta (equal_prod C_ A_) h bot_fset then bot_fset
    else let
           val settled = finite_inference_result A_ B_ f k;
         in
           ffilter (fn (_, a) => not (member A_ a settled)) h
         end);

fun investigation_inference rules known goals =
  let
    val f = investigation_rules rules;
    val k = fset_of_list known;
    val h = fset_of_list goals;
    val g = finite_inference_residual equal_nat equal_nat equal_nat f k h;
    val d = finite_inference_demand equal_nat equal_nat f k (fimage snd h);
  in
    (finite_inference_formed equal_nat equal_nat f andalso
       finite_premise_functional equal_nat equal_nat h,
      (investigation_select (equal_prod equal_nat equal_nat) goals g,
        (investigation_select equal_nat (investigation_atoms rules known goals)
           d,
          investigation_reasons rules known d)))
  end;

fun admission_direct_pair_head (B1_, B2_) pair payload a b n =
  let
    val nila = payload [];
    val goal =
      pair (payload [one B1_])
        (pair (pair (payload [zero B2_]) a) (pair (payload [zero B2_]) b));
    val instruction = pair n (pair a (pair b nila));
  in
    pair (pair goal n) (pair n (pair (pair nila n) (pair instruction nila)))
  end;

fun finite_admission_counter n =
  (if equal_nata n zero_nata then Finite_Payload []
    else Finite_Pair
           (Finite_Payload [],
             finite_admission_counter (minus_nat n one_nata)));

val reasoning_false_goal : finite_factor_term =
  admission_direct_pair_head (one_nat, zero_nat)
    (fn a => fn b => Finite_Pair (a, b)) Finite_Payload
    (finite_admission_counter zero_nata) (finite_admission_counter one_nata)
    (Finite_Payload [zero_nata]);

fun pattern_investigation_replacement c =
  (if equal_nata c zero_nata then Pattern_Variable zero_nata
    else (if equal_nata c one_nata then Pattern_Variable one_nata
           else (if equal_nata c (nat_of_integer (2 : IntInf.int))
                  then Pattern_Payload [zero_nata]
                  else (if equal_nata c (nat_of_integer (3 : IntInf.int))
                         then Pattern_Payload [one_nata]
                         else Pattern_Target
                                (Whole_Artifact empty_artifact)))));

fun pattern_investigation_pattern c =
  pattern_substitute (fn _ => pattern_investigation_replacement c)
    (Pattern_Pair (Pattern_Variable (), Pattern_Variable ()));

fun pattern_investigation_marker collapsed f a =
  (if equal_nata f zero_nata
    then Payload_Term (if collapsed then [zero_nata] else [a])
    else Target_Term (Whole_Artifact empty_artifact));

fun pattern_investigation_value (Pair_Term (Payload_Term a, y)) =
  (if equal_lista equal_nat a [zero_nata] then zero_nata
    else (if equal_lista equal_nat a [one_nata] then one_nata
           else nat_of_integer (3 : IntInf.int)))
  | pattern_investigation_value (Pair_Term (Target_Term k, y)) =
    nat_of_integer (2 : IntInf.int)
  | pattern_investigation_value (Target_Term v) =
    nat_of_integer (3 : IntInf.int)
  | pattern_investigation_value (Payload_Term v) =
    nat_of_integer (3 : IntInf.int)
  | pattern_investigation_value (Pair_Term (Pair_Term (vb, vc), va)) =
    nat_of_integer (3 : IntInf.int);

fun pattern_investigation_observation collapsed f c =
  pattern_investigation_value
    (evaluate_pattern (pattern_investigation_marker collapsed f)
      (pattern_investigation_pattern c));

fun pattern_investigation_observations collapsed =
  maps (fn c =>
         map (fn f => (f, (c, pattern_investigation_observation collapsed f c)))
           [zero_nata, one_nata])
    [zero_nata, one_nata, nat_of_integer (2 : IntInf.int),
      nat_of_integer (3 : IntInf.int), nat_of_integer (4 : IntInf.int)];

fun pattern_investigation_compare c d =
  equal_nata
    (if equal_nata c zero_nata then zero_nata
      else (if equal_nata c one_nata then one_nata
             else (if equal_nata c (nat_of_integer (2 : IntInf.int))
                    then nat_of_integer (2 : IntInf.int)
                    else (if equal_nata c (nat_of_integer (3 : IntInf.int))
                           then nat_of_integer (3 : IntInf.int)
                           else nat_of_integer (4 : IntInf.int)))))
    (if equal_nata d zero_nata then zero_nata
      else (if equal_nata d one_nata then one_nata
             else (if equal_nata d (nat_of_integer (2 : IntInf.int))
                    then nat_of_integer (2 : IntInf.int)
                    else (if equal_nata d (nat_of_integer (3 : IntInf.int))
                           then nat_of_integer (3 : IntInf.int)
                           else nat_of_integer (4 : IntInf.int)))));

val pattern_investigation_relation : (nat * nat) list =
  filtera (fn (a, b) => pattern_investigation_compare a b)
    (investigation_pairs
      [zero_nata, one_nata, nat_of_integer (2 : IntInf.int),
        nat_of_integer (3 : IntInf.int), nat_of_integer (4 : IntInf.int)]);

fun pattern_investigation collapsed selected =
  investigation_basis
    [zero_nata, one_nata, nat_of_integer (2 : IntInf.int),
      nat_of_integer (3 : IntInf.int), nat_of_integer (4 : IntInf.int)]
    [zero_nata, one_nata] selected
    (pattern_investigation_observations collapsed)
    pattern_investigation_relation;

fun pair_scope_investigation_decision f n =
  (if equal_nata f zero_nata
    then equal_lista (equal_prod equal_nat equal_nat) (pair_scope_example n)
           [(zero_nata, zero_nata), (one_nata, one_nata)]
    else data_product_octets [zero_nata, one_nata] [zero_nata, one_nata]
           (pair_scope_example n));

val pair_scope_investigation_observations : (nat * (nat * nat)) list =
  maps (fn c =>
         map (fn f =>
               (f, (c, (if pair_scope_investigation_decision f c then one_nata
                         else zero_nata))))
           [zero_nata, one_nata])
    [zero_nata, one_nata, nat_of_integer (2 : IntInf.int),
      nat_of_integer (3 : IntInf.int), nat_of_integer (4 : IntInf.int),
      nat_of_integer (5 : IntInf.int), nat_of_integer (6 : IntInf.int)];

fun pair_scope_investigation_compare c d =
  equal_boola (pair_scope_complete c) (pair_scope_complete d);

val pair_scope_investigation_relation : (nat * nat) list =
  filtera (fn (a, b) => pair_scope_investigation_compare a b)
    (investigation_pairs
      [zero_nata, one_nata, nat_of_integer (2 : IntInf.int),
        nat_of_integer (3 : IntInf.int), nat_of_integer (4 : IntInf.int),
        nat_of_integer (5 : IntInf.int), nat_of_integer (6 : IntInf.int)]);

fun pair_scope_investigation selected =
  investigation_basis
    [zero_nata, one_nata, nat_of_integer (2 : IntInf.int),
      nat_of_integer (3 : IntInf.int), nat_of_integer (4 : IntInf.int),
      nat_of_integer (5 : IntInf.int), nat_of_integer (6 : IntInf.int)]
    [zero_nata, one_nata] selected pair_scope_investigation_observations
    pair_scope_investigation_relation;

fun permission_investigation_decision f c i =
  (if equal_nata f zero_nata
    then not (equal_nata c zero_nata) orelse equal_nata i zero_nata
    else not (equal_nata c zero_nata) andalso not (equal_nata c one_nata));

val permission_investigation_observations : (nat * (nat * nat)) list =
  maps (fn c =>
         maps (fn f =>
                map (fn i =>
                      (f, (c, plus_nata
                                (times_nat (nat_of_integer (2 : IntInf.int)) i)
                                (if permission_investigation_decision f c i
                                  then one_nata else zero_nata))))
                  [zero_nata, one_nata])
           [zero_nata, one_nata])
    [zero_nata, one_nata, nat_of_integer (2 : IntInf.int)];

fun permission_investigation_compare c d =
  list_all
    (fn f =>
      list_all
        (fn i =>
          equal_boola (permission_investigation_decision f c i)
            (permission_investigation_decision f d i))
        [zero_nata, one_nata])
    [zero_nata, one_nata];

val permission_investigation_relation : (nat * nat) list =
  filtera (fn (a, b) => permission_investigation_compare a b)
    (investigation_pairs
      [zero_nata, one_nata, nat_of_integer (2 : IntInf.int)]);

fun permission_investigation selected =
  investigation_basis [zero_nata, one_nata, nat_of_integer (2 : IntInf.int)]
    [zero_nata, one_nata] selected permission_investigation_observations
    permission_investigation_relation;

fun proof_probe_observation f c =
  (if equal_nata f zero_nata orelse
        (equal_nata f one_nata orelse not (equal_nata c zero_nata))
    then nat_of_integer (3 : IntInf.int) else nat_of_integer (2 : IntInf.int));

fun finite_generated_schema_applications A_ B_ C_ D_ l c =
  ffUnion
