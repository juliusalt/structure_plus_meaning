fun revision_method_selection method input =
  let
    val (c, (u, (f, (t, r)))) = input;
    val report = investigation_repairs c u f t r;
    val retained = investigation_retain c u f t r;
    val old_repairs = fst (snd (snd report));
  in
    (if equal_nata method zero_nata then investigation_extend f old_repairs
      else (if equal_nata method one_nata
             then investigation_extend retained old_repairs
             else (if equal_nata method (nat_of_integer (2 : IntInf.int))
                    then fst (snd (snd (snd
 (investigation_revision c u f t r))))
                    else (if equal_nata method (nat_of_integer (3 : IntInf.int))
                           then fst report
                           else (if equal_nata method
                                      (nat_of_integer (4 : IntInf.int))
                                  then retained
                                  else investigation_extend []
 (fst (snd (snd (investigation_repairs c u [] t r)))))))))
  end;

fun revision_method_quality method workload q =
  let
    val (c, (u, (f, (t, r)))) = revision_workload workload;
    val g = revision_method_selection method (c, (u, (f, (t, r))));
    val report = investigation_repairs c u g t r;
    val retained = investigation_retain c u f t r;
    val repairs = fst (snd (snd (investigation_repairs c u retained t r)));
  in
    (if equal_nata q zero_nata then null (fst (snd report))
      else (if equal_nata q one_nata then superset equal_nat g retained
             else (if equal_nata q (nat_of_integer (2 : IntInf.int))
                    then equal_seta (equal_prod equal_nat equal_nat)
                           (Set (filtera
                                  (fn (ca, d) =>
                                    not (membera
  (equal_prod equal_nat equal_nat) r (ca, d)))
                                  (fst (snd (investigation_basis c u g t r)))))
                           (Set (snd (snd (snd report))))
                    else equal_nata q (nat_of_integer (3 : IntInf.int)) andalso
                           less_eq_set equal_nat
                             (minus_set equal_nat (Set g) (Set f))
                             (Set (map (fn (_, (_, (fa, _))) => fa) repairs)))))
  end;

