"""Propose index wrappers around the one actual subject operation."""
from pathlib import Path
import json
b=Path(__file__).parent
w=b/'worktree/theories'

def block(source, name):
    start=source.index('definition '+name)
    end=source.index('\n\n', start)+2
    return start,end,source[start:end]

def move(source,name,before):
    start,end,definition=block(source,name)
    source=source[:start]+source[end:]
    i=source.index('definition '+before)
    return source[:i]+definition+source[i:]

records=[
 ('Factor_Observation_Investigation','observation','observation_investigation_output n'),
 ('Factor_Observation_Collection_Investigation','collection','collection_example_rows n'),
 ('Factor_Observation_Scope_Investigation','scope','observation_scope_example_argument n'),
 ('Factor_Pair_Scope_Investigation','pair_scope','pair_scope_example n'),
 ('Factor_Observation_Table_Investigation','table','(table_example_profiles n,table_example_losses n)'),
 ('Factor_Investigation_Input_Investigation','input','input_subject_data n')]
for name,prefix,subject in records:
    p=w/(name+'.thy');s=p.read_text();index=prefix+'_investigation_decision';operation=prefix+'_subject_operation'
    if prefix=='input':s=move(s,'input_subject_data',index)
    s=move(s,operation,index)
    start,end,old=block(s,index)
    header=old.split(' where\n',1)[0]+' where\n'
    s=s[:start]+header+'  "'+index+' f n='+operation+' f ('+subject+')"\n\n'+s[end:]
    extra=operation+'_def'+(' input_subject_data_def Let_def case_prod_conv' if prefix=='input' else ' case_prod_conv' if prefix=='table' else '')
    s=s.replace(index+'_def',index+'_def '+extra)
    start=s.index('  by ',s.index('lemma '+prefix+'_subject_decision_at:'));end=s.index('\n\n',start)
    s=s[:start]+'  by (simp only: '+index+'_def)'+s[end:]
    if prefix in ['input','table']:
        condition=prefix+'_subject_complete';admitted=prefix+'_example_admitted' if prefix=='input' else 'table_example_complete'
        s=move(s,condition,admitted)
        start,end,old=block(s,admitted);header=old.split(' where\n',1)[0]+' where\n'
        s=s[:start]+header+'  "'+admitted+' n='+condition+' ('+subject+')"\n\n'+s[end:]
        s=s.replace(admitted+'_def',admitted+'_def '+condition+'_def'+(' input_subject_data_def' if prefix=='input' else '')+' case_prod_conv')
        start=s.index('  by ',s.index('lemma '+prefix+'_subject_complete_at:'));end=s.index('\n\n',start)
        s=s[:start]+'  by (simp only: '+admitted+'_def)'+s[end:]
    p.write_text(s)
p=w/'Presentation_Completion_Investigation.thy';s=p.read_text();s=move(s,'completion_subject_operation','completion_investigation_observe')
start,end,old=block(s,'completion_investigation_observe')
s=s[:start]+old.split(' where\n',1)[0]+' where\n  "completion_investigation_observe f c=completion_subject_operation f (id,completion_investigation_test c)"\n\n'+s[end:]
s=s.replace('completion_investigation_observe_def','completion_investigation_observe_def completion_subject_operation_def')
start=s.index('  by ',s.index('lemma completion_subject_decision_at:'));end=s.index('\n\n',start)
s=s[:start]+'  by (simp only: completion_investigation_observe_def)'+s[end:];p.write_text(s)
p=w/'Factor_Substitution_Investigation.thy';s=p.read_text().replace('metis )','metis)');p.write_text(s)
proposal={'problem':'Make each indexed native decision instantiate its actual structural operation rather than retain two parallel native-call definitions.',
 'existing_acceptance':str(b/'candidate9/receipt.json'),
 'candidates':{'before':'The exact subject bridge relates two separately written native expressions.',
               'proposed':'The native expression is defined once on the complete subject; the numeric interface applies that operation to its subject map.'},
 'requirements':['Every original native code equation, subject contract and complete runtime result still holds.','Each changed scalar definition delegates to its actual subject operation.','The independent complete-input and complete-table predicates are also defined once on their complete subjects.'],
 'changed_theories':[r[0] for r in records]+['Presentation_Completion_Investigation','Factor_Substitution_Investigation'],
 'boundary':'This is an externally generated isolated refactoring proposal. Accepted source equations and complete runtime comparisons are required before selecting it for integration.'}
(b/'operation-factoring-proposal.json').write_text(json.dumps(proposal,indent=2)+'\n')
print(proposal['changed_theories'])
