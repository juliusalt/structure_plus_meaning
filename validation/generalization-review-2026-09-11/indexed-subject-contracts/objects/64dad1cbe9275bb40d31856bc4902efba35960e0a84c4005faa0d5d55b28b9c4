theory Finite_Derived_Observations
  imports Finite_Investigation_Interface
begin

section \<open>Observation indices present actual subjects, operations and values\<close>

definition finite_derived_observations where
  "finite_derived_observations C U W P=ffUnion (fimage (\<lambda>(f,u).
    ffUnion (fimage (\<lambda>(c,s). fimage (\<lambda>(w,v). (f,c,w))
      (ffilter (\<lambda>(w,v). P u s v) W)) C)) U)"

lemma finite_derived_observation_member:
  "(f,c,w) |\<in>| finite_derived_observations C U W P \<longleftrightarrow>
    (\<exists>u s v. (f,u) |\<in>| U \<and> (c,s) |\<in>| C \<and>
      (w,v) |\<in>| W \<and> P u s v)"
  by (auto simp: finite_derived_observations_def ffUnion.rep_eq fimage.rep_eq
    image_iff split: prod.splits; force)

definition finite_observation_subjects_formed where
  "finite_observation_subjects_formed C U W \<longleftrightarrow>
    single_valued (fset C) \<and> single_valued (fset U) \<and> single_valued (fset W)"

theorem finite_derived_observation_at_subject:
  assumes scope: "finite_observation_subjects_formed C U W"
    and candidate: "(c,s) |\<in>| C" and operation: "(f,u) |\<in>| U"
    and output_value: "(w,v) |\<in>| W"
  shows "(f,c,w) |\<in>| finite_derived_observations C U W P \<longleftrightarrow> P u s v"
  using assms by (auto simp: finite_derived_observation_member
    finite_observation_subjects_formed_def single_valued_def; blast)

lemma finite_derived_observations_formed:
  "finite_observation_table_formed (fimage fst C) (fimage fst U)
    (finite_derived_observations C U W P)"
  by (auto simp: finite_observation_table_formed_def finite_derived_observation_member; force)

theorem finite_derived_profile_at_subject:
  assumes scope: "finite_observation_subjects_formed C U W"
    and candidate: "(c,s) |\<in>| C"
  shows "fset (finite_candidate_profile F (finite_derived_observations C U W P) c)=
    {(f,w). f |\<in>| F \<and> (\<exists>u v. (f,u) |\<in>| U \<and> (w,v) |\<in>| W \<and> P u s v)}"
proof -
  have functional: "single_valued (fset C)"
    using scope by (simp add: finite_observation_subjects_formed_def)
  have rows: "(f,c,w) |\<in>| finite_derived_observations C U W P \<longleftrightarrow>
    (\<exists>u v. (f,u) |\<in>| U \<and> (w,v) |\<in>| W \<and> P u s v)" for f w
  proof
    assume member: "(f,c,w) |\<in>| finite_derived_observations C U W P"
    obtain u a v where actual: "(f,u) |\<in>| U" "(c,a) |\<in>| C"
      "(w,v) |\<in>| W" "P u a v"
      using member by (simp only: finite_derived_observation_member) blast
    have same: "a=s" by (rule single_valued_outputs[OF functional actual(2) candidate])
    show "\<exists>u v. (f,u) |\<in>| U \<and> (w,v) |\<in>| W \<and> P u s v"
      using actual same by blast
  next
    assume actual: "\<exists>u v. (f,u) |\<in>| U \<and> (w,v) |\<in>| W \<and> P u s v"
    show "(f,c,w) |\<in>| finite_derived_observations C U W P"
      using actual candidate by (simp only: finite_derived_observation_member) blast
  qed
  show ?thesis by (auto simp: finite_candidate_profile_exact candidate_profile_def
    finite_table_observations_def rows)
qed

theorem finite_derived_observations_extensional:
  assumes agreement: "\<And>f u c s w v. (f,u) |\<in>| U \<Longrightarrow> (c,s) |\<in>| C \<Longrightarrow>
    (w,v) |\<in>| W \<Longrightarrow> P u s v \<longleftrightarrow> Q u s v"
  shows "finite_derived_observations C U W P=finite_derived_observations C U W Q"
proof -
  have "fset (finite_derived_observations C U W P)=fset (finite_derived_observations C U W Q)"
    using agreement by (auto simp: finite_derived_observation_member split: prod.splits; blast)
  then show ?thesis by (simp only: fset_inject)
qed

section \<open>Function graphs present the complete finite source maps\<close>

lemma indexed_value_rows_member:
  "(f,c,w)\<in>set (concat (map (\<lambda>c. map (\<lambda>f. (f,c,value f c)) fs) cs)) \<longleftrightarrow>
    c\<in>set cs \<and> f\<in>set fs \<and> w=value f c"
  by auto

lemma indexed_predicate_rows_member:
  "(f,c,w)\<in>set (concat (map (\<lambda>f. concat (map (\<lambda>c.
      map (\<lambda>w. (f,c,w)) (filter (P f c) ws)) cs)) fs)) \<longleftrightarrow>
    f\<in>set fs \<and> c\<in>set cs \<and> w\<in>set ws \<and> P f c w"
  by auto

lemma finite_function_graph:
  "fset (fimage (\<lambda>i. (i,S i)) I)=graph_map (fset I) S"
  by (auto simp: fimage.rep_eq graph_map_def)

lemma finite_observation_function_graphs_formed:
  "finite_observation_subjects_formed
    (fimage (\<lambda>c. (c,C c)) Cs) (fimage (\<lambda>f. (f,U f)) Us)
    (fimage (\<lambda>w. (w,W w)) Ws)"
  by (simp only: finite_observation_subjects_formed_def finite_function_graph
    graph_map_single_valued; simp)

theorem finite_derived_observation_on_function_graphs:
  "(f,c,w) |\<in>| finite_derived_observations
      (fimage (\<lambda>c. (c,C c)) Cs) (fimage (\<lambda>f. (f,U f)) Us)
      (fimage (\<lambda>w. (w,W w)) Ws) P \<longleftrightarrow>
    f |\<in>| Us \<and> c |\<in>| Cs \<and> w |\<in>| Ws \<and> P (U f) (C c) (W w)"
  by (auto simp: finite_derived_observation_member fimage.rep_eq)

theorem finite_table_derived_from_function_graphs:
  assumes equation: "\<And>f c w. (f,c,w) |\<in>| T \<longleftrightarrow>
    f |\<in>| Us \<and> c |\<in>| Cs \<and> w |\<in>| Ws \<and> P (U f) (C c) (W w)"
  shows "T=finite_derived_observations
    (fimage (\<lambda>c. (c,C c)) Cs) (fimage (\<lambda>f. (f,U f)) Us)
    (fimage (\<lambda>w. (w,W w)) Ws) P"
proof -
  have "fset T=fset (finite_derived_observations
      (fimage (\<lambda>c. (c,C c)) Cs) (fimage (\<lambda>f. (f,U f)) Us)
      (fimage (\<lambda>w. (w,W w)) Ws) P)"
    by (auto simp: equation finite_derived_observation_on_function_graphs)
  then show ?thesis by (simp only: fset_inject)
qed

text \<open>
  The source maps contain the actual candidate, operation and result subjects.
  An index contributes only through a row in those maps. The exact equation is
  about the independently supplied relation P on those subjects. A concrete
  operation must establish its own equation against that relation; a label,
  stored description or file identity cannot supply it.

  Functional maps prevent one index from silently selecting incompatible
  subjects. Several indices may present the same subject. Empty result sets
  and unrepresented values remain explicit. The existing finite comparison
  consumes the derived table without changing its observation semantics.
\<close>

export_code finite_derived_observations checking SML

end
