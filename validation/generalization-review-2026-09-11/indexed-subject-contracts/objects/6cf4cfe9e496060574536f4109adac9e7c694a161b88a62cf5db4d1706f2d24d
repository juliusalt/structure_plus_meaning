"""Compare the actual complete checker objects with their public JSON values."""
import ast
import inspect
import json
from pathlib import Path
import sys
sys.path.insert(0, str(Path(__file__).parent/'worktree/tools'))
import check_builtin_cases as checker
import check_reasoning as review
import investigate

b=Path(__file__).parent
cases=json.loads((b/'cases.json').read_text())['cases']
actual=checker.assess(cases,(b/'candidate6/results.log').read_text())['results']
expected=json.loads((b/'baseline1/complete-results.json').read_text())['results']
# Reuse the earlier complete host-type presentation, without running its old case driver.
source=Path('/tmp/generalization-quality-review/structural-binding-observations/replay-assessment-investigation.py')
assignment=next(node for node in ast.parse(source.read_text()).body
                if isinstance(node,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='CHILD' for t in node.targets))
child=ast.parse(ast.literal_eval(assignment.value))
typed=next(node for node in child.body if isinstance(node,ast.FunctionDef) and node.name=='typed')
ns={}
exec(compile(ast.Module(body=[typed],type_ignores=[]),str(source),'exec'),ns)
typed=ns['typed']
subjects=[]
for i,(a,e) in enumerate(zip(actual,expected)):
    outputs=[a,review.clone_json(a)]
    subjects.append({'case_index':i,'input':typed(a),'expected':typed(e),
                     'outputs':list(map(typed,outputs)),
                     'satisfied':[typed(value)==typed(e) for value in outputs]})
observations=[[0,c,w] for w,row in enumerate(subjects) for c,ok in enumerate(row['satisfied']) if ok]
profiles=[{w for f,d,w in observations if d==c} for c in [0,1]]
relation=[[c,d] for c in [0,1] for d in [0,1] if profiles[c]<=profiles[d]]
problem={'problem':'Preserve each complete accepted public JSON assessment while comparing actual checker results with the original stored baseline.',
         'condition':'Exact recursively typed equality with the complete decoded baseline assessment, retaining every field and ordered occurrence.',
         'operations':[{'source':'def identity(value): return value'}, {'source':inspect.getsource(review.clone_json)}],
         'subjects':subjects,'observations':observations,'relation':relation,
         'boundary':'Derived host observations of these actual complete objects under the existing identity and JSON-copy operations. The finite evaluator receives their conditional table; it does not prove arbitrary Python or JSON semantics.'}
p=b/'assessment-repair-subjects.json';p.write_text(json.dumps(problem,indent=2)+'\n')
case={'schema':investigate.SCHEMA,'kind':'basis','question':problem['problem'],
      'candidates':[0,1],'facets':[0],'selected':[],'observations':observations,'relation':relation,
      'scope':{'candidates':{'0':'Identity on the actual complete host assessment','1':'Existing JSON copy on that same assessment'},
               'facets':{'0':problem['condition']},'subjects':str(p)},
      'semantic_boundary':problem['boundary'],
      'evidence':[{'path':str(path),'sha256':investigate.file_hash(path)} for path in
                  [p,Path(__file__),source,Path(checker.__file__),Path(review.__file__),
                   b/'candidate6/results.log',b/'baseline1/complete-results.json']]}
investigate.validate_case(case)
spec={'question':problem['problem'],'boundary':problem['boundary'],
      'problems':[{'name':'builtin-assessment-json-boundary','case':case,
                   'required_observations':[[0,w] for w in range(len(subjects))]}]}
(b/'assessment-repair-specification.json').write_text(json.dumps(spec,indent=2)+'\n')
print({'case_count':len(subjects),'satisfied_case_indices':list(map(sorted,profiles)),'relation':relation})
