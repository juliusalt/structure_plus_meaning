        "source": "theory Factor_Pair_Scope_Investigation\n  imports Factor_Binder_Admission Factor_Data_Product_Execution Finite_Investigation_Interface\nbegin\n\nsection \\<open>All ordered pairs belong to a complete candidate scope\\<close>\n\nabbreviation pair_scope_full where\n  \"pair_scope_full \\<equiv> [(0::nat,0::nat),(0,1),(1,0),(1,1)]\"\n\ndefinition pair_scope_example :: \"nat \\<Rightarrow> (nat\\<times>nat) list\" where\n  \"pair_scope_example n=(if n=1 then pair_scope_full\n    else if n=2 then rev pair_scope_full\n    else if n=3 then pair_scope_full@[(0,0)]\n    else if n=4 then [(0,1),(1,0),(1,1)]\n    else if n=5 then pair_scope_full@[(2,2)]\n    else if n=6 then pair_scope_full@[(0,1),(1,0)]\n    else [(0,0),(1,1)])\"\n\nabbreviation pair_scope_row where\n  \"pair_scope_row z \\<equiv> case z of (c,d) \\<Rightarrow> Pair_Term (Payload_Term [c]) (Payload_Term [d])\"\n\nabbreviation pair_scope_term where\n  \"pair_scope_term n \\<equiv> data_list_term (map pair_scope_row (pair_scope_example n))\"\n\ndefinition pair_scope_investigation_decision :: \"nat \\<Rightarrow> nat \\<Rightarrow> bool\" where\n  \"pair_scope_investigation_decision f n=(if f=0 then\n    (53,Pair_Term (data_list_term [Payload_Term [0],Payload_Term [1]]) (pair_scope_term n))\n      \\<in>positive_meaning diagonal_rows_system\n    else (325,context_relation_argument (data_list_term [Payload_Term [0],Payload_Term [1]])\n      (data_list_term [Payload_Term [0],Payload_Term [1]]) (pair_scope_term n))\n      \\<in>positive_meaning data_product_system)\"\n\nlemma pair_scope_investigation_decision_code [code]:\n  \"pair_scope_investigation_decision f n=(if f=0 then pair_scope_example n=[(0,0),(1,1)]\n    else data_product_octets [0,1] [0,1] (pair_scope_example n))\"\nproof -\n  have diagonal: \"(53,Pair_Term (data_list_term [Payload_Term [0],Payload_Term [1]]) (pair_scope_term n))\n      \\<in>positive_meaning diagonal_rows_system \\<longleftrightarrow> pair_scope_example n=[(0,0),(1,1)]\"\n    by (simp only: diagonal_rows_at_list) (simp add: pair_scope_example_def octets_formed_def)\n  have encoded: \"map pair_scope_row xs=map (data_pair_encoding (\\<lambda>n. Payload_Term [n]) (\\<lambda>n. Payload_Term [n])) xs\" for xs\n    by (rule map_cong[OF refl]) (auto split: prod.splits)\n  show ?thesis by (simp only: pair_scope_investigation_decision_def diagonal)\n    (simp only: data_product_octets_def encoded list.map)\nqed\n\ndefinition pair_scope_complete :: \"nat \\<Rightarrow> bool\" where\n  \"pair_scope_complete n \\<longleftrightarrow> set (pair_scope_example n)={0,1}\\<times>{0,1}\"\n\ndefinition pair_scope_investigation_compare :: \"nat \\<Rightarrow> nat \\<Rightarrow> bool\" where\n  \"pair_scope_investigation_compare c d \\<longleftrightarrow> pair_scope_complete c=pair_scope_complete d\"\n\ndefinition pair_scope_investigation_observations :: \"(nat\\<times>nat\\<times>nat) list\" where\n  \"pair_scope_investigation_observations=concat (map (\\<lambda>c.\n    map (\\<lambda>f. (f,c,if pair_scope_investigation_decision f c then 1 else 0)) [0,1]) [0,1,2,3,4,5,6])\"\n\ndefinition pair_scope_investigation_relation :: \"(nat\\<times>nat) list\" where\n  \"pair_scope_investigation_relation=filter (\\<lambda>(c,d). pair_scope_investigation_compare c d)\n    (investigation_pairs [0,1,2,3,4,5,6])\"\n\nlemma pair_scope_investigation_relation_exact:\n  \"(c,d)\\<in>set pair_scope_investigation_relation \\<longleftrightarrow>\n    c\\<in>{0,1,2,3,4,5,6} \\<and> d\\<in>{0,1,2,3,4,5,6} \\<and> pair_scope_complete c=pair_scope_complete d\"\n  by (simp only: pair_scope_investigation_relation_def set_filter investigation_pairs_exact\n    mem_Collect_eq case_prod_conv pair_scope_investigation_compare_def list.set; blast)\n\ndefinition pair_scope_investigation where\n  \"pair_scope_investigation selected=investigation_basis [0,1,2,3,4,5,6] [0,1] selected\n    pair_scope_investigation_observations pair_scope_investigation_relation\"\n\nexport_code investigation_inference investigation_basis investigation_repairs investigation_extend pair_scope_investigation\n  pair_scope_investigation_observations pair_scope_investigation_relation nat_of_integer integer_of_nat\n  in SML module_name Finite_Investigation file_prefix finite_investigation\n\ntext \\<open>\n  The existing diagonal operation correctly constructs self pairs. Here its\n  actual decisions are investigated as a possible observation of complete\n  ordered pair coverage. The independent requirement includes every pair\n  from the declared two-candidate scope, with no extra pair. It admits every\n  order and repetition of that complete finite set. The second observation\n  calls the complete native Cartesian operation built from two maps,\n  flattening, explicit input admission, and finite-set comparison. Its Boolean result\n  identifies complete admission, not the identity of an incomplete output.\n\\<close>\n\nend\n",
        "source_sha256": "95405157c5987356f400a41213f058e16e57f2ca876632fc37a25332764586c2",
