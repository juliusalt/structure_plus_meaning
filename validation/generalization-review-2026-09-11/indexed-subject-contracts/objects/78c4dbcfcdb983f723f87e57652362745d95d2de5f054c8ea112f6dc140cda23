"""Compare actual runtime generators under changes to accompanying registry data."""
import json
from pathlib import Path
import subprocess
import sys
sys.path.insert(0,'/home/julius/structure_and_semantics/tools')
import investigate

b=Path(__file__).parent
child=r'''
import copy,inspect,json,sys
from pathlib import Path
sys.path.insert(0,sys.argv[1])
import investigate
b=Path(sys.argv[2]);mode=sys.argv[3]
cases=json.loads((b/'cases.json').read_text())['cases']
proof=json.loads((b/'candidate-code9/indexed_subject_exports.proof.json').read_text())
engine=Path(proof['exports'][0]['path'])
contracts=json.loads((b/'candidate9/receipt.json').read_text())['assessment']['formal_subject_contracts']
parameters=lambda case: (case,engine,contracts[case['kind']]) if mode=='structural' else (case,engine)
rows=[]
for i,case in enumerate(cases):
 descriptor=investigate.BUILTIN_CASES[case['kind']]
 original=copy.deepcopy(descriptor['scope'])
 initial=investigate.runtime_program(*parameters(case))
 changes=[dict(original,facets={k:'Changed accompanying description' for k in original['facets']}),
          dict(original,facets={'999':'A conflicting declared facet domain'})]
 outputs=[]
 for changed in changes:
  descriptor['scope']=changed
  outputs.append(investigate.runtime_program(*parameters(case)))
 descriptor['scope']=original
 rows.append({'case':case,'original_scope':original,'changed_scopes':changes,
              'original_program':initial,'changed_programs':outputs,
              'satisfied':[program==initial for program in outputs]})
print(json.dumps({'generator_source':inspect.getsource(investigate.runtime_program),'rows':rows}))
'''
proposals=[]
for directory,mode in [(Path('/tmp/native-investigation-report-diagnostic-indexedbaseline1/helper-sources'),'indexed'),
                       (b/'worktree/tools','structural')]:
    completed=subprocess.run([sys.executable,'-B','-c',child,str(directory),str(b),mode],capture_output=True,text=True,check=True)
    proposals.append(json.loads(completed.stdout))
assert [row['case'] for row in proposals[0]['rows']]==[row['case'] for row in proposals[1]['rows']]
observations=[[f,c,w] for c,p in enumerate(proposals) for w,row in enumerate(p['rows'])
              for f,ok in enumerate(row['satisfied']) if ok]
profiles=[{(f,w) for f,d,w in observations if c==d} for c in [0,1]]
relation=[[c,d] for c in [0,1] for d in [0,1] if profiles[c]<=profiles[d]]
subject={'problem':'Keep the runtime problem selected by the checked definition invariant under changes to the accompanying scope descriptions and facet dictionary.',
         'condition':'The entire generated runtime program remains exactly equal after replacing only the indicated registry scope object.',
         'proposals':proposals,'observations':observations,'relation':relation,
         'boundary':'These host observations compare the actual complete generated ML texts on every original finite case. They establish this exercised independence property. The subject equations and actual domains have their separate accepted Isabelle contract; no meaning is attributed to the supplied prose.'}
p=b/'registry-source-subjects.json';p.write_text(json.dumps(subject,indent=2)+'\n')
case={'schema':investigate.SCHEMA,'kind':'basis','question':subject['problem'],
      'candidates':[0,1],'facets':[0,1],'selected':[],'observations':observations,'relation':relation,
      'scope':{'candidates':{'0':'Original runtime generator on its complete inputs','1':'Generator supplied with the checked structural contract'},
               'facets':{'0':'Complete program equality after replacing facet descriptions','1':'Complete program equality after replacing the facet index dictionary'},'subjects':str(p)},
      'semantic_boundary':subject['boundary'],
      'evidence':[{'path':str(path),'sha256':investigate.file_hash(path)} for path in [p,Path(__file__),
                  b/'cases.json',b/'candidate9/receipt.json',b/'worktree/tools/investigate.py']]}
investigate.validate_case(case)
spec={'question':subject['problem'],'boundary':subject['boundary'],
      'problems':[{'name':'registry-independent-runtime-scope','case':case,
                   'required_observations':[[f,w] for f in [0,1] for w in range(98)]}]}
(b/'registry-source-specification.json').write_text(json.dumps(spec,indent=2)+'\n')
print({'complete_cases':98,'satisfied_counts':[[sum(row['satisfied'][f] for row in p['rows']) for f in [0,1]] for p in proposals], 'relation':relation})
