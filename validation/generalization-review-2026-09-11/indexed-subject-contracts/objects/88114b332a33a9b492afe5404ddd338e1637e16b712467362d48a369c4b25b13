from pathlib import Path
BASE=Path(__file__).parent
DRAFTS=BASE/'drafts'

def boolean_contracts(prefix,candidates,subject,operation,old_decision,observations,bridge_proof):
    ids='{|'+','.join(map(str,candidates))+'::nat|}'
    # Annotate the first numeral, since a trailing annotation would attach to
    # only the last member and obscures the source map's declared key type.
    ids='{|'+str(candidates[0])+'::nat'+''.join(','+str(c) for c in candidates[1:])+'|}'
    return rf"""
lemma {prefix}_subject_decision_at:
  "{operation} f ({subject.format(c='c')})={old_decision} f c"
  {bridge_proof}

definition {prefix}_candidate_subjects where
  "{prefix}_candidate_subjects=fimage (\<lambda>c. (c,{subject.format(c='c')})) {ids}"

definition {prefix}_operation_subjects where
  "{prefix}_operation_subjects=fimage (\<lambda>f. (f,{operation} f)) {{|0::nat,1|}}"

definition {prefix}_value_subjects where
  "{prefix}_value_subjects=fimage (\<lambda>w. (w,w=1)) {{|0::nat,1|}}"

lemma {prefix}_subject_maps_formed:
  "finite_observation_subjects_formed {prefix}_candidate_subjects {prefix}_operation_subjects {prefix}_value_subjects"
  unfolding {prefix}_candidate_subjects_def {prefix}_operation_subjects_def {prefix}_value_subjects_def
  by (rule finite_observation_function_graphs_formed)

lemma {prefix}_observations_derived:
  "fset_of_list {observations}=
    finite_derived_observations {prefix}_candidate_subjects {prefix}_operation_subjects
      {prefix}_value_subjects (\<lambda>operation subject value. value=operation subject)"
  unfolding {prefix}_candidate_subjects_def {prefix}_operation_subjects_def {prefix}_value_subjects_def
  apply (rule finite_table_derived_from_function_graphs)
  by (auto simp: {observations}_def {prefix}_subject_decision_at fset_of_list.rep_eq split: if_splits)

theorem {prefix}_observation_at_subject:
  assumes "(c,subject) |\<in>| {prefix}_candidate_subjects"
    "(f,operation) |\<in>| {prefix}_operation_subjects"
    "(w,value) |\<in>| {prefix}_value_subjects"
  shows "(f,c,w)\<in>set {observations} \<longleftrightarrow> value=operation subject"
  using finite_derived_observation_at_subject[OF {prefix}_subject_maps_formed assms]
  by (simp only: {prefix}_observations_derived[symmetric] fset_of_list.rep_eq)
"""

def add(name,body):
    path=DRAFTS/(name+'.thy')
    source=path.read_text().replace('Finite_Investigation_Interface','Finite_Derived_Observations')
    point=source.index('\nexport_code ')
    source=source[:point]+body+source[point:]
    path.write_text(source)

