      "source": "theory Factor_Observation_Collection_Investigation\n  imports Factor_Observation_Collection_Contracts Factor_Keyed_Set_Execution Finite_Investigation_Interface\nbegin\n\nsection \\<open>Nested profiles retain both levels of finite-set identity\\<close>\n\nabbreviation collection_example_profile where\n  \"collection_example_profile \\<equiv> [(0::nat,0::nat),(0,1)]\"\n\nabbreviation collection_example_other where\n  \"collection_example_other \\<equiv> [(0::nat,2::nat)]\"\n\ndefinition collection_example_rows :: \"nat \\<Rightarrow> (nat\\<times>(nat\\<times>nat) list) list\" where\n  \"collection_example_rows n=(if n=1 then [(0,rev collection_example_profile),(1,collection_example_other)]\n    else if n=2 then [(0,collection_example_profile@[(0,0)]),(1,collection_example_other)]\n    else if n=3 then [(1,collection_example_other),(0,collection_example_profile)]\n    else if n=4 then [(0,collection_example_profile),(1,collection_example_other),(0,collection_example_profile)]\n    else if n=5 then [(0,[(0,0)]),(1,collection_example_other)]\n    else if n=6 then [(0,collection_example_profile),(0,rev collection_example_profile),(1,collection_example_other)]\n    else [(0,collection_example_profile),(1,collection_example_other)])\"\n\nabbreviation collection_example_value where\n  \"collection_example_value z \\<equiv> keyed_octet_pair z\"\n\nabbreviation collection_example_row where\n  \"collection_example_row z \\<equiv> case z of (c,values) \\<Rightarrow>\n    Pair_Term (Payload_Term [c]) (data_list_term (map collection_example_value values))\"\n\nabbreviation collection_example_term where\n  \"collection_example_term n \\<equiv> data_list_term (map collection_example_row (collection_example_rows n))\"\n\nabbreviation collection_example_table where\n  \"collection_example_table \\<equiv> [(Payload_Term [0],Payload_Term [0],Payload_Term [0]),\n    (Payload_Term [0],Payload_Term [0],Payload_Term [1]),\n    (Payload_Term [0],Payload_Term [1],Payload_Term [2])]\"\n\nlemma collection_example_computed_profiles:\n  assumes \"c\\<in>{0,1}\"\n  shows \"(301,context_relation_argument (Pair_Term (data_list_term [Payload_Term [0]]) (Payload_Term [c]))\n    (data_list_term (map observation_row_term collection_example_table))\n    (data_list_term (map collection_example_value (if c=0 then collection_example_profile else collection_example_other))))\n      \\<in>positive_meaning observation_system\"\n  using assms by (simp only: observation_encoded_profile)\n    (auto simp: observation_profile_list_def octets_formed_def)\n\ndefinition collection_investigation_decision :: \"nat \\<Rightarrow> nat \\<Rightarrow> bool\" where\n  \"collection_investigation_decision f n=(if f=0 then\n    (219,Pair_Term (collection_example_term 0) (collection_example_term n))\n      \\<in>positive_meaning data_set_comparison_system\n    else (317,Pair_Term (collection_example_term 0) (collection_example_term n))\n      \\<in>positive_meaning keyed_set_system)\"\n\nlemma collection_example_value_injective: \"inj collection_example_value\"\n  by (auto simp: inj_on_def split: prod.splits)\n\nlemma collection_example_row_injective: \"inj collection_example_row\"\nproof (rule injI)\n  fix x y assume same: \"collection_example_row x=collection_example_row y\"\n  have keys: \"fst x=fst y\" and value_lists:\n    \"map collection_example_value (snd x)=map collection_example_value (snd y)\"\n    using same by (cases x; cases y; auto simp: data_list_term_injective)+\n  have \"snd x=snd y\" using value_lists\n    by (simp only: inj_map_eq_map[OF collection_example_value_injective])\n  then show \"x=y\" using keys by (simp add: prod_eq_iff)\nqed\n\nlemma collection_example_data:\n  \"data_elements (map collection_example_row (collection_example_rows n))\"\n  by (simp add: collection_example_rows_def octets_formed_def split: if_splits)\n\nlemma collection_investigation_decision_code [code]:\n  \"collection_investigation_decision f n=(if f=0 then\n    set (collection_example_rows 0)=set (collection_example_rows n)\n    else keyed_octet_profiles (collection_example_rows 0) (collection_example_rows n))\"\nproof -\n  have raw: \"(219,Pair_Term (collection_example_term 0) (collection_example_term n))\n      \\<in>positive_meaning data_set_comparison_system \\<longleftrightarrow>\n      set (collection_example_rows 0)=set (collection_example_rows n)\"\n    by (simp only: data_set_comparison_mapped[OF collection_example_row_injective])\n      (use collection_example_data[of 0] collection_example_data[of n] in blast)\n  have encoded: \"map collection_example_row xs=\n      map keyed_set_row_term (map (map_prod keyed_octet (map keyed_octet_pair)) xs)\" for xs\n    by (induction xs) (auto simp: map_prod_def split: prod.splits)\n  show ?thesis by (simp only: collection_investigation_decision_def raw; simp only: encoded keyed_octet_profiles_def)\nqed\n\ndefinition collection_example_subject where\n  \"collection_example_subject n=fset_of_list (map (map_prod id fset_of_list) (collection_example_rows n))\"\n\ndefinition collection_investigation_compare :: \"nat \\<Rightarrow> nat \\<Rightarrow> bool\" where\n  \"collection_investigation_compare c d \\<longleftrightarrow> collection_example_subject c=collection_example_subject d\"\n\ndefinition collection_investigation_observations :: \"(nat\\<times>nat\\<times>nat) list\" where\n  \"collection_investigation_observations=concat (map (\\<lambda>c.\n    map (\\<lambda>f. (f,c,if collection_investigation_decision f c then 1 else 0)) [0,1]) [0,1,2,3,4,5,6])\"\n\ndefinition collection_investigation_relation :: \"(nat\\<times>nat) list\" where\n  \"collection_investigation_relation=filter (\\<lambda>(c,d). collection_investigation_compare c d)\n    (investigation_pairs [0,1,2,3,4,5,6])\"\n\nlemma collection_investigation_relation_exact:\n  \"(c,d)\\<in>set collection_investigation_relation \\<longleftrightarrow>\n    c\\<in>{0,1,2,3,4,5,6} \\<and> d\\<in>{0,1,2,3,4,5,6} \\<and>\n    collection_example_subject c=collection_example_subject d\"\n  by (simp only: collection_investigation_relation_def set_filter investigation_pairs_exact\n    mem_Collect_eq case_prod_conv collection_investigation_compare_def list.set; blast)\n\ndefinition collection_investigation where\n  \"collection_investigation selected=investigation_basis [0,1,2,3,4,5,6] [0,1] selected\n    collection_investigation_observations collection_investigation_relation\"\n\nexport_code investigation_inference investigation_basis investigation_repairs investigation_extend collection_investigation\n  collection_investigation_observations collection_investigation_relation nat_of_integer integer_of_nat\n  in SML module_name Finite_Investigation file_prefix finite_investigation\n\ntext \\<open>\n  The source profiles are outputs of the actual native profile computation.\n  The seven subjects vary inner order, inner repetition, outer order, outer\n  repetition, and two different presentations of a repeated semantic row.\n  One subject removes a profile member. The independent comparison keeps\n  both finite-set levels. The first actual native observation compares literal\n  outer rows; the second uses the complete keyed-set comparison. A successful Boolean reference test is not a general decoder\n  of every possible collection identity.\n\\<close>\n\nend\n",
