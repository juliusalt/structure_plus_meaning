      "source": "theory Factor_Observation_Table_Investigation\n  imports Factor_Observation_Collection_Contracts Factor_Observation_Table_Execution Finite_Investigation_Interface\nbegin\n\nsection \\<open>A complete table retains rows whose computed result is empty\\<close>\n\nabbreviation table_example_candidates where\n  \"table_example_candidates \\<equiv> [0::nat,1,2]\"\n\nabbreviation table_example_rows where\n  \"table_example_rows \\<equiv> [(0::nat,0::nat,0::nat),(0,0,1),(0,1,0)]\"\n\ndefinition table_example_profile where\n  \"table_example_profile c=map (\\<lambda>(f,d,w). (f,w)) (filter (\\<lambda>(f,d,w). d=c) table_example_rows)\"\n\ndefinition table_example_loss where\n  \"table_example_loss c d=filter (\\<lambda>x. x\\<notin>set (table_example_profile d)) (table_example_profile c)\"\n\nabbreviation table_example_full_profiles where\n  \"table_example_full_profiles \\<equiv> map (\\<lambda>c. (c,table_example_profile c)) table_example_candidates\"\n\nabbreviation table_example_full_losses where\n  \"table_example_full_losses \\<equiv> map (\\<lambda>(c,d). ((c,d),table_example_loss c d))\n    (investigation_pairs table_example_candidates)\"\n\nabbreviation table_example_sparse_profiles where\n  \"table_example_sparse_profiles \\<equiv> filter (\\<lambda>(c,vs). vs\\<noteq>[]) table_example_full_profiles\"\n\nabbreviation table_example_sparse_losses where\n  \"table_example_sparse_losses \\<equiv> filter (\\<lambda>(k,vs). vs\\<noteq>[]) table_example_full_losses\"\n\ndefinition table_example_profiles :: \"nat \\<Rightarrow> (nat\\<times>(nat\\<times>nat) list) list\" where\n  \"table_example_profiles n=(if n=0 then table_example_sparse_profiles\n    else if n=2 then rev (map (\\<lambda>(c,vs). (c,rev vs)) table_example_full_profiles)\n    else if n=3 then table_example_full_profiles@[(0,rev (table_example_profile 0))]\n    else if n=4 then filter (\\<lambda>(c,vs). c\\<noteq>2) table_example_full_profiles\n    else if n=6 then table_example_full_profiles@[(3,[])]\n    else table_example_full_profiles)\"\n\ndefinition table_example_losses :: \"nat \\<Rightarrow> ((nat\\<times>nat)\\<times>(nat\\<times>nat) list) list\" where\n  \"table_example_losses n=(if n=0 then table_example_sparse_losses\n    else if n=2 then rev (map (\\<lambda>(k,vs). (k,rev vs)) table_example_full_losses)\n    else if n=3 then table_example_full_losses@[((0,2),rev (table_example_loss 0 2))]\n    else if n=5 then filter (\\<lambda>(k,vs). k\\<noteq>(2,2)) table_example_full_losses\n    else if n=7 then map (\\<lambda>(k,vs). (k,if k=(0,2) then [(0,0)] else vs)) table_example_full_losses\n    else table_example_full_losses)\"\n\nabbreviation table_example_native_rows where\n  \"table_example_native_rows \\<equiv> map (\\<lambda>(f,c,w). (keyed_octet f,keyed_octet c,keyed_octet w)) table_example_rows\"\n\nlemma table_example_computed_profiles:\n  assumes \"c\\<in>{0,1,2}\"\n  shows \"(301,context_relation_argument (Pair_Term (data_list_term [keyed_octet 0]) (keyed_octet c))\n      (data_list_term (map observation_row_term table_example_native_rows))\n      (data_list_term (map keyed_octet_pair (table_example_profile c))))\\<in>positive_meaning observation_system\"\n  using assms by (simp only: observation_encoded_profile)\n    (auto simp: table_example_profile_def observation_profile_list_def octets_formed_def)\n\nlemma table_example_computed_losses:\n  assumes \"c\\<in>{0,1,2}\" \"d\\<in>{0,1,2}\"\n  shows \"(306,context_relation_argument\n      (Pair_Term (data_list_term [keyed_octet 0]) (keyed_octet_pair (c,d)))\n      (data_list_term (map observation_row_term table_example_native_rows))\n      (data_list_term (map keyed_octet_pair (table_example_loss c d))))\\<in>positive_meaning observation_system\"\n  using assms by (simp only: observation_encoded_losses)\n    (auto simp: table_example_loss_def table_example_profile_def observation_losses_list_def observation_profile_list_def octets_formed_def)\n\ndefinition table_investigation_decision :: \"nat \\<Rightarrow> nat \\<Rightarrow> bool\" where\n  \"table_investigation_decision f n \\<longleftrightarrow> (if f=0 then\n    keyed_octet_profiles table_example_sparse_profiles (table_example_profiles n) \\<and>\n    keyed_octet_losses table_example_sparse_losses (table_example_losses n)\n    else observation_octet_profile_table table_example_candidates [0] [0] table_example_rows (table_example_profiles n) \\<and>\n      observation_octet_loss_table table_example_candidates [0] [0] table_example_rows (table_example_losses n))\"\n\ndefinition table_example_complete :: \"nat \\<Rightarrow> bool\" where\n  \"table_example_complete n \\<longleftrightarrow>\n    fset_of_list (map (map_prod id fset_of_list) (table_example_profiles n))=\n      fset_of_list (map (\\<lambda>c. (c,fset_of_list (table_example_profile c))) table_example_candidates) \\<and>\n    fset_of_list (map (map_prod id fset_of_list) (table_example_losses n))=\n      fset_of_list (map (\\<lambda>(c,d). ((c,d),fset_of_list (table_example_loss c d)))\n        (investigation_pairs table_example_candidates))\"\n\ndefinition table_investigation_observations :: \"(nat\\<times>nat\\<times>nat) list\" where\n  \"table_investigation_observations=concat (map (\\<lambda>c.\n    map (\\<lambda>f. (f,c,if table_investigation_decision f c then 1 else 0)) [0,1]) [0,1,2,3,4,5,6,7])\"\n\ndefinition table_investigation_relation :: \"(nat\\<times>nat) list\" where\n  \"table_investigation_relation=filter (\\<lambda>(c,d). table_example_complete c=table_example_complete d)\n    (investigation_pairs [0,1,2,3,4,5,6,7])\"\n\nlemma table_investigation_relation_exact:\n  \"(c,d)\\<in>set table_investigation_relation \\<longleftrightarrow>\n    c\\<in>{0,1,2,3,4,5,6,7} \\<and> d\\<in>{0,1,2,3,4,5,6,7} \\<and> table_example_complete c=table_example_complete d\"\n  by (simp only: table_investigation_relation_def set_filter investigation_pairs_exact\n    mem_Collect_eq case_prod_conv list.set; blast)\n\ndefinition table_investigation where\n  \"table_investigation selected=investigation_basis [0,1,2,3,4,5,6,7] [0,1] selected\n    table_investigation_observations table_investigation_relation\"\n\nexport_code investigation_inference investigation_basis investigation_repairs investigation_extend table_investigation\n  table_investigation_observations table_investigation_relation nat_of_integer integer_of_nat\n  in SML module_name Finite_Investigation file_prefix finite_investigation\n\ntext \\<open>\n  Both sparse reference collections retain only nonempty results of the\n  actual native profile and loss computations. The existing complete nested\n  comparator tests each supplied table against these sparse references.\n  A second observation calls the complete native profile and loss table\n  operations on the same query and displayed results. The independent\n  criterion requires every declared candidate and\n  every ordered candidate pair, with its exact computed finite result.\n  Its eight subjects include complete tables, changed presentations,\n  omitted empty rows, a foreign row, and a wrong nonempty loss.\n\\<close>\n\nend\n",
