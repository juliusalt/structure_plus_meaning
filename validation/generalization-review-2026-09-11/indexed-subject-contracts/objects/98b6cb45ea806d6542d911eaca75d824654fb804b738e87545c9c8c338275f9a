      "source": "theory Factor_Proof_Probe_Investigation\n  imports Factor_Pattern_Families Factor_Finite_Relations Factor_Permission_Investigation Factor_Derivation\nbegin\n\nsection \\<open>No finite set of positive call probes establishes universal meaning\\<close>\n\ndefinition universal_family_system :: \"'a \\<Rightarrow> ('a,unit,unit,factor_term) schema_system\" where\n  \"universal_family_system a=pattern_family_system a {(Payload_Term [],Pattern_Variable a)}\"\n\nlemma universal_family_formed [simp]: \"schema_system_formed (universal_family_system a)\"\n  unfolding universal_family_system_def by (rule pattern_family_formed) (auto simp: single_valued_def)\n\nlemma universal_family_call [simp]: \"schema_call_formed (universal_family_system a) () t \\<longleftrightarrow> term_formed t\"\n  using pattern_family_call[of a \"{(Payload_Term [],Pattern_Variable a)}\" t]\n  by (simp add: universal_family_system_def[symmetric])\n\nlemma universal_family_meaning [simp]: \"((),t)\\<in>positive_meaning (universal_family_system a) \\<longleftrightarrow> term_formed t\"\n  using pattern_family_meaning[of a \"{(Payload_Term [],Pattern_Variable a)}\" t]\n  by (simp add: universal_family_system_def[symmetric])\n\ntheorem finite_positive_probes_miss_universal_meaning:\n  assumes family: \"extensional_family_formed T\"\n  shows \"program_decisions_agree (\\<lambda>t. t\\<in>rel_ran T) (finite_relation_system a T,()) (universal_family_system a,())\"\n    \"\\<not>program_decisions_agree term_formed (finite_relation_system a T,()) (universal_family_system a,())\"\nproof -\n  have finite_T: \"finite T\" using family by (simp add: extensional_family_formed_def)\n  have finite: \"finite (rel_ran T)\" by (rule finite_rel_ran[OF finite_T])\n  have formed: \"\\<forall>t\\<in>rel_ran T. term_formed t\"\n    using family by (auto simp: extensional_family_formed_def rel_ran_def)\n  show \"program_decisions_agree (\\<lambda>t. t\\<in>rel_ran T) (finite_relation_system a T,()) (universal_family_system a,())\"\n    using formed by (simp add: program_decisions_agree_def finite_relation_call[OF family]\n      finite_relation_holds[OF family])\n  obtain t where tf: \"term_formed t\" and missing: \"t\\<notin>rel_ran T\"\n    using future_term_domain_is_infinite finite finite_subset[of \"{t. term_formed t}\" \"rel_ran T\"] by blast\n  show \"\\<not>program_decisions_agree term_formed (finite_relation_system a T,()) (universal_family_system a,())\"\n  proof\n    assume agreement: \"program_decisions_agree term_formed (finite_relation_system a T,()) (universal_family_system a,())\"\n    have same: \"(((),t)\\<in>positive_meaning (finite_relation_system a T))=(((),t)\\<in>positive_meaning (universal_family_system a))\"\n      using agreement tf by (auto simp: program_decisions_agree_def)\n    show False using same tf missing by (simp add: finite_relation_holds[OF family])\n  qed\nqed\n\nlemma finite_relation_proof_origin:\n  assumes family: \"extensional_family_formed T\"\n    and replay: \"checks_schema_proof (finite_relation_system a T) (Schema_Proof c V B) () t\"\n  shows \"(c,t)\\<in>T \\<and> fset V={} \\<and> fset B={}\"\n  using replay by (auto simp: checks_schema_proof_node finite_relation_instance[OF family])\n\nsection \\<open>The two determining syntax markers are insufficient truth probes\\<close>\n\ndefinition proof_probe_argument :: \"nat \\<Rightarrow> factor_term\" where\n  \"proof_probe_argument f=(if f=0 then Payload_Term [0]\n    else if f=1 then Target_Term (Whole_Artifact empty_artifact)\n    else Pair_Term (Payload_Term [0]) (Payload_Term [0]))\"\n\ndefinition proof_probe_program :: \"nat \\<Rightarrow> (unit,unit,unit,factor_term) schema_system\" where\n  \"proof_probe_program c=(if c=0 then finite_relation_system ()\n    {(proof_probe_argument 0,proof_probe_argument 0),(proof_probe_argument 1,proof_probe_argument 1)}\n    else universal_family_system ())\"\n\nlemma proof_probe_arguments_formed [simp]: \"term_formed (proof_probe_argument f)\"\n  by (simp add: proof_probe_argument_def octets_formed_def)\n\nlemma proof_probe_family_formed:\n  \"extensional_family_formed\n    {(proof_probe_argument 0,proof_probe_argument 0),(proof_probe_argument 1,proof_probe_argument 1)}\"\n  by (auto simp: extensional_family_formed_def single_valued_def)\n\nlemma proof_probe_programs_formed [simp]: \"schema_system_formed (proof_probe_program c)\"\n  by (simp add: proof_probe_program_def finite_relation_formed extensional_family_formed_def single_valued_def)\n\nlemma proof_probe_calls [simp]: \"schema_call_formed (proof_probe_program c) () t \\<longleftrightarrow> term_formed t\"\n  by (simp add: proof_probe_program_def finite_relation_call extensional_family_formed_def single_valued_def)\n\nlemma proof_probe_truth:\n  \"((),t)\\<in>positive_meaning (proof_probe_program c) \\<longleftrightarrow>\n    (if c=0 then t=proof_probe_argument 0 \\<or> t=proof_probe_argument 1 else term_formed t)\"\n  by (auto simp: proof_probe_program_def finite_relation_holds extensional_family_formed_def single_valued_def rel_ran_def)\n\ndefinition proof_probe_compare where\n  \"proof_probe_compare c d=program_decisions_agree term_formed (proof_probe_program c,()) (proof_probe_program d,())\"\n\nlemma proof_probe_compare_code [code]: \"proof_probe_compare c d=((c=0)=(d=0))\"\nproof\n  assume comparison: \"proof_probe_compare c d\"\n  have same: \"(((),proof_probe_argument 2)\\<in>positive_meaning (proof_probe_program c))=\n      (((),proof_probe_argument 2)\\<in>positive_meaning (proof_probe_program d))\"\n    using comparison proof_probe_arguments_formed[of 2]\n    by (auto simp: proof_probe_compare_def program_decisions_agree_def)\n  have at: \"(((),proof_probe_argument 2)\\<in>positive_meaning (proof_probe_program k))=(k\\<noteq>0)\" for k\n    by (simp only: proof_probe_truth) (simp add: proof_probe_argument_def octets_formed_def)\n  show \"(c=0)=(d=0)\" using same by (simp only: at) blast\nnext\n  assume same: \"(c=0)=(d=0)\"\n  have programs: \"proof_probe_program c=proof_probe_program d\" using same by (simp add: proof_probe_program_def)\n  show \"proof_probe_compare c d\" by (simp add: proof_probe_compare_def program_decisions_agree_def programs)\nqed\n\ndefinition proof_probe_observation :: \"nat \\<Rightarrow> nat \\<Rightarrow> nat\" where\n  \"proof_probe_observation f c=(if schema_call_formed (proof_probe_program c) () (proof_probe_argument f) then 2 else 0) +\n    (if ((),proof_probe_argument f)\\<in>positive_meaning (proof_probe_program c) then 1 else 0)\"\n\nlemma proof_probe_observation_code [code]:\n  \"proof_probe_observation f c=(if f=0 \\<or> f=1 \\<or> c\\<noteq>0 then 3 else 2)\"\n  by (auto simp: proof_probe_observation_def proof_probe_truth proof_probe_argument_def octets_formed_def)\n\ntheorem proof_probe_observation_exact:\n  \"proof_probe_observation f c=proof_probe_observation g d \\<longleftrightarrow>\n    (schema_call_formed (proof_probe_program c) () (proof_probe_argument f)=\n      schema_call_formed (proof_probe_program d) () (proof_probe_argument g)) \\<and>\n    ((((),proof_probe_argument f)\\<in>positive_meaning (proof_probe_program c))=\n      (((),proof_probe_argument g)\\<in>positive_meaning (proof_probe_program d)))\"\n  by (auto simp: proof_probe_observation_def)\n\ndefinition proof_probes_investigation_observations :: \"(nat\\<times>nat\\<times>nat) list\" where\n  \"proof_probes_investigation_observations=concat (map (\\<lambda>c.\n    map (\\<lambda>f. (f,c,proof_probe_observation f c)) [0,1,2]) [0,1])\"\n\ndefinition proof_probes_investigation_relation :: \"(nat\\<times>nat) list\" where\n  \"proof_probes_investigation_relation=filter (\\<lambda>(c,d). proof_probe_compare c d) (investigation_pairs [0,1])\"\n\nlemma proof_probes_observations_literal:\n  \"proof_probes_investigation_observations=[(0,0,3),(1,0,3),(2,0,2),(0,1,3),(1,1,3),(2,1,3)]\"\n  by (simp add: proof_probes_investigation_observations_def proof_probe_observation_code)\n\nlemma proof_probes_relation_literal: \"proof_probes_investigation_relation=[(0,0),(1,1)]\"\n  by (simp add: proof_probes_investigation_relation_def investigation_pairs_def proof_probe_compare_code)\n\nlemma proof_probes_observations_exact:\n  \"finite_table_observations (fset_of_list proof_probes_investigation_observations) f c=\n    (if f\\<in>{0,1,2} \\<and> c\\<in>{0,1} then {proof_probe_observation f c} else {})\"\n  by (auto simp: finite_table_observations_def proof_probes_investigation_observations_def)\n\nlemma proof_probes_relation_exact:\n  \"(c,d)\\<in>set proof_probes_investigation_relation \\<longleftrightarrow>\n    c\\<in>{0,1} \\<and> d\\<in>{0,1} \\<and>\n    program_decisions_agree term_formed (proof_probe_program c,()) (proof_probe_program d,())\"\n  by (simp only: proof_probes_investigation_relation_def set_filter mem_Collect_eq split_conv\n    investigation_pairs_exact mem_Times_iff proof_probe_compare_def set_simps conj_assoc fst_conv snd_conv)\n\ndefinition proof_probes_investigation where\n  \"proof_probes_investigation selected=investigation_basis [0,1] [0,1,2] selected\n    proof_probes_investigation_observations proof_probes_investigation_relation\"\n\ntheorem proof_probes_two_markers_leave_both_comparisons:\n  \"fst (proof_probes_investigation [0,1]) \\<and>\n    set (fst (snd (proof_probes_investigation [0,1])))={(0,1),(1,0)}\"\n  by (simp add: proof_probes_investigation_def investigation_basis_def Let_def investigation_select_def\n    investigation_pairs_def proof_probes_observations_literal proof_probes_relation_literal\n    finite_basis_residual_def finite_candidate_profile_def finite_basis_evaluation_def finite_observation_table_formed_def; blast)\n\ntheorem proof_probes_third_argument_separates:\n  \"fst (proof_probes_investigation [0,1,2]) \\<and> fst (snd (proof_probes_investigation [0,1,2]))=[]\"\n  by (simp add: proof_probes_investigation_def investigation_basis_def Let_def investigation_select_def\n    investigation_pairs_def proof_probes_observations_literal proof_probes_relation_literal\n    finite_basis_residual_def finite_candidate_profile_def finite_basis_evaluation_def finite_observation_table_formed_def)\n\nexport_code investigation_inference investigation_basis investigation_repairs investigation_extend proof_probes_investigation\n  proof_probes_investigation_observations proof_probes_investigation_relation\n  nat_of_integer integer_of_nat\n  in SML module_name Finite_Investigation file_prefix finite_investigation\n\ntext \\<open>\n  The comparison is complete formation and truth agreement on every formed\n  term. The two candidates are independently fixed actual programs. Both\n  accept every formed call, and both prove the payload and target markers.\n  A pair argument separates their truth. The numeric observation retains the\n  Boolean outcomes of both formation and truth; its code equation follows\n  from the programs' independently established meanings.\n\n  Three arguments suffice for this two-program family. The preceding general\n  theorem shows why extending finite positive probes cannot establish\n  universal meaning for arbitrary finite programs. A finite literal family\n  agrees with a universal recognizer at every supplied formed term and still\n  differs elsewhere. Uniform proof structure requires its own argument.\n\\<close>\n\nend\n",
