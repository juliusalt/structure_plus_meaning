      "source": "theory Factor_Permission_Investigation\n  imports Factor_Permission_Invariance Factor_Pattern_Programs Finite_Investigation_Interface\nbegin\n\nsection \\<open>Preserving decisions includes both outcomes of both observations\\<close>\n\ndefinition program_decisions_agree where\n  \"program_decisions_agree A x y \\<longleftrightarrow> (\\<forall>t. A t \\<longrightarrow>\n    (schema_call_formed (fst x) (snd x) t \\<longleftrightarrow> schema_call_formed (fst y) (snd y) t) \\<and>\n    (((snd x),t)\\<in>positive_meaning (fst x) \\<longleftrightarrow> ((snd y),t)\\<in>positive_meaning (fst y)))\"\n\ndefinition program_decision_observations where\n  \"program_decision_observations A role x=\n    {(t,b). A t \\<and> b=(if role then ((snd x),t)\\<in>positive_meaning (fst x)\n      else schema_call_formed (fst x) (snd x) t)}\"\n\ntheorem program_decision_observation_comparison:\n  \"candidate_profile {False,True} (program_decision_observations A) x\\<subseteq>\n      candidate_profile {False,True} (program_decision_observations A) y \\<longleftrightarrow>\n    program_decisions_agree A x y\"\nproof\n  assume included: \"candidate_profile {False,True} (program_decision_observations A) x\\<subseteq>\n    candidate_profile {False,True} (program_decision_observations A) y\"\n  have decision: \"(if role then (snd x,t)\\<in>positive_meaning (fst x) else schema_call_formed (fst x) (snd x) t)=\n      (if role then (snd y,t)\\<in>positive_meaning (fst y) else schema_call_formed (fst y) (snd y) t)\"\n    if domain: \"A t\" for t role\n  proof -\n    have recorded: \"(role,(t,if role then (snd x,t)\\<in>positive_meaning (fst x)\n        else schema_call_formed (fst x) (snd x) t))\\<in>\n      candidate_profile {False,True} (program_decision_observations A) x\"\n      using domain by (cases role) (simp_all add: program_decision_observations_def)\n    have kept: \"(role,(t,if role then (snd x,t)\\<in>positive_meaning (fst x)\n        else schema_call_formed (fst x) (snd x) t))\\<in>\n      candidate_profile {False,True} (program_decision_observations A) y\"\n      by (rule subsetD[OF included recorded])\n    show ?thesis using kept by (simp add: program_decision_observations_def)\n  qed\n  show \"program_decisions_agree A x y\"\n    using decision[where role=False] decision[where role=True]\n    by (auto simp: program_decisions_agree_def)\nnext\n  assume agreement: \"program_decisions_agree A x y\"\n  have observed: \"program_decision_observations A role x=program_decision_observations A role y\" for role\n    using agreement by (cases role) (auto simp: program_decision_observations_def program_decisions_agree_def)\n  show \"candidate_profile {False,True} (program_decision_observations A) x\\<subseteq>\n      candidate_profile {False,True} (program_decision_observations A) y\"\n    by (auto simp: candidate_profile_def observed)\nqed\n\ntheorem program_decision_observation_basis:\n  \"comparison_basis C (program_decisions_agree A) {False,True} (program_decision_observations A)\"\n  by (simp only: comparison_basis_def program_decision_observation_comparison; simp)\n\ntheorem program_decision_comparison_reduction:\n  \"exact_obligation_reduction UNIV\n    (\\<lambda>z. program_decisions_agree A (fst z) (snd z))\n    (profile_condition (program_decision_observations A))\n    (\\<lambda>z. profile_obligations {False,True} (program_decision_observations A) (fst z) (snd z))\"\n  by (auto simp: exact_obligation_reduction_def profile_obligations_def graph_map_ran\n    image_subset_iff candidate_profile_def profile_condition_def\n    program_decision_observations_def program_decisions_agree_def)\n\nsection \\<open>Actual formed programs witness the loss from either omitted facet\\<close>\n\nabbreviation interface_test_program :: \"unit term_pattern \\<Rightarrow> (unit,unit,unit,unit) schema_system\" where\n  \"interface_test_program p \\<equiv> \\<lparr>system_interfaces={((),p)},system_clauses={}\\<rparr>\"\n\nabbreviation unit_program_entries :: \"((unit,unit,unit,unit) schema_system\\<times>unit) set\" where\n  \"unit_program_entries \\<equiv> {z. schema_system_formed (fst z) \\<and> snd z\\<in>system_definitions (fst z)}\"\n\nabbreviation narrow_false_program where\n  \"narrow_false_program \\<equiv> interface_test_program (Pattern_Payload [])\"\n\nabbreviation broad_false_program where\n  \"broad_false_program \\<equiv> interface_test_program (Pattern_Variable ())\"\n\nabbreviation broad_true_program where\n  \"broad_true_program \\<equiv> recognizer_system () (Pattern_Variable ())\"\n\nlemma interface_test_formed:\n  \"pattern_formed p \\<Longrightarrow> schema_system_formed (interface_test_program p)\"\n  by (auto simp: schema_system_formed_def single_valued_def)\n\nlemma interface_test_calls:\n  assumes \"pattern_formed p\"\n  shows \"schema_call_formed (interface_test_program p) () t \\<longleftrightarrow> pattern_accepts p t\"\n  using interface_test_formed[OF assms] by (simp add: schema_call_formed_def)\n\nlemma interface_test_meaning:\n  \"positive_meaning (interface_test_program p)={}\"\n  by (subst positive_meaning_unfold)\n    (auto simp: schema_consequences_def admitted_schema_instance_def)\n\nlemma permission_comparison_witness_entries:\n  \"(narrow_false_program,())\\<in>unit_program_entries\"\n  \"(broad_false_program,())\\<in>unit_program_entries\"\n  \"(broad_true_program,())\\<in>unit_program_entries\"\n  using interface_test_formed[of \"Pattern_Payload []\"] interface_test_formed[of \"Pattern_Variable ()\"]\n    recognizer_system_formed[of \"Pattern_Variable ()\" \"()\"]\n  by (auto simp: octets_formed_def system_definitions_def rel_dom_def recognizer_system_def)\n\nlemma permission_comparison_witness_calls:\n  \"schema_call_formed narrow_false_program () t \\<longleftrightarrow> t=Payload_Term []\"\n  \"schema_call_formed broad_false_program () t \\<longleftrightarrow> term_formed t\"\n  \"schema_call_formed broad_true_program () t \\<longleftrightarrow> term_formed t\"\nproof -\n  have exact: \"pattern_accepts (Pattern_Payload []::unit term_pattern) t \\<longleftrightarrow> t=Payload_Term []\"\n    using exact_term_pattern_accepts[of \"Payload_Term []\" t]\n    by (simp add: octets_formed_def)\n  show \"schema_call_formed narrow_false_program () t \\<longleftrightarrow> t=Payload_Term []\"\n    by (simp add: interface_test_calls exact octets_formed_def)\n  show \"schema_call_formed broad_false_program () t \\<longleftrightarrow> term_formed t\"\n    by (simp add: interface_test_calls)\n  show \"schema_call_formed broad_true_program () t \\<longleftrightarrow> term_formed t\"\n    by (simp add: recognizer_call_formed)\nqed\n\nlemma broad_true_meaning:\n  \"((),t)\\<in>positive_meaning broad_true_program \\<longleftrightarrow> term_formed t\"\n  by (simp add: recognizer_positive_meaning)\n\ntheorem truth_observations_miss_call_formation:\n  \"((narrow_false_program,()),(broad_false_program,()))\\<in>\n    comparison_failures unit_program_entries (program_decisions_agree term_formed)\n      {True} (program_decision_observations term_formed)\"\n  \"(False,(Pair_Term (Payload_Term []) (Payload_Term []),False))\\<in>\n    candidate_losses {False,True} (program_decision_observations term_formed)\n      (narrow_false_program,()) (broad_false_program,())\"\nproof -\n  have unequal: \"\\<not>program_decisions_agree term_formed (narrow_false_program,()) (broad_false_program,())\"\n  proof\n    assume agreement: \"program_decisions_agree term_formed (narrow_false_program,()) (broad_false_program,())\"\n    have formed: \"term_formed (Pair_Term (Payload_Term []) (Payload_Term []))\"\n      by (simp add: octets_formed_def)\n    have at: \"schema_call_formed narrow_false_program () (Pair_Term (Payload_Term []) (Payload_Term []))=\n        schema_call_formed broad_false_program () (Pair_Term (Payload_Term []) (Payload_Term []))\"\n      using agreement formed by (auto simp: program_decisions_agree_def)\n    show False using at by (simp add: permission_comparison_witness_calls octets_formed_def)\n  qed\n  show \"((narrow_false_program,()),(broad_false_program,()))\\<in>\n    comparison_failures unit_program_entries (program_decisions_agree term_formed)\n      {True} (program_decision_observations term_formed)\"\n    using permission_comparison_witness_entries(1,2) unequal\n    by (auto simp: comparison_failures_def candidate_profile_comparison\n      program_decision_observations_def interface_test_meaning)\n  show \"(False,(Pair_Term (Payload_Term []) (Payload_Term []),False))\\<in>\n    candidate_losses {False,True} (program_decision_observations term_formed)\n      (narrow_false_program,()) (broad_false_program,())\"\n    by (simp add: program_decision_observations_def permission_comparison_witness_calls octets_formed_def)\nqed\n\ntheorem formation_observations_miss_truth:\n  \"((broad_false_program,()),(broad_true_program,()))\\<in>\n    comparison_failures unit_program_entries (program_decisions_agree term_formed)\n      {False} (program_decision_observations term_formed)\"\n  \"(True,(Payload_Term [],False))\\<in>\n    candidate_losses {False,True} (program_decision_observations term_formed)\n      (broad_false_program,()) (broad_true_program,())\"\nproof -\n  have unequal: \"\\<not>program_decisions_agree term_formed (broad_false_program,()) (broad_true_program,())\"\n  proof\n    assume agreement: \"program_decisions_agree term_formed (broad_false_program,()) (broad_true_program,())\"\n    have formed: \"term_formed (Payload_Term [])\" by (simp add: octets_formed_def)\n    have at: \"(((),Payload_Term [])\\<in>positive_meaning broad_false_program)=\n        (((),Payload_Term [])\\<in>positive_meaning broad_true_program)\"\n      using agreement formed by (auto simp: program_decisions_agree_def)\n    show False using at by (simp add: interface_test_meaning broad_true_meaning octets_formed_def)\n  qed\n  show \"((broad_false_program,()),(broad_true_program,()))\\<in>\n    comparison_failures unit_program_entries (program_decisions_agree term_formed)\n      {False} (program_decision_observations term_formed)\"\n    using permission_comparison_witness_entries(2,3) unequal\n    by (auto simp: comparison_failures_def candidate_profile_comparison\n      program_decision_observations_def permission_comparison_witness_calls)\n  show \"(True,(Payload_Term [],False))\\<in>\n    candidate_losses {False,True} (program_decision_observations term_formed)\n      (broad_false_program,()) (broad_true_program,())\"\n    by (simp add: program_decision_observations_def interface_test_meaning broad_true_meaning octets_formed_def)\nqed\n\ntheorem both_permission_facets_are_essential:\n  assumes \"F\\<subset>{False,True}\"\n  shows \"\\<not>comparison_basis unit_program_entries (program_decisions_agree term_formed)\n    F (program_decision_observations term_formed)\"\nproof (rule essential_facets_prevent_a_smaller_basis[OF assms])\n  fix role assume \"role\\<in>{False,True}\"\n  have without_false: \"{False,True}-{False}={True}\" by auto\n  have without_true: \"{False,True}-{True}={False}\" by auto\n  show \"\\<exists>x y. (x,y)\\<in>\n      comparison_failures unit_program_entries (program_decisions_agree term_formed)\n        ({False,True}-{role}) (program_decision_observations term_formed)\"\n  proof (cases role)\n    case False\n    have selected: \"{False,True}-{role}={True}\" using False without_false by simp\n    show ?thesis unfolding selected\n      by (rule exI[of _ \"(narrow_false_program,())\"], rule exI[of _ \"(broad_false_program,())\"])\n        (rule truth_observations_miss_call_formation(1))\n  next\n    case True\n    have selected: \"{False,True}-{role}={False}\" using True without_true by simp\n    show ?thesis unfolding selected\n      by (rule exI[of _ \"(broad_false_program,())\"], rule exI[of _ \"(broad_true_program,())\"])\n        (rule formation_observations_miss_truth(1))\n  qed\nqed\n\ntheorem more_positive_calls_need_not_preserve_decisions:\n  \"positive_meaning broad_false_program\\<subset>positive_meaning broad_true_program \\<and>\n    \\<not>program_decisions_agree term_formed (broad_false_program,()) (broad_true_program,())\"\nproof -\n  have witness: \"((),Payload_Term [])\\<in>positive_meaning broad_true_program\"\n    by (simp add: broad_true_meaning octets_formed_def)\n  have proper: \"positive_meaning broad_false_program\\<subset>positive_meaning broad_true_program\"\n    using witness by (simp only: interface_test_meaning) blast\n  have unequal: \"\\<not>program_decisions_agree term_formed (broad_false_program,()) (broad_true_program,())\"\n    using formation_observations_miss_truth(1)\n    by (simp only: comparison_failures_def mem_Collect_eq) blast\n  show ?thesis by (rule conjI[OF proper unequal])\nqed\n\nsection \\<open>The executed finite comparison computes actual program decisions\\<close>\n\ndefinition permission_investigation_program :: \"nat \\<Rightarrow> (unit,unit,unit,unit) schema_system\" where\n  \"permission_investigation_program c=(if c=0 then narrow_false_program\n    else if c=1 then broad_false_program else broad_true_program)\"\n\ndefinition permission_investigation_argument :: \"nat \\<Rightarrow> factor_term\" where\n  \"permission_investigation_argument i=(if i=0 then Payload_Term []\n    else Pair_Term (Payload_Term []) (Payload_Term []))\"\n\ndefinition permission_investigation_decision :: \"nat \\<Rightarrow> nat \\<Rightarrow> nat \\<Rightarrow> bool\" where\n  \"permission_investigation_decision f c i=(if f=0 then\n    schema_call_formed (permission_investigation_program c) () (permission_investigation_argument i)\n    else ((),permission_investigation_argument i)\\<in>positive_meaning (permission_investigation_program c))\"\n\nlemma permission_investigation_decision_code [code]:\n  \"permission_investigation_decision f c i=(if f=0 then c\\<noteq>0 \\<or> i=0 else c\\<noteq>0 \\<and> c\\<noteq>1)\"\n  by (auto simp: permission_investigation_decision_def permission_investigation_program_def\n    permission_investigation_argument_def permission_comparison_witness_calls\n    interface_test_meaning broad_true_meaning octets_formed_def)\n\ndefinition permission_investigation_compare :: \"nat \\<Rightarrow> nat \\<Rightarrow> bool\" where\n  \"permission_investigation_compare c d=program_decisions_agree\n    (\\<lambda>t. t\\<in>set (map permission_investigation_argument [0,1]))\n    (permission_investigation_program c,()) (permission_investigation_program d,())\"\n\nlemma permission_investigation_compare_code [code]:\n  \"permission_investigation_compare c d=list_all (\\<lambda>f.\n    list_all (\\<lambda>i. permission_investigation_decision f c i=\n      permission_investigation_decision f d i) [0,1]) [0,1]\"\n  by (auto simp: permission_investigation_compare_def program_decisions_agree_def\n    permission_investigation_decision_def)\n\ndefinition permission_investigation_observations :: \"(nat\\<times>nat\\<times>nat) list\" where\n  \"permission_investigation_observations=concat (map (\\<lambda>c. concat (map (\\<lambda>f.\n    map (\\<lambda>i. (f,c,2*i+(if permission_investigation_decision f c i then 1 else 0))) [0,1])\n      [0,1])) [0,1,2])\"\n\ndefinition permission_investigation_relation :: \"(nat\\<times>nat) list\" where\n  \"permission_investigation_relation=filter (\\<lambda>(c,d). permission_investigation_compare c d)\n    (investigation_pairs [0,1,2])\"\n\nlemma permission_investigation_observations_exact:\n  \"finite_table_observations (fset_of_list permission_investigation_observations) f c=\n    (if f\\<in>{0,1} \\<and> c\\<in>{0,1,2} then\n      (\\<lambda>i. 2*i+(if permission_investigation_decision f c i then 1 else 0)) ` {0,1}\n    else {})\"\n  by (cases \"f=0\"; cases \"f=1\"; cases \"c=0\"; cases \"c=1\"; cases \"c=2\")\n    (auto simp: finite_table_observations_def permission_investigation_observations_def\n      permission_investigation_decision_code)\n\nlemma permission_investigation_relation_exact:\n  \"(c,d)\\<in>set permission_investigation_relation \\<longleftrightarrow>\n    c\\<in>{0,1,2} \\<and> d\\<in>{0,1,2} \\<and> program_decisions_agree\n      (\\<lambda>t. t\\<in>set (map permission_investigation_argument [0,1]))\n      (permission_investigation_program c,()) (permission_investigation_program d,())\"\n  by (auto simp: permission_investigation_relation_def investigation_pairs_exact\n    permission_investigation_compare_def)\n\nlemma permission_investigation_observations_literal:\n  \"permission_investigation_observations=\n    [(0,0,1),(0,0,2),(1,0,0),(1,0,2),\n     (0,1,1),(0,1,3),(1,1,0),(1,1,2),\n     (0,2,1),(0,2,3),(1,2,1),(1,2,3)]\"\n  by (simp add: permission_investigation_observations_def permission_investigation_decision_code)\n\nlemma permission_investigation_relation_literal:\n  \"permission_investigation_relation=[(0,0),(1,1),(2,2)]\"\n  by (simp add: permission_investigation_relation_def investigation_pairs_def\n    permission_investigation_compare_code permission_investigation_decision_code)\n\ndefinition permission_investigation where\n  \"permission_investigation selected=investigation_basis [0,1,2] [0,1] selected\n    permission_investigation_observations permission_investigation_relation\"\n\ntheorem permission_investigation_formation_only:\n  \"fst (permission_investigation [0]) \\<and>\n    set (fst (snd (permission_investigation [0])))={(1,2),(2,1)}\"\n  by (simp add: permission_investigation_def investigation_basis_def Let_def\n    investigation_select_def investigation_pairs_def permission_investigation_observations_literal\n    permission_investigation_relation_literal finite_basis_residual_def finite_candidate_profile_def\n    finite_basis_evaluation_def finite_observation_table_formed_def)\n\ntheorem permission_investigation_truth_only:\n  \"fst (permission_investigation [1]) \\<and>\n    set (fst (snd (permission_investigation [1])))={(0,1),(1,0)}\"\n  by (simp add: permission_investigation_def investigation_basis_def Let_def\n    investigation_select_def investigation_pairs_def permission_investigation_observations_literal\n    permission_investigation_relation_literal finite_basis_residual_def finite_candidate_profile_def\n    finite_basis_evaluation_def finite_observation_table_formed_def)\n\ntheorem permission_investigation_both_facets:\n  \"fst (permission_investigation [0,1]) \\<and> fst (snd (permission_investigation [0,1]))=[]\"\n  by (simp add: permission_investigation_def investigation_basis_def Let_def\n    investigation_select_def investigation_pairs_def permission_investigation_observations_literal\n    permission_investigation_relation_literal finite_basis_residual_def finite_candidate_profile_def\n    finite_basis_evaluation_def finite_observation_table_formed_def)\n\nexport_code investigation_inference investigation_basis investigation_repairs investigation_extend permission_investigation\n  permission_investigation_observations permission_investigation_relation\n  nat_of_integer integer_of_nat\n  in SML module_name Finite_Investigation file_prefix finite_investigation\n\ntext \\<open>\n  The intended comparison preserves the decisions on the supplied argument\n  domain. Each observation therefore retains its Boolean outcome, including\n  refusal. Inclusion of these complete graphs is exactly agreement. Increasing\n  the positive set alone can lose an original refusal.\n\n  Both witnesses are formed programs with actual entries. Equal empty positive\n  meanings can hide different call boundaries. Equal complete call boundaries\n  can hide opposite truth. Each failure supplies the omitted facet and its\n  concrete outcome through the existing candidate-loss account. The two-facet\n  basis is therefore irredundant for this whole comparison scope.\n\n  The same exact reduction evaluates these comparisons. Physical code retention,\n  native availability, and establishment obligations remain different questions;\n  decision agreement does not identify their programs or prove those properties.\n\n  The finite execution computes the actual interface and positive-meaning\n  observations of these three programs at two supplied arguments. Proved code\n  equations replace only this calculation. The complete table, intended\n  comparison, and residual equations retain their independent contracts.\n  Both Boolean outcomes are encoded, so a missing positive call remains\n  observable. Numeric coordinates are private to this finite investigation;\n  its sample scope does not replace the general comparison proved above.\n\\<close>\n\nend\n",
