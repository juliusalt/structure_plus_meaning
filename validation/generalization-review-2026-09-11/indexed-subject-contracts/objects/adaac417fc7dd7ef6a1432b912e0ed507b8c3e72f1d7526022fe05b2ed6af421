theory Factor_Proof_Probe_Investigation
  imports "RRA_Factor_Structural_Bootstrap.Factor_Pattern_Families" "RRA_Factor_Structural_Bootstrap.Factor_Finite_Relations" "Factor_Permission_Investigation" "RRA_Factor_Structural_Bootstrap.Factor_Derivation" "Finite_Derived_Observations"
begin

section \<open>No finite set of positive call probes establishes universal meaning\<close>

definition universal_family_system :: "'a \<Rightarrow> ('a,unit,unit,factor_term) schema_system" where
  "universal_family_system a=pattern_family_system a {(Payload_Term [],Pattern_Variable a)}"

lemma universal_family_formed [simp]: "schema_system_formed (universal_family_system a)"
  unfolding universal_family_system_def by (rule pattern_family_formed) (auto simp: single_valued_def)

lemma universal_family_call [simp]: "schema_call_formed (universal_family_system a) () t \<longleftrightarrow> term_formed t"
  using pattern_family_call[of a "{(Payload_Term [],Pattern_Variable a)}" t]
  by (simp add: universal_family_system_def[symmetric])

lemma universal_family_meaning [simp]: "((),t)\<in>positive_meaning (universal_family_system a) \<longleftrightarrow> term_formed t"
  using pattern_family_meaning[of a "{(Payload_Term [],Pattern_Variable a)}" t]
  by (simp add: universal_family_system_def[symmetric])

theorem finite_positive_probes_miss_universal_meaning:
  assumes family: "extensional_family_formed T"
  shows "program_decisions_agree (\<lambda>t. t\<in>rel_ran T) (finite_relation_system a T,()) (universal_family_system a,())"
    "\<not>program_decisions_agree term_formed (finite_relation_system a T,()) (universal_family_system a,())"
proof -
  have finite_T: "finite T" using family by (simp add: extensional_family_formed_def)
  have finite: "finite (rel_ran T)" by (rule finite_rel_ran[OF finite_T])
  have formed: "\<forall>t\<in>rel_ran T. term_formed t"
    using family by (auto simp: extensional_family_formed_def rel_ran_def)
  show "program_decisions_agree (\<lambda>t. t\<in>rel_ran T) (finite_relation_system a T,()) (universal_family_system a,())"
    using formed by (simp add: program_decisions_agree_def finite_relation_call[OF family]
      finite_relation_holds[OF family])
  obtain t where tf: "term_formed t" and missing: "t\<notin>rel_ran T"
    using future_term_domain_is_infinite finite finite_subset[of "{t. term_formed t}" "rel_ran T"] by blast
  show "\<not>program_decisions_agree term_formed (finite_relation_system a T,()) (universal_family_system a,())"
  proof
    assume agreement: "program_decisions_agree term_formed (finite_relation_system a T,()) (universal_family_system a,())"
    have same: "(((),t)\<in>positive_meaning (finite_relation_system a T))=(((),t)\<in>positive_meaning (universal_family_system a))"
      using agreement tf by (auto simp: program_decisions_agree_def)
    show False using same tf missing by (simp add: finite_relation_holds[OF family])
  qed
qed

lemma finite_relation_proof_origin:
  assumes family: "extensional_family_formed T"
    and replay: "checks_schema_proof (finite_relation_system a T) (Schema_Proof c V B) () t"
  shows "(c,t)\<in>T \<and> fset V={} \<and> fset B={}"
  using replay by (auto simp: checks_schema_proof_node finite_relation_instance[OF family])

section \<open>The two determining syntax markers are insufficient truth probes\<close>

definition proof_probe_argument :: "nat \<Rightarrow> factor_term" where
  "proof_probe_argument f=(if f=0 then Payload_Term [0]
    else if f=1 then Target_Term (Whole_Artifact empty_artifact)
    else Pair_Term (Payload_Term [0]) (Payload_Term [0]))"

definition proof_probe_program :: "nat \<Rightarrow> (unit,unit,unit,factor_term) schema_system" where
  "proof_probe_program c=(if c=0 then finite_relation_system ()
    {(proof_probe_argument 0,proof_probe_argument 0),(proof_probe_argument 1,proof_probe_argument 1)}
    else universal_family_system ())"

lemma proof_probe_arguments_formed [simp]: "term_formed (proof_probe_argument f)"
  by (simp add: proof_probe_argument_def octets_formed_def)

lemma proof_probe_family_formed:
  "extensional_family_formed
    {(proof_probe_argument 0,proof_probe_argument 0),(proof_probe_argument 1,proof_probe_argument 1)}"
  by (auto simp: extensional_family_formed_def single_valued_def)

lemma proof_probe_programs_formed [simp]: "schema_system_formed (proof_probe_program c)"
  by (simp add: proof_probe_program_def finite_relation_formed extensional_family_formed_def single_valued_def)

lemma proof_probe_calls [simp]: "schema_call_formed (proof_probe_program c) () t \<longleftrightarrow> term_formed t"
  by (simp add: proof_probe_program_def finite_relation_call extensional_family_formed_def single_valued_def)

lemma proof_probe_truth:
  "((),t)\<in>positive_meaning (proof_probe_program c) \<longleftrightarrow>
    (if c=0 then t=proof_probe_argument 0 \<or> t=proof_probe_argument 1 else term_formed t)"
  by (auto simp: proof_probe_program_def finite_relation_holds extensional_family_formed_def single_valued_def rel_ran_def)

definition proof_probe_compare where
  "proof_probe_compare c d=program_decisions_agree term_formed (proof_probe_program c,()) (proof_probe_program d,())"

lemma proof_probe_compare_code [code]: "proof_probe_compare c d=((c=0)=(d=0))"
proof
  assume comparison: "proof_probe_compare c d"
  have same: "(((),proof_probe_argument 2)\<in>positive_meaning (proof_probe_program c))=
      (((),proof_probe_argument 2)\<in>positive_meaning (proof_probe_program d))"
    using comparison proof_probe_arguments_formed[of 2]
    by (auto simp: proof_probe_compare_def program_decisions_agree_def)
  have at: "(((),proof_probe_argument 2)\<in>positive_meaning (proof_probe_program k))=(k\<noteq>0)" for k
    by (simp only: proof_probe_truth) (simp add: proof_probe_argument_def octets_formed_def)
  show "(c=0)=(d=0)" using same by (simp only: at) blast
next
  assume same: "(c=0)=(d=0)"
  have programs: "proof_probe_program c=proof_probe_program d" using same by (simp add: proof_probe_program_def)
  show "proof_probe_compare c d" by (simp add: proof_probe_compare_def program_decisions_agree_def programs)
qed

definition proof_probe_observation :: "nat \<Rightarrow> nat \<Rightarrow> nat" where
  "proof_probe_observation f c=(if schema_call_formed (proof_probe_program c) () (proof_probe_argument f) then 2 else 0) +
    (if ((),proof_probe_argument f)\<in>positive_meaning (proof_probe_program c) then 1 else 0)"

lemma proof_probe_observation_code [code]:
  "proof_probe_observation f c=(if f=0 \<or> f=1 \<or> c\<noteq>0 then 3 else 2)"
  by (auto simp: proof_probe_observation_def proof_probe_truth proof_probe_argument_def octets_formed_def)

theorem proof_probe_observation_exact:
  "proof_probe_observation f c=proof_probe_observation g d \<longleftrightarrow>
    (schema_call_formed (proof_probe_program c) () (proof_probe_argument f)=
      schema_call_formed (proof_probe_program d) () (proof_probe_argument g)) \<and>
    ((((),proof_probe_argument f)\<in>positive_meaning (proof_probe_program c))=
      (((),proof_probe_argument g)\<in>positive_meaning (proof_probe_program d)))"
  by (auto simp: proof_probe_observation_def)

definition proof_probes_investigation_observations :: "(nat\<times>nat\<times>nat) list" where
  "proof_probes_investigation_observations=concat (map (\<lambda>c.
    map (\<lambda>f. (f,c,proof_probe_observation f c)) [0,1,2]) [0,1])"

definition proof_probes_investigation_relation :: "(nat\<times>nat) list" where
  "proof_probes_investigation_relation=filter (\<lambda>(c,d). proof_probe_compare c d) (investigation_pairs [0,1])"

lemma proof_probes_observations_literal:
  "proof_probes_investigation_observations=[(0,0,3),(1,0,3),(2,0,2),(0,1,3),(1,1,3),(2,1,3)]"
  by (simp add: proof_probes_investigation_observations_def proof_probe_observation_code)

lemma proof_probes_relation_literal: "proof_probes_investigation_relation=[(0,0),(1,1)]"
  by (simp add: proof_probes_investigation_relation_def investigation_pairs_def proof_probe_compare_code)

lemma proof_probes_observations_exact:
  "finite_table_observations (fset_of_list proof_probes_investigation_observations) f c=
    (if f\<in>{0,1,2} \<and> c\<in>{0,1} then {proof_probe_observation f c} else {})"
  by (auto simp: finite_table_observations_def proof_probes_investigation_observations_def)

lemma proof_probes_relation_exact:
  "(c,d)\<in>set proof_probes_investigation_relation \<longleftrightarrow>
    c\<in>{0,1} \<and> d\<in>{0,1} \<and>
    program_decisions_agree term_formed (proof_probe_program c,()) (proof_probe_program d,())"
  by (simp only: proof_probes_investigation_relation_def set_filter mem_Collect_eq split_conv
    investigation_pairs_exact mem_Times_iff proof_probe_compare_def set_simps conj_assoc fst_conv snd_conv)

definition proof_probes_investigation where
  "proof_probes_investigation selected=investigation_basis [0,1] [0,1,2] selected
    proof_probes_investigation_observations proof_probes_investigation_relation"

theorem proof_probes_two_markers_leave_both_comparisons:
  "fst (proof_probes_investigation [0,1]) \<and>
    set (fst (snd (proof_probes_investigation [0,1])))={(0,1),(1,0)}"
  by (simp add: proof_probes_investigation_def investigation_basis_def Let_def investigation_select_def
    investigation_pairs_def proof_probes_observations_literal proof_probes_relation_literal
    finite_basis_residual_def finite_candidate_profile_def finite_basis_evaluation_def finite_observation_table_formed_def; blast)

theorem proof_probes_third_argument_separates:
  "fst (proof_probes_investigation [0,1,2]) \<and> fst (snd (proof_probes_investigation [0,1,2]))=[]"
  by (simp add: proof_probes_investigation_def investigation_basis_def Let_def investigation_select_def
    investigation_pairs_def proof_probes_observations_literal proof_probes_relation_literal
    finite_basis_residual_def finite_candidate_profile_def finite_basis_evaluation_def finite_observation_table_formed_def)

definition proof_probe_value_subject where
  "proof_probe_value_subject (w::nat)=(w=2 \<or> w=3,w=1 \<or> w=3)"

definition proof_probe_candidate_subjects where
  "proof_probe_candidate_subjects=fimage (\<lambda>c. (c,(proof_probe_program c,()))) {|0::nat,1|}"

definition proof_probe_operation_subjects where
  "proof_probe_operation_subjects=fimage (\<lambda>f. (f,proof_probe_argument f)) {|0::nat,1,2|}"

definition proof_probe_value_subjects where
  "proof_probe_value_subjects=fimage (\<lambda>w. (w,proof_probe_value_subject w)) {|0::nat,1,2,3|}"

lemma proof_probe_subject_maps_formed:
  "finite_observation_subjects_formed proof_probe_candidate_subjects proof_probe_operation_subjects proof_probe_value_subjects"
  unfolding proof_probe_candidate_subjects_def proof_probe_operation_subjects_def proof_probe_value_subjects_def
  by (rule finite_observation_function_graphs_formed)

lemma proof_probe_observations_derived:
  "fset_of_list proof_probes_investigation_observations=
    finite_derived_observations proof_probe_candidate_subjects proof_probe_operation_subjects
      proof_probe_value_subjects (\<lambda>argument program value.
        (argument,fst value)\<in>program_decision_observations (\<lambda>_. True) False program \<and>
        (argument,snd value)\<in>program_decision_observations (\<lambda>_. True) True program)"
  unfolding proof_probe_candidate_subjects_def proof_probe_operation_subjects_def proof_probe_value_subjects_def
  apply (rule finite_table_derived_from_function_graphs)
  by (auto simp: proof_probes_observations_literal fset_of_list.rep_eq proof_probe_value_subject_def
    program_decision_observations_def proof_probe_truth proof_probe_argument_def octets_formed_def split: if_splits)

theorem proof_probe_observation_at_subject:
  assumes "(c,program) |\<in>| proof_probe_candidate_subjects"
    "(f,argument) |\<in>| proof_probe_operation_subjects"
    "(w,value) |\<in>| proof_probe_value_subjects"
  shows "(f,c,w)\<in>set proof_probes_investigation_observations \<longleftrightarrow>
    (argument,fst value)\<in>program_decision_observations (\<lambda>_. True) False program \<and>
    (argument,snd value)\<in>program_decision_observations (\<lambda>_. True) True program"
  using finite_derived_observation_at_subject[OF proof_probe_subject_maps_formed assms]
  by (simp only: proof_probe_observations_derived[symmetric] fset_of_list.rep_eq)

theorem proof_probe_comparison_at_subject:
  assumes "(c,subject) |\<in>| proof_probe_candidate_subjects"
    "(d,other) |\<in>| proof_probe_candidate_subjects"
  shows "(c,d)\<in>set proof_probes_investigation_relation \<longleftrightarrow> program_decisions_agree term_formed subject other"
  using assms by (auto simp: proof_probe_candidate_subjects_def fimage.rep_eq proof_probes_relation_exact)

export_code investigation_inference investigation_basis investigation_repairs investigation_extend proof_probes_investigation
  proof_probes_investigation_observations proof_probes_investigation_relation
  nat_of_integer integer_of_nat
  in SML module_name Finite_Investigation file_prefix finite_investigation

text \<open>
  The comparison is complete formation and truth agreement on every formed
  term. The two candidates are independently fixed actual programs. Both
  accept every formed call, and both prove the payload and target markers.
  A pair argument separates their truth. The numeric observation retains the
  Boolean outcomes of both formation and truth; its code equation follows
  from the programs' independently established meanings.

  Three arguments suffice for this two-program family. The preceding general
  theorem shows why extending finite positive probes cannot establish
  universal meaning for arbitrary finite programs. A finite literal family
  agrees with a universal recognizer at every supplied formed term and still
  differs elsewhere. Uniform proof structure requires its own argument.
\<close>

end
