theory Factor_Pair_Scope_Investigation
  imports Factor_Binder_Admission Factor_Data_Product_Execution Finite_Derived_Observations
begin

section \<open>All ordered pairs belong to a complete candidate scope\<close>

abbreviation pair_scope_full where
  "pair_scope_full \<equiv> [(0::nat,0::nat),(0,1),(1,0),(1,1)]"

definition pair_scope_example :: "nat \<Rightarrow> (nat\<times>nat) list" where
  "pair_scope_example n=(if n=1 then pair_scope_full
    else if n=2 then rev pair_scope_full
    else if n=3 then pair_scope_full@[(0,0)]
    else if n=4 then [(0,1),(1,0),(1,1)]
    else if n=5 then pair_scope_full@[(2,2)]
    else if n=6 then pair_scope_full@[(0,1),(1,0)]
    else [(0,0),(1,1)])"

abbreviation pair_scope_row where
  "pair_scope_row z \<equiv> case z of (c,d) \<Rightarrow> Pair_Term (Payload_Term [c]) (Payload_Term [d])"

abbreviation pair_scope_term where
  "pair_scope_term n \<equiv> data_list_term (map pair_scope_row (pair_scope_example n))"

definition pair_scope_investigation_decision :: "nat \<Rightarrow> nat \<Rightarrow> bool" where
  "pair_scope_investigation_decision f n=(if f=0 then
    (53,Pair_Term (data_list_term [Payload_Term [0],Payload_Term [1]]) (pair_scope_term n))
      \<in>positive_meaning diagonal_rows_system
    else (325,context_relation_argument (data_list_term [Payload_Term [0],Payload_Term [1]])
      (data_list_term [Payload_Term [0],Payload_Term [1]]) (pair_scope_term n))
      \<in>positive_meaning data_product_system)"

lemma pair_scope_investigation_decision_code [code]:
  "pair_scope_investigation_decision f n=(if f=0 then pair_scope_example n=[(0,0),(1,1)]
    else data_product_octets [0,1] [0,1] (pair_scope_example n))"
proof -
  have diagonal: "(53,Pair_Term (data_list_term [Payload_Term [0],Payload_Term [1]]) (pair_scope_term n))
      \<in>positive_meaning diagonal_rows_system \<longleftrightarrow> pair_scope_example n=[(0,0),(1,1)]"
    by (simp only: diagonal_rows_at_list) (simp add: pair_scope_example_def octets_formed_def)
  have encoded: "map pair_scope_row xs=map (data_pair_encoding (\<lambda>n. Payload_Term [n]) (\<lambda>n. Payload_Term [n])) xs" for xs
    by (rule map_cong[OF refl]) (auto split: prod.splits)
  show ?thesis by (simp only: pair_scope_investigation_decision_def diagonal)
    (simp only: data_product_octets_def encoded list.map)
qed

definition pair_scope_complete :: "nat \<Rightarrow> bool" where
  "pair_scope_complete n \<longleftrightarrow> set (pair_scope_example n)={0,1}\<times>{0,1}"

definition pair_scope_investigation_compare :: "nat \<Rightarrow> nat \<Rightarrow> bool" where
  "pair_scope_investigation_compare c d \<longleftrightarrow> pair_scope_complete c=pair_scope_complete d"

definition pair_scope_investigation_observations :: "(nat\<times>nat\<times>nat) list" where
  "pair_scope_investigation_observations=concat (map (\<lambda>c.
    map (\<lambda>f. (f,c,if pair_scope_investigation_decision f c then 1 else 0)) [0,1]) [0,1,2,3,4,5,6])"

definition pair_scope_investigation_relation :: "(nat\<times>nat) list" where
  "pair_scope_investigation_relation=filter (\<lambda>(c,d). pair_scope_investigation_compare c d)
    (investigation_pairs [0,1,2,3,4,5,6])"

lemma pair_scope_investigation_relation_exact:
  "(c,d)\<in>set pair_scope_investigation_relation \<longleftrightarrow>
    c\<in>{0,1,2,3,4,5,6} \<and> d\<in>{0,1,2,3,4,5,6} \<and> pair_scope_complete c=pair_scope_complete d"
  by (simp only: pair_scope_investigation_relation_def set_filter investigation_pairs_exact
    mem_Collect_eq case_prod_conv pair_scope_investigation_compare_def list.set; blast)

definition pair_scope_investigation where
  "pair_scope_investigation selected=investigation_basis [0,1,2,3,4,5,6] [0,1] selected
    pair_scope_investigation_observations pair_scope_investigation_relation"

definition pair_scope_subject_operation :: "nat \<Rightarrow> (nat\<times>nat) list \<Rightarrow> bool" where
  "pair_scope_subject_operation f pairs=(if f=0 then
    (53,Pair_Term (data_list_term [Payload_Term [0],Payload_Term [1]]) (data_list_term (map pair_scope_row pairs)))
      \<in>positive_meaning diagonal_rows_system
    else (325,context_relation_argument (data_list_term [Payload_Term [0],Payload_Term [1]])
      (data_list_term [Payload_Term [0],Payload_Term [1]]) (data_list_term (map pair_scope_row pairs)))
      \<in>positive_meaning data_product_system)"

lemma pair_scope_subject_decision_at:
  "pair_scope_subject_operation f (pair_scope_example c)=pair_scope_investigation_decision f c"
  by (simp add: pair_scope_subject_operation_def pair_scope_investigation_decision_def)

definition pair_scope_candidate_subjects where
  "pair_scope_candidate_subjects=fimage (\<lambda>c. (c,pair_scope_example c)) {|0::nat,1,2,3,4,5,6|}"

definition pair_scope_operation_subjects where
  "pair_scope_operation_subjects=fimage (\<lambda>f. (f,pair_scope_subject_operation f)) {|0::nat,1|}"

definition pair_scope_value_subjects where
  "pair_scope_value_subjects=fimage (\<lambda>w. (w,w=1)) {|0::nat,1|}"

lemma pair_scope_subject_maps_formed:
  "finite_observation_subjects_formed pair_scope_candidate_subjects pair_scope_operation_subjects pair_scope_value_subjects"
  unfolding pair_scope_candidate_subjects_def pair_scope_operation_subjects_def pair_scope_value_subjects_def
  by (rule finite_observation_function_graphs_formed)

lemma pair_scope_observations_derived:
  "fset_of_list pair_scope_investigation_observations=
    finite_derived_observations pair_scope_candidate_subjects pair_scope_operation_subjects
      pair_scope_value_subjects (\<lambda>operation subject value. value=operation subject)"
  unfolding pair_scope_candidate_subjects_def pair_scope_operation_subjects_def pair_scope_value_subjects_def
  apply (rule finite_table_derived_from_function_graphs)
  by (simp only: fset_of_list.rep_eq pair_scope_investigation_observations_def indexed_value_rows_member pair_scope_subject_decision_at;
    auto split: if_splits)

theorem pair_scope_observation_at_subject:
  assumes "(c,subject) |\<in>| pair_scope_candidate_subjects"
    "(f,operation) |\<in>| pair_scope_operation_subjects"
    "(w,value) |\<in>| pair_scope_value_subjects"
  shows "(f,c,w)\<in>set pair_scope_investigation_observations \<longleftrightarrow> value=operation subject"
  using finite_derived_observation_at_subject[OF pair_scope_subject_maps_formed assms, where P="\<lambda>operation subject value. value=operation subject"]
  by (simp only: pair_scope_observations_derived[symmetric] fset_of_list.rep_eq)

theorem pair_scope_comparison_at_subject:
  assumes "(c,subject) |\<in>| pair_scope_candidate_subjects"
    "(d,other) |\<in>| pair_scope_candidate_subjects"
  shows "(c,d)\<in>set pair_scope_investigation_relation \<longleftrightarrow> (set subject={0,1}\<times>{0,1})=(set other={0,1}\<times>{0,1})"
  using assms
  by (simp only: pair_scope_candidate_subjects_def finite_function_graph_member
    finsert.rep_eq fempty.rep_eq pair_scope_investigation_relation_exact;
    metis pair_scope_complete_def)

export_code investigation_inference investigation_basis investigation_repairs investigation_extend pair_scope_investigation
  pair_scope_investigation_observations pair_scope_investigation_relation nat_of_integer integer_of_nat
  in SML module_name Finite_Investigation file_prefix finite_investigation

text \<open>
  The existing diagonal operation correctly constructs self pairs. Here its
  actual decisions are investigated as a possible observation of complete
  ordered pair coverage. The independent requirement includes every pair
  from the declared two-candidate scope, with no extra pair. It admits every
  order and repetition of that complete finite set. The second observation
  calls the complete native Cartesian operation built from two maps,
  flattening, explicit input admission, and finite-set comparison. Its Boolean result
  identifies complete admission, not the identity of an incomplete output.
\<close>

end
