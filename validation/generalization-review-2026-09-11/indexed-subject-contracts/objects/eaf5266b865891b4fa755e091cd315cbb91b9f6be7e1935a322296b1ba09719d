"""Propose the ordinary runtime connection to the checked structural contract."""
from pathlib import Path
b=Path(__file__).parent
p=b/'worktree/tools/investigate.py'
s=p.read_text().replace('import build\n','import build\nimport observation_contracts\n')
s=s.replace('    if kind in BUILTIN_CASES:\n        function = BUILTIN_CASES[kind]["function"]\n        functions.extend([function, function + "_observations", function + "_relation"])',
'''    contract_export = ""
    if kind in BUILTIN_CASES:
        function = BUILTIN_CASES[kind]["function"]
        functions.extend([function, function + "_observations", function + "_relation"])
        contract_export = ("setup \\\\<open>Finite_Observation_Contracts.export @{term "
                           + function + "}\\\\<close>\\n\\n")''')
s=s.replace('              "export_code " + " ".join(functions) +','              + contract_export + "export_code " + " ".join(functions) +')
s=s.replace('tool_paths = [Path(__file__).resolve(), Path(build.__file__).resolve()]',
            'tool_paths = [Path(__file__).resolve(), Path(build.__file__).resolve(),\n                  Path(observation_contracts.__file__).resolve()]')
old='''        run_command([args.isabelle, "export", "-n", "-d", str(snapshot), "-O", str(export_dir),
                     "-x", f"*{export_theory}:code/finite_investigation.ML", session], args, receipt, log, 60)'''
new='''        export_command = [args.isabelle, "export", "-n", "-d", str(snapshot), "-O", str(export_dir),
                          "-x", f"*{export_theory}:code/finite_investigation.ML"]
        if kind in BUILTIN_CASES:
            function = BUILTIN_CASES[kind]["function"]
            export_command += ["-x", f"*{export_theory}:subjects/{function}.yxml"]
        run_command(export_command + [session], args, receipt, log, 60)'''
assert old in s;s=s.replace(old,new)
old='''        engine = blobs[0]
        require(current_sources(sources)'''
new='''        engine = blobs[0]
        if kind in BUILTIN_CASES:
            paths = list(export_dir.rglob(function + ".yxml"))
            require(len(paths) == 1, "Expected the checked subject contract of this runtime operation.")
            path = paths[0]
            contract = observation_contracts.read_contract(path, engine_theory, function)
            sha = file_hash(path)
            archive_evidence(output, receipt, "checked observation subject contract", path, sha)
            receipt["formal_subject_contract"] = {**contract, "path": str(path), "sha256": sha}
        require(current_sources(sources)'''
assert old in s;s=s.replace(old,new)
s=s.replace('def runtime_program(case: dict, engine: Path) -> str:',
            'def runtime_program(case: dict, engine: Path, formal_contract: dict | None = None) -> str:')
old='''    if case["kind"] in BUILTIN_CASES:
        function = "Finite_Investigation." + BUILTIN_CASES[case["kind"]]["function"]'''
new='''    if case["kind"] in BUILTIN_CASES:
        require(formal_contract is not None, "A fixed runtime operation requires its checked subject contract.")
        function = "Finite_Investigation." + formal_contract["function"].rsplit(".", 1)[-1]
        require(function == "Finite_Investigation." + BUILTIN_CASES[case["kind"]]["function"],
                "The structural contract selects a different runtime function.")'''
assert old in s;s=s.replace(old,new)
s=s.replace('facets = [int(f) for f in BUILTIN_CASES[case["kind"]]["scope"]["facets"]]',
            'facets = formal_contract["facet_indices"]')
s=s.replace('program.write_text(runtime_program(case, engine))',
            'program.write_text(runtime_program(case, engine, receipt.get("formal_subject_contract")))')
old='''            require(file_hash(engine) == receipt["generated_engine_sha256"], "Generated engine changed during execution.")'''
new=old+'''
            if "formal_subject_contract" in receipt:
                contract = receipt["formal_subject_contract"]
                require(file_hash(Path(contract["path"])) == contract["sha256"],
                        "The checked observation subject contract changed during execution.")'''
assert old in s;s=s.replace(old,new)
compile(s,str(p),'exec')
(b/'drafts/investigate.py').write_text(s)
print('Prepared normal engine, runtime, facet-scope and retained-contract connections.')
