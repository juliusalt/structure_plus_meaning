#!/usr/bin/env python3
"""Retain exact reasoning evidence, reusing verified blobs from older archives.

The JSON specification names proof directories, run directories, and optional
attachments. Every recorded execution input except the external Poly/ML
binary must have retained bytes with exactly its recorded digest.
"""
from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path
import shutil


def digest(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


class Archive:
    def __init__(self, output, prior, fallback):
        self.output = output.resolve()
        self.output.mkdir(parents=True)
        self.available = {}
        self.retained = {}
        self.prior_paths = set()
        for directory in prior:
            directory = directory.resolve()
            manifest = json.loads((directory / "archive.json").read_text())
            for name, sha in manifest["files"].items():
                path = (directory / name).resolve()
                assert digest(path) == sha, path
                self.available.setdefault(sha, path)
                self.prior_paths.add(path)
        for directory in fallback:
            for path in directory.resolve().rglob("*"):
                if path.is_file():
                    self.available.setdefault(digest(path), path)

    def add(self, path, sha=None):
        path = Path(path).resolve()
        if sha is None:
            sha = digest(path)
        if sha in self.retained:
            return self.retained[sha]
        if self.available.get(sha) in self.prior_paths:
            selected = self.available[sha]
        elif path.is_file() and digest(path) == sha:
            selected = path
        else:
            selected = self.available.get(sha)
            assert selected is not None and digest(selected) == sha, (path, sha, "missing exact source bytes")
        # Older archive blobs are valid relative references within the same
        # repository. Temporary fallback files are copied into this archive.
        import os
        reference = os.path.relpath(selected, self.output)
        if selected not in self.prior_paths:
            reference = "objects/" + sha
            destination = self.output / reference
            destination.parent.mkdir(exist_ok=True)
            shutil.copyfile(selected, destination)
        assert digest(self.output / reference) == sha
        self.retained[sha] = reference
        return reference

    def directory(self, source):
        return {str(path.relative_to(source)): self.add(path)
                for path in sorted(source.rglob("*")) if path.is_file()}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--specification", type=Path, required=True)
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--project", type=Path, default=Path(__file__).resolve().parents[1])
    parser.add_argument("--prior-archive", type=Path, action="append", default=[])
    parser.add_argument("--fallback-sources", type=Path, action="append", default=[])
    args = parser.parse_args()
    assert not args.output.exists(), "Use a new archive directory."
    spec = json.loads(args.specification.read_text())
    proof_directories = [Path(item["path"]).resolve() for item in spec["proofs"].values()]
    archive = Archive(args.output, args.prior_archive, args.fallback_sources + proof_directories)
    index = {"version": 1, "proofs": {}, "runs": {}, "attachments": {},
             "retainer": archive.add(Path(__file__)), "specification": archive.add(args.specification)}
    for name, item in spec["proofs"].items():
        directory = Path(item["path"]).resolve()
        receipt_path = directory / "result.json"
        receipt = json.loads(receipt_path.read_text())
        context = archive.directory(directory)
        sources = {theory: archive.add(args.project / "theories" / (theory + ".thy"), sha)
                   for theory, sha in receipt["sources"].items()}
        proof = {"receipt": archive.add(receipt_path), "context": context,
                 "sources": sources, "status": receipt["status"]}
        parent_path = directory / "parent.json"
        if parent_path.exists():
            parent = json.loads(parent_path.read_text())
            if "receipt" in parent:
                parent_receipt = Path(parent["receipt"])
                proof["parent_receipt"] = archive.add(parent_receipt, parent["receipt_sha256"])
                source = json.loads(parent_receipt.read_text())
                if "proof_receipt_sha256" in source:
                    proof["parent_proof_receipt"] = archive.add(parent_receipt.parent / "proof.json",
                                                               source["proof_receipt_sha256"])
        if receipt["status"] == "accepted":
            assert receipt["exit_code"] == 0 and receipt["sources_unchanged"]
            assert len(receipt["exports"]) == 1
            engine = receipt["exports"][0]
            proof["engine"] = archive.add(Path(engine["path"]), engine["sha256"])
        index["proofs"][name] = proof
    for name, item in spec["runs"].items():
        directory = Path(item["path"]).resolve()
        receipt = json.loads((directory / "receipt.json").read_text())
        inputs = json.loads((directory / "execution-inputs.json").read_text())
        files = archive.directory(directory)
        exact_inputs, external = {}, {}
        for source, sha in inputs.items():
            if Path(source).name == "poly":
                assert digest(Path(source)) == sha
                external[source] = sha
            else:
                exact_inputs[source] = archive.add(Path(source), sha)
        expected_failure = item.get("expected_failure")
        if expected_failure:
            assert receipt["status"] == "failed"
            assert expected_failure in (directory / "results.log").read_text()
        else:
            assert receipt["status"] == "accepted"
            assert receipt["execution_inputs"] == inputs
        proof_name = item["proof"]
        assert index["proofs"][proof_name]["status"] == "accepted"
        proof = index["proofs"][proof_name]
        if receipt["status"] == "accepted":
            assert digest(archive.output / proof["receipt"]) == receipt["proof_receipt_sha256"]
        index["runs"][name] = {
            "proof": proof_name, "files": files, "inputs": exact_inputs, "external": external,
            "expected_failure": expected_failure,
            "library_exports": item.get("library_exports", list(receipt.get("exported_libraries", {}))),
        }
    for name, path in spec.get("attachments", {}).items():
        index["attachments"][name] = archive.add(Path(path))
    for name, path in spec.get("documents", {}).items():
        relative = Path(name)
        assert not relative.is_absolute() and ".." not in relative.parts
        target = archive.output / relative
        assert not target.exists()
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(Path(path), target)
    (archive.output / "index.json").write_text(json.dumps(index, indent=2) + "\n")
    files = {reference: sha for sha, reference in archive.retained.items()}
    files["index.json"] = digest(archive.output / "index.json")
    for name in spec.get("documents", {}):
        files[name] = digest(archive.output / name)
    (archive.output / "archive.json").write_text(json.dumps({"files": files}, indent=2) + "\n")
    print(json.dumps({"proofs": len(index["proofs"]), "runs": len(index["runs"]),
                      "retained_or_referenced_files": len(files), "archive": str(archive.output)}, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
