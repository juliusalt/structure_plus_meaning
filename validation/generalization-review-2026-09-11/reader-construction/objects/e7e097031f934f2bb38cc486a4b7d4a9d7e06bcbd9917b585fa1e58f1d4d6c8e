#!/usr/bin/env python3
"""Check conditional construction of complete native inference-reader heads."""
from __future__ import annotations

import argparse
import json
from pathlib import Path

import check_reasoning as review
import reader_construction_cases as family


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    for name in ["proof", "poly", "output", "catalog"]:
        parser.add_argument("--" + name, type=Path, required=True)
    parser.add_argument("--engine", type=Path)
    args = parser.parse_args()
    catalogs = family.load_catalogs(args.catalog)
    cases = family.reader_cases(catalogs)
    status = review.run(args, cases_factory=lambda: cases, cases_source=Path(__file__),
                        cases_dependencies=[Path(family.__file__), *family.catalogs_dependencies(args.catalog)])
    if status:
        return status
    results = {}
    coverages = {}
    for line in (args.output / "results.log").read_text().splitlines():
        if line.startswith(("REASONING_RESULT ", "COVERAGE_RESULT ")):
            kind, identifier, raw = line.split(" ", 2)
            (results if kind == "REASONING_RESULT" else coverages)[int(identifier)] = json.loads(raw)
    indexed = {item["name"]: i for i, item in enumerate(cases)}
    base = family.fixture(catalogs)
    final = results[indexed["reader-depth-3"]]
    applications = set(map(review.application_key, final["applications"]))
    expected = set(map(review.application_key, base["trace"]))
    assert applications == expected, "Every complete intended native clause instance must be present."
    no_reasons = lambda result, goal: not any(r["conclusion"] == goal[1:] for r in result["reasons"])
    conditions = {
        "complete_heads_generated_from_original_components": applications == expected,
        "original_reader_goals_remain_conditional": set(map(review.freeze, final["residual"])) == set(map(review.freeze, base["goals"])),
        "assumed_components_close_all_goals": not results[indexed["reader-assumed-all-conditions"]]["residual"],
        "depth_zero_has_no_reader_conclusion": not any(a["entry"] in {348, 349, 350} for a in results[indexed["reader-depth-0"]]["applications"]),
        "depth_two_has_no_top_conclusion": not any(a["entry"] == 350 for a in results[indexed["reader-depth-2"]]["applications"]),
        "missing_top_constructor_has_no_top_reasons": no_reasons(results[indexed["reader-selected-348-349"]], base["goals"][0]),
        "withheld_conditions_keep_top_goal_open": all(base["goals"][0] in results[i]["residual"] for i, c in enumerate(cases) if c["name"].startswith("reader-withheld-condition-")),
        "changed_fields_and_joins_do_not_match": all(no_reasons(results[i], c["goals"][0]) for i, c in enumerate(cases) if c.get("expected_no_goal_application")),
        "unused_malformed_source_rejected": not results[indexed["reader-unused-malformed-source"]]["input_formed"],
        "possible_goal_is_not_known": base["goals"][0] in results[indexed["reader-goal-only-possible"]]["residual"],
        "native_binding_seeds_are_established": not results[indexed["reader-native-binding-seed-comparison"]]["residual"],
    }
    assert all(conditions.values()), conditions
    known = set(map(review.freeze, base["known"]))
    produced = {review.freeze([a["entry"], a["conclusion"]]) for a in final["applications"]}
    unresolved = [q for q in final["demand"] if review.freeze(q) not in known | produced]
    assert set(map(review.freeze, unresolved)) == set(map(review.freeze, base["frontier"])) - known
    receipt = args.output / "receipt.json"
    diagnosis = {
        "question": "Can the compiled reader clauses satisfy the preceding library-coverage report's construction requirement?",
        "status": "complete conditional clause construction demonstrated at the explicit finite bound",
        "conditions": conditions,
        "receipt_sha256": review.digest(receipt),
        "next_conditions": unresolved,
        "next_requirement": "Establish actual source evidence for the demanded component readings, or retain them as explicit unsolved conditions.",
        "semantic_requirement": "The selected clauses and known binding observations must share one accepted native program before their joint closure is asserted sound.",
        "boundary": "The source marker fixtures check complete constructor fields and joins. They do not establish inhabited source readings, whole-node admission, mathematical-proof admission, or general workflow coverage.",
    }
    (args.output / "adequacy.json").write_text(json.dumps(diagnosis, indent=2) + "\n")
    print(json.dumps({k: v for k, v in diagnosis.items() if k != "next_conditions"}, indent=2))
    print("Remaining original component entries:", [d for d, _ in unresolved])
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
