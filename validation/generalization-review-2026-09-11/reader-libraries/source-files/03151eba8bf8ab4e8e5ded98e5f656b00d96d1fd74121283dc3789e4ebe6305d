theory Factor_Executable_Terms
  imports "RRA_Finite_Environments" "Finite_Investigation_a24c220cc9c60a2a4f495caf.Factor_Terms"
begin

section \<open>Finite term values with executable identity\<close>

datatype finite_factor_term =
    Finite_Target finite_exact_target
  | Finite_Payload octets
  | Finite_Pair finite_factor_term finite_factor_term

fun decode_finite_term :: "finite_factor_term \<Rightarrow> factor_term" where
  "decode_finite_term (Finite_Target t) = Target_Term (decode_finite_target t)"
| "decode_finite_term (Finite_Payload v) = Payload_Term v"
| "decode_finite_term (Finite_Pair x y) = Pair_Term (decode_finite_term x) (decode_finite_term y)"

fun finite_term_of :: "factor_term \<Rightarrow> finite_factor_term" where
  "finite_term_of (Target_Term t) = Finite_Target (finite_target_of t)"
| "finite_term_of (Payload_Term v) = Finite_Payload v"
| "finite_term_of (Pair_Term x y) = Finite_Pair (finite_term_of x) (finite_term_of y)"

fun finite_term_formed :: "finite_factor_term \<Rightarrow> bool" where
  "finite_term_formed (Finite_Target t) = finite_target_formed t"
| "finite_term_formed (Finite_Payload v) = octets_formed v"
| "finite_term_formed (Finite_Pair x y) = (finite_term_formed x \<and> finite_term_formed y)"

lemma finite_term_formed_correct:
  "finite_term_formed C \<longleftrightarrow> term_formed (decode_finite_term C)"
  by (induction C) (simp_all add: finite_target_formed_correct)

lemma finite_term_of_decode [simp]: "finite_term_of (decode_finite_term C) = C"
  by (induction C) auto

lemma decode_finite_term_injective [simp]:
  "decode_finite_term C = decode_finite_term D \<longleftrightarrow> C = D"
  using finite_term_of_decode[of C] finite_term_of_decode[of D] by metis

lemma decode_finite_term_of:
  assumes "term_formed t"
  shows "decode_finite_term (finite_term_of t) = t"
  using assms by (induction t) (simp_all add: decode_finite_target_of)

theorem finite_term_representation:
  assumes "term_formed t"
  shows "\<exists>!C. finite_term_formed C \<and> decode_finite_term C = t"
  by (rule ex1I[of _ "finite_term_of t"])
     (use decode_finite_term_of[OF assms] assms in \<open>auto simp: finite_term_formed_correct\<close>)

section \<open>Finite pattern values and direct instance checking\<close>

datatype 'a finite_term_pattern =
    Finite_Variable 'a
  | Finite_Pattern_Target finite_exact_target
  | Finite_Pattern_Payload octets
  | Finite_Pattern_Pair "'a finite_term_pattern" "'a finite_term_pattern"

fun decode_finite_pattern :: "'a finite_term_pattern \<Rightarrow> 'a term_pattern" where
  "decode_finite_pattern (Finite_Variable a) = Pattern_Variable a"
| "decode_finite_pattern (Finite_Pattern_Target t) = Pattern_Target (decode_finite_target t)"
| "decode_finite_pattern (Finite_Pattern_Payload v) = Pattern_Payload v"
| "decode_finite_pattern (Finite_Pattern_Pair p q) =
    Pattern_Pair (decode_finite_pattern p) (decode_finite_pattern q)"

fun finite_pattern_of :: "'a term_pattern \<Rightarrow> 'a finite_term_pattern" where
  "finite_pattern_of (Pattern_Variable a) = Finite_Variable a"
| "finite_pattern_of (Pattern_Target t) = Finite_Pattern_Target (finite_target_of t)"
| "finite_pattern_of (Pattern_Payload v) = Finite_Pattern_Payload v"
| "finite_pattern_of (Pattern_Pair p q) = Finite_Pattern_Pair (finite_pattern_of p) (finite_pattern_of q)"

fun finite_pattern_formed :: "'a finite_term_pattern \<Rightarrow> bool" where
  "finite_pattern_formed (Finite_Variable a) = True"
| "finite_pattern_formed (Finite_Pattern_Target t) = finite_target_formed t"
| "finite_pattern_formed (Finite_Pattern_Payload v) = octets_formed v"
| "finite_pattern_formed (Finite_Pattern_Pair p q) = (finite_pattern_formed p \<and> finite_pattern_formed q)"

fun finite_pattern_variables :: "'a finite_term_pattern \<Rightarrow> 'a fset" where
  "finite_pattern_variables (Finite_Variable a) = {|a|}"
| "finite_pattern_variables (Finite_Pattern_Target t) = {||}"
| "finite_pattern_variables (Finite_Pattern_Payload v) = {||}"
| "finite_pattern_variables (Finite_Pattern_Pair p q) =
    finite_pattern_variables p |\<union>| finite_pattern_variables q"

lemma finite_pattern_formed_correct:
  "finite_pattern_formed C \<longleftrightarrow> pattern_formed (decode_finite_pattern C)"
  by (induction C) (simp_all add: finite_target_formed_correct)

lemma finite_pattern_variables_correct:
  "fset (finite_pattern_variables C) = pattern_variables (decode_finite_pattern C)"
  by (induction C) auto

lemma finite_pattern_of_decode [simp]: "finite_pattern_of (decode_finite_pattern C) = C"
  by (induction C) auto

lemma decode_finite_pattern_injective [simp]:
  "decode_finite_pattern C = decode_finite_pattern D \<longleftrightarrow> C = D"
  using finite_pattern_of_decode[of C] finite_pattern_of_decode[of D] by metis

lemma decode_finite_pattern_of:
  assumes "pattern_formed p"
  shows "decode_finite_pattern (finite_pattern_of p) = p"
  using assms by (induction p) (simp_all add: decode_finite_target_of)

definition decode_finite_term_bindings ::
  "('a \<times> finite_factor_term) fset \<Rightarrow> ('a \<times> factor_term) set" where
  "decode_finite_term_bindings V = map_relation_values decode_finite_term (fset V)"

lemma decode_finite_term_binding [simp]:
  "(a,decode_finite_term t) \<in> decode_finite_term_bindings V \<longleftrightarrow> (a,t) |\<in>| V"
  by (auto simp: decode_finite_term_bindings_def)

definition finite_term_bindings_formed ::
  "'a fset \<Rightarrow> ('a \<times> finite_factor_term) fset \<Rightarrow> bool" where
  "finite_term_bindings_formed B V \<longleftrightarrow>
    finite_relation_functional V \<and> fimage fst V = B \<and>
    fBall V (\<lambda>(a,t). finite_term_formed t)"

lemma finite_term_bindings_formed_correct:
  "finite_term_bindings_formed B V \<longleftrightarrow>
    term_bindings_formed (fset B) (decode_finite_term_bindings V)"
proof -
  have injective: "inj decode_finite_term" by (auto simp: inj_def)
  show ?thesis
    by (auto simp: finite_term_bindings_formed_def term_bindings_formed_def
        finite_relation_functional_correct decode_finite_term_bindings_def
        map_relation_values_functional[OF injective] finite_term_formed_correct
        rel_dom_image fimage.rep_eq fset_inject[symmetric]
        Ball_def split_paired_All; blast)
qed

fun finite_pattern_instance ::
  "('a \<times> finite_factor_term) fset \<Rightarrow> 'a finite_term_pattern \<Rightarrow>
    finite_factor_term \<Rightarrow> bool" where
  "finite_pattern_instance V (Finite_Variable a) t = ((a,t) |\<in>| V)"
| "finite_pattern_instance V (Finite_Pattern_Target x) t =
    (finite_target_formed x \<and> t = Finite_Target x)"
| "finite_pattern_instance V (Finite_Pattern_Payload v) t =
    (octets_formed v \<and> t = Finite_Payload v)"
| "finite_pattern_instance V (Finite_Pattern_Pair p q) t =
    (case t of Finite_Pair x y \<Rightarrow> finite_pattern_instance V p x \<and> finite_pattern_instance V q y
      | _ \<Rightarrow> False)"

theorem finite_pattern_instance_correct:
  "finite_pattern_instance V p t \<longleftrightarrow>
    pattern_instance (decode_finite_term_bindings V) (decode_finite_pattern p) (decode_finite_term t)"
proof (induction p arbitrary: t)
  case (Finite_Variable a)
  then show ?case by simp
next
  case (Finite_Pattern_Target x)
  then show ?case by (cases t) (auto simp: finite_target_formed_correct)
next
  case (Finite_Pattern_Payload v)
  then show ?case by (cases t) auto
next
  case (Finite_Pattern_Pair p q)
  then show ?case by (cases t) auto
qed

export_code finite_term_formed finite_pattern_formed finite_term_bindings_formed
  finite_pattern_instance checking SML

text \<open>
  Instance checking recurses over the supplied pattern and term. It preserves
  every variable key and tests literal targets by complete exact value equality.
  These executable operations implement the existing term judgments; they do
  not add syntax constructors to the native Factor language or decide its
  positive fixed point.
\<close>

end
