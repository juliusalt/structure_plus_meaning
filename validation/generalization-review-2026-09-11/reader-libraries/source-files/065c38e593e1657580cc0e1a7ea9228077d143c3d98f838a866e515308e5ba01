  "(41,t)\<in>positive_meaning prospective_instantiation_system \<longleftrightarrow> (41,t)\<in>positive_meaning citation_location_system"
  "(55,t)\<in>positive_meaning prospective_instantiation_system \<longleftrightarrow> (55,t)\<in>positive_meaning pattern_instantiation_system"
  "(46,t)\<in>positive_meaning prospective_instantiation_system \<longleftrightarrow> (46,t)\<in>positive_meaning data_append_system"
  "(6,t)\<in>positive_meaning prospective_instantiation_system \<longleftrightarrow> (6,t)\<in>positive_meaning bag_comparison_system"
  "(48,t)\<in>positive_meaning prospective_instantiation_system \<longleftrightarrow> (48,t)\<in>positive_meaning data_union_system"
  "(49,t)\<in>positive_meaning prospective_instantiation_system \<longleftrightarrow> (49,t)\<in>positive_meaning payload_disjoint_system"
