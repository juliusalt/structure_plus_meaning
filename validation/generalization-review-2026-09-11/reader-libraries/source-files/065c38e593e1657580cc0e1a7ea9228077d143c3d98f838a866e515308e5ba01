theory Factor_Prospective_Instantiation
  imports "Factor_Scoped_Instantiation"
begin

section \<open>The actual callee and argument under a complete substitution\<close>

abbreviation prospective_instantiation_argument ::
  "factor_term \<Rightarrow> factor_term \<Rightarrow> factor_term \<Rightarrow> factor_term \<Rightarrow>
    factor_term \<Rightarrow> factor_term \<Rightarrow> factor_term \<Rightarrow> factor_term \<Rightarrow>
    factor_term \<Rightarrow> factor_term \<Rightarrow> factor_term" where
  "prospective_instantiation_argument e u v b r d t w i k \<equiv>
    pattern_instantiation_argument e u v b r (Pair_Term d t) w i k"

abbreviation prospective_instantiation_pattern ::
  "'a term_pattern \<Rightarrow> 'a term_pattern \<Rightarrow> 'a term_pattern \<Rightarrow> 'a term_pattern \<Rightarrow>
    'a term_pattern \<Rightarrow> 'a term_pattern \<Rightarrow> 'a term_pattern \<Rightarrow> 'a term_pattern \<Rightarrow>
    'a term_pattern \<Rightarrow> 'a term_pattern \<Rightarrow> 'a term_pattern" where
  "prospective_instantiation_pattern e u v b r d t w i k \<equiv>
    pattern_instantiation_pattern e u v b r (Pattern_Pair d t) w i k"

abbreviation prospective_instantiation_result :: "factor_term \<Rightarrow> bool" where
  "prospective_instantiation_result z \<equiv> \<exists>E e u Vs xs r du da p t Us Is Ks.
    z=prospective_instantiation_argument e (use_data_term u) (data_list_term (map Payload_Term Vs))
      (binding_rows_term xs) (Payload_Term r) (site_data_term du da) t (data_list_term (map Payload_Term Us))
      (data_list_term (map Payload_Term Is)) (data_list_term (map Payload_Term Ks)) \<and>
    environment_value_presents E e \<and> distinct Vs \<and> distinct xs \<and> (\<forall>a\<in>set Vs. octets_formed a) \<and>
    term_bindings_formed (set Vs) (set xs) \<and> distinct Us \<and> distinct Is \<and> distinct Ks \<and>
    prospective_call_at E u (set Vs) r (du,da) p (set Is) (set Ks) \<and>
    pattern_variables p=set Us \<and> pattern_instance (set xs) p t"

lemma prospective_instantiation_result_at_source:
  assumes source: "environment_value_presents E e"
  shows "prospective_instantiation_result (prospective_instantiation_argument e u v b r d t w i k) \<longleftrightarrow>
    (\<exists>q Vs xs a du da p Us Is Ks. u=use_data_term q \<and> v=data_list_term (map Payload_Term Vs) \<and>
      b=binding_rows_term xs \<and> r=Payload_Term a \<and> d=site_data_term du da \<and>
      w=data_list_term (map Payload_Term Us) \<and> i=data_list_term (map Payload_Term Is) \<and>
      k=data_list_term (map Payload_Term Ks) \<and> distinct Vs \<and> distinct xs \<and>
      (\<forall>a\<in>set Vs. octets_formed a) \<and> term_bindings_formed (set Vs) (set xs) \<and>
      distinct Us \<and> distinct Is \<and> distinct Ks \<and>
      prospective_call_at E q (set Vs) a (du,da) p (set Is) (set Ks) \<and>
      pattern_variables p=set Us \<and> pattern_instance (set xs) p t)"
proof
  assume admitted: "prospective_instantiation_result (prospective_instantiation_argument e u v b r d t w i k)"
  obtain F q Vs xs a du da p Us Is Ks where parts: "environment_value_presents F e"
    "u=use_data_term q" "v=data_list_term (map Payload_Term Vs)" "b=binding_rows_term xs" "r=Payload_Term a"
    "d=site_data_term du da" "w=data_list_term (map Payload_Term Us)"
    "i=data_list_term (map Payload_Term Is)" "k=data_list_term (map Payload_Term Ks)"
    "distinct Vs" "distinct xs" "\<forall>a\<in>set Vs. octets_formed a" "term_bindings_formed (set Vs) (set xs)"
    "distinct Us" "distinct Is" "distinct Ks" "prospective_call_at F q (set Vs) a (du,da) p (set Is) (set Ks)"
    "pattern_variables p=set Us" "pattern_instance (set xs) p t"
    using admitted by (simp only: factor_term.inject) blast
  have same: "F=E" by (rule environment_value_presents_unique[OF parts(1) source])
  show "\<exists>q Vs xs a du da p Us Is Ks. u=use_data_term q \<and> v=data_list_term (map Payload_Term Vs) \<and>
      b=binding_rows_term xs \<and> r=Payload_Term a \<and> d=site_data_term du da \<and>
      w=data_list_term (map Payload_Term Us) \<and> i=data_list_term (map Payload_Term Is) \<and>
      k=data_list_term (map Payload_Term Ks) \<and> distinct Vs \<and> distinct xs \<and>
      (\<forall>a\<in>set Vs. octets_formed a) \<and> term_bindings_formed (set Vs) (set xs) \<and>
      distinct Us \<and> distinct Is \<and> distinct Ks \<and>
      prospective_call_at E q (set Vs) a (du,da) p (set Is) (set Ks) \<and>
      pattern_variables p=set Us \<and> pattern_instance (set xs) p t"
    by (rule exI[of _ q], rule exI[of _ Vs], rule exI[of _ xs], rule exI[of _ a],
      rule exI[of _ du], rule exI[of _ da], rule exI[of _ p], rule exI[of _ Us], rule exI[of _ Is], rule exI[of _ Ks])
      (use parts same in auto)
next
  assume "\<exists>q Vs xs a du da p Us Is Ks. u=use_data_term q \<and> v=data_list_term (map Payload_Term Vs) \<and>
      b=binding_rows_term xs \<and> r=Payload_Term a \<and> d=site_data_term du da \<and>
      w=data_list_term (map Payload_Term Us) \<and> i=data_list_term (map Payload_Term Is) \<and>
      k=data_list_term (map Payload_Term Ks) \<and> distinct Vs \<and> distinct xs \<and>
      (\<forall>a\<in>set Vs. octets_formed a) \<and> term_bindings_formed (set Vs) (set xs) \<and>
      distinct Us \<and> distinct Is \<and> distinct Ks \<and>
      prospective_call_at E q (set Vs) a (du,da) p (set Is) (set Ks) \<and>
      pattern_variables p=set Us \<and> pattern_instance (set xs) p t"
  then obtain q Vs xs a du da p Us Is Ks where parts:
    "u=use_data_term q" "v=data_list_term (map Payload_Term Vs)" "b=binding_rows_term xs" "r=Payload_Term a"
    "d=site_data_term du da" "w=data_list_term (map Payload_Term Us)"
    "i=data_list_term (map Payload_Term Is)" "k=data_list_term (map Payload_Term Ks)"
    "distinct Vs" "distinct xs" "\<forall>a\<in>set Vs. octets_formed a" "term_bindings_formed (set Vs) (set xs)"
    "distinct Us" "distinct Is" "distinct Ks" "prospective_call_at E q (set Vs) a (du,da) p (set Is) (set Ks)"
    "pattern_variables p=set Us" "pattern_instance (set xs) p t" by blast
  show "prospective_instantiation_result (prospective_instantiation_argument e u v b r d t w i k)"
    by (rule exI[of _ E], rule exI[of _ e], rule exI[of _ q], rule exI[of _ Vs], rule exI[of _ xs], rule exI[of _ a],
      rule exI[of _ du], rule exI[of _ da], rule exI[of _ p], rule exI[of _ t],
      rule exI[of _ Us], rule exI[of _ Is], rule exI[of _ Ks]) (use parts source in auto)
qed

section \<open>One ordinary join of citation reading, location, and instantiation\<close>

definition prospective_instantiation_schema :: "(nat,nat,nat) factor_schema" where
  "prospective_instantiation_schema=data_rule
    (prospective_instantiation_pattern data_x data_y data_z data_w (Pattern_Variable 4) (Pattern_Variable 5)
      (Pattern_Variable 6) (Pattern_Variable 7) (Pattern_Variable 8) (Pattern_Variable 9))
    {(0,37,artifact_lookup_pattern data_x data_y (Pattern_Variable 10)),
     (1,34,Pattern_Pair (Pattern_Pair (Pattern_Variable 10) (Pattern_Variable 4))
       (data_list_pattern [Pattern_Pair (Pattern_Variable 11) (Pattern_Variable 13),
         Pattern_Pair (Pattern_Variable 12) (Pattern_Variable 14)])),
     (2,42,citation_reading_pattern data_x data_y (Pattern_Variable 13)
       (Pattern_Pair (Pattern_Variable 17) (Pattern_Variable 18)) (Pattern_Variable 15)),
     (3,41,citation_observation_pattern data_x data_y
       (Pattern_Pair (Pattern_Variable 17) (Pattern_Variable 18)) (Pattern_Variable 5)),
     (4,55,pattern_instantiation_pattern data_x data_y data_z data_w (Pattern_Variable 14) (Pattern_Variable 6)
       (Pattern_Variable 7) (Pattern_Variable 16) (Pattern_Variable 19)),
     (5,46,collection_join_pattern (data_list_pattern [Pattern_Variable 4,Pattern_Variable 11,Pattern_Variable 12])
       (Pattern_Variable 15) (Pattern_Variable 20)),
     (6,46,collection_join_pattern (Pattern_Variable 20) (Pattern_Variable 16) (Pattern_Variable 21)),
     (7,6,Pattern_Pair (Pattern_Variable 21) (Pattern_Variable 8)),
     (8,48,collection_join_pattern (Pattern_Variable 17) (Pattern_Variable 19) (Pattern_Variable 9)),
     (9,49,Pattern_Pair (Pattern_Variable 8) (Pattern_Variable 9)),
     (10,49,Pattern_Pair (Pattern_Variable 8) data_z)}"

definition prospective_instantiation_system :: "(nat,nat,nat,nat) schema_system" where
  "prospective_instantiation_system=add_view_definition scoped_instantiation_system 57 data_x {(0,prospective_instantiation_schema)}"

interpretation prospective_instantiation_view: positive_view scoped_instantiation_system 57 data_x "{(0,prospective_instantiation_schema)}"
  by (rule positive_view.intro)
    (auto simp: prospective_instantiation_schema_def schema_formed_def schema_dependencies_def
      single_valued_def rel_dom_def rel_ran_def octets_formed_def)

lemma prospective_instantiation_system_formed [simp]: "schema_system_formed prospective_instantiation_system"
  using prospective_instantiation_view.formed by (simp only: prospective_instantiation_system_def)

lemma prospective_instantiation_definitions [simp]:
  "system_definitions prospective_instantiation_system=insert 57 (system_definitions scoped_instantiation_system)"
  by (simp add: prospective_instantiation_system_def)

lemma prospective_instantiation_call:
  "schema_call_formed prospective_instantiation_system d t \<longleftrightarrow>
    d\<in>system_definitions prospective_instantiation_system \<and> term_formed t"
  using added_variable_calls[OF scoped_instantiation_system_formed
    prospective_instantiation_system_formed[unfolded prospective_instantiation_system_def] scoped_instantiation_call]
  by (simp only: prospective_instantiation_system_def[symmetric])

lemma prospective_instantiation_old_meaning:
  assumes "d\<in>system_definitions scoped_instantiation_system"
  shows "(d,t)\<in>positive_meaning prospective_instantiation_system \<longleftrightarrow>
    (d,t)\<in>positive_meaning scoped_instantiation_system"
  using added_definition_preserves_old(2)[OF scoped_instantiation_system_formed
    prospective_instantiation_system_formed[unfolded prospective_instantiation_system_def], of d t] assms
  by (auto simp: prospective_instantiation_system_def)

lemma prospective_instantiation_clause [simp]:
  "((57,c),S)\<in>system_clauses prospective_instantiation_system \<longleftrightarrow> (c,S)\<in>{(0,prospective_instantiation_schema)}"
proof -
  have owned: "((d,c),S)\<in>system_clauses scoped_instantiation_system \<Longrightarrow>
    d\<in>system_definitions scoped_instantiation_system" for d c S
    using scoped_instantiation_system_formed unfolding schema_system_formed_def by blast
  have absent: "((57,c),S)\<notin>system_clauses scoped_instantiation_system" by (auto dest: owned)
  show ?thesis using absent by (simp add: prospective_instantiation_system_def)
qed

