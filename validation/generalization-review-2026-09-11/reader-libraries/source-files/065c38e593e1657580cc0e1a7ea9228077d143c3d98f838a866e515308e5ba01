  "(37,t)\<in>positive_meaning prospective_instantiation_system \<longleftrightarrow> (37,t)\<in>positive_meaning artifact_lookup_system"
  "(34,t)\<in>positive_meaning prospective_instantiation_system \<longleftrightarrow> (34,t)\<in>positive_meaning record_admission_system"
