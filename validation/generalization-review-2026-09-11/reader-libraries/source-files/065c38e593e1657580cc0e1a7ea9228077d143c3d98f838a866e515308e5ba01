    prospective_instantiation_old_meaning[of 41 t] scoped_instantiation_old_meaning[of 41 t]
    pattern_instantiation_quotation_meaning[of 41 t] quotation_admission_reading_meaning[of 41 t]
    citation_reading_components(4)[of t]
    prospective_instantiation_old_meaning[of 55 t] scoped_instantiation_components(4)[of t]
    prospective_instantiation_old_meaning[of 46 t] scoped_instantiation_components(6)[of t]
    prospective_instantiation_old_meaning[of 6 t] scoped_instantiation_components(5)[of t]
    prospective_instantiation_old_meaning[of 48 t] scoped_instantiation_old_meaning[of 48 t] pattern_instantiation_components(10)[of t]
    prospective_instantiation_old_meaning[of 49 t] scoped_instantiation_components(7)[of t] by auto

lemma prospective_instantiation_step:
  assumes lookup: "(37,artifact_lookup_argument e u a)\<in>positive_meaning artifact_lookup_system"
    and rec: "(34,rooted_rows_argument a r (data_list_term [Pair_Term p c,Pair_Term s q]))\<in>positive_meaning record_admission_system"
    and reading: "(42,citation_reading_argument e u c (Pair_Term sk ac) ci)\<in>positive_meaning citation_reading_system"
    and location: "(41,citation_observation_argument e u (Pair_Term sk ac) d)\<in>positive_meaning citation_location_system"
    and body: "(55,pattern_instantiation_argument e u v table q t w ai ak)\<in>positive_meaning pattern_instantiation_system"
    and prefix: "(46,collection_join_argument (data_list_term [r,p,s]) ci prefix)\<in>positive_meaning data_append_system"
    and joined: "(46,collection_join_argument prefix ai joined)\<in>positive_meaning data_append_system"
    and interior: "(6,Pair_Term joined i)\<in>positive_meaning bag_comparison_system"
    and slots: "(48,collection_join_argument sk ak k)\<in>positive_meaning data_union_system"
    and boundary: "(49,Pair_Term i k)\<in>positive_meaning payload_disjoint_system"
    and scope_boundary: "(49,Pair_Term i v)\<in>positive_meaning payload_disjoint_system"
  shows "(57,prospective_instantiation_argument e u v table r d t w i k)\<in>positive_meaning prospective_instantiation_system"
proof -
  have formed: "term_formed e" "term_formed u" "term_formed v" "term_formed table" "term_formed r" "term_formed d"
    "term_formed t" "term_formed w" "term_formed i" "term_formed k" "term_formed a" "term_formed p"
    "term_formed s" "term_formed c" "term_formed q" "term_formed ci" "term_formed ai" "term_formed sk"
    "term_formed ac" "term_formed ak" "term_formed prefix" "term_formed joined"
    using schema_call_formed_target[OF positive_meaning_formed[OF lookup]]
      schema_call_formed_target[OF positive_meaning_formed[OF rec]]
      schema_call_formed_target[OF positive_meaning_formed[OF reading]]
      schema_call_formed_target[OF positive_meaning_formed[OF location]]
      schema_call_formed_target[OF positive_meaning_formed[OF body]]
      schema_call_formed_target[OF positive_meaning_formed[OF prefix]]
      schema_call_formed_target[OF positive_meaning_formed[OF joined]]
      schema_call_formed_target[OF positive_meaning_formed[OF interior]]
      schema_call_formed_target[OF positive_meaning_formed[OF slots]]
      schema_call_formed_target[OF positive_meaning_formed[OF boundary]]
      schema_call_formed_target[OF positive_meaning_formed[OF scope_boundary]] by auto
  let ?h="\<lambda>n::nat. if n=0 then e else if n=1 then u else if n=2 then v else if n=3 then table else if n=4 then r else
    if n=5 then d else if n=6 then t else if n=7 then w else if n=8 then i else if n=9 then k else
    if n=10 then a else if n=11 then p else if n=12 then s else if n=13 then c else if n=14 then q else
    if n=15 then ci else if n=16 then ai else if n=17 then sk else if n=18 then ac else if n=19 then ak else
    if n=20 then prefix else joined"
  have result: "(57,evaluate_pattern ?h (schema_conclusion prospective_instantiation_schema))
      \<in>positive_meaning prospective_instantiation_system"
    by (rule ordinary_positive_valuation_step[where c=0])
      (use formed assms in \<open>auto simp: prospective_instantiation_schema_def schema_variables_def
        prospective_instantiation_call prospective_instantiation_components\<close>)
  show ?thesis using result by (simp add: prospective_instantiation_schema_def)
qed

section \<open>Exact recovery from every supplied source presentation\<close>

theorem prospective_instantiation_sound:
  assumes holds: "(57,z)\<in>positive_meaning prospective_instantiation_system"
  shows "prospective_instantiation_result z"
proof -
  have expansion: "(57,z)\<in>positive_meaning prospective_instantiation_system \<longleftrightarrow>
    (\<exists>c S h. ((57,c),S)\<in>system_clauses prospective_instantiation_system \<and>
      (\<forall>i\<in>schema_variables S. term_formed (h i)) \<and>
      z=evaluate_pattern h (schema_conclusion S) \<and> schema_call_formed prospective_instantiation_system 57 z \<and>
      (\<forall>s e p. (s,e,p)\<in>schema_premises S \<longrightarrow>
        (e,evaluate_pattern h p)\<in>positive_meaning prospective_instantiation_system))"
    by (rule ordinary_positive_entry_valuation) (auto simp: prospective_instantiation_schema_def)
  obtain c S h where clause: "((57,c),S)\<in>system_clauses prospective_instantiation_system"
    and head: "z=evaluate_pattern h (schema_conclusion S)"
    and support: "\<forall>s e p. (s,e,p)\<in>schema_premises S \<longrightarrow>
      (e,evaluate_pattern h p)\<in>positive_meaning prospective_instantiation_system"
    using holds by (simp only: expansion) blast
  have schema: "S=prospective_instantiation_schema" using clause by auto
  have shape: "z=prospective_instantiation_argument (h 0) (h 1) (h 2) (h 3) (h 4) (h 5) (h 6) (h 7) (h 8) (h 9)"
    using head by (simp add: schema prospective_instantiation_schema_def)
  have calls: "(37,artifact_lookup_argument (h 0) (h 1) (h 10))\<in>positive_meaning artifact_lookup_system"
    "(34,rooted_rows_argument (h 10) (h 4) (data_list_term [Pair_Term (h 11) (h 13),Pair_Term (h 12) (h 14)]))\<in>positive_meaning record_admission_system"
    "(42,citation_reading_argument (h 0) (h 1) (h 13) (Pair_Term (h 17) (h 18)) (h 15))\<in>positive_meaning citation_reading_system"
    "(41,citation_observation_argument (h 0) (h 1) (Pair_Term (h 17) (h 18)) (h 5))\<in>positive_meaning citation_location_system"
    "(55,pattern_instantiation_argument (h 0) (h 1) (h 2) (h 3) (h 14) (h 6) (h 7) (h 16) (h 19))\<in>positive_meaning pattern_instantiation_system"
    "(46,collection_join_argument (data_list_term [(h 4),(h 11),(h 12)]) (h 15) (h 20))\<in>positive_meaning data_append_system"
    "(46,collection_join_argument (h 20) (h 16) (h 21))\<in>positive_meaning data_append_system"
    "(6,Pair_Term (h 21) (h 8))\<in>positive_meaning bag_comparison_system"
    "(48,collection_join_argument (h 17) (h 19) (h 9))\<in>positive_meaning data_union_system"
    "(49,Pair_Term (h 8) (h 9))\<in>positive_meaning payload_disjoint_system"
    "(49,Pair_Term (h 8) (h 2))\<in>positive_meaning payload_disjoint_system"
    using support by (auto simp: schema prospective_instantiation_schema_def prospective_instantiation_components)
  obtain E u R where source: "environment_value_presents E (h 0)" "h 1=use_data_term u"
    "artifact_at E u R" "artifact_value_presents R (h 10)"
    using calls(1) by (auto simp: artifact_lookup_exact)
  have ef: "environment_formed E" using environment_value_presents_formed[OF source(1)] by blast
  obtain r p c s q where rec: "h 4=Payload_Term r" "h 11=Payload_Term p" "h 13=Payload_Term c"
    "h 12=Payload_Term s" "h 14=Payload_Term q" "record_at R r [p,s] [c,q]"
    using calls(2) by (simp only: record_admission_pair_fields[OF source(4)]) blast
  obtain cite Cs S where citation: "Pair_Term (h 17) (h 18)=citation_data_term cite"
    "h 15=data_list_term (map Payload_Term Cs)" "distinct Cs"
    "artifact_at E u S" "citation_at S c cite (set Cs)"
    using calls(3)[unfolded citation_reading_at_source[OF source(1)]]
    by (auto simp: source(2)[unfolded One_nat_def] rec(3) inj_eq[OF use_data_term_injective])
  have same: "S=R" by (rule environment_artifact_unique[OF ef citation(4) source(3)])
  have raw_citation: "citation_at R c cite (set Cs)" using citation(5) same by simp
  obtain Ss where slot_field: "h 17=data_list_term (map Payload_Term Ss)"
    "distinct Ss" "set Ss=citation_slots cite"
    using citation_data_slot_fields[OF citation(1)[symmetric]] by blast
  obtain du da where location: "h 5=site_data_term du da" "citation_location E u cite du da"
    using calls(4)[unfolded citation_location_at_source[OF source(1)]]
    by (auto simp: source(2)[unfolded One_nat_def] citation(1)
      inj_eq[OF use_data_term_injective] inj_eq[OF citation_data_term_injective])
  obtain Vs xs pat Us Js As where table:
    "h 2=data_list_term (map Payload_Term Vs)" "h 3=binding_rows_term xs"
    "distinct Vs" "distinct xs" "\<forall>a\<in>set Vs. octets_formed a" "term_bindings_formed (set Vs) (set xs)"
    and body: "h 7=data_list_term (map Payload_Term Us)" "h 16=data_list_term (map Payload_Term Js)"
    "h 19=data_list_term (map Payload_Term As)" "distinct Us" "distinct Js" "distinct As"
    "pattern_quoted_at E u (set Vs) q pat (set Js) (set As)"
    "pattern_variables pat=set Us" "pattern_instance (set xs) pat (h 6)"
    using calls(5)[unfolded pattern_instantiation_at_source[OF source(1)]]
    by (auto simp: source(2)[unfolded One_nat_def] rec(5) inj_eq[OF use_data_term_injective])
  obtain Is Ks where boundary: "h 8=data_list_term (map Payload_Term Is)" "h 9=data_list_term (map Payload_Term Ks)"
    "distinct Is" "distinct Ks" "set Is\<inter>set Ks={}"
    using calls(10) by (auto simp: payload_disjoint_exact)
  have scope_boundary: "set Is\<inter>set Vs={}"
    using calls(11) by (simp only: boundary(1) table(1) payload_disjoint_lists; blast)
  have slots: "set Ks=citation_slots cite\<union>set As"
    using calls(9) by (simp only: slot_field(1) body(3) boundary(2) data_union_payload_lists slot_field(3); blast)
  have prefix: "h 20=data_list_term (map Payload_Term (r#p#s#Cs))"
    using calls(6) by (simp only: rec(1,2,4) citation(2) data_append_at_lists) auto
  have joined: "h 21=data_list_term (map Payload_Term (r#p#s#Cs@Js))"
    using calls(7) by (simp only: prefix body(2) data_append_at_lists) auto
  have comparison: "mset (r#p#s#Cs@Js)=mset Is"
    using calls(8) by (simp only: joined boundary(1) bag_comparison_lists injective_mapped_multisets[OF payload_term_inj])
  have ports: "distinct [p,s]" "r\<notin>set [p,s]"
    using record_at_preserves_socket_occurrences[OF rec(6)] by auto
  have separation: "insert r (set [p,s])\<inter>(set Cs\<union>set Js)={}"
    "set Cs\<inter>set Js={}" "set Is=insert r (set [p,s]\<union>set Cs\<union>set Js)"
    using quotation_interior_lists[OF ports citation(3) body(5) boundary(3)] comparison by auto
  have reading: "prospective_call_at E u (set Vs) r (du,da) pat (set Is) (set Ks)"
    unfolding prospective_call_at_def
    by (intro conjI, rule ef, rule exI[of _ R], rule exI[of _ "[p,s]"], rule exI[of _ c],
      rule exI[of _ q], rule exI[of _ cite], rule exI[of _ "set Cs"], rule exI[of _ "set Js"], rule exI[of _ "set As"])
      (use source(3) rec(6) raw_citation location(2) body(7) separation slots boundary(5) scope_boundary in auto)
  show ?thesis
    by (rule exI[of _ E], rule exI[of _ "h 0"], rule exI[of _ u], rule exI[of _ Vs], rule exI[of _ xs],
      rule exI[of _ r], rule exI[of _ du], rule exI[of _ da], rule exI[of _ pat], rule exI[of _ "h 6"],
      rule exI[of _ Us], rule exI[of _ Is], rule exI[of _ Ks])
      (use shape source rec location table body boundary reading in auto)
qed

theorem prospective_instantiation_complete:
  assumes call: "prospective_call_at E u V r d p I K" and source: "environment_value_presents E e"
    and table: "(52,Pair_Term (data_list_term (map Payload_Term Vs)) (binding_rows_term xs))
      \<in>positive_meaning binding_admission_system"
    and scope: "set Vs=V" and order: "distinct Us" "distinct Is" "distinct Ks"
    and collections: "set Us=pattern_variables p" "set Is=I" "set Ks=K"
    and inst: "pattern_instance (set xs) p t"
  shows "(57,prospective_instantiation_argument e (use_data_term u) (data_list_term (map Payload_Term Vs))
      (binding_rows_term xs) (Payload_Term r) (site_data_term (fst d) (snd d)) t (data_list_term (map Payload_Term Us))
      (data_list_term (map Payload_Term Is)) (data_list_term (map Payload_Term Ks)))
      \<in>positive_meaning prospective_instantiation_system"
proof -
  obtain R ps c a cite C J A where parts:
    "artifact_at E u R" "record_at R r ps [c,a]" "citation_at R c cite C"
    "citation_location E u cite (fst d) (snd d)" "pattern_quoted_at E u V a p J A"
    "insert r (set ps)\<inter>(C\<union>J)={}" "C\<inter>J={}"
    "I=insert r (set ps\<union>C\<union>J)" "K=citation_slots cite\<union>A" "I\<inter>(K\<union>V)={}"
    using call by (auto simp: prospective_call_at_def)
  have ef: "environment_formed E" using environment_value_presents_formed[OF source] by blast
  have rf: "exact_formed R" using ef parts(1) by (auto simp: environment_formed_def)
  obtain material where presented: "artifact_value_presents R material" using artifact_value_presents_total[OF rf] by blast
  have raw_citation: "raw_citation_at R c cite C" using parts(3) by (simp add: citation_at_def)
  obtain Cs where cs: "set Cs=C" "distinct Cs"
    using finite_distinct_list[OF raw_citation_interior(1)[OF raw_citation]] by blast
  obtain Js where js: "set Js=J" "distinct Js"
    using finite_distinct_list[of J] pattern_quoted_boundary[OF parts(5)] by blast
  obtain As where as_rows: "set As=A" "distinct As"
    using finite_distinct_list[of A] pattern_quoted_boundary[OF parts(5)] by blast
  obtain Ss ac where slot_field: "citation_data_term cite=Pair_Term (data_list_term (map Payload_Term Ss)) ac"
    "distinct Ss" "set Ss=citation_slots cite" using citation_data_slot_shape[of cite] by blast
  obtain b q where ports: "ps=[b,q]"
    using record_at_preserves_socket_occurrences[OF parts(2)] by (auto simp: length_Suc_conv)
  have ports_distinct: "distinct [b,q]" "r\<notin>set [b,q]"
    using record_at_preserves_socket_occurrences[OF parts(2)] by (auto simp: ports)
  have lookup: "(37,artifact_lookup_argument e (use_data_term u) material)\<in>positive_meaning artifact_lookup_system"
    using source parts(1) presented by (auto simp: artifact_lookup_exact)
  have rec: "(34,rooted_rows_argument material (Payload_Term r)
      (data_list_term [Pair_Term (Payload_Term b) (Payload_Term c),Pair_Term (Payload_Term q) (Payload_Term a)]))
      \<in>positive_meaning record_admission_system"
    by (simp only: record_admission_pair_fields[OF presented]) (use parts(2) in \<open>auto simp: ports\<close>)
  have citation: "citation_at R c cite (set Cs)" using parts(3) cs(1) by simp
  have reading: "(42,citation_reading_argument e (use_data_term u) (Payload_Term c)
      (Pair_Term (data_list_term (map Payload_Term Ss)) ac) (data_list_term (map Payload_Term Cs)))
      \<in>positive_meaning citation_reading_system"
    using citation_reading_complete[OF source parts(1) cs(2) citation] by (simp only: slot_field(1))
  have location: "(41,citation_observation_argument e (use_data_term u)
      (Pair_Term (data_list_term (map Payload_Term Ss)) ac) (site_data_term (fst d) (snd d)))
      \<in>positive_meaning citation_location_system"
    using citation_location_complete[OF source parts(4)] by (simp only: slot_field(1))
  have body: "(55,pattern_instantiation_argument e (use_data_term u) (data_list_term (map Payload_Term Vs))
      (binding_rows_term xs) (Payload_Term a) t (data_list_term (map Payload_Term Us))
      (data_list_term (map Payload_Term Js)) (data_list_term (map Payload_Term As)))
      \<in>positive_meaning pattern_instantiation_system"
    by (rule pattern_instantiation_complete[OF parts(5) source table scope order(1) js(2) as_rows(2)
      collections(1) js(1) as_rows(1) inst])
  have scope_formed: "distinct Vs" "\<forall>a\<in>set Vs. octets_formed a"
    using table[unfolded binding_admission_on_values] by auto
  have operands: "octets_formed r" "octets_formed b" "octets_formed q"
    "\<forall>a\<in>set Cs. octets_formed a" "\<forall>a\<in>set Ss. octets_formed a"
    "\<forall>a\<in>set Js. octets_formed a" "\<forall>a\<in>set As. octets_formed a"
    using schema_call_formed_target[OF positive_meaning_formed[OF rec]]
      schema_call_formed_target[OF positive_meaning_formed[OF reading]]
      schema_call_formed_target[OF positive_meaning_formed[OF body]]
    by (auto simp: data_list_term_formed)
  have data: "data_elements (map Payload_Term (r#b#q#Cs))" "data_elements (map Payload_Term Js)"
    "data_elements (map Payload_Term Is)" "data_elements (map Payload_Term Ks)"
    "data_elements (map Payload_Term Ss)" "data_elements (map Payload_Term As)" "data_elements (map Payload_Term Vs)"
    using operands scope_formed by (auto simp: collections(2,3) parts(8,9) ports cs(1) js(1) as_rows(1) slot_field(3))
  have comparison: "mset (r#b#q#Cs@Js)=mset Is"
    using quotation_interior_lists[OF ports_distinct cs(2) js(2) order(2)] parts(6-8) collections(2)
    by (auto simp: ports cs(1) js(1))
  let ?prefix="data_list_term (map Payload_Term (r#b#q#Cs))"
  let ?joined="data_list_term (map Payload_Term (r#b#q#Cs@Js))"
  have prefix: "(46,collection_join_argument (data_list_term [Payload_Term r,Payload_Term b,Payload_Term q])
      (data_list_term (map Payload_Term Cs)) ?prefix)\<in>positive_meaning data_append_system"
    by (simp only: data_append_at_lists) (use data in auto)
  have joined: "(46,collection_join_argument ?prefix (data_list_term (map Payload_Term Js)) ?joined)
      \<in>positive_meaning data_append_system"
    by (simp only: data_append_at_lists) (use data in auto)
  have interior: "(6,Pair_Term ?joined (data_list_term (map Payload_Term Is)))\<in>positive_meaning bag_comparison_system"
    by (simp only: bag_comparison_lists injective_mapped_multisets[OF payload_term_inj]) (use data comparison in auto)
  have slots: "(48,collection_join_argument (data_list_term (map Payload_Term Ss))
      (data_list_term (map Payload_Term As)) (data_list_term (map Payload_Term Ks)))\<in>positive_meaning data_union_system"
    by (simp only: data_union_payload_lists) (use data collections(3) parts(9) slot_field(3) as_rows(1) in auto)
  have boundary: "(49,Pair_Term (data_list_term (map Payload_Term Is)) (data_list_term (map Payload_Term Ks)))
      \<in>positive_meaning payload_disjoint_system"
    by (simp only: payload_disjoint_lists) (use data order(2,3) collections(2,3) parts(10) in auto)
  have scope_boundary: "(49,Pair_Term (data_list_term (map Payload_Term Is)) (data_list_term (map Payload_Term Vs)))
      \<in>positive_meaning payload_disjoint_system"
    by (simp only: payload_disjoint_lists) (use data order(2) scope_formed scope collections(2) parts(10) in auto)
  show ?thesis
    by (rule prospective_instantiation_step[OF lookup rec reading location body prefix joined interior slots boundary scope_boundary])
qed

theorem prospective_instantiation_exact:
  "(57,z)\<in>positive_meaning prospective_instantiation_system \<longleftrightarrow> prospective_instantiation_result z"
proof
  show "(57,z)\<in>positive_meaning prospective_instantiation_system \<Longrightarrow> prospective_instantiation_result z"
    by (rule prospective_instantiation_sound)
next
  assume admitted: "prospective_instantiation_result z"
  obtain E e u Vs xs r du da p t Us Is Ks where parts:
    "z=prospective_instantiation_argument e (use_data_term u) (data_list_term (map Payload_Term Vs))
      (binding_rows_term xs) (Payload_Term r) (site_data_term du da) t (data_list_term (map Payload_Term Us))
      (data_list_term (map Payload_Term Is)) (data_list_term (map Payload_Term Ks))"
    "environment_value_presents E e" "distinct Vs" "distinct xs" "\<forall>a\<in>set Vs. octets_formed a"
    "term_bindings_formed (set Vs) (set xs)" "distinct Us" "distinct Is" "distinct Ks"
    "prospective_call_at E u (set Vs) r (du,da) p (set Is) (set Ks)"
    "pattern_variables p=set Us" "pattern_instance (set xs) p t"
    using admitted by blast
  have table: "(52,Pair_Term (data_list_term (map Payload_Term Vs)) (binding_rows_term xs))
      \<in>positive_meaning binding_admission_system"
    by (simp only: binding_admission_on_values) (use parts(3-6) in blast)
  show "(57,z)\<in>positive_meaning prospective_instantiation_system"
    using prospective_instantiation_complete[OF parts(10,2) table refl parts(7-9) parts(11)[symmetric] refl refl parts(12)]
    by (simp only: fst_conv snd_conv parts(1))
qed

corollary prospective_instantiation_at_source:
  assumes source: "environment_value_presents E e"
  shows "(57,prospective_instantiation_argument e u v b r d t w i k)\<in>positive_meaning prospective_instantiation_system \<longleftrightarrow>
    (\<exists>q Vs xs a du da p Us Is Ks. u=use_data_term q \<and> v=data_list_term (map Payload_Term Vs) \<and>
      b=binding_rows_term xs \<and> r=Payload_Term a \<and> d=site_data_term du da \<and>
      w=data_list_term (map Payload_Term Us) \<and> i=data_list_term (map Payload_Term Is) \<and>
      k=data_list_term (map Payload_Term Ks) \<and> distinct Vs \<and> distinct xs \<and>
      (\<forall>a\<in>set Vs. octets_formed a) \<and> term_bindings_formed (set Vs) (set xs) \<and>
      distinct Us \<and> distinct Is \<and> distinct Ks \<and>
      prospective_call_at E q (set Vs) a (du,da) p (set Is) (set Ks) \<and>
      pattern_variables p=set Us \<and> pattern_instance (set xs) p t)"
  by (simp only: prospective_instantiation_exact prospective_instantiation_result_at_source[OF source])

corollary prospective_instantiation_on_values:
  assumes source: "environment_value_presents E e"
  shows "(57,prospective_instantiation_argument e (use_data_term u) (data_list_term (map Payload_Term Vs))
      (binding_rows_term xs) (Payload_Term r) (site_data_term du da) t (data_list_term (map Payload_Term Us))
      (data_list_term (map Payload_Term Is)) (data_list_term (map Payload_Term Ks)))
      \<in>positive_meaning prospective_instantiation_system \<longleftrightarrow>
    distinct Vs \<and> distinct xs \<and> (\<forall>a\<in>set Vs. octets_formed a) \<and> term_bindings_formed (set Vs) (set xs) \<and>
    distinct Us \<and> distinct Is \<and> distinct Ks \<and>
    (\<exists>p. prospective_call_at E u (set Vs) r (du,da) p (set Is) (set Ks) \<and>
      pattern_variables p=set Us \<and> pattern_instance (set xs) p t)"
  by (subst prospective_instantiation_at_source[OF source],
    simp only: binding_rows_term_injective inj_eq[OF use_data_term_injective] factor_term.inject)
    (auto simp: data_list_term_injective injective_mapped_lists[OF payload_term_inj])

corollary prospective_instantiation_presentation_invariance:
  assumes "environment_value_presents E e" "environment_value_presents E f"
  shows "(57,prospective_instantiation_argument e u v b r d t w i k)\<in>positive_meaning prospective_instantiation_system \<longleftrightarrow>
    (57,prospective_instantiation_argument f u v b r d t w i k)\<in>positive_meaning prospective_instantiation_system"
  by (simp only: prospective_instantiation_at_source[OF assms(1)] prospective_instantiation_at_source[OF assms(2)])

corollary prospective_instantiation_orders:
  assumes source: "environment_value_presents E e"
    and same: "mset Vs=mset Ws" "mset xs=mset ys" "mset Us=mset Zs" "mset Is=mset Js" "mset Ks=mset Ls"
  shows "(57,prospective_instantiation_argument e (use_data_term u) (data_list_term (map Payload_Term Vs))
      (binding_rows_term xs) (Payload_Term r) (site_data_term du da) t (data_list_term (map Payload_Term Us))
      (data_list_term (map Payload_Term Is)) (data_list_term (map Payload_Term Ks)))\<in>positive_meaning prospective_instantiation_system
      \<longleftrightarrow>
    (57,prospective_instantiation_argument e (use_data_term u) (data_list_term (map Payload_Term Ws))
      (binding_rows_term ys) (Payload_Term r) (site_data_term du da) t (data_list_term (map Payload_Term Zs))
      (data_list_term (map Payload_Term Js)) (data_list_term (map Payload_Term Ls)))\<in>positive_meaning prospective_instantiation_system"
  using mset_eq_imp_distinct_iff[OF same(1)] mset_eq_imp_distinct_iff[OF same(2)] mset_eq_imp_distinct_iff[OF same(3)]
    mset_eq_imp_distinct_iff[OF same(4)] mset_eq_imp_distinct_iff[OF same(5)]
    mset_eq_setD[OF same(1)] mset_eq_setD[OF same(2)] mset_eq_setD[OF same(3)] mset_eq_setD[OF same(4)] mset_eq_setD[OF same(5)]
  by (simp only: prospective_instantiation_on_values[OF source])

corollary prospective_instantiation_result_unique:
  assumes source: "environment_value_presents E e"
    and first: "(57,prospective_instantiation_argument e (use_data_term u) (data_list_term (map Payload_Term Vs))
      (binding_rows_term xs) (Payload_Term r) (site_data_term du da) t (data_list_term (map Payload_Term Us))
      (data_list_term (map Payload_Term Is)) (data_list_term (map Payload_Term Ks)))\<in>positive_meaning prospective_instantiation_system"
    and second: "(57,prospective_instantiation_argument e (use_data_term u) (data_list_term (map Payload_Term Vs))
      (binding_rows_term xs) (Payload_Term r) (site_data_term eu ea) s (data_list_term (map Payload_Term Ws))
      (data_list_term (map Payload_Term Js)) (data_list_term (map Payload_Term Ls)))\<in>positive_meaning prospective_instantiation_system"
  shows "du=eu \<and> da=ea \<and> t=s \<and> mset Us=mset Ws \<and> mset Is=mset Js \<and> mset Ks=mset Ls"
proof -
  obtain p where left: "term_bindings_formed (set Vs) (set xs)" "distinct Us" "distinct Is" "distinct Ks"
    "prospective_call_at E u (set Vs) r (du,da) p (set Is) (set Ks)"
    "pattern_variables p=set Us" "pattern_instance (set xs) p t"
    using first by (simp only: prospective_instantiation_on_values[OF source]) blast
  obtain q where right: "distinct Ws" "distinct Js" "distinct Ls"
    "prospective_call_at E u (set Vs) r (eu,ea) q (set Js) (set Ls)"
    "pattern_variables q=set Ws" "pattern_instance (set xs) q s"
    using second by (simp only: prospective_instantiation_on_values[OF source]) blast
  have same: "du=eu" "da=ea" "p=q" "set Is=set Js" "set Ks=set Ls"
    using prospective_call_unique[OF left(5) right(4)] by auto
  have used: "set Us=set Ws" using left(6) right(5) same(3) by simp
  have single: "single_valued (set xs)" using left(1) by (simp add: term_bindings_formed_def)
  have other: "pattern_instance (set xs) p s" using right(6) same(3) by simp
  have terms: "t=s" by (rule pattern_instance_unique[OF single left(7) other])
  show ?thesis using same(1,2,4,5) used terms left(2-4) right(1-3)
    distinct_source_mset[OF left(2), of Ws] distinct_source_mset[OF left(3), of Js]
    distinct_source_mset[OF left(4), of Ls] by auto
qed

corollary prospective_instantiation_total:
  assumes call: "prospective_call_at E u (set Vs) r (du,da) p I K" and source: "environment_value_presents E e"
    and table: "(52,Pair_Term (data_list_term (map Payload_Term Vs)) (binding_rows_term xs))
      \<in>positive_meaning binding_admission_system"
    and order: "distinct Us" "distinct Is" "distinct Ks"
    and collections: "set Us=pattern_variables p" "set Is=I" "set Ks=K"
  shows "\<exists>!t. (57,prospective_instantiation_argument e (use_data_term u) (data_list_term (map Payload_Term Vs))
      (binding_rows_term xs) (Payload_Term r) (site_data_term du da) t (data_list_term (map Payload_Term Us))
      (data_list_term (map Payload_Term Is)) (data_list_term (map Payload_Term Ks)))\<in>positive_meaning prospective_instantiation_system"
proof -
  have bindings: "term_bindings_formed (set Vs) (set xs)" using table[unfolded binding_admission_on_values] by blast
  have formed: "pattern_formed p" "pattern_variables p\<subseteq>set Vs" using prospective_call_formed[OF call] by auto
  obtain t where inst: "pattern_instance (set xs) p t"
    using scoped_pattern_has_one_instance[OF bindings formed] by blast
  have first: "(57,prospective_instantiation_argument e (use_data_term u) (data_list_term (map Payload_Term Vs))
      (binding_rows_term xs) (Payload_Term r) (site_data_term du da) t (data_list_term (map Payload_Term Us))
      (data_list_term (map Payload_Term Is)) (data_list_term (map Payload_Term Ks)))\<in>positive_meaning prospective_instantiation_system"
    using prospective_instantiation_complete[OF call source table refl order collections inst] by simp
  show ?thesis
  proof (rule ex1I[of _ t])
    show "(57,prospective_instantiation_argument e (use_data_term u) (data_list_term (map Payload_Term Vs))
        (binding_rows_term xs) (Payload_Term r) (site_data_term du da) t (data_list_term (map Payload_Term Us))
        (data_list_term (map Payload_Term Is)) (data_list_term (map Payload_Term Ks)))\<in>positive_meaning prospective_instantiation_system"
      by (rule first)
  next
    fix s
    assume second: "(57,prospective_instantiation_argument e (use_data_term u) (data_list_term (map Payload_Term Vs))
      (binding_rows_term xs) (Payload_Term r) (site_data_term du da) s (data_list_term (map Payload_Term Us))
      (data_list_term (map Payload_Term Is)) (data_list_term (map Payload_Term Ks)))\<in>positive_meaning prospective_instantiation_system"
    show "s=t" using prospective_instantiation_result_unique[OF source second first] by blast
  qed
qed

text \<open>
  The operands retain the actual source, declared scope, complete bindings,
  resolved callee use and address, substituted argument, and exact metadata.
  The body supplies table admission; the enclosing call does not repeat that
  check. Its used-variable set may be a proper subset of the declared scope.

  Counted concatenation accounts for every syntax occurrence and enforces the
  separations between the outer record, citation, and argument. Membership
  union permits shared external slots. The complete interior is disjoint from
  those slots and from the declared scope; the relative grammar permits the
  slot and variable sets themselves to overlap.

  Every complete source presentation and distinct metadata order is admitted.
  The resolved use remains distinct from the artifact value at that use.
  Location recovery does not assign a definition role or test interface
  acceptance or truth. Those checks require their own native judgments.
\<close>

end
