theory Factor_Program_Call_List
  imports "Factor_Application_Admission"
begin

section \<open>Every instantiated call retains the same actual package\<close>

abbreviation program_call_list_result :: "factor_term \<Rightarrow> bool" where
  "program_call_list_result z \<equiv> \<exists>a xs. z=Pair_Term a (data_list_term xs) \<and> term_formed a \<and>
    (\<forall>x\<in>set xs. program_call_admission_result (Pair_Term a x))"

definition program_call_list_system :: "(nat,nat,nat,nat) schema_system" where
  "program_call_list_system=add_view_definition application_admission_system 86 data_x (context_list_clauses 84 86)"

lemma program_call_list_system_formed [simp]: "schema_system_formed program_call_list_system"
  unfolding program_call_list_system_def
  by (rule add_recursive_definition_formed[OF application_admission_system_formed])
    (auto simp: context_list_clauses_def context_list_nil_schema_def context_list_step_schema_def
      schema_formed_def schema_dependencies_def single_valued_def rel_dom_def rel_ran_def octets_formed_def)

lemma program_call_list_definitions [simp]:
  "system_definitions program_call_list_system=insert 86 (system_definitions application_admission_system)"
  by (simp add: program_call_list_system_def)

lemma program_call_list_call:
  "schema_call_formed program_call_list_system d t \<longleftrightarrow>
    d\<in>system_definitions program_call_list_system \<and> term_formed t"
  using added_variable_calls[OF application_admission_system_formed
    program_call_list_system_formed[unfolded program_call_list_system_def] application_admission_call]
  by (simp only: program_call_list_system_def[symmetric])

lemma program_call_list_old_meaning:
  assumes "d\<in>system_definitions application_admission_system"
  shows "(d,t)\<in>positive_meaning program_call_list_system \<longleftrightarrow> (d,t)\<in>positive_meaning application_admission_system"
  using added_definition_preserves_old(2)[OF application_admission_system_formed
    program_call_list_system_formed[unfolded program_call_list_system_def], of d t] assms
  by (auto simp: program_call_list_system_def)

lemma program_call_list_clause [simp]:
  "((86,c),S)\<in>system_clauses program_call_list_system \<longleftrightarrow> (c,S)\<in>(context_list_clauses 84 86)"
proof -
  have owned: "((d,c),S)\<in>system_clauses application_admission_system \<Longrightarrow>
    d\<in>system_definitions application_admission_system" for d c S
    using application_admission_system_formed unfolding schema_system_formed_def by blast
  have absent: "((86,c),S)\<notin>system_clauses application_admission_system" by (auto dest: owned)
  show ?thesis using absent by (simp add: program_call_list_system_def)
qed

lemma program_call_list_previous_meaning:
  assumes "d\<in>system_definitions package_admission_system"
  shows "(d,t)\<in>positive_meaning program_call_list_system \<longleftrightarrow> (d,t)\<in>positive_meaning package_admission_system"
  using program_call_list_old_meaning[of d t] application_admission_previous_meaning[OF assms, of t] assms by auto

lemma program_call_list_element:
  "(84,t)\<in>positive_meaning program_call_list_system \<longleftrightarrow> (84,t)\<in>positive_meaning program_call_admission_system"
  using program_call_list_old_meaning[of 84 t] application_admission_old_meaning[of 84 t] by auto

interpretation program_call_list_profile: context_list_profile program_call_list_system 84 86
  by (rule context_list_profile.intro) (auto simp: program_call_list_call)

theorem program_call_list_exact:
  "(86,z)\<in>positive_meaning program_call_list_system \<longleftrightarrow> program_call_list_result z"
  by (simp only: program_call_list_profile.exact program_call_list_element program_call_admission_exact)

corollary program_call_list_at_calls:
  assumes source: "environment_value_presents E e" and package: "native_package_at E u r P"
  shows "(86,package_subject_argument e (use_data_term u) (Payload_Term r)
      (pair_list_term (map (\<lambda>(s,d,t). (definition_site_value d,t)) qs)))\<in>positive_meaning program_call_list_system
    \<longleftrightarrow> (\<forall>s d t. (s,d,t)\<in>set qs \<longrightarrow> schema_call_formed P d t)"
proof -
  have context_formed: "term_formed (source_root_argument e (use_data_term u) (Payload_Term r))"
    using schema_call_formed_target[OF positive_meaning_formed[OF package_admission_complete[OF source package]]] by auto
  have entry: "(84,package_subject_argument e (use_data_term u) (Payload_Term r) (Pair_Term (site_data_term v a) t))
      \<in>positive_meaning program_call_admission_system \<longleftrightarrow> schema_call_formed P (v,a) t" for v a t
    using program_call_admission_at_package[OF source package, of "(v,a)" t] by simp
  show ?thesis by (simp only: program_call_list_profile.lists program_call_list_element)
    (use context_formed in \<open>auto simp: entry split: prod.splits\<close>)
qed

corollary program_call_list_empty:
  "(86,Pair_Term a (Payload_Term []))\<in>positive_meaning program_call_list_system \<longleftrightarrow> term_formed a"
  using program_call_list_profile.lists[of a "[]"] by simp

text \<open>
  The existing context-carrying list clauses check every callee and operand
  against the same actual package. Operands may be any formed terms,
  including literal targets; no data-only list recognizer restricts them.
  Repeated equal calls remain separate list occurrences.

  The standalone empty case admits any formed context. The complete instance
  entry separately admits its head call and package even when this list is
  empty. Its original socket rows remain present before the value projection.
\<close>

end
