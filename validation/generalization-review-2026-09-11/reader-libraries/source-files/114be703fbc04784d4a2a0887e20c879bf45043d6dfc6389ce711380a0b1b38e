theory Factor_Admission_Pair_Reasoning
  imports "Factor_Admission_Plan_Exact" "Factor_Learned_Investigation"
begin

section \<open>A reusable construction argument becomes a conditional rule\<close>

definition admission_direct_pair_head where
  "admission_direct_pair_head pair payload a b n=
    (let nil=payload []; goal=pair (payload [1])
        (pair (pair (payload [0]) a) (pair (payload [0]) b));
         instruction=pair n (pair a (pair b nil))
     in pair (pair goal n) (pair n (pair (pair nil n) (pair instruction nil))))"

lemma admission_direct_pair_counter_encoding:
  "admission_direct_pair_head Pair_Term Payload_Term
      (admission_counter a) (admission_counter b) (admission_counter n)=
    admission_plan_argument
      (admission_goal_value (Paired_Admission (Existing_Admission a) (Existing_Admission b)))
      (admission_counter n) (admission_counter n) (admission_counter (Suc n))
      (data_list_term (map admission_instruction_value [Pair_Admission_Instruction n a b]))"
  by (simp add: admission_direct_pair_head_def Let_def)

lemma admission_direct_pair_counters_native:
  "(341,admission_direct_pair_head Pair_Term Payload_Term
    (admission_counter a) (admission_counter b) (admission_counter n))
      \<in>positive_meaning admission_plan_system"
proof -
  have plan: "admission_plan (Paired_Admission (Existing_Admission a) (Existing_Admission b)) n=
      (n,Suc n,[Pair_Admission_Instruction n a b])" by simp
  show ?thesis unfolding admission_direct_pair_counter_encoding
    by (rule admission_plan_complete[OF plan])
qed

definition admission_direct_pair_schema :: "(nat,nat,nat) factor_schema" where
  "admission_direct_pair_schema=data_rule
    (admission_direct_pair_head Pattern_Pair Pattern_Payload data_x data_y data_z)
    {(0,340,data_x),(1,340,data_y),(2,340,data_z)}"

lemma admission_direct_pair_schema_formed [simp]: "schema_formed admission_direct_pair_schema"
  by (auto simp: admission_direct_pair_schema_def admission_direct_pair_head_def Let_def
    schema_formed_def single_valued_def octets_formed_def)

theorem admission_direct_pair_rule_sound:
  assumes rule: "schema_rule_instance admission_direct_pair_schema (positive_meaning admission_plan_system) t"
  shows "(341,t)\<in>positive_meaning admission_plan_system"
proof -
  obtain h where head: "t=evaluate_pattern h (schema_conclusion admission_direct_pair_schema)"
    and support: "\<forall>s e p. (s,e,p)\<in>schema_premises admission_direct_pair_schema \<longrightarrow>
      (e,evaluate_pattern h p)\<in>positive_meaning admission_plan_system"
    using rule by (simp only: schema_rule_instance_valuation; blast)
  have counters: "(340,h 0)\<in>positive_meaning admission_plan_system"
    "(340,h 1)\<in>positive_meaning admission_plan_system"
    "(340,h 2)\<in>positive_meaning admission_plan_system"
    using support by (auto simp: admission_direct_pair_schema_def)
  obtain a b n where fields: "h 0=admission_counter a" "h 1=admission_counter b" "h 2=admission_counter n"
    using counters by (simp only: admission_plan_counter_exact; blast)
  have successor_one: "h (Suc 0)=admission_counter b"
    using fields(2) by (simp only: One_nat_def)
  show ?thesis using admission_direct_pair_counters_native[of a b n]
    by (simp add: head fields successor_one admission_direct_pair_schema_def
      admission_direct_pair_head_def Let_def)
qed

lemma admission_direct_pair_library_sound:
  "inference_sound (\<lambda>q. q\<in>positive_meaning admission_plan_system)
    (learned_schema_inferences {(341,admission_direct_pair_schema)})"
  by (rule learned_schema_inferences_sound)
    (auto intro: admission_direct_pair_rule_sound)

section \<open>The same rule constructs future applications in the evaluator\<close>

definition finite_admission_direct_pair_schema :: "(nat,nat,nat) finite_factor_schema" where
  "finite_admission_direct_pair_schema=\<lparr>
    finite_schema_conclusion=admission_direct_pair_head Finite_Pattern_Pair Finite_Pattern_Payload
      (Finite_Variable 0) (Finite_Variable 1) (Finite_Variable 2),
    finite_schema_premises=fset_of_list [(0,340,Finite_Variable 0),
      (1,340,Finite_Variable 1),(2,340,Finite_Variable 2)],
    finite_schema_materials={||}\<rparr>"

lemma finite_admission_direct_pair_schema_exact:
  "decode_finite_schema finite_admission_direct_pair_schema=admission_direct_pair_schema"
  by (simp add: finite_admission_direct_pair_schema_def admission_direct_pair_schema_def
    admission_direct_pair_head_def Let_def decode_finite_schema_def decode_finite_call_pattern_def
    map_relation_values_def; auto)

lemma decode_admission_direct_pair_head:
  "decode_finite_term (admission_direct_pair_head Finite_Pair Finite_Payload a b n)=
    admission_direct_pair_head Pair_Term Payload_Term
      (decode_finite_term a) (decode_finite_term b) (decode_finite_term n)"
  by (simp add: admission_direct_pair_head_def Let_def)

fun finite_admission_counter :: "nat \<Rightarrow> finite_factor_term" where
  "finite_admission_counter 0=Finite_Payload []"
| "finite_admission_counter (Suc n)=Finite_Pair (Finite_Payload []) (finite_admission_counter n)"

lemma finite_admission_counter_exact [simp]:
  "decode_finite_term (finite_admission_counter n)=admission_counter n"
  by (induction n) auto

definition admission_pair_reasoning_library where
  "admission_pair_reasoning_library=[(341,finite_admission_direct_pair_schema,
    [(0,340,Finite_Variable 0),(1,340,Finite_Variable 1),(2,340,Finite_Variable 2)])]"

definition admission_pair_reasoning_frontier :: "(nat\<times>finite_factor_term) list" where
  "admission_pair_reasoning_frontier=map (\<lambda>n. (340,finite_admission_counter n)) [0,1,2]"

definition admission_pair_reasoning_goal where
  "admission_pair_reasoning_goal=admission_direct_pair_head Finite_Pair Finite_Payload
    (finite_admission_counter 0) (finite_admission_counter 1) (finite_admission_counter 2)"

definition admission_pair_reasoning_experiment where
  "admission_pair_reasoning_experiment (stage::nat)=finite_learned_investigation
    (if stage=0 then [] else admission_pair_reasoning_library)
    admission_pair_reasoning_frontier
    (fset_of_list (if stage=1 then take 2 admission_pair_reasoning_frontier else admission_pair_reasoning_frontier))
    {|(0::nat,(341,admission_pair_reasoning_goal))|}"

export_code admission_plan admission_pair_reasoning_experiment
  finite_generated_schema_applications finite_generated_schema_rules finite_learned_investigation
  nat_of_integer integer_of_nat
  in SML module_name Native_Learned_Reasoning file_prefix native_learned_reasoning

text \<open>
  Pairing two already named admission predicates repeatedly required the same
  two leaf plans, allocation, and list concatenations. The condensed argument
  now supplies a schema over the actual counter predicate. Its conclusion
  constructs the complete plan; the three counter premises remain explicit.
  The theorem proves every application is a call of the original native
  planner. The finite schema is proved to decode to that very rule.

  The experiment first lacks the rule, then has the rule but lacks one known
  premise, then supplies all three known premises. The possible premise
  frontier is unchanged. No concrete conclusion is inserted into the rule
  input. The explicit goal is a question posed to the generated inference
  family. An executable run and independent checks are required to assess
  these cases. The mathematical justification above has not yet been admitted
  by a native checker for inductive mathematical proofs.
\<close>

end
