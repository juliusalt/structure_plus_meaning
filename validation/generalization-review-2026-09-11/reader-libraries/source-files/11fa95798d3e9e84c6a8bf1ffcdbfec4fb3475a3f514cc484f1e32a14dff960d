theory Factor_Material_Instantiation
  imports "Factor_Record_Instantiation"
begin

section \<open>The five ordinary operands of the existing material record\<close>

lemma material_pattern_field_instances:
  "list_all2 (pattern_instance B) (material_fields M) [s,a,e,b,f] \<longleftrightarrow>
    material_pattern_instance B M s a e b f"
  by (simp add: material_fields_def material_pattern_instance_def)

lemma material_fields_complete:
  assumes "length ps=5"
  shows "\<exists>M. material_fields M=ps"
proof -
  have expanded: "length ps=Suc (Suc (Suc (Suc (Suc 0))))" using assms by simp
  obtain s a e b f where fields: "ps=[s,a,e,b,f]"
    using expanded by (auto simp only: length_Suc_conv length_0_conv)
  show ?thesis
    by (rule exI[of _ "\<lparr>material_source=s,material_atoms=a,material_edges=e,material_counts=b,material_functions=f\<rparr>"])
      (simp add: fields material_fields_def)
qed

abbreviation material_instantiation_argument ::
  "factor_term \<Rightarrow> factor_term \<Rightarrow> factor_term \<Rightarrow> factor_term \<Rightarrow>
    factor_term \<Rightarrow> factor_term \<Rightarrow> factor_term \<Rightarrow> factor_term \<Rightarrow>
    factor_term \<Rightarrow> factor_term \<Rightarrow> factor_term \<Rightarrow> factor_term \<Rightarrow>
    factor_term \<Rightarrow> factor_term" where
  "material_instantiation_argument e u v b r s a d c f w i k \<equiv>
    pattern_instantiation_argument e u v b r (material_tuple s a d c f) w i k"

abbreviation material_instantiation_pattern ::
  "'a term_pattern \<Rightarrow> 'a term_pattern \<Rightarrow> 'a term_pattern \<Rightarrow> 'a term_pattern \<Rightarrow>
    'a term_pattern \<Rightarrow> 'a term_pattern \<Rightarrow> 'a term_pattern \<Rightarrow> 'a term_pattern \<Rightarrow>
    'a term_pattern \<Rightarrow> 'a term_pattern \<Rightarrow> 'a term_pattern \<Rightarrow> 'a term_pattern \<Rightarrow>
    'a term_pattern \<Rightarrow> 'a term_pattern" where
  "material_instantiation_pattern e u v b r s a d c f w i k \<equiv>
    pattern_instantiation_pattern e u v b r
      (Pattern_Pair s (Pattern_Pair a (Pattern_Pair d (Pattern_Pair c f)))) w i k"

abbreviation material_instantiation_result :: "factor_term \<Rightarrow> bool" where
  "material_instantiation_result z \<equiv> \<exists>E e u Vs xs r M s a d c f Us Is Ks.
    z=material_instantiation_argument e (use_data_term u) (data_list_term (map Payload_Term Vs)) (binding_rows_term xs)
      (Payload_Term r) s a d c f (data_list_term (map Payload_Term Us))
      (data_list_term (map Payload_Term Is)) (data_list_term (map Payload_Term Ks)) \<and>
    environment_value_presents E e \<and> distinct Vs \<and> distinct xs \<and> (\<forall>x\<in>set Vs. octets_formed x) \<and>
    term_bindings_formed (set Vs) (set xs) \<and> distinct Us \<and> distinct Is \<and> distinct Ks \<and>
    native_material_at E u (set Vs) r M (set Is) (set Ks) \<and> material_variables M=set Us \<and>
    material_pattern_instance (set xs) M s a d c f"

definition material_instantiation_schema :: "(nat,nat,nat) factor_schema" where
  "material_instantiation_schema=data_rule
    (material_instantiation_pattern data_x data_y data_z data_w (Pattern_Variable 4) (Pattern_Variable 5)
      (Pattern_Variable 6) (Pattern_Variable 7) (Pattern_Variable 8) (Pattern_Variable 9)
      (Pattern_Variable 10) (Pattern_Variable 11) (Pattern_Variable 12))
    {(0,61,pattern_instantiation_pattern data_x data_y data_z data_w (Pattern_Variable 4)
      (data_list_pattern [Pattern_Variable 5,Pattern_Variable 6,Pattern_Variable 7,Pattern_Variable 8,Pattern_Variable 9])
      (Pattern_Variable 10) (Pattern_Variable 11) (Pattern_Variable 12))}"

definition material_instantiation_system :: "(nat,nat,nat,nat) schema_system" where
  "material_instantiation_system=add_view_definition record_instantiation_system 62 data_x {(0,material_instantiation_schema)}"

lemma material_instantiation_system_formed [simp]: "schema_system_formed material_instantiation_system"
  unfolding material_instantiation_system_def
  by (rule add_recursive_definition_formed[OF record_instantiation_system_formed])
    (auto simp: material_instantiation_schema_def
      schema_formed_def schema_dependencies_def single_valued_def rel_dom_def rel_ran_def octets_formed_def)

lemma material_instantiation_definitions [simp]:
  "system_definitions material_instantiation_system=insert 62 (system_definitions record_instantiation_system)"
  by (simp add: material_instantiation_system_def)

lemma material_instantiation_call:
  "schema_call_formed material_instantiation_system d t \<longleftrightarrow>
    d\<in>system_definitions material_instantiation_system \<and> term_formed t"
  using added_variable_calls[OF record_instantiation_system_formed
    material_instantiation_system_formed[unfolded material_instantiation_system_def] record_instantiation_call]
  by (simp only: material_instantiation_system_def[symmetric])

lemma material_instantiation_old_meaning:
  assumes "d\<in>system_definitions record_instantiation_system"
  shows "(d,t)\<in>positive_meaning material_instantiation_system \<longleftrightarrow>
    (d,t)\<in>positive_meaning record_instantiation_system"
  using added_definition_preserves_old(2)[OF record_instantiation_system_formed
    material_instantiation_system_formed[unfolded material_instantiation_system_def], of d t] assms
  by (auto simp: material_instantiation_system_def)

lemma material_instantiation_clause [simp]:
  "((62,c),S)\<in>system_clauses material_instantiation_system \<longleftrightarrow> (c,S)\<in>{(0,material_instantiation_schema)}"
proof -
  have owned: "((d,c),S)\<in>system_clauses record_instantiation_system \<Longrightarrow>
    d\<in>system_definitions record_instantiation_system" for d c S
    using record_instantiation_system_formed unfolding schema_system_formed_def by blast
  have absent: "((62,c),S)\<notin>system_clauses record_instantiation_system" by (auto dest: owned)
  show ?thesis using absent by (simp add: material_instantiation_system_def)
qed

lemma material_instantiation_previous_entry:
  "(61,t)\<in>positive_meaning material_instantiation_system \<longleftrightarrow>
    (61,t)\<in>positive_meaning record_instantiation_system"
  by (rule material_instantiation_old_meaning) simp

lemma material_instantiation_step:
  assumes child: "(61,pattern_instantiation_argument e u v b r (data_list_term [s,a,d,c,f]) w i k)
    \<in>positive_meaning record_instantiation_system"
  shows "(62,material_instantiation_argument e u v b r s a d c f w i k)\<in>positive_meaning material_instantiation_system"
proof -
  have formed: "term_formed e" "term_formed u" "term_formed v" "term_formed b" "term_formed r"
    "term_formed s" "term_formed a" "term_formed d" "term_formed c" "term_formed f"
    "term_formed w" "term_formed i" "term_formed k"
    using schema_call_formed_target[OF positive_meaning_formed[OF child]] by auto
  let ?h="\<lambda>n::nat. if n=0 then e else if n=1 then u else if n=2 then v else if n=3 then b
    else if n=4 then r else if n=5 then s else if n=6 then a else if n=7 then d
    else if n=8 then c else if n=9 then f else if n=10 then w else if n=11 then i else k"
  have result: "(62,evaluate_pattern ?h (schema_conclusion material_instantiation_schema))\<in>positive_meaning material_instantiation_system"
    by (rule ordinary_positive_valuation_step[where c=0])
      (use formed child in \<open>auto simp: material_instantiation_schema_def schema_variables_def
        material_instantiation_call material_instantiation_previous_entry\<close>)
  show ?thesis using result by (simp add: material_instantiation_schema_def material_tuple_def)
qed

lemma material_instantiation_fields:
  "(62,z)\<in>positive_meaning material_instantiation_system \<longleftrightarrow>
    (\<exists>e u v b r s a d c f w i k. z=material_instantiation_argument e u v b r s a d c f w i k \<and>
      (61,pattern_instantiation_argument e u v b r (data_list_term [s,a,d,c,f]) w i k)
        \<in>positive_meaning record_instantiation_system)"
proof
  assume holds: "(62,z)\<in>positive_meaning material_instantiation_system"
  have consequence: "(62,z)\<in>schema_consequences material_instantiation_system (positive_meaning material_instantiation_system)"
    using holds positive_meaning_unfold[of material_instantiation_system] by blast
  obtain n S h where clause: "((62,n),S)\<in>system_clauses material_instantiation_system"
    and conclusion: "z=evaluate_pattern h (schema_conclusion S)"
    and support: "\<forall>x d p. (x,d,p)\<in>schema_premises S \<longrightarrow>
      (d,evaluate_pattern h p)\<in>positive_meaning material_instantiation_system"
    using schema_consequences_valuationD[OF consequence] by blast
  have schema: "S=material_instantiation_schema" using clause by simp
  have child: "(61,pattern_instantiation_argument (h 0) (h 1) (h 2) (h 3) (h 4)
      (data_list_term [h 5,h 6,h 7,h 8,h 9]) (h 10) (h 11) (h 12))\<in>positive_meaning record_instantiation_system"
    using support by (auto simp: schema material_instantiation_schema_def material_instantiation_previous_entry)
  show "\<exists>e u v b r s a d c f w i k. z=material_instantiation_argument e u v b r s a d c f w i k \<and>
      (61,pattern_instantiation_argument e u v b r (data_list_term [s,a,d,c,f]) w i k)
        \<in>positive_meaning record_instantiation_system"
    by (rule exI[of _ "h 0"], rule exI[of _ "h 1"], rule exI[of _ "h 2"], rule exI[of _ "h 3"],
      rule exI[of _ "h 4"], rule exI[of _ "h 5"], rule exI[of _ "h 6"], rule exI[of _ "h 7"],
      rule exI[of _ "h 8"], rule exI[of _ "h 9"], rule exI[of _ "h 10"], rule exI[of _ "h 11"], rule exI[of _ "h 12"])
      (use conclusion child in \<open>simp add: schema material_instantiation_schema_def material_tuple_def\<close>)
next
  assume "\<exists>e u v b r s a d c f w i k. z=material_instantiation_argument e u v b r s a d c f w i k \<and>
      (61,pattern_instantiation_argument e u v b r (data_list_term [s,a,d,c,f]) w i k)
        \<in>positive_meaning record_instantiation_system"
  then show "(62,z)\<in>positive_meaning material_instantiation_system" using material_instantiation_step by blast
qed

theorem material_instantiation_sound:
  assumes "(62,z)\<in>positive_meaning material_instantiation_system"
  shows "material_instantiation_result z"
proof -
  obtain e u v b r s a d c f w i k where shape: "z=material_instantiation_argument e u v b r s a d c f w i k"
    and child: "(61,pattern_instantiation_argument e u v b r (data_list_term [s,a,d,c,f]) w i k)
      \<in>positive_meaning record_instantiation_system"
    using assms by (simp only: material_instantiation_fields) blast
  obtain E q Vs xs l ps Us Is Ks where parts: "environment_value_presents E e"
    "u=use_data_term q" "v=data_list_term (map Payload_Term Vs)" "b=binding_rows_term xs" "r=Payload_Term l"
    "w=data_list_term (map Payload_Term Us)" "i=data_list_term (map Payload_Term Is)" "k=data_list_term (map Payload_Term Ks)"
    "distinct Vs" "distinct xs" "\<forall>x\<in>set Vs. octets_formed x" "term_bindings_formed (set Vs) (set xs)"
    "distinct Us" "distinct Is" "distinct Ks" "pattern_record_at E q (set Vs) l ps (set Is) (set Ks)"
    "pattern_forest_variables ps=set Us" "list_all2 (pattern_instance (set xs)) ps [s,a,d,c,f]"
    using child by (simp only: record_instantiation_exact factor_term.inject data_list_term_injective) blast
  have length: "length ps=5" using list_all2_lengthD[OF parts(18)] by simp
  obtain M where fields: "material_fields M=ps" using material_fields_complete[OF length] by blast
  have reading: "native_material_at E q (set Vs) l M (set Is) (set Ks)"
    using parts(16) by (simp add: native_material_at_def fields)
  have variables: "material_variables M=set Us"
    using parts(17) by (simp add: material_variables_def pattern_forest_variables_def fields)
  have inst: "material_pattern_instance (set xs) M s a d c f"
    using parts(18) by (simp only: fields[symmetric] material_pattern_field_instances)
  show ?thesis
    by (rule exI[of _ E], rule exI[of _ e], rule exI[of _ q], rule exI[of _ Vs], rule exI[of _ xs],
      rule exI[of _ l], rule exI[of _ M], rule exI[of _ s], rule exI[of _ a], rule exI[of _ d],
      rule exI[of _ c], rule exI[of _ f], rule exI[of _ Us], rule exI[of _ Is], rule exI[of _ Ks])
      (use shape parts reading variables inst in auto)
qed

theorem material_instantiation_complete:
  assumes source: "environment_value_presents E e"
    and table: "(52,Pair_Term (data_list_term (map Payload_Term Vs)) (binding_rows_term xs))\<in>positive_meaning binding_admission_system"
    and reading: "native_material_at E u (set Vs) r M (set Is) (set Ks)"
    and order: "distinct Us" "distinct Is" "distinct Ks"
    and used: "set Us=material_variables M" and inst: "material_pattern_instance (set xs) M s a d c f"
  shows "(62,material_instantiation_argument e (use_data_term u) (data_list_term (map Payload_Term Vs))
      (binding_rows_term xs) (Payload_Term r) s a d c f (data_list_term (map Payload_Term Us))
      (data_list_term (map Payload_Term Is)) (data_list_term (map Payload_Term Ks)))\<in>positive_meaning material_instantiation_system"
proof -
  have rec: "pattern_record_at E u (set Vs) r (material_fields M) (set Is) (set Ks)"
    using reading by (simp add: native_material_at_def)
  have variables: "set Us=pattern_forest_variables (material_fields M)"
    using used by (simp add: material_variables_def pattern_forest_variables_def)
  have instances: "list_all2 (pattern_instance (set xs)) (material_fields M) [s,a,d,c,f]"
    using inst by (simp only: material_pattern_field_instances)
  have child: "(61,pattern_instantiation_argument e (use_data_term u) (data_list_term (map Payload_Term Vs))
      (binding_rows_term xs) (Payload_Term r) (data_list_term [s,a,d,c,f]) (data_list_term (map Payload_Term Us))
      (data_list_term (map Payload_Term Is)) (data_list_term (map Payload_Term Ks)))\<in>positive_meaning record_instantiation_system"
    by (rule record_instantiation_complete[OF source table rec order variables instances])
  show ?thesis by (rule material_instantiation_step[OF child])
qed

theorem material_instantiation_exact:
  "(62,z)\<in>positive_meaning material_instantiation_system \<longleftrightarrow> material_instantiation_result z"
proof
  show "(62,z)\<in>positive_meaning material_instantiation_system \<Longrightarrow> material_instantiation_result z"
    by (rule material_instantiation_sound)
next
  assume admitted: "material_instantiation_result z"
  obtain E e u Vs xs r M s a d c f Us Is Ks where parts:
    "z=material_instantiation_argument e (use_data_term u) (data_list_term (map Payload_Term Vs))
      (binding_rows_term xs) (Payload_Term r) s a d c f (data_list_term (map Payload_Term Us))
      (data_list_term (map Payload_Term Is)) (data_list_term (map Payload_Term Ks))"
    "environment_value_presents E e" "distinct Vs" "distinct xs" "\<forall>x\<in>set Vs. octets_formed x"
    "term_bindings_formed (set Vs) (set xs)" "distinct Us" "distinct Is" "distinct Ks"
    "native_material_at E u (set Vs) r M (set Is) (set Ks)" "material_variables M=set Us"
    "material_pattern_instance (set xs) M s a d c f" using admitted by blast
  have table: "(52,Pair_Term (data_list_term (map Payload_Term Vs)) (binding_rows_term xs))
      \<in>positive_meaning binding_admission_system"
    by (simp only: binding_admission_on_values) (use parts(3-6) in blast)
  show "(62,z)\<in>positive_meaning material_instantiation_system"
    using material_instantiation_complete[OF parts(2) table parts(10,7-9) parts(11)[symmetric] parts(12)]
    by (simp only: parts(1))
qed

lemma material_instantiation_result_at_source:
  assumes source: "environment_value_presents E e"
  shows "material_instantiation_result (material_instantiation_argument e u v b r s a d c f w i k) \<longleftrightarrow>
    (\<exists>q Vs xs l M Us Is Ks. u=use_data_term q \<and> v=data_list_term (map Payload_Term Vs) \<and>
      b=binding_rows_term xs \<and> r=Payload_Term l \<and> w=data_list_term (map Payload_Term Us) \<and>
      i=data_list_term (map Payload_Term Is) \<and> k=data_list_term (map Payload_Term Ks) \<and>
      distinct Vs \<and> distinct xs \<and> (\<forall>a\<in>set Vs. octets_formed a) \<and> term_bindings_formed (set Vs) (set xs) \<and>
      distinct Us \<and> distinct Is \<and> distinct Ks \<and> native_material_at E q (set Vs) l M (set Is) (set Ks) \<and>
      material_variables M=set Us \<and> material_pattern_instance (set xs) M s a d c f)"
proof
  assume admitted: "material_instantiation_result (material_instantiation_argument e u v b r s a d c f w i k)"
  obtain F q Vs xs l M Us Is Ks where parts: "environment_value_presents F e"
    "u=use_data_term q" "v=data_list_term (map Payload_Term Vs)" "b=binding_rows_term xs" "r=Payload_Term l"
    "w=data_list_term (map Payload_Term Us)" "i=data_list_term (map Payload_Term Is)" "k=data_list_term (map Payload_Term Ks)"
    "distinct Vs" "distinct xs" "\<forall>a\<in>set Vs. octets_formed a" "term_bindings_formed (set Vs) (set xs)"
    "distinct Us" "distinct Is" "distinct Ks" "native_material_at F q (set Vs) l M (set Is) (set Ks)"
    "material_variables M=set Us" "material_pattern_instance (set xs) M s a d c f"
    using admitted by (simp only: material_tuple_def factor_term.inject) blast
  have same: "F=E" by (rule environment_value_presents_unique[OF parts(1) source])
  show "\<exists>q Vs xs l M Us Is Ks. u=use_data_term q \<and> v=data_list_term (map Payload_Term Vs) \<and>
      b=binding_rows_term xs \<and> r=Payload_Term l \<and> w=data_list_term (map Payload_Term Us) \<and>
      i=data_list_term (map Payload_Term Is) \<and> k=data_list_term (map Payload_Term Ks) \<and>
      distinct Vs \<and> distinct xs \<and> (\<forall>a\<in>set Vs. octets_formed a) \<and> term_bindings_formed (set Vs) (set xs) \<and>
      distinct Us \<and> distinct Is \<and> distinct Ks \<and> native_material_at E q (set Vs) l M (set Is) (set Ks) \<and>
      material_variables M=set Us \<and> material_pattern_instance (set xs) M s a d c f"
    by (rule exI[of _ q], rule exI[of _ Vs], rule exI[of _ xs], rule exI[of _ l], rule exI[of _ M],
      rule exI[of _ Us], rule exI[of _ Is], rule exI[of _ Ks]) (use parts same in auto)
next
  assume "\<exists>q Vs xs l M Us Is Ks. u=use_data_term q \<and> v=data_list_term (map Payload_Term Vs) \<and>
      b=binding_rows_term xs \<and> r=Payload_Term l \<and> w=data_list_term (map Payload_Term Us) \<and>
      i=data_list_term (map Payload_Term Is) \<and> k=data_list_term (map Payload_Term Ks) \<and>
      distinct Vs \<and> distinct xs \<and> (\<forall>a\<in>set Vs. octets_formed a) \<and> term_bindings_formed (set Vs) (set xs) \<and>
      distinct Us \<and> distinct Is \<and> distinct Ks \<and> native_material_at E q (set Vs) l M (set Is) (set Ks) \<and>
      material_variables M=set Us \<and> material_pattern_instance (set xs) M s a d c f"
  then obtain q Vs xs l M Us Is Ks where parts:
    "u=use_data_term q" "v=data_list_term (map Payload_Term Vs)" "b=binding_rows_term xs" "r=Payload_Term l"
    "w=data_list_term (map Payload_Term Us)" "i=data_list_term (map Payload_Term Is)" "k=data_list_term (map Payload_Term Ks)"
    "distinct Vs" "distinct xs" "\<forall>a\<in>set Vs. octets_formed a" "term_bindings_formed (set Vs) (set xs)"
    "distinct Us" "distinct Is" "distinct Ks" "native_material_at E q (set Vs) l M (set Is) (set Ks)"
    "material_variables M=set Us" "material_pattern_instance (set xs) M s a d c f" by blast
  show "material_instantiation_result (material_instantiation_argument e u v b r s a d c f w i k)"
    by (rule exI[of _ E], rule exI[of _ e], rule exI[of _ q], rule exI[of _ Vs], rule exI[of _ xs],
      rule exI[of _ l], rule exI[of _ M], rule exI[of _ s], rule exI[of _ a], rule exI[of _ d], rule exI[of _ c], rule exI[of _ f], rule exI[of _ Us], rule exI[of _ Is], rule exI[of _ Ks])
      (use parts source in auto)
qed

corollary material_instantiation_at_source:
  assumes source: "environment_value_presents E e"
  shows "(62,material_instantiation_argument e u v b r s a d c f w i k)\<in>positive_meaning material_instantiation_system \<longleftrightarrow>
    (\<exists>q Vs xs l M Us Is Ks. u=use_data_term q \<and> v=data_list_term (map Payload_Term Vs) \<and>
      b=binding_rows_term xs \<and> r=Payload_Term l \<and> w=data_list_term (map Payload_Term Us) \<and>
      i=data_list_term (map Payload_Term Is) \<and> k=data_list_term (map Payload_Term Ks) \<and>
      distinct Vs \<and> distinct xs \<and> (\<forall>x\<in>set Vs. octets_formed x) \<and> term_bindings_formed (set Vs) (set xs) \<and>
      distinct Us \<and> distinct Is \<and> distinct Ks \<and> native_material_at E q (set Vs) l M (set Is) (set Ks) \<and>
      material_variables M=set Us \<and> material_pattern_instance (set xs) M s a d c f)"
  by (simp only: material_instantiation_exact material_instantiation_result_at_source[OF source])

corollary material_instantiation_on_values:
  assumes source: "environment_value_presents E e"
  shows "(62,material_instantiation_argument e (use_data_term u) (data_list_term (map Payload_Term Vs))
      (binding_rows_term xs) (Payload_Term r) s a d c f (data_list_term (map Payload_Term Us))
      (data_list_term (map Payload_Term Is)) (data_list_term (map Payload_Term Ks)))\<in>positive_meaning material_instantiation_system
      \<longleftrightarrow>
    distinct Vs \<and> distinct xs \<and> (\<forall>x\<in>set Vs. octets_formed x) \<and> term_bindings_formed (set Vs) (set xs) \<and>
    distinct Us \<and> distinct Is \<and> distinct Ks \<and>
    (\<exists>M. native_material_at E u (set Vs) r M (set Is) (set Ks) \<and> material_variables M=set Us \<and>
      material_pattern_instance (set xs) M s a d c f)"
  by (subst material_instantiation_at_source[OF source],
    simp only: binding_rows_term_injective inj_eq[OF use_data_term_injective] factor_term.inject)
    (auto simp: data_list_term_injective injective_mapped_lists[OF payload_term_inj])

corollary material_instantiation_presentation_invariance:
  assumes "environment_value_presents E e" "environment_value_presents E g"
  shows "(62,material_instantiation_argument e u v b r s a d c f w i k)\<in>positive_meaning material_instantiation_system \<longleftrightarrow>
    (62,material_instantiation_argument g u v b r s a d c f w i k)\<in>positive_meaning material_instantiation_system"
  by (simp only: material_instantiation_at_source[OF assms(1)] material_instantiation_at_source[OF assms(2)])

corollary material_instantiation_orders:
  assumes source: "environment_value_presents E e"
    and same: "mset Vs=mset Ws" "mset xs=mset ys" "mset Us=mset Zs" "mset Is=mset Js" "mset Ks=mset Ls"
  shows "(62,material_instantiation_argument e (use_data_term u) (data_list_term (map Payload_Term Vs))
      (binding_rows_term xs) (Payload_Term r) s a d c f (data_list_term (map Payload_Term Us))
      (data_list_term (map Payload_Term Is)) (data_list_term (map Payload_Term Ks)))\<in>positive_meaning material_instantiation_system
      \<longleftrightarrow>
    (62,material_instantiation_argument e (use_data_term u) (data_list_term (map Payload_Term Ws))
      (binding_rows_term ys) (Payload_Term r) s a d c f (data_list_term (map Payload_Term Zs))
      (data_list_term (map Payload_Term Js)) (data_list_term (map Payload_Term Ls)))\<in>positive_meaning material_instantiation_system"
  using mset_eq_imp_distinct_iff[OF same(1)] mset_eq_imp_distinct_iff[OF same(2)]
    mset_eq_imp_distinct_iff[OF same(3)] mset_eq_imp_distinct_iff[OF same(4)] mset_eq_imp_distinct_iff[OF same(5)]
    mset_eq_setD[OF same(1)] mset_eq_setD[OF same(2)] mset_eq_setD[OF same(3)] mset_eq_setD[OF same(4)] mset_eq_setD[OF same(5)]
  by (simp only: material_instantiation_on_values[OF source])

corollary material_instantiation_result_unique:
  assumes source: "environment_value_presents E e"
    and first: "(62,material_instantiation_argument e (use_data_term u) (data_list_term (map Payload_Term Vs))
      (binding_rows_term xs) (Payload_Term r) s a d c f (data_list_term (map Payload_Term Us))
      (data_list_term (map Payload_Term Is)) (data_list_term (map Payload_Term Ks)))\<in>positive_meaning material_instantiation_system"
    and second: "(62,material_instantiation_argument e (use_data_term u) (data_list_term (map Payload_Term Vs))
      (binding_rows_term xs) (Payload_Term r) s' a' d' c' f' (data_list_term (map Payload_Term Ws))
      (data_list_term (map Payload_Term Js)) (data_list_term (map Payload_Term Ls)))\<in>positive_meaning material_instantiation_system"
  shows "(s,a,d,c,f)=(s',a',d',c',f') \<and> mset Us=mset Ws \<and> mset Is=mset Js \<and> mset Ks=mset Ls"
proof -
  obtain M where left: "term_bindings_formed (set Vs) (set xs)" "distinct Us" "distinct Is" "distinct Ks"
    "native_material_at E u (set Vs) r M (set Is) (set Ks)" "material_variables M=set Us"
    "material_pattern_instance (set xs) M s a d c f"
    using first by (simp only: material_instantiation_on_values[OF source]) blast
  obtain N where right: "distinct Ws" "distinct Js" "distinct Ls"
    "native_material_at E u (set Vs) r N (set Js) (set Ls)" "material_variables N=set Ws"
    "material_pattern_instance (set xs) N s' a' d' c' f'"
    using second by (simp only: material_instantiation_on_values[OF source]) blast
  have same: "M=N" "set Is=set Js" "set Ks=set Ls" using native_material_unique[OF left(5) right(4)] by auto
  have variables: "set Us=set Ws" using same(1) left(6) right(5) by simp
  have single: "single_valued (set xs)" using left(1) by (simp add: term_bindings_formed_def)
  have other: "material_pattern_instance (set xs) M s' a' d' c' f'" using same(1) right(6) by simp
  have terms: "(s,a,d,c,f)=(s',a',d',c',f')" by (rule material_pattern_instance_unique[OF single left(7) other])
  show ?thesis using terms variables same(2,3) left(2-4) right(1-3)
    distinct_source_mset[OF left(2), of Ws] distinct_source_mset[OF left(3), of Js] distinct_source_mset[OF left(4), of Ls] by auto
qed

theorem material_instantiation_total:
  assumes source: "environment_value_presents E e"
    and table: "(52,Pair_Term (data_list_term (map Payload_Term Vs)) (binding_rows_term xs))\<in>positive_meaning binding_admission_system"
    and reading: "native_material_at E u (set Vs) r M (set Is) (set Ks)"
    and order: "distinct Us" "distinct Is" "distinct Ks" and used: "set Us=material_variables M"
  shows "\<exists>s a d c f. (62,material_instantiation_argument e (use_data_term u) (data_list_term (map Payload_Term Vs))
      (binding_rows_term xs) (Payload_Term r) s a d c f (data_list_term (map Payload_Term Us))
      (data_list_term (map Payload_Term Is)) (data_list_term (map Payload_Term Ks)))\<in>positive_meaning material_instantiation_system"
proof -
  have formed: "material_pattern_formed M" and scope: "material_variables M\<subseteq>set Vs"
    using native_material_formed[OF reading] by auto
  have domain: "rel_dom (set xs)=set Vs"
    using table by (simp only: binding_admission_on_values) (auto simp: term_bindings_formed_def)
  obtain s a d c f where inst: "material_pattern_instance (set xs) M s a d c f"
    using material_pattern_instance_exists[OF formed, where V="set xs"] scope domain by blast
  show ?thesis using material_instantiation_complete[OF source table reading order used inst] by blast
qed

section \<open>One fixed native program before every future operand\<close>

abbreviation field_instantiation_operation_result :: "nat \<Rightarrow> factor_term \<Rightarrow> bool" where
  "field_instantiation_operation_result d t \<equiv>
    (d=59 \<and> (\<exists>xs. t=Pair_Term (pair_list_term xs) (data_list_term (map snd xs)) \<and> term_formed (pair_list_term xs))) \<or>
    (d=60 \<and> vector_instantiation_result t) \<or> (d=61 \<and> record_instantiation_result t) \<or>
    (d=62 \<and> material_instantiation_result t)"

lemma field_instantiation_operations_exact:
  assumes "d\<in>{59,60,61,62}"
  shows "(d,t)\<in>positive_meaning material_instantiation_system \<longleftrightarrow> field_instantiation_operation_result d t"
proof -
  consider (rows) "d=59" | (vector) "d=60" | (rec) "d=61" | (material) "d=62"
    using assms by auto
  then show ?thesis
  proof cases
    case rows
    have meaning: "(59,t)\<in>positive_meaning material_instantiation_system \<longleftrightarrow>
      (59,t)\<in>positive_meaning row_values_system"
      using material_instantiation_old_meaning[of 59 t] record_instantiation_old_meaning[of 59 t]
        vector_instantiation_old_meaning[of 59 t] by auto
    show ?thesis by (simp add: rows meaning row_values_exact)
  next
    case vector
    have meaning: "(60,t)\<in>positive_meaning material_instantiation_system \<longleftrightarrow>
      (60,t)\<in>positive_meaning vector_instantiation_system"
      using material_instantiation_old_meaning[of 60 t] record_instantiation_old_meaning[of 60 t] by auto
    show ?thesis by (simp add: vector meaning vector_instantiation_exact)
  next
    case rec
    show ?thesis by (simp add: rec material_instantiation_previous_entry record_instantiation_exact)
  next
    case material
    show ?thesis by (simp add: material material_instantiation_exact)
  qed
qed

theorem native_field_instantiation_operations:
  "\<exists>E :: local_address option artifact_environment. \<exists>pu Q g.
    closed_native_package_at E pu [] Q \<and> inj_on g {59::nat,60,61,62} \<and>
    (\<forall>d\<in>{59,60,61,62}. \<forall>t. term_formed t \<longrightarrow>
      (\<exists>F au I K. environment_formed F \<and> environment_included E F \<and> au\<notin>environment_uses E \<and>
        native_package_at F pu [] Q \<and> native_application_at F au [] (g d) t I K \<and>
        native_package_environment F pu []=E \<and> native_application_formed F pu [] au [] \<and>
        (native_positive_holds F pu [] au [] \<longleftrightarrow> field_instantiation_operation_result d t)))"
proof -
  obtain g :: "nat \<Rightarrow> local_address option definition_site"
    and E :: "local_address option artifact_environment" and pu Q
    where injective: "inj_on g (system_definitions material_instantiation_system)"
    and closed: "closed_native_package_at E pu [] Q"
    and future: "\<forall>d\<in>system_definitions material_instantiation_system. \<forall>t. term_formed t \<longrightarrow>
      (\<exists>F au I K. environment_formed F \<and> environment_included E F \<and> au\<notin>environment_uses E \<and>
        native_package_at F pu [] Q \<and> native_application_at F au [] (g d) t I K \<and>
        native_package_environment F pu []=E \<and>
        (native_application_formed F pu [] au [] \<longleftrightarrow> schema_call_formed material_instantiation_system d t) \<and>
        (native_positive_holds F pu [] au [] \<longleftrightarrow> (d,t)\<in>positive_meaning material_instantiation_system) \<and>
        (\<forall>v\<in>environment_uses E. \<forall>R. artifact_at F v R \<longleftrightarrow> artifact_at E v R) \<and>
        (\<forall>v\<in>environment_uses E. \<forall>k w. binds_slot F v k w \<longleftrightarrow> binds_slot E v k w))"
    using compiled_program_future_applications[OF material_instantiation_system_formed] by blast
  have sites: "inj_on g {59,60,61,62}" by (rule inj_on_subset[OF injective]) auto
  show ?thesis
  proof (rule exI[of _ E], rule exI[of _ pu], rule exI[of _ Q], rule exI[of _ g], intro conjI ballI allI impI)
    show "closed_native_package_at E pu [] Q" by (rule closed)
    show "inj_on g {59,60,61,62}" by (rule sites)
  next
    fix d :: nat and t :: factor_term
    assume selected: "d\<in>{59,60,61,62}" and tf: "term_formed t"
    have member: "d\<in>system_definitions material_instantiation_system" using selected by auto
    obtain F au I K where parts: "environment_formed F" "environment_included E F" "au\<notin>environment_uses E"
      "native_package_at F pu [] Q" "native_application_at F au [] (g d) t I K"
      "native_package_environment F pu []=E"
      "native_application_formed F pu [] au [] \<longleftrightarrow> schema_call_formed material_instantiation_system d t"
      "native_positive_holds F pu [] au [] \<longleftrightarrow> (d,t)\<in>positive_meaning material_instantiation_system"
      using future[rule_format, OF member tf] by blast
    show "\<exists>F au I K. environment_formed F \<and> environment_included E F \<and> au\<notin>environment_uses E \<and>
      native_package_at F pu [] Q \<and> native_application_at F au [] (g d) t I K \<and>
      native_package_environment F pu []=E \<and> native_application_formed F pu [] au [] \<and>
      (native_positive_holds F pu [] au [] \<longleftrightarrow> field_instantiation_operation_result d t)"
      by (rule exI[of _ F], rule exI[of _ au], rule exI[of _ I], rule exI[of _ K])
        (use parts tf member field_instantiation_operations_exact[OF selected] in \<open>auto simp: material_instantiation_call\<close>)
  qed
qed

