theory Factor_Located_List
  imports "Factor_Package_Closure_Admission"
begin

section \<open>Every supplied pair is located in the same actual source\<close>

abbreviation located_list_result :: "factor_term \<Rightarrow> bool" where
  "located_list_result z \<equiv> \<exists>a xs. z=Pair_Term a (data_list_term xs) \<and> term_formed a \<and>
    (\<forall>x\<in>set xs. anchored_checking_result 44 (Pair_Term a x))"

definition located_list_system :: "(nat,nat,nat,nat) schema_system" where
  "located_list_system=add_view_definition package_closure_admission_system 78 data_x (context_list_clauses 44 78)"

lemma located_list_system_formed [simp]: "schema_system_formed located_list_system"
  unfolding located_list_system_def
  by (rule add_recursive_definition_formed[OF package_closure_admission_system_formed])
    (auto simp: context_list_clauses_def context_list_nil_schema_def context_list_step_schema_def
      schema_formed_def schema_dependencies_def single_valued_def rel_dom_def rel_ran_def octets_formed_def)

lemma located_list_definitions [simp]:
  "system_definitions located_list_system=insert 78 (system_definitions package_closure_admission_system)"
  by (simp add: located_list_system_def)

lemma located_list_call:
  "schema_call_formed located_list_system d t \<longleftrightarrow>
    d\<in>system_definitions located_list_system \<and> term_formed t"
  using added_variable_calls[OF package_closure_admission_system_formed
    located_list_system_formed[unfolded located_list_system_def] package_closure_admission_call]
  by (simp only: located_list_system_def[symmetric])

lemma located_list_old_meaning:
  assumes "d\<in>system_definitions package_closure_admission_system"
  shows "(d,t)\<in>positive_meaning located_list_system \<longleftrightarrow>
    (d,t)\<in>positive_meaning package_closure_admission_system"
  using added_definition_preserves_old(2)[OF package_closure_admission_system_formed
    located_list_system_formed[unfolded located_list_system_def], of d t] assms
  by (auto simp: located_list_system_def)

lemma located_list_clause [simp]:
  "((78,c),S)\<in>system_clauses located_list_system \<longleftrightarrow> (c,S)\<in>context_list_clauses 44 78"
proof -
  have owned: "((d,c),S)\<in>system_clauses package_closure_admission_system \<Longrightarrow>
    d\<in>system_definitions package_closure_admission_system" for d c S
    using package_closure_admission_system_formed unfolding schema_system_formed_def by blast
  have absent: "((78,c),S)\<notin>system_clauses package_closure_admission_system" by (auto dest: owned)
  show ?thesis using absent by (simp add: located_list_system_def)
qed

lemma located_list_element:
  "(44,t)\<in>positive_meaning located_list_system \<longleftrightarrow>
    (44,t)\<in>positive_meaning located_admission_system"
  using located_list_old_meaning[of 44 t] package_closure_previous_meaning[of 44 t]
    definition_call_admission_instantiation_meaning[of 44 t] schema_instantiation_pattern_meaning[of 44 t]
    pattern_instantiation_quotation_meaning[of 44 t] quotation_admission_projection_meaning[of 44 t]
    target_projection_old_meaning[of 44 t] by auto

interpretation located_list_profile: context_list_profile located_list_system 44 78
  by (rule context_list_profile.intro) (auto simp: located_list_call)

theorem located_list_exact:
  "(78,z)\<in>positive_meaning located_list_system \<longleftrightarrow> located_list_result z"
  by (simp add: located_list_profile.exact located_list_element located_admission_exact)

corollary located_list_on_rows:
  assumes source: "environment_value_presents E e"
  shows "(78,Pair_Term (Pair_Term e (use_data_term u)) (pair_list_term zs))\<in>positive_meaning located_list_system
    \<longleftrightarrow> (\<forall>(a,d)\<in>set zs. \<exists>r v b. a=Payload_Term r \<and> d=site_data_term v b \<and> located_at E u r v b)"
  by (simp only: located_list_profile.lists located_list_element)
    (use environment_value_presents_formed[OF source] in
      \<open>auto simp: located_admission_at_source[OF source] inj_eq[OF use_data_term_injective]\<close>)

corollary located_list_at_rows:
  assumes source: "environment_value_presents E e"
  shows "(78,Pair_Term (Pair_Term e (use_data_term u))
      (pair_list_term (map (\<lambda>(a,d). (Payload_Term a,definition_site_value d)) xs)))\<in>positive_meaning located_list_system
    \<longleftrightarrow> (\<forall>(a,d)\<in>set xs. located_at E u a (fst d) (snd d))"
  by (simp only: located_list_profile.lists located_list_element)
    (use environment_value_presents_formed[OF source] in
      \<open>auto simp: located_admission_on_values[OF source]\<close>)

corollary located_list_empty:
  "(78,Pair_Term a (Payload_Term []))\<in>positive_meaning located_list_system \<longleftrightarrow> term_formed a"
  using located_list_profile.lists[of a "[]"] by simp

text \<open>
  The existing context-carrying list profile checks every pair and the final
  tail through the existing located-citation entry. The same environment and
  source use accompany every element. Repeated references and repeated
  destinations remain possible; no uniqueness condition is added.

  The standalone empty list admits any formed context. It does not claim
  to have inspected an environment or an artifact. Callers that read an
  actual family retain those separate source and root checks.
\<close>

end
