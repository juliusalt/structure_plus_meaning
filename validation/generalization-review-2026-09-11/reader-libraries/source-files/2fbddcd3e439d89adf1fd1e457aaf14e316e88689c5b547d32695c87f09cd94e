theory Factor_Pattern_Call_Contracts
  imports "Factor_Pattern_Call_Instances" "Factor_Context_Admission"
begin

section \<open>The linked input class retains both actual sites and the selected definition\<close>

abbreviation pattern_call_sources_presents ::
  "((site_context\<times>local_address option definition_site)\<times>site_context) \<Rightarrow> factor_term \<Rightarrow> bool" where
  "pattern_call_sources_presents \<equiv>
    factor_pair_presents (factor_pair_presents source_root_presents site_coordinate_presents) site_context_presents"

interpretation pattern_call_sources: presentation_class pattern_call_sources_presents
  "\<lambda>z. site_context_formed (fst (fst z)) \<and> site_context_formed (snd z)"
  "\<lambda>t. \<exists>x y. (\<exists>a b. (\<exists>z. source_root_presents z a) \<and>
    (\<exists>d. site_coordinate_presents d b) \<and> x=Pair_Term a b) \<and>
    (156,y)\<in>positive_meaning context_admission_system \<and> t=Pair_Term x y"
  using factor_pair_class[OF factor_pair_class[OF source_root_presentation_class
    site_coordinate_presentation] site_context_native_class] by simp

definition pattern_call_context_formed ::
  "((site_context\<times>local_address option definition_site)\<times>site_context) \<Rightarrow> bool" where
  "pattern_call_context_formed z \<longleftrightarrow>
    (case z of (((E,u,r),d),(F,v,q)) \<Rightarrow> schema_pattern_call_at E u r d F v q)"

definition pattern_call_context_presents ::
  "((site_context\<times>local_address option definition_site)\<times>site_context) \<Rightarrow> factor_term \<Rightarrow> bool" where
  "pattern_call_context_presents z t \<longleftrightarrow> pattern_call_context_formed z \<and> pattern_call_sources_presents z t"

lemma pattern_call_context_boundary:
  assumes "pattern_call_context_formed z"
  shows "site_context_formed (fst (fst z)) \<and> site_context_formed (snd z)"
  using assms by (auto simp: pattern_call_context_formed_def schema_pattern_call_at_def
    native_package_at_def native_root_family_at_def family_at_def scoped_pattern_at_def record_at_def split: prod.splits)

lemma pattern_call_context_fields:
  "pattern_call_context_presents (((E,u,r),d),(F,v,q)) t \<longleftrightarrow>
    schema_pattern_call_at E u r d F v q \<and>
    (\<exists>a b. source_root_presents (E,u,r) a \<and> site_value_presents F v q b \<and>
      t=Pair_Term (Pair_Term a (definition_site_value d)) b)"
  by (auto simp: pattern_call_context_presents_def pattern_call_context_formed_def factor_pair_presents_def)

theorem pattern_call_context_admission:
  "(292,t)\<in>positive_meaning pattern_call_reading_system \<longleftrightarrow>
    (\<exists>z. pattern_call_context_presents z t)"
proof -
  have actual: "site_context_formed (E,u,r) \<and> site_context_formed (F,v,q)"
    if "schema_pattern_call_at E u r d F v q" for E u r d F v q
    using pattern_call_context_boundary[of "(((E,u,r),d),(F,v,q))"] that
    by (simp add: pattern_call_context_formed_def)
  show ?thesis
  proof
    assume admitted: "(292,t)\<in>positive_meaning pattern_call_reading_system"
    obtain E e u r d F f v q where inputs: "environment_value_presents E e" "environment_value_presents F f"
      "t=pattern_call_reading_argument e (use_data_term u) (Payload_Term r) (definition_site_value d)
        f (use_data_term v) (Payload_Term q)" "schema_pattern_call_at E u r d F v q"
      using admitted by (simp only: pattern_call_reading_exact pattern_call_reading_result_def) blast
    have sites: "source_root_presents (E,u,r) (source_root_argument e (use_data_term u) (Payload_Term r))"
      "site_value_presents F v q (Pair_Term f (site_data_term v q))"
      using inputs(1,2) actual[OF inputs(4)] by (auto simp: site_value_presents_def source_root_presents_fields)
    have presented: "pattern_call_context_presents (((E,u,r),d),(F,v,q)) t"
      unfolding pattern_call_context_fields
      by (rule conjI[OF inputs(4)], rule exI[of _ "source_root_argument e (use_data_term u) (Payload_Term r)"],
        rule exI[of _ "Pair_Term f (site_data_term v q)"])
        (use sites inputs(3) in \<open>simp add: site_data_term_def\<close>)
    show "\<exists>z. pattern_call_context_presents z t" using presented by blast
  next
    assume "\<exists>z. pattern_call_context_presents z t"
    then obtain z where presented: "pattern_call_context_presents z t" by blast
    obtain E u r d F v q where shape: "z=(((E,u,r),d),(F,v,q))" by (metis surjective_pairing)
    obtain a b where inputs: "schema_pattern_call_at E u r d F v q"
      "source_root_presents (E,u,r) a" "site_value_presents F v q b"
      "t=Pair_Term (Pair_Term a (definition_site_value d)) b"
      using presented by (simp only: shape pattern_call_context_fields) blast
    obtain e f where sources: "environment_value_presents E e" "a=source_root_argument e (use_data_term u) (Payload_Term r)"
      "environment_value_presents F f" "b=Pair_Term f (site_data_term v q)"
      using inputs(2,3) by (auto simp: site_value_presents_def source_root_presents_fields)
    show "(292,t)\<in>positive_meaning pattern_call_reading_system"
      unfolding pattern_call_reading_exact pattern_call_reading_result_def
      by (rule exI[of _ E], rule exI[of _ e], rule exI[of _ u], rule exI[of _ r], rule exI[of _ d],
        rule exI[of _ F], rule exI[of _ f], rule exI[of _ v], rule exI[of _ q])
        (use sources inputs(1,4) in \<open>simp add: site_data_term_def\<close>)
  qed
qed

theorem pattern_call_context_class:
  "presentation_class pattern_call_context_presents pattern_call_context_formed
    (\<lambda>t. (292,t)\<in>positive_meaning pattern_call_reading_system)"
proof -
  have generic: "presentation_class (\<lambda>z t. pattern_call_context_formed z \<and> pattern_call_sources_presents z t)
      pattern_call_context_formed (\<lambda>t. \<exists>z. pattern_call_context_formed z \<and> pattern_call_sources_presents z t)"
    by (rule presentation_class_subdomain[OF pattern_call_sources.presentation_class_axioms])
      (rule pattern_call_context_boundary)
  show ?thesis using generic
    by (simp only: pattern_call_context_presents_def[symmetric] pattern_call_context_admission[symmetric])
qed

theorem pattern_call_context_predicate:
  "(292,t)\<in>positive_meaning pattern_call_reading_system \<longleftrightarrow>
    presented_predicate pattern_call_sources_presents pattern_call_context_formed t"
  by (simp only: pattern_call_context_admission pattern_call_context_presents_def presented_predicate_def conj_commute)

theorem pattern_call_context_at:
  assumes "pattern_call_sources_presents z t"
  shows "(292,t)\<in>positive_meaning pattern_call_reading_system \<longleftrightarrow> pattern_call_context_formed z"
  by (simp only: pattern_call_context_predicate pattern_call_sources.predicate_at[OF assms])

theorem pattern_call_context_invariance:
  assumes "pattern_call_sources_presents z t" "pattern_call_sources_presents z s"
  shows "(292,t)\<in>positive_meaning pattern_call_reading_system \<longleftrightarrow>
    (292,s)\<in>positive_meaning pattern_call_reading_system"
  by (simp only: pattern_call_context_at[OF assms(1)] pattern_call_context_at[OF assms(2)])

text \<open>
  The independent subject retains the actual package site, selected definition,
  and actual scoped-pattern site. The existing source-root, site, and coordinate
  classes compose through the general product construction.
  The intrinsic symbolic-call relation then supplies the subdomain, and the
  native entry admits exactly every presentation of that subdomain.

  Coordinate recovery alone assigns no definition meaning. The joint relation
  checks the actual reached definition in the supplied package. Alternative
  presentations of either source environment preserve the same subject and
  the native predicate result, including refusal on incompatible inputs.
\<close>

end
