theory Factor_Substitution_Observations
  imports "Factor_Substitution" "Factor_Schema_Observations"
begin

section \<open>Two observations determine the substituted pattern\<close>

theorem pattern_substitution_two_observations:
  assumes markers: "inj_on f B"
    and scope: "\<forall>a\<in>pattern_variables p. pattern_variables (s a)\<subseteq>B"
      "pattern_variables q\<subseteq>B"
  shows "q=pattern_substitute s p \<longleftrightarrow>
    evaluate_pattern (\<lambda>a. evaluate_pattern (\<lambda>b. Payload_Term (f b)) (s a)) p =
      evaluate_pattern (\<lambda>b. Payload_Term (f b)) q \<and>
    evaluate_pattern (\<lambda>a. evaluate_pattern (\<lambda>_. Target_Term k) (s a)) p =
      evaluate_pattern (\<lambda>_. Target_Term k) q"
proof
  assume "q=pattern_substitute s p"
  then show "evaluate_pattern (\<lambda>a. evaluate_pattern (\<lambda>b. Payload_Term (f b)) (s a)) p =
      evaluate_pattern (\<lambda>b. Payload_Term (f b)) q \<and>
    evaluate_pattern (\<lambda>a. evaluate_pattern (\<lambda>_. Target_Term k) (s a)) p =
      evaluate_pattern (\<lambda>_. Target_Term k) q" by simp
next
  assume observations: "evaluate_pattern (\<lambda>a. evaluate_pattern (\<lambda>b. Payload_Term (f b)) (s a)) p =
      evaluate_pattern (\<lambda>b. Payload_Term (f b)) q \<and>
    evaluate_pattern (\<lambda>a. evaluate_pattern (\<lambda>_. Target_Term k) (s a)) p =
      evaluate_pattern (\<lambda>_. Target_Term k) q"
  show "q=pattern_substitute s p"
    by (rule pattern_evaluations_determine[OF markers, where k=k])
      (use scope observations in \<open>auto simp: pattern_substitute_variables\<close>)
qed

lemma evaluate_material_tuple_substitute [simp]:
  "evaluate_material_tuple h (material_pattern_substitute s M)=
    evaluate_material_tuple (\<lambda>a. evaluate_pattern h (s a)) M"
  by (simp add: material_pattern_substitute_def)

lemma evaluate_schema_materials_substitute [simp]:
  "evaluate_schema_materials h (schema_substitute s S)=
    evaluate_schema_materials (\<lambda>a. evaluate_pattern h (s a)) S"
  by (simp add: evaluate_schema_materials_def schema_substitute_def image_image split_def)

lemma schema_reference_outputs_substitute [simp]:
  "schema_reference_outputs h (schema_substitute s S)=
    schema_reference_outputs (\<lambda>a. evaluate_pattern h (s a)) S"
  by (simp add: schema_reference_outputs_def)

lemma schema_data_substitute_formed:
  assumes source: "schema_data_formed S"
    and replacements: "\<forall>a\<in>schema_variables S. pattern_formed (s a)"
    and variables: "\<forall>b\<in>(\<Union>a\<in>schema_variables S. pattern_variables (s a)). octets_formed b"
  shows "schema_data_formed (schema_substitute s S)"
  using source variables schema_substitute_formed[OF _ replacements]
  by (auto simp: schema_data_formed_def schema_substitute_variables)

lemma schema_substitution_reference_data:
  "schema_reference_data (schema_substitute s S)=
    ((\<Union>a\<in>schema_variables S. pattern_variables (s a)),
      (schema_reference_outputs (\<lambda>a. evaluate_pattern Payload_Term (s a)) S,
       schema_reference_outputs (\<lambda>a. evaluate_pattern
         (\<lambda>_. Target_Term (Whole_Artifact empty_artifact)) (s a)) S))"
  by (simp add: schema_reference_data_def schema_substitute_variables)

theorem schema_substitution_two_observations:
  assumes source: "schema_data_formed S" and target: "schema_data_formed T"
    and replacements: "\<forall>a\<in>schema_variables S. pattern_formed (s a)"
    and scope: "schema_variables T=(\<Union>a\<in>schema_variables S. pattern_variables (s a))"
  shows "T=schema_substitute s S \<longleftrightarrow>
    schema_reference_outputs (\<lambda>a. evaluate_pattern Payload_Term (s a)) S=
      schema_reference_outputs Payload_Term T \<and>
    schema_reference_outputs (\<lambda>a. evaluate_pattern
      (\<lambda>_. Target_Term (Whole_Artifact empty_artifact)) (s a)) S=
      schema_reference_outputs (\<lambda>_. Target_Term (Whole_Artifact empty_artifact)) T"
proof
  assume "T=schema_substitute s S"
  then show "schema_reference_outputs (\<lambda>a. evaluate_pattern Payload_Term (s a)) S=
      schema_reference_outputs Payload_Term T \<and>
    schema_reference_outputs (\<lambda>a. evaluate_pattern
      (\<lambda>_. Target_Term (Whole_Artifact empty_artifact)) (s a)) S=
      schema_reference_outputs (\<lambda>_. Target_Term (Whole_Artifact empty_artifact)) T" by simp
next
  assume observations: "schema_reference_outputs (\<lambda>a. evaluate_pattern Payload_Term (s a)) S=
      schema_reference_outputs Payload_Term T \<and>
    schema_reference_outputs (\<lambda>a. evaluate_pattern
      (\<lambda>_. Target_Term (Whole_Artifact empty_artifact)) (s a)) S=
      schema_reference_outputs (\<lambda>_. Target_Term (Whole_Artifact empty_artifact)) T"
  have variables: "\<forall>b\<in>(\<Union>a\<in>schema_variables S. pattern_variables (s a)). octets_formed b"
    using target scope by (simp add: schema_data_formed_def)
  have formed: "schema_data_formed (schema_substitute s S)"
    by (rule schema_data_substitute_formed[OF source replacements variables])
  have same: "schema_reference_data T=schema_reference_data (schema_substitute s S)"
    using observations scope by (simp add: schema_reference_data_def schema_substitute_variables)
  show "T=schema_substitute s S" by (rule schema_reference_data_determines[OF target formed same])
qed

theorem observed_schema_substitution_specializes:
  assumes source: "schema_data_formed S" and target: "schema_data_formed T"
    and replacements: "\<forall>a\<in>schema_variables S. pattern_formed (s a)"
    and scope: "schema_variables T=(\<Union>a\<in>schema_variables S. pattern_variables (s a))"
    and observations:
      "schema_reference_outputs (\<lambda>a. evaluate_pattern Payload_Term (s a)) S=
        schema_reference_outputs Payload_Term T"
      "schema_reference_outputs (\<lambda>a. evaluate_pattern
        (\<lambda>_. Target_Term (Whole_Artifact empty_artifact)) (s a)) S=
        schema_reference_outputs (\<lambda>_. Target_Term (Whole_Artifact empty_artifact)) T"
    and rule: "schema_rule_instance T X t"
  shows "schema_rule_instance S X t"
proof -
  have same: "T=schema_substitute s S"
    using schema_substitution_two_observations[OF source target replacements scope] observations by blast
  show ?thesis by (rule schema_substitute_specializes[OF _ replacements])
    (use source rule same in \<open>auto simp: schema_data_formed_def\<close>)
qed

text \<open>
  The source schema is observed under the evaluated replacements. The target
  schema is observed under the original two marker assignments. The complete
  output contains the conclusion, every identified prospective call, and all
  five operands at every material socket. Its scope is exactly the variables
  remaining after substitution. No injectivity condition is imposed on the
  substitution itself.

  The syntax theorem and the valuation theorem have separate jobs. The two
  observations identify one finite transformed schema; commutation supplies
  its behavior at every later valuation. Specialization follows. Equivalence
  still requires a reverse argument such as valuation coverage, and a program
  comparison still includes its independent call interfaces.
\<close>

end
