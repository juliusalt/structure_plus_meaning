theory Factor_Binding_Table_Reading
  imports "Factor_Site_Link_Vector" "Factor_Table_Metadata" "Factor_Table_Reading_Profiles"
begin

section \<open>Complete native bindings retain their actual variable sites\<close>

abbreviation positioned_binding_rows_term where
  "positioned_binding_rows_term qs \<equiv> keyed_rows_term (\<lambda>d. definition_site_value d) id qs"

abbreviation binding_table_reading_result :: "factor_term\<Rightarrow>bool" where
  "binding_table_reading_result z \<equiv> \<exists>E e u r qs Is Ks.
    z=term_quotation_argument e (use_data_term u) (Payload_Term r) (positioned_binding_rows_term qs)
      (data_list_term (map Payload_Term Is)) (data_list_term (map Payload_Term Ks)) \<and>
    environment_value_presents E e \<and> distinct qs \<and> distinct Is \<and> distinct Ks \<and>
    native_binding_table_at E u r (set qs) (set Is) (set Ks)"

definition binding_table_reading_system :: "(nat,nat,nat,nat) schema_system" where
  "binding_table_reading_system=add_view_definition site_link_vector_system 92 data_x {(0,table_reading_schema 90)}"

lemma binding_table_reading_system_formed [simp]: "schema_system_formed binding_table_reading_system"
  unfolding binding_table_reading_system_def
  by (rule add_recursive_definition_formed[OF site_link_vector_system_formed])
    (auto simp: table_reading_schema_def
      schema_formed_def schema_dependencies_def single_valued_def rel_dom_def rel_ran_def octets_formed_def)

lemma binding_table_reading_definitions [simp]:
  "system_definitions binding_table_reading_system=insert 92 (system_definitions site_link_vector_system)"
  by (simp add: binding_table_reading_system_def)

lemma binding_table_reading_call:
  "schema_call_formed binding_table_reading_system d t \<longleftrightarrow>
    d\<in>system_definitions binding_table_reading_system \<and> term_formed t"
  using added_variable_calls[OF site_link_vector_system_formed
    binding_table_reading_system_formed[unfolded binding_table_reading_system_def] site_link_vector_call]
  by (simp only: binding_table_reading_system_def[symmetric])

lemma binding_table_reading_old_meaning:
  assumes "d\<in>system_definitions site_link_vector_system"
  shows "(d,t)\<in>positive_meaning binding_table_reading_system \<longleftrightarrow> (d,t)\<in>positive_meaning site_link_vector_system"
  using added_definition_preserves_old(2)[OF site_link_vector_system_formed
    binding_table_reading_system_formed[unfolded binding_table_reading_system_def], of d t] assms
  by (auto simp: binding_table_reading_system_def)

lemma binding_table_reading_clause [simp]:
  "((92,c),S)\<in>system_clauses binding_table_reading_system \<longleftrightarrow> (c,S)\<in>{(0,table_reading_schema 90)}"
proof -
  have owned: "((d,c),S)\<in>system_clauses site_link_vector_system \<Longrightarrow>
    d\<in>system_definitions site_link_vector_system" for d c S
    using site_link_vector_system_formed unfolding schema_system_formed_def by blast
  have absent: "((92,c),S)\<notin>system_clauses site_link_vector_system" by (auto dest: owned)
  show ?thesis using absent by (simp add: binding_table_reading_system_def)
qed

lemma binding_table_reading_base_meaning:
  assumes "d\<in>system_definitions admitted_instantiation_system"
  shows "(d,t)\<in>positive_meaning binding_table_reading_system \<longleftrightarrow> (d,t)\<in>positive_meaning admitted_instantiation_system"
  using binding_table_reading_old_meaning[of d t] site_link_vector_base_meaning[OF assms, of t] assms by auto

lemma binding_table_reading_components:
  "(37,t)\<in>positive_meaning binding_table_reading_system \<longleftrightarrow> (37,t)\<in>positive_meaning artifact_lookup_system"
  "(32,t)\<in>positive_meaning binding_table_reading_system \<longleftrightarrow> (32,t)\<in>positive_meaning family_admission_system"
  "(51,t)\<in>positive_meaning binding_table_reading_system \<longleftrightarrow> (51,t)\<in>positive_meaning row_keys_system"
  "(59,t)\<in>positive_meaning binding_table_reading_system \<longleftrightarrow> (59,t)\<in>positive_meaning row_values_system"
  "(21,t)\<in>positive_meaning binding_table_reading_system \<longleftrightarrow> (21,t)\<in>positive_meaning keyed_list_system"
  "(46,t)\<in>positive_meaning binding_table_reading_system \<longleftrightarrow> (46,t)\<in>positive_meaning data_append_system"
  "(6,t)\<in>positive_meaning binding_table_reading_system \<longleftrightarrow> (6,t)\<in>positive_meaning bag_comparison_system"
  "(49,t)\<in>positive_meaning binding_table_reading_system \<longleftrightarrow> (49,t)\<in>positive_meaning payload_disjoint_system"
  using binding_table_reading_base_meaning[of 37 t] metadata_reading_components(1)[of t]
    binding_table_reading_base_meaning[of 32 t] metadata_reading_components(2)[of t]
    binding_table_reading_base_meaning[of 51 t] metadata_reading_components(12)[of t]
    binding_table_reading_base_meaning[of 59 t] metadata_reading_components(13)[of t]
    binding_table_reading_base_meaning[of 21 t] metadata_reading_components(11)[of t]
    binding_table_reading_base_meaning[of 46 t] metadata_reading_components(7)[of t]
    binding_table_reading_base_meaning[of 6 t] metadata_reading_components(8)[of t]
    binding_table_reading_base_meaning[of 49 t] metadata_reading_components(10)[of t] by auto

lemma binding_table_reading_rows:
  "(90,t)\<in>positive_meaning binding_table_reading_system \<longleftrightarrow> boundary_rows_result application_reading_result t"
  using binding_table_reading_old_meaning[of 90 t] site_link_vector_old_meaning[of 90 t]
    application_vector_exact[of t] by auto

interpretation binding_table_reading_profile: table_reading_profile binding_table_reading_system 92 90 application_reading_result
  "(\<lambda>E u a q J A. native_application_at E u a (fst q) (snd q) J A)" "(\<lambda>d. definition_site_value d)" id
proof -
  have row: "application_reading_result (term_quotation_argument e u r q i k) \<longleftrightarrow>
      (\<exists>v a x Js As. u=use_data_term v \<and> r=Payload_Term a \<and>
        q=Pair_Term (definition_site_value (fst x)) (id (snd x)) \<and>
        i=data_list_term (map Payload_Term Js) \<and> k=data_list_term (map Payload_Term As) \<and>
        distinct Js \<and> distinct As \<and> native_application_at E v a (fst x) (snd x) (set Js) (set As))"
    if source: "environment_value_presents E e" for E e u r q i k
    using application_reading_row_at_source[OF source, of u r q i k]
    by (simp only: split_paired_Ex fst_conv snd_conv id_apply)
  have unique: "q=z \<and> J=L \<and> A=B"
    if "native_application_at E u a (fst q) (snd q) J A" "native_application_at E u a (fst z) (snd z) L B"
    for E u a q J A z L B
    using native_application_unique[OF that] by (cases q; cases z) auto
  have finite: "finite J \<and> finite A" if "native_application_at E u a (fst q) (snd q) J A" for E u a q J A
    using native_application_properties[OF that] by blast
  show "table_reading_profile binding_table_reading_system 92 90 application_reading_result
      (\<lambda>E u a q J A. native_application_at E u a (fst q) (snd q) J A) (\<lambda>d. definition_site_value d) id"
    by (rule table_reading_profile.intro)
      (fact binding_table_reading_system_formed, fact binding_table_reading_clause,
       simp add: binding_table_reading_call, fact binding_table_reading_rows,
       fact row, fact unique, fact finite, fact definition_site_value_injective, fact inj_on_id, simp,
       fact binding_table_reading_components(1), fact binding_table_reading_components(2),
       fact binding_table_reading_components(3), fact binding_table_reading_components(4),
       fact binding_table_reading_components(5), fact binding_table_reading_components(6),
       fact binding_table_reading_components(7), fact binding_table_reading_components(8))
qed

theorem binding_table_reading_exact:
  "(92,z)\<in>positive_meaning binding_table_reading_system \<longleftrightarrow> binding_table_reading_result z"
  by (rule binding_table_reading_profile.exact)

theorem binding_table_reading_complete:
  assumes source: "environment_value_presents E e" and order: "distinct qs" "distinct Is" "distinct Ks"
    and raw: "native_binding_table_at E u r (set qs) (set Is) (set Ks)"
  shows "(92,term_quotation_argument e (use_data_term u) (Payload_Term r) (positioned_binding_rows_term qs)
    (data_list_term (map Payload_Term Is)) (data_list_term (map Payload_Term Ks)))\<in>positive_meaning binding_table_reading_system"
  by (rule binding_table_reading_profile.complete[OF source raw order])

corollary binding_table_reading_on_values:
  assumes source: "environment_value_presents E e"
  shows "(92,term_quotation_argument e (use_data_term u) (Payload_Term r) (positioned_binding_rows_term qs)
      (data_list_term (map Payload_Term Is)) (data_list_term (map Payload_Term Ks)))\<in>positive_meaning binding_table_reading_system \<longleftrightarrow>
    distinct qs \<and> distinct Is \<and> distinct Ks \<and> native_binding_table_at E u r (set qs) (set Is) (set Ks)"
  by (rule binding_table_reading_profile.on_values[OF source])

lemmas binding_table_reading_at_source=binding_table_reading_profile.at_source
lemmas binding_table_reading_presentation_invariance=binding_table_reading_profile.presentation_invariance
lemmas binding_table_reading_orders=binding_table_reading_profile.orders
lemmas binding_table_reading_result_unique=binding_table_reading_profile.result_unique
lemmas binding_table_reading_empty=binding_table_reading_profile.empty
lemmas binding_table_reading_physical_key_unique=binding_table_reading_profile.physical_key_unique

corollary binding_table_reading_reject_repeated_keys:
  assumes source: "environment_value_presents E e" and repeated: "\<not> distinct (map fst qs)"
  shows "\<not> (92,term_quotation_argument e (use_data_term u) (Payload_Term r) (positioned_binding_rows_term qs)
    (data_list_term (map Payload_Term Is)) (data_list_term (map Payload_Term Ks)))\<in>positive_meaning binding_table_reading_system"
proof
  assume holds: "(92,term_quotation_argument e (use_data_term u) (Payload_Term r) (positioned_binding_rows_term qs)
    (data_list_term (map Payload_Term Is)) (data_list_term (map Payload_Term Ks)))\<in>positive_meaning binding_table_reading_system"
  have parts: "distinct qs \<and> distinct Is \<and> distinct Ks \<and>
      native_binding_table_at E u r (set qs) (set Is) (set Ks)"
    using holds by (simp only: binding_table_reading_on_values[OF source])
  have distinct: "distinct qs" and raw: "native_binding_table_at E u r (set qs) (set Is) (set Ks)"
    using parts by blast+
  have functional: "single_valued (set qs)" by (rule native_binding_table_properties(2)[OF raw])
  show False using distinct functional repeated by (simp add: distinct_keys_iff)
qed

text \<open>
  Binding keys are actual sites, and values retain arbitrary formed terms.
  The complete physical family and every row are checked before their decoded
  table is returned. Repeated decoded keys are rejected even when their values
  agree. Complete output and metadata orders remain independent, and the
  empty table still requires its actual artifact and family root.

  The existing binding and link table projections now live below proof-node
  metadata. Their definitions and properties are unchanged.
\<close>

end
