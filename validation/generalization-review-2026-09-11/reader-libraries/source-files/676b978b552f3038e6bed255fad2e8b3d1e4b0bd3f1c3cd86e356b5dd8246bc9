lemma schema_pattern_base_call_meaning:
  assumes "d\<in>system_definitions schema_pattern_call_base_system"
  shows "(d,t)\<in>positive_meaning schema_pattern_base_system \<longleftrightarrow>
    (d,t)\<in>positive_meaning schema_pattern_call_base_system"
  using system_union_agree_left_locality(2)[OF schema_pattern_call_base_formed schema_reading_system_formed
    schema_pattern_report_agreement assms, of t] by (simp only: schema_pattern_base_system_def)

lemma schema_pattern_base_report_meaning:
  assumes "d\<in>system_definitions schema_reading_system"
  shows "(d,t)\<in>positive_meaning schema_pattern_base_system \<longleftrightarrow>
    (d,t)\<in>positive_meaning schema_reading_system"
  using system_union_agree_right_locality(2)[OF schema_pattern_call_base_formed schema_reading_system_formed
    schema_pattern_report_agreement assms, of t] by (simp only: schema_pattern_base_system_def)

section \<open>One ordinary clause checks the entire symbolic call boundary\<close>

definition schema_pattern_reading_schema :: "(nat,nat,nat) factor_schema" where
  "schema_pattern_reading_schema=data_rule
    (pattern_call_reading_pattern data_x data_y data_z data_w (Pattern_Variable 4) (Pattern_Variable 5) (Pattern_Variable 6))
    {(0,126,Pattern_Pair (Pattern_Pair (Pattern_Variable 4) (Pattern_Pair (Pattern_Variable 5) (Pattern_Variable 6)))
       (schema_reference_pattern (Pattern_Variable 7) (Pattern_Variable 8) (Pattern_Variable 9) (Pattern_Variable 10)
         (Pattern_Variable 11) (Pattern_Variable 12) (Pattern_Variable 13))),
     (1,84,package_subject_pattern data_x data_y data_z (Pattern_Pair data_w (Pattern_Variable 8))),
     (2,84,package_subject_pattern data_x data_y data_z (Pattern_Pair data_w (Pattern_Variable 11))),
     (3,59,Pattern_Pair (Pattern_Variable 9) (Pattern_Variable 14)),
     (4,59,Pattern_Pair (Pattern_Variable 12) (Pattern_Variable 15)),
     (5,86,package_subject_pattern data_x data_y data_z (Pattern_Variable 14)),
     (6,86,package_subject_pattern data_x data_y data_z (Pattern_Variable 15))}"

definition schema_pattern_reading_system :: "(nat,nat,nat,nat) schema_system" where
  "schema_pattern_reading_system=add_view_definition schema_pattern_base_system 293 data_x {(0,schema_pattern_reading_schema)}"

interpretation schema_pattern_reading_view: positive_view schema_pattern_base_system 293 data_x "{(0,schema_pattern_reading_schema)}"
  by (rule positive_view.intro)
    (auto simp: schema_pattern_reading_schema_def schema_formed_def schema_dependencies_def
      single_valued_def rel_dom_def rel_ran_def octets_formed_def)

lemma schema_pattern_reading_system_formed [simp]: "schema_system_formed schema_pattern_reading_system"
  using schema_pattern_reading_view.formed by (simp only: schema_pattern_reading_system_def)

lemma schema_pattern_reading_definitions [simp]:
  "system_definitions schema_pattern_reading_system=insert 293 (system_definitions schema_pattern_base_system)"
