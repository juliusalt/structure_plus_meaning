  "(126,t)\<in>positive_meaning schema_pattern_reading_system \<longleftrightarrow>
    (126,t)\<in>positive_meaning schema_reading_system"
  "(84,t)\<in>positive_meaning schema_pattern_reading_system \<longleftrightarrow>
