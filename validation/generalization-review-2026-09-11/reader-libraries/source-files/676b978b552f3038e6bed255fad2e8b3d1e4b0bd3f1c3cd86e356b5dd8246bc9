section \<open>Shared definitions preserve all three existing readers\<close>

lemma schema_pattern_call_list_agreement:
  "systems_agree_on pattern_call_reading_system program_call_list_system
    (system_definitions pattern_call_reading_system \<inter> system_definitions program_call_list_system)"
proof -
  have reverse: "systems_agree_on program_call_admission_system substitution_reading_system
      (system_definitions program_call_admission_system \<inter> system_definitions substitution_reading_system)"
    using systems_agree_on_sym[OF pattern_call_base_agreement] by (simp only: Int_commute)
  have base: "systems_agree_on program_call_admission_system pattern_call_base_system
      (system_definitions program_call_admission_system)"
    using system_union_agree_left[OF substitution_reading_system_formed reverse]
    by (simp only: pattern_call_base_system_def system_union_commute)
  have pattern: "systems_agree_on program_call_admission_system pattern_call_reading_system
      (system_definitions program_call_admission_system)"
    using base by (simp add: systems_agree_on_added pattern_call_reading_system_def)
  have list: "systems_agree_on program_call_admission_system program_call_list_system
      (system_definitions program_call_admission_system)"
    by (simp add: systems_agree_on_added program_call_list_system_def application_admission_system_def)
  have shared: "systems_agree_on pattern_call_reading_system program_call_list_system
      (system_definitions program_call_admission_system)"
    by (rule systems_agree_on_transitive[OF systems_agree_on_sym[OF pattern] list])
  have overlap: "system_definitions pattern_call_reading_system \<inter> system_definitions program_call_list_system=
      system_definitions program_call_admission_system" by auto
  show ?thesis using shared by (simp only: overlap)
qed

definition schema_pattern_call_base_system :: "(nat,nat,nat,nat) schema_system" where
  "schema_pattern_call_base_system=system_union pattern_call_reading_system program_call_list_system"

lemma schema_pattern_call_base_formed [simp]: "schema_system_formed schema_pattern_call_base_system"
  unfolding schema_pattern_call_base_system_def
  by (rule system_union_agree_formed[OF pattern_call_reading_system_formed program_call_list_system_formed
    schema_pattern_call_list_agreement])

lemma schema_pattern_call_base_definitions [simp]:
  "system_definitions schema_pattern_call_base_system=
    system_definitions pattern_call_reading_system \<union> system_definitions program_call_list_system"
  by (simp add: schema_pattern_call_base_system_def)

lemma schema_pattern_call_base_pattern_meaning:
  assumes "d\<in>system_definitions pattern_call_reading_system"
  shows "(d,t)\<in>positive_meaning schema_pattern_call_base_system \<longleftrightarrow>
    (d,t)\<in>positive_meaning pattern_call_reading_system"
  using system_union_agree_left_locality(2)[OF pattern_call_reading_system_formed program_call_list_system_formed
    schema_pattern_call_list_agreement assms, of t] by (simp only: schema_pattern_call_base_system_def)

lemma schema_pattern_call_base_list_meaning:
  assumes "d\<in>system_definitions program_call_list_system"
  shows "(d,t)\<in>positive_meaning schema_pattern_call_base_system \<longleftrightarrow>
    (d,t)\<in>positive_meaning program_call_list_system"
  using system_union_agree_right_locality(2)[OF pattern_call_reading_system_formed program_call_list_system_formed
    schema_pattern_call_list_agreement assms, of t] by (simp only: schema_pattern_call_base_system_def)

lemma schema_pattern_report_agreement:
  "systems_agree_on schema_pattern_call_base_system schema_reading_system
    (system_definitions schema_pattern_call_base_system \<inter> system_definitions schema_reading_system)"
proof -
  have reference: "systems_agree_on reference_bindings_system substitution_reading_system
      (system_definitions reference_bindings_system)"
    by (simp add: substitution_reading_system_def systems_agree_on_added)
  have union: "systems_agree_on substitution_reading_system pattern_call_base_system
      (system_definitions substitution_reading_system)"
    using system_union_agree_left[OF program_call_admission_system_formed pattern_call_base_agreement]
    by (simp only: pattern_call_base_system_def)
  have restricted: "systems_agree_on substitution_reading_system pattern_call_base_system
      (system_definitions reference_bindings_system)"
    by (rule systems_agree_on_subdomain[OF union]) auto
  have base: "systems_agree_on reference_bindings_system pattern_call_base_system
      (system_definitions reference_bindings_system)"
    by (rule systems_agree_on_transitive[OF reference restricted])
  have pattern: "systems_agree_on reference_bindings_system pattern_call_reading_system
      (system_definitions reference_bindings_system)"
    using base by (simp add: pattern_call_reading_system_def systems_agree_on_added)
  have calls: "systems_agree_on pattern_call_reading_system schema_pattern_call_base_system
      (system_definitions pattern_call_reading_system)"
    using system_union_agree_left[OF program_call_list_system_formed schema_pattern_call_list_agreement]
    by (simp only: schema_pattern_call_base_system_def)
  have calls_restricted: "systems_agree_on pattern_call_reading_system schema_pattern_call_base_system
      (system_definitions reference_bindings_system)"
    by (rule systems_agree_on_subdomain[OF calls]) auto
  have combined: "systems_agree_on reference_bindings_system schema_pattern_call_base_system
      (system_definitions reference_bindings_system)"
    by (rule systems_agree_on_transitive[OF pattern calls_restricted])
  have report: "systems_agree_on reference_bindings_system schema_reading_system
      (system_definitions reference_bindings_system)"
    by (simp add: schema_reading_system_def systems_agree_on_added)
  have shared: "systems_agree_on schema_pattern_call_base_system schema_reading_system
      (system_definitions reference_bindings_system)"
    by (rule systems_agree_on_transitive[OF systems_agree_on_sym[OF combined] report])
  have overlap: "system_definitions schema_pattern_call_base_system \<inter> system_definitions schema_reading_system=
      system_definitions reference_bindings_system" by auto
  show ?thesis using shared by (simp only: overlap)
qed

