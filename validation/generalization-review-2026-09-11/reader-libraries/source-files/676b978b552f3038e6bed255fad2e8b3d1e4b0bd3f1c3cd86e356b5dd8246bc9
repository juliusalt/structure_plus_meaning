    d\<in>system_definitions schema_pattern_base_system \<and> term_formed t"
  using system_union_agree_call[OF schema_pattern_call_base_formed schema_reading_system_formed
    schema_pattern_report_agreement, of d t]
    system_union_agree_call[OF pattern_call_reading_system_formed program_call_list_system_formed
      schema_pattern_call_list_agreement, of d t]
  by (simp only: schema_pattern_base_system_def schema_pattern_call_base_system_def system_union_definitions
