theory Factor_Pattern_Call_Instances
  imports "Factor_Pattern_Call_Admission" "Finite_Investigation_a24c220cc9c60a2a4f495caf.Factor_Pattern_Encoding" "Factor_Proof_Probe_Investigation"
begin

section \<open>Private target coordinates preserve the complete call boundary\<close>

lemma schema_pattern_call_target_alpha:
  assumes "inj_on f (pattern_variables p)"
  shows "schema_pattern_call P d (rename_pattern f p) \<longleftrightarrow> schema_pattern_call P d p"
  by (simp only: schema_pattern_call_all_instances rename_pattern_formed pattern_accepts_alpha[OF assms])

theorem native_pattern_call_representations:
  fixes P :: "('a,'s,'d,'c) schema_system"
  assumes formed: "schema_system_formed P"
  shows "\<exists>g :: 'd\<Rightarrow>local_address option definition_site. \<exists>E u Q e.
    inj_on g (system_definitions P) \<and> closed_native_package_at E u [] Q \<and>
    system_alpha_variant (rename_system g P) Q \<and> environment_value_presents E e \<and>
    (\<forall>d. \<forall>p::'b term_pattern. schema_pattern_call P d p \<longrightarrow>
      (\<exists>f F r I K w. binder_addressing (pattern_variables p) f \<and>
        scoped_pattern_at F None r (rename_pattern f p) I K \<and>
        environment_value_presents F w \<and>
        (292,pattern_call_reading_argument e (use_data_term u) (Payload_Term []) (definition_site_value (g d))
          w (use_data_term None) (Payload_Term r))\<in>positive_meaning pattern_call_reading_system))"
proof -
  obtain g :: "'d\<Rightarrow>local_address option definition_site" and E u Q where program:
    "inj_on g (system_definitions P)" "closed_native_package_at E u [] Q"
    "system_alpha_variant (rename_system g P) Q"
    using program_compilation_total[OF formed] by blast
  have package: "native_package_at E u [] Q" using program(2) by (simp add: closed_native_package_at_def)
  have ef: "environment_formed E" using native_package_projection(1)[OF package]
    by (simp add: native_package_formed_def)
  obtain e where encoded: "environment_value_presents E e" using environment_value_presents_total[OF ef] by blast
  have each: "\<exists>f F r I K w. binder_addressing (pattern_variables p) f \<and>
      scoped_pattern_at F None r (rename_pattern f p) I K \<and> environment_value_presents F w \<and>
      (292,pattern_call_reading_argument e (use_data_term u) (Payload_Term []) (definition_site_value (g d))
        w (use_data_term None) (Payload_Term r))\<in>positive_meaning pattern_call_reading_system"
    if call: "schema_pattern_call P d p" for d and p :: "'b term_pattern"
  proof -
    have pf: "pattern_formed p" and member: "d\<in>system_definitions P"
      using schema_pattern_call_formed[OF call] by blast+
    obtain f and F :: "local_address option artifact_environment" and r I K where pattern:
      "binder_addressing (pattern_variables p) f" "scoped_pattern_at F None r (rename_pattern f p) I K"
      using scoped_pattern_representation_total[OF pf] by blast
    have injective: "inj_on f (pattern_variables p)" using pattern(1)
      by (simp add: binder_addressing_def finite_addressing_def)
    have ff: "environment_formed F" using pattern(2) by (simp add: scoped_pattern_at_def)
    obtain w where source: "environment_value_presents F w" using environment_value_presents_total[OF ff] by blast
    have compiled: "schema_pattern_call Q (g d) p"
      using schema_pattern_call_agreement[OF compiled_system_call_boundary[OF formed program(1,3) member], of p] call by blast
    have renamed: "schema_pattern_call Q (g d) (rename_pattern f p)"
      using compiled by (simp only: schema_pattern_call_target_alpha[OF injective])
    have at: "schema_pattern_call_at E u [] (g d) F None r"
      using renamed by (simp only: schema_pattern_call_at_reads[OF package pattern(2)])
    have accepted: "(292,pattern_call_reading_argument e (use_data_term u) (Payload_Term []) (definition_site_value (g d))
        w (use_data_term None) (Payload_Term r))\<in>positive_meaning pattern_call_reading_system"
      using at by (simp only: pattern_call_reading_on_sources[OF encoded source])
    show ?thesis by (rule exI[of _ f], rule exI[of _ F], rule exI[of _ r], rule exI[of _ I], rule exI[of _ K], rule exI[of _ w])
      (use pattern source accepted in blast)
  qed
  show ?thesis by (rule exI[of _ g], rule exI[of _ E], rule exI[of _ u], rule exI[of _ Q], rule exI[of _ e])
    (use program encoded each in blast)
qed

section \<open>The marker conditions are necessary for this complete criterion\<close>

theorem pattern_specialization_needs_both_marker_kinds:
  "evaluate_pattern (\<lambda>_. Payload_Term [0]) (Pattern_Variable ())=
      evaluate_pattern (\<lambda>_. Payload_Term [0]) (Pattern_Payload [0]) \<and>
    (\<nexists>s. Pattern_Variable ()=pattern_substitute s (Pattern_Payload [0]))"
  "evaluate_pattern (\<lambda>_. Target_Term (Whole_Artifact empty_artifact)) (Pattern_Variable ())=
      evaluate_pattern (\<lambda>_. Target_Term (Whole_Artifact empty_artifact)) (Pattern_Target (Whole_Artifact empty_artifact)) \<and>
    (\<nexists>s. Pattern_Variable ()=pattern_substitute s (Pattern_Target (Whole_Artifact empty_artifact)))"
  by simp_all

theorem repeated_interface_needs_distinct_markers:
  "evaluate_pattern (\<lambda>_. Payload_Term [0]) (Pattern_Pair (Pattern_Variable 0) (Pattern_Variable (1::nat)))=
      evaluate_pattern (\<lambda>_. Payload_Term [0]) (Pattern_Pair (Pattern_Variable ()) (Pattern_Variable ())) \<and>
    evaluate_pattern (\<lambda>_. Target_Term (Whole_Artifact empty_artifact))
      (Pattern_Pair (Pattern_Variable 0) (Pattern_Variable (1::nat)))=
      evaluate_pattern (\<lambda>_. Target_Term (Whole_Artifact empty_artifact))
        (Pattern_Pair (Pattern_Variable ()) (Pattern_Variable ())) \<and>
    (\<nexists>s. Pattern_Pair (Pattern_Variable 0) (Pattern_Variable (1::nat))=
      pattern_substitute s (Pattern_Pair (Pattern_Variable ()) (Pattern_Variable ())))"
proof -
  have absent: "\<nexists>s. Pattern_Pair (Pattern_Variable 0) (Pattern_Variable (1::nat))=
      pattern_substitute s (Pattern_Pair (Pattern_Variable ()) (Pattern_Variable ()))"
  proof
    assume "\<exists>s. Pattern_Pair (Pattern_Variable 0) (Pattern_Variable (1::nat))=
      pattern_substitute s (Pattern_Pair (Pattern_Variable ()) (Pattern_Variable ()))"
    then obtain s where equal: "Pattern_Pair (Pattern_Variable 0) (Pattern_Variable (1::nat))=
      pattern_substitute s (Pattern_Pair (Pattern_Variable ()) (Pattern_Variable ()))" by blast
    have first: "Pattern_Variable (0::nat)=s ()" and second: "Pattern_Variable (1::nat)=s ()"
      using equal by simp_all
    have "Pattern_Variable (0::nat)=Pattern_Variable (1::nat)" by (rule trans[OF first sym[OF second]])
    then show False by simp
  qed
  show ?thesis using absent by simp
qed

section \<open>Uniform call formation leaves positive proof obligations intact\<close>

theorem proof_probe_symbolic_calls:
  "schema_pattern_call (proof_probe_program c) () p \<longleftrightarrow> pattern_formed p"
  by (simp add: schema_pattern_call_all_instances pattern_accepts_def)

theorem proof_probe_symbolic_call_is_not_uniform_truth:
  "schema_pattern_call (proof_probe_program 0) () (Pattern_Variable a) \<and>
    ((),proof_probe_argument 0)\<in>positive_meaning (proof_probe_program 0) \<and>
    ((),proof_probe_argument 1)\<in>positive_meaning (proof_probe_program 0) \<and>
    ((),proof_probe_argument 2)\<notin>positive_meaning (proof_probe_program 0)"
  by (simp add: proof_probe_symbolic_calls proof_probe_truth proof_probe_argument_def)

text \<open>
  Every formed program is compiled once before all of its future symbolic
  calls. Each finite claim pattern then has an actual scoped presentation,
  with injective private variable coordinates, and the new native operation
  accepts its complete encoded sources. This covers arbitrary pattern depth
  and nonempty variable scopes; it is not an existence claim restricted to
  literal or already native inputs.

  The counterexamples retain why two constructor kinds and distinct variable
  markers are required. Reusing the actual finite probe program also exposes
  the separate positive proof obligation: its variable claim has a uniform
  call boundary while its pair instance is false.
\<close>

