theory Presentation_Observation_Contracts
  imports "Presentation_Completion"
begin

section \<open>An observation factors through the subject exactly when it is invariant\<close>

theorem observation_invariance_factorization:
  "rel_fun (presentation_transport R R) (=) f f \<longleftrightarrow>
    (\<exists>g. rel_fun R (=) g f)"
proof
  assume invariant: "rel_fun (presentation_transport R R) (=) f f"
  let ?g="\<lambda>a. f (SOME p. R a p)"
  have agrees: "?g a=f p" if read: "R a p" for a p
  proof -
    have selected: "R a (SOME p. R a p)" by (rule someI[where P="R a" and x=p, OF read])
    have related: "presentation_transport R R (SOME p. R a p) p"
      using selected read by (auto simp: presentation_transport_def)
    show ?thesis using invariant related by (simp add: rel_fun_def)
  qed
  show "\<exists>g. rel_fun R (=) g f"
    by (rule exI[of _ ?g]) (use agrees in \<open>simp add: rel_fun_def\<close>)
next
  assume "\<exists>g. rel_fun R (=) g f"
  then obtain g where factor: "rel_fun R (=) g f" by (elim exE)
  show "rel_fun (presentation_transport R R) (=) f f"
  proof (unfold rel_fun_def, intro allI impI)
    fix p q assume related: "presentation_transport R R p q"
    then obtain a where first: "R a p" and second: "R a q"
      by (auto simp: presentation_transport_def)
    have left: "g a=f p" using factor first by (simp add: rel_fun_def)
    have right: "g a=f q" using factor second by (simp add: rel_fun_def)
    show "f p=f q" using left right by simp
  qed
qed

theorem paired_observation_factorization:
  "rel_fun (presentation_transport R R) (=) (\<lambda>p. (f p,h p)) (\<lambda>p. (f p,h p))
    \<longleftrightarrow> (\<exists>g k. \<forall>a p. R a p \<longrightarrow> f p=g a \<and> h p=k a)"
proof
  assume "rel_fun (presentation_transport R R) (=) (\<lambda>p. (f p,h p)) (\<lambda>p. (f p,h p))"
  then obtain v where factor: "rel_fun R (=) v (\<lambda>p. (f p,h p))"
    by (simp only: observation_invariance_factorization) blast
  show "\<exists>g k. \<forall>a p. R a p \<longrightarrow> f p=g a \<and> h p=k a"
    by (rule exI[of _ "\<lambda>a. fst (v a)"], rule exI[of _ "\<lambda>a. snd (v a)"])
      (use factor in \<open>auto simp: rel_fun_def; metis fst_conv snd_conv\<close>)
next
  assume "\<exists>g k. \<forall>a p. R a p \<longrightarrow> f p=g a \<and> h p=k a"
  then obtain g k where factor: "\<forall>a p. R a p \<longrightarrow> f p=g a \<and> h p=k a" by blast
  show "rel_fun (presentation_transport R R) (=) (\<lambda>p. (f p,h p)) (\<lambda>p. (f p,h p))"
    by (simp only: observation_invariance_factorization, rule exI[of _ "\<lambda>a. (g a,k a)"])
      (use factor in \<open>auto simp: rel_fun_def\<close>)
qed

theorem factored_observation_unique_on_subjects:
  assumes class_contract: "presentation_class R D A"
    and first: "rel_fun R (=) f observe" and second: "rel_fun R (=) g observe"
    and subject: "D a"
  shows "f a=g a"
  using presentation_class.total[OF class_contract subject] first second
  by (auto simp: rel_fun_def)

theorem presentation_class_reading_admission:
  assumes class_contract: "presentation_class R D A"
  shows "presentation_class R D (\<lambda>p. \<exists>a. R a p)"
proof -
  have admission: "A=(\<lambda>p. \<exists>a. R a p)"
    by (rule ext) (rule presentation_class.admissible_iff[OF class_contract])
  show ?thesis using class_contract by (simp only: admission)
qed

theorem presentation_admission_saturation:
  assumes class_contract: "presentation_class R D A"
  shows "saturate_observation R A=A"
  by (rule ext)
    (use presentation_class.saturation_boundary[OF class_contract]
      presentation_class.saturation_extends[OF class_contract] in blast)

text \<open>
  The observation may have any value type. Its factorization is relative to
  the actual presentation relation, with no assertion about unpresented
  arguments or subjects. Totality makes the factor unique on the independent
  subject domain. The mathematical choice in the existence proof selects no
  operative representation and supplies no new native observation.

  A pair retains both observations. A client's independently intended meaning
  remains a further condition; existence of some factor does not establish it.
\<close>

end
