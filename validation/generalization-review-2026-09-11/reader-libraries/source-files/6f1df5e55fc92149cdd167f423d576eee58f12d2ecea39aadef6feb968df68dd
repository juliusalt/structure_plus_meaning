theory Finite_Functional_Enumeration
  imports "RRA_Finite_Artifacts" "Finite_Singleton_Selection"
begin

section \<open>Ordered keys enumerate a complete finite functional relation\<close>

definition finite_functional_rows :: "('i::linorder\<times>'a) fset \<Rightarrow> ('i\<times>'a) list" where
  "finite_functional_rows R=
    (if finite_relation_functional R then
      map (\<lambda>i. (i,fthe_elem (fimage snd (ffilter (\<lambda>r. fst r=i) R))))
        (sorted_list_of_fset (fimage fst R))
     else [])"

lemma finite_functional_slot_singleton:
  assumes functional: "finite_relation_functional R" and member: "(i,a) |\<in>| R"
  shows "fimage snd (ffilter (\<lambda>r. fst r=i) R)={|a|}"
proof -
  have agrees: "b=a" if "(i,b) |\<in>| R" for b
    using single_valued_outputs[of "fset R" i b a] functional member that
    by (simp add: finite_relation_functional_correct)
  show ?thesis
  proof (rule fset_inject[THEN iffD1], rule set_eqI)
    fix b
    show "b\<in>fset (fimage snd (ffilter (\<lambda>r. fst r=i) R)) \<longleftrightarrow> b\<in>fset {|a|}"
    proof
      assume selected: "b\<in>fset (fimage snd (ffilter (\<lambda>r. fst r=i) R))"
      obtain r where actual: "r |\<in>| R" and key: "fst r=i" and val: "snd r=b"
        using selected by auto
      have actual_row: "(i,b) |\<in>| R" using actual key val by (cases r) auto
      have equal: "b=a" by (rule agrees[OF actual_row])
      show "b\<in>fset {|a|}" by (simp only: equal) simp
    next
      assume "b\<in>fset {|a|}"
      then have equal: "b=a" by simp
      show "b\<in>fset (fimage snd (ffilter (\<lambda>r. fst r=i) R))"
        using member by (auto simp only: equal; force)
    qed
  qed
qed

lemma finite_functional_selected_value:
  assumes functional: "finite_relation_functional R" and member: "(i,a) |\<in>| R"
  shows "fthe_elem (fimage snd (ffilter (\<lambda>r. fst r=i) R))=a"
  by (simp only: finite_functional_slot_singleton[OF functional member] fthe_felem_eq)

theorem finite_functional_rows_exact:
  assumes functional: "finite_relation_functional R"
  shows "set (finite_functional_rows R)=fset R"
proof
  show "set (finite_functional_rows R)\<subseteq>fset R"
  proof
    fix row assume member: "row\<in>set (finite_functional_rows R)"
    obtain i where key: "i |\<in>| fimage fst R"
      and shape: "row=(i,fthe_elem (fimage snd (ffilter (\<lambda>r. fst r=i) R)))"
      using member by (auto simp: finite_functional_rows_def functional)
    obtain a where actual: "(i,a) |\<in>| R" using key by auto
    show "row\<in>fset R" using actual finite_functional_selected_value[OF functional actual]
      by (simp only: shape)
  qed
  show "fset R\<subseteq>set (finite_functional_rows R)"
  proof
    fix row assume member: "row\<in>fset R"
    obtain i a where shape: "row=(i,a)" by (cases row) auto
    have actual: "(i,a) |\<in>| R" using member by (simp only: shape)
    have key: "i\<in>set (sorted_list_of_fset (fimage fst R))" using actual by force
    have chosen_value: "fthe_elem (fimage snd (ffilter (\<lambda>r. fst r=i) R))=a"
      by (rule finite_functional_selected_value[OF functional actual])
    let ?f="\<lambda>x. (x,fthe_elem (fimage snd (ffilter (\<lambda>r. fst r=x) R)))"
    have mapped: "?f i\<in>image ?f (set (sorted_list_of_fset (fimage fst R)))"
      by (rule imageI[OF key])
    show "row\<in>set (finite_functional_rows R)"
      using mapped by (simp only: finite_functional_rows_def functional if_True shape set_map chosen_value)
  qed
qed

lemma finite_functional_rows_invalid:
  "\<not>finite_relation_functional R \<Longrightarrow> finite_functional_rows R=[]"
  by (simp add: finite_functional_rows_def)

theorem finite_functional_rows_code [code]:
  "finite_functional_rows R=
    (if finite_relation_functional R then
      map (\<lambda>i. (i,the (finite_singleton_option (fimage snd (ffilter (\<lambda>r. fst r=i) R)))))
        (sorted_list_of_fset (fimage fst R))
     else [])"
proof (cases "finite_relation_functional R")
  case True
  have choices: "fthe_elem (fimage snd (ffilter (\<lambda>r. fst r=i) R))=
    the (finite_singleton_option (fimage snd (ffilter (\<lambda>r. fst r=i) R)))"
    if "i\<in>set (sorted_list_of_fset (fimage fst R))" for i
  proof -
    obtain a where member: "(i,a) |\<in>| R" using that by auto
    show ?thesis
      by (simp only: finite_functional_slot_singleton[OF True member]
        fthe_felem_eq finite_singleton_option_singleton option.sel)
  qed
  show ?thesis
    unfolding finite_functional_rows_def
    apply (simp only: True if_True)
    apply (rule map_cong[OF refl])
    apply (simp only: choices)
    done
next
  case False
  then show ?thesis by (simp only: finite_functional_rows_def if_False)
qed

text \<open>
  Only the keys require an order. Values can be complete terms, patterns,
  or other structures with no chosen ordering. Every selected key has
  exactly one value under the formation guard, including when the relation
  is empty. The enumeration retains every original key and value.
\<close>

end
