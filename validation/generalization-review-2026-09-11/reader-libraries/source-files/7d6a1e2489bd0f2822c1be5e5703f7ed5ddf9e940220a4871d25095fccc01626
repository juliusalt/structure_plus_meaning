theory Factor_Binding_Admission
  imports "Factor_Quotation_Admission"
begin

section \<open>Complete row keys retain their order and multiplicity\<close>

definition row_keys_cons_schema :: "(nat,nat,nat) factor_schema" where
  "row_keys_cons_schema=data_rule
    (Pattern_Pair (Pattern_Pair (Pattern_Pair data_x data_y) data_z) (Pattern_Pair data_x data_w))
    {(0,51,Pattern_Pair data_z data_w)}"

definition row_keys_clauses :: "(nat \<times> (nat,nat,nat) factor_schema) set" where
  "row_keys_clauses={(0,bag_nil_schema),(1,row_keys_cons_schema)}"

definition row_keys_system :: "(nat,nat,nat,nat) schema_system" where
  "row_keys_system=add_view_definition quotation_admission_system 51 data_x row_keys_clauses"

lemma row_keys_system_formed [simp]: "schema_system_formed row_keys_system"
  unfolding row_keys_system_def
  by (rule add_recursive_definition_formed[OF quotation_admission_system_formed])
    (auto simp: row_keys_clauses_def bag_nil_schema_def row_keys_cons_schema_def
      schema_formed_def schema_dependencies_def single_valued_def rel_dom_def rel_ran_def octets_formed_def)

lemma row_keys_definitions [simp]:
  "system_definitions row_keys_system=insert 51 (system_definitions quotation_admission_system)"
  by (simp add: row_keys_system_def)

lemma row_keys_call:
  "schema_call_formed row_keys_system d t \<longleftrightarrow>
    d\<in>system_definitions row_keys_system \<and> term_formed t"
  using added_variable_calls[OF quotation_admission_system_formed
    row_keys_system_formed[unfolded row_keys_system_def] quotation_admission_call]
  by (simp only: row_keys_system_def[symmetric])

lemma row_keys_old_meaning:
  assumes "d\<in>system_definitions quotation_admission_system"
  shows "(d,t)\<in>positive_meaning row_keys_system \<longleftrightarrow>
    (d,t)\<in>positive_meaning quotation_admission_system"
  using added_definition_preserves_old(2)[OF quotation_admission_system_formed
    row_keys_system_formed[unfolded row_keys_system_def], of d t] assms
  by (auto simp: row_keys_system_def)

lemma row_keys_clause [simp]:
  "((51,c),S)\<in>system_clauses row_keys_system \<longleftrightarrow> (c,S)\<in>row_keys_clauses"
proof -
  have owned: "((d,c),S)\<in>system_clauses quotation_admission_system \<Longrightarrow>
    d\<in>system_definitions quotation_admission_system" for d c S
    using quotation_admission_system_formed unfolding schema_system_formed_def by blast
  have absent: "((51,c),S)\<notin>system_clauses quotation_admission_system" by (auto dest: owned)
  show ?thesis using absent by (simp add: row_keys_system_def)
qed

theorem row_keys_sound:
  assumes holds: "(51,t)\<in>positive_meaning row_keys_system"
  shows "\<exists>xs. t=Pair_Term (pair_list_term xs) (data_list_term (map fst xs)) \<and>
    term_formed (pair_list_term xs)"
proof -
  let ?Q="\<lambda>t. \<exists>xs. t=Pair_Term (pair_list_term xs) (data_list_term (map fst xs)) \<and>
    term_formed (pair_list_term xs)"
  have invariant: "(51::nat)=51 \<longrightarrow> ?Q t"
  proof (rule positive_valuation_induct[OF holds, where property="\<lambda>d t. d=51 \<longrightarrow> ?Q t"])
    fix d c S h
    assume clause: "((d,c),S)\<in>system_clauses row_keys_system"
      and assignment: "\<forall>a\<in>schema_variables S. term_formed (h a)"
      and call: "schema_call_formed row_keys_system d (evaluate_pattern h (schema_conclusion S))"
      and support: "\<forall>s e p. (s,e,p)\<in>schema_premises S \<longrightarrow>
        (e,evaluate_pattern h p)\<in>positive_meaning row_keys_system \<and>
        (e=51 \<longrightarrow> ?Q (evaluate_pattern h p))"
    show "d=51 \<longrightarrow> ?Q (evaluate_pattern h (schema_conclusion S))"
    proof
      assume "d=51"
      then have alternatives: "S=bag_nil_schema \<or> S=row_keys_cons_schema"
        using clause by (auto simp: row_keys_clauses_def)
      then show "?Q (evaluate_pattern h (schema_conclusion S))"
      proof
        assume schema: "S=bag_nil_schema"
        show ?thesis by (rule exI[of _ "[]"]) (simp add: schema bag_nil_schema_def octets_formed_def)
      next
        assume schema: "S=row_keys_cons_schema"
        have first: "term_formed (h 0)" "term_formed (h 1)"
          using assignment by (auto simp: schema row_keys_cons_schema_def schema_variables_def)
        obtain xs where tail: "h 2=pair_list_term xs" "h 3=data_list_term (map fst xs)"
          "term_formed (pair_list_term xs)"
          using support[rule_format, of 0 51 "Pattern_Pair data_z data_w"]
          by (auto simp: schema row_keys_cons_schema_def)
        show ?thesis by (rule exI[of _ "(h 0,h 1)#xs"])
          (use first tail in \<open>simp add: schema row_keys_cons_schema_def\<close>)
      qed
    qed
  qed
  show ?thesis using invariant by simp
qed

theorem row_keys_complete:
  assumes "term_formed (pair_list_term xs)"
  shows "(51,Pair_Term (pair_list_term xs) (data_list_term (map fst xs)))\<in>positive_meaning row_keys_system"
  using assms
proof (induction xs)
  case Nil
  have result: "(51,evaluate_pattern (\<lambda>_. Payload_Term []) (schema_conclusion bag_nil_schema))
    \<in>positive_meaning row_keys_system"
    by (rule ordinary_positive_valuation_step[where c=0])
      (auto simp: row_keys_clauses_def bag_nil_schema_def schema_variables_def row_keys_call octets_formed_def)
  show ?case using result by (simp add: bag_nil_schema_def)
next
  case (Cons z xs)
  obtain k v where row: "z=(k,v)" by (cases z) auto
  have tail: "(51,Pair_Term (pair_list_term xs) (data_list_term (map fst xs)))\<in>positive_meaning row_keys_system"
    using Cons by simp
  let ?h="\<lambda>i::nat. if i=0 then k else if i=1 then v else if i=2 then pair_list_term xs
    else data_list_term (map fst xs)"
  have result: "(51,evaluate_pattern ?h (schema_conclusion row_keys_cons_schema))\<in>positive_meaning row_keys_system"
    by (rule ordinary_positive_valuation_step[where c=1])
      (use Cons.prems tail in \<open>auto simp: row row_keys_clauses_def row_keys_cons_schema_def
        schema_variables_def row_keys_call pair_list_term_formed_iff data_list_term_formed\<close>)
  show ?case using result by (simp add: row row_keys_cons_schema_def)
qed

theorem row_keys_exact:
  "(51,t)\<in>positive_meaning row_keys_system \<longleftrightarrow>
    (\<exists>xs. t=Pair_Term (pair_list_term xs) (data_list_term (map fst xs)) \<and>
      term_formed (pair_list_term xs))"
  using row_keys_sound row_keys_complete by blast

corollary row_keys_at_rows:
  "(51,Pair_Term (pair_list_term xs) k)\<in>positive_meaning row_keys_system \<longleftrightarrow>
    term_formed (pair_list_term xs) \<and> k=data_list_term (map fst xs)"
  by (simp only: row_keys_exact factor_term.inject pair_list_term_injective) auto

section \<open>Substitution tables have precisely the declared scope\<close>

abbreviation binding_rows_term :: "(local_address \<times> factor_term) list \<Rightarrow> factor_term" where
  "binding_rows_term xs \<equiv> pair_list_term (map (\<lambda>(a,t). (Payload_Term a,t)) xs)"

lemma binding_rows_term_injective:
  "binding_rows_term xs=binding_rows_term ys \<longleftrightarrow> xs=ys"
proof -
  have injective: "inj (\<lambda>(a,t). (Payload_Term a,t))"
    by (rule injI; rename_tac x y; case_tac x; case_tac y) simp
  show ?thesis by (simp only: pair_list_term_injective injective_mapped_lists[OF injective])
qed

lemma binding_rows_term_formed:
  "term_formed (binding_rows_term xs) \<longleftrightarrow>
    (\<forall>(a,t)\<in>set xs. octets_formed a \<and> term_formed t)"
  by (simp only: pair_list_term_formed_iff) auto

lemma binding_key_counts:
  assumes "distinct Vs"
  shows "mset (map fst xs)=mset Vs \<longleftrightarrow>
    distinct xs \<and> single_valued (set xs) \<and> rel_dom (set xs)=set Vs"
proof -
  have domain: "rel_dom (set xs)=set (map fst xs)" by (auto simp: rel_dom_def intro: rev_image_eqI)
  have comparison: "mset (map fst xs)=mset Vs \<longleftrightarrow>
    distinct (map fst xs) \<and> set (map fst xs)=set Vs"
    using distinct_source_mset[OF assms, of "map fst xs"] by auto
  show ?thesis by (simp only: comparison distinct_keys_iff domain conj_assoc)
qed

abbreviation binding_admission_result :: "factor_term \<Rightarrow> bool" where
  "binding_admission_result z \<equiv> \<exists>Vs xs.
    z=Pair_Term (data_list_term (map Payload_Term Vs)) (binding_rows_term xs) \<and>
    distinct Vs \<and> distinct xs \<and> (\<forall>a\<in>set Vs. octets_formed a) \<and>
    term_bindings_formed (set Vs) (set xs)"

definition binding_admission_schema :: "(nat,nat,nat) factor_schema" where
  "binding_admission_schema=data_rule (Pattern_Pair data_x data_y)
    {(0,51,Pattern_Pair data_y data_z),(1,1,data_x),(2,6,Pattern_Pair data_z data_x)}"

definition binding_admission_system :: "(nat,nat,nat,nat) schema_system" where
  "binding_admission_system=add_view_definition row_keys_system 52 data_x {(0,binding_admission_schema)}"

interpretation binding_admission_view: positive_view row_keys_system 52 data_x "{(0,binding_admission_schema)}"
  by (rule positive_view.intro)
    (auto simp: binding_admission_schema_def schema_formed_def schema_dependencies_def
      single_valued_def rel_dom_def rel_ran_def)

lemma binding_admission_system_formed [simp]: "schema_system_formed binding_admission_system"
  using binding_admission_view.formed by (simp only: binding_admission_system_def)

lemma binding_admission_definitions [simp]:
  "system_definitions binding_admission_system=insert 52 (system_definitions row_keys_system)"
  by (simp add: binding_admission_system_def)

lemma binding_admission_call:
  "schema_call_formed binding_admission_system d t \<longleftrightarrow>
    d\<in>system_definitions binding_admission_system \<and> term_formed t"
  using added_variable_calls[OF row_keys_system_formed
    binding_admission_system_formed[unfolded binding_admission_system_def] row_keys_call]
  by (simp only: binding_admission_system_def[symmetric])

lemma binding_admission_old_meaning:
  assumes "d\<in>system_definitions row_keys_system"
  shows "(d,t)\<in>positive_meaning binding_admission_system \<longleftrightarrow>
    (d,t)\<in>positive_meaning row_keys_system"
  using added_definition_preserves_old(2)[OF row_keys_system_formed
    binding_admission_system_formed[unfolded binding_admission_system_def], of d t] assms
  by (auto simp: binding_admission_system_def)

lemma binding_admission_clause [simp]:
  "((52,c),S)\<in>system_clauses binding_admission_system \<longleftrightarrow> (c,S)\<in>{(0,binding_admission_schema)}"
proof -
  have owned: "((d,c),S)\<in>system_clauses row_keys_system \<Longrightarrow>
    d\<in>system_definitions row_keys_system" for d c S
    using row_keys_system_formed unfolding schema_system_formed_def by blast
  have absent: "((52,c),S)\<notin>system_clauses row_keys_system" by (auto dest: owned)
  show ?thesis using absent by (simp add: binding_admission_system_def)
qed

lemma binding_admission_components:
  "(51,t)\<in>positive_meaning binding_admission_system \<longleftrightarrow> (51,t)\<in>positive_meaning row_keys_system"
  "(1,t)\<in>positive_meaning binding_admission_system \<longleftrightarrow> (1,t)\<in>positive_meaning distinct_payloads_system"
  "(6,t)\<in>positive_meaning binding_admission_system \<longleftrightarrow> (6,t)\<in>positive_meaning bag_comparison_system"
  using binding_admission_old_meaning[of 51 t] binding_admission_old_meaning[of 1 t]
    binding_admission_old_meaning[of 6 t] row_keys_old_meaning[of 1 t] row_keys_old_meaning[of 6 t]
    quotation_admission_old_meaning[of 1 t] payload_disjoint_components(2)[of t]
    quotation_admission_components(8)[of t] by auto

lemma binding_admission_valuation:
  "(52,t)\<in>positive_meaning binding_admission_system \<longleftrightarrow>
    (\<exists>h::nat\<Rightarrow>factor_term. (\<forall>i\<in>{0,1,2}. term_formed (h i)) \<and>
      t=Pair_Term (h 0) (h 1) \<and>
      (51,Pair_Term (h 1) (h 2))\<in>positive_meaning row_keys_system \<and>
      (1,h 0)\<in>positive_meaning distinct_payloads_system \<and>
      (6,Pair_Term (h 2) (h 0))\<in>positive_meaning bag_comparison_system)"
  by (subst ordinary_positive_entry_valuation)
    (auto simp: binding_admission_schema_def schema_variables_def binding_admission_call
      binding_admission_components binding_admission_components[unfolded One_nat_def])

lemma binding_admission_fields:
  "(52,t)\<in>positive_meaning binding_admission_system \<longleftrightarrow>
    (\<exists>v b k. t=Pair_Term v b \<and> (51,Pair_Term b k)\<in>positive_meaning row_keys_system \<and>
      (1,v)\<in>positive_meaning distinct_payloads_system \<and>
      (6,Pair_Term k v)\<in>positive_meaning bag_comparison_system)"
proof
  assume "(52,t)\<in>positive_meaning binding_admission_system"
  then show "\<exists>v b k. t=Pair_Term v b \<and> (51,Pair_Term b k)\<in>positive_meaning row_keys_system \<and>
      (1,v)\<in>positive_meaning distinct_payloads_system \<and>
      (6,Pair_Term k v)\<in>positive_meaning bag_comparison_system"
    by (simp only: binding_admission_valuation) blast
next
  assume "\<exists>v b k. t=Pair_Term v b \<and> (51,Pair_Term b k)\<in>positive_meaning row_keys_system \<and>
      (1,v)\<in>positive_meaning distinct_payloads_system \<and>
      (6,Pair_Term k v)\<in>positive_meaning bag_comparison_system"
  then obtain v b k where parts: "t=Pair_Term v b"
    "(51,Pair_Term b k)\<in>positive_meaning row_keys_system"
    "(1,v)\<in>positive_meaning distinct_payloads_system"
    "(6,Pair_Term k v)\<in>positive_meaning bag_comparison_system" by blast
  have formed: "term_formed v" "term_formed b" "term_formed k"
    using schema_call_formed_target[OF positive_meaning_formed[OF parts(2)]]
      schema_call_formed_target[OF positive_meaning_formed[OF parts(3)]] by auto
  show "(52,t)\<in>positive_meaning binding_admission_system"
    by (simp only: binding_admission_valuation,
      rule exI[of _ "\<lambda>i::nat. if i=0 then v else if i=1 then b else k"])
      (use parts formed in auto)
qed

theorem binding_admission_exact:
  "(52,z)\<in>positive_meaning binding_admission_system \<longleftrightarrow> binding_admission_result z"
proof
  assume holds: "(52,z)\<in>positive_meaning binding_admission_system"
  obtain v b k where fields: "z=Pair_Term v b"
    "(51,Pair_Term b k)\<in>positive_meaning row_keys_system"
    "(1,v)\<in>positive_meaning distinct_payloads_system"
    "(6,Pair_Term k v)\<in>positive_meaning bag_comparison_system"
    using holds by (simp only: binding_admission_fields) blast
  obtain Vs where scope: "v=data_list_term (map Payload_Term Vs)" "distinct Vs" "\<forall>a\<in>set Vs. octets_formed a"
    using distinct_payloads_positive_sound[OF fields(3)] by blast
  obtain ys where rows: "b=pair_list_term ys" "k=data_list_term (map fst ys)" "term_formed (pair_list_term ys)"
    using fields(2) by (auto simp: row_keys_exact)
  have counts: "mset (map fst ys)=mset (map Payload_Term Vs)"
    using fields(4) by (simp only: rows(2) scope(1) bag_comparison_lists)
  have keys: "set (map fst ys)=set (map Payload_Term Vs)" by (rule mset_eq_setD[OF counts])
  have members: "\<forall>y\<in>set ys. \<exists>x. y=(case x of (a,t) \<Rightarrow> (Payload_Term a,t))"
  proof (intro ballI)
    fix y assume member: "y\<in>set ys"
    obtain a where key: "fst y=Payload_Term a" using keys member by auto
    show "\<exists>x. y=(case x of (a,t) \<Rightarrow> (Payload_Term a,t))"
      by (rule exI[of _ "(a,snd y)"]) (cases y; use key in auto)
  qed
  obtain xs where represented: "ys=map (\<lambda>(a,t). (Payload_Term a,t)) xs"
    using list_range_witnesses[of ys "\<lambda>(a,t). (Payload_Term a,t)"] members by blast
  have key_map: "map fst ys=map Payload_Term (map fst xs)"
    by (simp add: represented map_map comp_def case_prod_unfold)
  have same: "mset (map fst xs)=mset Vs"
    using counts by (simp only: key_map injective_mapped_multisets[OF payload_term_inj])
  have table: "distinct xs" "single_valued (set xs)" "rel_dom (set xs)=set Vs"
    using iffD1[OF binding_key_counts[OF scope(2)] same] by auto
  have formed_values: "\<forall>(a,t)\<in>set xs. term_formed t"
    using rows(3)[unfolded represented binding_rows_term_formed] by auto
  show "binding_admission_result z"
    by (rule exI[of _ Vs], rule exI[of _ xs])
      (use fields(1) scope rows(1) represented table formed_values in \<open>auto simp: term_bindings_formed_def\<close>)
next
  assume admitted: "binding_admission_result z"
  obtain Vs xs where parts: "z=Pair_Term (data_list_term (map Payload_Term Vs)) (binding_rows_term xs)"
    "distinct Vs" "distinct xs" "\<forall>a\<in>set Vs. octets_formed a" "term_bindings_formed (set Vs) (set xs)"
    using admitted by blast
  have table: "single_valued (set xs)" "rel_dom (set xs)=set Vs" "\<forall>(a,t)\<in>set xs. term_formed t"
    using parts(5) by (auto simp: term_bindings_formed_def)
  have counts: "mset (map fst xs)=mset Vs"
    using parts(3) table by (simp only: binding_key_counts[OF parts(2)])
  have formed: "term_formed (binding_rows_term xs)"
    by (simp only: binding_rows_term_formed) (use table parts(4) in \<open>auto simp: rel_dom_def\<close>)
  have key_map: "map fst (map (\<lambda>(a,t). (Payload_Term a,t)) xs)=map Payload_Term (map fst xs)"
    by (simp add: map_map comp_def case_prod_unfold)
  have projection: "(51,Pair_Term (binding_rows_term xs) (data_list_term (map Payload_Term (map fst xs))))
      \<in>positive_meaning row_keys_system"
    using row_keys_complete[OF formed] by (simp only: key_map)
  have scope: "(1,data_list_term (map Payload_Term Vs))\<in>positive_meaning distinct_payloads_system"
    by (rule distinct_payloads_positive_complete[OF parts(2,4)])
  have keys_formed: "\<forall>a\<in>set (map fst xs). octets_formed a"
    by (simp only: mset_eq_setD[OF counts]) (rule parts(4))
  have comparison: "(6,Pair_Term (data_list_term (map Payload_Term (map fst xs)))
    (data_list_term (map Payload_Term Vs)))\<in>positive_meaning bag_comparison_system"
    by (simp only: bag_comparison_lists injective_mapped_multisets[OF payload_term_inj])
      (use counts keys_formed parts(4) in auto)
  show "(52,z)\<in>positive_meaning binding_admission_system"
    by (simp only: binding_admission_fields, rule exI[of _ "data_list_term (map Payload_Term Vs)"],
      rule exI[of _ "binding_rows_term xs"], rule exI[of _ "data_list_term (map Payload_Term (map fst xs))"])
      (use parts(1) projection scope comparison in blast)
qed

corollary binding_admission_on_values:
  "(52,Pair_Term (data_list_term (map Payload_Term Vs)) (binding_rows_term xs))
    \<in>positive_meaning binding_admission_system \<longleftrightarrow>
    distinct Vs \<and> distinct xs \<and> (\<forall>a\<in>set Vs. octets_formed a) \<and> term_bindings_formed (set Vs) (set xs)"
  by (simp only: binding_admission_exact factor_term.inject binding_rows_term_injective)
    (auto simp: data_list_term_injective injective_mapped_lists[OF payload_term_inj])

corollary binding_admission_orders:
  assumes "mset Vs=mset Ws" "mset xs=mset ys"
  shows "(52,Pair_Term (data_list_term (map Payload_Term Vs)) (binding_rows_term xs))
      \<in>positive_meaning binding_admission_system \<longleftrightarrow>
    (52,Pair_Term (data_list_term (map Payload_Term Ws)) (binding_rows_term ys))
      \<in>positive_meaning binding_admission_system"
  using mset_eq_imp_distinct_iff[OF assms(1)] mset_eq_imp_distinct_iff[OF assms(2)]
    mset_eq_setD[OF assms(1)] mset_eq_setD[OF assms(2)]
  by (simp only: binding_admission_on_values)

lemma key_values_singleton:
  assumes "distinct xs" "single_valued (set xs)"
  shows "key_values k xs=[t] \<longleftrightarrow> (k,t)\<in>set xs"
proof
  assume "key_values k xs=[t]"
  then show "(k,t)\<in>set xs" using key_values_set[of k xs] by auto
next
  assume row: "(k,t)\<in>set xs"
  have members: "set (key_values k xs)={t}"
    using row assms(2) by (auto simp: key_values_set single_valued_def)
  show "key_values k xs=[t]"
    by (rule distinct_singleton_enumeration[OF key_values_distinct[OF assms(1)] members])
qed

corollary binding_admission_fibre:
  assumes table: "(52,Pair_Term (data_list_term (map Payload_Term Vs)) (binding_rows_term xs))
      \<in>positive_meaning binding_admission_system"
  shows "(28,key_fibre_argument (Payload_Term a) (binding_rows_term xs) (data_list_term [t]))
      \<in>positive_meaning key_fibre_system \<longleftrightarrow> (a,t)\<in>set xs"
proof -
  have scope: "distinct xs" "\<forall>a\<in>set Vs. octets_formed a" "term_bindings_formed (set Vs) (set xs)"
    using table[unfolded binding_admission_on_values] by auto
  have single: "single_valued (set xs)" using scope(3) by (simp add: term_bindings_formed_def)
  have domain: "rel_dom (set xs)=set Vs" using scope(3) by (simp add: term_bindings_formed_def)
  have keys: "octets_formed j" if "(j,v)\<in>set xs" for j v
  proof -
    have member: "j\<in>rel_dom (set xs)" using that by (auto simp: rel_dom_def)
    have "j\<in>set Vs" using member by (simp only: domain)
    then show ?thesis using scope(2) by blast
  qed
  have formed: "formed_key_rows (map (\<lambda>(a,t). (Payload_Term a,t)) xs)"
    using scope(3) by (auto simp: term_bindings_formed_def dest: keys)
  have mapped: "key_values (Payload_Term a) (map (\<lambda>(j,v). (Payload_Term j,v)) xs)=key_values a xs"
    using key_values_map[OF payload_term_inj, where k=a and g=id and xs=xs] by simp
  have singleton: "[t]=key_values a xs \<longleftrightarrow> (a,t)\<in>set xs"
    using key_values_singleton[OF scope(1) single, of a t] by auto
  show ?thesis by (simp only: key_fibre_lists mapped data_list_term_injective singleton)
    (use formed in \<open>auto dest: keys\<close>)
qed

corollary binding_admission_lookup:
  assumes "(52,Pair_Term (data_list_term (map Payload_Term Vs)) (binding_rows_term xs))
      \<in>positive_meaning binding_admission_system" "a\<in>set Vs"
  shows "\<exists>!t. (a,t)\<in>set xs \<and> term_formed t"
proof -
  have bindings: "term_bindings_formed (set Vs) (set xs)"
    using assms(1) by (simp only: binding_admission_on_values)
  have member: "a\<in>rel_dom (set xs)" using bindings assms(2) by (simp add: term_bindings_formed_def)
  obtain t where row: "(a,t)\<in>set xs" using member by (auto simp: rel_dom_def)
  have formed: "term_formed t" using bindings row by (auto simp: term_bindings_formed_def)
  show ?thesis by (rule ex1I[of _ t])
    (use row formed bindings in \<open>auto simp: term_bindings_formed_def single_valued_def\<close>)
qed

corollary binding_admission_singleton:
