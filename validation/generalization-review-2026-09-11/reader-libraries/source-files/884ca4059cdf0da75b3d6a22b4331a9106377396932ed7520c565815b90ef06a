theory Factor_Chained_Investigation
  imports "Factor_Set_Frontier_Generation"
begin

section \<open>A constructed call becomes a possible premise for later construction\<close>

fun finite_construction_frontier where
  "finite_construction_frontier 0 L C=C"
| "finite_construction_frontier (Suc n) L C=
    (let D=finite_construction_frontier n L C in
      D |\<union>| fimage fst (finite_generated_rules_on_set L D))"

lemma finite_construction_frontier_retains:
  "C |\<subseteq>| finite_construction_frontier n L C"
  by (induction n) (auto simp: Let_def)

lemma finite_construction_step_formed:
  "fBall (C |\<union>| fimage fst (finite_generated_rules_on_set L C))
      (\<lambda>q. finite_term_formed (snd q)) \<longleftrightarrow> fBall C (\<lambda>q. finite_term_formed (snd q))"
  using finite_generated_set_conclusion_formed
  by (auto split: prod.splits)

theorem finite_construction_frontier_formed:
  "fBall (finite_construction_frontier n L C) (\<lambda>q. finite_term_formed (snd q)) \<longleftrightarrow>
    fBall C (\<lambda>q. finite_term_formed (snd q))"
  by (induction n) (simp_all only: finite_construction_frontier.simps Let_def finite_construction_step_formed)

definition finite_chained_investigation where
  "finite_chained_investigation n L C K goals=
    finite_learned_investigation_on_set L (finite_construction_frontier n L (fset_of_list C)) K goals"

theorem finite_chained_zero:
  "finite_chained_investigation 0 L C K goals=finite_learned_investigation L C K goals"
  by (simp only: finite_chained_investigation_def finite_construction_frontier.simps
    finite_learned_investigation_on_lists)

theorem finite_chained_original_formation:
  "fst (finite_chained_investigation n L C K goals)=fst (finite_learned_investigation L C K goals)"
  by (simp add: finite_chained_investigation_def finite_learned_investigation_on_set_def
    finite_learned_investigation_def Let_def finite_construction_frontier_formed fset_of_list.rep_eq)

theorem finite_chained_closure_sound:
  assumes library: "\<And>d S ps t. (d,S,ps)\<in>set L \<Longrightarrow>
      schema_rule_instance (decode_finite_schema S) (positive_meaning P) t \<Longrightarrow> (d,t)\<in>positive_meaning P"
    and known: "image decode_finite_call_term (fset K)\<subseteq>positive_meaning P"
  shows "image decode_finite_call_term (finite_inference_result
      (finite_generated_rules_on_set L (finite_construction_frontier n L (fset_of_list C))) K)
    \<subseteq>positive_meaning P"
  by (rule finite_generated_set_closure_sound[OF library known])

definition natural_chained_investigation where
  "natural_chained_investigation n
    (L::(nat\<times>(nat,nat,nat) finite_factor_schema\<times>(nat\<times>nat\<times>nat finite_term_pattern) list) list)
    C K (goals::(nat\<times>nat\<times>finite_factor_term) fset)=finite_chained_investigation n L C K goals"

definition natural_construction_frontier where
  "natural_construction_frontier n
    (L::(nat\<times>(nat,nat,nat) finite_factor_schema\<times>(nat\<times>nat\<times>nat finite_term_pattern) list) list)
    (C::(nat\<times>finite_factor_term) fset)=finite_construction_frontier n L C"

text \<open>
  Zero extra construction rounds is exactly the original investigation.
  Each further round adds generated conclusions to the possible frontier;
  it never adds them to the known set. Every application still retains its
  complete premises, so later constructions remain conditional on the same
  missing evidence. Original malformed inputs continue to reject the report.

  The explicit bound makes this computation terminate. It does not claim
  saturation or completeness for an unbounded language: a recursive list
  constructor can produce lists of every finite length.
\<close>

export_code natural_construction_frontier natural_chained_investigation checking SML

end
