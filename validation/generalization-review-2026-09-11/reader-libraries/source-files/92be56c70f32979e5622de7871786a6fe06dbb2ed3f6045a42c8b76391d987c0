theory Factor_Admission_Plan_Exact
  imports "Factor_Admission_Plan_Readings"
begin

theorem admission_plan_sound:
  assumes holds: "(341,z)\<in>positive_meaning admission_plan_system"
  shows "admission_plan_result z"
proof -
  have invariant: "(341::nat)=341 \<longrightarrow> admission_plan_result z"
  proof (rule positive_valuation_induct[OF holds, where property="\<lambda>d t. d=341 \<longrightarrow> admission_plan_result t"])
    fix d c S h
    assume clause: "((d,c),S)\<in>system_clauses admission_plan_system"
      and assignment: "\<forall>a\<in>schema_variables S. term_formed (h a)"
      and head: "schema_call_formed admission_plan_system d (evaluate_pattern h (schema_conclusion S))"
      and support: "\<forall>s e p. (s,e,p)\<in>schema_premises S \<longrightarrow>
        (e,evaluate_pattern h p)\<in>positive_meaning admission_plan_system \<and>
        (e=341 \<longrightarrow> admission_plan_result (evaluate_pattern h p))"
    show "d=341 \<longrightarrow> admission_plan_result (evaluate_pattern h (schema_conclusion S))"
    proof
      assume root: "d=341"
      consider (leaf) "S=admission_leaf_plan_schema" | (pair) "S=admission_pair_plan_schema"
        | (collection) "S=admission_list_plan_schema"
        using clause root by (auto simp: admission_plan_clauses_def)
      then show "admission_plan_result (evaluate_pattern h (schema_conclusion S))"
      proof cases
        case leaf
        have counters: "(340,h 0)\<in>positive_meaning admission_plan_system"
          "(340,h 1)\<in>positive_meaning admission_plan_system"
          using support by (auto simp: leaf admission_leaf_plan_schema_def)
        obtain a n where fields: "h 0=admission_counter a" "h 1=admission_counter n"
          using counters by (simp only: admission_plan_counter_exact; blast)
        show ?thesis unfolding admission_plan_result_def
          by (rule exI[of _ "Existing_Admission a"], rule exI[of _ n], rule exI[of _ a],
            rule exI[of _ n], rule exI[of _ "[]"])
            (use fields in \<open>simp add: leaf admission_leaf_plan_schema_def\<close>)
      next
        case pair
        have left: "admission_plan_result (admission_plan_argument (h 0) (h 2) (h 5) (h 6) (h 7))"
          and right: "admission_plan_result (admission_plan_argument (h 1) (h 6) (h 8) (h 3) (h 9))"
          using support by (auto simp: pair admission_pair_plan_schema_def)
        have join: "(46,collection_join_argument (h 7) (h 9) (h 10))\<in>positive_meaning data_append_system"
          and final: "(46,collection_join_argument (h 10)
            (data_list_term [data_list_term [h 3,h 5,h 8]]) (h 4))\<in>positive_meaning data_append_system"
          using support by (auto simp: pair admission_pair_plan_schema_def admission_plan_append_meaning)
        obtain g n a m xs where first: "admission_plan g n=(a,m,xs)"
          "h 0=admission_goal_value g" "h 2=admission_counter n" "h 5=admission_counter a"
          "h 6=admission_counter m" "h 7=data_list_term (map admission_instruction_value xs)"
          using left by (simp only: admission_plan_result_def factor_term.inject) blast
        obtain q b k ys where second: "admission_plan q m=(b,k,ys)"
          "h 1=admission_goal_value q" "h 8=admission_counter b" "h 3=admission_counter k"
          "h 9=data_list_term (map admission_instruction_value ys)"
          using right by (simp only: admission_plan_result_def first(5) factor_term.inject admission_counter_injective) blast
        have middle: "h 10=data_list_term (map admission_instruction_value xs@map admission_instruction_value ys)"
          using join by (simp only: first(6) second(5) data_append_at_lists; blast)
        have result_fields: "h 4=data_list_term (map admission_instruction_value
            (xs@ys@[Pair_Admission_Instruction k a b]))"
          using final by (simp only: middle second(4,3) first(4) data_append_at_lists
            map_append append_assoc list.map admission_instruction_value.simps; blast)
        show ?thesis unfolding admission_plan_result_def
          by (rule exI[of _ "Paired_Admission g q"], rule exI[of _ n], rule exI[of _ k],
            rule exI[of _ "Suc k"], rule exI[of _ "xs@ys@[Pair_Admission_Instruction k a b]"])
            (use first second result_fields in \<open>simp add: pair admission_pair_plan_schema_def\<close>)
      next
        case collection
        have child: "admission_plan_result (admission_plan_argument (h 0) (h 1) (h 4) (h 2) (h 5))"
          and final: "(46,collection_join_argument (h 5) (data_list_term [data_list_term [h 2,h 4]]) (h 3))
            \<in>positive_meaning data_append_system"
          using support by (auto simp: collection admission_list_plan_schema_def admission_plan_append_meaning)
        obtain g n a m xs where first: "admission_plan g n=(a,m,xs)"
          "h 0=admission_goal_value g" "h 1=admission_counter n" "h 4=admission_counter a"
          "h 2=admission_counter m" "h 5=data_list_term (map admission_instruction_value xs)"
          using child by (simp only: admission_plan_result_def factor_term.inject) blast
        have result_fields: "h 3=data_list_term (map admission_instruction_value (xs@[List_Admission_Instruction m a]))"
          using final by (simp only: first(6,5,4) data_append_at_lists map_append append_assoc list.map admission_instruction_value.simps; blast)
        show ?thesis unfolding admission_plan_result_def
          by (rule exI[of _ "Collected_Admission g"], rule exI[of _ n], rule exI[of _ m],
            rule exI[of _ "Suc m"], rule exI[of _ "xs@[List_Admission_Instruction m a]"])
            (use first result_fields in \<open>simp add: collection admission_list_plan_schema_def\<close>)
      qed
    qed
  qed
  show ?thesis using invariant by simp
qed

theorem admission_plan_complete:
  assumes plan: "admission_plan g n=(d,k,xs)"
  shows "(341,admission_plan_argument (admission_goal_value g) (admission_counter n)
    (admission_counter d) (admission_counter k) (data_list_term (map admission_instruction_value xs)))
    \<in>positive_meaning admission_plan_system"
  using plan
proof (induction g arbitrary: n d k xs)
  case (Existing_Admission a)
  have fields: "d=a" "k=n" "xs=[]" using Existing_Admission.prems by auto
  let ?h="\<lambda>i::nat. if i=0 then admission_counter a else admission_counter n"
  have result: "(341,evaluate_pattern ?h (schema_conclusion admission_leaf_plan_schema))
      \<in>positive_meaning admission_plan_system"
    by (rule admission_plan_valuation_step[where c=0])
      (auto simp: admission_plan_clauses_def admission_leaf_plan_schema_def schema_variables_def admission_plan_counter_exact)
  show ?case using result by (simp add: fields admission_leaf_plan_schema_def)
next
  case (Paired_Admission g q)
  obtain a m cs where first: "admission_plan g n=(a,m,cs)" by (cases "admission_plan g n") auto
  obtain b l js where second: "admission_plan q m=(b,l,js)" by (cases "admission_plan q m") auto
  have fields: "d=l" "k=Suc l" "xs=cs@js@[Pair_Admission_Instruction l a b]"
    using Paired_Admission.prems by (auto simp: first second)
  have left: "(341,admission_plan_argument (admission_goal_value g) (admission_counter n)
      (admission_counter a) (admission_counter m) (data_list_term (map admission_instruction_value cs)))
      \<in>positive_meaning admission_plan_system"
    by (rule Paired_Admission.IH(1)[OF first])
  have right: "(341,admission_plan_argument (admission_goal_value q) (admission_counter m)
      (admission_counter b) (admission_counter l) (data_list_term (map admission_instruction_value js)))
      \<in>positive_meaning admission_plan_system"
    by (rule Paired_Admission.IH(2)[OF second])
  let ?iv="data_list_term (map admission_instruction_value cs)"
  let ?jv="data_list_term (map admission_instruction_value js)"
  let ?mv="data_list_term (map admission_instruction_value (cs@js))"
  let ?ov="data_list_term (map admission_instruction_value xs)"
  have join: "(46,collection_join_argument ?iv ?jv ?mv)\<in>positive_meaning admission_plan_system"
    by (simp only: admission_plan_append_meaning data_append_lists; auto simp: octets_formed_def)
  have final: "(46,collection_join_argument ?mv
      (data_list_term [admission_instruction_value (Pair_Admission_Instruction l a b)]) ?ov)
      \<in>positive_meaning admission_plan_system"
    by (simp only: admission_plan_append_meaning data_append_lists; auto simp: fields octets_formed_def)
  let ?h="\<lambda>i::nat. if i=0 then admission_goal_value g else if i=1 then admission_goal_value q
    else if i=2 then admission_counter n else if i=3 then admission_counter l else if i=4 then ?ov
    else if i=5 then admission_counter a else if i=6 then admission_counter m else if i=7 then ?iv
    else if i=8 then admission_counter b else if i=9 then ?jv else ?mv"
  have result: "(341,evaluate_pattern ?h (schema_conclusion admission_pair_plan_schema))
      \<in>positive_meaning admission_plan_system"
    by (rule admission_plan_valuation_step[where c=1])
      (use left right join final in \<open>auto simp: admission_plan_clauses_def admission_pair_plan_schema_def
        schema_variables_def data_list_term_formed octets_formed_def\<close>)
  show ?case using result by (simp add: fields admission_pair_plan_schema_def)
next
  case (Collected_Admission g)
  obtain a m cs where first: "admission_plan g n=(a,m,cs)" by (cases "admission_plan g n") auto
  have fields: "d=m" "k=Suc m" "xs=cs@[List_Admission_Instruction m a]"
    using Collected_Admission.prems by (auto simp: first)
  let ?iv="data_list_term (map admission_instruction_value cs)"
  let ?ov="data_list_term (map admission_instruction_value xs)"
  have child: "(341,admission_plan_argument (admission_goal_value g) (admission_counter n)
      (admission_counter a) (admission_counter m) ?iv)\<in>positive_meaning admission_plan_system"
    by (rule Collected_Admission.IH[OF first])
  have final: "(46,collection_join_argument ?iv
      (data_list_term [admission_instruction_value (List_Admission_Instruction m a)]) ?ov)
      \<in>positive_meaning admission_plan_system"
    by (simp only: admission_plan_append_meaning data_append_lists; auto simp: fields octets_formed_def)
  let ?h="\<lambda>i::nat. if i=0 then admission_goal_value g else if i=1 then admission_counter n
    else if i=2 then admission_counter m else if i=3 then ?ov else if i=4 then admission_counter a else ?iv"
  have result: "(341,evaluate_pattern ?h (schema_conclusion admission_list_plan_schema))
      \<in>positive_meaning admission_plan_system"
    by (rule admission_plan_valuation_step[where c=2])
      (use child final in \<open>auto simp: admission_plan_clauses_def admission_list_plan_schema_def
        schema_variables_def data_list_term_formed octets_formed_def\<close>)
  show ?case using result by (simp add: fields admission_list_plan_schema_def)
qed

theorem admission_plan_exact:
  "(341,z)\<in>positive_meaning admission_plan_system \<longleftrightarrow> admission_plan_result z"
  using admission_plan_sound admission_plan_complete by (auto simp: admission_plan_result_def)

export_code admission_plan checking SML

end
