theory Factor_Pattern_Binding_Keys
  imports "Factor_Schema_Pattern_Boundary"
begin

section \<open>Changing source keys retains the complete replacement patterns\<close>

definition rekey_pattern_bindings ::
  "('a\<Rightarrow>'c)\<Rightarrow>('a\<times>'b term_pattern) set\<Rightarrow>('c\<times>'b term_pattern) set" where
  "rekey_pattern_bindings f V=(\<lambda>(a,p). (f a,p)) ` V"

lemma rekey_pattern_bindings_domain [simp]:
  "rel_dom (rekey_pattern_bindings f V)=f ` rel_dom V"
  by (simp add: rekey_pattern_bindings_def pair_image_domain)

lemma rekey_pattern_bindings_variables [simp]:
  "pattern_binding_variables (rekey_pattern_bindings f V)=pattern_binding_variables V"
  by (simp add: pattern_binding_variables_def rekey_pattern_bindings_def pair_image_range)

lemma rekey_pattern_bindings_composes:
  "rekey_pattern_bindings g (rekey_pattern_bindings f V)=rekey_pattern_bindings (g\<circ>f) V"
  by (simp add: rekey_pattern_bindings_def image_image split_def comp_def)

lemma rekey_pattern_bindings_restores:
  assumes "\<And>a p. (a,p)\<in>V \<Longrightarrow> g (f a)=a"
  shows "rekey_pattern_bindings g (rekey_pattern_bindings f V)=V"
  using assms by (auto simp: rekey_pattern_bindings_def image_iff; force)

lemma rekey_pattern_bindings_formed:
  assumes formed: "pattern_bindings_formed B V" and injective: "inj_on f B"
  shows "pattern_bindings_formed (f ` B) (rekey_pattern_bindings f V)"
proof -
  have sv: "single_valued V" and domain: "rel_dom V=B"
    using formed by (auto simp: pattern_bindings_formed_def)
  have functional: "single_valued (rekey_pattern_bindings f V)"
    using single_valued_pair_image[OF sv, where f=f and g=id] injective domain
    by (simp add: rekey_pattern_bindings_def)
  show ?thesis using formed functional
    by (auto simp: pattern_bindings_formed_def rekey_pattern_bindings_def pair_image_domain)
qed

lemma rekey_pattern_bindings_value:
  assumes formed: "pattern_bindings_formed B V" and injective: "inj_on f B" and key: "a\<in>B"
  shows "rel_value (rekey_pattern_bindings f V) (f a)=rel_value V a"
proof -
  have sv: "single_valued (rekey_pattern_bindings f V)"
    using rekey_pattern_bindings_formed[OF formed injective] by (simp add: pattern_bindings_formed_def)
  have row: "(f a,rel_value V a)\<in>rekey_pattern_bindings f V"
    using pattern_binding_at(1)[OF formed key] by (auto simp: rekey_pattern_bindings_def)
  show ?thesis by (rule rel_value_eq[OF sv row])
qed

lemma rekey_pattern_bindings_values:
  "map_relation_values h (rekey_pattern_bindings f V)=
    rename_term_bindings f (map_relation_values h V)"
  by (auto simp: rekey_pattern_bindings_def rename_term_bindings_def map_relation_values_def)

section \<open>The same coordinate change acts on every field of a schema\<close>

lemma schema_substitute_coordinates:
  "schema_substitute s (rename_schema f h g S)=
    rename_schema id h g (schema_substitute (s\<circ>f) S)"
  by (simp add: schema_substitute_def rename_schema_def map_socket_graph_def map_prod_def
    image_image split_def rename_pattern_def pattern_substitute_composes
    material_substitute_renaming[symmetric] material_substitute_composes comp_def)

theorem schema_substitute_rekeyed_bindings:
  assumes bindings: "pattern_bindings_formed (schema_variables S) V"
    and injective: "inj_on f (schema_variables S)"
  shows "schema_substitute (rel_value (rekey_pattern_bindings f V)) (rename_schema f h g S)=
    rename_schema id h g (schema_substitute (rel_value V) S)"
proof -
  have same: "schema_substitute (rel_value (rekey_pattern_bindings f V)\<circ>f) S=
      schema_substitute (rel_value V) S"
    by (rule schema_substitute_cong)
      (simp only: comp_apply; rule rekey_pattern_bindings_value[OF bindings injective]; assumption)
  show ?thesis by (simp only: schema_substitute_coordinates same)
qed

text \<open>
  This changes the source binder keys. It leaves the replacement patterns and
  all their target variables intact. The substitution equation covers the
  conclusion, every ordinary premise, and all five material operands together.
  Injectivity is required only on the original complete source binder.
\<close>

end
