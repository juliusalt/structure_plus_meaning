theory Factor_Admission_Plan_Clauses
  imports "Factor_Admission_Plans" "Finite_Investigation_a24c220cc9c60a2a4f495caf.Factor_Data_List_Operations"
begin

abbreviation admission_plan_argument where
  "admission_plan_argument g n d k is \<equiv>
    Pair_Term (Pair_Term g n) (Pair_Term d (Pair_Term k is))"

abbreviation admission_plan_pattern where
  "admission_plan_pattern g n d k is \<equiv>
    Pattern_Pair (Pattern_Pair g n) (Pattern_Pair d (Pattern_Pair k is))"

definition admission_leaf_plan_schema :: "(nat,nat,nat) factor_schema" where
  "admission_leaf_plan_schema=data_rule
    (admission_plan_pattern (Pattern_Pair (Pattern_Payload [0]) data_x) data_y data_x data_y (Pattern_Payload []))
    {(0,340,data_x),(1,340,data_y)}"

definition admission_pair_plan_schema :: "(nat,nat,nat) factor_schema" where
  "admission_pair_plan_schema=data_rule
    (admission_plan_pattern (Pattern_Pair (Pattern_Payload [1]) (Pattern_Pair data_x data_y)) data_z
      data_w (Pattern_Pair (Pattern_Payload []) data_w) (Pattern_Variable 4))
    {(0,341,admission_plan_pattern data_x data_z (Pattern_Variable 5) (Pattern_Variable 6) (Pattern_Variable 7)),
     (1,341,admission_plan_pattern data_y (Pattern_Variable 6) (Pattern_Variable 8) data_w (Pattern_Variable 9)),
     (2,46,collection_join_pattern (Pattern_Variable 7) (Pattern_Variable 9) (Pattern_Variable 10)),
     (3,46,collection_join_pattern (Pattern_Variable 10)
       (data_list_pattern [data_list_pattern [data_w,Pattern_Variable 5,Pattern_Variable 8]]) (Pattern_Variable 4))}"

definition admission_list_plan_schema :: "(nat,nat,nat) factor_schema" where
  "admission_list_plan_schema=data_rule
    (admission_plan_pattern (Pattern_Pair (Pattern_Payload [2]) data_x) data_y
      data_z (Pattern_Pair (Pattern_Payload []) data_z) data_w)
    {(0,341,admission_plan_pattern data_x data_y (Pattern_Variable 4) data_z (Pattern_Variable 5)),
     (1,46,collection_join_pattern (Pattern_Variable 5)
       (data_list_pattern [data_list_pattern [data_z,Pattern_Variable 4]]) data_w)}"

definition admission_plan_clauses :: "(nat\<times>(nat,nat,nat) factor_schema) set" where
  "admission_plan_clauses={(0,admission_leaf_plan_schema),(1,admission_pair_plan_schema),(2,admission_list_plan_schema)}"

definition admission_counter_element_system :: "(nat,nat,nat,nat) schema_system" where
  "admission_counter_element_system=add_view_definition data_append_system 339 data_x {(0,data_list_nil_schema)}"

definition admission_counter_system :: "(nat,nat,nat,nat) schema_system" where
  "admission_counter_system=add_view_definition admission_counter_element_system 340 data_x (list_profile_clauses 339 340)"

definition admission_plan_system :: "(nat,nat,nat,nat) schema_system" where
  "admission_plan_system=add_view_definition admission_counter_system 341 data_x admission_plan_clauses"

lemmas admission_plan_schema_defs=admission_leaf_plan_schema_def admission_pair_plan_schema_def
  admission_list_plan_schema_def

lemma admission_counter_element_formed [simp]: "schema_system_formed admission_counter_element_system"
  unfolding admission_counter_element_system_def
  by (rule add_recursive_definition_formed[OF data_append_system_formed])
    (auto simp: data_list_nil_schema_def schema_formed_def schema_dependencies_def
      single_valued_def rel_ran_def octets_formed_def)

lemma admission_counter_element_definitions [simp]:
  "system_definitions admission_counter_element_system=insert 339 (system_definitions data_append_system)"
  by (simp add: admission_counter_element_system_def)

lemma admission_counter_formed [simp]: "schema_system_formed admission_counter_system"
  unfolding admission_counter_system_def
  by (rule add_recursive_definition_formed[OF admission_counter_element_formed])
    (auto simp: list_profile_clauses_def data_list_nil_schema_def list_step_schema_def
      schema_formed_def schema_dependencies_def single_valued_def rel_ran_def octets_formed_def)

lemma admission_counter_definitions [simp]:
  "system_definitions admission_counter_system=insert 340 (system_definitions admission_counter_element_system)"
  by (simp add: admission_counter_system_def)

lemma admission_plan_formed [simp]: "schema_system_formed admission_plan_system"
  unfolding admission_plan_system_def
  by (rule add_recursive_definition_formed[OF admission_counter_formed])
    (auto simp: admission_plan_clauses_def admission_plan_schema_defs schema_formed_def
      schema_dependencies_def single_valued_def rel_ran_def octets_formed_def)

lemma admission_plan_definitions [simp]:
  "system_definitions admission_plan_system=insert 341 (system_definitions admission_counter_system)"
  by (simp add: admission_plan_system_def)

lemma admission_counter_element_call:
  "schema_call_formed admission_counter_element_system d t \<longleftrightarrow>
    d\<in>system_definitions admission_counter_element_system \<and> term_formed t"
  using added_variable_calls[OF data_append_system_formed
    admission_counter_element_formed[unfolded admission_counter_element_system_def] data_append_call]
  by (simp only: admission_counter_element_system_def[symmetric])

lemma admission_counter_call:
  "schema_call_formed admission_counter_system d t \<longleftrightarrow>
    d\<in>system_definitions admission_counter_system \<and> term_formed t"
  using added_variable_calls[OF admission_counter_element_formed
    admission_counter_formed[unfolded admission_counter_system_def] admission_counter_element_call]
  by (simp only: admission_counter_system_def[symmetric])

lemma admission_plan_call:
  "schema_call_formed admission_plan_system d t \<longleftrightarrow>
    d\<in>system_definitions admission_plan_system \<and> term_formed t"
  using added_variable_calls[OF admission_counter_formed
    admission_plan_formed[unfolded admission_plan_system_def] admission_counter_call]
  by (simp only: admission_plan_system_def[symmetric])

lemma admission_plan_entry_clauses [simp]:
  "((341,c),S)\<in>system_clauses admission_plan_system \<longleftrightarrow> (c,S)\<in>admission_plan_clauses"
proof -
  have owned: "((d,c),S)\<in>system_clauses admission_counter_system \<Longrightarrow>
      d\<in>system_definitions admission_counter_system" for d c S
    using admission_counter_formed unfolding schema_system_formed_def by blast
  have absent: "((341,c),S)\<notin>system_clauses admission_counter_system"
    by (auto dest: owned)
  show ?thesis using absent by (simp add: admission_plan_system_def)
qed

text \<open>
  The three planning clauses read the stated goal structure, call the planner
  on the actual children, thread the next available entry, and append concrete
  constructor arguments. The second child of a pair starts at the first
  child's returned counter. The parent uses the second child's returned
  counter, so their identities cannot be chosen independently.

  Counter admission uses the existing native list construction with a
  one-literal element predicate. Planning has no host semantic callback,
  registry of successful answers, or list of candidate plans as an input.
  Its exactness, source-dependency conditions, and installed-program contract
  are separate proof obligations.
\<close>

end
