theory Factor_Replay_Values
  imports "Factor_Judgment_Values"
begin

section \<open>One complete environment and three actual sites\<close>

definition replay_value_presents ::
  "local_address option artifact_environment \<Rightarrow> local_address option \<Rightarrow> local_address \<Rightarrow>
    local_address option \<Rightarrow> local_address \<Rightarrow> (local_address option \<times> local_address) \<Rightarrow>
    factor_term \<Rightarrow> bool" where
  "replay_value_presents E pu pr au ar root t \<longleftrightarrow>
    root\<in>environment_positions E \<and>
    (\<exists>j. judgment_value_presents E pu pr au ar j \<and>
      t=Pair_Term j (site_data_term (fst root) (snd root)))"

theorem replay_value_presents_unique:
  assumes first: "replay_value_presents E pu pr au ar root t"
    and second: "replay_value_presents F qu qr bu br other t"
  shows "E=F \<and> pu=qu \<and> pr=qr \<and> au=bu \<and> ar=br \<and> root=other"
proof -
  obtain j where left: "judgment_value_presents E pu pr au ar j"
    "t=Pair_Term j (site_data_term (fst root) (snd root))"
    using first unfolding replay_value_presents_def by blast
  obtain k where right: "judgment_value_presents F qu qr bu br k"
    "t=Pair_Term k (site_data_term (fst other) (snd other))"
    using second unfolding replay_value_presents_def by blast
  have same: "k=j" and roots: "root=other"
    using left(2) right(2) by (auto simp: prod_eq_iff)
  have other: "judgment_value_presents F qu qr bu br j" using right(1) same by simp
  show ?thesis using judgment_value_presents_unique[OF left(1) other] roots by blast
qed

lemma replay_value_presents_formed:
  assumes present: "replay_value_presents E pu pr au ar root t"
  shows "environment_formed E \<and> (pu,pr)\<in>environment_positions E \<and>
    (au,ar)\<in>environment_positions E \<and> root\<in>environment_positions E \<and>
    term_formed t \<and> self_contained_term t"
proof -
  obtain j where fields: "root\<in>environment_positions E" "judgment_value_presents E pu pr au ar j"
    "t=Pair_Term j (site_data_term (fst root) (snd root))"
    using present unfolding replay_value_presents_def by blast
  have formed: "environment_formed E" "term_formed j" "self_contained_term j"
    using judgment_value_presents_formed[OF fields(2)] by auto
  have sites: "(pu,pr)\<in>environment_positions E" "(au,ar)\<in>environment_positions E"
    using fields(2) by (auto simp: judgment_value_presents_def)
  have address: "octets_formed (snd root)"
    using environment_position_address[OF formed(1) fields(1)] by simp
  show ?thesis using fields(1,3) formed sites address by simp
qed

theorem replay_value_presents_total:
  assumes formed: "environment_formed E" and program: "(pu,pr)\<in>environment_positions E"
    and app: "(au,ar)\<in>environment_positions E" and root: "root\<in>environment_positions E"
  shows "\<exists>t. replay_value_presents E pu pr au ar root t"
proof -
  obtain j where present: "judgment_value_presents E pu pr au ar j"
    using judgment_value_presents_total[OF formed program app] by blast
  show ?thesis using present root unfolding replay_value_presents_def by blast
qed

definition replay_value_quoted_at ::
  "exact_artifact \<Rightarrow> local_address \<Rightarrow> local_address option artifact_environment \<Rightarrow>
    local_address option \<Rightarrow> local_address \<Rightarrow> local_address option \<Rightarrow> local_address \<Rightarrow>
    (local_address option \<times> local_address) \<Rightarrow> bool" where
  "replay_value_quoted_at C q E pu pr au ar root \<longleftrightarrow>
    (\<exists>t. replay_value_presents E pu pr au ar root t \<and> complete_data_quoted_at C q t)"

theorem replay_value_whole_unique:
  assumes first: "replay_value_quoted_at C q E pu pr au ar root"
    and second: "replay_value_quoted_at C r F qu qr bu br other"
  shows "q=r \<and> E=F \<and> pu=qu \<and> pr=qr \<and> au=bu \<and> ar=br \<and> root=other"
proof -
  obtain t where left: "replay_value_presents E pu pr au ar root t" "complete_data_quoted_at C q t"
    using first unfolding replay_value_quoted_at_def by blast
  obtain v where right: "replay_value_presents F qu qr bu br other v" "complete_data_quoted_at C r v"
    using second unfolding replay_value_quoted_at_def by blast
  have same: "q=r \<and> t=v" by (rule complete_data_quotation_whole_unique[OF left(2) right(2)])
  have other: "replay_value_presents F qu qr bu br other t" using right(1) same by simp
  show ?thesis using same replay_value_presents_unique[OF left(1) other] by blast
qed

lemma replay_value_quoted_formed:
  assumes quote: "replay_value_quoted_at C q E pu pr au ar root"
  shows "exact_formed C \<and> environment_formed E \<and> (pu,pr)\<in>environment_positions E \<and>
    (au,ar)\<in>environment_positions E \<and> root\<in>environment_positions E"
  using quote replay_value_presents_formed complete_data_quotation_formed
  unfolding replay_value_quoted_at_def by blast

lemma replay_value_quoted_anchor:
  assumes quote: "replay_value_quoted_at C q E pu pr au ar root"
  shows "anchor_formed (C,q)"
  using quote complete_data_quotation_anchor unfolding replay_value_quoted_at_def by blast

theorem replay_value_quoted_total:
  assumes "environment_formed E" "(pu,pr)\<in>environment_positions E"
    "(au,ar)\<in>environment_positions E" "root\<in>environment_positions E"
  shows "\<exists>C. replay_value_quoted_at C [] E pu pr au ar root"
proof -
  obtain t where present: "replay_value_presents E pu pr au ar root t"
    using replay_value_presents_total[OF assms] by blast
  have formed: "term_formed t" and closed: "self_contained_term t"
    using replay_value_presents_formed[OF present] by auto
  show ?thesis using present complete_data_quotation_total[OF formed closed]
    unfolding replay_value_quoted_at_def by blast
qed

theorem replay_value_quoted_in_environment:
  assumes quote: "replay_value_quoted_at C q E pu pr au ar root"
    and formed: "environment_formed F" and source: "artifact_at F u C"
  shows "\<exists>t. replay_value_presents E pu pr au ar root t \<and>
    term_quoted_at F u q t (rra_carrier (object_structure C)) {}"
proof -
  obtain t where present: "replay_value_presents E pu pr au ar root t"
    and full: "complete_data_quoted_at C q t"
    using quote unfolding replay_value_quoted_at_def by blast
  have native: "term_quoted_at F u q t (rra_carrier (object_structure C)) {}"
    by (rule self_contained_quoted_in_environment[OF complete_data_quotation_native[OF full] formed source])
  show ?thesis using present native by blast
qed

text \<open>
  The value contains the complete environment once, its program and call sites,
  and a third site for the proof root. Native readers determine the program,
  call, graph, and assumptions. Those derived values are not stored again.

  Every complete environment presentation is permitted. The whole quotation
  determines its root and every represented field, with no external binding.
  The actual-site conditions alone establish neither a valid graph nor replay.
  This data theory imports no derivation, evidence, or replay semantics.
\<close>

end
