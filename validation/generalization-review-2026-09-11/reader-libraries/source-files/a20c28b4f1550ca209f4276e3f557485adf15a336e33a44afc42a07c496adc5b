theory Factor_Binding_Record_Metadata
  imports "Factor_Binding_Record_Clauses"
begin

section \<open>The same actual record fixes every returned support field\<close>

theorem binding_record_support:
  assumes source: "environment_value_presents E e"
    and raw: "pattern_record_at E v (set Bs) r ps I K"
    and admitted: "(348,binding_record_argument e (use_data_term v) (Payload_Term r)
      (data_list_term (map Payload_Term Bs)) owner bs i k)\<in>positive_meaning binding_record_system"
  shows "distinct Bs \<and> (\<forall>b\<in>set Bs. octets_formed b) \<and>
    (\<exists>Is Ks. i=data_list_term (map Payload_Term Is) \<and> k=data_list_term (map Payload_Term Ks) \<and>
      distinct Is \<and> distinct Ks \<and> set Is=I \<and> set Ks=K)"
proof -
  let ?B="data_list_term (map Payload_Term Bs)"
  let ?xb="map (\<lambda>b. (b,Payload_Term b)) Bs"
  obtain xb yb xs ys where reads:
    "(125,reference_bindings_value ?B xb yb)\<in>positive_meaning reference_bindings_system"
    "(61,pattern_instantiation_argument e (use_data_term v) ?B xb (Payload_Term r) xs ?B i k)
      \<in>positive_meaning record_instantiation_system"
    using admitted by (simp only: binding_record_at_arguments binding_record_calls_def) blast
  have marker: "xb=binding_rows_term ?xb" using reads(1) by (auto simp only: reference_bindings_at_list)
  obtain ts where value_shape: "xs=data_list_term ts"
    using reads(2) by (simp only: record_instantiation_at_source[OF source]) blast
  obtain qs Us Is Ks where fields: "distinct Bs" "\<forall>b\<in>set Bs. octets_formed b"
    "i=data_list_term (map Payload_Term Is)" "k=data_list_term (map Payload_Term Ks)"
    "distinct Is" "distinct Ks" "pattern_record_at E v (set Bs) r qs (set Is) (set Ks)"
    using reads(2) by (simp only: marker value_shape record_instantiation_exact
      record_instantiation_result_on_context[OF source]) blast
  have support: "set Is=I" "set Ks=K"
    using pattern_record_unique[OF fields(7) raw] by auto
  show ?thesis using fields support by blast
qed

text \<open>
  Support is part of the submitted record reading. It is recovered from an
  actual instantiation and agrees with the unique source record, including
  empty boundaries and independently ordered complete support lists.
\<close>

end
