          using record_at_preserves_socket_occurrences[OF rec(6)] by auto
        have separation: "insert r (set [a,b])\<inter>(set L\<union>set Q)={}" "set L\<inter>set Q={}"
          "set Is=insert r (set [a,b]\<union>set L\<union>set Q)"
          using quotation_interior_lists[OF ports left(5) right(5) boundary(3)] comparison by auto
        have outside: "insert r (set [a,b]\<union>set L\<union>set Q)\<inter>(set A\<union>set B\<union>set Vs)={}"
