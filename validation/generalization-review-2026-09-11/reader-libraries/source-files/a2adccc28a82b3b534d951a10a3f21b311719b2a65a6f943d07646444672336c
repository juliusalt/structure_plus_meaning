theory Factor_Pattern_Instantiation
  imports "Factor_Binder_Admission"
begin

section \<open>Actual instantiations retain the source, scope, and complete table\<close>

abbreviation pattern_instantiation_argument ::
  "factor_term \<Rightarrow> factor_term \<Rightarrow> factor_term \<Rightarrow> factor_term \<Rightarrow>
    factor_term \<Rightarrow> factor_term \<Rightarrow> factor_term \<Rightarrow> factor_term \<Rightarrow>
    factor_term \<Rightarrow> factor_term" where
  "pattern_instantiation_argument e u v b r t w i k \<equiv>
    citation_observation_argument e u r
      (Pair_Term (Pair_Term v b) (Pair_Term t (Pair_Term w (Pair_Term i k))))"

abbreviation pattern_instantiation_pattern ::
  "'a term_pattern \<Rightarrow> 'a term_pattern \<Rightarrow> 'a term_pattern \<Rightarrow> 'a term_pattern \<Rightarrow>
    'a term_pattern \<Rightarrow> 'a term_pattern \<Rightarrow> 'a term_pattern \<Rightarrow> 'a term_pattern \<Rightarrow>
    'a term_pattern \<Rightarrow> 'a term_pattern" where
  "pattern_instantiation_pattern e u v b r t w i k \<equiv>
    citation_observation_pattern e u r
      (Pattern_Pair (Pattern_Pair v b) (Pattern_Pair t (Pattern_Pair w (Pattern_Pair i k))))"

abbreviation pattern_instantiation_result :: "factor_term \<Rightarrow> bool" where
  "pattern_instantiation_result z \<equiv> \<exists>E e u Vs xs r p t Us Is Ks.
    z=pattern_instantiation_argument e (use_data_term u) (data_list_term (map Payload_Term Vs))
      (binding_rows_term xs) (Payload_Term r) t (data_list_term (map Payload_Term Us))
      (data_list_term (map Payload_Term Is)) (data_list_term (map Payload_Term Ks)) \<and>
    environment_value_presents E e \<and> distinct Vs \<and> distinct xs \<and> (\<forall>a\<in>set Vs. octets_formed a) \<and>
    term_bindings_formed (set Vs) (set xs) \<and> distinct Us \<and> distinct Is \<and> distinct Ks \<and>
    pattern_quoted_at E u (set Vs) r p (set Is) (set Ks) \<and>
    pattern_variables p=set Us \<and> pattern_instance (set xs) p t"

lemma pattern_instantiation_result_at_source:
  assumes source: "environment_value_presents E e"
  shows "pattern_instantiation_result (pattern_instantiation_argument e u v b r t w i k) \<longleftrightarrow>
    (\<exists>q Vs xs a p Us Is Ks. u=use_data_term q \<and> v=data_list_term (map Payload_Term Vs) \<and>
      b=binding_rows_term xs \<and> r=Payload_Term a \<and> w=data_list_term (map Payload_Term Us) \<and>
      i=data_list_term (map Payload_Term Is) \<and> k=data_list_term (map Payload_Term Ks) \<and>
      distinct Vs \<and> distinct xs \<and> (\<forall>a\<in>set Vs. octets_formed a) \<and> term_bindings_formed (set Vs) (set xs) \<and>
      distinct Us \<and> distinct Is \<and> distinct Ks \<and> pattern_quoted_at E q (set Vs) a p (set Is) (set Ks) \<and>
      pattern_variables p=set Us \<and> pattern_instance (set xs) p t)"
proof
  assume admitted: "pattern_instantiation_result (pattern_instantiation_argument e u v b r t w i k)"
  obtain F q Vs xs a p Us Is Ks where parts: "environment_value_presents F e"
    "u=use_data_term q" "v=data_list_term (map Payload_Term Vs)" "b=binding_rows_term xs" "r=Payload_Term a"
    "w=data_list_term (map Payload_Term Us)" "i=data_list_term (map Payload_Term Is)" "k=data_list_term (map Payload_Term Ks)"
    "distinct Vs" "distinct xs" "\<forall>a\<in>set Vs. octets_formed a" "term_bindings_formed (set Vs) (set xs)"
    "distinct Us" "distinct Is" "distinct Ks" "pattern_quoted_at F q (set Vs) a p (set Is) (set Ks)"
    "pattern_variables p=set Us" "pattern_instance (set xs) p t"
    using admitted by (simp only: factor_term.inject) blast
  have same: "F=E" by (rule environment_value_presents_unique[OF parts(1) source])
  show "\<exists>q Vs xs a p Us Is Ks. u=use_data_term q \<and> v=data_list_term (map Payload_Term Vs) \<and>
      b=binding_rows_term xs \<and> r=Payload_Term a \<and> w=data_list_term (map Payload_Term Us) \<and>
      i=data_list_term (map Payload_Term Is) \<and> k=data_list_term (map Payload_Term Ks) \<and>
      distinct Vs \<and> distinct xs \<and> (\<forall>a\<in>set Vs. octets_formed a) \<and> term_bindings_formed (set Vs) (set xs) \<and>
      distinct Us \<and> distinct Is \<and> distinct Ks \<and> pattern_quoted_at E q (set Vs) a p (set Is) (set Ks) \<and>
      pattern_variables p=set Us \<and> pattern_instance (set xs) p t"
    by (rule exI[of _ q], rule exI[of _ Vs], rule exI[of _ xs], rule exI[of _ a], rule exI[of _ p],
      rule exI[of _ Us], rule exI[of _ Is], rule exI[of _ Ks]) (use parts same in auto)
next
  assume "\<exists>q Vs xs a p Us Is Ks. u=use_data_term q \<and> v=data_list_term (map Payload_Term Vs) \<and>
      b=binding_rows_term xs \<and> r=Payload_Term a \<and> w=data_list_term (map Payload_Term Us) \<and>
      i=data_list_term (map Payload_Term Is) \<and> k=data_list_term (map Payload_Term Ks) \<and>
      distinct Vs \<and> distinct xs \<and> (\<forall>a\<in>set Vs. octets_formed a) \<and> term_bindings_formed (set Vs) (set xs) \<and>
      distinct Us \<and> distinct Is \<and> distinct Ks \<and> pattern_quoted_at E q (set Vs) a p (set Is) (set Ks) \<and>
      pattern_variables p=set Us \<and> pattern_instance (set xs) p t"
  then obtain q Vs xs a p Us Is Ks where parts:
    "u=use_data_term q" "v=data_list_term (map Payload_Term Vs)" "b=binding_rows_term xs" "r=Payload_Term a"
    "w=data_list_term (map Payload_Term Us)" "i=data_list_term (map Payload_Term Is)" "k=data_list_term (map Payload_Term Ks)"
    "distinct Vs" "distinct xs" "\<forall>a\<in>set Vs. octets_formed a" "term_bindings_formed (set Vs) (set xs)"
    "distinct Us" "distinct Is" "distinct Ks" "pattern_quoted_at E q (set Vs) a p (set Is) (set Ks)"
    "pattern_variables p=set Us" "pattern_instance (set xs) p t" by blast
  show "pattern_instantiation_result (pattern_instantiation_argument e u v b r t w i k)"
    by (rule exI[of _ E], rule exI[of _ e], rule exI[of _ q], rule exI[of _ Vs], rule exI[of _ xs],
      rule exI[of _ a], rule exI[of _ p], rule exI[of _ t], rule exI[of _ Us], rule exI[of _ Is], rule exI[of _ Ks])
      (use parts source in auto)
qed

lemma pattern_instantiation_result_on_context:
  assumes source: "environment_value_presents E e"
  shows "pattern_instantiation_result (pattern_instantiation_argument e (use_data_term u)
      (data_list_term (map Payload_Term Vs)) (binding_rows_term xs) (Payload_Term r) t w i k) \<longleftrightarrow>
    distinct Vs \<and> distinct xs \<and> (\<forall>a\<in>set Vs. octets_formed a) \<and> term_bindings_formed (set Vs) (set xs) \<and>
    (\<exists>p Us Is Ks. w=data_list_term (map Payload_Term Us) \<and>
      i=data_list_term (map Payload_Term Is) \<and> k=data_list_term (map Payload_Term Ks) \<and>
      distinct Us \<and> distinct Is \<and> distinct Ks \<and> pattern_quoted_at E u (set Vs) r p (set Is) (set Ks) \<and>
      pattern_variables p=set Us \<and> pattern_instance (set xs) p t)"
  by (subst pattern_instantiation_result_at_source[OF source],
    simp only: binding_rows_term_injective inj_eq[OF use_data_term_injective] factor_term.inject)
    (auto simp: data_list_term_injective injective_mapped_lists[OF payload_term_inj])

