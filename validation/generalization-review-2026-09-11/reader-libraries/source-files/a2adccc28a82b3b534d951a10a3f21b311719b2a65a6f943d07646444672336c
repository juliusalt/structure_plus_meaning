        have slots: "set Ks=set A\<union>set B"
          using calls(6) by (simp only: left(3) right(3) boundary(2) data_union_payload_lists)
        have variables: "set Zs=set Us\<union>set Ws"
          using calls(7) by (simp only: left(1) right(1) used(1) data_union_payload_lists)
        have scope: "set Is\<inter>set Vs={}"
