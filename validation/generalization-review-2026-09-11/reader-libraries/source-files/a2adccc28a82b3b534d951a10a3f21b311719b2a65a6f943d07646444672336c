    d\<in>system_definitions binder_admission_system" for d c S
    using binder_admission_system_formed unfolding schema_system_formed_def by blast
  have absent: "((55,c),S)\<notin>system_clauses binder_admission_system" by (auto dest: owned)
  show ?thesis using absent by (simp add: pattern_instantiation_system_def)
qed

