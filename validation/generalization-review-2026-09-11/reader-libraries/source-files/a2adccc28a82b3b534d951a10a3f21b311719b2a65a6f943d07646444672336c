          by (rule exI[of _ E], rule exI[of _ "h 0"], rule exI[of _ u], rule exI[of _ Vs], rule exI[of _ xs],
            rule exI[of _ r], rule exI[of _ "Pattern_Pair p s"], rule exI[of _ "Pair_Term (h 5) (h 6)"],
            rule exI[of _ Zs], rule exI[of _ Is], rule exI[of _ Ks])
            (use source rec shared left right used boundary variables reading
              in \<open>auto simp: pair_read instantiation_pair_schema_def\<close>)
      qed
    qed
  qed
  show ?thesis using invariant by simp
qed

section \<open>All complete table and metadata presentations are accepted\<close>

lemma instantiation_constant_complete:
  assumes quote: "term_quoted_at E u r t I K" and source: "environment_value_presents E e"
    and table: "(52,Pair_Term (data_list_term (map Payload_Term Vs)) (binding_rows_term xs))
      \<in>positive_meaning binding_admission_system"
    and separate: "I\<inter>set Vs={}" and order: "distinct Is" "distinct Ks"
    and collections: "set Is=I" "set Ks=K"
  shows "(55,pattern_instantiation_argument e (use_data_term u) (data_list_term (map Payload_Term Vs))
      (binding_rows_term xs) (Payload_Term r) t (Payload_Term [])
      (data_list_term (map Payload_Term Is)) (data_list_term (map Payload_Term Ks)))
      \<in>positive_meaning pattern_instantiation_system"
proof -
  have scope: "distinct Vs" "\<forall>a\<in>set Vs. octets_formed a"
    using table[unfolded binding_admission_on_values] by auto
  have quotation: "(50,term_quotation_argument e (use_data_term u) (Payload_Term r) t
      (data_list_term (map Payload_Term Is)) (data_list_term (map Payload_Term Ks)))
      \<in>positive_meaning quotation_admission_system"
    by (rule quotation_admission_complete[OF quote source order collections])
  have boundary: "(49,Pair_Term (data_list_term (map Payload_Term Is)) (data_list_term (map Payload_Term Vs)))
      \<in>positive_meaning payload_disjoint_system"
    by (simp only: payload_disjoint_lists)
      (use scope order collections separate term_quoted_addresses_formed[OF quote] in auto)
  show ?thesis by (rule instantiation_constant_step[OF table quotation boundary])
qed

theorem pattern_instantiation_complete:
  assumes quote: "pattern_quoted_at E u V r p I K" and source: "environment_value_presents E e"
    and table: "(52,Pair_Term (data_list_term (map Payload_Term Vs)) (binding_rows_term xs))
      \<in>positive_meaning binding_admission_system"
    and scope: "set Vs=V" and order: "distinct Us" "distinct Is" "distinct Ks"
    and collections: "set Us=pattern_variables p" "set Is=I" "set Ks=K"
    and inst: "pattern_instance (set xs) p t"
  shows "(55,pattern_instantiation_argument e (use_data_term u) (data_list_term (map Payload_Term Vs))
      (binding_rows_term xs) (Payload_Term r) t (data_list_term (map Payload_Term Us))
      (data_list_term (map Payload_Term Is)) (data_list_term (map Payload_Term Ks)))
      \<in>positive_meaning pattern_instantiation_system"
  using quote source table scope order collections inst
proof (induction arbitrary: e Vs xs t Us Is Ks rule: pattern_quoted_at.induct)
  case (variable R r a I)
  have used: "Us=[a]"
    by (rule distinct_singleton_enumeration[OF variable.prems(4)]) (use variable.prems(7) in simp)
  have slots: "Ks=[]" using variable.prems(9) by simp
  have row: "(a,t)\<in>set xs" using variable.prems(10) by simp
  have citation: "citation_at R r (Local a) (set Is)" using variable.hyps(3) variable.prems(8) by simp
  have reading: "(42,citation_reading_argument e (use_data_term u) (Payload_Term r)
      (Pair_Term (Payload_Term []) (data_list_term [Payload_Term a])) (data_list_term (map Payload_Term Is)))
      \<in>positive_meaning citation_reading_system"
    using citation_reading_complete[OF variable.prems(1) variable.hyps(2) variable.prems(5) citation] by simp
  have lookup: "(28,key_fibre_argument (Payload_Term a) (binding_rows_term xs) (data_list_term [t]))
      \<in>positive_meaning key_fibre_system"
    by (simp only: binding_admission_fibre[OF variable.prems(2)]) (rule row)
  have scope: "distinct Vs" "\<forall>a\<in>set Vs. octets_formed a"
    using variable.prems(2)[unfolded binding_admission_on_values] by auto
  have pattern: "pattern_quoted_at E u V r (Pattern_Variable a) I {}"
    by (rule pattern_quoted_at.variable[OF variable.hyps])
  have boundary: "(49,Pair_Term (data_list_term (map Payload_Term Is)) (data_list_term (map Payload_Term Vs)))
      \<in>positive_meaning payload_disjoint_system"
    by (simp only: payload_disjoint_lists)
      (use scope variable.prems(3,5,8) variable.hyps(5) pattern_quoted_addresses_formed[OF pattern] in auto)
  show ?case using instantiation_variable_step[OF variable.prems(2) reading lookup boundary] by (simp add: used slots)
next
  case (target r x I K)
  have quotation: "term_quoted_at E u r t I K" using target.hyps(1) target.prems(10) by auto
  have separate: "I\<inter>set Vs={}" using target.hyps(2) target.prems(3) by simp
  have used: "Us=[]" using target.prems(7) by simp
  show ?case using instantiation_constant_complete[OF quotation target.prems(1,2) separate target.prems(5,6,8,9)]
    by (simp add: used)
next
  case (pair R r ps l q p L A s Q B)
  obtain x y where inst: "t=Pair_Term x y" "pattern_instance (set xs) p x" "pattern_instance (set xs) s y"
    using pair.prems(10) by auto
  have finite: "finite L" "finite A" "finite Q" "finite B"
    using pattern_quoted_boundary[OF pair.hyps(4)] pattern_quoted_boundary[OF pair.hyps(5)] by auto
  obtain Ls where ls: "set Ls=L" "distinct Ls" using finite_distinct_list[OF finite(1)] by blast
  obtain As where as_rows: "set As=A" "distinct As" using finite_distinct_list[OF finite(2)] by blast
  obtain Qs where qs: "set Qs=Q" "distinct Qs" using finite_distinct_list[OF finite(3)] by blast
  obtain Bs where bs_rows: "set Bs=B" "distinct Bs" using finite_distinct_list[OF finite(4)] by blast
  obtain Ps where ps_rows: "set Ps=pattern_variables p" "distinct Ps"
    using finite_distinct_list[OF pattern_variables_finite[of p]] by blast
  obtain Ss where ss_rows: "set Ss=pattern_variables s" "distinct Ss"
    using finite_distinct_list[OF pattern_variables_finite[of s]] by blast
  have left: "(55,pattern_instantiation_argument e (use_data_term u) (data_list_term (map Payload_Term Vs))
      (binding_rows_term xs) (Payload_Term l) x (data_list_term (map Payload_Term Ps))
      (data_list_term (map Payload_Term Ls)) (data_list_term (map Payload_Term As)))
      \<in>positive_meaning pattern_instantiation_system"
    by (rule pair.IH(1)[OF pair.prems(1-3) ps_rows(2) ls(2) as_rows(2) ps_rows(1) ls(1) as_rows(1) inst(2)])
  have right: "(55,pattern_instantiation_argument e (use_data_term u) (data_list_term (map Payload_Term Vs))
      (binding_rows_term xs) (Payload_Term q) y (data_list_term (map Payload_Term Ss))
      (data_list_term (map Payload_Term Qs)) (data_list_term (map Payload_Term Bs)))
      \<in>positive_meaning pattern_instantiation_system"
    by (rule pair.IH(2)[OF pair.prems(1-3) ss_rows(2) qs(2) bs_rows(2) ss_rows(1) qs(1) bs_rows(1) inst(3)])
  obtain a b where ports: "ps=[a,b]"
    using record_at_preserves_socket_occurrences[OF pair.hyps(3)] by (auto simp: length_Suc_conv)
  have ports_distinct: "distinct [a,b]" "r\<notin>set [a,b]"
    using record_at_preserves_socket_occurrences[OF pair.hyps(3)] by (auto simp: ports)
  have rf: "exact_formed R" using pair.hyps(1,2) by (auto simp: environment_formed_def)
  obtain material where presented: "artifact_value_presents R material" using artifact_value_presents_total[OF rf] by blast
  have lookup: "(37,artifact_lookup_argument e (use_data_term u) material)\<in>positive_meaning artifact_lookup_system"
    using pair.prems(1) pair.hyps(2) presented by (auto simp: artifact_lookup_exact)
  have rec: "(34,rooted_rows_argument material (Payload_Term r)
      (data_list_term [Pair_Term (Payload_Term a) (Payload_Term l),Pair_Term (Payload_Term b) (Payload_Term q)]))
      \<in>positive_meaning record_admission_system"
    by (simp only: record_admission_pair_fields[OF presented]) (use pair.hyps(3) in \<open>auto simp: ports\<close>)
  have pattern: "pattern_quoted_at E u V r (Pattern_Pair p s) (insert r (set ps\<union>L\<union>Q)) (A\<union>B)"
    by (rule pattern_quoted_at.pair[OF pair.hyps])
  have addresses: "\<forall>a\<in>insert r (set ps\<union>L\<union>Q)\<union>(A\<union>B)\<union>pattern_variables (Pattern_Pair p s). octets_formed a"
    by (rule pattern_quoted_addresses_formed[OF pattern])
  have data: "data_elements (map Payload_Term (r#a#b#Ls))" "data_elements (map Payload_Term Qs)"
    "data_elements (map Payload_Term Is)" "data_elements (map Payload_Term Ks)"
    "data_elements (map Payload_Term As)" "data_elements (map Payload_Term Bs)"
    "data_elements (map Payload_Term Ps)" "data_elements (map Payload_Term Ss)" "data_elements (map Payload_Term Us)"
    using addresses by (auto simp: ports ls(1) qs(1) as_rows(1) bs_rows(1) ps_rows(1) ss_rows(1) pair.prems(7-9))
  have comparison: "mset (r#a#b#Ls@Qs)=mset Is"
    using quotation_interior_lists[OF ports_distinct ls(2) qs(2) pair.prems(5)] pair.hyps(6,7) pair.prems(8)
    by (auto simp: ports ls(1) qs(1))
  let ?d="data_list_term (map Payload_Term (r#a#b#Ls))"
  let ?j="data_list_term (map Payload_Term (r#a#b#Ls@Qs))"
  have prefix: "(46,collection_join_argument (data_list_term [Payload_Term r,Payload_Term a,Payload_Term b])
      (data_list_term (map Payload_Term Ls)) ?d)\<in>positive_meaning data_append_system"
    by (simp only: data_append_at_lists) (use data in auto)
  have joined: "(46,collection_join_argument ?d (data_list_term (map Payload_Term Qs)) ?j)\<in>positive_meaning data_append_system"
    by (simp only: data_append_at_lists) (use data in auto)
  have interior: "(6,Pair_Term ?j (data_list_term (map Payload_Term Is)))\<in>positive_meaning bag_comparison_system"
    by (simp only: bag_comparison_lists injective_mapped_multisets[OF payload_term_inj]) (use data comparison in auto)
  have slots: "(48,collection_join_argument (data_list_term (map Payload_Term As))
      (data_list_term (map Payload_Term Bs)) (data_list_term (map Payload_Term Ks)))\<in>positive_meaning data_union_system"
    by (simp only: data_union_payload_lists) (use data pair.prems(9) as_rows(1) bs_rows(1) in auto)
  have used: "(48,collection_join_argument (data_list_term (map Payload_Term Ps))
      (data_list_term (map Payload_Term Ss)) (data_list_term (map Payload_Term Us)))\<in>positive_meaning data_union_system"
    by (simp only: data_union_payload_lists) (use data pair.prems(7) ps_rows(1) ss_rows(1) in auto)
  have boundary: "(49,Pair_Term (data_list_term (map Payload_Term Is)) (data_list_term (map Payload_Term Ks)))
      \<in>positive_meaning payload_disjoint_system"
    by (simp only: payload_disjoint_lists) (use pair.prems(5,6,8,9) pair.hyps(8) addresses in auto)
  have scope_properties: "distinct Vs" "\<forall>a\<in>set Vs. octets_formed a"
    using pair.prems(2)[unfolded binding_admission_on_values] by auto
  have scope: "(49,Pair_Term (data_list_term (map Payload_Term Is)) (data_list_term (map Payload_Term Vs)))
      \<in>positive_meaning payload_disjoint_system"
    by (simp only: payload_disjoint_lists)
      (use scope_properties pair.prems(3,5,8) pair.hyps(8) addresses in auto)
  have distinct_used: "(1,data_list_term (map Payload_Term Us))\<in>positive_meaning distinct_payloads_system"
    by (rule distinct_payloads_positive_complete[OF pair.prems(4)]) (use data in auto)
  show ?case using instantiation_pair_step[OF lookup rec left right prefix joined interior slots used boundary scope distinct_used]
    by (simp only: inst(1))
next
  case (payload r v I K)
  have quotation: "term_quoted_at E u r t I K" using payload.hyps(1) payload.prems(10) by auto
  have separate: "I\<inter>set Vs={}" using payload.hyps(2) payload.prems(3) by simp
  have used: "Us=[]" using payload.prems(7) by simp
  show ?case using instantiation_constant_complete[OF quotation payload.prems(1,2) separate payload.prems(5,6,8,9)]
    by (simp add: used)
qed

theorem pattern_instantiation_exact:
  "(55,z)\<in>positive_meaning pattern_instantiation_system \<longleftrightarrow> pattern_instantiation_result z"
proof
  show "(55,z)\<in>positive_meaning pattern_instantiation_system \<Longrightarrow> pattern_instantiation_result z"
    by (rule pattern_instantiation_sound)
next
  assume admitted: "pattern_instantiation_result z"
  obtain E e u Vs xs r p t Us Is Ks where parts:
    "z=pattern_instantiation_argument e (use_data_term u) (data_list_term (map Payload_Term Vs))
      (binding_rows_term xs) (Payload_Term r) t (data_list_term (map Payload_Term Us))
      (data_list_term (map Payload_Term Is)) (data_list_term (map Payload_Term Ks))"
    "environment_value_presents E e" "distinct Vs" "distinct xs" "\<forall>a\<in>set Vs. octets_formed a"
    "term_bindings_formed (set Vs) (set xs)" "distinct Us" "distinct Is" "distinct Ks"
    "pattern_quoted_at E u (set Vs) r p (set Is) (set Ks)" "pattern_variables p=set Us" "pattern_instance (set xs) p t"
    using admitted by blast
  have table: "(52,Pair_Term (data_list_term (map Payload_Term Vs)) (binding_rows_term xs))
      \<in>positive_meaning binding_admission_system"
    by (simp only: binding_admission_on_values) (use parts(3-6) in blast)
  show "(55,z)\<in>positive_meaning pattern_instantiation_system"
    using pattern_instantiation_complete[OF parts(10,2) table refl parts(7-9) parts(11)[symmetric] refl refl parts(12)]
    by (simp only: parts(1))
qed

corollary pattern_instantiation_at_source:
  assumes source: "environment_value_presents E e"
  shows "(55,pattern_instantiation_argument e u v b r t w i k)\<in>positive_meaning pattern_instantiation_system \<longleftrightarrow>
    (\<exists>q Vs xs a p Us Is Ks. u=use_data_term q \<and> v=data_list_term (map Payload_Term Vs) \<and>
      b=binding_rows_term xs \<and> r=Payload_Term a \<and> w=data_list_term (map Payload_Term Us) \<and>
      i=data_list_term (map Payload_Term Is) \<and> k=data_list_term (map Payload_Term Ks) \<and>
      distinct Vs \<and> distinct xs \<and> (\<forall>a\<in>set Vs. octets_formed a) \<and> term_bindings_formed (set Vs) (set xs) \<and>
      distinct Us \<and> distinct Is \<and> distinct Ks \<and> pattern_quoted_at E q (set Vs) a p (set Is) (set Ks) \<and>
      pattern_variables p=set Us \<and> pattern_instance (set xs) p t)"
  by (simp only: pattern_instantiation_exact pattern_instantiation_result_at_source[OF source])

corollary pattern_instantiation_on_values:
  assumes source: "environment_value_presents E e"
  shows "(55,pattern_instantiation_argument e (use_data_term u) (data_list_term (map Payload_Term Vs))
      (binding_rows_term xs) (Payload_Term r) t (data_list_term (map Payload_Term Us))
      (data_list_term (map Payload_Term Is)) (data_list_term (map Payload_Term Ks)))
      \<in>positive_meaning pattern_instantiation_system \<longleftrightarrow>
    distinct Vs \<and> distinct xs \<and> (\<forall>a\<in>set Vs. octets_formed a) \<and> term_bindings_formed (set Vs) (set xs) \<and>
    distinct Us \<and> distinct Is \<and> distinct Ks \<and>
    (\<exists>p. pattern_quoted_at E u (set Vs) r p (set Is) (set Ks) \<and>
      pattern_variables p=set Us \<and> pattern_instance (set xs) p t)"
  by (subst pattern_instantiation_exact, subst pattern_instantiation_result_on_context[OF source])
    (auto simp: data_list_term_injective injective_mapped_lists[OF payload_term_inj])

corollary pattern_instantiation_presentation_invariance:
  assumes "environment_value_presents E e" "environment_value_presents E f"
  shows "(55,pattern_instantiation_argument e u v b r t w i k)\<in>positive_meaning pattern_instantiation_system \<longleftrightarrow>
    (55,pattern_instantiation_argument f u v b r t w i k)\<in>positive_meaning pattern_instantiation_system"
  by (simp only: pattern_instantiation_at_source[OF assms(1)] pattern_instantiation_at_source[OF assms(2)])

corollary pattern_instantiation_orders:
  assumes source: "environment_value_presents E e"
    and same: "mset Vs=mset Ws" "mset xs=mset ys" "mset Us=mset Zs" "mset Is=mset Js" "mset Ks=mset Ls"
  shows "(55,pattern_instantiation_argument e (use_data_term u) (data_list_term (map Payload_Term Vs))
      (binding_rows_term xs) (Payload_Term r) t (data_list_term (map Payload_Term Us))
      (data_list_term (map Payload_Term Is)) (data_list_term (map Payload_Term Ks)))
      \<in>positive_meaning pattern_instantiation_system \<longleftrightarrow>
    (55,pattern_instantiation_argument e (use_data_term u) (data_list_term (map Payload_Term Ws))
      (binding_rows_term ys) (Payload_Term r) t (data_list_term (map Payload_Term Zs))
      (data_list_term (map Payload_Term Js)) (data_list_term (map Payload_Term Ls)))
      \<in>positive_meaning pattern_instantiation_system"
  using mset_eq_imp_distinct_iff[OF same(1)] mset_eq_imp_distinct_iff[OF same(2)]
    mset_eq_imp_distinct_iff[OF same(3)] mset_eq_imp_distinct_iff[OF same(4)] mset_eq_imp_distinct_iff[OF same(5)]
    mset_eq_setD[OF same(1)] mset_eq_setD[OF same(2)] mset_eq_setD[OF same(3)] mset_eq_setD[OF same(4)] mset_eq_setD[OF same(5)]
  by (simp only: pattern_instantiation_on_values[OF source])

corollary pattern_instantiation_result_unique:
  assumes source: "environment_value_presents E e"
    and first: "(55,pattern_instantiation_argument e (use_data_term u) (data_list_term (map Payload_Term Vs))
      (binding_rows_term xs) (Payload_Term r) t (data_list_term (map Payload_Term Us))
      (data_list_term (map Payload_Term Is)) (data_list_term (map Payload_Term Ks)))\<in>positive_meaning pattern_instantiation_system"
    and second: "(55,pattern_instantiation_argument e (use_data_term u) (data_list_term (map Payload_Term Vs))
      (binding_rows_term xs) (Payload_Term r) s (data_list_term (map Payload_Term Ws))
      (data_list_term (map Payload_Term Js)) (data_list_term (map Payload_Term Ls)))\<in>positive_meaning pattern_instantiation_system"
  shows "t=s \<and> mset Us=mset Ws \<and> mset Is=mset Js \<and> mset Ks=mset Ls"
proof -
  obtain p where left: "term_bindings_formed (set Vs) (set xs)" "distinct Us" "distinct Is" "distinct Ks"
    "pattern_quoted_at E u (set Vs) r p (set Is) (set Ks)" "pattern_variables p=set Us" "pattern_instance (set xs) p t"
    using first by (simp only: pattern_instantiation_on_values[OF source]) blast
  obtain q where right: "distinct Ws" "distinct Js" "distinct Ls"
    "pattern_quoted_at E u (set Vs) r q (set Js) (set Ls)" "pattern_variables q=set Ws" "pattern_instance (set xs) q s"
    using second by (simp only: pattern_instantiation_on_values[OF source]) blast
  have same: "p=q" "set Is=set Js" "set Ks=set Ls" using pattern_quoted_unique[OF left(5) right(4)] by auto
  have variables: "set Us=set Ws" using same(1) left(6) right(5) by simp
  have single: "single_valued (set xs)" using left(1) by (simp add: term_bindings_formed_def)
  have other: "pattern_instance (set xs) p s" using same(1) right(6) by simp
  have terms: "t=s" by (rule pattern_instance_unique[OF single left(7) other])
  show ?thesis using terms variables same(2,3) left(2-4) right(1-3)
    distinct_source_mset[OF left(2), of Ws] distinct_source_mset[OF left(3), of Js] distinct_source_mset[OF left(4), of Ls] by auto
qed

text \<open>
  The actual source determines the pattern. The operand contains that source,
  a declared scope, a complete substitution table, the resulting term, and the
  exact used-variable, interior, and external-slot collections. No new tagged
  pattern representation or substitution callback is introduced.

  Local citations obtain their value from the admitted table's complete key
  fibre. Constant branches reuse term quotation; the independent constant-pattern
  theorem proves this reuse for all variable-free patterns and arbitrary bindings.
  The pair clause is needed for variable-containing pairs. Both recursive calls
  share the same complete scope and table. Their admission already checks those
  operands, so the pair clause has no additional table premise.

  Counted interior comparison forbids repeated syntax occurrences. Membership
  union permits a variable or external slot to occur in both children. Used
  variables and external slots may overlap where the relative grammar permits it;
  the syntax interior is separate from both the slots and declared scope.
  The complete used-variable enumeration is checked independently of the declared
  scope, since the latter may contain unused variables in a relative pattern.

  Every term has an exact contract, every complete source and metadata order is
  covered, and the resulting term and metadata sets are unique. The next extension
  checks the enclosing binder and compiles both entries before future operands.
\<close>

end
