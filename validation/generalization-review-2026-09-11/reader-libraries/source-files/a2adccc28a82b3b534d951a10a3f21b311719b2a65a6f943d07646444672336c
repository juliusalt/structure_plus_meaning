section \<open>Positive meaning recovers exactly the quoted pattern instance\<close>

theorem pattern_instantiation_sound:
  assumes holds: "(55,z)\<in>positive_meaning pattern_instantiation_system"
  shows "pattern_instantiation_result z"
proof -
  have invariant: "(55::nat)=55 \<longrightarrow> pattern_instantiation_result z"
  proof (rule positive_valuation_induct[OF holds, where property="\<lambda>d z. d=55 \<longrightarrow> pattern_instantiation_result z"])
    fix d c S h
    assume clause: "((d,c),S)\<in>system_clauses pattern_instantiation_system"
      and assignment: "\<forall>a\<in>schema_variables S. term_formed (h a)"
      and call: "schema_call_formed pattern_instantiation_system d (evaluate_pattern h (schema_conclusion S))"
      and support: "\<forall>s e p. (s,e,p)\<in>schema_premises S \<longrightarrow>
        (e,evaluate_pattern h p)\<in>positive_meaning pattern_instantiation_system \<and>
        (e=55 \<longrightarrow> pattern_instantiation_result (evaluate_pattern h p))"
    have available: "\<forall>s e p. (s,e,p)\<in>schema_premises S \<longrightarrow>
      (e,evaluate_pattern h p)\<in>positive_meaning pattern_instantiation_system"
      using support by blast
    show "d=55 \<longrightarrow> pattern_instantiation_result (evaluate_pattern h (schema_conclusion S))"
    proof
      assume "d=55"
      then consider (var_read) "S=instantiation_variable_schema" | (constant_read) "S=instantiation_constant_schema"
