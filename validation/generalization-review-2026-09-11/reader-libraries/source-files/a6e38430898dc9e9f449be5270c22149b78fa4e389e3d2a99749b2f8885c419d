theory Factor_Specialization_Report_Reasoning
  imports Factor_Specialization_Reports Factor_Learned_Execution_Soundness Factor_Clause_Rule_Application
begin

section \<open>The native clause supplies a reusable conditional construction\<close>

lemma specialization_report_rule_sound:
  assumes rule: "schema_rule_instance specialization_report_schema (positive_meaning specialization_report_system) t"
  shows "(342,t)\<in>positive_meaning specialization_report_system"
  by (rule positive_variable_clause_rule[OF specialization_report_formed _ _ rule, where c=0 and a=0])
    (auto simp: specialization_report_system_def)

definition finite_specialization_report_schema :: "(nat,nat,nat) finite_factor_schema" where
  "finite_specialization_report_schema=\<lparr>
    finite_schema_conclusion=Finite_Pattern_Pair
      (Finite_Pattern_Pair (Finite_Pattern_Pair (Finite_Variable 0)
        (Finite_Pattern_Pair (Finite_Variable 1) (Finite_Variable 2)))
        (Finite_Pattern_Pair (Finite_Variable 3) (Finite_Variable 4))) (Finite_Variable 5),
    finite_schema_premises=fset_of_list
      [(0,294,Finite_Pattern_Pair (Finite_Pattern_Pair (Finite_Variable 0)
          (Finite_Pattern_Pair (Finite_Variable 1) (Finite_Variable 2)))
          (Finite_Pattern_Pair (Finite_Variable 3) (Finite_Variable 4))),
       (1,126,Finite_Pattern_Pair (Finite_Variable 4) (Finite_Variable 5))],
    finite_schema_materials={||}\<rparr>"

lemma finite_specialization_report_schema_exact:
  "decode_finite_schema finite_specialization_report_schema=specialization_report_schema"
  by (simp add: finite_specialization_report_schema_def specialization_report_schema_def
    decode_finite_schema_def decode_finite_call_pattern_def map_relation_values_def; auto)

definition specialization_report_reasoning_library ::
  "(nat\<times>(nat,nat,nat) finite_factor_schema\<times>(nat\<times>nat\<times>nat finite_term_pattern) list) list" where
  "specialization_report_reasoning_library=[(342,finite_specialization_report_schema,
    [(0,294,Finite_Pattern_Pair (Finite_Pattern_Pair (Finite_Variable 0)
        (Finite_Pattern_Pair (Finite_Variable 1) (Finite_Variable 2)))
        (Finite_Pattern_Pair (Finite_Variable 3) (Finite_Variable 4))),
     (1,126,Finite_Pattern_Pair (Finite_Variable 4) (Finite_Variable 5))])]"

lemma specialization_report_library_member_sound:
  assumes member: "(d,S,ps)\<in>set specialization_report_reasoning_library"
    and rule: "schema_rule_instance (decode_finite_schema S) (positive_meaning specialization_report_system) t"
  shows "(d,t)\<in>positive_meaning specialization_report_system"
  using member rule by (auto simp: specialization_report_reasoning_library_def
    finite_specialization_report_schema_exact intro: specialization_report_rule_sound)

theorem specialization_report_generator_sound:
  "inference_sound (\<lambda>q. decode_finite_call_term q\<in>positive_meaning specialization_report_system)
    (finite_inference_rules (finite_generated_schema_rules specialization_report_reasoning_library C))"
  by (rule finite_generated_schema_rules_sound)
    (rule specialization_report_library_member_sound; assumption)

theorem specialization_report_known_closure_sound:
  assumes "decode_finite_call_term ` fset K\<subseteq>positive_meaning specialization_report_system"
  shows "decode_finite_call_term ` finite_inference_result
      (finite_generated_schema_rules specialization_report_reasoning_library C) K
    \<subseteq>positive_meaning specialization_report_system"
  by (rule finite_learned_closure_sound[OF _ assms])
    (rule specialization_report_library_member_sound; assumption)

definition specialization_report_investigation where
  "specialization_report_investigation C K goals=
    natural_learned_investigation specialization_report_reasoning_library C K goals"

text \<open>
  The existing generator matches the two complete native premises, joins them
  at their shared target site, and constructs a complete report candidate.
  The caller does not supply that conclusion as a rule. Missing evidence for
  either native premise remains a condition of the generated application.
  Formation of a possible source term supplies no semantic evidence for it.

  The finite schema decodes to the actual native clause. Its soundness uses
  the existing positive inference step, and its execution uses the existing
  schema generator and obligation driver. Admission of a whole symbolic
  argument remains a separate composition problem.
\<close>

end
