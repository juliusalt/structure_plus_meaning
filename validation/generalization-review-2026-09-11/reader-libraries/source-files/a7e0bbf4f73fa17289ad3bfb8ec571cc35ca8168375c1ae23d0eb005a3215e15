theory Inference_Abstraction
  imports "Finite_Investigation_a24c220cc9c60a2a4f495caf.Inference_Closure"
begin

section \<open>A projection of every rule bounds every derived result\<close>

theorem inference_closure_projection:
  assumes steps: "\<And>a H. finite H \<Longrightarrow> single_valued H \<Longrightarrow> R a H \<Longrightarrow>
    S (f a) (map_relation_values f H)"
  shows "image f (inference_closure R K) \<subseteq> inference_closure S (image f K)"
proof -
  have sound: "inference_sound (\<lambda>a. f a\<in>inference_closure S (image f K)) R"
  unfolding inference_sound_def
  proof (intro allI impI)
    fix a H
    assume fin: "finite H" and functional: "single_valued H" and rule: "R a H"
      and support: "rel_ran H\<subseteq>{b. f b\<in>inference_closure S (image f K)}"
    have mapped_functional: "single_valued (map_relation_values f H)"
      using functional by (auto simp: single_valued_def; blast)
    have mapped_support: "rel_ran (map_relation_values f H)\<subseteq>inference_closure S (image f K)"
      using support by (auto simp: rel_ran_def)
    show "f a\<in>inference_closure S (image f K)"
      by (rule inference_closure_step[OF _ mapped_functional steps[OF fin functional rule] mapped_support])
        (simp add: fin)
  qed
  have seeds: "K\<subseteq>{a. f a\<in>inference_closure S (image f K)}"
    using inference_closure_seed[of "image f K" S] by blast
  show ?thesis using inference_closure_sound[OF sound seeds] by blast
qed

text \<open>
  The projection may identify different claims. A missing projected result
  therefore excludes the original result; a present projected result need
  not have an original derivation. Every premise occurrence survives the
  projection, and the target rule still requires all its premises.
\<close>

end
