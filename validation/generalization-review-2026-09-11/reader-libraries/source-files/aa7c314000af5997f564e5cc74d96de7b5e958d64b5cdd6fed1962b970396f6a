theory Factor_Inference_Value_Maps
  imports "Factor_Graph_Renaming"
begin

section \<open>One graph retains its occurrences while binding values change\<close>

fun map_inference_node ::
  "('v \<Rightarrow> 'w) \<Rightarrow> ('a,'c,'v) inference_node \<Rightarrow> ('a,'c,'w) inference_node" where
  "map_inference_node f Schema_Assertion=Schema_Assertion"
| "map_inference_node f (Schema_Inference c V)=Schema_Inference c (fimage (map_prod id f) V)"

definition map_inference_values ::
  "('v \<Rightarrow> 'w) \<Rightarrow> ('a,'s,'c,'n,'v) inference_graph \<Rightarrow>
    ('a,'s,'c,'n,'w) inference_graph" where
  "map_inference_values f G=\<lparr>
    graph_inferences=fimage (map_prod id (map_inference_node f)) (graph_inferences G),
    graph_discharges=graph_discharges G\<rparr>"

lemma map_inference_node_identity [simp]: "map_inference_node id A=A"
  by (cases A) (simp_all add: map_prod_def)

lemma map_inference_node_composes:
  "map_inference_node g (map_inference_node f A)=map_inference_node (g \<circ> f) A"
  by (cases A) (simp_all add: fimage_fimage map_prod_def comp_def split_def)

lemma map_inference_node_assertion [simp]:
  "map_inference_node f A=Schema_Assertion \<longleftrightarrow> A=Schema_Assertion"
  by (cases A) auto

lemma map_inference_values_node:
  "(n,A)\<in>fset (graph_inferences (map_inference_values f G)) \<longleftrightarrow>
    (\<exists>N. (n,N)\<in>fset (graph_inferences G) \<and> A=map_inference_node f N)"
  by (auto simp: map_inference_values_def map_prod_def)

lemma map_inference_values_geometry [simp]:
  "graph_discharges (map_inference_values f G)=graph_discharges G"
  "schema_graph_nodes (map_inference_values f G)=schema_graph_nodes G"
  "schema_graph_edges (map_inference_values f G)=schema_graph_edges G"
  "schema_graph_premises (map_inference_values f G) n=schema_graph_premises G n"
  "schema_assertion_uses (map_inference_values f G)=schema_assertion_uses G"
proof -
  have assertions: "(n,Schema_Assertion)\<in>fset (graph_inferences (map_inference_values f G)) \<longleftrightarrow>
      (n,Schema_Assertion)\<in>fset (graph_inferences G)" for n
    by (simp only: map_inference_values_node) (metis map_inference_node_assertion map_inference_node.simps(1))
  show "graph_discharges (map_inference_values f G)=graph_discharges G"
    by (simp add: map_inference_values_def)
  show "schema_graph_nodes (map_inference_values f G)=schema_graph_nodes G"
    by (auto simp: schema_graph_nodes_def rel_dom_def map_inference_values_node)
  show "schema_graph_edges (map_inference_values f G)=schema_graph_edges G"
    by (simp add: schema_graph_edges_def map_inference_values_def)
  show "schema_graph_premises (map_inference_values f G) n=schema_graph_premises G n"
    by (simp add: schema_graph_premises_def map_inference_values_def)
  show "schema_assertion_uses (map_inference_values f G)=schema_assertion_uses G"
    by (simp only: schema_assertion_uses_def assertions) (simp add: map_inference_values_def)
qed

lemma map_inference_values_formed:
  assumes "schema_graph_formed G root"
  shows "schema_graph_formed (map_inference_values f G) root"
proof -
  have sv: "single_valued (fset (graph_inferences (map_inference_values f G)))"
    using assms by (auto simp: map_inference_values_node single_valued_def schema_graph_formed_def; blast)
  show ?thesis using assms sv by (simp add: schema_graph_formed_def)
qed

lemma map_inference_values_identity [simp]: "map_inference_values id G=G"
  by (cases G) (simp add: map_inference_values_def map_prod_def)

lemma map_inference_values_composes:
  "map_inference_values g (map_inference_values f G)=map_inference_values (g \<circ> f) G"
  by (simp add: map_inference_values_def fimage_fimage map_prod_def comp_def split_def
    map_inference_node_composes)

lemma map_inference_values_renaming:
  "map_inference_values f (rename_schema_graph g G)=rename_schema_graph g (map_inference_values f G)"
  by (simp add: map_inference_values_def rename_schema_graph_def fimage_fimage map_prod_def comp_def split_def)

lemma map_relation_values_preserves_functional:
  "single_valued R \<Longrightarrow> single_valued (map_relation_values f R)"
  by (auto simp: single_valued_def; blast)

lemma map_relation_values_value:
  assumes sv: "single_valued R" and key: "k\<in>rel_dom R"
  shows "rel_value (map_relation_values f R) k=f (rel_value R k)"
proof -
  obtain v where row: "(k,v)\<in>R" using key by (auto simp: rel_dom_def)
  have mapped: "(k,f v)\<in>map_relation_values f R" using row by auto
  show ?thesis using rel_value_eq[OF sv row]
    rel_value_eq[OF map_relation_values_preserves_functional[OF sv] mapped] by simp
qed

lemma map_inference_values_assumptions:
  "schema_graph_assumptions (map_inference_values f G) (map_relation_values g J)=
    map_relation_values g (schema_graph_assumptions G J)"
  by (auto simp: schema_graph_assumptions_def map_inference_values_node; metis map_inference_node_assertion)

text \<open>
  Ground proofs and symbolic binding schemes use the same finite graph type.
  Mapping values retains every node, clause occurrence, socket, discharge,
  and assertion use. No injectivity of the value map is needed: even when
  different values become equal, their identified occurrences remain present.
  Private node renaming commutes with that independent change of values.
\<close>

end
