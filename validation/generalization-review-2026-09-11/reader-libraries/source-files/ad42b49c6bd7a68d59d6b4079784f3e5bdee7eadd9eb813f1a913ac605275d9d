section \<open>Preserving decisions includes both outcomes of both observations\<close>

definition program_decisions_agree where
  "program_decisions_agree A x y \<longleftrightarrow> (\<forall>t. A t \<longrightarrow>
    (schema_call_formed (fst x) (snd x) t \<longleftrightarrow> schema_call_formed (fst y) (snd y) t) \<and>
    (((snd x),t)\<in>positive_meaning (fst x) \<longleftrightarrow> ((snd y),t)\<in>positive_meaning (fst y)))"

definition program_decision_observations where
  "program_decision_observations A role x=
    {(t,b). A t \<and> b=(if role then ((snd x),t)\<in>positive_meaning (fst x)
      else schema_call_formed (fst x) (snd x) t)}"

theorem program_decision_observation_comparison:
  "candidate_profile {False,True} (program_decision_observations A) x\<subseteq>
      candidate_profile {False,True} (program_decision_observations A) y \<longleftrightarrow>
    program_decisions_agree A x y"
proof
  assume included: "candidate_profile {False,True} (program_decision_observations A) x\<subseteq>
    candidate_profile {False,True} (program_decision_observations A) y"
  have decision: "(if role then (snd x,t)\<in>positive_meaning (fst x) else schema_call_formed (fst x) (snd x) t)=
      (if role then (snd y,t)\<in>positive_meaning (fst y) else schema_call_formed (fst y) (snd y) t)"
    if domain: "A t" for t role
  proof -
    have recorded: "(role,(t,if role then (snd x,t)\<in>positive_meaning (fst x)
        else schema_call_formed (fst x) (snd x) t))\<in>
      candidate_profile {False,True} (program_decision_observations A) x"
      using domain by (cases role) (simp_all add: program_decision_observations_def)
    have kept: "(role,(t,if role then (snd x,t)\<in>positive_meaning (fst x)
        else schema_call_formed (fst x) (snd x) t))\<in>
      candidate_profile {False,True} (program_decision_observations A) y"
      by (rule subsetD[OF included recorded])
    show ?thesis using kept by (simp add: program_decision_observations_def)
  qed
  show "program_decisions_agree A x y"
    using decision[where role=False] decision[where role=True]
    by (auto simp: program_decisions_agree_def)
next
  assume agreement: "program_decisions_agree A x y"
  have observed: "program_decision_observations A role x=program_decision_observations A role y" for role
    using agreement by (cases role) (auto simp: program_decision_observations_def program_decisions_agree_def)
  show "candidate_profile {False,True} (program_decision_observations A) x\<subseteq>
      candidate_profile {False,True} (program_decision_observations A) y"
    by (auto simp: candidate_profile_def observed)
qed

theorem program_decision_observation_basis:
  "comparison_basis C (program_decisions_agree A) {False,True} (program_decision_observations A)"
  by (simp only: comparison_basis_def program_decision_observation_comparison; simp)

theorem program_decision_comparison_reduction:
  "exact_obligation_reduction UNIV
    (\<lambda>z. program_decisions_agree A (fst z) (snd z))
    (profile_condition (program_decision_observations A))
    (\<lambda>z. profile_obligations {False,True} (program_decision_observations A) (fst z) (snd z))"
  by (auto simp: exact_obligation_reduction_def profile_obligations_def graph_map_ran
    image_subset_iff candidate_profile_def profile_condition_def
    program_decision_observations_def program_decisions_agree_def)

section \<open>Actual formed programs witness the loss from either omitted facet\<close>

abbreviation interface_test_program :: "unit term_pattern \<Rightarrow> (unit,unit,unit,unit) schema_system" where
  "interface_test_program p \<equiv> \<lparr>system_interfaces={((),p)},system_clauses={}\<rparr>"

abbreviation unit_program_entries :: "((unit,unit,unit,unit) schema_system\<times>unit) set" where
  "unit_program_entries \<equiv> {z. schema_system_formed (fst z) \<and> snd z\<in>system_definitions (fst z)}"

abbreviation narrow_false_program where
  "narrow_false_program \<equiv> interface_test_program (Pattern_Payload [])"

abbreviation broad_false_program where
  "broad_false_program \<equiv> interface_test_program (Pattern_Variable ())"

abbreviation broad_true_program where
  "broad_true_program \<equiv> recognizer_system () (Pattern_Variable ())"

lemma interface_test_formed:
  "pattern_formed p \<Longrightarrow> schema_system_formed (interface_test_program p)"
  by (auto simp: schema_system_formed_def single_valued_def)

lemma interface_test_calls:
  assumes "pattern_formed p"
  shows "schema_call_formed (interface_test_program p) () t \<longleftrightarrow> pattern_accepts p t"
  using interface_test_formed[OF assms] by (simp add: schema_call_formed_def)

lemma interface_test_meaning:
  "positive_meaning (interface_test_program p)={}"
  by (subst positive_meaning_unfold)
    (auto simp: schema_consequences_def admitted_schema_instance_def)

lemma permission_comparison_witness_entries:
  "(narrow_false_program,())\<in>unit_program_entries"
  "(broad_false_program,())\<in>unit_program_entries"
  "(broad_true_program,())\<in>unit_program_entries"
  using interface_test_formed[of "Pattern_Payload []"] interface_test_formed[of "Pattern_Variable ()"]
    recognizer_system_formed[of "Pattern_Variable ()" "()"]
  by (auto simp: octets_formed_def system_definitions_def rel_dom_def recognizer_system_def)

lemma permission_comparison_witness_calls:
  "schema_call_formed narrow_false_program () t \<longleftrightarrow> t=Payload_Term []"
  "schema_call_formed broad_false_program () t \<longleftrightarrow> term_formed t"
  "schema_call_formed broad_true_program () t \<longleftrightarrow> term_formed t"
proof -
  have exact: "pattern_accepts (Pattern_Payload []::unit term_pattern) t \<longleftrightarrow> t=Payload_Term []"
    using exact_term_pattern_accepts[of "Payload_Term []" t]
    by (simp add: octets_formed_def)
  show "schema_call_formed narrow_false_program () t \<longleftrightarrow> t=Payload_Term []"
    by (simp add: interface_test_calls exact octets_formed_def)
  show "schema_call_formed broad_false_program () t \<longleftrightarrow> term_formed t"
    by (simp add: interface_test_calls)
  show "schema_call_formed broad_true_program () t \<longleftrightarrow> term_formed t"
    by (simp add: recognizer_call_formed)
qed

lemma broad_true_meaning:
  "((),t)\<in>positive_meaning broad_true_program \<longleftrightarrow> term_formed t"
  by (simp add: recognizer_positive_meaning)

theorem truth_observations_miss_call_formation:
  "((narrow_false_program,()),(broad_false_program,()))\<in>
    comparison_failures unit_program_entries (program_decisions_agree term_formed)
      {True} (program_decision_observations term_formed)"
  "(False,(Pair_Term (Payload_Term []) (Payload_Term []),False))\<in>
    candidate_losses {False,True} (program_decision_observations term_formed)
      (narrow_false_program,()) (broad_false_program,())"
proof -
  have unequal: "\<not>program_decisions_agree term_formed (narrow_false_program,()) (broad_false_program,())"
  proof
    assume agreement: "program_decisions_agree term_formed (narrow_false_program,()) (broad_false_program,())"
    have formed: "term_formed (Pair_Term (Payload_Term []) (Payload_Term []))"
      by (simp add: octets_formed_def)
    have at: "schema_call_formed narrow_false_program () (Pair_Term (Payload_Term []) (Payload_Term []))=
        schema_call_formed broad_false_program () (Pair_Term (Payload_Term []) (Payload_Term []))"
      using agreement formed by (auto simp: program_decisions_agree_def)
    show False using at by (simp add: permission_comparison_witness_calls octets_formed_def)
  qed
  show "((narrow_false_program,()),(broad_false_program,()))\<in>
    comparison_failures unit_program_entries (program_decisions_agree term_formed)
      {True} (program_decision_observations term_formed)"
    using permission_comparison_witness_entries(1,2) unequal
    by (auto simp: comparison_failures_def candidate_profile_comparison
      program_decision_observations_def interface_test_meaning)
  show "(False,(Pair_Term (Payload_Term []) (Payload_Term []),False))\<in>
    candidate_losses {False,True} (program_decision_observations term_formed)
      (narrow_false_program,()) (broad_false_program,())"
    by (simp add: program_decision_observations_def permission_comparison_witness_calls octets_formed_def)
qed

theorem formation_observations_miss_truth:
  "((broad_false_program,()),(broad_true_program,()))\<in>
    comparison_failures unit_program_entries (program_decisions_agree term_formed)
      {False} (program_decision_observations term_formed)"
  "(True,(Payload_Term [],False))\<in>
    candidate_losses {False,True} (program_decision_observations term_formed)
      (broad_false_program,()) (broad_true_program,())"
proof -
  have unequal: "\<not>program_decisions_agree term_formed (broad_false_program,()) (broad_true_program,())"
  proof
    assume agreement: "program_decisions_agree term_formed (broad_false_program,()) (broad_true_program,())"
    have formed: "term_formed (Payload_Term [])" by (simp add: octets_formed_def)
    have at: "(((),Payload_Term [])\<in>positive_meaning broad_false_program)=
        (((),Payload_Term [])\<in>positive_meaning broad_true_program)"
      using agreement formed by (auto simp: program_decisions_agree_def)
    show False using at by (simp add: interface_test_meaning broad_true_meaning octets_formed_def)
  qed
  show "((broad_false_program,()),(broad_true_program,()))\<in>
    comparison_failures unit_program_entries (program_decisions_agree term_formed)
      {False} (program_decision_observations term_formed)"
    using permission_comparison_witness_entries(2,3) unequal
    by (auto simp: comparison_failures_def candidate_profile_comparison
      program_decision_observations_def permission_comparison_witness_calls)
  show "(True,(Payload_Term [],False))\<in>
    candidate_losses {False,True} (program_decision_observations term_formed)
      (broad_false_program,()) (broad_true_program,())"
    by (simp add: program_decision_observations_def interface_test_meaning broad_true_meaning octets_formed_def)
qed

theorem both_permission_facets_are_essential:
  assumes "F\<subset>{False,True}"
  shows "\<not>comparison_basis unit_program_entries (program_decisions_agree term_formed)
    F (program_decision_observations term_formed)"
proof (rule essential_facets_prevent_a_smaller_basis[OF assms])
  fix role assume "role\<in>{False,True}"
  have without_false: "{False,True}-{False}={True}" by auto
  have without_true: "{False,True}-{True}={False}" by auto
  show "\<exists>x y. (x,y)\<in>
      comparison_failures unit_program_entries (program_decisions_agree term_formed)
        ({False,True}-{role}) (program_decision_observations term_formed)"
  proof (cases role)
    case False
    have selected: "{False,True}-{role}={True}" using False without_false by simp
    show ?thesis unfolding selected
      by (rule exI[of _ "(narrow_false_program,())"], rule exI[of _ "(broad_false_program,())"])
        (rule truth_observations_miss_call_formation(1))
  next
    case True
    have selected: "{False,True}-{role}={False}" using True without_true by simp
    show ?thesis unfolding selected
      by (rule exI[of _ "(broad_false_program,())"], rule exI[of _ "(broad_true_program,())"])
        (rule formation_observations_miss_truth(1))
  qed
qed

theorem more_positive_calls_need_not_preserve_decisions:
  "positive_meaning broad_false_program\<subset>positive_meaning broad_true_program \<and>
    \<not>program_decisions_agree term_formed (broad_false_program,()) (broad_true_program,())"
proof -
  have witness: "((),Payload_Term [])\<in>positive_meaning broad_true_program"
    by (simp add: broad_true_meaning octets_formed_def)
  have proper: "positive_meaning broad_false_program\<subset>positive_meaning broad_true_program"
    using witness by (simp only: interface_test_meaning) blast
  have unequal: "\<not>program_decisions_agree term_formed (broad_false_program,()) (broad_true_program,())"
    using formation_observations_miss_truth(1)
    by (simp only: comparison_failures_def mem_Collect_eq) blast
  show ?thesis by (rule conjI[OF proper unequal])
qed

section \<open>The executed finite comparison computes actual program decisions\<close>

definition permission_investigation_program :: "nat \<Rightarrow> (unit,unit,unit,unit) schema_system" where
  "permission_investigation_program c=(if c=0 then narrow_false_program
    else if c=1 then broad_false_program else broad_true_program)"

definition permission_investigation_argument :: "nat \<Rightarrow> factor_term" where
  "permission_investigation_argument i=(if i=0 then Payload_Term []
    else Pair_Term (Payload_Term []) (Payload_Term []))"

definition permission_investigation_decision :: "nat \<Rightarrow> nat \<Rightarrow> nat \<Rightarrow> bool" where
  "permission_investigation_decision f c i=(if f=0 then
    schema_call_formed (permission_investigation_program c) () (permission_investigation_argument i)
    else ((),permission_investigation_argument i)\<in>positive_meaning (permission_investigation_program c))"

lemma permission_investigation_decision_code [code]:
  "permission_investigation_decision f c i=(if f=0 then c\<noteq>0 \<or> i=0 else c\<noteq>0 \<and> c\<noteq>1)"
  by (auto simp: permission_investigation_decision_def permission_investigation_program_def
    permission_investigation_argument_def permission_comparison_witness_calls
    interface_test_meaning broad_true_meaning octets_formed_def)

definition permission_investigation_compare :: "nat \<Rightarrow> nat \<Rightarrow> bool" where
  "permission_investigation_compare c d=program_decisions_agree
    (\<lambda>t. t\<in>set (map permission_investigation_argument [0,1]))
    (permission_investigation_program c,()) (permission_investigation_program d,())"

lemma permission_investigation_compare_code [code]:
  "permission_investigation_compare c d=list_all (\<lambda>f.
    list_all (\<lambda>i. permission_investigation_decision f c i=
      permission_investigation_decision f d i) [0,1]) [0,1]"
  by (auto simp: permission_investigation_compare_def program_decisions_agree_def
    permission_investigation_decision_def)

definition permission_investigation_observations :: "(nat\<times>nat\<times>nat) list" where
  "permission_investigation_observations=concat (map (\<lambda>c. concat (map (\<lambda>f.
    map (\<lambda>i. (f,c,2*i+(if permission_investigation_decision f c i then 1 else 0))) [0,1])
      [0,1])) [0,1,2])"

definition permission_investigation_relation :: "(nat\<times>nat) list" where
  "permission_investigation_relation=filter (\<lambda>(c,d). permission_investigation_compare c d)
    (investigation_pairs [0,1,2])"

lemma permission_investigation_observations_exact:
  "finite_table_observations (fset_of_list permission_investigation_observations) f c=
    (if f\<in>{0,1} \<and> c\<in>{0,1,2} then
      (\<lambda>i. 2*i+(if permission_investigation_decision f c i then 1 else 0)) ` {0,1}
    else {})"
  by (cases "f=0"; cases "f=1"; cases "c=0"; cases "c=1"; cases "c=2")
    (auto simp: finite_table_observations_def permission_investigation_observations_def
      permission_investigation_decision_code)

lemma permission_investigation_relation_exact:
  "(c,d)\<in>set permission_investigation_relation \<longleftrightarrow>
    c\<in>{0,1,2} \<and> d\<in>{0,1,2} \<and> program_decisions_agree
      (\<lambda>t. t\<in>set (map permission_investigation_argument [0,1]))
      (permission_investigation_program c,()) (permission_investigation_program d,())"
  by (auto simp: permission_investigation_relation_def investigation_pairs_exact
    permission_investigation_compare_def)

lemma permission_investigation_observations_literal:
  "permission_investigation_observations=
    [(0,0,1),(0,0,2),(1,0,0),(1,0,2),
     (0,1,1),(0,1,3),(1,1,0),(1,1,2),
     (0,2,1),(0,2,3),(1,2,1),(1,2,3)]"
  by (simp add: permission_investigation_observations_def permission_investigation_decision_code)

lemma permission_investigation_relation_literal:
  "permission_investigation_relation=[(0,0),(1,1),(2,2)]"
  by (simp add: permission_investigation_relation_def investigation_pairs_def
    permission_investigation_compare_code permission_investigation_decision_code)

definition permission_investigation where
  "permission_investigation selected=investigation_basis [0,1,2] [0,1] selected
    permission_investigation_observations permission_investigation_relation"

theorem permission_investigation_formation_only:
  "fst (permission_investigation [0]) \<and>
    set (fst (snd (permission_investigation [0])))={(1,2),(2,1)}"
  by (simp add: permission_investigation_def investigation_basis_def Let_def
    investigation_select_def investigation_pairs_def permission_investigation_observations_literal
    permission_investigation_relation_literal finite_basis_residual_def finite_candidate_profile_def
    finite_basis_evaluation_def finite_observation_table_formed_def)

theorem permission_investigation_truth_only:
  "fst (permission_investigation [1]) \<and>
    set (fst (snd (permission_investigation [1])))={(0,1),(1,0)}"
  by (simp add: permission_investigation_def investigation_basis_def Let_def
    investigation_select_def investigation_pairs_def permission_investigation_observations_literal
    permission_investigation_relation_literal finite_basis_residual_def finite_candidate_profile_def
    finite_basis_evaluation_def finite_observation_table_formed_def)

theorem permission_investigation_both_facets:
  "fst (permission_investigation [0,1]) \<and> fst (snd (permission_investigation [0,1]))=[]"
  by (simp add: permission_investigation_def investigation_basis_def Let_def
    investigation_select_def investigation_pairs_def permission_investigation_observations_literal
    permission_investigation_relation_literal finite_basis_residual_def finite_candidate_profile_def
    finite_basis_evaluation_def finite_observation_table_formed_def)

