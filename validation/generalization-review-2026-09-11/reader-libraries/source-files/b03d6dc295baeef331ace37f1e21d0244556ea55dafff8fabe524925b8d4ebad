theory Factor_Context_Clauses
  imports "Finite_Investigation_a24c220cc9c60a2a4f495caf.Factor_Environment_Lookup" "Finite_Investigation_a24c220cc9c60a2a4f495caf.Factor_Recursive_Groups"
begin

section \<open>Actual sites precede any program or application role\<close>

definition site_context_admission_schema :: "(nat,nat,nat) factor_schema" where
  "site_context_admission_schema=data_rule
    (Pattern_Pair data_x (Pattern_Pair data_y data_z))
    {(0,37,artifact_lookup_pattern data_x data_y data_w),
     (1,35,Pattern_Pair data_w (Pattern_Pair data_z (Pattern_Payload [])))}"

definition judgment_context_admission_schema :: "(nat,nat,nat) factor_schema" where
  "judgment_context_admission_schema=data_rule
    (Pattern_Pair data_x (Pattern_Pair data_y data_z))
    {(0,156,Pattern_Pair data_x data_y),(1,156,Pattern_Pair data_x data_z)}"

definition context_identity_schema :: "nat \<Rightarrow> (nat,nat,nat) factor_schema" where
  "context_identity_schema admission=data_rule
    (Pattern_Pair (Pattern_Pair data_x data_z) (Pattern_Pair data_y data_z))
    {(0,admission,Pattern_Pair data_x data_z),(1,27,Pattern_Pair data_x data_y)}"

definition context_group_clauses :: "nat \<Rightarrow> (nat\<times>(nat,nat,nat) factor_schema) set" where
  "context_group_clauses d=
    (if d=156 then {(0,site_context_admission_schema)}
     else if d=157 then {(0,judgment_context_admission_schema)}
     else if d=158 then {(0,context_identity_schema 156)}
     else if d=159 then {(0,context_identity_schema 157)}
     else {})"

definition context_definition_group :: "(nat,nat,nat,nat) schema_system" where
  "context_definition_group=\<lparr>
    system_interfaces=image (\<lambda>d. (d,data_x)) {156,157,158,159},
    system_clauses=(\<Union>d\<in>{156,157,158,159}.
      image (\<lambda>(c,S). ((d,c),S)) (context_group_clauses d))\<rparr>"

lemma context_group_definitions [simp]:
  "system_definitions context_definition_group={156,157,158,159}"
  by (auto simp: context_definition_group_def system_definitions_def rel_dom_def)

lemma context_group_interfaces [simp]:
  "(d,p)\<in>system_interfaces context_definition_group \<longleftrightarrow>
    d\<in>{156,157,158,159} \<and> p=data_x"
  by (auto simp: context_definition_group_def)

lemma context_group_family [simp]:
  "((d,c),S)\<in>system_clauses context_definition_group \<longleftrightarrow>
    d\<in>{156,157,158,159} \<and> (c,S)\<in>context_group_clauses d"
  by (auto simp: context_definition_group_def)

lemma context_group_finite: "finite (context_group_clauses d)"
  by (simp add: context_group_clauses_def)

lemma context_group_functional: "single_valued (context_group_clauses d)"
  by (auto simp: context_group_clauses_def single_valued_def)

lemmas context_schema_defs = site_context_admission_schema_def
  judgment_context_admission_schema_def context_identity_schema_def

lemma context_group_schema_formation:
  assumes "(c,S)\<in>context_group_clauses d"
  shows "schema_formed S \<and> schema_material_premises S={} \<and>
    schema_dependencies S\<subseteq>system_definitions artifact_lookup_system\<union>
      system_definitions context_definition_group"
  using assms by (auto simp: context_group_clauses_def context_schema_defs
    schema_formed_def schema_dependencies_def single_valued_def rel_dom_def rel_ran_def octets_formed_def
    split: if_splits)

lemma context_group_source_formation:
  "schema_system_formed_over (system_definitions artifact_lookup_system) context_definition_group"
proof -
  have finite: "finite (system_interfaces context_definition_group)"
    "finite (system_clauses context_definition_group)"
    by (simp_all add: context_definition_group_def context_group_finite)
  have interfaces: "single_valued (system_interfaces context_definition_group)"
    by (auto simp: single_valued_def)
  have clauses: "single_valued (system_clauses context_definition_group)"
    using context_group_functional by (auto simp: single_valued_def; blast)
  have schemas: "\<forall>d c S. ((d,c),S)\<in>system_clauses context_definition_group \<longrightarrow>
    d\<in>system_definitions context_definition_group \<and> schema_formed S \<and>
    schema_dependencies S\<subseteq>system_definitions artifact_lookup_system\<union>
      system_definitions context_definition_group"
  proof (intro allI impI)
    fix d c S assume clause: "((d,c),S)\<in>system_clauses context_definition_group"
    have members: "d\<in>system_definitions context_definition_group \<and> (c,S)\<in>context_group_clauses d"
      using clause by (simp only: context_group_family context_group_definitions)
    show "d\<in>system_definitions context_definition_group \<and> schema_formed S \<and>
        schema_dependencies S\<subseteq>system_definitions artifact_lookup_system\<union>system_definitions context_definition_group"
      using members context_group_schema_formation[OF conjunct2[OF members]] by blast
  qed
  show ?thesis using finite interfaces clauses schemas by (simp add: schema_system_formed_over_def)
qed

lemma context_group_external_dependencies:
  "system_external_dependencies context_definition_group={27,35,37}"
  by (simp add: system_external_dependencies_clauses context_definition_group_def
    context_group_clauses_def context_schema_defs schema_dependencies_def rel_ran_image
    system_definitions_def rel_dom_image; auto)

definition context_base_system :: "(nat,nat,nat,nat) schema_system" where
  "context_base_system=rooted_system artifact_lookup_system
    (system_external_dependencies context_definition_group)"

lemma context_base_formed [simp]: "schema_system_formed context_base_system"
  unfolding context_base_system_def by (rule rooted_system_formed[OF artifact_lookup_system_formed])

lemma context_base_definitions:
  "system_definitions context_base_system=system_definition_closure artifact_lookup_system {27,35,37}"
  unfolding context_base_system_def context_group_external_dependencies
  by (rule rooted_system_definitions[OF artifact_lookup_system_formed]) auto

lemma context_base_subdomain:
  "system_definitions context_base_system\<subseteq>system_definitions artifact_lookup_system"
  unfolding context_base_system_def by (rule rooted_system_subdomain)

lemma context_base_roots:
  "{27,35,37}\<subseteq>system_definitions context_base_system"
  unfolding context_base_system_def context_group_external_dependencies
  by (rule rooted_system_roots[OF artifact_lookup_system_formed]) auto

lemma context_base_least:
  assumes "{27,35,37}\<subseteq>U" "system_dependency_closed artifact_lookup_system U"
  shows "system_definitions context_base_system\<subseteq>U"
  using system_definition_closure_least[OF assms] by (simp only: context_base_definitions)

lemma context_base_call:
  "schema_call_formed context_base_system d t \<longleftrightarrow>
    d\<in>system_definitions context_base_system \<and> term_formed t"
  using rooted_system_calls[where roots="system_external_dependencies context_definition_group" and d=d and t=t,
    OF artifact_lookup_system_formed]
  by (simp only: context_base_system_def rooted_system_def system_restriction_definitions
    artifact_lookup_call; blast)

lemma context_base_meaning:
  assumes "d\<in>system_definitions context_base_system"
  shows "(d,t)\<in>positive_meaning context_base_system \<longleftrightarrow>
    (d,t)\<in>positive_meaning artifact_lookup_system"
  using rooted_system_meaning[where roots="system_external_dependencies context_definition_group" and d=d and t=t,
    OF artifact_lookup_system_formed] assms
  by (simp only: context_base_system_def rooted_system_def system_restriction_definitions; blast)

lemma context_base_agreement:
  "systems_agree_on artifact_lookup_system context_base_system (system_definitions context_base_system)"
  unfolding context_base_system_def by (rule rooted_system_agreement)

lemma context_group_relative_formation:
  "schema_system_formed_over (system_definitions context_base_system) context_definition_group"
proof -
  have actual: "schema_system_formed_over (system_external_dependencies context_definition_group) context_definition_group"
    by (rule schema_system_formed_over_actual_dependencies[OF context_group_source_formation])
  have retained: "system_external_dependencies context_definition_group\<subseteq>system_definitions context_base_system"
    using context_base_roots by (simp only: context_group_external_dependencies)
  show ?thesis by (rule schema_system_formed_over_mono[OF actual retained])
qed

interpretation context_group: positive_definition_group context_base_system context_definition_group
proof (rule positive_definition_group.intro[OF context_base_formed context_group_relative_formation])
  show "system_definitions context_base_system\<inter>system_definitions context_definition_group={}"
    using context_base_subdomain by (auto dest: subsetD)
qed

definition context_admission_system :: "(nat,nat,nat,nat) schema_system" where
  "context_admission_system=system_union context_base_system context_definition_group"

lemma context_admission_system_formed [simp]: "schema_system_formed context_admission_system"
  using context_group.formed by (simp only: context_admission_system_def)

lemma context_admission_definitions [simp]:
  "system_definitions context_admission_system=system_definitions context_base_system\<union>{156,157,158,159}"
  by (simp add: context_admission_system_def)

lemma context_admission_call:
  "schema_call_formed context_admission_system d t \<longleftrightarrow>
    d\<in>system_definitions context_admission_system \<and> term_formed t"
  using context_group.variable_calls[OF context_base_call context_group_interfaces, of d t]
  by (simp only: context_admission_system_def)

lemma context_admission_old_agreement:
  "systems_agree_on context_base_system context_admission_system (system_definitions context_base_system)"
  using context_group.old_agreement by (simp only: context_admission_system_def)

lemma context_admission_old_meaning:
  assumes "d\<in>system_definitions context_base_system"
  shows "(d,t)\<in>positive_meaning context_admission_system \<longleftrightarrow>
    (d,t)\<in>positive_meaning artifact_lookup_system"
  using context_group.old_meaning[OF assms, of t] context_base_meaning[OF assms, of t]
  by (simp only: context_admission_system_def; blast)

lemma context_admission_clause:
  assumes "d\<in>{156,157,158,159}"
  shows "((d,c),S)\<in>system_clauses context_admission_system \<longleftrightarrow>
    (c,S)\<in>context_group_clauses d"
  using context_group.group_agreement assms
  by (simp only: context_admission_system_def systems_agree_on_def context_group_definitions
    context_group_family; blast)

lemma context_admission_clauses [simp]:
  "((156,c),S)\<in>system_clauses context_admission_system \<longleftrightarrow> c=0 \<and> S=site_context_admission_schema"
  "((157,c),S)\<in>system_clauses context_admission_system \<longleftrightarrow> c=0 \<and> S=judgment_context_admission_schema"
  "((158,c),S)\<in>system_clauses context_admission_system \<longleftrightarrow> c=0 \<and> S=context_identity_schema 156"
  "((159,c),S)\<in>system_clauses context_admission_system \<longleftrightarrow> c=0 \<and> S=context_identity_schema 157"
  using context_admission_clause by (auto simp: context_group_clauses_def)

lemma context_admission_components:
  "(27,t)\<in>positive_meaning context_admission_system \<longleftrightarrow>
    (27,t)\<in>positive_meaning environment_identity_system"
  "(35,t)\<in>positive_meaning context_admission_system \<longleftrightarrow>
    (35,t)\<in>positive_meaning target_admission_system"
  "(37,t)\<in>positive_meaning context_admission_system \<longleftrightarrow>
    (37,t)\<in>positive_meaning artifact_lookup_system"
  using context_admission_old_meaning[of 27 t] artifact_lookup_environment_meaning[of 27 t]
    context_admission_old_meaning[of 35 t] artifact_lookup_old_meaning[of 35 t] citation_admission_old_meaning[of 35 t]
    context_admission_old_meaning[of 37 t] context_base_roots by auto

text \<open>
  One site is an actual artifact use and an occurrence in that same artifact.
  Existing lookup and occurrence-target admission establish those two facts.
  A judgment context shares one represented environment across two such sites.
  Neither rule assigns a grammar, application role, or truth value to them.

  Identity retains the exact coordinate fields and compares complete
  environments through their existing admitted identity contract. Admission
  of the second context follows from equality of that complete environment
  and the retained coordinates. Four ordinary clauses use the least base
  closed under their three actual external callees. The coordinates are
  ordinary program construction choices and add no semantic names.
\<close>

end
