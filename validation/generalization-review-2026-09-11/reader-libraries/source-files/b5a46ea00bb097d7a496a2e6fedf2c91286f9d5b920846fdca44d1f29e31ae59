theory Factor_Executable_Matching
  imports "Factor_Executable_Terms" "Finite_Investigation_a24c220cc9c60a2a4f495caf.Factor_Interfaces"
begin

section \<open>Bindings recovered by structural descent\<close>

lemma pattern_instance_binding_mono:
  assumes "pattern_instance V p t" "V \<subseteq> W"
  shows "pattern_instance W p t"
  using assms by (induction rule: pattern_instance.induct)
    (auto intro: pattern_instance.intros)

lemma decode_finite_bindings_union [simp]:
  "decode_finite_term_bindings (V |\<union>| W) =
    decode_finite_term_bindings V \<union> decode_finite_term_bindings W"
  by (auto simp: decode_finite_term_bindings_def map_relation_values_def)

fun finite_matching_bindings ::
  "'a finite_term_pattern \<Rightarrow> finite_factor_term \<Rightarrow>
    ('a \<times> finite_factor_term) fset" where
  "finite_matching_bindings (Finite_Variable a) t = {|(a,t)|}"
| "finite_matching_bindings (Finite_Pattern_Target x) t = {||}"
| "finite_matching_bindings (Finite_Pattern_Payload v) t = {||}"
| "finite_matching_bindings (Finite_Pattern_Pair p q) t =
    (case t of Finite_Pair x y \<Rightarrow>
       finite_matching_bindings p x |\<union>| finite_matching_bindings q y
     | _ \<Rightarrow> {||})"

theorem finite_matching_bindings_complete:
  assumes "pattern_instance V (decode_finite_pattern p) (decode_finite_term t)"
  shows "pattern_instance (decode_finite_term_bindings (finite_matching_bindings p t))
      (decode_finite_pattern p) (decode_finite_term t) \<and>
    decode_finite_term_bindings (finite_matching_bindings p t) \<subseteq> V \<and>
    rel_dom (decode_finite_term_bindings (finite_matching_bindings p t)) =
      pattern_variables (decode_finite_pattern p)"
  using assms
proof (induction p arbitrary: t)
  case (Finite_Variable a)
  then show ?case by (auto simp: decode_finite_term_bindings_def rel_dom_def)
next
  case (Finite_Pattern_Target x)
  then show ?case by (cases t) (auto simp: decode_finite_term_bindings_def rel_dom_def)
next
  case (Finite_Pattern_Payload v)
  then show ?case by (cases t) (auto simp: decode_finite_term_bindings_def rel_dom_def)
next
  case (Finite_Pattern_Pair p q)
  obtain x y where tshape: "t = Finite_Pair x y"
    using Finite_Pattern_Pair.prems by (cases t) auto
  have left: "pattern_instance V (decode_finite_pattern p) (decode_finite_term x)"
    and right: "pattern_instance V (decode_finite_pattern q) (decode_finite_term y)"
    using Finite_Pattern_Pair.prems tshape by auto
  have L: "pattern_instance (decode_finite_term_bindings (finite_matching_bindings p x))
      (decode_finite_pattern p) (decode_finite_term x) \<and>
    decode_finite_term_bindings (finite_matching_bindings p x) \<subseteq> V \<and>
    rel_dom (decode_finite_term_bindings (finite_matching_bindings p x)) =
      pattern_variables (decode_finite_pattern p)"
    by (rule Finite_Pattern_Pair.IH(1)[OF left])
  have R: "pattern_instance (decode_finite_term_bindings (finite_matching_bindings q y))
      (decode_finite_pattern q) (decode_finite_term y) \<and>
    decode_finite_term_bindings (finite_matching_bindings q y) \<subseteq> V \<and>
    rel_dom (decode_finite_term_bindings (finite_matching_bindings q y)) =
      pattern_variables (decode_finite_pattern q)"
    by (rule Finite_Pattern_Pair.IH(2)[OF right])
  let ?U = "decode_finite_term_bindings
    (finite_matching_bindings p x |\<union>| finite_matching_bindings q y)"
  have li: "pattern_instance ?U (decode_finite_pattern p) (decode_finite_term x)"
    by (rule pattern_instance_binding_mono[OF conjunct1[OF L]]) simp
  have ri: "pattern_instance ?U (decode_finite_pattern q) (decode_finite_term y)"
    by (rule pattern_instance_binding_mono[OF conjunct1[OF R]]) simp
  show ?case using L R li ri by (auto simp: tshape rel_dom_def)
qed

definition finite_pattern_accepts :: "'a finite_term_pattern \<Rightarrow> finite_factor_term \<Rightarrow> bool" where
  "finite_pattern_accepts p t \<longleftrightarrow>
    finite_term_formed t \<and>
    finite_term_bindings_formed (finite_pattern_variables p) (finite_matching_bindings p t) \<and>
    finite_pattern_instance (finite_matching_bindings p t) p t"

theorem finite_pattern_accepts_correct:
  "finite_pattern_accepts p t \<longleftrightarrow>
    pattern_accepts (decode_finite_pattern p) (decode_finite_term t)"
proof
  assume accepted: "finite_pattern_accepts p t"
  have formed: "term_formed (decode_finite_term t)"
    and bindings: "term_bindings_formed (pattern_variables (decode_finite_pattern p))
      (decode_finite_term_bindings (finite_matching_bindings p t))"
    and inst: "pattern_instance (decode_finite_term_bindings (finite_matching_bindings p t))
      (decode_finite_pattern p) (decode_finite_term t)"
    using accepted by (auto simp: finite_pattern_accepts_def finite_term_formed_correct
        finite_term_bindings_formed_correct finite_pattern_variables_correct finite_pattern_instance_correct)
  show "pattern_accepts (decode_finite_pattern p) (decode_finite_term t)"
    using formed bindings inst unfolding pattern_accepts_def by blast
next
  assume accepted: "pattern_accepts (decode_finite_pattern p) (decode_finite_term t)"
  obtain V where formed: "term_formed (decode_finite_term t)"
    and bindings: "term_bindings_formed (pattern_variables (decode_finite_pattern p)) V"
    and inst: "pattern_instance V (decode_finite_pattern p) (decode_finite_term t)"
    using accepted unfolding pattern_accepts_def by blast
  let ?M = "finite_matching_bindings p t"
  let ?B = "decode_finite_term_bindings ?M"
  have recovered: "pattern_instance ?B (decode_finite_pattern p) (decode_finite_term t)"
    and subset: "?B \<subseteq> V"
    and domain: "rel_dom ?B = pattern_variables (decode_finite_pattern p)"
    using finite_matching_bindings_complete[OF inst] by auto
  have finite: "finite ?B" by (simp add: decode_finite_term_bindings_def)
  have sv: "single_valued ?B"
    using bindings subset unfolding term_bindings_formed_def single_valued_def by blast
  have vals: "\<forall>a x. (a,x) \<in> ?B \<longrightarrow> term_formed x"
    using bindings subset unfolding term_bindings_formed_def by blast
  have bf: "term_bindings_formed (pattern_variables (decode_finite_pattern p)) ?B"
    using finite sv vals domain unfolding term_bindings_formed_def by blast
  show "finite_pattern_accepts p t" using formed bf recovered
    by (simp add: finite_pattern_accepts_def finite_term_formed_correct
        finite_term_bindings_formed_correct finite_pattern_variables_correct finite_pattern_instance_correct)
qed

export_code finite_pattern_accepts checking SML

text \<open>
  Repeated occurrences of one variable contribute their actual encountered
  values. The functional-binding check rejects inconsistent repetitions.
  Mismatched constructors and literals fail the instance check, and all bindings
  are recovered by finite structural recursion. The equivalence covers every
  finite input, including malformed targets and ill-formed byte strings.
\<close>

