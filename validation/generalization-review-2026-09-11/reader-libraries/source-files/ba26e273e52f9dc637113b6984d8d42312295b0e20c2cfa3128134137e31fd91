theorem premise_rows_complete:
  assumes source: "environment_value_presents E e"
    and table: "(52,Pair_Term (data_list_term (map Payload_Term Vs)) (binding_rows_term xs))\<in>positive_meaning binding_admission_system"
    and read: "instantiated_premise_rows E u (set Vs) (set xs) rs qs cs U"
    and keys: "\<forall>s\<in>rel_dom (set rs). octets_formed s" and order: "distinct Us" and used: "set Us=U"
  shows "(63,premise_instantiation_argument e (use_data_term u) (data_list_term (map Payload_Term Vs)) (binding_rows_term xs)
      (data_list_term (map address_pair_data rs)) (call_instance_rows_term qs) (binding_rows_term cs)
      (data_list_term (map Payload_Term Us)))\<in>positive_meaning premise_rows_system"
proof -
  have scope: "\<forall>a\<in>set Vs. octets_formed a"
    using table by (simp only: binding_admission_on_values; blast)
  show ?thesis using read keys order used
  proof (induction arbitrary: Us rule: instantiated_premise_rows.induct)
    case empty
    have source_call: "(26,e)\<in>positive_meaning environment_admission_system"
      using source by (simp only: environment_admission_exact) blast
    have use_call: "(19,use_data_term u)\<in>positive_meaning coordinate_admission_system"
      by (simp only: coordinate_admission_exact) blast
    have list: "Us=[]" using empty.prems by auto
    show ?case using premise_rows_nil_step[OF source_call use_call table] by (simp add: list)
  next
    case (call r d p I K t rs qs cs U s)
    have key: "octets_formed s" and tail_keys: "\<forall>s\<in>rel_dom (set rs). octets_formed s"
      using call.prems(1) by (auto simp: rel_dom_def)
    have head_scope: "pattern_variables p\<subseteq>set Vs" and finite: "finite I" "finite K"
      using prospective_call_formed[OF call.hyps(1)] by auto
    have tail_scope: "finite U" "U\<subseteq>set Vs"
      using instantiated_premise_row_variables[OF call.hyps(3)] by auto
    obtain Hu where hu: "distinct Hu" "set Hu=pattern_variables p" using finite_distinct_list[OF pattern_variables_finite[of p]] by blast
    obtain Tu where tu: "distinct Tu" "set Tu=U" using finite_distinct_list[OF tail_scope(1)] by blast
    obtain Is where interiors: "distinct Is" "set Is=I" using finite_distinct_list[OF finite(1)] by blast
    obtain Ks where ks: "distinct Ks" "set Ks=K" using finite_distinct_list[OF finite(2)] by blast
    have first: "(57,prospective_instantiation_argument e (use_data_term u) (data_list_term (map Payload_Term Vs))
        (binding_rows_term xs) (Payload_Term r) (site_data_term (fst d) (snd d)) t
        (data_list_term (map Payload_Term Hu)) (data_list_term (map Payload_Term Is)) (data_list_term (map Payload_Term Ks)))
        \<in>positive_meaning prospective_instantiation_system"
      by (rule prospective_instantiation_complete[OF call.hyps(1) source table refl hu(1) interiors(1) ks(1) hu(2) interiors(2) ks(2) call.hyps(2)])
    have rest: "(63,premise_instantiation_argument e (use_data_term u) (data_list_term (map Payload_Term Vs))
        (binding_rows_term xs) (data_list_term (map address_pair_data rs)) (call_instance_rows_term qs) (binding_rows_term cs)
        (data_list_term (map Payload_Term Tu)))\<in>positive_meaning premise_rows_system"
      by (rule call.IH[OF tail_keys tu])
    have union: "(48,collection_join_argument (data_list_term (map Payload_Term Hu))
        (data_list_term (map Payload_Term Tu)) (data_list_term (map Payload_Term Us)))\<in>positive_meaning data_union_system"
      by (simp only: data_union_payload_lists) (use scope head_scope tail_scope hu tu call.prems(3) in auto)
    have unique: "(1,data_list_term (map Payload_Term Us))\<in>positive_meaning distinct_payloads_system"
      by (simp only: distinct_payload_list_exact) (use scope head_scope tail_scope call.prems(2,3) in auto)
    have socket: "(1,data_list_term [Payload_Term s])\<in>positive_meaning distinct_payloads_system"
      using key by (simp only: payload_recognition_exact; blast)
    show ?case using premise_rows_call_step[OF first rest union unique socket]
      by (simp add: address_pair_data_def[abs_def] call_instance_value_def)
  next
    case (material r M I K x a ed co fn rs qs cs U s)
    have key: "octets_formed s" and tail_keys: "\<forall>s\<in>rel_dom (set rs). octets_formed s"
      using material.prems(1) by (auto simp: rel_dom_def)
    have head_scope: "material_variables M\<subseteq>set Vs" and finite: "finite I" "finite K"
      using native_material_formed[OF material.hyps(1)] by auto
    have tail_scope: "finite U" "U\<subseteq>set Vs"
      using instantiated_premise_row_variables[OF material.hyps(3)] by auto
    obtain Hu where hu: "distinct Hu" "set Hu=material_variables M"
      using finite_distinct_list[OF material_variables_finite[of M]] by blast
    obtain Tu where tu: "distinct Tu" "set Tu=U" using finite_distinct_list[OF tail_scope(1)] by blast
    obtain Is where interiors: "distinct Is" "set Is=I" using finite_distinct_list[OF finite(1)] by blast
    obtain Ks where ks: "distinct Ks" "set Ks=K" using finite_distinct_list[OF finite(2)] by blast
    have raw: "native_material_at E u (set Vs) r M (set Is) (set Ks)"
      using material.hyps(1) interiors(2) ks(2) by simp
    have first: "(62,material_instantiation_argument e (use_data_term u) (data_list_term (map Payload_Term Vs))
        (binding_rows_term xs) (Payload_Term r) x a ed co fn
        (data_list_term (map Payload_Term Hu)) (data_list_term (map Payload_Term Is)) (data_list_term (map Payload_Term Ks)))
        \<in>positive_meaning material_instantiation_system"
      by (rule material_instantiation_complete[OF source table raw hu(1) interiors(1) ks(1) hu(2) material.hyps(2)])
    have rest: "(63,premise_instantiation_argument e (use_data_term u) (data_list_term (map Payload_Term Vs))
        (binding_rows_term xs) (data_list_term (map address_pair_data rs)) (call_instance_rows_term qs) (binding_rows_term cs)
        (data_list_term (map Payload_Term Tu)))\<in>positive_meaning premise_rows_system"
      by (rule material.IH[OF tail_keys tu])
    have union: "(48,collection_join_argument (data_list_term (map Payload_Term Hu))
        (data_list_term (map Payload_Term Tu)) (data_list_term (map Payload_Term Us)))\<in>positive_meaning data_union_system"
      by (simp only: data_union_payload_lists) (use scope head_scope tail_scope hu tu material.prems(3) in auto)
    have unique: "(1,data_list_term (map Payload_Term Us))\<in>positive_meaning distinct_payloads_system"
      by (simp only: distinct_payload_list_exact) (use scope head_scope tail_scope material.prems(2,3) in auto)
    have socket: "(1,data_list_term [Payload_Term s])\<in>positive_meaning distinct_payloads_system"
      using key by (simp only: payload_recognition_exact; blast)
    show ?case using premise_rows_material_step[OF first rest union unique socket]
      by (simp add: address_pair_data_def[abs_def])
  qed
qed

theorem premise_rows_exact:
  "(63,z)\<in>positive_meaning premise_rows_system \<longleftrightarrow> premise_rows_result z"
proof
  show "(63,z)\<in>positive_meaning premise_rows_system \<Longrightarrow> premise_rows_result z" by (rule premise_rows_sound)
next
  assume "premise_rows_result z"
  then obtain E e u Vs xs rs qs cs Us where parts:
    "z=premise_instantiation_argument e (use_data_term u) (data_list_term (map Payload_Term Vs)) (binding_rows_term xs)
      (data_list_term (map address_pair_data rs)) (call_instance_rows_term qs) (binding_rows_term cs)
      (data_list_term (map Payload_Term Us))"
    "environment_value_presents E e" "distinct Vs" "distinct xs" "\<forall>a\<in>set Vs. octets_formed a"
    "term_bindings_formed (set Vs) (set xs)" "distinct Us" "\<forall>s\<in>rel_dom (set rs). octets_formed s"
    "instantiated_premise_rows E u (set Vs) (set xs) rs qs cs (set Us)" by blast
  have table: "(52,Pair_Term (data_list_term (map Payload_Term Vs)) (binding_rows_term xs))\<in>positive_meaning binding_admission_system"
    by (simp only: binding_admission_on_values) (use parts(3-6) in blast)
  show "(63,z)\<in>positive_meaning premise_rows_system"
    using premise_rows_complete[OF parts(2) table parts(9,8,7) refl] parts(1) by simp
qed

corollary premise_rows_on_values:
  assumes source: "environment_value_presents E e"
  shows "(63,premise_instantiation_argument e (use_data_term u) (data_list_term (map Payload_Term Vs)) (binding_rows_term xs)
      (data_list_term (map address_pair_data rs)) (call_instance_rows_term qs) (binding_rows_term cs)
      (data_list_term (map Payload_Term Us)))\<in>positive_meaning premise_rows_system \<longleftrightarrow>
    distinct Vs \<and> distinct xs \<and> (\<forall>a\<in>set Vs. octets_formed a) \<and> term_bindings_formed (set Vs) (set xs) \<and>
    distinct Us \<and> (\<forall>s\<in>rel_dom (set rs). octets_formed s) \<and>
    instantiated_premise_rows E u (set Vs) (set xs) rs qs cs (set Us)"
  by (simp only: premise_rows_exact premise_rows_result_on_context[OF source];
      simp only: call_instance_rows_term_injective binding_rows_term_injective call_instance_rows_map_injective;
      auto simp: data_list_term_injective injective_mapped_lists[OF address_pair_data_injective]
        injective_mapped_lists[OF payload_term_inj])

corollary premise_rows_presentation_invariance:
  assumes "environment_value_presents E e" "environment_value_presents E f"
  shows "(63,premise_instantiation_argument e u v b r q c w)\<in>positive_meaning premise_rows_system \<longleftrightarrow>
    (63,premise_instantiation_argument f u v b r q c w)\<in>positive_meaning premise_rows_system"
  by (simp only: premise_rows_exact premise_rows_result_at_source[OF assms(1)] premise_rows_result_at_source[OF assms(2)])

text \<open>
  The three ordinary clauses traverse the entire input list and its final
  boundary. Every source socket is a formed payload and is copied into exactly
  one output part. Calls retain the actual callee use, address, and substituted
  argument; material rows retain the existing five-operand tuple. The used
  variables form one complete distinct membership union.

  The row operation preserves repeated source rows and imposes no global
  interior separation. Complete family formation is supplied by the next
  definition. Empty rows require the complete environment, use coordinate, and
  substitution table, without requiring an artifact at that use. Both kinds
  of nonempty row obtain their source reading from the existing child entry.
  Every input term has the stated exact contract, and all previous meanings
  remain unchanged.
\<close>

end
