theory Factor_Premise_Row_Instantiation
  imports "Factor_Material_Instantiation" "Factor_Premise_Instances"
begin

section \<open>One complete substitution shared by every identified premise\<close>

abbreviation premise_instantiation_argument ::
  "factor_term \<Rightarrow> factor_term \<Rightarrow> factor_term \<Rightarrow> factor_term \<Rightarrow>
    factor_term \<Rightarrow> factor_term \<Rightarrow> factor_term \<Rightarrow> factor_term \<Rightarrow> factor_term" where
  "premise_instantiation_argument e u v b r q c w \<equiv>
    Pair_Term (Pair_Term e (Pair_Term u (Pair_Term v b))) (Pair_Term r (Pair_Term q (Pair_Term c w)))"

abbreviation premise_instantiation_pattern ::
  "'a term_pattern \<Rightarrow> 'a term_pattern \<Rightarrow> 'a term_pattern \<Rightarrow> 'a term_pattern \<Rightarrow>
    'a term_pattern \<Rightarrow> 'a term_pattern \<Rightarrow> 'a term_pattern \<Rightarrow> 'a term_pattern \<Rightarrow> 'a term_pattern" where
  "premise_instantiation_pattern e u v b r q c w \<equiv>
    Pattern_Pair (Pattern_Pair e (Pattern_Pair u (Pattern_Pair v b))) (Pattern_Pair r (Pattern_Pair q (Pattern_Pair c w)))"

abbreviation premise_rows_result :: "factor_term \<Rightarrow> bool" where
  "premise_rows_result z \<equiv> \<exists>E e u Vs xs rs qs cs Us.
    z=premise_instantiation_argument e (use_data_term u) (data_list_term (map Payload_Term Vs)) (binding_rows_term xs)
      (data_list_term (map address_pair_data rs)) (call_instance_rows_term qs) (binding_rows_term cs)
      (data_list_term (map Payload_Term Us)) \<and>
    environment_value_presents E e \<and> distinct Vs \<and> distinct xs \<and> (\<forall>a\<in>set Vs. octets_formed a) \<and>
    term_bindings_formed (set Vs) (set xs) \<and> distinct Us \<and> (\<forall>s\<in>rel_dom (set rs). octets_formed s) \<and>
    instantiated_premise_rows E u (set Vs) (set xs) rs qs cs (set Us)"

lemma premise_rows_result_at_source:
  assumes source: "environment_value_presents E e"
  shows "premise_rows_result (premise_instantiation_argument e u v b r q c w) \<longleftrightarrow>
    (\<exists>a Vs xs rs qs cs Us. u=use_data_term a \<and> v=data_list_term (map Payload_Term Vs) \<and> b=binding_rows_term xs \<and>
      r=data_list_term (map address_pair_data rs) \<and> q=call_instance_rows_term qs \<and> c=binding_rows_term cs \<and>
      w=data_list_term (map Payload_Term Us) \<and> distinct Vs \<and> distinct xs \<and> (\<forall>a\<in>set Vs. octets_formed a) \<and>
      term_bindings_formed (set Vs) (set xs) \<and> distinct Us \<and> (\<forall>s\<in>rel_dom (set rs). octets_formed s) \<and>
      instantiated_premise_rows E a (set Vs) (set xs) rs qs cs (set Us))"
proof
  assume admitted: "premise_rows_result (premise_instantiation_argument e u v b r q c w)"
  obtain F a Vs xs rs qs cs Us where parts: "environment_value_presents F e"
    "u=use_data_term a" "v=data_list_term (map Payload_Term Vs)" "b=binding_rows_term xs"
    "r=data_list_term (map address_pair_data rs)" "q=call_instance_rows_term qs" "c=binding_rows_term cs"
    "w=data_list_term (map Payload_Term Us)" "distinct Vs" "distinct xs" "\<forall>a\<in>set Vs. octets_formed a"
    "term_bindings_formed (set Vs) (set xs)" "distinct Us" "\<forall>s\<in>rel_dom (set rs). octets_formed s"
    "instantiated_premise_rows F a (set Vs) (set xs) rs qs cs (set Us)"
    using admitted by (simp only: factor_term.inject) blast
  have same: "F=E" by (rule environment_value_presents_unique[OF parts(1) source])
  show "\<exists>a Vs xs rs qs cs Us. u=use_data_term a \<and> v=data_list_term (map Payload_Term Vs) \<and> b=binding_rows_term xs \<and>
      r=data_list_term (map address_pair_data rs) \<and> q=call_instance_rows_term qs \<and> c=binding_rows_term cs \<and>
      w=data_list_term (map Payload_Term Us) \<and> distinct Vs \<and> distinct xs \<and> (\<forall>a\<in>set Vs. octets_formed a) \<and>
      term_bindings_formed (set Vs) (set xs) \<and> distinct Us \<and> (\<forall>s\<in>rel_dom (set rs). octets_formed s) \<and>
      instantiated_premise_rows E a (set Vs) (set xs) rs qs cs (set Us)"
    by (rule exI[of _ a], rule exI[of _ Vs], rule exI[of _ xs], rule exI[of _ rs], rule exI[of _ qs], rule exI[of _ cs], rule exI[of _ Us])
      (use parts same in auto)
next
  assume "\<exists>a Vs xs rs qs cs Us. u=use_data_term a \<and> v=data_list_term (map Payload_Term Vs) \<and> b=binding_rows_term xs \<and>
      r=data_list_term (map address_pair_data rs) \<and> q=call_instance_rows_term qs \<and> c=binding_rows_term cs \<and>
      w=data_list_term (map Payload_Term Us) \<and> distinct Vs \<and> distinct xs \<and> (\<forall>a\<in>set Vs. octets_formed a) \<and>
      term_bindings_formed (set Vs) (set xs) \<and> distinct Us \<and> (\<forall>s\<in>rel_dom (set rs). octets_formed s) \<and>
      instantiated_premise_rows E a (set Vs) (set xs) rs qs cs (set Us)"
  then obtain a Vs xs rs qs cs Us where parts:
    "u=use_data_term a" "v=data_list_term (map Payload_Term Vs)" "b=binding_rows_term xs"
    "r=data_list_term (map address_pair_data rs)" "q=call_instance_rows_term qs" "c=binding_rows_term cs"
    "w=data_list_term (map Payload_Term Us)" "distinct Vs" "distinct xs" "\<forall>a\<in>set Vs. octets_formed a"
    "term_bindings_formed (set Vs) (set xs)" "distinct Us" "\<forall>s\<in>rel_dom (set rs). octets_formed s"
    "instantiated_premise_rows E a (set Vs) (set xs) rs qs cs (set Us)" by blast
  show "premise_rows_result (premise_instantiation_argument e u v b r q c w)"
    by (rule exI[of _ E], rule exI[of _ e], rule exI[of _ a], rule exI[of _ Vs], rule exI[of _ xs], rule exI[of _ rs], rule exI[of _ qs], rule exI[of _ cs], rule exI[of _ Us]) (use parts source in auto)
qed

lemma premise_rows_result_on_context:
  assumes source: "environment_value_presents E e"
  shows "premise_rows_result (premise_instantiation_argument e (use_data_term u)
      (data_list_term (map Payload_Term Vs)) (binding_rows_term xs) r q c w) \<longleftrightarrow>
    distinct Vs \<and> distinct xs \<and> (\<forall>a\<in>set Vs. octets_formed a) \<and> term_bindings_formed (set Vs) (set xs) \<and>
    (\<exists>rs qs cs Us. r=data_list_term (map address_pair_data rs) \<and> q=call_instance_rows_term qs \<and>
      c=binding_rows_term cs \<and> w=data_list_term (map Payload_Term Us) \<and> distinct Us \<and>
      (\<forall>s\<in>rel_dom (set rs). octets_formed s) \<and> instantiated_premise_rows E u (set Vs) (set xs) rs qs cs (set Us))"
  by (subst premise_rows_result_at_source[OF source],
    simp only: binding_rows_term_injective inj_eq[OF use_data_term_injective] factor_term.inject)
    (auto simp: data_list_term_injective injective_mapped_lists[OF payload_term_inj])

