section \<open>Exact agreement with ordered raw premise instances\<close>

theorem premise_rows_sound:
  assumes holds: "(63,z)\<in>positive_meaning premise_rows_system"
  shows "premise_rows_result z"
proof -
  have result: "d=63 \<longrightarrow> premise_rows_result t" if member: "(d,t)\<in>positive_meaning premise_rows_system" for d t
  proof (rule positive_valuation_induct[OF member])
    fix d c S h
    assume clause: "((d,c),S)\<in>system_clauses premise_rows_system"
      and assignment: "\<forall>a\<in>schema_variables S. term_formed (h a)"
      and call: "schema_call_formed premise_rows_system d (evaluate_pattern h (schema_conclusion S))"
      and support: "\<forall>s e p. (s,e,p)\<in>schema_premises S \<longrightarrow>
        (e,evaluate_pattern h p)\<in>positive_meaning premise_rows_system \<and>
        (e=63 \<longrightarrow> premise_rows_result (evaluate_pattern h p))"
    have available: "\<forall>s e p. (s,e,p)\<in>schema_premises S \<longrightarrow>
      (e,evaluate_pattern h p)\<in>positive_meaning premise_rows_system" using support by blast
    show "d=63 \<longrightarrow> premise_rows_result (evaluate_pattern h (schema_conclusion S))"
    proof
      assume "d=63"
      then consider (nil) "S=premise_rows_nil_schema" | (call) "S=premise_rows_call_schema"
        | (material) "S=premise_rows_material_schema"
        using clause by (auto simp: premise_rows_clauses_def)
      then show "premise_rows_result (evaluate_pattern h (schema_conclusion S))"
      proof cases
        case nil
        have calls: "(26,h 0)\<in>positive_meaning environment_admission_system"
          "(19,h 1)\<in>positive_meaning coordinate_admission_system"
          "(52,Pair_Term (h 2) (h 3))\<in>positive_meaning binding_admission_system"
          using available by (auto simp: nil premise_rows_nil_schema_def premise_rows_components)
        obtain E where source: "environment_value_presents E (h 0)" using calls(1)
          by (simp only: environment_admission_exact) blast
        obtain u where coordinate: "h 1=use_data_term u" using calls(2)
          by (simp only: coordinate_admission_exact) blast
        obtain Vs xs where table: "h 2=data_list_term (map Payload_Term Vs)" "h 3=binding_rows_term xs"
          "distinct Vs" "distinct xs" "\<forall>a\<in>set Vs. octets_formed a" "term_bindings_formed (set Vs) (set xs)"
          using calls(3) by (simp only: binding_admission_exact factor_term.inject) blast
        show ?thesis
          by (rule exI[of _ E], rule exI[of _ "h 0"], rule exI[of _ u], rule exI[of _ Vs], rule exI[of _ xs], rule exI[of _ "[]"], rule exI[of _ "[]"], rule exI[of _ "[]"], rule exI[of _ "[]"])
            (use source coordinate table in \<open>simp add: nil premise_rows_nil_schema_def instantiated_premise_rows.empty\<close>)
      next
        case call
        have calls:
          "(57,prospective_instantiation_argument (h 0) (h 1) (h 2) (h 3) (h 5) (h 7) (h 8) (h 12) (h 14) (h 15))
            \<in>positive_meaning prospective_instantiation_system"
          "(48,collection_join_argument (h 12) (h 13) (h 11))\<in>positive_meaning data_union_system"
          "(1,h 11)\<in>positive_meaning distinct_payloads_system"
          "(1,data_list_term [h 4])\<in>positive_meaning distinct_payloads_system"
          using available by (auto simp: call premise_rows_call_schema_def premise_rows_components
            premise_rows_components[unfolded One_nat_def])
        have tail_result: "premise_rows_result (premise_instantiation_argument (h 0) (h 1) (h 2) (h 3)
          (h 6) (h 9) (h 10) (h 13))"
          using support by (auto simp: call premise_rows_call_schema_def)
        obtain E u Vs xs rs qs cs Tu where source: "environment_value_presents E (h 0)"
          and shared: "h 1=use_data_term u" "h 2=data_list_term (map Payload_Term Vs)" "h 3=binding_rows_term xs"
          and table: "distinct Vs" "distinct xs" "\<forall>a\<in>set Vs. octets_formed a" "term_bindings_formed (set Vs) (set xs)"
