theory Factor_Definition_Clause_Reading
  imports "Factor_Package_Admission"
begin

section \<open>An actual clause socket selects its actual schema root\<close>

abbreviation definition_clause_reading_result :: "factor_term \<Rightarrow> bool" where
  "definition_clause_reading_result z \<equiv> \<exists>E e u r p C R ps i m M c a.
    z=citation_observation_argument e (use_data_term u) (Payload_Term r) (Pair_Term (Payload_Term c) (Payload_Term a)) \<and>
    environment_value_presents E e \<and> native_definition_at E u r p C \<and> artifact_at E u R \<and>
    record_at R r ps [i,m] \<and> family_at R m M \<and> (c,a)\<in>M"

definition definition_clause_reading_schema :: "(nat,nat,nat) factor_schema" where
  "definition_clause_reading_schema=data_rule
    (citation_observation_pattern data_x data_y data_z (Pattern_Pair data_w (Pattern_Variable 4)))
    {(0,72,citation_observation_pattern data_x data_y data_z (Pattern_Variable 5)),
     (1,37,artifact_lookup_pattern data_x data_y (Pattern_Variable 6)),
     (2,34,Pattern_Pair (Pattern_Pair (Pattern_Variable 6) data_z)
       (data_list_pattern [Pattern_Pair (Pattern_Variable 7) (Pattern_Variable 9),
         Pattern_Pair (Pattern_Variable 8) (Pattern_Variable 10)])),
     (3,32,Pattern_Pair (Pattern_Pair (Pattern_Variable 6) (Pattern_Variable 10)) (Pattern_Variable 11)),
     (4,5,Pattern_Pair (Pattern_Pair data_w (Pattern_Variable 4)) (Pattern_Pair (Pattern_Variable 11) (Pattern_Variable 12)))}"

definition definition_clause_reading_system :: "(nat,nat,nat,nat) schema_system" where
  "definition_clause_reading_system=add_view_definition package_admission_system 81 data_x {(0,definition_clause_reading_schema)}"

lemma definition_clause_reading_system_formed [simp]: "schema_system_formed definition_clause_reading_system"
  unfolding definition_clause_reading_system_def
  by (rule add_recursive_definition_formed[OF package_admission_system_formed])
    (auto simp: definition_clause_reading_schema_def
      schema_formed_def schema_dependencies_def single_valued_def rel_dom_def rel_ran_def octets_formed_def)

lemma definition_clause_reading_definitions [simp]:
  "system_definitions definition_clause_reading_system=insert 81 (system_definitions package_admission_system)"
  by (simp add: definition_clause_reading_system_def)

lemma definition_clause_reading_call:
  "schema_call_formed definition_clause_reading_system d t \<longleftrightarrow>
    d\<in>system_definitions definition_clause_reading_system \<and> term_formed t"
  using added_variable_calls[OF package_admission_system_formed
    definition_clause_reading_system_formed[unfolded definition_clause_reading_system_def] package_admission_call]
  by (simp only: definition_clause_reading_system_def[symmetric])

lemma definition_clause_reading_old_meaning:
  assumes "d\<in>system_definitions package_admission_system"
  shows "(d,t)\<in>positive_meaning definition_clause_reading_system \<longleftrightarrow> (d,t)\<in>positive_meaning package_admission_system"
  using added_definition_preserves_old(2)[OF package_admission_system_formed
    definition_clause_reading_system_formed[unfolded definition_clause_reading_system_def], of d t] assms
  by (auto simp: definition_clause_reading_system_def)

lemma definition_clause_reading_clause [simp]:
  "((81,c),S)\<in>system_clauses definition_clause_reading_system \<longleftrightarrow> (c,S)\<in>{(0,definition_clause_reading_schema)}"
proof -
  have owned: "((d,c),S)\<in>system_clauses package_admission_system \<Longrightarrow>
    d\<in>system_definitions package_admission_system" for d c S
    using package_admission_system_formed unfolding schema_system_formed_def by blast
  have absent: "((81,c),S)\<notin>system_clauses package_admission_system" by (auto dest: owned)
  show ?thesis using absent by (simp add: definition_clause_reading_system_def)
qed

lemma definition_clause_reading_components:
  "(72,t)\<in>positive_meaning definition_clause_reading_system \<longleftrightarrow>
    (72,t)\<in>positive_meaning definition_call_admission_system"
  "(37,t)\<in>positive_meaning definition_clause_reading_system \<longleftrightarrow>
    (37,t)\<in>positive_meaning artifact_lookup_system"
  "(34,t)\<in>positive_meaning definition_clause_reading_system \<longleftrightarrow>
    (34,t)\<in>positive_meaning record_admission_system"
  "(32,t)\<in>positive_meaning definition_clause_reading_system \<longleftrightarrow>
    (32,t)\<in>positive_meaning family_admission_system"
  "(5,t)\<in>positive_meaning definition_clause_reading_system \<longleftrightarrow>
    (5,t)\<in>positive_meaning bag_comparison_system"
  using definition_clause_reading_old_meaning[of 72 t] package_admission_previous_meaning[of 72 t]
    package_closure_previous_meaning[of 72 t]
    definition_clause_reading_old_meaning[of 37 t] package_admission_old_meaning[of 37 t]
    root_family_reading_components(1)[of t]
    definition_clause_reading_old_meaning[of 34 t] package_admission_previous_meaning[of 34 t]
    package_closure_previous_meaning[of 34 t] definition_call_admission_components(2)[of t]
    definition_clause_reading_old_meaning[of 32 t] package_admission_old_meaning[of 32 t]
    root_family_reading_components(2)[of t]
    definition_clause_reading_old_meaning[of 5 t] package_admission_previous_meaning[of 5 t]
    package_closure_previous_meaning[of 5 t] definition_call_admission_instantiation_meaning[of 5 t]
    schema_instantiation_pattern_meaning[of 5 t] pattern_instantiation_quotation_meaning[of 5 t]
    quotation_admission_projection_meaning[of 5 t] target_projection_bag_meaning[of 5 t] by auto

lemma definition_clause_reading_step:
  assumes admission: "(72,citation_observation_argument e u r t)\<in>positive_meaning definition_call_admission_system"
    and lookup: "(37,artifact_lookup_argument e u a)\<in>positive_meaning artifact_lookup_system"
    and rec: "(34,rooted_rows_argument a r (data_list_term [Pair_Term p i,Pair_Term q m]))\<in>positive_meaning record_admission_system"
    and family: "(32,rooted_rows_argument a m rows)\<in>positive_meaning family_admission_system"
    and selected: "(5,Pair_Term (Pair_Term c s) (Pair_Term rows rest))\<in>positive_meaning bag_comparison_system"
  shows "(81,citation_observation_argument e u r (Pair_Term c s))\<in>positive_meaning definition_clause_reading_system"
proof -
  have formed: "term_formed e" "term_formed u" "term_formed r" "term_formed c" "term_formed s"
    "term_formed t" "term_formed a" "term_formed p" "term_formed q" "term_formed i" "term_formed m"
    "term_formed rows" "term_formed rest"
    using schema_call_formed_target[OF positive_meaning_formed[OF admission]]
      schema_call_formed_target[OF positive_meaning_formed[OF rec]]
      schema_call_formed_target[OF positive_meaning_formed[OF selected]] by auto
  let ?h="\<lambda>n::nat. if n=0 then e else if n=1 then u else if n=2 then r else if n=3 then c
    else if n=4 then s else if n=5 then t else if n=6 then a else if n=7 then p
    else if n=8 then q else if n=9 then i else if n=10 then m else if n=11 then rows else rest"
  have result: "(81,evaluate_pattern ?h (schema_conclusion definition_clause_reading_schema))
      \<in>positive_meaning definition_clause_reading_system"
    by (rule ordinary_positive_valuation_step[where c=0])
      (use formed assms in \<open>auto simp: definition_clause_reading_schema_def schema_variables_def
        definition_clause_reading_call definition_clause_reading_components\<close>)
  show ?thesis using result by (simp add: definition_clause_reading_schema_def)
qed

theorem definition_clause_reading_sound:
  assumes holds: "(81,z)\<in>positive_meaning definition_clause_reading_system"
  shows "definition_clause_reading_result z"
proof -
  have consequence: "(81,z)\<in>schema_consequences definition_clause_reading_system (positive_meaning definition_clause_reading_system)"
    using holds positive_meaning_unfold[of definition_clause_reading_system] by blast
  obtain n S h where clause: "((81,n),S)\<in>system_clauses definition_clause_reading_system"
    and conclusion: "z=evaluate_pattern h (schema_conclusion S)"
    and support: "\<forall>s d p. (s,d,p)\<in>schema_premises S \<longrightarrow>
      (d,evaluate_pattern h p)\<in>positive_meaning definition_clause_reading_system"
    using schema_consequences_valuationD[OF consequence] by blast
  have schema: "S=definition_clause_reading_schema" using clause by simp
  have calls: "(72,citation_observation_argument (h 0) (h 1) (h 2) (h 5))\<in>positive_meaning definition_call_admission_system"
    "(37,artifact_lookup_argument (h 0) (h 1) (h 6))\<in>positive_meaning artifact_lookup_system"
    "(34,rooted_rows_argument (h 6) (h 2) (data_list_term [Pair_Term (h 7) (h 9),Pair_Term (h 8) (h 10)]))
      \<in>positive_meaning record_admission_system"
    "(32,rooted_rows_argument (h 6) (h 10) (h 11))\<in>positive_meaning family_admission_system"
    "(5,Pair_Term (Pair_Term (h 3) (h 4)) (Pair_Term (h 11) (h 12)))\<in>positive_meaning bag_comparison_system"
    using support by (auto simp: schema definition_clause_reading_schema_def definition_clause_reading_components)
  obtain E u R where source: "environment_value_presents E (h 0)" "h 1=use_data_term u"
    "artifact_at E u R" "artifact_value_presents R (h 6)"
    using calls(2) by (simp only: artifact_lookup_exact factor_term.inject) blast
  obtain r p q i m where rec: "h 2=Payload_Term r" "h 7=Payload_Term p" "h 9=Payload_Term i"
    "h 8=Payload_Term q" "h 10=Payload_Term m" "record_at R r [p,q] [i,m]"
    using calls(3) by (simp only: record_admission_pair_fields[OF source(4)]) blast
  obtain pat C where raw: "native_definition_at E u r pat C"
    using calls(1) by (simp only: source(2) rec(1) definition_call_admission_on_values[OF source(1)]) blast
  obtain xs where family: "h 11=data_list_term (map address_pair_data xs)" "distinct xs" "family_at R m (set xs)"
    using calls(4) by (simp only: rec(5) family_admission_at_source[OF source(4)] factor_term.inject) blast
  have selected: "selected_data_member (Pair_Term (h 3) (h 4)) (h 11)" using calls(5) by blast
  have member: "Pair_Term (h 3) (h 4)\<in>set (map address_pair_data xs)"
    using selected by (simp only: family(1) selected_data_member_exact data_list_term_injective) auto
  obtain c a where row: "h 3=Payload_Term c" "h 4=Payload_Term a" "(c,a)\<in>set xs"
    using member by (auto simp: address_pair_data_def split: prod.splits)
  show ?thesis
    by (rule exI[of _ E], rule exI[of _ "h 0"], rule exI[of _ u], rule exI[of _ r],
      rule exI[of _ pat], rule exI[of _ C], rule exI[of _ R], rule exI[of _ "[p,q]"],
      rule exI[of _ i], rule exI[of _ m], rule exI[of _ "set xs"], rule exI[of _ c], rule exI[of _ a])
      (use source rec raw family row conclusion in \<open>simp add: schema definition_clause_reading_schema_def\<close>)
qed

theorem definition_clause_reading_complete:
  assumes source: "environment_value_presents E e" and raw: "native_definition_at E u r pat C"
    and artifact: "artifact_at E u R" and rec: "record_at R r ps [i,m]"
    and family: "family_at R m M" and member: "(c,a)\<in>M"
  shows "(81,citation_observation_argument e (use_data_term u) (Payload_Term r)
    (Pair_Term (Payload_Term c) (Payload_Term a)))\<in>positive_meaning definition_clause_reading_system"
proof -
  obtain t where admission: "(72,citation_observation_argument e (use_data_term u) (Payload_Term r) t)
      \<in>positive_meaning definition_call_admission_system"
    using definition_call_admission_inhabited[OF source] raw by blast
  have ef: "environment_formed E" using environment_value_presents_formed[OF source] by blast
  have rf: "exact_formed R" using ef artifact by (auto simp: environment_formed_def)
  obtain v where presented: "artifact_value_presents R v" using artifact_value_presents_total[OF rf] by blast
  obtain p q where ports: "ps=[p,q]" using record_at_preserves_socket_occurrences[OF rec]
    by (auto simp: length_Suc_conv)
  obtain xs where rows: "set xs=M" "distinct xs" using finite_distinct_list[OF family_socket_graph_finite[OF family]] by blast
  let ?rows="data_list_term (map address_pair_data xs)"
  have lookup: "(37,artifact_lookup_argument e (use_data_term u) v)\<in>positive_meaning artifact_lookup_system"
    using source artifact presented by (auto simp: artifact_lookup_exact)
  have fields: "(34,rooted_rows_argument v (Payload_Term r)
      (data_list_term [Pair_Term (Payload_Term p) (Payload_Term i),Pair_Term (Payload_Term q) (Payload_Term m)]))
      \<in>positive_meaning record_admission_system"
    by (simp only: record_admission_pair_fields[OF presented]) (use rec in \<open>auto simp: ports\<close>)
  have graph: "(32,rooted_rows_argument v (Payload_Term m) ?rows)\<in>positive_meaning family_admission_system"
    by (simp only: family_admission_rows[OF presented]) (use rows family in auto)
  have formed: "term_formed ?rows" using schema_call_formed_target[OF positive_meaning_formed[OF graph]] by auto
  have data: "data_elements (map address_pair_data xs)"
    using formed by (auto simp: data_list_term_formed address_pair_data_def split: prod.splits)
  have row: "(c,a)\<in>set xs" using member rows(1) by simp
  have encoded_member: "Pair_Term (Payload_Term c) (Payload_Term a)\<in>set (map address_pair_data xs)"
    using imageI[OF row, where f=address_pair_data] by (simp add: address_pair_data_def)
  have selected: "selected_data_member (Pair_Term (Payload_Term c) (Payload_Term a)) ?rows"
    by (simp only: selected_data_member_exact data_list_term_injective)
      (use data encoded_member in auto)
  obtain rest where selection: "(5,Pair_Term (Pair_Term (Payload_Term c) (Payload_Term a)) (Pair_Term ?rows rest))
      \<in>positive_meaning bag_comparison_system" using selected by blast
  show ?thesis by (rule definition_clause_reading_step[OF admission lookup fields graph selection])
qed

theorem definition_clause_reading_exact:
  "(81,z)\<in>positive_meaning definition_clause_reading_system \<longleftrightarrow> definition_clause_reading_result z"
proof
  show "(81,z)\<in>positive_meaning definition_clause_reading_system \<Longrightarrow> definition_clause_reading_result z"
    by (rule definition_clause_reading_sound)
next
  assume "definition_clause_reading_result z"
  then obtain E e u r p C R ps i m M c a where parts:
    "z=citation_observation_argument e (use_data_term u) (Payload_Term r) (Pair_Term (Payload_Term c) (Payload_Term a))"
    "environment_value_presents E e" "native_definition_at E u r p C" "artifact_at E u R"
    "record_at R r ps [i,m]" "family_at R m M" "(c,a)\<in>M" by auto
  show "(81,z)\<in>positive_meaning definition_clause_reading_system"
    using definition_clause_reading_complete[OF parts(2-7)] by (simp only: parts(1))
qed

corollary definition_clause_reading_at_source:
  assumes source: "environment_value_presents E e"
  shows "(81,citation_observation_argument e u r (Pair_Term c a))\<in>positive_meaning definition_clause_reading_system \<longleftrightarrow>
    (\<exists>v b p C R ps i m M s q. u=use_data_term v \<and> r=Payload_Term b \<and> c=Payload_Term s \<and> a=Payload_Term q \<and>
      native_definition_at E v b p C \<and> artifact_at E v R \<and> record_at R b ps [i,m] \<and> family_at R m M \<and> (s,q)\<in>M)"
proof
  assume holds: "(81,citation_observation_argument e u r (Pair_Term c a))\<in>positive_meaning definition_clause_reading_system"
  obtain F v b p C R ps i m M s q where parts: "environment_value_presents F e" "u=use_data_term v"
    "r=Payload_Term b" "c=Payload_Term s" "a=Payload_Term q" "native_definition_at F v b p C"
    "artifact_at F v R" "record_at R b ps [i,m]" "family_at R m M" "(s,q)\<in>M"
    using holds by (simp only: definition_clause_reading_exact factor_term.inject) blast
  have same: "F=E" by (rule environment_value_presents_unique[OF parts(1) source])
  show "\<exists>v b p C R ps i m M s q. u=use_data_term v \<and> r=Payload_Term b \<and> c=Payload_Term s \<and> a=Payload_Term q \<and>
    native_definition_at E v b p C \<and> artifact_at E v R \<and> record_at R b ps [i,m] \<and> family_at R m M \<and> (s,q)\<in>M"
    using parts same by blast
next
  assume "\<exists>v b p C R ps i m M s q. u=use_data_term v \<and> r=Payload_Term b \<and> c=Payload_Term s \<and> a=Payload_Term q \<and>
    native_definition_at E v b p C \<and> artifact_at E v R \<and> record_at R b ps [i,m] \<and> family_at R m M \<and> (s,q)\<in>M"
  then obtain v b p C R ps i m M s q where parts: "u=use_data_term v" "r=Payload_Term b"
    "c=Payload_Term s" "a=Payload_Term q" "native_definition_at E v b p C" "artifact_at E v R"
    "record_at R b ps [i,m]" "family_at R m M" "(s,q)\<in>M" by blast
  show "(81,citation_observation_argument e u r (Pair_Term c a))\<in>positive_meaning definition_clause_reading_system"
    using definition_clause_reading_complete[OF source parts(5-9)] by (simp only: parts(1-4))
qed

corollary definition_clause_reading_on_values:
  assumes source: "environment_value_presents E e"
  shows "(81,citation_observation_argument e (use_data_term u) (Payload_Term r)
      (Pair_Term (Payload_Term c) (Payload_Term a)))\<in>positive_meaning definition_clause_reading_system \<longleftrightarrow>
    (\<exists>p C R ps i m M. native_definition_at E u r p C \<and> artifact_at E u R \<and>
      record_at R r ps [i,m] \<and> family_at R m M \<and> (c,a)\<in>M)"
  by (simp only: definition_clause_reading_at_source[OF source] inj_eq[OF use_data_term_injective] factor_term.inject) blast

corollary definition_clause_reading_presentation_invariance:
  assumes "environment_value_presents E e" "environment_value_presents E f"
  shows "(81,citation_observation_argument e u r (Pair_Term c a))\<in>positive_meaning definition_clause_reading_system \<longleftrightarrow>
    (81,citation_observation_argument f u r (Pair_Term c a))\<in>positive_meaning definition_clause_reading_system"
  by (simp only: definition_clause_reading_at_source[OF assms(1)] definition_clause_reading_at_source[OF assms(2)])

lemma definition_clause_reading_recovers:
  assumes source: "environment_value_presents E e"
    and holds: "(81,citation_observation_argument e (use_data_term u) (Payload_Term r)
      (Pair_Term (Payload_Term c) (Payload_Term a)))\<in>positive_meaning definition_clause_reading_system"
    and schema: "native_schema_at E u a S"
  shows "\<exists>p C. native_definition_at E u r p C \<and> (c,S)\<in>C"
proof -
  obtain p C R ps i m M where parts: "native_definition_at E u r p C" "artifact_at E u R"
    "record_at R r ps [i,m]" "family_at R m M" "(c,a)\<in>M"
    using holds by (simp only: definition_clause_reading_on_values[OF source]) blast
  have family: "native_schema_family_at E u m C" by (rule native_definition_record_family[OF parts(1-3)])
  have member: "(c,S)\<in>C"
    by (simp only: native_schema_family_at_graph(1)[OF family parts(2,4)]) (use parts(5) schema in blast)
  show ?thesis using parts(1) member by blast
qed

lemma definition_clause_reading_total:
  assumes source: "environment_value_presents E e" and raw: "native_definition_at E u r p C" and member: "(c,S)\<in>C"
  shows "\<exists>a. (81,citation_observation_argument e (use_data_term u) (Payload_Term r)
      (Pair_Term (Payload_Term c) (Payload_Term a)))\<in>positive_meaning definition_clause_reading_system \<and> native_schema_at E u a S"
proof -
  obtain R ps i m where parts: "artifact_at E u R" "record_at R r ps [i,m]" "native_schema_family_at E u m C"
    using raw by (auto simp: native_definition_at_def)
  obtain A M a where origin: "artifact_at E u A" "family_at A m M" "(c,a)\<in>M" "native_schema_at E u a S"
    using native_schema_family_origin[OF parts(3) member] by blast
  have ef: "environment_formed E" using environment_value_presents_formed[OF source] by blast
  have same: "A=R" by (rule environment_artifact_unique[OF ef origin(1) parts(1)])
  have family: "family_at R m M" using origin(2) same by simp
  have reading: "(81,citation_observation_argument e (use_data_term u) (Payload_Term r)
      (Pair_Term (Payload_Term c) (Payload_Term a)))\<in>positive_meaning definition_clause_reading_system"
    by (rule definition_clause_reading_complete[OF source raw parts(1,2) family origin(3)])
  show ?thesis using reading origin(4) by blast
qed

corollary definition_clause_reading_root_unique:
  assumes source: "environment_value_presents E e"
    and first: "(81,citation_observation_argument e (use_data_term u) (Payload_Term r)
      (Pair_Term (Payload_Term c) (Payload_Term a)))\<in>positive_meaning definition_clause_reading_system"
    and second: "(81,citation_observation_argument e (use_data_term u) (Payload_Term r)
      (Pair_Term (Payload_Term c) (Payload_Term b)))\<in>positive_meaning definition_clause_reading_system"
  shows "a=b"
proof -
  obtain R ps i m M where left: "artifact_at E u R" "record_at R r ps [i,m]" "family_at R m M" "(c,a)\<in>M"
    using first by (simp only: definition_clause_reading_on_values[OF source]) blast
  obtain A qs j n N where right: "artifact_at E u A" "record_at A r qs [j,n]" "family_at A n N" "(c,b)\<in>N"
    using second by (simp only: definition_clause_reading_on_values[OF source]) blast
  have ef: "environment_formed E" using environment_value_presents_formed[OF source] by blast
  have same: "A=R" by (rule environment_artifact_unique[OF ef right(1) left(1)])
  have rec: "record_at R r qs [j,n]" using right(2) same by simp
  have fields: "n=m" using record_at_unique[OF rec left(2)] by auto
  have family: "family_at R m N" using right(3) same fields by simp
  have graph: "N=M" by (rule family_at_unique[OF family left(3)])
  have functional: "single_valued M" using left(3) by (simp add: family_at_def)
  have other: "(c,b)\<in>M" using right(4) graph by simp
  show ?thesis by (rule single_valued_outputs[OF functional left(4) other])
qed

text \<open>
  Definition admission is independent of any requested operand: a valid
  interface supplies the hidden witness. The actual two-field record and
  complete clause family are then read, and one actual row selects the
  requested clause socket and schema root.

  The selected root is unique. Equal schemas at other roots do not replace
  that actual row. Every raw clause has its actual selected root, and reading
  a schema there recovers precisely a clause of the admitted definition.
  Source presentations and family enumeration orders cannot change the answer.
\<close>

end
