theory Presentation_Generators
  imports "Presentation_Completion"
begin

section \<open>A generator preserves subjects and covers every correspondence\<close>

locale presentation_generators = presentation_class R D A
  for R :: "'a \<Rightarrow> 'p \<Rightarrow> bool" and D A +
  fixes step :: "'p \<Rightarrow> 'p \<Rightarrow> bool"
  assumes preserves: "step p q \<Longrightarrow> presentation_transport R R p q"
    and covers: "presentation_transport R R p q \<Longrightarrow> rtranclp step p q"
begin

lemma path_preserves:
  assumes boundary: "A p" and path: "rtranclp step p q"
  shows "presentation_transport R R p q"
proof -
  obtain a where source: "R a p" using admitted[OF boundary] by blast
  have "R a q" using path
  proof (induction rule: rtranclp_induct)
    case base
    show ?case by (rule source)
  next
    case (step y z)
    obtain b where pair: "R b y" "R b z"
      using preserves[OF step.hyps(2)] by (auto simp: presentation_transport_def)
    have "a=b" by (rule recovery[OF step.IH pair(1)])
    then show ?case using pair(2) by simp
  qed
  then show ?thesis using source by (auto simp: presentation_transport_def)
qed

theorem paths_exact:
  "presentation_transport R R p q \<longleftrightarrow> A p \<and> rtranclp step p q"
  using covers path_preserves presentation_boundary by (auto simp: presentation_transport_def; blast)

theorem generator_observation_iff:
  "rel_fun (presentation_transport R R) (=) f f \<longleftrightarrow> rel_fun step (=) f f"
proof
  assume global: "rel_fun (presentation_transport R R) (=) f f"
  show "rel_fun step (=) f f" using global preserves by (auto simp: rel_fun_def)
next
  assume local: "rel_fun step (=) f f"
  have paths: "rel_fun (rtranclp step) (=) f f"
    using local by (simp only: observation_invariance_closure)
  show "rel_fun (presentation_transport R R) (=) f f"
    using paths covers by (auto simp: rel_fun_def)
qed

theorem generator_obligation_reduction:
  "exact_obligation_reduction UNIV (\<lambda>f. rel_fun (presentation_transport R R) (=) f f)
    observation_condition (observation_obligations step)"
  by (simp add: exact_obligation_reduction_def generator_observation_iff observation_obligations_exact)

theorem completion_local_evaluation:
  "exact_obligation_reduction UNIV
    (\<lambda>test. saturate_observation R test=(\<lambda>p. A p \<and> test p))
    observation_condition (observation_obligations step)"
  by (simp add: exact_obligation_reduction_def saturation_fixed_iff generator_observation_iff
    observation_obligations_exact)

theorem generator_refinement:
  assumes sound: "\<And>p q. next p q \<Longrightarrow> presentation_transport R R p q"
    and simulation: "\<And>p q. step p q \<Longrightarrow> rtranclp next p q"
  shows "presentation_generators R D A next"
proof (rule presentation_generators.intro[OF presentation_class_axioms]; unfold_locales)
  fix p q assume "next p q"
  then show "presentation_transport R R p q" by (rule sound)
next
  fix p q assume "presentation_transport R R p q"
  then have path: "rtranclp step p q" by (rule covers)
  show "rtranclp next p q" using relational_path_simulation[where h=id, OF simulation path] by simp
qed

end

theorem missing_generator_coverage_leaves_false_agreement:
  "presentation_class (\<lambda>_::unit. \<lambda>_::bool. True) (\<lambda>_. True) (\<lambda>_. True) \<and>
    (\<forall>p q::bool. False \<longrightarrow>
      presentation_transport (\<lambda>_::unit. \<lambda>_::bool. True) (\<lambda>_::unit. \<lambda>_::bool. True) p q) \<and>
    rel_fun (\<lambda>_ _::bool. False) (=) id id \<and>
    \<not>rel_fun (presentation_transport (\<lambda>_::unit. \<lambda>_::bool. True)
      (\<lambda>_::unit. \<lambda>_::bool. True)) (=) id id"
  by (auto simp: presentation_class_def rel_fun_def presentation_transport_def)

text \<open>
  The correspondence is independently fixed by a complete presentation class.
  Proposed generators must preserve it and connect every pair in it. Only
  those two proved conditions make local observation obligations exact.
  Reflexive closure outside the admitted domain supplies no presentation.

  A refinement enters the same criterion: it preserves subjects and simulates
  each old step by a finite path. Its internal depth cannot silently narrow
  the comparison class. The empty-generator counterexample keeps the coverage
  condition visible. No finite sample is claimed to cover an infinite class.
\<close>

end
