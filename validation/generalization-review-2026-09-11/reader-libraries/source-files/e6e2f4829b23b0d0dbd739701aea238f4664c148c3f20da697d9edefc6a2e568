theory Factor_Material_Meaning
  imports "Factor_Positive_Parametricity"
begin

section \<open>One finite material schema observes arbitrary future artifacts\<close>

definition incidence_material_pattern :: "nat material_pattern" where
  "incidence_material_pattern =
    \<lparr>material_source=Pattern_Variable 0, material_atoms=Pattern_Variable 1,
     material_edges=Pattern_Pair (Pattern_Variable 2) (Pattern_Variable 3),
     material_counts=Pattern_Variable 4, material_functions=Pattern_Variable 5\<rparr>"

definition incidence_schema :: "(nat,unit,unit) factor_schema" where
  "incidence_schema =
    \<lparr>schema_conclusion=Pattern_Variable 0, schema_premises={},
     schema_material_premises={((),incidence_material_pattern)}\<rparr>"

definition incidence_system :: "(nat,unit,unit,unit) schema_system" where
  "incidence_system =
    \<lparr>system_interfaces={((),Pattern_Variable 0)}, system_clauses={(((),()),incidence_schema)}\<rparr>"

lemma incidence_system_formed [simp]:
  "schema_system_formed incidence_system"
  by (auto simp: schema_system_formed_def incidence_system_def incidence_schema_def
      schema_formed_def incidence_material_pattern_def material_pattern_formed_def material_fields_def
      system_definitions_def schema_dependencies_def single_valued_def rel_dom_def rel_ran_def)

lemma incidence_schema_variables:
  "schema_variables incidence_schema = {0,1,2,3,4,5}"
  by (auto simp: schema_variables_def incidence_schema_def incidence_material_pattern_def
      material_variables_def material_fields_def)

lemma nonempty_material_enumeration_has_pair:
  assumes observed: "material_observation (Target_Term (Whole_Artifact R)) a e b f"
    and nonempty: "rra_incidence (object_structure R) \<noteq> {}"
  shows "\<exists>h t. e=Pair_Term h t"
proof -
  obtain A E B F where enumeration: "artifact_enumeration R A E B F"
    and encoding: "e=enumeration_term (map (incidence_term R) E)"
    using observed by (auto simp: material_observation_def)
  have actual: "set E = rra_incidence (object_structure R)"
    by (rule artifact_enumeration_material(3)[OF enumeration])
  have "E \<noteq> []" using actual nonempty by auto
  then obtain x xs where list: "E=x#xs" by (cases E) auto
  show ?thesis by (simp add: encoding list)
qed

lemma incidence_schema_admits_material:
  assumes observed: "material_observation s a (Pair_Term h t) b f"
  shows "((),s) \<in> positive_meaning incidence_system"
proof -
  let ?V = "{(0,s),(1,a),(2,h),(3,t),(4,b),(5,f)}"
  have formed: "term_formed s" "term_formed a" "term_formed h" "term_formed t" "term_formed b" "term_formed f"
    using material_observation_formed[OF observed] by auto
  have bindings: "term_bindings_formed (schema_variables incidence_schema) ?V"
    using formed by (auto simp: incidence_schema_variables term_bindings_formed_def single_valued_def rel_dom_def)
  have sf: "schema_formed incidence_schema"
    using incidence_system_formed by (simp add: schema_system_formed_def incidence_system_def)
  have inst: "schema_instance incidence_schema ?V s {}"
    using sf bindings by (auto simp: schema_instance_def incidence_schema_def
        schema_premise_instance_def single_valued_def rel_dom_def)
  have material_inst: "material_pattern_instance ?V incidence_material_pattern s a (Pair_Term h t) b f"
    by (simp add: material_pattern_instance_def incidence_material_pattern_def)
  have material: "schema_material_satisfied incidence_schema ?V"
    using material_inst observed
    by (auto simp: schema_material_satisfied_def incidence_schema_def material_pattern_satisfied_def; blast)
  have call: "schema_call_formed incidence_system () s"
    using formed(1) incidence_system_formed by (simp add: schema_call_formed_def incidence_system_def)
  have admitted: "admitted_schema_instance incidence_system () () ?V s {}"
    using call inst material by (auto simp: admitted_schema_instance_def incidence_system_def)
  show ?thesis by (rule positive_meaning_step[OF admitted]) simp
qed

theorem generic_incidence_observation_holds:
  assumes formed: "exact_formed R" and nonempty: "rra_incidence (object_structure R) \<noteq> {}"
  shows "((),Target_Term (Whole_Artifact R)) \<in> positive_meaning incidence_system"
proof -
  obtain a e b f where observed: "material_observation (Target_Term (Whole_Artifact R)) a e b f"
    using material_observation_total[OF formed] by blast
  obtain h t where shape: "e=Pair_Term h t"
    using nonempty_material_enumeration_has_pair[OF observed nonempty] by blast
  have material: "material_observation (Target_Term (Whole_Artifact R)) a (Pair_Term h t) b f"
    using observed shape by simp
  show ?thesis by (rule incidence_schema_admits_material[OF material])
qed

lemma incidence_schema_material_forces_nonempty:
  assumes schema: "schema_instance incidence_schema V t Q"
    and material: "schema_material_satisfied incidence_schema V"
  shows "\<exists>R. t=Target_Term (Whole_Artifact R) \<and> exact_formed R \<and>
    rra_incidence (object_structure R) \<noteq> {}"
proof -
  have sv: "single_valued V" and head: "(0,t) \<in> V"
    using schema by (auto simp: schema_instance_def incidence_schema_def term_bindings_formed_def)
  obtain s a e b f where inst: "material_pattern_instance V incidence_material_pattern s a e b f"
    and observed: "material_observation s a e b f"
    using material by (auto simp: schema_material_satisfied_def incidence_schema_def material_pattern_satisfied_def)
  have source: "(0,s) \<in> V" and pair: "\<exists>h z. e=Pair_Term h z"
    using inst by (auto simp: material_pattern_instance_def incidence_material_pattern_def)
  have same: "t=s" by (rule single_valued_outputs[OF sv head source])
  obtain R A E B F where value_shape: "s=Target_Term (Whole_Artifact R)"
    and enumeration: "artifact_enumeration R A E B F"
    using observed by (auto simp: material_observation_def)
  have rf: "exact_formed R" by (rule artifact_enumeration_material(1)[OF enumeration])
  have typed: "material_observation (Target_Term (Whole_Artifact R)) a e b f"
    using observed value_shape by simp
  have nonempty: "rra_incidence (object_structure R) \<noteq> {}"
    using material_observation_incidence_empty[OF typed] pair by auto
  show ?thesis using same value_shape rf nonempty by blast
qed

theorem generic_incidence_observation_exact:
  "((),t) \<in> positive_meaning incidence_system \<longleftrightarrow>
    (\<exists>R. t=Target_Term (Whole_Artifact R) \<and> exact_formed R \<and>
      rra_incidence (object_structure R) \<noteq> {})"
proof
  assume holds: "((),t) \<in> positive_meaning incidence_system"
  obtain c V Q where inst: "admitted_schema_instance incidence_system () c V t Q"
    using holds by (subst (asm) positive_meaning_unfold) (auto simp: schema_consequences_def)
  have schema: "schema_instance incidence_schema V t Q"
    and material: "schema_material_satisfied incidence_schema V"
    using inst by (auto simp: admitted_schema_instance_def incidence_system_def)
  show "\<exists>R. t=Target_Term (Whole_Artifact R) \<and> exact_formed R \<and>
    rra_incidence (object_structure R) \<noteq> {}"
    by (rule incidence_schema_material_forces_nonempty[OF schema material])
next
  assume "\<exists>R. t=Target_Term (Whole_Artifact R) \<and> exact_formed R \<and>
    rra_incidence (object_structure R) \<noteq> {}"
  then show "((),t) \<in> positive_meaning incidence_system"
    using generic_incidence_observation_holds by blast
qed

corollary incidence_observation_adds_expressive_power:
  assumes "schema_system_formed P" "system_observation_free P"
  shows "\<exists>R. exact_formed R \<and>
    ((d,Target_Term (Whole_Artifact R)) \<in> positive_meaning P) \<noteq>
    (((),Target_Term (Whole_Artifact R)) \<in> positive_meaning incidence_system)"
  using positive_incidence_test_not_definable[OF assms, of d]
  by (auto simp: generic_incidence_observation_exact)

text \<open>
  The same generic consequence operator evaluates this schema and the equality
  schema. The new material premise invokes the complete object equation. There
  is no incidence-specific branch in meaning or in the derivation checker.
  The nonempty list shape is supplied in this schema's ordinary edge pattern.
  Its interface accepts all formed terms; its true instances are exactly the
  whole-artifact terms displayed above. Complete native program construction
  remains a separate requirement from this semantic example.
\<close>

end
