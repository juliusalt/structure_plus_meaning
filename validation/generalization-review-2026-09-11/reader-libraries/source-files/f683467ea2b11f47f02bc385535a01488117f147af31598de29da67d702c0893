theory Factor_Substitution_Contracts
  imports "Factor_Substitution_Admission" "Factor_Context_Admission" "Factor_Schema_Reading" "Factor_Schema_Environments"
begin

section \<open>The intrinsic relation constrains three independently presented source sites\<close>

abbreviation substitution_sources_presents ::
  "(site_context\<times>site_context\<times>site_context) \<Rightarrow> factor_term \<Rightarrow> bool" where
  "substitution_sources_presents \<equiv> factor_pair_presents site_context_presents
    (factor_pair_presents site_context_presents site_context_presents)"

definition substitution_context_formed :: "(site_context\<times>site_context\<times>site_context) \<Rightarrow> bool" where
  "substitution_context_formed z \<longleftrightarrow>
    (case z of ((E,u,r),(F,v,q),(G,w,t)) \<Rightarrow> schema_substitution_at E u r F v q G w t)"

definition substitution_context_presents ::
  "(site_context\<times>site_context\<times>site_context) \<Rightarrow> factor_term \<Rightarrow> bool" where
  "substitution_context_presents z p \<longleftrightarrow> substitution_context_formed z \<and> substitution_sources_presents z p"

interpretation substitution_sources: presentation_class substitution_sources_presents
  "\<lambda>z. site_context_formed (fst z) \<and> site_context_formed (fst (snd z)) \<and> site_context_formed (snd (snd z))"
  "\<lambda>p. \<exists>x y. (156,x)\<in>positive_meaning context_admission_system \<and>
    (\<exists>a b. (156,a)\<in>positive_meaning context_admission_system \<and>
      (156,b)\<in>positive_meaning context_admission_system \<and> y=Pair_Term a b) \<and> p=Pair_Term x y"
  by (rule factor_pair_class[OF site_context_native_class factor_pair_class[OF site_context_native_class site_context_native_class]])

lemma substitution_context_boundary:
  assumes "substitution_context_formed z"
  shows "site_context_formed (fst z) \<and> site_context_formed (fst (snd z)) \<and> site_context_formed (snd (snd z))"
  using assms native_schema_position
  by (auto simp: substitution_context_formed_def schema_substitution_at_def native_schema_at_def
    pattern_record_at_def record_at_def split: prod.splits)

lemma substitution_context_fields:
  "substitution_context_presents ((E,u,r),(F,v,q),(G,w,t)) p \<longleftrightarrow>
    schema_substitution_at E u r F v q G w t \<and>
    (\<exists>a b c. site_value_presents E u r a \<and> site_value_presents F v q b \<and>
      site_value_presents G w t c \<and> p=Pair_Term a (Pair_Term b c))"
  by (auto simp: substitution_context_presents_def substitution_context_formed_def factor_pair_presents_def)

theorem substitution_context_admission:
  "(291,p)\<in>positive_meaning substitution_reading_system \<longleftrightarrow>
    (\<exists>z. substitution_context_presents z p)"
proof -
  have actual: "site_context_formed (E,u,r) \<and> site_context_formed (F,v,q) \<and> site_context_formed (G,w,t)"
    if "schema_substitution_at E u r F v q G w t" for E u r F v q G w t
    using substitution_context_boundary[of "((E,u,r),(F,v,q),(G,w,t))"] that
    by (simp add: substitution_context_formed_def)
  show ?thesis
  proof
    assume admitted: "(291,p)\<in>positive_meaning substitution_reading_system"
    obtain E e u r F f v q G g w t where data:
      "environment_value_presents E e" "environment_value_presents F f" "environment_value_presents G g"
      "p=substitution_reading_argument e (use_data_term u) (Payload_Term r)
        f (use_data_term v) (Payload_Term q) g (use_data_term w) (Payload_Term t)"
      "schema_substitution_at E u r F v q G w t"
      using admitted by (simp only: substitution_reading_exact substitution_reading_result_def) blast
    have sites: "site_value_presents E u r (Pair_Term e (site_data_term u r))"
      "site_value_presents F v q (Pair_Term f (site_data_term v q))"
      "site_value_presents G w t (Pair_Term g (site_data_term w t))"
      using data(1-3) actual[OF data(5)] by (auto simp: site_value_presents_def)
    have presented: "substitution_context_presents ((E,u,r),(F,v,q),(G,w,t)) p"
      unfolding substitution_context_fields
      by (rule conjI[OF data(5)], rule exI[of _ "Pair_Term e (site_data_term u r)"],
        rule exI[of _ "Pair_Term f (site_data_term v q)"], rule exI[of _ "Pair_Term g (site_data_term w t)"])
        (use sites data(4) in \<open>simp add: site_data_term_def\<close>)
    show "\<exists>z. substitution_context_presents z p" using presented by blast
  next
    assume "\<exists>z. substitution_context_presents z p"
    then obtain z where presented: "substitution_context_presents z p" by blast
    obtain E u r F v q G w t where shape: "z=((E,u,r),(F,v,q),(G,w,t))"
      by (metis surjective_pairing)
    obtain a b c where data: "schema_substitution_at E u r F v q G w t"
      "site_value_presents E u r a" "site_value_presents F v q b" "site_value_presents G w t c"
      "p=Pair_Term a (Pair_Term b c)"
      using presented by (simp only: shape substitution_context_fields) blast
    obtain e f g where sites: "environment_value_presents E e" "a=Pair_Term e (site_data_term u r)"
      "environment_value_presents F f" "b=Pair_Term f (site_data_term v q)"
      "environment_value_presents G g" "c=Pair_Term g (site_data_term w t)"
      using data(2-4) by (auto simp: site_value_presents_def)
    show "(291,p)\<in>positive_meaning substitution_reading_system"
      unfolding substitution_reading_exact substitution_reading_result_def
      by (rule exI[of _ E], rule exI[of _ e], rule exI[of _ u], rule exI[of _ r],
        rule exI[of _ F], rule exI[of _ f], rule exI[of _ v], rule exI[of _ q],
        rule exI[of _ G], rule exI[of _ g], rule exI[of _ w], rule exI[of _ t])
        (use sites data(1,5) in \<open>simp add: site_data_term_def\<close>)
  qed
qed

theorem substitution_context_class:
  "presentation_class substitution_context_presents substitution_context_formed
    (\<lambda>p. (291,p)\<in>positive_meaning substitution_reading_system)"
proof -
  have generic: "presentation_class (\<lambda>z p. substitution_context_formed z \<and> substitution_sources_presents z p)
      substitution_context_formed (\<lambda>p. \<exists>z. substitution_context_formed z \<and> substitution_sources_presents z p)"
    by (rule presentation_class_subdomain[OF substitution_sources.presentation_class_axioms])
      (rule substitution_context_boundary)
  show ?thesis using generic
    by (simp only: substitution_context_presents_def[symmetric] substitution_context_admission[symmetric])
qed

interpretation substitution_contexts: presentation_class substitution_context_presents substitution_context_formed
  "\<lambda>p. (291,p)\<in>positive_meaning substitution_reading_system"
  by (rule substitution_context_class)

theorem substitution_context_predicate:
  "(291,p)\<in>positive_meaning substitution_reading_system \<longleftrightarrow>
    presented_predicate substitution_sources_presents substitution_context_formed p"
  by (simp only: substitution_context_admission substitution_context_presents_def presented_predicate_def conj_commute)

theorem substitution_context_at:
  assumes "substitution_sources_presents z p"
  shows "(291,p)\<in>positive_meaning substitution_reading_system \<longleftrightarrow> substitution_context_formed z"
  by (simp only: substitution_context_predicate substitution_sources.predicate_at[OF assms])

theorem substitution_context_invariance:
  assumes "substitution_sources_presents z p" "substitution_sources_presents z q"
  shows "(291,p)\<in>positive_meaning substitution_reading_system \<longleftrightarrow>
    (291,q)\<in>positive_meaning substitution_reading_system"
  by (simp only: substitution_context_at[OF assms(1)] substitution_context_at[OF assms(2)])

section \<open>An actual empty binder supplies an admitted identity substitution\<close>

lemma empty_binder_pattern_record:
  assumes formed: "environment_formed E" and source: "artifact_at E u R" and binder_read: "binder_scope_at R b {}"
  shows "pattern_record_at E u {} b [] {b} {}"
proof -
  have rec: "record_at R b [] []"
    using binder_read by (auto simp: binder_scope_at_def family_at_def record_at_def raw_record_at_def rel_dom_def)
  show ?thesis unfolding pattern_record_at_def
    by (rule conjI[OF formed], rule exI[of _ R], rule exI[of _ "[]"], rule exI[of _ "[]"], rule exI[of _ "{}"])
      (use source rec formed in \<open>simp add: pattern_vector_nil\<close>)
qed

theorem ground_schema_substitution:
  assumes raw: "native_schema_at E u r S" and ground: "schema_variables S={}"
  shows "\<exists>b. schema_substitution_at E u r E u b E u r"
proof -
  obtain R b where parts: "environment_formed E" "artifact_at E u R" "binder_scope_at R b {}"
    using raw ground by (auto simp: native_schema_at_def)
  have rec: "pattern_record_at E u {} b [] {b} {}"
    by (rule empty_binder_pattern_record[OF parts])
  have actual: "schema_substitution_at E u r E u b E u r"
    unfolding schema_substitution_at_def
    by (rule exI[of _ S], rule exI[of _ Pattern_Variable], rule exI[of _ "[]"],
      rule exI[of _ "{b}"], rule exI[of _ "{}"])
      (use raw ground rec in \<open>simp add: substitution_row_patterns_def\<close>)
  show ?thesis using actual by blast
qed

theorem substitution_context_inhabited:
  "\<exists>p. (291,p)\<in>positive_meaning substitution_reading_system"
proof -
  let ?S="recognizer_schema (Pattern_Payload []) :: (unit,unit,local_address option definition_site) factor_schema"
  have formed: "schema_formed ?S" by (simp add: octets_formed_def)
  have no_callees: "schema_dependencies ?S={}"
    by (simp add: schema_dependencies_def recognizer_schema_def rel_ran_def)
  obtain E u r f h where native: "native_schema_at E u r (rename_schema f h id ?S)"
    using callee_free_schema_native_total[OF formed no_callees] by blast
  have ground: "schema_variables (rename_schema f h id ?S)={}"
    by (simp add: renamed_schema_variables)
  obtain b where actual: "schema_substitution_at E u r E u b E u r"
    using ground_schema_substitution[OF native ground] by blast
  have subject: "substitution_context_formed ((E,u,r),(E,u,b),(E,u,r))"
    using actual by (simp add: substitution_context_formed_def)
  obtain p where presentation: "substitution_context_presents ((E,u,r),(E,u,b),(E,u,r)) p"
    using substitution_contexts.total[OF subject] by blast
  show ?thesis using substitution_contexts.presentation_boundary[OF presentation] by blast
qed

text \<open>
  The independent subject is the triple of actual source sites linked by
  schema substitution. Each site retains its entire environment, actual use,
  and address. The general product and subdomain constructions derive its
  class from the existing site classes. The native predicate is exactly this
  intrinsic relation on every compatible presentation; it does not define
  the relation by the desired answer or select one encoding.

  The replacement record is interpreted under the target schema's complete
  binder, as specified by the joint relation. No function from a record alone
  to a target is claimed. A ground schema's actual empty binder also forms
  the existing empty pattern record. It supplies an identity substitution
  without adding source material. Native compilation of an ordinary literal
  schema and class coverage therefore construct an admitted checker input.
\<close>

end
