theory Factor_Inference_Reader_Compilation
  imports "Factor_Library_Compilation" "Factor_Inference_Specialization_Clauses" "Factor_Clause_Rule_Application"
begin

definition compiled_binding_record_schema where
  "compiled_binding_record_schema=finite_schema_of binding_record_schema"

definition compiled_specialization_binding_schema where
  "compiled_specialization_binding_schema=finite_schema_of specialization_binding_schema"

definition compiled_inference_specialization_schema where
  "compiled_inference_specialization_schema=finite_schema_of inference_specialization_schema"

lemmas compiled_binding_record_code [code] =
  compiled_binding_record_schema_def[unfolded binding_record_schema_def finite_schema_of_def
    map_relation_values_def, simplified finite_set_empty_encoding finite_set_insert_encoding]

lemmas compiled_specialization_binding_code [code] =
  compiled_specialization_binding_schema_def[unfolded specialization_binding_schema_def finite_schema_of_def
    map_relation_values_def, simplified finite_set_empty_encoding finite_set_insert_encoding]

lemmas compiled_inference_specialization_code [code] =
  compiled_inference_specialization_schema_def[unfolded inference_specialization_schema_def finite_schema_of_def
    map_relation_values_def, simplified finite_set_empty_encoding finite_set_insert_encoding]

lemma compiled_inference_reader_schemas:
  "decode_finite_schema compiled_binding_record_schema=binding_record_schema"
  "decode_finite_schema compiled_specialization_binding_schema=specialization_binding_schema"
  "decode_finite_schema compiled_inference_specialization_schema=inference_specialization_schema"
  unfolding compiled_binding_record_schema_def compiled_specialization_binding_schema_def
    compiled_inference_specialization_schema_def
  by (rule decode_finite_schema_of; auto simp: binding_record_schema_def specialization_binding_schema_def
    inference_specialization_schema_def schema_formed_def single_valued_def rel_dom_def octets_formed_def)+

definition inference_reader_construction_library ::
  "(nat\<times>(nat,nat,nat) finite_factor_schema\<times>(nat\<times>nat\<times>nat finite_term_pattern) list) list" where
  "inference_reader_construction_library=finite_compiled_library
    [(348,compiled_binding_record_schema),(349,compiled_specialization_binding_schema),
     (350,compiled_inference_specialization_schema)]"

lemma inference_reader_compiled_clause:
  assumes member: "(d,S,ps)\<in>set inference_reader_construction_library"
  shows "((d,0),decode_finite_schema S)\<in>system_clauses inference_specialization_system \<and>
    "(d,Pattern_Variable 0)\<in>system_interfaces inference_specialization_system"
  using member
  by (auto simp: inference_reader_construction_library_def finite_compiled_library_member
    compiled_inference_reader_schemas inference_specialization_system_def inference_specialization_base_system_def
    specialization_binding_system_def specialization_binding_base_system_def binding_record_system_def
    system_union_interfaces)

theorem inference_reader_construction_member_sound:
  assumes member: "(d,S,ps)\<in>set inference_reader_construction_library"
    and rule_instance: "schema_rule_instance (decode_finite_schema S) (positive_meaning inference_specialization_system) t"
  shows "(d,t)\<in>positive_meaning inference_specialization_system"
  by (rule positive_variable_clause_rule[OF inference_specialization_formed
    conjunct1[OF inference_reader_compiled_clause[OF member]]
    conjunct2[OF inference_reader_compiled_clause[OF member]] rule_instance])

text \<open>
  Each finite schema is compiled from the actual native clause definition.
  The generated code equations are simplifications of that definition.
  Complete premise enumerations are generated by the common compiler.
  All three clauses are used in the same actual inference-specialization
  program, and their conditional semantic contract follows from its clauses.
\<close>

export_code inference_reader_construction_library checking SML

end
