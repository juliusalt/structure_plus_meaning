theory Factor_Application_Vector
  imports "Factor_Site_Link_Reading"
begin

section \<open>Every binding-row root retains its arbitrary formed term\<close>

abbreviation application_vector_result :: "factor_term\<Rightarrow>bool" where
  "application_vector_result z \<equiv> boundary_rows_result application_reading_result z"

definition application_vector_system :: "(nat,nat,nat,nat) schema_system" where
  "application_vector_system=add_view_definition site_link_reading_system 90 data_x (boundary_list_clauses 58 90)"

lemma application_vector_system_formed [simp]: "schema_system_formed application_vector_system"
  unfolding application_vector_system_def
  by (rule add_recursive_definition_formed[OF site_link_reading_system_formed])
    (auto simp: boundary_list_clauses_def boundary_list_nil_schema_def boundary_list_cons_schema_def
      schema_formed_def schema_dependencies_def single_valued_def rel_dom_def rel_ran_def octets_formed_def)

lemma application_vector_definitions [simp]:
  "system_definitions application_vector_system=insert 90 (system_definitions site_link_reading_system)"
  by (simp add: application_vector_system_def)

lemma application_vector_call:
  "schema_call_formed application_vector_system d t \<longleftrightarrow>
    d\<in>system_definitions application_vector_system \<and> term_formed t"
  using added_variable_calls[OF site_link_reading_system_formed
    application_vector_system_formed[unfolded application_vector_system_def] site_link_reading_call]
  by (simp only: application_vector_system_def[symmetric])

lemma application_vector_old_meaning:
  assumes "d\<in>system_definitions site_link_reading_system"
  shows "(d,t)\<in>positive_meaning application_vector_system \<longleftrightarrow> (d,t)\<in>positive_meaning site_link_reading_system"
  using added_definition_preserves_old(2)[OF site_link_reading_system_formed
    application_vector_system_formed[unfolded application_vector_system_def], of d t] assms
  by (auto simp: application_vector_system_def)

lemma application_vector_clause [simp]:
  "((90,c),S)\<in>system_clauses application_vector_system \<longleftrightarrow> (c,S)\<in>(boundary_list_clauses 58 90)"
proof -
  have owned: "((d,c),S)\<in>system_clauses site_link_reading_system \<Longrightarrow>
    d\<in>system_definitions site_link_reading_system" for d c S
    using site_link_reading_system_formed unfolding schema_system_formed_def by blast
  have absent: "((90,c),S)\<notin>system_clauses site_link_reading_system" by (auto dest: owned)
  show ?thesis using absent by (simp add: application_vector_system_def)
qed

lemma application_vector_base_meaning:
  assumes "d\<in>system_definitions admitted_instantiation_system"
  shows "(d,t)\<in>positive_meaning application_vector_system \<longleftrightarrow> (d,t)\<in>positive_meaning admitted_instantiation_system"
  using application_vector_old_meaning[of d t] site_link_reading_base_meaning[OF assms, of t] assms by auto

lemma application_vector_element:
  "(58,t)\<in>positive_meaning application_vector_system \<longleftrightarrow> (58,t)\<in>positive_meaning application_reading_system"
  using application_vector_base_meaning[of 58 t] metadata_reading_components(6)[of t] by auto

lemma application_vector_components:
  "(46,t)\<in>positive_meaning application_vector_system \<longleftrightarrow> (46,t)\<in>positive_meaning data_append_system"
  "(6,t)\<in>positive_meaning application_vector_system \<longleftrightarrow> (6,t)\<in>positive_meaning bag_comparison_system"
  "(48,t)\<in>positive_meaning application_vector_system \<longleftrightarrow> (48,t)\<in>positive_meaning data_union_system"
  "(49,t)\<in>positive_meaning application_vector_system \<longleftrightarrow> (49,t)\<in>positive_meaning payload_disjoint_system"
  using application_vector_base_meaning[of 46 t] metadata_reading_components(7)[of t]
    application_vector_base_meaning[of 6 t] metadata_reading_components(8)[of t]
    application_vector_base_meaning[of 48 t] metadata_reading_components(9)[of t]
    application_vector_base_meaning[of 49 t] metadata_reading_components(10)[of t] by auto

interpretation application_vector_profile: boundary_list_profile application_vector_system 58 90
  by (rule boundary_list_profile.intro)
    (auto simp: application_vector_call application_vector_components application_vector_element application_reading_exact)

theorem application_vector_exact:
  "(90,z)\<in>positive_meaning application_vector_system \<longleftrightarrow> application_vector_result z"
  by (simp only: application_vector_profile.exact application_vector_element application_reading_exact)

corollary application_vector_empty:
  "(90,boundary_reading_argument ctx (Payload_Term []) (Payload_Term []) (Payload_Term []) (Payload_Term []))
    \<in>positive_meaning application_vector_system \<longleftrightarrow> term_formed ctx"
  by (rule application_vector_profile.empty)

lemma application_reading_row_at_source:
  assumes source: "environment_value_presents E e"
  shows "application_reading_result (term_quotation_argument e u r q i k) \<longleftrightarrow>
    (\<exists>v a d t Is Ks. u=use_data_term v \<and> r=Payload_Term a \<and> q=Pair_Term (definition_site_value d) t \<and>
      i=data_list_term (map Payload_Term Is) \<and> k=data_list_term (map Payload_Term Ks) \<and>
      distinct Is \<and> distinct Ks \<and> native_application_at E v a d t (set Is) (set Ks))"
proof
  assume holds: "application_reading_result (term_quotation_argument e u r q i k)"
  obtain F v a du da t Is Ks where parts: "environment_value_presents F e"
    "u=use_data_term v" "r=Payload_Term a" "q=Pair_Term (site_data_term du da) t"
    "i=data_list_term (map Payload_Term Is)" "k=data_list_term (map Payload_Term Ks)"
    "distinct Is" "distinct Ks" "native_application_at F v a (du,da) t (set Is) (set Ks)"
    using holds by (simp only: factor_term.inject) blast
  have same: "F=E" by (rule environment_value_presents_unique[OF parts(1) source])
  show "\<exists>v a d t Is Ks. u=use_data_term v \<and> r=Payload_Term a \<and> q=Pair_Term (definition_site_value d) t \<and>
    i=data_list_term (map Payload_Term Is) \<and> k=data_list_term (map Payload_Term Ks) \<and>
    distinct Is \<and> distinct Ks \<and> native_application_at E v a d t (set Is) (set Ks)"
    by (rule exI[of _ v], rule exI[of _ a], rule exI[of _ "(du,da)"], rule exI[of _ t],
      rule exI[of _ Is], rule exI[of _ Ks]) (use parts same in simp)
next
  assume "\<exists>v a d t Is Ks. u=use_data_term v \<and> r=Payload_Term a \<and> q=Pair_Term (definition_site_value d) t \<and>
    i=data_list_term (map Payload_Term Is) \<and> k=data_list_term (map Payload_Term Ks) \<and>
    distinct Is \<and> distinct Ks \<and> native_application_at E v a d t (set Is) (set Ks)"
  then obtain v a d t Is Ks where parts: "u=use_data_term v" "r=Payload_Term a"
    "q=Pair_Term (definition_site_value d) t" "i=data_list_term (map Payload_Term Is)"
    "k=data_list_term (map Payload_Term Ks)" "distinct Is" "distinct Ks"
    "native_application_at E v a d t (set Is) (set Ks)" by blast
  obtain du da where site: "d=(du,da)" by (cases d)
  show "application_reading_result (term_quotation_argument e u r q i k)"
    by (rule exI[of _ E], rule exI[of _ e], rule exI[of _ v], rule exI[of _ a],
      rule exI[of _ du], rule exI[of _ da], rule exI[of _ t], rule exI[of _ Is], rule exI[of _ Ks])
      (use parts source site in simp)
qed

corollary application_vector_presentation_invariance:
  assumes "environment_value_presents E e" "environment_value_presents E f"
  shows "(90,term_quotation_argument e u r q i k)\<in>positive_meaning application_vector_system \<longleftrightarrow>
    (90,term_quotation_argument f u r q i k)\<in>positive_meaning application_vector_system"
proof -
  have row: "application_reading_result (term_quotation_argument e u a b j l) \<longleftrightarrow>
    application_reading_result (term_quotation_argument f u a b j l)" for a b j l
    by (simp only: application_reading_row_at_source[OF assms(1)] application_reading_row_at_source[OF assms(2)])
  have formed: "term_formed (Pair_Term e u) \<longleftrightarrow> term_formed (Pair_Term f u)"
    using environment_value_presents_formed[OF assms(1)] environment_value_presents_formed[OF assms(2)] by auto
  show ?thesis by (simp only: application_vector_exact)
    (rule boundary_rows_result_context_cong[where R=application_reading_result and S=application_reading_result
      and ctx="Pair_Term e u" and other="Pair_Term f u", OF formed row])
qed

text \<open>
  The shared list clauses call the existing raw application reader at every
  supplied root. Each recovered site-and-term pair remains in that position.
  Terms may contain literal targets. Counted interiors reject shared syntax;
  slot union permits shared external references. Empty traversal requires a
  formed context, and an enclosing table supplies its actual source boundary.
\<close>

end
