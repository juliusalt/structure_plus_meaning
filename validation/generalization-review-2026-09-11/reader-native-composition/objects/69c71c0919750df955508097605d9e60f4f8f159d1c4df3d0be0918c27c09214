import json,os,subprocess,sys
from pathlib import Path
root=Path('/home/julius/structure_and_semantics')
archive=root/'validation/generalization-review-2026-09-11/reader-native-composition'
index=json.loads((archive/'index.json').read_text())
base=Path('/tmp/reader-composition-replays');base.mkdir(exist_ok=False)
poly='/opt/isabelle/contrib/polyml-5.9.2-2/x86_64-linux/poly'
results=[]
for kind,names in [('stage',index['runs']),('investigation',index['investigations'])]:
 for name in names:
  output=base/(kind+'-'+name)
  command=[sys.executable,str(root/'tools/replay_reasoning_review.py'),'--archive',str(archive),'--'+kind,name,'--poly',poly,'--output',str(output)]
  with (base/(kind+'-'+name+'-command.log')).open('w') as log:
   r=subprocess.run(command,stdout=log,stderr=subprocess.STDOUT,env={**os.environ,'PYTHONDONTWRITEBYTECODE':'1'})
  if r.returncode:
   print((base/(kind+'-'+name+'-command.log')).read_text()[-7000:],flush=True);raise SystemExit(r.returncode)
  result=json.loads((output/'replay.json').read_text());assert result['status']=='accepted'
  results.append({'kind':kind,'name':name,'output':str(output),'status':result['status']})
  print('PASS',kind,name,flush=True)
(base/'all-results.json').write_text(json.dumps(results,indent=2)+'\n')
print('PASS: all',len(results),'retained reports replayed.',flush=True)
