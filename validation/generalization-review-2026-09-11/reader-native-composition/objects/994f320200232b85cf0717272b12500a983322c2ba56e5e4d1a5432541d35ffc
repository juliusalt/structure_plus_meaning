theorem ground_schema_substitution:
  assumes raw: "native_schema_at E u r S" and ground: "schema_variables S={}"
  shows "\<exists>b. schema_substitution_at E u r E u b E u r"
proof -
  obtain R b where parts: "environment_formed E" "artifact_at E u R" "binder_scope_at R b {}"
    using raw ground by (auto simp: native_schema_at_def)
  have rec: "pattern_record_at E u {} b [] {b} {}"
    by (rule empty_binder_pattern_record[OF parts])
  have actual: "schema_substitution_at E u r E u b E u r"
    unfolding schema_substitution_at_def
    by (rule exI[of _ S], rule exI[of _ Pattern_Variable], rule exI[of _ "[]"],
      rule exI[of _ "{b}"], rule exI[of _ "{}"])
      (use raw ground rec in \<open>simp add: substitution_row_patterns_def\<close>)
  show ?thesis using actual by blast
qed

