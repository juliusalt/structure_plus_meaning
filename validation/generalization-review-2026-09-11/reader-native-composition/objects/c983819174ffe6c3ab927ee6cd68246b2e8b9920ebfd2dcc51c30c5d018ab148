import copy, json, sys
from pathlib import Path
sys.dont_write_bytecode=True
root=Path('/home/julius/structure_and_semantics');sys.path.insert(0,str(root/'tools'))
import check_reasoning as r
out=Path('/tmp/generalization-quality-review/reader-native-composition')
proof_path=Path(sys.argv[1]).resolve(); proof=json.loads(proof_path.read_text())
assert proof['status']=='accepted' and proof['exit_code']==0 and proof['sources_unchanged']
assert all(r.digest(root/'theories'/(n+'.thy'))==h for n,h in proof['sources'].items())
spec=json.loads((out/'initial-specification.json').read_text())
for e in spec['evidence']:assert r.digest(Path(e['path']))==e['sha256']
spec['contract_proofs']={str(d):{'theory':n,'theorem':t,'source_sha256':proof['sources'][n]} for d,n,t in [
 (10,'Factor_Specialization_Binding_Total','specialization_binding_total'),
 (11,'Factor_Proof_Node_Extension','native_proof_node_extension'),
 (12,'Factor_Specialization_Binding_Total','specialization_binding_source_included'),
 (40,'Factor_Inference_Specialization_Total','inference_specialization_extension'),
 (41,'Factor_Inference_Specialization_Total','inference_specialization_reading_inhabited')]}
spec['cases'][0]['name']='proved-contracts'
spec['cases'][0]['known']=copy.deepcopy(spec['cases'][2]['known'])
spec['cases'][0]['frontier']=copy.deepcopy(spec['cases'][2]['frontier'])
for d in [13,14]:
    c=copy.deepcopy(spec['cases'][2]); c['name']='native-source-contract-withheld-'+str(d)
    c['known']=[q for q in c['known'] if q[0]!=d]; c['frontier']=copy.deepcopy(c['known'])
    spec['cases'].append(c)
paths=[proof_path,Path(__file__),out/'initial-specification.json']
paths += [root/'theories'/(n+'.thy') for n in ['Factor_Inference_Specialization_Total','Factor_Proof_Node_Extension','Factor_Specialization_Binding_Total']]
spec['evidence'] += [{'path':str(p),'sha256':r.digest(p)} for p in paths]
spec['boundary'] += ' The new joins and their complete composition now have the attached Isabelle proofs. The original dependency proposal overrequires native source readings for local node construction. The second method moves those obligations to the native reading boundary. Added withholding controls expose that distinction. Entry 16 remains unproved.'
for stage in ['original','factored']:
    current=copy.deepcopy(spec)
    if stage=='factored':
        for c in current['cases']:
            for entry in c['library']:
                if entry['entry']==40: sockets=[(0,10),(1,11),(2,12)]
                elif entry['entry']==41: sockets=[(0,40),(1,15),(2,13),(3,14)]
                else: continue
                rule=r.schema(r.variable(0),[[s,d,r.variable(0)] for s,d in sockets])
                entry['schema']=rule;entry['enumeration']=copy.deepcopy(rule['premises'])
    p=out/('proved-'+stage+'-specification.json');assert not p.exists()
    p.write_text(json.dumps(current,indent=2)+'\n');print(p)
