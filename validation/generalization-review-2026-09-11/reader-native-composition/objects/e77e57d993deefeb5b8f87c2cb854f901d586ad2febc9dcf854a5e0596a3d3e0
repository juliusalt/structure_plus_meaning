theory Factor_Realization
  imports "Factor_Proof_Metadata" "Factor_Derivation_Recovery"
begin

type_synonym 'u native_derivation_graph =
  "('u definition_site,'u definition_site,'u definition_site,'u definition_site) schema_derivation_graph"

section \<open>A native graph realizes every node and every premise occurrence\<close>

definition native_schema_graph_at ::
  "'u artifact_environment \<Rightarrow> 'u definition_site \<Rightarrow> 'u native_derivation_graph \<Rightarrow> bool" where
  "native_schema_graph_at E root G \<longleftrightarrow> schema_graph_formed G root \<and>
    (\<forall>n A. (n,A) \<in> fset (graph_inferences G) \<longrightarrow>
      (\<exists>I K. native_proof_node_at E (fst n) (snd n) A (schema_graph_premises G n) I K))"

lemma native_schema_graph_entry:
  assumes graph: "native_schema_graph_at E root G" and member: "(n,A) \<in> fset (graph_inferences G)"
  shows "\<exists>I K. native_proof_node_at E (fst n) (snd n) A (schema_graph_premises G n) I K"
  using assms unfolding native_schema_graph_at_def by blast

lemma native_schema_graph_node:
  assumes graph: "native_schema_graph_at E root G" and member: "n \<in> schema_graph_nodes G"
  shows "\<exists>A I K. (n,A) \<in> fset (graph_inferences G) \<and>
    native_proof_node_at E (fst n) (snd n) A (schema_graph_premises G n) I K"
proof -
  obtain A where entry: "(n,A) \<in> fset (graph_inferences G)"
    using member by (auto simp: schema_graph_nodes_def rel_dom_def)
  show ?thesis using entry native_schema_graph_entry[OF graph entry] by blast
qed

lemma native_schema_graph_positions:
  assumes graph: "native_schema_graph_at E root G"
  shows "schema_graph_nodes G \<subseteq> environment_positions E"
proof
  fix n assume member: "n \<in> schema_graph_nodes G"
  obtain A I K where node: "native_proof_node_at E (fst n) (snd n) A (schema_graph_premises G n) I K"
    using native_schema_graph_node[OF graph member] by blast
  show "n \<in> environment_positions E" using native_proof_node_properties(2)[OF node] by simp
qed

lemma native_schema_graph_environment:
  assumes graph: "native_schema_graph_at E root G"
  shows "environment_formed E"
proof -
  have root: "root \<in> schema_graph_nodes G" using graph
    by (simp add: native_schema_graph_at_def schema_graph_formed_def)
  obtain A I K where node: "native_proof_node_at E (fst root) (snd root) A (schema_graph_premises G root) I K"
    using native_schema_graph_node[OF graph root] by blast
  show ?thesis by (rule native_proof_node_properties(1)[OF node])
qed

definition native_proof_edges ::
  "'u artifact_environment \<Rightarrow> ('u definition_site \<times> 'u definition_site) set" where
  "native_proof_edges E = {(m,n). \<exists>A D I K s.
    native_proof_node_at E (fst n) (snd n) A D I K \<and> (s,m) \<in> D}"

definition native_proof_sites ::
  "'u artifact_environment \<Rightarrow> 'u definition_site \<Rightarrow> 'u definition_site set" where
  "native_proof_sites E root = {n. (n,root) \<in> (native_proof_edges E)\<^sup>*}"

lemma native_schema_graph_edge_at:
  assumes graph: "native_schema_graph_at E root G" and parent: "n \<in> schema_graph_nodes G"
  shows "(m,n) \<in> native_proof_edges E \<longleftrightarrow> (m,n) \<in> schema_graph_edges G"
proof -
  obtain A I K where node: "native_proof_node_at E (fst n) (snd n) A (schema_graph_premises G n) I K"
    using native_schema_graph_node[OF graph parent] by blast
  show ?thesis
  proof
    assume edge: "(m,n) \<in> native_proof_edges E"
    obtain B D J W s where other: "native_proof_node_at E (fst n) (snd n) B D J W" "(s,m) \<in> D"
      using edge by (auto simp: native_proof_edges_def)
    have same: "D=schema_graph_premises G n" using native_proof_node_unique[OF other(1) node] by blast
    have actual: "(s,m) \<in> schema_graph_premises G n" using other(2) same by simp
    show "(m,n) \<in> schema_graph_edges G" by (rule schema_graph_edge[OF actual])
  next
    assume edge: "(m,n) \<in> schema_graph_edges G"
    obtain s where premise: "(s,m) \<in> schema_graph_premises G n"
      using edge by (auto simp: schema_graph_edges_def schema_graph_premises_def)
    show "(m,n) \<in> native_proof_edges E" using node premise unfolding native_proof_edges_def by blast
  qed
qed

lemma native_schema_graph_edges:
  assumes graph: "native_schema_graph_at E root G"
  shows "schema_graph_edges G \<subseteq> native_proof_edges E"
proof
  fix edge assume member: "edge \<in> schema_graph_edges G"
  obtain m n where shape: "edge=(m,n)" by (cases edge)
  have formed: "schema_graph_formed G root" using graph by (simp add: native_schema_graph_at_def)
  have actual: "(m,n) \<in> schema_graph_edges G" using member shape by simp
  have parent: "n \<in> schema_graph_nodes G" by (rule schema_graph_edge_nodes(2)[OF formed actual])
  show "edge \<in> native_proof_edges E" using native_schema_graph_edge_at[OF graph parent] actual shape by simp
qed

theorem native_schema_graph_exact_sites:
  assumes graph: "native_schema_graph_at E root G"
  shows "schema_graph_nodes G=native_proof_sites E root"
proof -
  have formed: "schema_graph_formed G root" and root: "root \<in> schema_graph_nodes G"
    and paths: "\<forall>n\<in>schema_graph_nodes G. (n,root) \<in> (schema_graph_edges G)\<^sup>*"
    using graph by (auto simp: native_schema_graph_at_def schema_graph_formed_def)
  have closure: "(schema_graph_edges G)\<^sup>* \<subseteq> (native_proof_edges E)\<^sup>*"
    by (rule rtrancl_mono[OF native_schema_graph_edges[OF graph]])
  have lower: "schema_graph_nodes G \<subseteq> native_proof_sites E root"
    using paths closure by (auto simp: native_proof_sites_def)
  have descent: "\<And>m n. (m,n) \<in> native_proof_edges E \<Longrightarrow>
    n \<in> schema_graph_nodes G \<Longrightarrow> m \<in> schema_graph_nodes G"
  proof -
    fix m n assume edge: "(m,n) \<in> native_proof_edges E" and parent: "n \<in> schema_graph_nodes G"
    have actual: "(m,n) \<in> schema_graph_edges G" using native_schema_graph_edge_at[OF graph parent] edge by simp
    show "m \<in> schema_graph_nodes G" by (rule schema_graph_edge_nodes(1)[OF formed actual])
  qed
  have path: "\<And>a b. (a,b) \<in> (native_proof_edges E)\<^sup>* \<Longrightarrow>
    b \<in> schema_graph_nodes G \<longrightarrow> a \<in> schema_graph_nodes G"
  proof -
    fix a b assume reach: "(a,b) \<in> (native_proof_edges E)\<^sup>*"
    show "b \<in> schema_graph_nodes G \<longrightarrow> a \<in> schema_graph_nodes G"
      using reach by (induction rule: rtrancl_induct) (use descent in blast)+
  qed
  have upper: "native_proof_sites E root \<subseteq> schema_graph_nodes G"
    using path root unfolding native_proof_sites_def by blast
  show ?thesis using lower upper by blast
qed

lemma native_schema_graph_common_node:
  assumes first: "native_schema_graph_at E root G" and second: "native_schema_graph_at E root H"
    and left: "(n,A) \<in> fset (graph_inferences G)" and right: "(n,B) \<in> fset (graph_inferences H)"
  shows "A=B" "schema_graph_premises G n=schema_graph_premises H n"
proof -
  obtain I K where g: "native_proof_node_at E (fst n) (snd n) A (schema_graph_premises G n) I K"
    using native_schema_graph_entry[OF first left] by blast
  obtain J W where h: "native_proof_node_at E (fst n) (snd n) B (schema_graph_premises H n) J W"
    using native_schema_graph_entry[OF second right] by blast
  show "A=B" "schema_graph_premises G n=schema_graph_premises H n"
    using native_proof_node_unique[OF g h] by blast+
qed

lemma native_schema_graph_node_inclusion:
  assumes first: "native_schema_graph_at E root G" and second: "native_schema_graph_at E root H"
  shows "fset (graph_inferences G) \<subseteq> fset (graph_inferences H)"
proof
  fix row assume member: "row \<in> fset (graph_inferences G)"
  obtain n A where shape: "row=(n,A)" by (cases row)
  have actual: "(n,A) \<in> fset (graph_inferences G)" using member shape by simp
  have inside: "n \<in> schema_graph_nodes G" using actual by (auto simp: schema_graph_nodes_def rel_dom_def)
  have same: "schema_graph_nodes G=schema_graph_nodes H"
    using native_schema_graph_exact_sites[OF first] native_schema_graph_exact_sites[OF second] by simp
  obtain B where target: "(n,B) \<in> fset (graph_inferences H)"
    using inside same by (auto simp: schema_graph_nodes_def rel_dom_def)
  have kind: "A=B" by (rule native_schema_graph_common_node(1)[OF first second actual target])
  show "row \<in> fset (graph_inferences H)" using shape target kind by simp
qed

lemma native_schema_graph_discharge_inclusion:
  assumes first: "native_schema_graph_at E root G" and second: "native_schema_graph_at E root H"
  shows "fset (graph_discharges G) \<subseteq> fset (graph_discharges H)"
proof
  fix row assume member: "row \<in> fset (graph_discharges G)"
  obtain n s m where shape: "row=((n,s),m)" by (cases row) auto
  have actual: "((n,s),m) \<in> fset (graph_discharges G)" using member shape by simp
  have premise: "(s,m) \<in> schema_graph_premises G n" using actual by (simp add: schema_graph_premises_def)
  have edge: "(m,n) \<in> schema_graph_edges G" by (rule schema_graph_edge[OF premise])
  have formed: "schema_graph_formed G root" using first by (simp add: native_schema_graph_at_def)
  have inside: "n \<in> schema_graph_nodes G" by (rule schema_graph_edge_nodes(2)[OF formed edge])
  obtain A where left: "(n,A) \<in> fset (graph_inferences G)"
    using inside by (auto simp: schema_graph_nodes_def rel_dom_def)
  have right: "(n,A) \<in> fset (graph_inferences H)"
    by (rule subsetD[OF native_schema_graph_node_inclusion[OF first second] left])
  have same: "schema_graph_premises G n=schema_graph_premises H n"
    by (rule native_schema_graph_common_node(2)[OF first second left right])
  have copied: "(s,m) \<in> schema_graph_premises H n" using premise same by simp
  show "row \<in> fset (graph_discharges H)" using copied shape by (simp add: schema_graph_premises_def)
qed

theorem native_schema_graph_unique:
  assumes first: "native_schema_graph_at E root G" and second: "native_schema_graph_at E root H"
  shows "G=H"
proof -
  have nodes: "fset (graph_inferences G)=fset (graph_inferences H)"
    using native_schema_graph_node_inclusion[OF first second] native_schema_graph_node_inclusion[OF second first] by blast
  have edges: "fset (graph_discharges G)=fset (graph_discharges H)"
    using native_schema_graph_discharge_inclusion[OF first second] native_schema_graph_discharge_inclusion[OF second first] by blast
  have node_fields: "graph_inferences G=graph_inferences H" using nodes by auto
  have edge_fields: "graph_discharges G=graph_discharges H" using edges by auto
  show ?thesis using node_fields edge_fields by (cases G; cases H) simp
qed

corollary native_schema_graph_rejects_changed_projection:
  assumes "native_schema_graph_at E root G" "G\<noteq>H"
  shows "\<not> native_schema_graph_at E root H"
  using assms native_schema_graph_unique by blast

text \<open>
  Native node identities are actual use-and-address sites. All incoming links
  to one site therefore share one node. The exact reachable closure recovered
  from the native premise links equals the graph's node set; no node or edge
  may be omitted or added to that projection. This structural realization does
  not check a root judgment, clause admission, assumptions, or positive truth.
  Those conditions remain in the independent derivation relation.
\<close>

end
