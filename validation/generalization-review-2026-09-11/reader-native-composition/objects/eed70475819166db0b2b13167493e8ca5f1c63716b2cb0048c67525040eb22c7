theory Factor_Specialization_Binding_Total
  imports Factor_Specialization_Binding_Contracts Factor_Graph_Metadata Factor_Package_Locality
begin

section \<open>All observations and support enumerations follow from the actual sources\<close>

theorem specialization_binding_total:
  assumes actual: "schema_clause_specialization_at E pu pr d c F v r G w t"
  shows "\<exists>report bs Is Ks. distinct bs \<and>
    specialization_binding_at E pu pr d c F v r G w t report (positioned_binding_rows_term bs) Is Ks \<and>
    graph_node_inputs_at E {} (Schema_Inference (fst d,c) (fset_of_list bs))"
proof -
  obtain P S s As I K where raw: "native_package_at E pu pr P" "((d,c),S)\<in>system_clauses P"
    "distinct As" "set As=schema_variables S"
    "pattern_record_at F v (schema_variables (schema_substitute s S)) r (substitution_row_patterns As s) I K"
    "native_schema_at G w t (schema_substitute s S)" "schema_pattern_boundary P d (schema_substitute s S)"
    using actual by (auto simp: schema_clause_specialization_at_def)
  have finite: "finite I" "finite K" using pattern_record_formed[OF raw(5)] by auto
  obtain Is Ks where supports: "distinct Is" "set Is=I" "distinct Ks" "set Ks=K"
    using finite_distinct_list[OF finite(1)] finite_distinct_list[OF finite(2)] by blast
  obtain report where reference: "schema_reference_presents (schema_substitute s S) report"
    using native_schema_reference_total[OF raw(6)] by blast
  let ?bs="map (\<lambda>a. ((fst d,a),pattern_claim_observation (s a))) As"
  have rows: "distinct ?bs" using raw(3) by (auto simp: distinct_map inj_on_def)
  have binding: "specialization_binding_at E pu pr d c F v r G w t report
      (positioned_binding_rows_term ?bs) Is Ks"
    unfolding specialization_binding_at_def
    by (intro conjI, rule supports(1), rule supports(3), simp,
      rule exI[of _ P], rule exI[of _ S], rule exI[of _ s], rule exI[of _ As])
      (use raw reference supports in simp)
  have positioned: "((d,(fst d,c)),rename_schema (Pair (fst d)) (Pair (fst d)) id S)
    \<in>system_clauses (positioned_program P)"
    using raw(2) by (auto simp: positioned_clause_entry)
  have clause: "(fst d,c)\<in>environment_positions E"
    by (rule positioned_package_clause_positions(1)[OF raw(1) positioned])
  have coordinates: "image (Pair (fst d)) (schema_variables S)\<subseteq>environment_positions E"
    using positioned_package_clause_positions(2)[OF raw(1) positioned]
    by (auto simp: renamed_schema_variables)
  have replacements: "\<forall>a\<in>set As. pattern_formed (s a)"
    using pattern_record_formed[OF raw(5)] by (auto simp only: substitution_row_formed)
  have variables: "\<forall>a\<in>set As. \<forall>b\<in>pattern_variables (s a). octets_formed b"
    using native_schema_variables_formed[OF raw(6)] raw(4)
    by (auto simp: schema_substitute_variables)
  have terms: "\<forall>a\<in>set As. term_formed (pattern_claim_observation (s a))"
    using replacements variables by (auto intro: pattern_claim_observation_formed)
  have inputs: "graph_node_inputs_at E {} (Schema_Inference (fst d,c) (fset_of_list ?bs))"
    using clause coordinates raw(4) terms
    by (auto simp: single_valued_def rel_dom_def)
  show ?thesis by (rule exI[of _ report], rule exI[of _ ?bs], rule exI[of _ Is], rule exI[of _ Ks])
    (use rows binding inputs in blast)
qed

section \<open>Extending the package source preserves the same replacement and target\<close>

theorem specialization_binding_source_included:
  assumes actual: "specialization_binding_at E pu pr d c F v r G w t report bs Is Ks"
    and included: "environment_included E H" and formed: "environment_formed H"
  shows "specialization_binding_at H pu pr d c F v r G w t report bs Is Ks"
  using actual native_package_included[OF _ included formed]
  by (auto simp only: specialization_binding_at_def)

text \<open>
  Every original binder contributes its paired pattern observation. Their
  physical keys are actual occurrences in the cited native package. The
  complete replacement record supplies the finite supports; the actual target
  supplies every used variable and the complete schema report. No source field
  is replaced by an arbitrary formed marker.

  Source inclusion here changes only the package environment. The exact
  replacement environment, target environment, report, rows, and both support
  lists remain part of the conclusion.
\<close>

end
