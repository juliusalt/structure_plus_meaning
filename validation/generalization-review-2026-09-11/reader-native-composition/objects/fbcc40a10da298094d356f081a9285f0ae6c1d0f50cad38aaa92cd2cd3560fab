cases.append(example('conditional-three-bridges', [10, 11, 12, *known]))
for missing in [10, 11, 12]:
    cases.append(example('conditional-withheld-' + str(missing), [d for d in [10, 11, 12, *known] if d != missing]))
broken = example('different-source-context', [10, 11, 12, *known])
broken['known'][2][1] = r.payload(*b'Different E; no shared source preservation evidence')
