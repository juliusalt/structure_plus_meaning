context = r.payload(*b'Complete clause specialization: E pu pr d c F v r G w t; extension owns H nu, report, binding rows, discharges, node and replacement supports.')
lib = []
for head, ps in [(40, [10, 11, 12, 13, 14]), (41, [40, 15]), (42, [41, 16])]:
    lib += r.library(head, r.schema(r.variable(0), [[s, d, r.variable(0)] for s, d in enumerate(ps)]))
call = lambda d: [d, copy.deepcopy(context)]
goals = [[s, *call(d)] for s, d in enumerate([40, 41, 42])]
def example(name, evidence, library=lib):
    item = r.case(name, copy.deepcopy(library), [call(d) for d in evidence],
                  [call(d) for d in evidence], copy.deepcopy(goals), ['guided', 4])
    item.update(guided_rounds=4, diagnose_coverage=True, diagnose_bindings=True)
    return item
known = [13, 14, 15]
