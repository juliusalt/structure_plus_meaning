import json,sys
from pathlib import Path
sys.path.insert(0,str(Path('tools').resolve()))
from retain_reasoning_review import Archive,digest
base=Path('validation/generalization-review-2026-09-11/reader-source-requirements').resolve()
manifest=json.loads((base/'archive.json').read_text())
archive=Archive(base,[base],[],allow_existing=True)
supplement={'initial_manifest':archive.add(base/'archive.json'),'replays':{},'main804':{},'documents':{},'checks':{},'retention_script':archive.add(Path(__file__))}
for name in ['after','initial','followed']:
 directory=Path('/tmp/reader-source-replay-'+name)
 r=json.loads((directory/'replay.json').read_text())
 assert r['status']=='accepted' and r['archive_index_sha256']==digest(base/'index.json')
 supplement['replays'][name]=archive.directory(directory)
b=json.loads(Path('validation/build.json').read_text());c=json.loads(Path('validation/check.json').read_text())
assert b['status']==c['status']=='accepted' and c['theory_count']==804
for field in ['sources','tools']:
 for name,h in b[field].items():assert digest(Path(name))==h,name
for name in ['build.json','build.log','build-errors.log','check.json','check-errors.log']:
 path=Path('validation',name)
 if path.exists():supplement['main804'][name]=archive.add(path)
for name in ['README.md','REASONING_REUSE.md','GENERALIZATION_REVIEW.md','DEVELOPMENT_WORKFLOW.md','THEORY_MAP.md','ROOT']:
 supplement['documents'][name]=archive.add(Path(name))
for name in ['reader-source-final-tool-tests.log','verify-reader-source-adapters.py','reader-source-adapter-checks.log']:
 supplement['checks'][name]=archive.add(Path('/tmp',name))
assert Path('/tmp/reader-source-adapter-checks.log').read_text().count('PASS:')==2
readme=base/'README.md'
readme.write_text(readme.read_text()+'\nThe full 804-theory session passes in invocation\nc886634d-5833-4fee-866c-7e95762943b6 with unchanged sources and validation\ntools. The 27 tooling tests pass. All three final replays pass: the full\n55-case source family and both complete source comparisons. The final shared\nadapters also reproduce the previous method study and verify its retained\nevidence. Their actual scripts and raw output are retained in replays.json.\n')
(base/'replays.json').write_text(json.dumps(supplement,indent=2)+'\n')
manifest['files'].update({ref:sha for sha,ref in archive.retained.items()})
for name in ['README.md','replays.json']:manifest['files'][name]=digest(base/name)
(base/'archive.json').write_text(json.dumps(manifest,indent=2)+'\n')
for name,h in manifest['files'].items():
 assert digest(base/name)==h,name
 assert (base/name).resolve().is_relative_to(Path.cwd()),name
print('Verified',len(manifest['files']),'archive references; final manifest',digest(base/'archive.json'))
