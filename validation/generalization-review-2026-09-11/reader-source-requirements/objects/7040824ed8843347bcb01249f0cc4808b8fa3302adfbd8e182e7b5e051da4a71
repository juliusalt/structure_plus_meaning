#!/usr/bin/env python3
"""Revisit retained native and generic problems with requested-head generation."""
from __future__ import annotations

import argparse
import copy
import json
from pathlib import Path

import check_reasoning as review


def load_baseline(directory):
    receipt = json.loads((directory / "receipt.json").read_text())
    assert receipt["status"] == "accepted"
    assert review.digest(directory / "results.log") == receipt["results_sha256"]
    cases_path = directory / "cases.json"
    assert review.digest(cases_path) == receipt["execution_inputs"][str(cases_path.resolve())]
    cases = json.loads(cases_path.read_text())
    reports = {}
    for line in (directory / "results.log").read_text().splitlines():
        if line.startswith("REASONING_RESULT "):
            identifier, raw = line.removeprefix("REASONING_RESULT ").split(" ", 1)
            reports[int(identifier)] = json.loads(raw)
    assert set(reports) == set(range(len(cases)))
    return cases, reports


def guide_case(original, index):
    """Change the construction driver while retaining the complete problem."""
    assert original["operation"] is None or original["operation"][0] == "chain"
    item = copy.deepcopy(original)
    item["name"] = "guided-" + original["name"]
    item["guided_rounds"] = item.pop("construction_rounds", 2)
    item["operation"] = ["guided", item["guided_rounds"]]
    item.pop("native_reader_investigation", None)
    if original["name"].startswith("binding-clauses-"):
        item["native_binding_guided"] = bool(item["library"])
    item["baseline_source_index"] = index
    return item


def guided_cases(baseline):
    selected = []
    for index, original in enumerate(baseline):
        if not original["name"].startswith("binding-clauses-") and original["operation"] is not None:
            continue
        selected.append(guide_case(original, index))
    return selected


def assess(cases, results, before):
    deep = [i for i, c in enumerate(cases) if c["name"].startswith("guided-binding-clauses-length-")
            and c["guided_rounds"] == 5]
    controls = {
        "all_original_goals_and_evidence_retained": bool(cases),
        "native_goals_settle_at_the_checked_bound": bool(deep) and all(not results[i]["residual"] for i in deep),
        "previous_applications_preserved": all(set(map(review.application_key, before[c["baseline_source_index"]]["applications"])) <=
            set(map(review.application_key, results[i]["applications"])) for i, c in enumerate(cases)),
        "previous_settlements_preserved": all(set(map(review.freeze, results[i]["residual"])) <=
            set(map(review.freeze, before[c["baseline_source_index"]]["residual"])) for i, c in enumerate(cases)),
        "original_formation_results_preserved": all(results[i]["input_formed"] ==
            before[c["baseline_source_index"]]["input_formed"] for i, c in enumerate(cases)),
        "false_native_goals_remain_unresolved": all(truth or goal in results[i]["residual"]
            for i, c in enumerate(cases) for goal, truth in zip(c["goals"], c.get("native_goal_truth", []))),
    }
    assert all(controls.values()), controls
    newly_settled = [{"case": c["name"], "goals": [g for g in before[c["baseline_source_index"]]["residual"]
                     if g not in results[i]["residual"]]} for i, c in enumerate(cases)]
    return {
        "question": "Does requested-head instantiation repair the retained binding-generation failure while preserving the existing premise generator and original evidence boundaries?",
        "controls": controls,
        "newly_settled": [x for x in newly_settled if x["goals"]],
        "contracts": ["finite_requested_schema_applications_exact", "finite_guided_closure_sound",
                      "finite_guided_original_formation", "finite_guided_chained_applications"],
        "boundary": "The checked head-scope condition gives exact local applications. The construction bound remains explicit; this family does not prove unrestricted search completeness, native source-environment readings, whole argument admission, or complete workflow coverage.",
    }


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    for name in ["proof", "poly", "output", "baseline"]:
        parser.add_argument("--" + name, type=Path, required=True)
    parser.add_argument("--engine", type=Path)
    parser.add_argument("--assume-goals", action="store_true",
                        help="Measure the deliberately unsupported policy of adding every native goal to the known set.")
    parser.add_argument("--case", help="Run one retained case as a diagnostic, without claiming a complete family assessment.")
    args = parser.parse_args()
    if not __debug__:
        raise ValueError("Execution review requires Python assertions to be enabled.")
    original, before = load_baseline(args.baseline)
    cases = guided_cases(original)
    if args.assume_goals:
        cases = [c for c in cases if "native_binding_guided" in c]
        for c in cases:
            c["name"] = "assume-" + c["name"]
            c["native_reference_truth"] = c.pop("native_goal_truth")
            c["unproved_goal_assumptions"] = [g[1:] for g in c["goals"]]
            c["known"] += copy.deepcopy(c["unproved_goal_assumptions"])
    if args.case:
        cases = [c for c in cases if c["name"] == args.case]
        assert len(cases) == 1, "The requested retained case must exist exactly once."
    for c in cases:
        old = original[c["baseline_source_index"]]
        fields = ["library", "frontier", "goals"] + ([] if args.assume_goals else ["known"])
        assert all(c[field] == old[field] for field in fields)
    status = review.run(args, cases_factory=lambda: cases, cases_source=Path(__file__),
        cases_dependencies=[args.baseline / name for name in ["receipt.json", "cases.json", "results.log"]])
    if status or args.case:
        return status
    results = {}
    for line in (args.output / "results.log").read_text().splitlines():
        if line.startswith("REASONING_RESULT "):
            identifier, raw = line.removeprefix("REASONING_RESULT ").split(" ", 1)
            results[int(identifier)] = json.loads(raw)
    if args.assume_goals:
        failures = [{"case": c["name"], "falsely_settled_goals": [g for g, truth in
                    zip(c["goals"], c["native_reference_truth"]) if not truth and g not in results[i]["residual"]]}
                    for i, c in enumerate(cases) if results[i]["input_formed"]]
        failures = [f for f in failures if f["falsely_settled_goals"]]
        assert failures, "The unsupported goal-assumption policy must be challenged by actual false native calls."
        assessment = {"policy": "Assume every requested native goal is known",
                      "assessment": "Fails native semantic adequacy",
                      "failures": failures,
                      "boundary": "The finite conditional reports pass reconstruction. The native closure theorem's known-call hypothesis is not established for this policy."}
        (args.output / "policy-assessment.json").write_text(json.dumps(assessment, indent=2) + "\n")
        print("Native workloads with falsely settled goals:", len(failures))
        return 0
    assessment = assess(cases, results, before)
    assessment["receipt_sha256"] = review.digest(args.output / "receipt.json")
    (args.output / "adequacy.json").write_text(json.dumps(assessment, indent=2) + "\n")
    print(json.dumps({k: v for k, v in assessment.items() if k != "newly_settled"}, indent=2))
    print("Cases with additional settled goals:", len(assessment["newly_settled"]))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
