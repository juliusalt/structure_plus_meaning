"""Derive a bounded comparison from the actual rejected assessment objects."""
import inspect
import json
from pathlib import Path
import subprocess
import sys

BASE = Path(__file__).parent
ROOT = Path('/home/julius/structure_and_semantics')
sys.path.insert(0, str(ROOT / 'tools'))
import check_reasoning as review
import investigate

CHILD = '''
import inspect,json,sys
from pathlib import Path
sys.path.insert(0,sys.argv[1])
import check_application_comparison as checker
def typed(value):
    kind=type(value).__name__
    if isinstance(value,dict):return [kind,[[k,typed(v)] for k,v in sorted(value.items())]]
    if isinstance(value,(tuple,list)):return [kind,[typed(v) for v in value]]
    return [kind,value]
run,original=Path(sys.argv[2]),Path(sys.argv[3])
case=json.loads((original/'cases.json').read_text())
expected=json.loads((original/'receipt.json').read_text())['assessment']
actual=checker.assess(case,(run/'results.log').read_text())
outputs=[actual,checker.review.clone_json(actual)]
print(json.dumps({'input':case,'expected':typed(expected),'outputs':list(map(typed,outputs)),
 'observed': [typed(output)==typed(expected) for output in outputs],
 'json_copy_source':inspect.getsource(checker.review.clone_json)}))
'''

subjects = []
for replay, original in [('comparison-before-integration','comparison2'),
                         ('comparison-current','comparison3'),
                         ('repeated-subjects','subjects-repeated1'),
                         ('empty-subject-family','subjects-empty1')]:
    run = BASE / 'replays1' / replay
    completed = subprocess.run([sys.executable, '-B', '-c', CHILD, str(run/'tools'),
                  str(run), str(BASE/original)], text=True, capture_output=True, check=True)
    subject = json.loads(completed.stdout)
    assert subject['observed'] == [v == subject['expected'] for v in subject['outputs']]
    subject['source_execution'] = original
    subjects.append(subject)

observations = [[0,c,w] for w,p in enumerate(subjects) for c,satisfied in enumerate(p['observed']) if satisfied]
profiles = {c: {(f,w) for f,d,w in observations if c==d} for c in [0,1]}
relation = [[c,d] for c in [0,1] for d in [0,1] if profiles[c] <= profiles[d]]
evidence = {'problem': 'Reproduce the original complete stored JSON assessment while retaining every field and occurrence.',
 'contract': 'For each complete original input and stored assessment, compute the original archived checker result, apply identity or its existing clone_json operation, and compare their complete recursively typed values with the stored JSON object. Each observation is exactly the result of that equality.',
 'candidates': [{'operation': 'identity', 'source': 'def identity(value): return value'},
                {'operation': 'JSON encoding followed by decoding', 'source': inspect.getsource(review.clone_json)}],
 'condition': 'Complete recursively typed equality with the original decoded receipt assessment.',
 'subjects': subjects, 'observations': observations, 'relation': relation,
 'boundary': 'These observations are derived from actual complete host objects and operations. The finite comparison has this executed source equation; it is not an Isabelle proof about arbitrary Python or JSON programs, nor a meaning claim based on registry prose.'}
evidence_path = BASE/'replay-assessment-subjects.json'
evidence_path.write_text(json.dumps(evidence,indent=2)+'\n')
case = {'schema':investigate.SCHEMA,'kind':'basis','question':evidence['problem'], 'candidates':[0,1],'facets':[0],
        'selected':[], 'observations':observations, 'relation':relation,
        'scope':{'candidates':{'0':'Identity on the actual returned assessment','1':'Existing JSON copy on that same assessment'},
                 'facets':{'0':evidence['condition']},'subjects':str(evidence_path)},
        'semantic_boundary':evidence['boundary'],
        'evidence':[{'path':str(p),'sha256':investigate.file_hash(p)} for p in [evidence_path,Path(__file__)]]}
investigate.validate_case(case)
spec={'question':evidence['problem'],'boundary':evidence['boundary'],
      'problems':[{'name':'replay-assessment-representation','case':case,
                   'required_observations':[[0,w] for w in range(len(subjects))]}]}
(BASE/'replay-assessment-specification.json').write_text(json.dumps(spec,indent=2)+'\n')
print(json.dumps({'observations':observations,'relation':relation,
                  'actual_satisfaction': [p['observed'] for p in subjects]},indent=2))
