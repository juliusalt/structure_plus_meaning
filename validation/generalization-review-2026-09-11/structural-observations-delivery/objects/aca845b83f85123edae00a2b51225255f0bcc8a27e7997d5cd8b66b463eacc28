structure N = Finite_Literal_Inference_Premises;
fun jnat x = IntInf.toString (N.integer_of_nat x);
fun jlist f xs = "[" ^ String.concatWith "," (map f xs) ^ "]";

fun jtarget _ = raise Fail "Unexpected target in the complete finite data input";
fun jterm (N.Finite_Payload b) = "{\"payload\":" ^ jlist jnat b ^ "}"
 | jterm (N.Finite_Pair (a,b)) = "{\"pair\":[" ^ jterm a ^ "," ^ jterm b ^ "]}"
 | jterm (N.Finite_Target t) = jtarget t;

fun jcall (d,t) = "[" ^ jnat d ^ "," ^ jterm t ^ "]";
val () = print ("NATIVE_INPUT " ^ "{\"argument\":" ^
  jterm (N.finite_literal_inference_value []) ^ ",\"known\":" ^
  jlist jcall (N.finite_literal_inference_known []) ^ "}\n");
