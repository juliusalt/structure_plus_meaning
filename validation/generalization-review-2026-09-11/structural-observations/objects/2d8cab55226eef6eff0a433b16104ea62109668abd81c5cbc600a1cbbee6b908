theory Factor_Executable_Propagation
  imports "Factor_Executable_Readings" "Factor_Instantiated_Premises"
begin

section \<open>Prospective premises are computed from complete metadata\<close>

definition finite_child_claims ::
  "('a,'s,'c,'n) finite_derivation_graph \<Rightarrow> 'n \<Rightarrow> ('a,'s,'d) finite_factor_schema \<Rightarrow>
    ('a \<times> finite_factor_term) fset \<Rightarrow> ('n \<times> ('d \<times> finite_factor_term)) fset" where
  "finite_child_claims G n S V = finite_edge_compose
    (fimage (\<lambda>(s,m). (m,s)) (finite_graph_premises G n)) (finite_instantiated_premises S V)"

lemma finite_child_claims_member:
  "(m,d,t) |\<in>| finite_child_claims G n S V \<longleftrightarrow>
    (\<exists>s. (s,m) |\<in>| finite_graph_premises G n \<and> (s,d,t) |\<in>| finite_instantiated_premises S V)"
  by (auto simp: finite_child_claims_def finite_edge_compose_correct fimage.rep_eq relcomp_unfold)

fun finite_node_transitions ::
  "('a,'s,'d,'c) finite_schema_system \<Rightarrow> ('a,'s,'c,'n) finite_derivation_graph \<Rightarrow>
    'n \<Rightarrow> ('a,'c) finite_schema_graph_node \<Rightarrow>
    (('n \<times> 'd) \<times> ('n \<times> ('d \<times> finite_factor_term))) fset" where
  "finite_node_transitions P G n Finite_Assertion = {||}"
| "finite_node_transitions P G n (Finite_Inference c V) =
    ffUnion (fimage (\<lambda>((d,k),S). if k=c
      then fimage (Pair (n,d)) (finite_child_claims G n S V) else {||}) (finite_system_clauses P))"

lemma finite_node_transitions_member:
  "((r,d),q) |\<in>| finite_node_transitions P G n A \<longleftrightarrow>
    r=n \<and> (\<exists>c V S. A=Finite_Inference c V \<and> ((d,c),S) |\<in>| finite_system_clauses P \<and>
      q |\<in>| finite_child_claims G n S V)"
  by (cases A; auto simp: fimage.rep_eq ffUnion.rep_eq split: prod.splits if_splits; force)

definition finite_graph_transitions ::
  "('a,'s,'d,'c) finite_schema_system \<Rightarrow> ('a,'s,'c,'n) finite_derivation_graph \<Rightarrow>
    (('n \<times> 'd) \<times> ('n \<times> ('d \<times> finite_factor_term))) fset" where
  "finite_graph_transitions P G =
    ffUnion (fimage (\<lambda>(n,A). finite_node_transitions P G n A) (finite_graph_inferences G))"

lemma finite_graph_transitions_member:
  "((n,d),q) |\<in>| finite_graph_transitions P G \<longleftrightarrow>
    (\<exists>c V S. (n,Finite_Inference c V) |\<in>| finite_graph_inferences G \<and>
      ((d,c),S) |\<in>| finite_system_clauses P \<and> q |\<in>| finite_child_claims G n S V)"
  by (auto simp: finite_graph_transitions_def fimage.rep_eq ffUnion.rep_eq
      finite_node_transitions_member split: prod.splits; force)

section \<open>Propagation follows exactly the supplied inference equations\<close>

lemma finite_graph_transition_sound:
  assumes read: "schema_graph_reading (decode_finite_system P) (decode_finite_graph G) root d t J"
    and claim: "(n,e,x) \<in> J"
    and transition: "((n,e),(m,f,u)) |\<in>| finite_graph_transitions P G"
  shows "(m,f,decode_finite_term u) \<in> J"
proof -
  obtain c V S where node: "(n,Finite_Inference c V) |\<in>| finite_graph_inferences G"
    and clause: "((e,c),S) |\<in>| finite_system_clauses P"
    and child: "(m,f,u) |\<in>| finite_child_claims G n S V"
    using transition by (auto simp: finite_graph_transitions_member)
  have node': "(n,Schema_Inference c (decode_finite_binding_set V)) \<in>
      fset (graph_inferences (decode_finite_graph G))" using node by auto
  have clause': "((e,c),decode_finite_schema S) \<in> system_clauses (decode_finite_system P)"
    using clause by auto
  have inst: "schema_instance (decode_finite_schema S) (decode_finite_term_bindings V) x
      (schema_graph_premises (decode_finite_graph G) n O J)"
    using schema_graph_node_schema_instance[OF read node' claim clause'] by simp
  obtain s where link: "(s,m) |\<in>| finite_graph_premises G n"
    and premise: "(s,f,u) |\<in>| finite_instantiated_premises S V"
    using child by (auto simp: finite_child_claims_member)
  have link': "(s,m) \<in> schema_graph_premises (decode_finite_graph G) n"
    using link by (simp add: finite_graph_premises_correct)
  have premise': "(s,f,decode_finite_term u) \<in> schema_graph_premises (decode_finite_graph G) n O J"
    using premise finite_instantiated_premises_correct[OF inst] by fastforce
  obtain k where other: "(s,k) \<in> schema_graph_premises (decode_finite_graph G) n"
    and actual: "(k,f,decode_finite_term u) \<in> J" using premise' by auto
  have formed: "schema_graph_formed (decode_finite_graph G) root"
    using read by (simp add: schema_graph_reading_def)
  have sv: "single_valued (schema_graph_premises (decode_finite_graph G) n)"
    by (rule schema_graph_premises_functional[OF formed])
  have same: "m=k" by (rule single_valued_outputs[OF sv link' other])
  show ?thesis using actual same by simp
qed

lemma finite_graph_edge_transition:
  assumes read: "schema_graph_reading (decode_finite_system P) (decode_finite_graph G) root d t J"
    and edge: "(m,n) \<in> schema_graph_edges (decode_finite_graph G)"
  shows "\<exists>e u. ((n,fst (rel_value J n)),(m,e,u)) |\<in>| finite_graph_transitions P G \<and>
    rel_value J m=(e,decode_finite_term u)"
proof -
  obtain s c W Q where discharge: "((n,s),m) \<in> fset (graph_discharges (decode_finite_graph G))"
    and node: "(n,Schema_Inference c W) \<in> fset (graph_inferences (decode_finite_graph G))"
    and admitted: "admitted_schema_instance (decode_finite_system P)
      (fst (rel_value J n)) c (fset W) (snd (rel_value J n)) Q"
    and premise: "(s,rel_value J m) \<in> Q"
    using schema_graph_edge_premise[OF read edge] by blast
  obtain V where row: "(n,Finite_Inference c V) |\<in>| finite_graph_inferences G"
    and bindings: "W=decode_finite_binding_set V"
    using node by (auto simp: map_relation_values_member split: finite_schema_graph_node.splits)
  obtain S where clause: "((fst (rel_value J n),c),S) |\<in>| finite_system_clauses P"
    and inst: "schema_instance (decode_finite_schema S) (decode_finite_term_bindings V)
      (snd (rel_value J n)) Q"
    using admitted bindings by (auto simp: admitted_schema_instance_def)
  obtain e x where shape: "rel_value J m=(e,x)" by (cases "rel_value J m") auto
  have member: "(s,e,x) \<in> decode_finite_premises (finite_instantiated_premises S V)"
    using premise shape finite_instantiated_premises_correct[OF inst] by simp
  obtain u where pu: "(s,e,u) |\<in>| finite_instantiated_premises S V"
    and decoded_term: "x=decode_finite_term u"
    using member by (auto simp: decode_finite_premises_def decode_finite_call_term_def)
  have link: "(s,m) |\<in>| finite_graph_premises G n"
    using discharge by (simp add: finite_graph_premises_correct schema_graph_premises_def)
  have child: "(m,e,u) |\<in>| finite_child_claims G n S V"
    using link pu by (auto simp: finite_child_claims_member)
  have trans: "((n,fst (rel_value J n)),(m,e,u)) |\<in>| finite_graph_transitions P G"
    using row clause child by (auto simp: finite_graph_transitions_member)
  show ?thesis using trans shape decoded_term by blast
qed

export_code finite_graph_transitions checking SML

text \<open>
  Each transition is derived from an actual inference occurrence, a matching
  program clause, an identified premise, and its actual discharge. Its target
  term is computed from the complete binding metadata. In a valid reading,
  every such transition from a known parent claim gives exactly the child
  claim, and every proof edge has a corresponding transition.
\<close>

end
