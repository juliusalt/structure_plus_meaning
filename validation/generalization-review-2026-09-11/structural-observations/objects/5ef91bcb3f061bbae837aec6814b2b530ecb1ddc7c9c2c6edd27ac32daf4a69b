theory Factor_Observed_Applications
  imports Factor_Binding_Contributions Factor_Instantiated_Premises Finite_Set_Composition
begin

section \<open>Observation sites are actual roles in one complete schema\<close>

datatype ('s,'d) finite_schema_observation_site =
    Finite_Conclusion_Site
  | Finite_Premise_Site 's 'd
  | Finite_Material_Source_Site 's
  | Finite_Material_Atoms_Site 's
  | Finite_Material_Edges_Site 's
  | Finite_Material_Counts_Site 's
  | Finite_Material_Functions_Site 's

definition finite_schema_observation_sources where
  "finite_schema_observation_sources S=finsert
    (Finite_Conclusion_Site,finite_schema_conclusion S)
    (fimage (\<lambda>(s,d,p). (Finite_Premise_Site s d,p)) (finite_schema_premises S) |\<union>|
     ffUnion (fimage (\<lambda>(s,M). fset_of_list
       [(Finite_Material_Source_Site s,finite_material_source M),
        (Finite_Material_Atoms_Site s,finite_material_atoms M),
        (Finite_Material_Edges_Site s,finite_material_edges M),
        (Finite_Material_Counts_Site s,finite_material_counts M),
        (Finite_Material_Functions_Site s,finite_material_functions M)]) (finite_schema_materials S)))"

lemma finite_schema_observation_source_head [simp]:
  "(Finite_Conclusion_Site,p) |\<in>| finite_schema_observation_sources S \<longleftrightarrow>
    p=finite_schema_conclusion S"
  by (auto simp: finite_schema_observation_sources_def ffUnion.rep_eq fimage.rep_eq
    fset_of_list.rep_eq split: prod.splits)

lemma finite_schema_observation_source_premise [simp]:
  "(Finite_Premise_Site s d,p) |\<in>| finite_schema_observation_sources S \<longleftrightarrow>
    (s,d,p) |\<in>| finite_schema_premises S"
  by (auto simp: finite_schema_observation_sources_def ffUnion.rep_eq fimage.rep_eq
    fset_of_list.rep_eq image_iff split: prod.splits; force)

lemma finite_schema_observation_source_scope:
  assumes "(i,p) |\<in>| finite_schema_observation_sources S"
  shows "finite_pattern_variables p |\<subseteq>| finite_schema_variables S"
  using assms by (auto simp: finite_schema_observation_sources_def finite_schema_variables_def
    finite_material_variables_def ffUnion.rep_eq fimage.rep_eq fset_of_list.rep_eq
    split: prod.splits; force)

definition finite_schema_call_observations where
  "finite_schema_call_observations d S C Q=
    fimage (\<lambda>(e,t). (Finite_Conclusion_Site,t)) (ffilter (\<lambda>(e,t). e=d) Q) |\<union>|
    ffUnion (fimage (\<lambda>(s,e,p). fimage (\<lambda>(f,t). (Finite_Premise_Site s e,t))
      (ffilter (\<lambda>(f,t). f=e) C)) (finite_schema_premises S))"

lemma finite_schema_call_observation_head [simp]:
  "(Finite_Conclusion_Site,t) |\<in>| finite_schema_call_observations d S C Q \<longleftrightarrow>
    (d,t) |\<in>| Q"
  by (auto simp: finite_schema_call_observations_def ffUnion.rep_eq fimage.rep_eq
    image_iff split: prod.splits; force)

lemma finite_schema_call_observation_premise [simp]:
  "(Finite_Premise_Site s e,t) |\<in>| finite_schema_call_observations d S C Q \<longleftrightarrow>
    (e,t) |\<in>| C \<and> (\<exists>p. (s,e,p) |\<in>| finite_schema_premises S)"
  by (auto simp: finite_schema_call_observations_def ffUnion.rep_eq fimage.rep_eq
    image_iff split: prod.splits; force)

section \<open>All supplied parts are joined before the complete instance is checked\<close>

definition finite_observed_schema_applications where
  "finite_observed_schema_applications S obs=ffUnion (fimage (\<lambda>V.
    let H=finite_instantiated_premises S V
    in fimage (\<lambda>t. (t,V,H))
      (ffilter (\<lambda>t. finite_schema_instance S V t H \<and> finite_schema_material_satisfied S V)
        (finite_pattern_instances V (finite_schema_conclusion S))))
    (finite_observed_bindings (finite_schema_observation_sources S) obs))"

lemma finite_observed_schema_application_sound:
  assumes member: "(t,V,H) |\<in>| finite_observed_schema_applications S obs"
  shows "V |\<in>| finite_observed_bindings (finite_schema_observation_sources S) obs"
    "finite_schema_instance S V t H" "finite_schema_material_satisfied S V"
proof -
  have "V |\<in>| finite_observed_bindings (finite_schema_observation_sources S) obs \<and>
    finite_schema_instance S V t H \<and> finite_schema_material_satisfied S V"
    using member by (auto simp: finite_observed_schema_applications_def Let_def
      ffUnion.rep_eq fimage.rep_eq image_iff split: prod.splits; force)
  then show "V |\<in>| finite_observed_bindings (finite_schema_observation_sources S) obs"
    "finite_schema_instance S V t H" "finite_schema_material_satisfied S V" by blast+
qed

theorem finite_observed_schema_applications_exact:
  "(t,V,H) |\<in>| finite_observed_schema_applications S obs \<longleftrightarrow>
    V |\<in>| finite_observed_bindings (finite_schema_observation_sources S) obs \<and>
    finite_schema_instance S V t H \<and> finite_schema_material_satisfied S V"
proof
  assume member: "(t,V,H) |\<in>| finite_observed_schema_applications S obs"
  show "V |\<in>| finite_observed_bindings (finite_schema_observation_sources S) obs \<and>
      finite_schema_instance S V t H \<and> finite_schema_material_satisfied S V"
    using finite_observed_schema_application_sound[OF member] by blast
next
  assume valid: "V |\<in>| finite_observed_bindings (finite_schema_observation_sources S) obs \<and>
    finite_schema_instance S V t H \<and> finite_schema_material_satisfied S V"
  have head: "t |\<in>| finite_pattern_instances V (finite_schema_conclusion S)"
    using valid by (auto simp: finite_pattern_instances_member finite_schema_instance_def)
  have body: "finite_instantiated_premises S V=H"
    using valid by (intro finite_instantiated_premises_exact) blast
  let ?F="\<lambda>W. fimage (\<lambda>u. (u,W,finite_instantiated_premises S W))
    (ffilter (\<lambda>u. finite_schema_instance S W u (finite_instantiated_premises S W) \<and>
      finite_schema_material_satisfied S W) (finite_pattern_instances W (finite_schema_conclusion S)))"
  have inner: "(t,V,H) |\<in>| ?F V"
    using valid head by (auto simp: body intro!: fimageI)
  have outer: "?F V |\<in>| fimage ?F (finite_observed_bindings (finite_schema_observation_sources S) obs)"
    by (rule fimageI) (use valid in blast)
  show "(t,V,H) |\<in>| finite_observed_schema_applications S obs"
    using outer inner by (auto simp only: finite_observed_schema_applications_def Let_def ffUnion.rep_eq)
qed

theorem finite_observed_schema_application_origin:
  assumes member: "(t,V,H) |\<in>| finite_observed_schema_applications S obs" and row: "(a,u) |\<in>| V"
  shows "\<exists>i p x. (i,p) |\<in>| finite_schema_observation_sources S \<and>
    (i,x) |\<in>| obs \<and> finite_pattern_accepts p x \<and> (a,u) |\<in>| finite_matching_bindings p x"
  by (rule finite_observed_binding_origin[OF finite_observed_schema_application_sound(1)[OF member] row])

theorem finite_observed_schema_application_support:
  assumes supported: "(i,p,u) |\<in>| finite_binding_support (finite_schema_observation_sources S) obs V"
  shows "(i,p) |\<in>| finite_schema_observation_sources S" "finite_pattern_instance V p u"
  using supported finite_binding_support_instance[OF supported]
  by (auto simp: finite_binding_support_member)

definition finite_guided_applications where
  "finite_guided_applications L C Q=ffUnion (fimage (\<lambda>(d,S,ps).
    if set ps=fset (finite_schema_premises S) then
      fimage (\<lambda>(t,V,H). (d,S,t,V,H)) (finite_observed_schema_applications S
        (finite_schema_call_observations d S C Q))
    else {||}) (fset_of_list L))"

lemma finite_guided_application:
  "(d,S,t,V,H) |\<in>| finite_guided_applications L C Q \<longleftrightarrow>
    (\<exists>ps. (d,S,ps)\<in>set L \<and> set ps=fset (finite_schema_premises S) \<and>
      (t,V,H) |\<in>| finite_observed_schema_applications S (finite_schema_call_observations d S C Q))"
  apply (auto simp: finite_guided_applications_def finite_union_image_member finite_image_member
    fset_of_list.rep_eq split_paired_Ex split: if_splits)
  subgoal for ps
    by (rule bexI[where x="(d,S,ps)"])
      (auto simp: finite_image_member intro!: exI[of _ "(t,V,H)"])
  done

lemma finite_guided_application_source:
  assumes member: "(d,S,t,V,H) |\<in>| finite_guided_applications L C Q"
  shows "\<exists>ps. (d,S,ps)\<in>set L \<and>
    finite_schema_instance S V t H \<and> finite_schema_material_satisfied S V"
  using member by (auto simp: finite_guided_application finite_observed_schema_applications_exact)

text \<open>
  Each source role retains its complete schema projection, including its
  original ordinary socket and callee or its material socket and operand.
  Source matching is derived from those projections. A union may use several
  head, premise or material observations, provided their recovered values
  agree. Only then does the original complete instance and material check
  decide whether the application is returned.

  Available calls and requests supply the first two kinds of observations.
  The general operation also accepts separately supplied material operands;
  supplying an operand does not bypass the material satisfaction check.
  Every ordinary premise is reconstructed with its original socket, including
  premises whose values were not independently available as known facts.
\<close>

end
