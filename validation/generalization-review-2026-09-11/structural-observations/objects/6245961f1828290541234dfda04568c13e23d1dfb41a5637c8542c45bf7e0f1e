theory Factor_Learned_Investigation
  imports "Factor_Schema_Generation" "Native_Investigation_Report_Diagnostic_finitepresenters19.Finite_Investigation"
begin

section \<open>The current library constructs the rules of an investigation\<close>

definition finite_schema_library_formed where
  "finite_schema_library_formed L \<longleftrightarrow>
    (\<forall>(d,S,ps)\<in>set L. finite_schema_formed S \<and> set ps=fset (finite_schema_premises S))"

definition finite_generated_schema_applications where
  "finite_generated_schema_applications L C=ffUnion (fimage (\<lambda>(d,S,ps).
    fimage (\<lambda>(t,V,H). (d,S,t,V,H)) (finite_schema_generation S ps C)) (fset_of_list L))"

definition finite_generated_schema_rules where
  "finite_generated_schema_rules L C=fimage (\<lambda>(d,S,t,V,H). ((d,t),H))
    (finite_generated_schema_applications L C)"

lemma finite_generated_schema_application:
  "(d,S,t,V,H) |\<in>| finite_generated_schema_applications L C \<longleftrightarrow>
    (\<exists>ps. (d,S,ps)\<in>set L \<and> (t,V,H) |\<in>| finite_schema_generation S ps C)"
  by (auto simp: finite_generated_schema_applications_def fset_of_list.rep_eq; force)

lemma finite_generated_schema_rule:
  "(q,H) |\<in>| finite_generated_schema_rules L C \<longleftrightarrow>
    (\<exists>S ps V. (fst q,S,ps)\<in>set L \<and> (snd q,V,H) |\<in>| finite_schema_generation S ps C)"
proof
  assume step: "(q,H) |\<in>| finite_generated_schema_rules L C"
  obtain row where member: "row |\<in>| finite_generated_schema_applications L C"
    and shape: "(q,H)=(case row of (d,S,t,V,J) \<Rightarrow> ((d,t),J))"
    using step by (auto simp: finite_generated_schema_rules_def)
  obtain d S t V J where fields: "row=(d,S,t,V,J)" by (cases row) auto
  have result: "q=(d,t)" "H=J" using shape by (simp_all add: fields)
  obtain ps where source: "(d,S,ps)\<in>set L"
    and generated: "(t,V,J) |\<in>| finite_schema_generation S ps C"
    using member by (simp only: fields finite_generated_schema_application; blast)
  show "\<exists>S ps V. (fst q,S,ps)\<in>set L \<and> (snd q,V,H) |\<in>| finite_schema_generation S ps C"
    using source generated by (simp only: result fst_conv snd_conv; blast)
next
  assume "\<exists>S ps V. (fst q,S,ps)\<in>set L \<and> (snd q,V,H) |\<in>| finite_schema_generation S ps C"
  then obtain S ps V where source: "(fst q,S,ps)\<in>set L"
    and generated: "(snd q,V,H) |\<in>| finite_schema_generation S ps C" by blast
  have member: "(fst q,S,snd q,V,H) |\<in>| finite_generated_schema_applications L C"
    using source generated by (simp only: finite_generated_schema_application; blast)
  let ?f="\<lambda>(d,S,t,V,H). ((d,t),H)"
  have "?f (fst q,S,snd q,V,H) |\<in>| fimage ?f (finite_generated_schema_applications L C)"
    by (rule fimageI[OF member])
  then show "(q,H) |\<in>| finite_generated_schema_rules L C"
    by (simp add: finite_generated_schema_rules_def)
qed

theorem finite_generated_schema_rule_inference:
  assumes generated: "(q,H) |\<in>| finite_generated_schema_rules L C"
  shows "learned_schema_inferences
    {(d,decode_finite_schema S) |d S ps. (d,S,ps)\<in>set L}
    (decode_finite_call_term q) (decode_finite_premises H)"
proof -
  obtain S ps V where member: "(fst q,S,ps)\<in>set L"
    and inst: "(snd q,V,H) |\<in>| finite_schema_generation S ps C"
    using generated by (simp only: finite_generated_schema_rule; blast)
  have library: "(fst q,decode_finite_schema S)\<in>
      {(d,decode_finite_schema S) |d S ps. (d,S,ps)\<in>set L}"
    using member by blast
  show ?thesis using finite_schema_generation_inference(1)[OF inst library]
    by (simp only: decode_finite_call_term_fields)
qed

lemma finite_generated_schema_rule_functional:
  assumes member: "(q,H) |\<in>| finite_generated_schema_rules L C"
  shows "finite_premise_functional H"
proof -
  obtain S ps V where source: "(fst q,S,ps)\<in>set L"
    and generated: "(snd q,V,H) |\<in>| finite_schema_generation S ps C"
    using member by (simp only: finite_generated_schema_rule; blast)
  have functional: "finite_relation_functional H"
    using finite_schema_generation_sound(1)[OF generated]
    by (auto simp: finite_schema_instance_def finite_schema_premise_instance_def)
  show ?thesis using functional
    by (simp only: finite_premise_functional_exact finite_relation_functional_correct)
qed

theorem finite_generated_schema_rules_formed:
  "finite_inference_formed (finite_generated_schema_rules L C)"
  by (auto simp: finite_inference_formed_def intro: finite_generated_schema_rule_functional split: prod.splits)

definition finite_learned_investigation where
  "finite_learned_investigation L C K goals=
    (let applications=finite_generated_schema_applications L C;
         rules=finite_generated_schema_rules L C;
         formed=finite_schema_library_formed L \<and>
           (\<forall>q\<in>set C. finite_term_formed (snd q)) \<and>
           fBall K (\<lambda>q. finite_term_formed (snd q)) \<and>
           fBall goals (\<lambda>(i,q). finite_term_formed (snd q)) \<and> finite_premise_functional goals
     in (formed,applications,finite_inference_residual rules K goals,
       finite_inference_demand rules K (fimage snd goals),
       finite_inference_demand_reasons rules K (fimage snd goals)))"

theorem finite_learned_investigation_residual:
  "fset (fst (snd (snd (finite_learned_investigation L C K goals))))=
    remaining_obligations (inference_closure (finite_inference_rules (finite_generated_schema_rules L C))
      (fset K)) (fset goals)"
  by (simp only: finite_learned_investigation_def Let_def fst_conv snd_conv finite_inference_residual_exact)

definition natural_learned_investigation where
  "natural_learned_investigation
    (L::(nat\<times>(nat,nat,nat) finite_factor_schema\<times>(nat\<times>nat\<times>nat finite_term_pattern) list) list)
    C K (goals::(nat\<times>nat\<times>finite_factor_term) fset)=finite_learned_investigation L C K goals"

export_code finite_generated_schema_applications finite_generated_schema_rules
  finite_learned_investigation checking SML

text \<open>
  The investigation receives reusable schemas and a finite frontier of possible
  premise calls. It constructs the concrete applications, their conclusions,
  complete bindings, and every premise occurrence. The existing inference
  machinery then determines the residual, demanded information, and reasons.
  A new library member changes the generated applications without changing
  this driver or supplying its future conclusions as a rule table.

  Frontier membership does not establish truth. Only the separately supplied
  known calls enter the initial closure. Consequently a generated construction
  can remain conditional on information present in the frontier. Malformed
  unused library members and terms invalidate the whole report. The residual
  still describes its finite generated rule family, never all possible future
  library extensions or all mathematical consequences.

  No particular class of problems is reserved for this operation. Content
  requirements, questions about methods, and questions about the adequacy of
  their observations can supply their own predicates and qualified schemas.
  Each such use still requires its actual local contract and evidence for
  every known call. This interface alone does not supply those contracts or
  make its executable data structures a native proof-scheme checker.
\<close>

end
