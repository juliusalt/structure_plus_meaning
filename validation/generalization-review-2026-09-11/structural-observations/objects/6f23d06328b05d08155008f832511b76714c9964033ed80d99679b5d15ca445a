theory Factor_Observed_Preservation
  imports Factor_Observed_Applications Factor_Requested_Applications Factor_Set_Frontier_Generation
begin

section \<open>Every complete premise join is a compatible observation union\<close>

lemma finite_premise_set_join_observations:
  assumes joined: "(V,H) |\<in>| finite_premise_set_joins ps C"
    and patterns: "\<And>s d p. (s,d,p)\<in>set ps \<Longrightarrow> (key s d,p) |\<in>| P"
    and observations: "\<And>s d p t. (s,d,p)\<in>set ps \<Longrightarrow> (d,t) |\<in>| C \<Longrightarrow>
      (key s d,t) |\<in>| obs"
  shows "V |\<in>| finite_observed_bindings P obs"
  using joined patterns observations
proof (induction ps arbitrary: V H)
  case Nil
  then show ?case by simp
next
  case (Cons z ps)
  obtain s d p where shape: "z=(s,d,p)" by (cases z) auto
  obtain U J t where previous: "(U,J) |\<in>| finite_premise_set_joins ps C"
    and actual: "(d,t) |\<in>| C" and accepted: "finite_pattern_accepts p t"
    and compatible: "finite_relation_functional (U |\<union>| finite_matching_bindings p t)"
    and bindings: "V=U |\<union>| finite_matching_bindings p t"
    using Cons.prems(1) by (auto simp: shape ffUnion.rep_eq fimage.rep_eq image_iff
      split: prod.splits; force)
  have prior: "U |\<in>| finite_observed_bindings P obs"
    apply (rule Cons.IH[OF previous])
    subgoal for s' d' p'
      by (rule Cons.prems(2)[of s' d' p']) auto
    subgoal for s' d' p' t'
      by (rule Cons.prems(3)[of s' d' p' t']) auto
    done
  have source: "(key s d,p) |\<in>| P"
    by (rule Cons.prems(2)) (simp add: shape)
  have observed: "(key s d,t) |\<in>| obs"
    by (rule Cons.prems(3)[of s d p t, OF _ actual]) (simp add: shape)
  have matched: "(key s d,p,t) |\<in>| finite_pattern_observations P obs"
    using source observed accepted by (simp only: finite_pattern_observation_member)
  show ?case using finite_observed_bindings_add[OF prior matched compatible]
    by (simp only: bindings)
qed

lemma finite_schema_generation_observed:
  assumes generated: "(t,V,H) |\<in>| finite_schema_generation_on_set S ps C"
  shows "(t,V,H) |\<in>| finite_observed_schema_applications S (finite_schema_call_observations d S C Q)"
proof -
  have data: "(V,H) |\<in>| finite_premise_set_joins ps C \<and>
    finite_schema_instance S V t H \<and> finite_schema_material_satisfied S V \<and>
    set ps=fset (finite_schema_premises S)"
    using generated by (auto simp: finite_schema_generation_on_set_def ffUnion.rep_eq
      fimage.rep_eq image_iff split: prod.splits if_splits; force)
  have joined: "(V,H) |\<in>| finite_premise_set_joins ps C"
    and enumeration: "set ps=fset (finite_schema_premises S)" using data by blast+
  have observed: "V |\<in>| finite_observed_bindings (finite_schema_observation_sources S)
    (finite_schema_call_observations d S C Q)"
    by (rule finite_premise_set_join_observations[OF joined, where key=Finite_Premise_Site])
      (use enumeration in auto)
  show ?thesis using data observed by (simp only: finite_observed_schema_applications_exact) blast
qed

theorem finite_guided_forward_applications:
  "finite_generated_applications_on_set L C |\<subseteq>| finite_guided_applications L C Q"
proof -
  have included: "(d,S,t,V,H) |\<in>| finite_guided_applications L C Q"
    if member: "(d,S,t,V,H) |\<in>| finite_generated_applications_on_set L C" for d S t V H
  proof -
    obtain ps where source: "(d,S,ps)\<in>set L"
      and generated: "(t,V,H) |\<in>| finite_schema_generation_on_set S ps C"
      using member by (auto simp: finite_generated_applications_on_set_def ffUnion.rep_eq
        fimage.rep_eq fset_of_list.rep_eq image_iff split: prod.splits; force)
    have enumeration: "set ps=fset (finite_schema_premises S)"
      using generated by (auto simp: finite_schema_generation_on_set_def split: if_splits)
    have observed: "(t,V,H) |\<in>| finite_observed_schema_applications S (finite_schema_call_observations d S C Q)"
      by (rule finite_schema_generation_observed[OF generated])
    show ?thesis using source enumeration observed by (simp only: finite_guided_application) blast
  qed
  show ?thesis using included by (auto simp: less_eq_fset.rep_eq split_paired_All)
qed

section \<open>Every complete requested-head instance is retained\<close>

lemma finite_requested_schema_application_observed:
  assumes generated: "(t,V,H) |\<in>| finite_requested_schema_applications S q"
    and requested: "(d,q) |\<in>| Q"
  shows "(t,V,H) |\<in>| finite_observed_schema_applications S (finite_schema_call_observations d S C Q)"
proof -
  have conclusion: "t=q" and inst: "finite_schema_instance S V t H"
    and material: "finite_schema_material_satisfied S V"
    using finite_requested_schema_application_sound[OF generated] by blast+
  have same: "V=finite_matching_bindings (finite_schema_conclusion S) t"
    using generated by (auto simp: finite_requested_schema_applications_def Let_def conclusion split: if_splits)
  have bindings: "finite_term_bindings_formed (finite_schema_variables S) V"
    and head: "finite_pattern_instance V (finite_schema_conclusion S) t"
    using inst by (auto simp: finite_schema_instance_def)
  have accepted: "finite_pattern_accepts (finite_schema_conclusion S) t"
    by (rule finite_pattern_instance_accepted[OF bindings head])
  have observed: "(Finite_Conclusion_Site,finite_schema_conclusion S,t) |\<in>|
      finite_pattern_observations (finite_schema_observation_sources S) (finite_schema_call_observations d S C Q)"
    using accepted requested by (simp add: finite_pattern_observation_member conclusion)
  have recovered: "V |\<in>| finite_observed_bindings (finite_schema_observation_sources S)
      (finite_schema_call_observations d S C Q)"
    using finite_observed_bindings_single[OF observed] by (simp only: same)
  show ?thesis using recovered inst material by (simp only: finite_observed_schema_applications_exact)
qed

text \<open>
  The inclusion proofs use the actual witnesses of each existing construction.
  An ordered premise join contributes exactly its matched fragments; a complete
  requested head contributes its recovered relation. Compatible union retains
  both, including empty and repeated presentations. These are universal
  inclusions, with no assumption that possible calls or requests are known.
\<close>

end
