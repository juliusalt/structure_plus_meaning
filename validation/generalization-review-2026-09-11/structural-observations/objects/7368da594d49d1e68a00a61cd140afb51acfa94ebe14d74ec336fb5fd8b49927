"""Compare complete old and new reports through their existing field boundaries."""
import gzip
import json
from pathlib import Path
import re
import sys

ROOT = Path('/home/julius/structure_and_semantics')
sys.path.insert(0, str(ROOT / 'tools'))
import check_reasoning as review
import evidence_io

BASE = Path(__file__).parent
LABELS = {'REASONING_RESULT', 'GUIDED_STATE', 'CONSTRUCTION_FRONTIER',
          'BINDING_GAPS_RESULT', 'ENVIRONMENT_REQUIREMENT_RESULT',
          'COMPILED_LIBRARY', 'COVERAGE_RESULT', 'BINDING_RESULT',
          'INPUT_RESULT', 'CONSTRUCTION_SEED'}


def reports(path):
    opener = gzip.open if path.suffix == '.gz' else open
    with opener(path, 'rt') as source:
        for line in source:
            if line.split(' ', 1)[0] in LABELS:
                match = re.fullmatch(r'([A-Z_]+(?: [0-9]+)+) (.*)\n?', line)
                assert match, line[:150]
                yield match[1], json.loads(match[2])


def normalize(label, data):
    if label == 'REASONING_RESULT':
        return {'input_formed': data['input_formed'],
                'applications': frozenset(map(review.application_key, data['applications'])),
                'residual': frozenset(map(review.freeze, data['residual'])),
                'demand': frozenset(map(review.freeze, data['demand'])),
                'reasons': frozenset((review.freeze(r['conclusion']),
                     frozenset(map(review.freeze, r['premises'])), r['premise'],
                     review.freeze(r['condition'])) for r in data['reasons'])}
    if label == 'GUIDED_STATE':
        return {**{f: frozenset(map(review.freeze, data[f])) for f in ['frontier', 'requests']},
                'applications': frozenset(map(review.application_key, data['applications']))}
    if label == 'CONSTRUCTION_FRONTIER':
        return frozenset(map(review.freeze, data))
    return review.freeze(data)


def compare(archive_name, stage_name, current_name):
    archive = ROOT / 'validation/generalization-review-2026-09-11' / archive_name
    index = json.loads((archive / 'index.json').read_text())
    manifest = json.loads((archive / 'archive.json').read_text())
    reference = index['runs'][stage_name]['files']['results.log']
    original = archive / reference
    assert evidence_io.digest(original) == manifest['files'][reference]
    if reference in manifest.get('encodings', {}):
        evidence_io.unpack(original, manifest['encodings'][reference])
    current = BASE / current_name / 'results.log'
    old = dict(reports(original))
    new = dict(reports(current))
    assert old.keys() == new.keys()
    differences = []
    counts = {}
    for key in old:
        label = key.split(' ', 1)[0]
        counts[label] = counts.get(label, 0) + 1
        a, b = normalize(label, old[key]), normalize(label, new[key])
        if a != b:
            differences.append({'report': key, 'before': old[key], 'after': new[key]})
    return {'original_archive': archive_name, 'stage': stage_name,
            'original_stored_sha256': evidence_io.digest(original),
            'current': current_name, 'current_sha256': evidence_io.digest(current),
            'checked_complete_reports': counts, 'differences': differences}


results = [compare('reader-source-requirements', 'after', 'guided-regression1'),
           compare('finite-native-reader', 'native-reader', 'native-reader29')]
output = BASE / 'regression-comparison.json'
output.write_text(json.dumps({'tool_sha256': evidence_io.digest(Path(__file__)),
    'boundary': 'Complete emitted mathematical reports compared using existing finite-set boundaries; list and term occurrence structure is preserved. This is execution equality within these original case families, not universal preservation.',
    'results': results}, indent=2) + '\n')
for result in results:
    print(json.dumps({k: v for k, v in result.items() if k != 'differences'}))
    print('different complete reports', len(result['differences']))
    print('report keys', [d['report'] for d in result['differences']])
