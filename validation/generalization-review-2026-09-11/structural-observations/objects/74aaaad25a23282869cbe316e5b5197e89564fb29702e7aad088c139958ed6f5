theory Factor_Executable_Patterns
  imports "Factor_Executable_Quotation" "Native_Investigation_Report_Diagnostic_finitepresenters19.Factor_Patterns"
begin

section \<open>Pattern depth is bounded by its private interior\<close>

fun factor_pattern_depth :: "'a term_pattern \<Rightarrow> nat" where
  "factor_pattern_depth (Pattern_Variable a)=1"
| "factor_pattern_depth (Pattern_Target t)=1"
| "factor_pattern_depth (Pattern_Payload v)=1"
| "factor_pattern_depth (Pattern_Pair p q)=Suc (max (factor_pattern_depth p) (factor_pattern_depth q))"

lemma pattern_quoted_depth_interior:
  assumes "pattern_quoted_at E u V r p I K"
  shows "factor_pattern_depth p \<le> card I"
  using assms
proof (induction rule: pattern_quoted_at.induct)
  case (variable R r a I)
  have finite: "finite I" and root: "r \<in> I"
    using variable.hyps(3) raw_citation_interior by (auto simp: citation_at_def)
  have "0 < card I" using finite root by (auto simp: card_gt_0_iff)
  then show ?case by simp
next
  case (target r t I K)
  show ?case using term_quoted_depth_interior[OF target.hyps(1)] by simp
next
  case (pair R r ps l q p L A s Q B)
  let ?I = "insert r (set ps \<union> L \<union> Q)"
  have finite: "finite ?I" using pattern_quoted_boundary[OF pair.hyps(4)]
    pattern_quoted_boundary[OF pair.hyps(5)] by simp
  have left: "L \<subset> ?I" and right: "Q \<subset> ?I" using pair.hyps(6) by blast+
  have lc: "card L < card ?I" by (rule psubset_card_mono[OF finite left])
  have rc: "card Q < card ?I" by (rule psubset_card_mono[OF finite right])
  show ?case using pair.IH lc rc by (simp add: max_def; arith)
next
  case (payload r v I K)
  show ?case using term_quoted_depth_interior[OF payload.hyps(1)] by simp
qed

lemma pattern_quoted_depth_carrier:
  assumes quote: "pattern_quoted_at (decode_finite_environment E) u V r p I K"
    and source: "C |\<in>| finite_artifacts_at E u"
  shows "factor_pattern_depth p \<le> fcard (finite_carrier (finite_structure C))"
proof -
  have art: "artifact_at (decode_finite_environment E) u (decode_finite_object C)"
    using source by (simp add: finite_artifacts_at_member)
  have subset: "I \<subseteq> fset (finite_carrier (finite_structure C))"
    using pattern_quoted_carrier[OF quote art] by auto
  have "card I \<le> card (fset (finite_carrier (finite_structure C)))"
    by (rule card_mono) (simp_all add: subset)
  then show ?thesis using pattern_quoted_depth_interior[OF quote] by (simp add: fcard.rep_eq)
qed

section \<open>Local citations select declared binders\<close>

fun finite_variable_leaf ::
  "local_address fset \<Rightarrow> (citation \<times> local_address fset) \<Rightarrow>
    local_address finite_term_pattern finite_syntax_reading fset" where
  "finite_variable_leaf V (Local a,I) =
    (if a |\<in>| V \<and> I |\<inter>| V={||} then {|(Finite_Variable a,I,{||})|} else {||})"
| "finite_variable_leaf V (Local_Whole,I) = {||}"
| "finite_variable_leaf V (External k a,I) = {||}"
| "finite_variable_leaf V (External_Whole k,I) = {||}"

lemma finite_variable_leaf_member:
  "(p,I,K) |\<in>| finite_variable_leaf V (c,J) \<longleftrightarrow>
    (\<exists>a. c=Local a \<and> a |\<in>| V \<and> p=Finite_Variable a \<and>
      I=J \<and> K={||} \<and> I |\<inter>| V={||})"
  by (cases c; auto split: if_splits)

definition finite_variable_readings ::
  "finite_exact_artifact \<Rightarrow> local_address fset \<Rightarrow> local_address \<Rightarrow>
    local_address finite_term_pattern finite_syntax_reading fset" where
  "finite_variable_readings C V r =
    ffUnion (fimage (finite_variable_leaf V) (finite_citation_candidates C r))"

lemma finite_variable_readings_member:
  "(p,I,K) |\<in>| finite_variable_readings C V r \<longleftrightarrow>
    (\<exists>a. p=Finite_Variable a \<and> a |\<in>| V \<and>
      citation_at (decode_finite_object C) r (Local a) (fset I) \<and>
      I |\<inter>| V={||} \<and> K={||})"
  by (simp only: finite_variable_readings_def finite_union_image_member split_paired_Ex
      finite_variable_leaf_member finite_citation_candidates_correct; auto; blast)

section \<open>Literal leaves preserve the exact term reading\<close>

fun finite_pattern_leaf ::
  "local_address fset \<Rightarrow> finite_factor_term finite_syntax_reading \<Rightarrow>
    local_address finite_term_pattern finite_syntax_reading fset" where
  "finite_pattern_leaf V (Finite_Target T,I,K) =
    (if I |\<inter>| V={||} then {|(Finite_Pattern_Target T,I,K)|} else {||})"
| "finite_pattern_leaf V (Finite_Payload v,I,K) =
    (if I |\<inter>| V={||} then {|(Finite_Pattern_Payload v,I,K)|} else {||})"
| "finite_pattern_leaf V (Finite_Pair x y,I,K) = {||}"

lemma finite_pattern_leaf_member:
  "(p,I,K) |\<in>| finite_pattern_leaf V (t,J,W) \<longleftrightarrow>
    I=J \<and> K=W \<and> I |\<inter>| V={||} \<and>
    ((\<exists>T. t=Finite_Target T \<and> p=Finite_Pattern_Target T) \<or>
     (\<exists>v. t=Finite_Payload v \<and> p=Finite_Pattern_Payload v))"
  by (cases t; auto split: if_splits)

definition finite_pattern_constants ::
  "'u finite_artifact_environment \<Rightarrow> 'u \<Rightarrow> local_address fset \<Rightarrow> local_address \<Rightarrow>
    local_address finite_term_pattern finite_syntax_reading fset" where
  "finite_pattern_constants E u V r =
    ffUnion (fimage (finite_pattern_leaf V) (finite_term_readings_bounded 1 E u r))"

lemma finite_pattern_constants_member:
  "(p,I,K) |\<in>| finite_pattern_constants E u V r \<longleftrightarrow>
    I |\<inter>| V={||} \<and>
    ((\<exists>T. p=Finite_Pattern_Target T \<and>
      term_quoted_at (decode_finite_environment E) u r (Target_Term (decode_finite_target T)) (fset I) (fset K)) \<or>
     (\<exists>v. p=Finite_Pattern_Payload v \<and>
      term_quoted_at (decode_finite_environment E) u r (Payload_Term v) (fset I) (fset K)))"
  by (simp only: finite_pattern_constants_def finite_union_image_member split_paired_Ex
      finite_pattern_leaf_member finite_term_readings_bounded_correct; auto; blast)

lemma finite_pattern_target_complete:
  assumes quote: "term_quoted_at (decode_finite_environment E) u r (Target_Term t) I K"
    and separate: "I \<inter> fset V={}"
  shows "\<exists>P F W. (P,F,W) |\<in>| finite_pattern_constants E u V r \<and>
    decode_finite_pattern P=Pattern_Target t \<and> fset F=I \<and> fset W=K"
proof -
  obtain T F W where member: "(T,F,W) |\<in>| finite_term_readings_bounded 1 E u r"
    and decoded: "decode_finite_term T=Target_Term t" "fset F=I" "fset W=K"
    using finite_term_readings_bounded_complete[OF quote, of 1] by auto
  obtain A where shape: "T=Finite_Target A" and target: "decode_finite_target A=t"
    using decoded(1) by (cases T) auto
  have leaf: "(Finite_Pattern_Target A,F,W) |\<in>| finite_pattern_constants E u V r"
    using quote separate decoded target
    by (simp add: finite_pattern_constants_member fset_inject[symmetric])
  show ?thesis
    by (rule exI[of _ "Finite_Pattern_Target A"], rule exI[of _ F], rule exI[of _ W])
       (simp add: leaf target decoded)
qed

lemma finite_pattern_payload_complete:
  assumes quote: "term_quoted_at (decode_finite_environment E) u r (Payload_Term v) I K"
    and separate: "I \<inter> fset V={}"
  shows "\<exists>P F W. (P,F,W) |\<in>| finite_pattern_constants E u V r \<and>
    decode_finite_pattern P=Pattern_Payload v \<and> fset F=I \<and> fset W=K"
proof -
  obtain T F W where member: "(T,F,W) |\<in>| finite_term_readings_bounded 1 E u r"
    and decoded: "decode_finite_term T=Payload_Term v" "fset F=I" "fset W=K"
    using finite_term_readings_bounded_complete[OF quote, of 1] by auto
  have leaf: "(Finite_Pattern_Payload v,F,W) |\<in>| finite_pattern_constants E u V r"
    using quote separate decoded
    by (simp add: finite_pattern_constants_member fset_inject[symmetric])
  show ?thesis
    by (rule exI[of _ "Finite_Pattern_Payload v"], rule exI[of _ F], rule exI[of _ W])
       (simp add: leaf decoded)
qed

section \<open>Recursive pattern recovery under the supplied scope\<close>

fun finite_pattern_readings_bounded ::
  "nat \<Rightarrow> 'u finite_artifact_environment \<Rightarrow> 'u \<Rightarrow> local_address fset \<Rightarrow>
    local_address \<Rightarrow> local_address finite_term_pattern finite_syntax_reading fset" where
  "finite_pattern_readings_bounded 0 E u V r={||}"
| "finite_pattern_readings_bounded (Suc n) E u V r=
    (if finite_environment_formed E then finite_pattern_constants E u V r |\<union>|
      ffUnion (fimage (\<lambda>C. finite_variable_readings C V r |\<union>|
        finite_record_readings C r Finite_Pattern_Pair V (finite_pattern_readings_bounded n E u V))
          (finite_artifacts_at E u)) else {||})"

lemma finite_pattern_readings_step:
  "(p,I,K) |\<in>| finite_pattern_readings_bounded (Suc n) E u V r \<longleftrightarrow>
    finite_environment_formed E \<and> ((p,I,K) |\<in>| finite_pattern_constants E u V r \<or>
      (\<exists>C. C |\<in>| finite_artifacts_at E u \<and>
        ((p,I,K) |\<in>| finite_variable_readings C V r \<or>
         (p,I,K) |\<in>| finite_record_readings C r Finite_Pattern_Pair V (finite_pattern_readings_bounded n E u V))))"
  by (auto simp: finite_union_image_member)

lemma finite_pattern_readings_bounded_sound:
  assumes "(p,I,K) |\<in>| finite_pattern_readings_bounded n E u V r"
  shows "pattern_quoted_at (decode_finite_environment E) u (fset V) r
      (decode_finite_pattern p) (fset I) (fset K) \<and>
    factor_pattern_depth (decode_finite_pattern p) \<le> n"
  using assms
proof (induction n arbitrary: r p I K)
  case 0
  then show ?case by simp
next
  case (Suc n)
  have ef: "finite_environment_formed E" using Suc.prems by (simp only: finite_pattern_readings_step; blast)
  have formed: "environment_formed (decode_finite_environment E)"
    using ef by (simp add: finite_environment_formed_correct)
  consider (literal_case) "(p,I,K) |\<in>| finite_pattern_constants E u V r"
    | (variable) C where "C |\<in>| finite_artifacts_at E u" "(p,I,K) |\<in>| finite_variable_readings C V r"
    | (pair) C where "C |\<in>| finite_artifacts_at E u"
        "(p,I,K) |\<in>| finite_record_readings C r Finite_Pattern_Pair V (finite_pattern_readings_bounded n E u V)"
    using Suc.prems by (simp only: finite_pattern_readings_step; blast)
  then show ?case
  proof cases
    case literal_case
    have separate: "fset I \<inter> fset V={}"
      using literal_case by (simp add: finite_pattern_constants_member fset_inject[symmetric])
    consider (target) T where "p=Finite_Pattern_Target T"
        "term_quoted_at (decode_finite_environment E) u r (Target_Term (decode_finite_target T)) (fset I) (fset K)"
      | (payload) v where "p=Finite_Pattern_Payload v"
        "term_quoted_at (decode_finite_environment E) u r (Payload_Term v) (fset I) (fset K)"
      using literal_case by (simp only: finite_pattern_constants_member; blast)
    then show ?thesis
    proof cases
      case (target T)
      have quote: "pattern_quoted_at (decode_finite_environment E) u (fset V) r
        (Pattern_Target (decode_finite_target T)) (fset I) (fset K)"
        by (rule pattern_quoted_at.target[OF target(2) separate])
      show ?thesis using quote target(1) by simp
    next
      case (payload v)
      have quote: "pattern_quoted_at (decode_finite_environment E) u (fset V) r
        (Pattern_Payload v) (fset I) (fset K)"
        by (rule pattern_quoted_at.payload[OF payload(2) separate])
      show ?thesis using quote payload(1) by simp
    qed
  next
    case (variable C)
    have art: "artifact_at (decode_finite_environment E) u (decode_finite_object C)"
      using variable(1) by (simp add: finite_artifacts_at_member)
    obtain a where eq: "p=Finite_Variable a" "K={||}" and declared: "a |\<in>| V"
      and cite: "citation_at (decode_finite_object C) r (Local a) (fset I)"
      and separate: "I |\<inter>| V={||}"
      using variable(2) by (simp only: finite_variable_readings_member; blast)
    have outside: "fset I \<inter> fset V={}"
      using separate by (simp add: fset_inject[symmetric])
    have quote: "pattern_quoted_at (decode_finite_environment E) u (fset V) r
      (Pattern_Variable a) (fset I) {}"
      by (rule pattern_quoted_at.variable[OF formed art cite declared outside])
    show ?thesis using quote eq by simp
  next
    case (pair C)
    have art: "artifact_at (decode_finite_environment E) u (decode_finite_object C)"
      using pair(1) by (simp add: finite_artifacts_at_member)
    obtain ps l q x L A y Q B where rec: "record_at (decode_finite_object C) r ps [l,q]"
      and left: "(x,L,A) |\<in>| finite_pattern_readings_bounded n E u V l"
      and right: "(y,Q,B) |\<in>| finite_pattern_readings_bounded n E u V q"
      and eq: "p=Finite_Pattern_Pair x y" "I=finsert r (fset_of_list ps |\<union>| L |\<union>| Q)" "K=A |\<union>| B"
      and separate: "finsert r (fset_of_list ps) |\<inter>| (L |\<union>| Q)={||}"
        "L |\<inter>| Q={||}" "I |\<inter>| (K |\<union>| V)={||}"
      using pair(2) by (simp only: finite_record_readings_member finite_join_readings_member; auto)
    have lq: "pattern_quoted_at (decode_finite_environment E) u (fset V) l (decode_finite_pattern x) (fset L) (fset A)"
      and ld: "factor_pattern_depth (decode_finite_pattern x) \<le> n" using Suc.IH[OF left] by auto
    have rq: "pattern_quoted_at (decode_finite_environment E) u (fset V) q (decode_finite_pattern y) (fset Q) (fset B)"
      and rd: "factor_pattern_depth (decode_finite_pattern y) \<le> n" using Suc.IH[OF right] by auto
    have boundary: "insert r (set ps) \<inter> (fset L \<union> fset Q)={}"
      "fset L \<inter> fset Q={}"
      "insert r (set ps \<union> fset L \<union> fset Q) \<inter> (fset A \<union> fset B \<union> fset V)={}"
      using separate eq by (simp_all add: fset_inject[symmetric] fset_of_list.rep_eq)
    have quote: "pattern_quoted_at (decode_finite_environment E) u (fset V) r
      (Pattern_Pair (decode_finite_pattern x) (decode_finite_pattern y))
      (insert r (set ps \<union> fset L \<union> fset Q)) (fset A \<union> fset B)"
      by (rule pattern_quoted_at.pair[OF formed art rec lq rq boundary])
    show ?thesis using quote ld rd eq by (simp add: fset_of_list.rep_eq)
  qed
qed

lemma finite_pattern_readings_bounded_complete:
  assumes quote: "pattern_quoted_at (decode_finite_environment E) u (fset V) r p I K"
    and depth: "factor_pattern_depth p \<le> n"
  shows "\<exists>P F W. (P,F,W) |\<in>| finite_pattern_readings_bounded n E u V r \<and>
    decode_finite_pattern P=p \<and> fset F=I \<and> fset W=K"
  using quote depth
proof (induction arbitrary: n rule: pattern_quoted_at.induct)
  case (variable R r a I)
  obtain m where n: "n=Suc m" using variable.prems by (cases n) auto
  have ef: "finite_environment_formed E" using variable.hyps(1) by (simp add: finite_environment_formed_correct)
  obtain C where source: "C |\<in>| finite_artifacts_at E u" and decoded: "decode_finite_object C=R"
    using variable.hyps(2) by (simp only: finite_artifacts_at_complete; blast)
  obtain F where cite: "(Local a,F) |\<in>| finite_citation_candidates C r" and interior: "fset F=I"
    using finite_citation_candidates_complete[of C r "Local a" I] variable.hyps(3) decoded by blast
  have leaf: "(Finite_Variable a,F,{||}) |\<in>| finite_variable_readings C V r"
    using cite interior variable.hyps(4,5)
    by (simp add: finite_variable_readings_member finite_citation_candidates_correct fset_inject[symmetric])
  have member: "(Finite_Variable a,F,{||}) |\<in>| finite_pattern_readings_bounded n E u V r"
    using ef source leaf by (simp only: n finite_pattern_readings_step; blast)
  show ?case
    by (rule exI[of _ "Finite_Variable a"], rule exI[of _ F], rule exI[of _ "{||}"])
       (simp add: member interior)
next
  case (target r t I K)
  obtain m where n: "n=Suc m" using target.prems by (cases n) auto
  have ef: "finite_environment_formed E" using term_quoted_environment_formed[OF target.hyps(1)]
    by (simp add: finite_environment_formed_correct)
  obtain P F W where leaf: "(P,F,W) |\<in>| finite_pattern_constants E u V r"
    and decoded: "decode_finite_pattern P=Pattern_Target t" "fset F=I" "fset W=K"
    using finite_pattern_target_complete[OF target.hyps] by blast
  have member: "(P,F,W) |\<in>| finite_pattern_readings_bounded n E u V r"
    using ef leaf by (simp only: n finite_pattern_readings_step; blast)
  show ?case using member decoded by blast
next
  case (pair R r ps l q x L A y Q B)
  obtain m where n: "n=Suc m" using pair.prems by (cases n) auto
  have ld: "factor_pattern_depth x \<le> m" and rd: "factor_pattern_depth y \<le> m"
    using pair.prems n by auto
  obtain X LF AF where left: "(X,LF,AF) |\<in>| finite_pattern_readings_bounded m E u V l"
    and lx: "decode_finite_pattern X=x" "fset LF=L" "fset AF=A"
    using pair.IH(1)[OF ld] by blast
  obtain Y QF BF where right: "(Y,QF,BF) |\<in>| finite_pattern_readings_bounded m E u V q"
    and ry: "decode_finite_pattern Y=y" "fset QF=Q" "fset BF=B"
    using pair.IH(2)[OF rd] by blast
  have ef: "finite_environment_formed E" using pair.hyps(1) by (simp add: finite_environment_formed_correct)
  obtain C where source: "C |\<in>| finite_artifacts_at E u" and decoded: "decode_finite_object C=R"
    using pair.hyps(2) by (simp only: finite_artifacts_at_complete; blast)
  let ?F = "finsert r (fset_of_list ps |\<union>| LF |\<union>| QF)"
  let ?W = "AF |\<union>| BF"
  have boundary: "finsert r (fset_of_list ps) |\<inter>| (LF |\<union>| QF)={||}"
    "LF |\<inter>| QF={||}" "?F |\<inter>| (?W |\<union>| V)={||}"
    using pair.hyps(6-8) lx ry by (simp_all add: fset_inject[symmetric] fset_of_list.rep_eq)
  have joined: "(Finite_Pattern_Pair X Y,?F,?W) |\<in>| finite_join_readings Finite_Pattern_Pair V r ps
    (finite_pattern_readings_bounded m E u V l) (finite_pattern_readings_bounded m E u V q)"
    using left right boundary by (simp only: finite_join_readings_member; blast)
  have branch: "(Finite_Pattern_Pair X Y,?F,?W) |\<in>|
    finite_record_readings C r Finite_Pattern_Pair V (finite_pattern_readings_bounded m E u V)"
    using joined pair.hyps(3) decoded by (simp only: finite_record_readings_member; blast)
  have member: "(Finite_Pattern_Pair X Y,?F,?W) |\<in>| finite_pattern_readings_bounded n E u V r"
    using ef source branch by (simp only: n finite_pattern_readings_step; blast)
  show ?case
    by (rule exI[of _ "Finite_Pattern_Pair X Y"], rule exI[of _ ?F], rule exI[of _ ?W])
       (simp add: member lx ry fset_of_list.rep_eq)
next
  case (payload r v I K)
  obtain m where n: "n=Suc m" using payload.prems by (cases n) auto
  have ef: "finite_environment_formed E" using term_quoted_environment_formed[OF payload.hyps(1)]
    by (simp add: finite_environment_formed_correct)
  obtain P F W where leaf: "(P,F,W) |\<in>| finite_pattern_constants E u V r"
    and decoded: "decode_finite_pattern P=Pattern_Payload v" "fset F=I" "fset W=K"
    using finite_pattern_payload_complete[OF payload.hyps] by blast
  have member: "(P,F,W) |\<in>| finite_pattern_readings_bounded n E u V r"
    using ef leaf by (simp only: n finite_pattern_readings_step; blast)
  show ?case using member decoded by blast
qed

theorem finite_pattern_readings_bounded_correct:
  "(p,I,K) |\<in>| finite_pattern_readings_bounded n E u V r \<longleftrightarrow>
    pattern_quoted_at (decode_finite_environment E) u (fset V) r
      (decode_finite_pattern p) (fset I) (fset K) \<and>
    factor_pattern_depth (decode_finite_pattern p) \<le> n"
  using finite_pattern_readings_bounded_sound[of p I K n E u V r]
    finite_pattern_readings_bounded_complete[of E u V r "decode_finite_pattern p" "fset I" "fset K" n]
  by (auto simp: fset_inject)

definition finite_pattern_readings ::
  "'u finite_artifact_environment \<Rightarrow> 'u \<Rightarrow> local_address fset \<Rightarrow> local_address \<Rightarrow>
    local_address finite_term_pattern finite_syntax_reading fset" where
  "finite_pattern_readings E u V r = ffUnion (fimage (\<lambda>C.
    finite_pattern_readings_bounded (fcard (finite_carrier (finite_structure C))) E u V r)
      (finite_artifacts_at E u))"

theorem finite_pattern_readings_correct:
  "(p,I,K) |\<in>| finite_pattern_readings E u V r \<longleftrightarrow>
    pattern_quoted_at (decode_finite_environment E) u (fset V) r
      (decode_finite_pattern p) (fset I) (fset K)"
proof
  assume member: "(p,I,K) |\<in>| finite_pattern_readings E u V r"
  show "pattern_quoted_at (decode_finite_environment E) u (fset V) r
    (decode_finite_pattern p) (fset I) (fset K)"
    using member by (auto simp: finite_pattern_readings_def finite_union_image_member
        dest: finite_pattern_readings_bounded_sound)
next
  assume quote: "pattern_quoted_at (decode_finite_environment E) u (fset V) r
    (decode_finite_pattern p) (fset I) (fset K)"
  have has_source: "\<exists>R. artifact_at (decode_finite_environment E) u R"
    by (rule pattern_quotation_has_artifact[OF quote])
  obtain C where source: "C |\<in>| finite_artifacts_at E u"
    using has_source by (auto simp: finite_artifacts_at_member)
  have bounded: "(p,I,K) |\<in>|
    finite_pattern_readings_bounded (fcard (finite_carrier (finite_structure C))) E u V r"
    using quote pattern_quoted_depth_carrier[OF quote source]
    by (simp add: finite_pattern_readings_bounded_correct)
  show "(p,I,K) |\<in>| finite_pattern_readings E u V r"
    using source bounded by (auto simp: finite_pattern_readings_def finite_union_image_member)
qed

theorem finite_pattern_readings_complete:
  assumes quote: "pattern_quoted_at (decode_finite_environment E) u (fset V) r p I K"
  shows "\<exists>P F W. (P,F,W) |\<in>| finite_pattern_readings E u V r \<and>
    decode_finite_pattern P=p \<and> fset F=I \<and> fset W=K"
proof -
  obtain P F W where member: "(P,F,W) |\<in>| finite_pattern_readings_bounded (factor_pattern_depth p) E u V r"
    and decoded: "decode_finite_pattern P=p" "fset F=I" "fset W=K"
    using finite_pattern_readings_bounded_complete[OF quote order_refl] by blast
  have "(P,F,W) |\<in>| finite_pattern_readings E u V r"
    using quote decoded by (simp add: finite_pattern_readings_correct)
  then show ?thesis using decoded by blast
qed

corollary finite_pattern_readings_unique:
  assumes "(p,I,K) |\<in>| finite_pattern_readings E u V r" "(q,J,W) |\<in>| finite_pattern_readings E u V r"
  shows "p=q \<and> I=J \<and> K=W"
proof -
  have first: "pattern_quoted_at (decode_finite_environment E) u (fset V) r
      (decode_finite_pattern p) (fset I) (fset K)"
    and second: "pattern_quoted_at (decode_finite_environment E) u (fset V) r
      (decode_finite_pattern q) (fset J) (fset W)"
    using assms by (simp_all add: finite_pattern_readings_correct)
  show ?thesis using pattern_quoted_unique[OF first second] by (simp add: fset_inject)
qed

export_code finite_pattern_readings checking SML

text \<open>
  Local citations read variables only when their actual target occurrence is
  in the supplied scope. Literal targets retain their exact external values.
  Every pattern interior is disjoint from the declared binders and external
  slots. The carrier-derived depth bound covers every reading under a finite
  scope; no successful branch chooses additional binders or implicit bindings.
\<close>

