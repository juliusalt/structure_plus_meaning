theory Factor_Requested_Applications
  imports Factor_Generation_Bindings Factor_Matching_Instances Factor_Instantiated_Premises
begin

section \<open>A requested head can supply the complete binding relation\<close>

definition finite_requested_schema_applications where
  "finite_requested_schema_applications S t=
    (let V=finite_matching_bindings (finite_schema_conclusion S) t;
         H=finite_instantiated_premises S V
     in if finite_schema_instance S V t H \<and> finite_schema_material_satisfied S V
        then {|(t,V,H)|} else {||})"

lemma finite_requested_schema_application_sound:
  assumes generated: "(t,V,H) |\<in>| finite_requested_schema_applications S q"
  shows "t=q" "finite_schema_instance S V t H" "finite_schema_material_satisfied S V"
  using generated by (auto simp: finite_requested_schema_applications_def Let_def split: if_splits)

lemma finite_schema_instance_head_bindings:
  assumes inst: "finite_schema_instance S V t H"
    and covered: "finite_schema_head_missing S={||}"
  shows "finite_matching_bindings (finite_schema_conclusion S) t=V"
proof -
  have scope: "finite_schema_variables S=finite_pattern_variables (finite_schema_conclusion S)"
    using covered by (auto simp: finite_schema_head_missing_def finite_schema_variables_def)
  have bindings: "finite_term_bindings_formed (finite_pattern_variables (finite_schema_conclusion S)) V"
    and head: "finite_pattern_instance V (finite_schema_conclusion S) t"
    using inst by (auto simp: finite_schema_instance_def scope)
  show ?thesis by (rule finite_matching_complete_scope[OF bindings head])
qed

theorem finite_requested_schema_applications_exact:
  assumes covered: "finite_schema_head_missing S={||}"
  shows "(t,V,H) |\<in>| finite_requested_schema_applications S t \<longleftrightarrow>
    finite_schema_instance S V t H \<and> finite_schema_material_satisfied S V"
proof
  assume "(t,V,H) |\<in>| finite_requested_schema_applications S t"
  then show "finite_schema_instance S V t H \<and> finite_schema_material_satisfied S V"
    using finite_requested_schema_application_sound by blast
next
  assume valid: "finite_schema_instance S V t H \<and> finite_schema_material_satisfied S V"
  have bindings: "finite_matching_bindings (finite_schema_conclusion S) t=V"
    by (rule finite_schema_instance_head_bindings[OF conjunct1[OF valid] covered])
  have body: "finite_instantiated_premises S V=H"
    by (rule finite_instantiated_premises_exact[OF conjunct1[OF valid]])
  show "(t,V,H) |\<in>| finite_requested_schema_applications S t"
    using valid by (simp only: finite_requested_schema_applications_def Let_def bindings body) simp
qed

text \<open>
  The requested term supplies bindings, not semantic evidence. Every complete
  schema instance and material condition is checked before an application is
  returned. The premise family is constructed from the schema itself, retaining
  every original socket and callee. For schemas whose heads cover their entire
  variable scope, the application account is exact on every finite term.
  Variables absent from the head are not assigned arbitrary values.
\<close>

export_code finite_requested_schema_applications checking SML

end
