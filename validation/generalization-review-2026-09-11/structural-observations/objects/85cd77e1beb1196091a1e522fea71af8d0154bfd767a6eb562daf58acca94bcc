theory Factor_Binding_Contributions
  imports "Native_Investigation_Report_Diagnostic_finitepresenters19.Factor_Executable_Matching"
begin

section \<open>Compatible finite unions of independently supplied relations\<close>

lemma finite_relation_functional_subset:
  assumes "finite_relation_functional W" "V |\<subseteq>| W"
  shows "finite_relation_functional V"
  using assms by (auto simp: finite_relation_functional_correct single_valued_def)

definition finite_compatible_unions where
  "finite_compatible_unions B=ffilter finite_relation_functional (fimage ffUnion (fPow B))"

lemma finite_compatible_union_member:
  "V |\<in>| finite_compatible_unions B \<longleftrightarrow>
    finite_relation_functional V \<and> (\<exists>A. A |\<subseteq>| B \<and> V=ffUnion A)"
  by (auto simp: finite_compatible_unions_def)

lemma finite_compatible_union_origin:
  assumes "V |\<in>| finite_compatible_unions B" "(a,t) |\<in>| V"
  shows "\<exists>W. W |\<in>| B \<and> (a,t) |\<in>| W"
  using assms by (auto simp: finite_compatible_union_member ffUnion.rep_eq; blast)

lemma finite_compatible_unions_mono:
  assumes "B |\<subseteq>| D"
  shows "finite_compatible_unions B |\<subseteq>| finite_compatible_unions D"
  using assms by (auto simp: finite_compatible_union_member; blast)

lemma finite_compatible_union_empty [simp]:
  "finite_compatible_unions {||}={|{||}|}"
  by (rule fset_inject[THEN iffD1])
    (auto simp: finite_compatible_unions_def finite_relation_functional_correct single_valued_def)

lemma finite_compatible_union_step:
  "finite_compatible_unions (finsert W B)=finite_compatible_unions B |\<union>|
    fimage (\<lambda>V. W |\<union>| V)
      (ffilter (\<lambda>V. finite_relation_functional (W |\<union>| V)) (finite_compatible_unions B))"
proof -
  have subset: "finite_relation_functional V" if "finite_relation_functional (W |\<union>| V)" for V
    by (rule finite_relation_functional_subset[OF that]) simp
  have "fset (finite_compatible_unions (finsert W B))=
      fset (finite_compatible_unions B |\<union>| fimage (\<lambda>V. W |\<union>| V)
        (ffilter (\<lambda>V. finite_relation_functional (W |\<union>| V)) (finite_compatible_unions B)))"
    using subset by (auto simp: finite_compatible_unions_def fPow_finsert
      fimage_fimage comp_def ffunion_insert fimage.rep_eq image_iff; blast)
  then show ?thesis by (simp only: fset_inject)
qed

fun finite_compatible_union_list where
  "finite_compatible_union_list []={|{||}|}"
| "finite_compatible_union_list (W#Bs)=
    (let A=finite_compatible_union_list Bs
     in A |\<union>| fimage (\<lambda>V. W |\<union>| V)
       (ffilter (\<lambda>V. finite_relation_functional (W |\<union>| V)) A))"

lemma finite_compatible_unions_list:
  "finite_compatible_union_list Bs=finite_compatible_unions (fset_of_list Bs)"
  by (induction Bs) (simp_all add: finite_compatible_union_step Let_def)

section \<open>Each contribution is recovered from an actual source pattern\<close>

definition pattern_binding_observation where
  "pattern_binding_observation P O i p t V \<longleftrightarrow>
    (i,p)\<in>P \<and> (i,t)\<in>O \<and>
    term_bindings_formed (pattern_variables p) V \<and> pattern_instance V p t"

definition finite_pattern_observations where
  "finite_pattern_observations P O=ffUnion (fimage (\<lambda>(i,p).
    fimage (\<lambda>(j,t). (i,p,t))
      (ffilter (\<lambda>(j,t). j=i \<and> finite_pattern_accepts p t) O)) P)"

lemma finite_pattern_observation_member:
  "(i,p,t) |\<in>| finite_pattern_observations P O \<longleftrightarrow>
    (i,p) |\<in>| P \<and> (i,t) |\<in>| O \<and> finite_pattern_accepts p t"
  by (auto simp: finite_pattern_observations_def ffUnion.rep_eq fimage.rep_eq
    image_iff split: prod.splits; force)

definition finite_observed_bindings where
  "finite_observed_bindings P O=finite_compatible_unions
    (fimage (\<lambda>(i,p,t). finite_matching_bindings p t) (finite_pattern_observations P O))"

definition finite_binding_support where
  "finite_binding_support P O V=ffilter
    (\<lambda>(i,p,t). finite_matching_bindings p t |\<subseteq>| V) (finite_pattern_observations P O)"

lemma finite_binding_support_member:
  "(i,p,t) |\<in>| finite_binding_support P O V \<longleftrightarrow>
    (i,p) |\<in>| P \<and> (i,t) |\<in>| O \<and> finite_pattern_accepts p t \<and>
    finite_matching_bindings p t |\<subseteq>| V"
  by (simp add: finite_binding_support_def finite_pattern_observation_member)

definition finite_observation_union where
  "finite_observation_union M=ffUnion (fimage (\<lambda>(i,p,t). finite_matching_bindings p t) M)"

definition finite_join_observations where
  "finite_join_observations P E=
    (let M=finite_pattern_observations P E; V=finite_observation_union M
     in if finite_relation_functional P \<and> fimage (\<lambda>(i,p,t). (i,t)) M=E \<and>
       finite_relation_functional V then Some V else None)"

theorem finite_join_observations_exact:
  "finite_join_observations P E=Some V \<longleftrightarrow>
    finite_relation_functional P \<and>
    fimage (\<lambda>(i,p,t). (i,t)) (finite_pattern_observations P E)=E \<and>
    finite_relation_functional V \<and> V=finite_observation_union (finite_pattern_observations P E)"
  by (auto simp: finite_join_observations_def Let_def split: if_splits)

theorem finite_join_observations_retains_every_input:
  assumes joined: "finite_join_observations P E=Some V" and observed: "(i,t) |\<in>| E"
  shows "\<exists>p. (i,p) |\<in>| P \<and> finite_pattern_accepts p t \<and>
    finite_matching_bindings p t |\<subseteq>| V"
  using joined observed
  by (auto simp: finite_join_observations_exact finite_pattern_observation_member
    finite_observation_union_def ffUnion.rep_eq fimage.rep_eq image_iff
    split: prod.splits; force)

theorem finite_observed_binding_origin:
  assumes generated: "V |\<in>| finite_observed_bindings P O" and row: "(a,t) |\<in>| V"
  shows "\<exists>i p u. (i,p) |\<in>| P \<and> (i,u) |\<in>| O \<and>
    finite_pattern_accepts p u \<and> (a,t) |\<in>| finite_matching_bindings p u"
  using finite_compatible_union_origin[OF _ row] generated
  by (auto simp: finite_observed_bindings_def finite_pattern_observation_member
    fimage.rep_eq image_iff split: prod.splits; force)

lemma finite_observed_bindings_functional:
  "V |\<in>| finite_observed_bindings P O \<Longrightarrow> finite_relation_functional V"
  by (auto simp: finite_observed_bindings_def finite_compatible_union_member)

lemma finite_observed_bindings_values:
  assumes generated: "V |\<in>| finite_observed_bindings P O" and row: "(a,t) |\<in>| V"
  shows "finite_term_formed t"
  using finite_observed_binding_origin[OF generated row]
  by (auto simp: finite_pattern_accepts_def finite_term_bindings_formed_def)

theorem finite_observed_bindings_complete_scope:
  assumes generated: "V |\<in>| finite_observed_bindings P O"
  shows "finite_term_bindings_formed B V \<longleftrightarrow> fimage fst V=B"
  using finite_observed_bindings_functional[OF generated] finite_observed_bindings_values[OF generated]
  by (auto simp: finite_term_bindings_formed_def)

text \<open>
  P contains the actual source patterns and O the observed terms at their
  source keys. Only an accepted structural match supplies a relation. The
  union operation considers compatible combinations of any finite number of
  contributions; no contribution must cover the complete application alone.
  Every resulting pair has an actual source match, and disagreement on one
  variable is rejected. Whole-scope completion is a separate final condition.

  These observations establish substitution information. They do not establish
  the truth of a requested conclusion or a possible premise. Concrete schema
  consumers must derive P from the same complete schema they later check.
\<close>

end
