theory Factor_Executable_Scopes
  imports "Factor_Executable_Patterns" "Native_Investigation_Report_Diagnostic_finitepresenters19.Factor_Presentation"
begin

section \<open>Declared binders are recovered from the actual family\<close>

definition finite_binder_scope_at ::
  "finite_exact_artifact \<Rightarrow> local_address \<Rightarrow> local_address fset \<Rightarrow> bool" where
  "finite_binder_scope_at C b V = finite_family_at C b (fimage (\<lambda>a. (a,a)) V)"

lemma finite_binder_scope_at_correct:
  "finite_binder_scope_at C b V \<longleftrightarrow> binder_scope_at (decode_finite_object C) b (fset V)"
  by (simp add: finite_binder_scope_at_def finite_family_at_correct binder_scope_at_def fimage.rep_eq)

definition finite_binder_scope_candidates ::
  "finite_exact_artifact \<Rightarrow> local_address \<Rightarrow> local_address fset fset" where
  "finite_binder_scope_candidates C b =
    (let V=fimage fst (finite_headed_incidence (finite_structure C) b) in
     if finite_binder_scope_at C b V then {|V|} else {||})"

theorem finite_binder_scope_candidates_correct:
  "V |\<in>| finite_binder_scope_candidates C b \<longleftrightarrow>
    binder_scope_at (decode_finite_object C) b (fset V)"
proof -
  let ?H = "finite_headed_incidence (finite_structure C) b"
  have recover: "binder_scope_at (decode_finite_object C) b (fset V) \<Longrightarrow> fimage fst ?H=V"
  proof -
    assume read: "binder_scope_at (decode_finite_object C) b (fset V)"
    have head: "fset ?H=(\<lambda>a. (a,a)) ` fset V"
      using read by (simp add: binder_scope_at_def family_at_def finite_headed_incidence_correct)
    have "fset (fimage fst ?H)=fset V" by (simp add: fimage.rep_eq head image_image)
    then show "fimage fst ?H=V" by (simp only: fset_inject)
  qed
  show ?thesis using recover
    by (auto simp: finite_binder_scope_candidates_def Let_def finite_binder_scope_at_correct split: if_splits)
qed

lemma finite_binder_scope_candidates_complete:
  assumes read: "binder_scope_at (decode_finite_object C) b V"
  shows "\<exists>F. F |\<in>| finite_binder_scope_candidates C b \<and> fset F=V"
proof -
  have finite: "finite V" by (rule binder_scope_properties(1)[OF read])
  have represented: "fset (Abs_fset V)=V" by (rule Abs_fset_inverse) (simp add: finite)
  have member: "Abs_fset V |\<in>| finite_binder_scope_candidates C b"
    using read represented by (simp add: finite_binder_scope_candidates_correct)
  show ?thesis using member represented by blast
qed

section \<open>A scoped pattern preserves the whole declaration and body\<close>

lemma finite_join_scope_member:
  "(p,I,K) |\<in>| finite_join_readings (\<lambda>(_::unit) p. p) {||} r ps
      {|((),finsert b V,{||})|} Y \<longleftrightarrow>
    (\<exists>J. (p,J,K) |\<in>| Y \<and>
      I=finsert r (fset_of_list ps |\<union>| finsert b V |\<union>| J) \<and>
      finsert r (fset_of_list ps) |\<inter>| (finsert b V |\<union>| J)={||} \<and>
      finsert b V |\<inter>| J={||} \<and> I |\<inter>| K={||})"
  by (simp only: finite_join_readings_member; auto; blast)

definition finite_scoped_record ::
  "'u finite_artifact_environment \<Rightarrow> 'u \<Rightarrow> finite_exact_artifact \<Rightarrow>
    local_address \<Rightarrow> local_address list \<Rightarrow> local_address \<Rightarrow> local_address \<Rightarrow>
    local_address finite_term_pattern finite_syntax_reading fset" where
  "finite_scoped_record E u C r ps b q = ffUnion (fimage (\<lambda>V.
    ffilter (\<lambda>(p,I,K). finite_pattern_variables p=V)
      (finite_join_readings (\<lambda>(_::unit) p. p) {||} r ps {|((),finsert b V,{||})|}
        (finite_pattern_readings E u V q))) (finite_binder_scope_candidates C b))"

lemma finite_scoped_record_member:
  "(p,I,K) |\<in>| finite_scoped_record E u C r ps b q \<longleftrightarrow>
    (\<exists>V J. V |\<in>| finite_binder_scope_candidates C b \<and>
      (p,J,K) |\<in>| finite_pattern_readings E u V q \<and> finite_pattern_variables p=V \<and>
      I=finsert r (fset_of_list ps |\<union>| finsert b V |\<union>| J) \<and>
      finsert r (fset_of_list ps) |\<inter>| (finsert b V |\<union>| J)={||} \<and>
      finsert b V |\<inter>| J={||} \<and> I |\<inter>| K={||})"
  by (simp only: finite_scoped_record_def finite_union_image_member;
      auto simp: finite_join_scope_member)

definition finite_scoped_pattern_readings ::
  "'u finite_artifact_environment \<Rightarrow> 'u \<Rightarrow> local_address \<Rightarrow>
    local_address finite_term_pattern finite_syntax_reading fset" where
  "finite_scoped_pattern_readings E u r = (if finite_environment_formed E then
    ffUnion (fimage (\<lambda>C. finite_two_field_record C r (finite_scoped_record E u C r))
      (finite_artifacts_at E u)) else {||})"

lemma finite_scoped_pattern_readings_step:
  "(p,I,K) |\<in>| finite_scoped_pattern_readings E u r \<longleftrightarrow>
    finite_environment_formed E \<and> (\<exists>C ps b q. C |\<in>| finite_artifacts_at E u \<and>
      record_at (decode_finite_object C) r ps [b,q] \<and>
      (p,I,K) |\<in>| finite_scoped_record E u C r ps b q)"
  by (auto simp: finite_scoped_pattern_readings_def finite_union_image_member
      finite_two_field_record_member split: if_splits)

theorem finite_scoped_pattern_readings_correct:
  "(p,I,K) |\<in>| finite_scoped_pattern_readings E u r \<longleftrightarrow>
    scoped_pattern_at (decode_finite_environment E) u r (decode_finite_pattern p) (fset I) (fset K)"
proof
  assume member: "(p,I,K) |\<in>| finite_scoped_pattern_readings E u r"
  obtain C ps b q V J where ef: "finite_environment_formed E"
    and source: "C |\<in>| finite_artifacts_at E u"
    and rec: "record_at (decode_finite_object C) r ps [b,q]"
    and scope: "V |\<in>| finite_binder_scope_candidates C b"
    and body: "(p,J,K) |\<in>| finite_pattern_readings E u V q"
    and declared: "finite_pattern_variables p=V"
    and boundary: "I=finsert r (fset_of_list ps |\<union>| finsert b V |\<union>| J)"
      "finsert r (fset_of_list ps) |\<inter>| (finsert b V |\<union>| J)={||}"
      "finsert b V |\<inter>| J={||}" "I |\<inter>| K={||}"
    using member by (simp only: finite_scoped_pattern_readings_step finite_scoped_record_member; auto)
  have formed: "environment_formed (decode_finite_environment E)"
    using ef by (simp add: finite_environment_formed_correct)
  have art: "artifact_at (decode_finite_environment E) u (decode_finite_object C)"
    using source by (simp add: finite_artifacts_at_member)
  show "scoped_pattern_at (decode_finite_environment E) u r (decode_finite_pattern p) (fset I) (fset K)"
    unfolding scoped_pattern_at_def
    apply (rule conjI[OF formed])
    apply (rule exI[of _ "decode_finite_object C"])
    apply (rule exI[of _ ps], rule exI[of _ b], rule exI[of _ q])
    apply (rule exI[of _ "fset V"], rule exI[of _ "fset J"])
    using art rec scope body declared boundary
    by (auto simp: finite_binder_scope_candidates_correct finite_pattern_readings_correct
        finite_pattern_variables_correct[symmetric] fset_inject[symmetric] fset_of_list.rep_eq)
next
  assume read: "scoped_pattern_at (decode_finite_environment E) u r (decode_finite_pattern p) (fset I) (fset K)"
  obtain C ps b q V J where ef: "environment_formed (decode_finite_environment E)"
    and source: "C |\<in>| finite_artifacts_at E u"
    and rec: "record_at (decode_finite_object C) r ps [b,q]"
    and scope: "binder_scope_at (decode_finite_object C) b V"
    and body: "pattern_quoted_at (decode_finite_environment E) u V q (decode_finite_pattern p) J (fset K)"
    and declared: "V=pattern_variables (decode_finite_pattern p)"
    and boundary: "insert r (set ps) \<inter> (insert b V \<union> J)={}" "insert b V \<inter> J={}"
      "fset I=insert r (set ps \<union> insert b V \<union> J)" "fset I \<inter> fset K={}"
    using read by (auto simp: scoped_pattern_at_def finite_artifacts_at_member)
  obtain VF where binders: "VF |\<in>| finite_binder_scope_candidates C b" and represented: "fset VF=V"
    using finite_binder_scope_candidates_complete[OF scope] by blast
  have fin: "finite J" using pattern_quoted_boundary[OF body] by blast
  have interior: "fset (Abs_fset J)=J" by (rule Abs_fset_inverse) (simp add: fin)
  have pattern: "(p,Abs_fset J,K) |\<in>| finite_pattern_readings E u VF q"
    using body represented interior by (simp add: finite_pattern_readings_correct)
  have complete: "finite_pattern_variables p=VF"
    using declared represented by (simp add: fset_inject[symmetric] finite_pattern_variables_correct)
  have physical: "I=finsert r (fset_of_list ps |\<union>| finsert b VF |\<union>| Abs_fset J)"
    "finsert r (fset_of_list ps) |\<inter>| (finsert b VF |\<union>| Abs_fset J)={||}"
    "finsert b VF |\<inter>| Abs_fset J={||}" "I |\<inter>| K={||}"
    using boundary represented interior by (simp_all add: fset_inject[symmetric] fset_of_list.rep_eq)
  have branch: "(p,I,K) |\<in>| finite_scoped_record E u C r ps b q"
    unfolding finite_scoped_record_member
    by (rule exI[of _ VF], rule exI[of _ "Abs_fset J"])
       (use binders pattern complete physical in blast)
  show "(p,I,K) |\<in>| finite_scoped_pattern_readings E u r"
    using ef source rec branch
    by (simp only: finite_scoped_pattern_readings_step finite_environment_formed_correct; blast)
qed

theorem finite_scoped_pattern_readings_complete:
  assumes read: "scoped_pattern_at (decode_finite_environment E) u r p I K"
  shows "\<exists>P F W. (P,F,W) |\<in>| finite_scoped_pattern_readings E u r \<and>
    decode_finite_pattern P=p \<and> fset F=I \<and> fset W=K"
proof -
  have formed: "pattern_formed p" and fi: "finite I" and fk: "finite K"
    using scoped_pattern_formed[OF read] by auto
  have pattern: "decode_finite_pattern (finite_pattern_of p)=p"
    by (rule decode_finite_pattern_of[OF formed])
  have interior: "fset (Abs_fset I)=I" by (rule Abs_fset_inverse) (simp add: fi)
  have slots: "fset (Abs_fset K)=K" by (rule Abs_fset_inverse) (simp add: fk)
  have member: "(finite_pattern_of p,Abs_fset I,Abs_fset K) |\<in>| finite_scoped_pattern_readings E u r"
    using read pattern interior slots by (simp add: finite_scoped_pattern_readings_correct)
  show ?thesis using member pattern interior slots by blast
qed

corollary finite_scoped_pattern_readings_unique:
  assumes "(p,I,K) |\<in>| finite_scoped_pattern_readings E u r"
    "(q,J,W) |\<in>| finite_scoped_pattern_readings E u r"
  shows "p=q \<and> I=J \<and> K=W"
proof -
  have first: "scoped_pattern_at (decode_finite_environment E) u r (decode_finite_pattern p) (fset I) (fset K)"
    and second: "scoped_pattern_at (decode_finite_environment E) u r (decode_finite_pattern q) (fset J) (fset W)"
    using assms by (simp_all add: finite_scoped_pattern_readings_correct)
  show ?thesis using scoped_pattern_unique[OF first second] by (simp add: fset_inject)
qed

export_code finite_binder_scope_candidates finite_scoped_pattern_readings checking SML

text \<open>
  The complete actual family determines the binder scope. Scoped recovery
  requires its declarations to equal exactly the variables used in the body,
  and retains the declaration, record, body, and external slot boundaries.
  Every abstract scoped pattern has a recovered finite value; malformed or
  unused declarations do not obtain a reading through an omitted check.
\<close>

end
