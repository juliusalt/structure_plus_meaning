theory Factor_Executable_References
  imports "Factor_Executable_Calls" "Native_Investigation_Report_Diagnostic_finitepresenters19.Factor_Native_References"
begin

section \<open>Located citations retain their complete physical boundary\<close>

definition finite_site_citation_readings ::
  "'u finite_artifact_environment \<Rightarrow> 'u \<Rightarrow> local_address \<Rightarrow>
    'u definition_site finite_syntax_reading fset" where
  "finite_site_citation_readings E u r = (if finite_environment_formed E then
    ffUnion (fimage (\<lambda>C. finite_location_readings E u C r) (finite_artifacts_at E u)) else {||})"

lemma finite_site_citation_readings_step:
  "(d,I,K) |\<in>| finite_site_citation_readings E u r \<longleftrightarrow>
    finite_environment_formed E \<and> (\<exists>C. C |\<in>| finite_artifacts_at E u \<and>
      (d,I,K) |\<in>| finite_location_readings E u C r)"
  by (auto simp: finite_site_citation_readings_def finite_union_image_member split: if_splits)

theorem finite_site_citation_readings_correct:
  "(d,I,K) |\<in>| finite_site_citation_readings E u r \<longleftrightarrow>
    site_citation_at (decode_finite_environment E) u r d (fset I) (fset K)"
proof
  assume member: "(d,I,K) |\<in>| finite_site_citation_readings E u r"
  obtain C c where ef: "finite_environment_formed E"
    and source: "C |\<in>| finite_artifacts_at E u"
    and citation: "citation_at (decode_finite_object C) r c (fset I)"
    and location: "citation_location (decode_finite_environment E) u c (fst d) (snd d)"
    and slots: "K=finite_citation_slots c"
    using member by (simp only: finite_site_citation_readings_step finite_location_readings_member; blast)
  have formed: "environment_formed (decode_finite_environment E)"
    using ef by (simp add: finite_environment_formed_correct)
  have art: "artifact_at (decode_finite_environment E) u (decode_finite_object C)"
    using source by (simp add: finite_artifacts_at_member)
  show "site_citation_at (decode_finite_environment E) u r d (fset I) (fset K)"
    unfolding site_citation_at_def
    by (rule conjI[OF formed], rule exI[of _ "decode_finite_object C"], rule exI[of _ c])
      (use art citation location slots in \<open>simp add: finite_citation_slots_correct\<close>)
next
  assume read: "site_citation_at (decode_finite_environment E) u r d (fset I) (fset K)"
  obtain C c where ef: "environment_formed (decode_finite_environment E)"
    and source: "C |\<in>| finite_artifacts_at E u"
    and citation: "citation_at (decode_finite_object C) r c (fset I)"
    and location: "citation_location (decode_finite_environment E) u c (fst d) (snd d)"
    and slots: "fset K=citation_slots c"
    using read by (auto simp: site_citation_at_def finite_artifacts_at_member)
  have boundary: "K=finite_citation_slots c"
    using slots by (simp add: fset_inject[symmetric] finite_citation_slots_correct)
  have member: "(d,I,K) |\<in>| finite_location_readings E u C r"
    using citation location boundary by (auto simp: finite_location_readings_member)
  show "(d,I,K) |\<in>| finite_site_citation_readings E u r"
    unfolding finite_site_citation_readings_step
    apply (rule conjI)
     apply (use ef in \<open>simp add: finite_environment_formed_correct\<close>)
    apply (rule exI[of _ C])
    using source member by blast
qed

theorem finite_site_citation_readings_complete:
  assumes read: "site_citation_at (decode_finite_environment E) u r d I K"
  shows "\<exists>F W. (d,F,W) |\<in>| finite_site_citation_readings E u r \<and> fset F=I \<and> fset W=K"
proof -
  have finite: "finite I" "finite K" using site_citation_properties(2,3)[OF read] by blast+
  have interior: "fset (Abs_fset I)=I" by (rule Abs_fset_inverse) (simp add: finite)
  have slots: "fset (Abs_fset K)=K" by (rule Abs_fset_inverse) (simp add: finite)
  show ?thesis by (rule exI[of _ "Abs_fset I"], rule exI[of _ "Abs_fset K"])
    (use read interior slots in \<open>simp add: finite_site_citation_readings_correct\<close>)
qed

corollary finite_site_citation_readings_unique:
  assumes "(d,I,K) |\<in>| finite_site_citation_readings E u r"
    "(e,J,A) |\<in>| finite_site_citation_readings E u r"
  shows "d=e \<and> I=J \<and> K=A"
proof -
  have first: "site_citation_at (decode_finite_environment E) u r d (fset I) (fset K)"
    and second: "site_citation_at (decode_finite_environment E) u r e (fset J) (fset A)"
    using assms by (simp_all add: finite_site_citation_readings_correct)
  show ?thesis using site_citation_unique[OF first second] by (simp add: fset_inject)
qed

lemma finite_location_readings_site_citation:
  assumes ef: "finite_environment_formed E" and source: "C |\<in>| finite_artifacts_at E u"
  shows "(d,I,K) |\<in>| finite_location_readings E u C r \<longleftrightarrow>
    site_citation_at (decode_finite_environment E) u r d (fset I) (fset K)"
proof -
  have formed: "environment_formed (decode_finite_environment E)"
    using ef by (simp add: finite_environment_formed_correct)
  have art: "artifact_at (decode_finite_environment E) u (decode_finite_object C)"
    using source by (simp add: finite_artifacts_at_member)
  have unique: "D=C" if other: "D |\<in>| finite_artifacts_at E u" for D
  proof -
    have art': "artifact_at (decode_finite_environment E) u (decode_finite_object D)"
      using other by (simp add: finite_artifacts_at_member)
    have same: "decode_finite_object D=decode_finite_object C"
      by (rule environment_artifact_unique[OF formed art' art])
    show ?thesis using same by simp
  qed
  have wrapper: "(d,I,K) |\<in>| finite_site_citation_readings E u r \<longleftrightarrow>
      (d,I,K) |\<in>| finite_location_readings E u C r"
  proof
    assume member: "(d,I,K) |\<in>| finite_site_citation_readings E u r"
    obtain D where actual: "D |\<in>| finite_artifacts_at E u"
      and reading: "(d,I,K) |\<in>| finite_location_readings E u D r"
      using member by (simp only: finite_site_citation_readings_step; blast)
    have same: "D=C" by (rule unique[OF actual])
    show "(d,I,K) |\<in>| finite_location_readings E u C r" using reading same by simp
  next
    assume reading: "(d,I,K) |\<in>| finite_location_readings E u C r"
    show "(d,I,K) |\<in>| finite_site_citation_readings E u r"
      unfolding finite_site_citation_readings_step
      by (rule conjI[OF ef], rule exI[of _ C]) (use source reading in blast)
  qed
  show ?thesis using wrapper by (simp only: finite_site_citation_readings_correct; blast)
qed

section \<open>Each link retains both located endpoints\<close>

definition finite_site_link_readings ::
  "'u finite_artifact_environment \<Rightarrow> 'u \<Rightarrow> local_address \<Rightarrow>
    ('u definition_site \<times> 'u definition_site) finite_syntax_reading fset" where
  "finite_site_link_readings E u r = finite_call_readings E u {||} r (finite_site_citation_readings E u)"

theorem finite_site_link_readings_correct:
  "((d,e),I,K) |\<in>| finite_site_link_readings E u r \<longleftrightarrow>
    native_site_link_at (decode_finite_environment E) u r d e (fset I) (fset K)"
proof
  assume member: "((d,e),I,K) |\<in>| finite_site_link_readings E u r"
  obtain C ps a b J A L B where ef: "finite_environment_formed E"
    and source: "C |\<in>| finite_artifacts_at E u"
    and rec: "record_at (decode_finite_object C) r ps [a,b]"
    and left: "(d,J,A) |\<in>| finite_location_readings E u C a"
    and right: "(e,L,B) |\<in>| finite_site_citation_readings E u b"
    and boundary: "I=finsert r (fset_of_list ps |\<union>| J |\<union>| L)" "K=A |\<union>| B"
      "finsert r (fset_of_list ps) |\<inter>| (J |\<union>| L)={||}"
      "J |\<inter>| L={||}" "I |\<inter>| (K |\<union>| {||})={||}"
    using member by (simp only: finite_site_link_readings_def finite_call_readings_step; auto)
  have formed: "environment_formed (decode_finite_environment E)"
    using ef by (simp add: finite_environment_formed_correct)
  have art: "artifact_at (decode_finite_environment E) u (decode_finite_object C)"
    using source by (simp add: finite_artifacts_at_member)
  have first: "site_citation_at (decode_finite_environment E) u a d (fset J) (fset A)"
    using left by (simp add: finite_location_readings_site_citation[OF ef source])
  have second: "site_citation_at (decode_finite_environment E) u b e (fset L) (fset B)"
    using right by (simp add: finite_site_citation_readings_correct)
  show "native_site_link_at (decode_finite_environment E) u r d e (fset I) (fset K)"
    unfolding native_site_link_at_def
    apply (rule conjI[OF formed])
    apply (rule exI[of _ "decode_finite_object C"], rule exI[of _ ps], rule exI[of _ a], rule exI[of _ b])
    apply (rule exI[of _ "fset J"], rule exI[of _ "fset A"], rule exI[of _ "fset L"], rule exI[of _ "fset B"])
    using art rec first second boundary
    by (auto simp: fset_inject[symmetric] fset_of_list.rep_eq)
next
  assume read: "native_site_link_at (decode_finite_environment E) u r d e (fset I) (fset K)"
  obtain C ps a b J A L B where ef: "environment_formed (decode_finite_environment E)"
    and source: "C |\<in>| finite_artifacts_at E u"
    and rec: "record_at (decode_finite_object C) r ps [a,b]"
    and first: "site_citation_at (decode_finite_environment E) u a d J A"
    and second: "site_citation_at (decode_finite_environment E) u b e L B"
    and boundary: "insert r (set ps) \<inter> (J \<union> L)={}" "J \<inter> L={}"
      "fset I=insert r (set ps \<union> J \<union> L)" "fset K=A \<union> B" "fset I \<inter> fset K={}"
    using read by (auto simp: native_site_link_at_def finite_artifacts_at_member)
  obtain F W where first_member: "(d,F,W) |\<in>| finite_site_citation_readings E u a"
    and first_boundary: "fset F=J" "fset W=A"
    using finite_site_citation_readings_complete[OF first] by blast
  obtain N Z where right: "(e,N,Z) |\<in>| finite_site_citation_readings E u b"
    and second_boundary: "fset N=L" "fset Z=B"
    using finite_site_citation_readings_complete[OF second] by blast
  have formed: "finite_environment_formed E" using ef by (simp add: finite_environment_formed_correct)
  have left: "(d,F,W) |\<in>| finite_location_readings E u C a"
    using first first_boundary by (simp add: finite_location_readings_site_citation[OF formed source])
  have physical: "I=finsert r (fset_of_list ps |\<union>| F |\<union>| N)" "K=W |\<union>| Z"
    "finsert r (fset_of_list ps) |\<inter>| (F |\<union>| N)={||}"
    "F |\<inter>| N={||}" "I |\<inter>| (K |\<union>| {||})={||}"
    using boundary first_boundary second_boundary
    by (simp_all add: fset_inject[symmetric] fset_of_list.rep_eq)
  show "((d,e),I,K) |\<in>| finite_site_link_readings E u r"
    unfolding finite_site_link_readings_def finite_call_readings_step
    apply (rule conjI[OF formed])
    apply (rule exI[of _ C], rule exI[of _ ps], rule exI[of _ a], rule exI[of _ b])
    apply (rule exI[of _ F], rule exI[of _ W], rule exI[of _ N], rule exI[of _ Z])
    using source rec left right physical by blast
qed

theorem finite_site_link_readings_complete:
  assumes read: "native_site_link_at (decode_finite_environment E) u r d e I K"
  shows "\<exists>F W. ((d,e),F,W) |\<in>| finite_site_link_readings E u r \<and> fset F=I \<and> fset W=K"
proof -
  have finite: "finite I" "finite K" using native_site_link_properties(2,3)[OF read] by blast+
  have interior: "fset (Abs_fset I)=I" by (rule Abs_fset_inverse) (simp add: finite)
  have slots: "fset (Abs_fset K)=K" by (rule Abs_fset_inverse) (simp add: finite)
  show ?thesis by (rule exI[of _ "Abs_fset I"], rule exI[of _ "Abs_fset K"])
    (use read interior slots in \<open>simp add: finite_site_link_readings_correct\<close>)
qed

corollary finite_site_link_readings_unique:
  assumes "((d,e),I,K) |\<in>| finite_site_link_readings E u r"
    "((f,g),J,A) |\<in>| finite_site_link_readings E u r"
  shows "d=f \<and> e=g \<and> I=J \<and> K=A"
proof -
  have first: "native_site_link_at (decode_finite_environment E) u r d e (fset I) (fset K)"
    and second: "native_site_link_at (decode_finite_environment E) u r f g (fset J) (fset A)"
    using assms by (simp_all add: finite_site_link_readings_correct)
  show ?thesis using native_site_link_unique[OF first second] by (simp add: fset_inject)
qed

export_code finite_site_citation_readings finite_site_link_readings checking SML

text \<open>
  Located citations retain the actual target use and position, their whole
  syntax interior, and their external slots. A two-field link checks both
  citation interiors and their complete enclosing boundary. Its endpoints
  may identify one site while the two citation interiors remain distinct.
  The common call-record reader supplies the same geometry without introducing
  interface or truth conditions. Binding and premise tables can therefore use
  these readings as physical rows before any derivation is checked.
\<close>

end
