theory Factor_Executable_Packages
  imports "Factor_Executable_Definitions" "Factor_Executable_Systems" "Native_Investigation_Report_Diagnostic_finitepresenters19.Factor_Packages" "Native_Investigation_Report_Diagnostic_finitepresenters19.Bootstrap_Finite_Closure"
begin

section \<open>Every candidate definition comes from a supplied occurrence\<close>

definition finite_environment_positions ::
  "'u finite_artifact_environment \<Rightarrow> 'u definition_site fset" where
  "finite_environment_positions E = ffUnion (fimage (\<lambda>(u,C).
    fimage (Pair u) (finite_carrier (finite_structure C))) (finite_environment_artifacts E))"

lemma finite_environment_positions_correct:
  "fset (finite_environment_positions E) = environment_positions (decode_finite_environment E)"
  by (auto simp: finite_environment_positions_def finite_union_image_member finite_image_member
      environment_positions_def artifact_at_def split: prod.splits; force)

definition decode_finite_definition ::
  "'u finite_native_definition \<Rightarrow>
    local_address term_pattern \<times> (local_address \<times> 'u native_schema) set" where
  "decode_finite_definition q =
    (decode_finite_pattern (fst q),map_relation_values decode_finite_schema (fset (snd q)))"

lemma decode_finite_definition_injective [simp]:
  fixes p :: "'u finite_native_definition"
  shows "decode_finite_definition p=decode_finite_definition q \<longleftrightarrow> p=q"
proof -
  have injective: "inj (decode_finite_schema :: 'u finite_native_schema \<Rightarrow> _)"
    by (auto simp: inj_def)
  show ?thesis by (cases p; cases q)
    (simp add: decode_finite_definition_def map_relation_values_injective[OF injective] fset_inject)
qed

definition finite_native_definition_rows ::
  "'u finite_artifact_environment \<Rightarrow> ('u definition_site \<times> 'u finite_native_definition) fset" where
  "finite_native_definition_rows E = ffUnion (fimage (\<lambda>d.
    fimage (Pair d) (finite_native_definition_readings E (fst d) (snd d)))
      (finite_environment_positions E))"

lemma finite_native_definition_rows_correct:
  "(d,p,F) |\<in>| finite_native_definition_rows E \<longleftrightarrow>
    native_definition_at (decode_finite_environment E) (fst d) (snd d)
      (decode_finite_pattern p) (map_relation_values decode_finite_schema (fset F))"
proof -
  have step: "(d,p,F) |\<in>| finite_native_definition_rows E \<longleftrightarrow>
      d |\<in>| finite_environment_positions E \<and>
      (p,F) |\<in>| finite_native_definition_readings E (fst d) (snd d)"
    by (simp only: finite_native_definition_rows_def finite_union_image_member finite_image_member prod.inject; blast)
  have position: "native_definition_at (decode_finite_environment E) (fst d) (snd d)
      (decode_finite_pattern p) (map_relation_values decode_finite_schema (fset F)) \<Longrightarrow>
      d \<in> environment_positions (decode_finite_environment E)"
    using native_definition_position[of "decode_finite_environment E" "fst d" "snd d"] by simp
  show ?thesis using position
    by (auto simp: step finite_environment_positions_correct finite_native_definition_readings_correct)
qed

lemma finite_native_definition_rows_decoded:
  fixes E :: "'u finite_artifact_environment"
  shows "map_relation_values decode_finite_definition (fset (finite_native_definition_rows E)) =
    {(d,p,C). native_definition_at (decode_finite_environment E) (fst d) (snd d) p C}"
proof -
  have complete: "\<And>d p C. native_definition_at (decode_finite_environment E) (fst d) (snd d) p C
      \<Longrightarrow> \<exists>q F. (d,q,F) |\<in>| finite_native_definition_rows E \<and>
        decode_finite_pattern q=p \<and> map_relation_values decode_finite_schema (fset F)=C"
    using finite_native_definition_readings_complete
    by (metis finite_native_definition_readings_correct finite_native_definition_rows_correct)
  have pointwise: "(d,p,C) \<in> map_relation_values decode_finite_definition
      (fset (finite_native_definition_rows E)) \<longleftrightarrow>
      native_definition_at (decode_finite_environment E) (fst d) (snd d) p C" for d p C
  proof
    assume member: "(d,p,C) \<in> map_relation_values decode_finite_definition
      (fset (finite_native_definition_rows E))"
    obtain q F where row: "(d,q,F) |\<in>| finite_native_definition_rows E"
      and represented: "p=decode_finite_pattern q" "C=map_relation_values decode_finite_schema (fset F)"
      using member by (auto simp: decode_finite_definition_def split_paired_Ex)
    show "native_definition_at (decode_finite_environment E) (fst d) (snd d) p C"
      using row represented by (simp add: finite_native_definition_rows_correct)
  next
    assume read: "native_definition_at (decode_finite_environment E) (fst d) (snd d) p C"
    obtain q F where row: "(d,q,F) |\<in>| finite_native_definition_rows E"
      and represented: "decode_finite_pattern q=p" "map_relation_values decode_finite_schema (fset F)=C"
      using complete[OF read] by blast
    have mapped: "(d,decode_finite_definition (q,F)) \<in>
        map_relation_values decode_finite_definition (fset (finite_native_definition_rows E))"
      using row by auto
    show "(d,p,C) \<in> map_relation_values decode_finite_definition (fset (finite_native_definition_rows E))"
      using mapped represented by (simp add: decode_finite_definition_def)
  qed
  show ?thesis
  proof (rule set_eqI)
    fix x :: "'u definition_site \<times> (local_address term_pattern \<times> (local_address \<times> 'u native_schema) set)"
    obtain d p C where shape: "x=(d,p,C)" by (cases x) auto
    show "(x \<in> map_relation_values decode_finite_definition (fset (finite_native_definition_rows E))) =
        (x \<in> {(d,p,C). native_definition_at (decode_finite_environment E) (fst d) (snd d) p C})"
      by (simp only: shape pointwise mem_Collect_eq prod.case)
  qed
qed

section \<open>The roots and recovered callees determine the complete program\<close>

definition finite_native_definition_edges ::
  "'u finite_artifact_environment \<Rightarrow> ('u definition_site \<times> 'u definition_site) fset" where
  "finite_native_definition_edges E = ffUnion (fimage (\<lambda>(d,p,F).
    ffUnion (fimage (\<lambda>(c,S). fimage (Pair d) (finite_schema_dependencies S)) F))
      (finite_native_definition_rows E))"

lemma finite_native_definition_edges_member:
  "(d,e) |\<in>| finite_native_definition_edges E \<longleftrightarrow>
    (\<exists>p F c S. (d,p,F) |\<in>| finite_native_definition_rows E \<and>
      (c,S) |\<in>| F \<and> e |\<in>| finite_schema_dependencies S)"
proof
  assume member: "(d,e) |\<in>| finite_native_definition_edges E"
  show "\<exists>p F c S. (d,p,F) |\<in>| finite_native_definition_rows E \<and>
      (c,S) |\<in>| F \<and> e |\<in>| finite_schema_dependencies S"
    using member by (auto simp: finite_native_definition_edges_def finite_union_image_member finite_image_member)
next
  assume "\<exists>p F c S. (d,p,F) |\<in>| finite_native_definition_rows E \<and>
      (c,S) |\<in>| F \<and> e |\<in>| finite_schema_dependencies S"
  then obtain p F c S where row: "(d,p,F) |\<in>| finite_native_definition_rows E"
    and clause: "(c,S) |\<in>| F" and dep: "e |\<in>| finite_schema_dependencies S" by blast
  have inner: "(d,e) |\<in>| fimage (Pair d) (finite_schema_dependencies S)"
    using dep by (auto simp: finite_image_member)
  have middle: "(d,e) |\<in>| ffUnion (fimage (\<lambda>(c,S). fimage (Pair d) (finite_schema_dependencies S)) F)"
    by (rule iffD2[OF finite_union_image_member], rule exI[of _ "(c,S)"])
      (use clause inner in simp)
  show "(d,e) |\<in>| finite_native_definition_edges E"
    unfolding finite_native_definition_edges_def
    by (rule iffD2[OF finite_union_image_member], rule exI[of _ "(d,p,F)"])
      (use row middle in simp)
qed

theorem finite_native_definition_edges_correct:
  "fset (finite_native_definition_edges E) = native_definition_edges (decode_finite_environment E)"
proof -
  have pointwise: "(d,e) |\<in>| finite_native_definition_edges E \<longleftrightarrow>
      (d,e) \<in> native_definition_edges (decode_finite_environment E)" for d e
  proof
    assume member: "(d,e) |\<in>| finite_native_definition_edges E"
    obtain p F c S where row: "(d,p,F) |\<in>| finite_native_definition_rows E"
      and clause: "(c,S) |\<in>| F" and dep: "e |\<in>| finite_schema_dependencies S"
      using member by (simp only: finite_native_definition_edges_member; blast)
    have read: "native_definition_at (decode_finite_environment E) (fst d) (snd d)
        (decode_finite_pattern p) (map_relation_values decode_finite_schema (fset F))"
      using row by (simp add: finite_native_definition_rows_correct)
    have decoded_clause: "(c,decode_finite_schema S) \<in> map_relation_values decode_finite_schema (fset F)"
      using clause by auto
    have dependency: "e \<in> schema_dependencies (decode_finite_schema S)"
      using dep by (simp add: finite_schema_dependencies_correct)
    show "(d,e) \<in> native_definition_edges (decode_finite_environment E)"
      using read decoded_clause dependency unfolding native_definition_edges_def by blast
  next
    assume edge: "(d,e) \<in> native_definition_edges (decode_finite_environment E)"
    obtain p C c S where read: "native_definition_at (decode_finite_environment E) (fst d) (snd d) p C"
      and clause: "(c,S) \<in> C" and dep: "e \<in> schema_dependencies S"
      using edge by (auto simp: native_definition_edges_def)
    obtain q F where row: "(q,F) |\<in>| finite_native_definition_readings E (fst d) (snd d)"
      and represented: "map_relation_values decode_finite_schema (fset F)=C"
      using finite_native_definition_readings_complete[OF read] by blast
    obtain T where actual: "(c,T) |\<in>| F" and schema: "decode_finite_schema T=S"
      using clause represented by auto
    show "(d,e) |\<in>| finite_native_definition_edges E"
      unfolding finite_native_definition_edges_member
      apply (rule exI[of _ q], rule exI[of _ F], rule exI[of _ c], rule exI[of _ T])
      using row actual dep schema
      by (simp add: finite_native_definition_rows_correct finite_native_definition_readings_correct
          finite_schema_dependencies_correct)
  qed
  show ?thesis using pointwise by auto
qed

definition finite_native_definition_sites ::
  "'u finite_artifact_environment \<Rightarrow> 'u definition_site fset \<Rightarrow> 'u definition_site fset" where
  "finite_native_definition_sites E roots = roots |\<union>|
    fimage snd (ffilter (\<lambda>(d,e). d |\<in>| roots)
      (finite_edge_closure (finite_native_definition_edges E)))"

theorem finite_native_definition_sites_correct:
  "fset (finite_native_definition_sites E roots) =
    native_definition_sites (decode_finite_environment E) (fset roots)"
  by (auto simp: finite_native_definition_sites_def finite_image_member finite_edge_closure_correct
      finite_native_definition_edges_correct native_definition_sites_def rtrancl_eq_or_trancl
      split: prod.splits; force)

lemma finite_native_definition_readings_nonempty:
  "finite_native_definition_readings E u r \<noteq> {||} \<longleftrightarrow>
    (\<exists>p C. native_definition_at (decode_finite_environment E) u r p C)"
proof
  assume nonempty: "finite_native_definition_readings E u r \<noteq> {||}"
  obtain q F where member: "(q,F) |\<in>| finite_native_definition_readings E u r"
    using nonempty by (auto simp: fset_inject[symmetric])
  show "\<exists>p C. native_definition_at (decode_finite_environment E) u r p C"
    using member by (auto simp: finite_native_definition_readings_correct)
next
  assume "\<exists>p C. native_definition_at (decode_finite_environment E) u r p C"
  then obtain p C where read: "native_definition_at (decode_finite_environment E) u r p C" by blast
  obtain q F where member: "(q,F) |\<in>| finite_native_definition_readings E u r"
    using finite_native_definition_readings_complete[OF read] by blast
  show "finite_native_definition_readings E u r \<noteq> {||}" using member by auto
qed

definition finite_native_package_formed ::
  "'u finite_artifact_environment \<Rightarrow> 'u definition_site fset \<Rightarrow> bool" where
  "finite_native_package_formed E roots \<longleftrightarrow> finite_environment_formed E \<and>
    fBall (finite_native_definition_sites E roots)
      (\<lambda>d. finite_native_definition_readings E (fst d) (snd d) \<noteq> {||})"

theorem finite_native_package_formed_correct:
  "finite_native_package_formed E roots \<longleftrightarrow>
    native_package_formed (decode_finite_environment E) (fset roots)"
  by (simp add: finite_native_package_formed_def native_package_formed_def
      finite_environment_formed_correct finite_native_definition_sites_correct
      finite_native_definition_readings_nonempty)

definition finite_native_definition_graph ::
  "'u finite_artifact_environment \<Rightarrow> 'u definition_site fset \<Rightarrow>
    ('u definition_site \<times> 'u finite_native_definition) fset" where
  "finite_native_definition_graph E roots =
    ffilter (\<lambda>(d,p,F). d |\<in>| finite_native_definition_sites E roots) (finite_native_definition_rows E)"

lemma finite_native_definition_graph_decoded:
  "map_relation_values decode_finite_definition (fset (finite_native_definition_graph E roots)) =
    native_definition_graph (decode_finite_environment E) (fset roots)"
proof -
  have restricted: "map_relation_values decode_finite_definition (fset (finite_native_definition_graph E roots)) =
      {(d,q)\<in>map_relation_values decode_finite_definition (fset (finite_native_definition_rows E)).
        d \<in> native_definition_sites (decode_finite_environment E) (fset roots)}"
    by (auto simp: finite_native_definition_graph_def finite_native_definition_sites_correct
        split_paired_Ex split: prod.splits)
  show ?thesis by (auto simp: restricted finite_native_definition_rows_decoded native_definition_graph_def
      split: prod.splits)
qed

type_synonym 'u finite_native_system =
  "(local_address,local_address,'u definition_site,local_address) finite_schema_system"

definition finite_native_program ::
  "'u finite_artifact_environment \<Rightarrow> 'u definition_site fset \<Rightarrow> 'u finite_native_system" where
  "finite_native_program E roots =
    (let G=finite_native_definition_graph E roots in
      \<lparr>finite_system_interfaces=fimage (\<lambda>(d,p,F). (d,p)) G,
       finite_system_clauses=ffUnion (fimage (\<lambda>(d,p,F). fimage (\<lambda>(c,S). ((d,c),S)) F) G)\<rparr>)"

lemma finite_native_program_fields:
  "finite_system_interfaces (finite_native_program E roots) =
    fimage (\<lambda>(d,p,F). (d,p)) (finite_native_definition_graph E roots)"
  "finite_system_clauses (finite_native_program E roots) =
    ffUnion (fimage (\<lambda>(d,p,F). fimage (\<lambda>(c,S). ((d,c),S)) F)
      (finite_native_definition_graph E roots))"
  by (simp_all add: finite_native_program_def Let_def)

theorem finite_native_program_correct:
  fixes E :: "'u finite_artifact_environment"
  shows "decode_finite_system (finite_native_program E roots) =
    native_program (decode_finite_environment E) (fset roots)"
proof -
  let ?G = "finite_native_definition_graph E roots"
  have graph: "(d,p,C) \<in> native_definition_graph (decode_finite_environment E) (fset roots) \<longleftrightarrow>
      (\<exists>q F. (d,q,F) |\<in>| ?G \<and> p=decode_finite_pattern q \<and>
        C=map_relation_values decode_finite_schema (fset F))" for d p C
    by (simp only: finite_native_definition_graph_decoded[symmetric] map_relation_values_member
        split_paired_Ex decode_finite_definition_def fst_conv snd_conv prod.inject; blast)
  have interfaces: "(d,p) \<in> system_interfaces (decode_finite_system (finite_native_program E roots)) \<longleftrightarrow>
      (\<exists>q F. (d,q,F) |\<in>| ?G \<and> p=decode_finite_pattern q)" for d p
    by (cases d; simp only: decode_finite_system_fields finite_native_program_fields map_relation_values_member
        finite_image_member split_paired_Ex prod.case prod.inject; blast)
  have clauses: "((d,c),S) \<in> system_clauses (decode_finite_system (finite_native_program E roots)) \<longleftrightarrow>
      (\<exists>q F T. (d,q,F) |\<in>| ?G \<and> (c,T) |\<in>| F \<and> S=decode_finite_schema T)" for d c S
    by (cases d; simp only: decode_finite_system_fields finite_native_program_fields map_relation_values_member
        finite_union_image_member finite_image_member split_paired_Ex prod.case prod.inject; blast)
  have interface_eq: "((d,p) \<in> system_interfaces (decode_finite_system (finite_native_program E roots))) =
      ((d,p) \<in> system_interfaces (native_program (decode_finite_environment E) (fset roots)))" for d p
    by (simp only: interfaces native_program_interfaces graph; blast)
  have clause_eq: "(((d,c),S) \<in> system_clauses (decode_finite_system (finite_native_program E roots))) =
      (((d,c),S) \<in> system_clauses (native_program (decode_finite_environment E) (fset roots)))" for d c S
  proof
    assume member: "((d,c),S) \<in> system_clauses (decode_finite_system (finite_native_program E roots))"
    obtain q F T where row: "(d,q,F) |\<in>| ?G" and clause: "(c,T) |\<in>| F"
      and represented: "S=decode_finite_schema T"
      using member by (simp only: clauses; blast)
    have decoded_row: "(d,decode_finite_pattern q,map_relation_values decode_finite_schema (fset F)) \<in>
        native_definition_graph (decode_finite_environment E) (fset roots)"
      using row by (simp only: graph; blast)
    have decoded_clause: "(c,S) \<in> map_relation_values decode_finite_schema (fset F)"
      using clause represented by auto
    show "((d,c),S) \<in> system_clauses (native_program (decode_finite_environment E) (fset roots))"
      unfolding native_program_clauses
      by (rule exI[of _ "decode_finite_pattern q"],
          rule exI[of _ "map_relation_values decode_finite_schema (fset F)"])
        (use decoded_row decoded_clause in blast)
  next
    assume member: "((d,c),S) \<in> system_clauses (native_program (decode_finite_environment E) (fset roots))"
    obtain p C where old_row: "(d,p,C) \<in> native_definition_graph (decode_finite_environment E) (fset roots)"
      and old_clause: "(c,S) \<in> C" using member by (simp only: native_program_clauses; blast)
    obtain q F where row: "(d,q,F) |\<in>| ?G" and represented: "C=map_relation_values decode_finite_schema (fset F)"
      using old_row by (simp only: graph; blast)
    obtain T where clause: "(c,T) |\<in>| F" and schema: "S=decode_finite_schema T"
      using old_clause represented by auto
    show "((d,c),S) \<in> system_clauses (decode_finite_system (finite_native_program E roots))"
      unfolding clauses
      by (rule exI[of _ q], rule exI[of _ F], rule exI[of _ T]) (use row clause schema in blast)
  qed
  show ?thesis
  proof (rule schema_system.equality)
    show "system_interfaces (decode_finite_system (finite_native_program E roots)) =
        system_interfaces (native_program (decode_finite_environment E) (fset roots))"
    proof (rule set_eqI)
      fix x :: "'u definition_site \<times> local_address term_pattern"
      obtain d p where shape: "x=(d,p)" by (cases x) auto
      show "(x \<in> system_interfaces (decode_finite_system (finite_native_program E roots))) =
          (x \<in> system_interfaces (native_program (decode_finite_environment E) (fset roots)))"
        by (simp only: shape interface_eq)
    qed
    show "system_clauses (decode_finite_system (finite_native_program E roots)) =
        system_clauses (native_program (decode_finite_environment E) (fset roots))"
    proof (rule set_eqI)
      fix x :: "('u definition_site \<times> local_address) \<times> 'u native_schema"
      obtain d c S where shape: "x=((d,c),S)" by (cases x) auto
      show "(x \<in> system_clauses (decode_finite_system (finite_native_program E roots))) =
          (x \<in> system_clauses (native_program (decode_finite_environment E) (fset roots)))"
        by (simp only: shape clause_eq)
    qed
    show "schema_system.more (decode_finite_system (finite_native_program E roots)) =
        schema_system.more (native_program (decode_finite_environment E) (fset roots))" by simp
  qed
qed

corollary finite_native_program_formed:
  assumes "finite_native_package_formed E roots"
  shows "finite_system_formed (finite_native_program E roots)"
  using native_program_formed[of "decode_finite_environment E" "fset roots"] assms
  by (simp add: finite_system_formed_correct finite_native_program_correct finite_native_package_formed_correct)

section \<open>The native citation family supplies the roots\<close>

definition finite_located_values ::
  "'u finite_artifact_environment \<Rightarrow> 'u \<Rightarrow> local_address \<Rightarrow> 'u definition_site fset" where
  "finite_located_values E u r = ffUnion (fimage (\<lambda>C.
    finite_reading_values (finite_location_readings E u C r)) (finite_artifacts_at E u))"

theorem finite_located_values_correct:
  "d |\<in>| finite_located_values E u r \<longleftrightarrow>
    located_at (decode_finite_environment E) u r (fst d) (snd d)"
proof
  assume member: "d |\<in>| finite_located_values E u r"
  show "located_at (decode_finite_environment E) u r (fst d) (snd d)"
    using member
    by (auto simp: finite_located_values_def finite_union_image_member finite_reading_values_member
        finite_location_readings_member located_at_def finite_artifacts_at_member; blast)
next
  assume location: "located_at (decode_finite_environment E) u r (fst d) (snd d)"
  obtain C c I where source: "C |\<in>| finite_artifacts_at E u"
    and citation: "citation_at (decode_finite_object C) r c I"
    and target: "citation_location (decode_finite_environment E) u c (fst d) (snd d)"
    using location by (auto simp: located_at_def finite_artifacts_at_member)
  obtain F where represented: "fset F=I" using finite_citation_candidates_complete[OF citation] by blast
  have read: "(d,F,finite_citation_slots c) |\<in>| finite_location_readings E u C r"
    using citation target represented by (auto simp: finite_location_readings_member)
  show "d |\<in>| finite_located_values E u r"
    using source read
    by (auto simp: finite_located_values_def finite_union_image_member finite_reading_values_member)
qed

definition finite_native_root_family_readings ::
  "'u finite_artifact_environment \<Rightarrow> 'u \<Rightarrow> local_address \<Rightarrow>
    (local_address \<times> 'u definition_site) fset fset" where
  "finite_native_root_family_readings E u r = finite_family_readings E u r (finite_located_values E u)"

theorem finite_native_root_family_readings_correct:
  "Q |\<in>| finite_native_root_family_readings E u r \<longleftrightarrow>
    native_root_family_at (decode_finite_environment E) u r (fset Q)"
proof (cases "finite_environment_formed E")
  case False
  then show ?thesis
    by (simp add: finite_native_root_family_readings_def finite_family_readings_def
        native_root_family_at_def finite_environment_formed_correct[symmetric])
next
  case True
  have ef: "environment_formed (decode_finite_environment E)"
    using True by (simp add: finite_environment_formed_correct)
  have unique: "\<And>a d e. located_at (decode_finite_environment E) u a (fst d) (snd d) \<Longrightarrow>
      located_at (decode_finite_environment E) u a (fst e) (snd e) \<Longrightarrow> d=e"
    using located_at_unique[OF ef] by (metis prod.expand)
  have correct: "\<And>a d. d |\<in>| finite_located_values E u a \<longleftrightarrow>
      located_at (decode_finite_environment E) u a (fst (id d)) (snd (id d))"
    by (simp add: finite_located_values_correct)
  have identity: "map_relation_values id (fset Q)=fset Q" by (auto simp: map_relation_values_def)
  show ?thesis
    by (simp only: finite_native_root_family_readings_def
        finite_family_readings_correct[OF inj_on_id correct unique] identity native_root_family_at_def)
qed

theorem finite_native_root_family_readings_complete:
  assumes read: "native_root_family_at (decode_finite_environment E) u r Q"
  shows "\<exists>F. F |\<in>| finite_native_root_family_readings E u r \<and> fset F=Q"
proof -
  have finite: "finite Q" using native_root_family_formed[OF read] by blast
  have represented: "fset (Abs_fset Q)=Q" by (rule Abs_fset_inverse) (simp add: finite)
  show ?thesis by (rule exI[of _ "Abs_fset Q"])
    (use read represented in \<open>simp add: finite_native_root_family_readings_correct\<close>)
qed

corollary finite_native_root_family_readings_unique:
  assumes "Q |\<in>| finite_native_root_family_readings E u r"
    "F |\<in>| finite_native_root_family_readings E u r"
  shows "Q=F"
  using assms native_root_family_unique
  by (metis finite_native_root_family_readings_correct fset_inject)

definition finite_native_package_readings ::
  "'u finite_artifact_environment \<Rightarrow> 'u \<Rightarrow> local_address \<Rightarrow> 'u finite_native_system fset" where
  "finite_native_package_readings E u r = ffUnion (fimage (\<lambda>Q.
    if finite_native_package_formed E (fimage snd Q)
    then {|finite_native_program E (fimage snd Q)|} else {||}) (finite_native_root_family_readings E u r))"

lemma finite_native_package_readings_step:
  "P |\<in>| finite_native_package_readings E u r \<longleftrightarrow>
    (\<exists>Q. Q |\<in>| finite_native_root_family_readings E u r \<and>
      finite_native_package_formed E (fimage snd Q) \<and> P=finite_native_program E (fimage snd Q))"
  by (auto simp: finite_native_package_readings_def finite_union_image_member finite_singleton_when_member)

theorem finite_native_package_readings_correct:
  "P |\<in>| finite_native_package_readings E u r \<longleftrightarrow>
    native_package_at (decode_finite_environment E) u r (decode_finite_system P)"
proof
  assume member: "P |\<in>| finite_native_package_readings E u r"
  obtain Q where roots: "Q |\<in>| finite_native_root_family_readings E u r"
    and formed: "finite_native_package_formed E (fimage snd Q)"
    and prog: "P=finite_native_program E (fimage snd Q)"
    using member by (simp only: finite_native_package_readings_step; blast)
  show "native_package_at (decode_finite_environment E) u r (decode_finite_system P)"
    unfolding native_package_at_def
    by (rule exI[of _ "fset Q"])
      (use roots formed prog in \<open>simp add: finite_native_root_family_readings_correct
        finite_native_package_formed_correct finite_native_program_correct fimage.rep_eq rel_ran_image\<close>)
next
  assume read: "native_package_at (decode_finite_environment E) u r (decode_finite_system P)"
  obtain Q where roots: "native_root_family_at (decode_finite_environment E) u r Q"
    and formed: "native_package_formed (decode_finite_environment E) (rel_ran Q)"
    and prog: "decode_finite_system P=native_program (decode_finite_environment E) (rel_ran Q)"
    using read by (auto simp: native_package_at_def)
  obtain F where family: "F |\<in>| finite_native_root_family_readings E u r" and represented: "fset F=Q"
    using finite_native_root_family_readings_complete[OF roots] by blast
  have range: "fset (fimage snd F)=rel_ran Q" by (simp add: fimage.rep_eq represented rel_ran_image)
  have ef: "finite_native_package_formed E (fimage snd F)"
    using formed range by (simp add: finite_native_package_formed_correct)
  have decoded: "decode_finite_system P=decode_finite_system (finite_native_program E (fimage snd F))"
    using prog range by (simp add: finite_native_program_correct)
  have same: "P=finite_native_program E (fimage snd F)" using decoded by simp
  show "P |\<in>| finite_native_package_readings E u r"
    unfolding finite_native_package_readings_step
    by (rule exI[of _ F]) (use family ef same in blast)
qed

theorem finite_native_package_readings_complete:
  assumes read: "native_package_at (decode_finite_environment E) u r P"
  shows "\<exists>F. F |\<in>| finite_native_package_readings E u r \<and> decode_finite_system F=P"
proof -
  have formed: "schema_system_formed P" by (rule native_package_system_formed[OF read])
  have represented: "decode_finite_system (finite_system_of P)=P" by (rule decode_finite_system_of[OF formed])
  show ?thesis by (rule exI[of _ "finite_system_of P"])
    (use read represented in \<open>simp add: finite_native_package_readings_correct\<close>)
qed

corollary finite_native_package_readings_unique:
  assumes "P |\<in>| finite_native_package_readings E u r"
    "Q |\<in>| finite_native_package_readings E u r"
  shows "P=Q"
  using assms native_package_unique
  by (metis finite_native_package_readings_correct decode_finite_system_injective)

