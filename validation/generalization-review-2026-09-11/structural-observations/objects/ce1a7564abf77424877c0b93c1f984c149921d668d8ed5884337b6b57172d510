theory Factor_Executable_Quotation
  imports "Native_Investigation_Report_Diagnostic_finitepresenters19.RRA_Executable_Citations" "Native_Investigation_Report_Diagnostic_finitepresenters19.RRA_Executable_Records" "Native_Investigation_Report_Diagnostic_finitepresenters19.Factor_Executable_Terms" "Native_Investigation_Report_Diagnostic_finitepresenters19.Factor_Quotation" "Finite_Set_Composition"
begin

section \<open>The represented interior bounds recursive quotation\<close>

fun factor_term_depth :: "factor_term \<Rightarrow> nat" where
  "factor_term_depth (Target_Term t) = 1"
| "factor_term_depth (Payload_Term v) = 1"
| "factor_term_depth (Pair_Term x y) = Suc (max (factor_term_depth x) (factor_term_depth y))"

lemma factor_term_depth_positive: "0 < factor_term_depth t"
  by (cases t) simp_all

lemma term_quoted_depth_interior:
  assumes "term_quoted_at E u r t I K"
  shows "factor_term_depth t \<le> card I"
  using assms
proof (induction rule: term_quoted_at.induct)
  case (target u R r c I t)
  have finite: "finite I" and root: "r \<in> I"
    using target.hyps(3) raw_citation_interior by (auto simp: citation_at_def)
  have "0 < card I" using finite root by (auto simp: card_gt_0_iff)
  then show ?case by simp
next
  case (pair u R r ps l q x L A y Q B)
  let ?I = "insert r (set ps \<union> L \<union> Q)"
  have finite: "finite ?I" using term_quoted_finite[OF pair.hyps(4)]
    term_quoted_finite[OF pair.hyps(5)] by simp
  have left: "L \<subset> ?I" and right: "Q \<subset> ?I" using pair.hyps(6) by blast+
  have lc: "card L < card ?I" by (rule psubset_card_mono[OF finite left])
  have rc: "card Q < card ?I" by (rule psubset_card_mono[OF finite right])
  show ?case using pair.IH lc rc by (simp add: max_def; arith)
next
  case (payload u R r v)
  show ?case by simp
qed

lemma term_quoted_depth_carrier:
  assumes quote: "term_quoted_at (decode_finite_environment E) u r t I K"
    and source: "C |\<in>| finite_artifacts_at E u"
  shows "factor_term_depth t \<le> fcard (finite_carrier (finite_structure C))"
proof -
  have art: "artifact_at (decode_finite_environment E) u (decode_finite_object C)"
    using source by (simp add: finite_artifacts_at_member)
  have subset: "I \<subseteq> fset (finite_carrier (finite_structure C))"
    using term_quoted_carrier[OF quote art] by auto
  have "card I \<le> card (fset (finite_carrier (finite_structure C)))"
    by (rule card_mono) (simp_all add: subset)
  then show ?thesis using term_quoted_depth_interior[OF quote] by (simp add: fcard.rep_eq)
qed

section \<open>Finite composition of explicit quotation boundaries\<close>

type_synonym 'a finite_syntax_reading = "'a \<times> local_address fset \<times> local_address fset"

definition finite_join_readings ::
  "('a \<Rightarrow> 'b \<Rightarrow> 'c) \<Rightarrow> local_address fset \<Rightarrow> local_address \<Rightarrow>
    local_address list \<Rightarrow> 'a finite_syntax_reading fset \<Rightarrow>
    'b finite_syntax_reading fset \<Rightarrow> 'c finite_syntax_reading fset" where
  "finite_join_readings f V r ps X Y = ffUnion (fimage (\<lambda>(x,L,A).
    ffUnion (fimage (\<lambda>(y,Q,B).
      let F=finsert r (fset_of_list ps); I=F |\<union>| L |\<union>| Q; K=A |\<union>| B in
      if F |\<inter>| (L |\<union>| Q)={||} \<and> L |\<inter>| Q={||} \<and>
          I |\<inter>| (K |\<union>| V)={||}
      then {|(f x y,I,K)|} else {||}) Y)) X)"

lemma finite_join_readings_member:
  "(t,I,K) |\<in>| finite_join_readings f V r ps X Y \<longleftrightarrow>
    (\<exists>x L A y Q B. (x,L,A) |\<in>| X \<and> (y,Q,B) |\<in>| Y \<and> t=f x y \<and>
      I=finsert r (fset_of_list ps |\<union>| L |\<union>| Q) \<and> K=A |\<union>| B \<and>
      finsert r (fset_of_list ps) |\<inter>| (L |\<union>| Q)={||} \<and>
      L |\<inter>| Q={||} \<and> I |\<inter>| (K |\<union>| V)={||})"
proof -
  let ?F = "finsert r (fset_of_list ps)"
  let ?step = "\<lambda>x L A y Q B.
    if ?F |\<inter>| (L |\<union>| Q)={||} \<and> L |\<inter>| Q={||} \<and>
        (?F |\<union>| L |\<union>| Q) |\<inter>| (A |\<union>| B |\<union>| V)={||}
    then {|(f x y,?F |\<union>| L |\<union>| Q,A |\<union>| B)|} else {||}"
  have expanded: "finite_join_readings f V r ps X Y =
    ffUnion (fimage (\<lambda>(x,L,A). ffUnion (fimage (\<lambda>(y,Q,B). ?step x L A y Q B) Y)) X)"
    by (simp add: finite_join_readings_def Let_def)
  show ?thesis
  proof
    assume member: "(t,I,K) |\<in>| finite_join_readings f V r ps X Y"
    obtain x L A y Q B where left: "(x,L,A) |\<in>| X" and right: "(y,Q,B) |\<in>| Y"
      and row: "(t,I,K) |\<in>| ?step x L A y Q B"
      using member by (simp only: expanded finite_union_image_member split_paired_Ex prod.case; blast)
    have fields: "t=f x y" "I=finsert r (fset_of_list ps |\<union>| L |\<union>| Q)"
      "K=A |\<union>| B" "?F |\<inter>| (L |\<union>| Q)={||}"
      "L |\<inter>| Q={||}" "I |\<inter>| (K |\<union>| V)={||}"
      using row by (auto split: if_splits)
    show "\<exists>x L A y Q B. (x,L,A) |\<in>| X \<and> (y,Q,B) |\<in>| Y \<and> t=f x y \<and>
      I=finsert r (fset_of_list ps |\<union>| L |\<union>| Q) \<and> K=A |\<union>| B \<and>
      ?F |\<inter>| (L |\<union>| Q)={||} \<and> L |\<inter>| Q={||} \<and> I |\<inter>| (K |\<union>| V)={||}"
      by (rule exI[of _ x], rule exI[of _ L], rule exI[of _ A],
          rule exI[of _ y], rule exI[of _ Q], rule exI[of _ B])
         (use left right fields in blast)
  next
    assume read: "\<exists>x L A y Q B. (x,L,A) |\<in>| X \<and> (y,Q,B) |\<in>| Y \<and> t=f x y \<and>
      I=finsert r (fset_of_list ps |\<union>| L |\<union>| Q) \<and> K=A |\<union>| B \<and>
      ?F |\<inter>| (L |\<union>| Q)={||} \<and> L |\<inter>| Q={||} \<and> I |\<inter>| (K |\<union>| V)={||}"
    obtain x L A y Q B where left: "(x,L,A) |\<in>| X" and right: "(y,Q,B) |\<in>| Y"
      and fields: "t=f x y" "I=finsert r (fset_of_list ps |\<union>| L |\<union>| Q)"
        "K=A |\<union>| B" "?F |\<inter>| (L |\<union>| Q)={||}"
        "L |\<inter>| Q={||}" "I |\<inter>| (K |\<union>| V)={||}"
      using read by auto
    have row: "(t,I,K) |\<in>| ?step x L A y Q B" using fields by simp
    show "(t,I,K) |\<in>| finite_join_readings f V r ps X Y"
      unfolding expanded
      apply (simp only: finite_union_image_member)
      apply (rule exI[of _ "(x,L,A)"])
      apply (simp only: prod.case)
      apply (rule conjI[OF left])
      apply (simp only: finite_union_image_member)
      apply (rule exI[of _ "(y,Q,B)"])
      using right row by simp
  qed
qed

definition finite_two_field_record ::
  "finite_exact_artifact \<Rightarrow> local_address \<Rightarrow>
    (local_address list \<Rightarrow> local_address \<Rightarrow> local_address \<Rightarrow> 'a fset) \<Rightarrow> 'a fset" where
  "finite_two_field_record C r F = ffUnion (fimage (\<lambda>(ps,xs).
    case xs of [l,q] \<Rightarrow> F ps l q
      | _ \<Rightarrow> {||}) (finite_record_candidates C r 2))"

lemma finite_two_field_record_member:
  "z |\<in>| finite_two_field_record C r F \<longleftrightarrow>
    (\<exists>ps l q. record_at (decode_finite_object C) r ps [l,q] \<and>
      z |\<in>| F ps l q)"
proof
  assume member: "z |\<in>| finite_two_field_record C r F"
  obtain ps xs where listed: "(ps,xs) |\<in>| finite_record_candidates C r 2"
    and branch: "z |\<in>| (case xs of [l,q] \<Rightarrow>
      F ps l q | _ \<Rightarrow> {||})"
    using member by (simp only: finite_two_field_record_def finite_union_image_member
        split_paired_Ex prod.case; blast)
  have len: "length xs=2" using listed by (simp add: finite_record_candidates_correct)
  obtain l q where shape: "xs=[l,q]" using len by (auto simp: length_Suc_conv numeral_2_eq_2)
  have rec: "record_at (decode_finite_object C) r ps [l,q]"
    using listed shape by (simp add: finite_record_candidates_correct)
  have joined: "z |\<in>| F ps l q"
    using branch shape by simp
  show "\<exists>ps l q. record_at (decode_finite_object C) r ps [l,q] \<and>
    z |\<in>| F ps l q"
    using rec joined by blast
next
  assume read: "\<exists>ps l q. record_at (decode_finite_object C) r ps [l,q] \<and>
    z |\<in>| F ps l q"
  obtain ps l q where rec: "record_at (decode_finite_object C) r ps [l,q]"
    and joined: "z |\<in>| F ps l q"
    using read by blast
  have listed: "(ps,[l,q]) |\<in>| finite_record_candidates C r 2"
    using rec by (simp add: finite_record_candidates_correct)
  show "z |\<in>| finite_two_field_record C r F"
    unfolding finite_two_field_record_def finite_union_image_member
    by (rule exI[of _ "(ps,[l,q])"]) (simp add: listed joined)
qed

definition finite_record_readings ::
  "finite_exact_artifact \<Rightarrow> local_address \<Rightarrow> ('a \<Rightarrow> 'a \<Rightarrow> 'a) \<Rightarrow>
    local_address fset \<Rightarrow> (local_address \<Rightarrow> 'a finite_syntax_reading fset) \<Rightarrow>
    'a finite_syntax_reading fset" where
  "finite_record_readings C r f V reads = finite_two_field_record C r
    (\<lambda>ps l q. finite_join_readings f V r ps (reads l) (reads q))"

lemma finite_record_readings_member:
  "(t,I,K) |\<in>| finite_record_readings C r f V reads \<longleftrightarrow>
    (\<exists>ps l q. record_at (decode_finite_object C) r ps [l,q] \<and>
      (t,I,K) |\<in>| finite_join_readings f V r ps (reads l) (reads q))"
  by (simp only: finite_record_readings_def finite_two_field_record_member)

section \<open>Leaves read actual payloads and external citation values\<close>

definition finite_target_readings ::
  "'u finite_artifact_environment \<Rightarrow> 'u \<Rightarrow> finite_exact_artifact \<Rightarrow>
    local_address \<Rightarrow> finite_factor_term finite_syntax_reading fset" where
  "finite_target_readings E u C r = ffUnion (fimage (\<lambda>(c,I).
    if finite_citation_slots c={||} then {||}
    else fimage (\<lambda>T. (Finite_Target T,I,finite_citation_slots c)) (finite_citation_targets E u c))
      (finite_citation_candidates C r))"

lemma finite_target_readings_member:
  "(t,I,K) |\<in>| finite_target_readings E u C r \<longleftrightarrow>
    (\<exists>c T. t=Finite_Target T \<and> citation_at (decode_finite_object C) r c (fset I) \<and>
      citation_slots c \<noteq> {} \<and>
      interpret_citation (decode_finite_environment E) u c (decode_finite_target T) \<and>
      K=finite_citation_slots c)"
proof -
  have slots: "finite_citation_slots c={||} \<longleftrightarrow> citation_slots c={}" for c
    by (simp only: fset_inject[symmetric] bot_fset.rep_eq finite_citation_slots_correct)
  show ?thesis
    by (simp only: finite_target_readings_def finite_union_image_member split_paired_Ex prod.case
        finite_unless_member finite_image_member prod.inject finite_citation_candidates_correct
        finite_citation_targets_member slots; auto; blast)
qed

definition finite_payload_readings ::
  "finite_exact_artifact \<Rightarrow> local_address \<Rightarrow> finite_factor_term finite_syntax_reading fset" where
  "finite_payload_readings C r = fimage (\<lambda>v. (Finite_Payload v,{|r|},{||}))
    (ffilter (finite_payload_leaf_at C r) (finite_payload_values C r))"

lemma finite_payload_readings_member:
  "(t,I,K) |\<in>| finite_payload_readings C r \<longleftrightarrow>
    (\<exists>v. t=Finite_Payload v \<and> payload_leaf_at (decode_finite_object C) r v \<and>
      I={|r|} \<and> K={||})"
proof -
  have actual: "\<And>v. finite_payload_leaf_at C r v \<Longrightarrow> v |\<in>| finite_payload_values C r"
    by (auto simp: finite_payload_leaf_at_def intro: finite_payload_at_has_value)
  show ?thesis using actual
    by (auto simp: finite_payload_readings_def fimage.rep_eq finite_payload_leaf_at_correct[symmetric])
qed

section \<open>Recursive finite reading and exact coverage\<close>

fun finite_term_readings_bounded ::
  "nat \<Rightarrow> 'u finite_artifact_environment \<Rightarrow> 'u \<Rightarrow> local_address \<Rightarrow>
    finite_factor_term finite_syntax_reading fset" where
  "finite_term_readings_bounded 0 E u r = {||}"
| "finite_term_readings_bounded (Suc n) E u r =
    (if finite_environment_formed E then ffUnion (fimage (\<lambda>C.
      finite_target_readings E u C r |\<union>| finite_payload_readings C r |\<union>|
      finite_record_readings C r Finite_Pair {||} (finite_term_readings_bounded n E u))
        (finite_artifacts_at E u)) else {||})"

lemma finite_term_readings_step:
  "(t,I,K) |\<in>| finite_term_readings_bounded (Suc n) E u r \<longleftrightarrow>
    finite_environment_formed E \<and> (\<exists>C. C |\<in>| finite_artifacts_at E u \<and>
      ((t,I,K) |\<in>| finite_target_readings E u C r \<or>
       (t,I,K) |\<in>| finite_payload_readings C r \<or>
       (t,I,K) |\<in>| finite_record_readings C r Finite_Pair {||} (finite_term_readings_bounded n E u)))"
  by (auto simp: ffUnion.rep_eq fimage.rep_eq)

lemma finite_term_readings_bounded_sound:
  assumes "(t,I,K) |\<in>| finite_term_readings_bounded n E u r"
  shows "term_quoted_at (decode_finite_environment E) u r (decode_finite_term t) (fset I) (fset K) \<and>
    factor_term_depth (decode_finite_term t) \<le> n"
  using assms
proof (induction n arbitrary: r t I K)
  case 0
  then show ?case by simp
next
  case (Suc n)
  obtain C where ef: "finite_environment_formed E" and source: "C |\<in>| finite_artifacts_at E u"
    and choices: "(t,I,K) |\<in>| finite_target_readings E u C r \<or>
      (t,I,K) |\<in>| finite_payload_readings C r \<or>
      (t,I,K) |\<in>| finite_record_readings C r Finite_Pair {||} (finite_term_readings_bounded n E u)"
    using Suc.prems by (simp only: finite_term_readings_step; blast)
  have formed: "environment_formed (decode_finite_environment E)"
    using ef by (simp add: finite_environment_formed_correct)
  have art: "artifact_at (decode_finite_environment E) u (decode_finite_object C)"
    using source by (simp add: finite_artifacts_at_member)
  consider (target) "(t,I,K) |\<in>| finite_target_readings E u C r"
    | (payload) "(t,I,K) |\<in>| finite_payload_readings C r"
    | (pair) "(t,I,K) |\<in>| finite_record_readings C r Finite_Pair {||} (finite_term_readings_bounded n E u)"
    using choices by blast
  then show ?case
  proof cases
    case target
    obtain c T where eq: "t=Finite_Target T" "K=finite_citation_slots c"
      and cite: "citation_at (decode_finite_object C) r c (fset I)"
      and external: "citation_slots c \<noteq> {}"
      and interpreted: "interpret_citation (decode_finite_environment E) u c (decode_finite_target T)"
      using target by (simp only: finite_target_readings_member; blast)
    have quote: "term_quoted_at (decode_finite_environment E) u r
      (Target_Term (decode_finite_target T)) (fset I) (citation_slots c)"
      by (rule term_quoted_at.target[OF formed art cite external interpreted])
    show ?thesis using quote eq by (simp add: finite_citation_slots_correct)
  next
    case payload
    obtain v where eq: "t=Finite_Payload v" "I={|r|}" "K={||}"
      and leaf: "payload_leaf_at (decode_finite_object C) r v"
      using payload by (simp only: finite_payload_readings_member; blast)
    have quote: "term_quoted_at (decode_finite_environment E) u r (Payload_Term v) {r} {}"
      by (rule term_quoted_at.payload[OF formed art leaf])
    show ?thesis using quote eq by simp
  next
    case pair
    obtain ps l q x L A y Q B where rec: "record_at (decode_finite_object C) r ps [l,q]"
      and left: "(x,L,A) |\<in>| finite_term_readings_bounded n E u l"
      and right: "(y,Q,B) |\<in>| finite_term_readings_bounded n E u q"
      and eq: "t=Finite_Pair x y" "I=finsert r (fset_of_list ps |\<union>| L |\<union>| Q)" "K=A |\<union>| B"
      and separate: "finsert r (fset_of_list ps) |\<inter>| (L |\<union>| Q)={||}"
        "L |\<inter>| Q={||}" "I |\<inter>| K={||}"
      using pair by (simp only: finite_record_readings_member finite_join_readings_member funion_fempty_right; auto)
    have lq: "term_quoted_at (decode_finite_environment E) u l (decode_finite_term x) (fset L) (fset A)"
      and ld: "factor_term_depth (decode_finite_term x) \<le> n" using Suc.IH[OF left] by auto
    have rq: "term_quoted_at (decode_finite_environment E) u q (decode_finite_term y) (fset Q) (fset B)"
      and rd: "factor_term_depth (decode_finite_term y) \<le> n" using Suc.IH[OF right] by auto
    have boundary: "insert r (set ps) \<inter> (fset L \<union> fset Q)={}"
      "fset L \<inter> fset Q={}"
      "insert r (set ps \<union> fset L \<union> fset Q) \<inter> (fset A \<union> fset B)={}"
      using separate eq by (simp_all add: fset_inject[symmetric] fset_of_list.rep_eq)
    have quote: "term_quoted_at (decode_finite_environment E) u r
      (Pair_Term (decode_finite_term x) (decode_finite_term y))
      (insert r (set ps \<union> fset L \<union> fset Q)) (fset A \<union> fset B)"
      by (rule term_quoted_at.pair[OF formed art rec lq rq boundary])
    show ?thesis using quote ld rd eq by (simp add: fset_of_list.rep_eq)
  qed
qed

lemma finite_term_readings_bounded_complete:
  assumes quote: "term_quoted_at (decode_finite_environment E) u r t I K"
    and depth: "factor_term_depth t \<le> n"
  shows "\<exists>T F W. (T,F,W) |\<in>| finite_term_readings_bounded n E u r \<and>
    decode_finite_term T=t \<and> fset F=I \<and> fset W=K"
  using quote depth
proof (induction arbitrary: n rule: term_quoted_at.induct)
  case (target u R r c I t)
  obtain m where n: "n=Suc m" using target.prems by (cases n) auto
  have ef: "finite_environment_formed E" using target.hyps(1) by (simp add: finite_environment_formed_correct)
  obtain C where source: "C |\<in>| finite_artifacts_at E u" and decoded: "decode_finite_object C=R"
    using target.hyps(2) by (simp only: finite_artifacts_at_complete; blast)
  obtain F where cite: "(c,F) |\<in>| finite_citation_candidates C r" and interior: "fset F=I"
    using finite_citation_candidates_complete[of C r c I] target.hyps(3) decoded by blast
  obtain T where interpreted: "T |\<in>| finite_citation_targets E u c" and decoded_target: "decode_finite_target T=t"
    using target.hyps(5) by (simp only: finite_citation_targets_complete; blast)
  have leaf: "(Finite_Target T,F,finite_citation_slots c) |\<in>| finite_target_readings E u C r"
    using cite interpreted target.hyps(4)
    by (auto simp: finite_target_readings_member finite_citation_candidates_correct finite_citation_targets_member)
  have member: "(Finite_Target T,F,finite_citation_slots c) |\<in>| finite_term_readings_bounded n E u r"
    using ef source leaf by (simp only: n finite_term_readings_step; blast)
  show ?case
    by (rule exI[of _ "Finite_Target T"], rule exI[of _ F], rule exI[of _ "finite_citation_slots c"])
       (simp add: member decoded_target interior finite_citation_slots_correct)
next
  case (pair u R r ps l q x L A y Q B)
  obtain m where n: "n=Suc m" using pair.prems by (cases n) auto
  have ld: "factor_term_depth x \<le> m" and rd: "factor_term_depth y \<le> m"
    using pair.prems n by auto
  obtain X LF AF where left: "(X,LF,AF) |\<in>| finite_term_readings_bounded m E u l"
    and lx: "decode_finite_term X=x" "fset LF=L" "fset AF=A"
    using pair.IH(1)[OF ld] by blast
  obtain Y QF BF where right: "(Y,QF,BF) |\<in>| finite_term_readings_bounded m E u q"
    and ry: "decode_finite_term Y=y" "fset QF=Q" "fset BF=B"
    using pair.IH(2)[OF rd] by blast
  have ef: "finite_environment_formed E" using pair.hyps(1) by (simp add: finite_environment_formed_correct)
  obtain C where source: "C |\<in>| finite_artifacts_at E u" and decoded: "decode_finite_object C=R"
    using pair.hyps(2) by (simp only: finite_artifacts_at_complete; blast)
  let ?F = "finsert r (fset_of_list ps |\<union>| LF |\<union>| QF)"
  let ?W = "AF |\<union>| BF"
  have boundary: "finsert r (fset_of_list ps) |\<inter>| (LF |\<union>| QF)={||}"
    "LF |\<inter>| QF={||}" "?F |\<inter>| (?W |\<union>| {||})={||}"
    using pair.hyps(6-8) lx ry by (simp_all add: fset_inject[symmetric] fset_of_list.rep_eq)
  have joined: "(Finite_Pair X Y,?F,?W) |\<in>| finite_join_readings Finite_Pair {||} r ps
    (finite_term_readings_bounded m E u l) (finite_term_readings_bounded m E u q)"
    using left right boundary by (simp only: finite_join_readings_member; blast)
  have branch: "(Finite_Pair X Y,?F,?W) |\<in>|
    finite_record_readings C r Finite_Pair {||} (finite_term_readings_bounded m E u)"
    using joined pair.hyps(3) decoded by (simp only: finite_record_readings_member; blast)
  have member: "(Finite_Pair X Y,?F,?W) |\<in>| finite_term_readings_bounded n E u r"
    using ef source branch by (simp only: n finite_term_readings_step; blast)
  show ?case
    by (rule exI[of _ "Finite_Pair X Y"], rule exI[of _ ?F], rule exI[of _ ?W])
       (simp add: member lx ry fset_of_list.rep_eq)
next
  case (payload u R r v)
  obtain m where n: "n=Suc m" using payload.prems by (cases n) auto
  have ef: "finite_environment_formed E" using payload.hyps(1) by (simp add: finite_environment_formed_correct)
  obtain C where source: "C |\<in>| finite_artifacts_at E u" and decoded: "decode_finite_object C=R"
    using payload.hyps(2) by (simp only: finite_artifacts_at_complete; blast)
  have leaf: "(Finite_Payload v,{|r|},{||}) |\<in>| finite_payload_readings C r"
    using payload.hyps(3) decoded by (simp add: finite_payload_readings_member)
  have member: "(Finite_Payload v,{|r|},{||}) |\<in>| finite_term_readings_bounded n E u r"
    using ef source leaf by (simp only: n finite_term_readings_step; blast)
  show ?case
    by (rule exI[of _ "Finite_Payload v"], rule exI[of _ "{|r|}"], rule exI[of _ "{||}"])
       (simp add: member)
qed

theorem finite_term_readings_bounded_correct:
  "(t,I,K) |\<in>| finite_term_readings_bounded n E u r \<longleftrightarrow>
    term_quoted_at (decode_finite_environment E) u r (decode_finite_term t) (fset I) (fset K) \<and>
    factor_term_depth (decode_finite_term t) \<le> n"
  using finite_term_readings_bounded_sound[of t I K n E u r]
    finite_term_readings_bounded_complete[of E u r "decode_finite_term t" "fset I" "fset K" n]
  by (auto simp: fset_inject)

definition finite_term_readings ::
  "'u finite_artifact_environment \<Rightarrow> 'u \<Rightarrow> local_address \<Rightarrow>
    finite_factor_term finite_syntax_reading fset" where
  "finite_term_readings E u r = ffUnion (fimage (\<lambda>C.
    finite_term_readings_bounded (fcard (finite_carrier (finite_structure C))) E u r)
      (finite_artifacts_at E u))"

theorem finite_term_readings_correct:
  "(t,I,K) |\<in>| finite_term_readings E u r \<longleftrightarrow>
    term_quoted_at (decode_finite_environment E) u r (decode_finite_term t) (fset I) (fset K)"
proof
  assume member: "(t,I,K) |\<in>| finite_term_readings E u r"
  show "term_quoted_at (decode_finite_environment E) u r (decode_finite_term t) (fset I) (fset K)"
    using member by (auto simp: finite_term_readings_def ffUnion.rep_eq fimage.rep_eq
        dest: finite_term_readings_bounded_sound)
next
  assume quote: "term_quoted_at (decode_finite_environment E) u r (decode_finite_term t) (fset I) (fset K)"
  obtain C where source: "C |\<in>| finite_artifacts_at E u"
    using term_quoted_has_artifact[OF quote] by (auto simp: finite_artifacts_at_member)
  have bounded: "(t,I,K) |\<in>|
    finite_term_readings_bounded (fcard (finite_carrier (finite_structure C))) E u r"
    using quote term_quoted_depth_carrier[OF quote source]
    by (simp add: finite_term_readings_bounded_correct)
  show "(t,I,K) |\<in>| finite_term_readings E u r"
    using source bounded by (auto simp: finite_term_readings_def ffUnion.rep_eq fimage.rep_eq)
qed

theorem finite_term_readings_complete:
  assumes quote: "term_quoted_at (decode_finite_environment E) u r t I K"
  shows "\<exists>T F W. (T,F,W) |\<in>| finite_term_readings E u r \<and>
    decode_finite_term T=t \<and> fset F=I \<and> fset W=K"
proof -
  obtain T F W where member: "(T,F,W) |\<in>| finite_term_readings_bounded (factor_term_depth t) E u r"
    and decoded: "decode_finite_term T=t" "fset F=I" "fset W=K"
    using finite_term_readings_bounded_complete[OF quote order_refl] by blast
  have "(T,F,W) |\<in>| finite_term_readings E u r"
    using quote decoded by (simp add: finite_term_readings_correct)
  then show ?thesis using decoded by blast
qed

corollary finite_term_readings_unique:
  assumes "(t,I,K) |\<in>| finite_term_readings E u r" "(s,J,W) |\<in>| finite_term_readings E u r"
  shows "t=s \<and> I=J \<and> K=W"
proof -
  have first: "term_quoted_at (decode_finite_environment E) u r (decode_finite_term t) (fset I) (fset K)"
    and second: "term_quoted_at (decode_finite_environment E) u r (decode_finite_term s) (fset J) (fset W)"
    using assms by (simp_all add: finite_term_readings_correct)
  show ?thesis using term_quoted_unique[OF first second] by (simp add: fset_inject)
qed

export_code finite_term_readings checking SML

text \<open>
  The reader obtains every leaf and record from the supplied artifact and
  environment. Pair composition checks the full private interiors and external
  slot boundary. Its recursion bound is derived from the finite source carrier:
  each child interior is a strict subset of the parent interior. The bound
  therefore covers every abstract quotation, including arbitrarily deep finite
  terms, without imposing an independently chosen semantic cutoff.
\<close>

