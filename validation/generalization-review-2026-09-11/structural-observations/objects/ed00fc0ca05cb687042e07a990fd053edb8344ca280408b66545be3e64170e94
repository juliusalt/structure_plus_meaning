import json,sys
from pathlib import Path

def compact(result):
    terms,witnesses=[],[]
    def reference(table,value):
        if value not in table:table.append(value)
        return table.index(value)
    bindings=[[[[a,reference(terms,t)] for a,t in row["bindings"]],
               [reference(witnesses,w) for w in row["witnesses"]]] for row in result["bindings"]]
    recovered=[{"bindings":[[a,terms[t]] for a,t in rows],"witnesses":[witnesses[w] for w in support]}
               for rows,support in bindings]
    assert recovered==result["bindings"]
    return {**result,"terms":terms,"witnesses":witnesses,"bindings":bindings}

for line in Path(sys.argv[1]).read_text().splitlines():
    if line.startswith("BINDING_CONTRIBUTIONS "):
        _,i,data=line.split(" ",2)
        print(i,json.dumps(compact(json.loads(data)),separators=(",",":")))
