theory Factor_Executable_Families
  imports "Factor_Executable_Quotation"
begin

section \<open>Complete socket readings preserve every actual row\<close>

lemma finite_when_member:
  "x |\<in>| (if P then A else {||}) \<longleftrightarrow> P \<and> x |\<in>| A"
  by (cases P) auto

definition finite_reading_values :: "'a finite_syntax_reading fset \<Rightarrow> 'a fset" where
  "finite_reading_values X = fimage fst X"

lemma finite_reading_values_member:
  "x |\<in>| finite_reading_values X \<longleftrightarrow> (\<exists>I K. (x,I,K) |\<in>| X)"
  by (simp only: finite_reading_values_def finite_image_member split_paired_Ex fst_conv; blast)

definition finite_socket_rows ::
  "('s \<times> 'a) fset \<Rightarrow> ('a \<Rightarrow> 'b fset) \<Rightarrow> ('s \<times> 'b) fset" where
  "finite_socket_rows M reads =
    ffUnion (fimage (\<lambda>(s,a). fimage (Pair s) (reads a)) M)"

lemma finite_socket_rows_member:
  "(s,x) |\<in>| finite_socket_rows M reads \<longleftrightarrow>
    (\<exists>a. (s,a) |\<in>| M \<and> x |\<in>| reads a)"
  by (auto simp: finite_socket_rows_def finite_union_image_member finite_image_member)

definition finite_socket_readings ::
  "('s \<times> 'a) fset \<Rightarrow> ('a \<Rightarrow> 'b fset) \<Rightarrow> ('s \<times> 'b) fset fset" where
  "finite_socket_readings M reads =
    (let Q=finite_socket_rows M reads in
     if fBall M (\<lambda>(s,a). reads a \<noteq> {||}) \<and> finite_relation_functional Q
     then {|Q|} else {||})"

lemma finite_socket_readings_correct:
  assumes unique: "\<And>a x y. x |\<in>| reads a \<Longrightarrow> y |\<in>| reads a \<Longrightarrow> x=y"
  shows "Q |\<in>| finite_socket_readings M reads \<longleftrightarrow>
    single_valued (fset Q) \<and> rel_dom (fset Q)=rel_dom (fset M) \<and>
    (\<forall>s a. (s,a) |\<in>| M \<longrightarrow> (\<exists>x. (s,x) |\<in>| Q \<and> x |\<in>| reads a))"
proof -
  have total: "fBall M (\<lambda>(s,a). reads a \<noteq> {||}) \<longleftrightarrow>
    (\<forall>s a. (s,a) |\<in>| M \<longrightarrow> (\<exists>x. x |\<in>| reads a))"
    by (auto simp: fset_inject[symmetric] Ball_def split_paired_All)
  show ?thesis
  proof
    assume member: "Q |\<in>| finite_socket_readings M reads"
    have eq: "Q=finite_socket_rows M reads"
      and all: "\<forall>s a. (s,a) |\<in>| M \<longrightarrow> (\<exists>x. x |\<in>| reads a)"
      and sv: "single_valued (fset Q)"
      using member by (auto simp: finite_socket_readings_def Let_def
          finite_singleton_when_member total finite_relation_functional_correct)
    have domain: "rel_dom (fset Q)=rel_dom (fset M)"
      using all by (auto simp: eq rel_dom_def finite_socket_rows_member; blast)
    have complete: "\<forall>s a. (s,a) |\<in>| M \<longrightarrow>
      (\<exists>x. (s,x) |\<in>| Q \<and> x |\<in>| reads a)"
      using all by (auto simp: eq finite_socket_rows_member; blast)
    show "single_valued (fset Q) \<and> rel_dom (fset Q)=rel_dom (fset M) \<and>
      (\<forall>s a. (s,a) |\<in>| M \<longrightarrow> (\<exists>x. (s,x) |\<in>| Q \<and> x |\<in>| reads a))"
      using sv domain complete by blast
  next
    assume reading: "single_valued (fset Q) \<and> rel_dom (fset Q)=rel_dom (fset M) \<and>
      (\<forall>s a. (s,a) |\<in>| M \<longrightarrow> (\<exists>x. (s,x) |\<in>| Q \<and> x |\<in>| reads a))"
    have sv: "single_valued (fset Q)" and domain: "rel_dom (fset Q)=rel_dom (fset M)"
      and complete: "\<forall>s a. (s,a) |\<in>| M \<longrightarrow>
        (\<exists>x. (s,x) |\<in>| Q \<and> x |\<in>| reads a)"
      using reading by auto
    have rows: "(s,x) |\<in>| Q \<longleftrightarrow> (s,x) |\<in>| finite_socket_rows M reads" for s x
    proof
      assume member: "(s,x) |\<in>| Q"
      show "(s,x) |\<in>| finite_socket_rows M reads"
        using complete_socket_reading_origin[OF sv domain complete member]
        by (simp only: finite_socket_rows_member)
    next
      assume member: "(s,x) |\<in>| finite_socket_rows M reads"
      obtain a where field: "(s,a) |\<in>| M" and read: "x |\<in>| reads a"
        using member by (auto simp: finite_socket_rows_member)
      obtain y where present: "(s,y) |\<in>| Q" and recovered: "y |\<in>| reads a"
        using complete field by blast
      have same: "x=y" by (rule unique[OF read recovered])
      show "(s,x) |\<in>| Q" using present same by simp
    qed
    have eq: "Q=finite_socket_rows M reads"
      using rows by (auto simp: fset_inject[symmetric])
    have all: "fBall M (\<lambda>(s,a). reads a \<noteq> {||})" using complete total by blast
    show "Q |\<in>| finite_socket_readings M reads"
      using eq all sv by (simp add: finite_socket_readings_def Let_def
          finite_relation_functional_correct)
  qed
qed

section \<open>Reading the actual family before interpreting its endpoints\<close>

definition finite_family_readings ::
  "'u finite_artifact_environment \<Rightarrow> 'u \<Rightarrow> local_address \<Rightarrow>
    (local_address \<Rightarrow> 'a fset) \<Rightarrow> (local_address \<times> 'a) fset fset" where
  "finite_family_readings E u r reads = (if finite_environment_formed E then
    ffUnion (fimage (\<lambda>C. ffUnion (fimage (\<lambda>M. finite_socket_readings M reads)
      (finite_family_candidates C r))) (finite_artifacts_at E u)) else {||})"

lemma finite_family_readings_step:
  "Q |\<in>| finite_family_readings E u r reads \<longleftrightarrow>
    finite_environment_formed E \<and> (\<exists>C M. C |\<in>| finite_artifacts_at E u \<and>
      family_at (decode_finite_object C) r (fset M) \<and> Q |\<in>| finite_socket_readings M reads)"
  by (auto simp: finite_family_readings_def finite_union_image_member
      finite_family_candidates_correct split: if_splits)

theorem finite_family_readings_correct:
  assumes injective: "inj D"
    and correct: "\<And>a x. x |\<in>| reads a \<longleftrightarrow> R a (D x)"
    and unique: "\<And>a x y. R a x \<Longrightarrow> R a y \<Longrightarrow> x=y"
  shows "Q |\<in>| finite_family_readings E u r reads \<longleftrightarrow>
    environment_formed (decode_finite_environment E) \<and>
    (\<exists>A M. artifact_at (decode_finite_environment E) u A \<and> family_at A r M \<and>
      finite (map_relation_values D (fset Q)) \<and> single_valued (map_relation_values D (fset Q)) \<and>
      rel_dom (map_relation_values D (fset Q))=rel_dom M \<and>
      (\<forall>s a. (s,a) \<in> M \<longrightarrow>
        (\<exists>x. (s,x) \<in> map_relation_values D (fset Q) \<and> R a x)))"
proof -
  have values_unique: "\<And>a x y. x |\<in>| reads a \<Longrightarrow> y |\<in>| reads a \<Longrightarrow> x=y"
    using injective unique by (auto simp: correct inj_def)
  have socket: "Q |\<in>| finite_socket_readings M reads \<longleftrightarrow>
      finite (map_relation_values D (fset Q)) \<and> single_valued (map_relation_values D (fset Q)) \<and>
      rel_dom (map_relation_values D (fset Q))=rel_dom (fset M) \<and>
      (\<forall>s a. (s,a) |\<in>| M \<longrightarrow>
        (\<exists>x. (s,x) \<in> map_relation_values D (fset Q) \<and> R a x))" for M
    by (simp only: finite_socket_readings_correct[OF values_unique]
        map_relation_values_functional[OF injective] map_relation_values_domain)
       (auto simp: correct; blast)
  show ?thesis
  proof
    assume member: "Q |\<in>| finite_family_readings E u r reads"
    obtain C M where ef: "finite_environment_formed E"
      and source: "C |\<in>| finite_artifacts_at E u"
      and family: "family_at (decode_finite_object C) r (fset M)"
      and reading: "Q |\<in>| finite_socket_readings M reads"
      using member by (auto simp: finite_family_readings_step)
    have art: "artifact_at (decode_finite_environment E) u (decode_finite_object C)"
      using source by (simp add: finite_artifacts_at_member)
    show "environment_formed (decode_finite_environment E) \<and>
      (\<exists>A M. artifact_at (decode_finite_environment E) u A \<and> family_at A r M \<and>
        finite (map_relation_values D (fset Q)) \<and> single_valued (map_relation_values D (fset Q)) \<and>
        rel_dom (map_relation_values D (fset Q))=rel_dom M \<and>
        (\<forall>s a. (s,a) \<in> M \<longrightarrow>
          (\<exists>x. (s,x) \<in> map_relation_values D (fset Q) \<and> R a x)))"
      apply (rule conjI)
       apply (use ef in \<open>simp add: finite_environment_formed_correct\<close>)
      apply (rule exI[of _ "decode_finite_object C"], rule exI[of _ "fset M"])
      using art family reading by (simp add: socket)
  next
    assume reading: "environment_formed (decode_finite_environment E) \<and>
      (\<exists>A M. artifact_at (decode_finite_environment E) u A \<and> family_at A r M \<and>
        finite (map_relation_values D (fset Q)) \<and> single_valued (map_relation_values D (fset Q)) \<and>
        rel_dom (map_relation_values D (fset Q))=rel_dom M \<and>
        (\<forall>s a. (s,a) \<in> M \<longrightarrow>
          (\<exists>x. (s,x) \<in> map_relation_values D (fset Q) \<and> R a x)))"
    obtain C M where ef: "environment_formed (decode_finite_environment E)"
      and source: "C |\<in>| finite_artifacts_at E u"
      and family: "family_at (decode_finite_object C) r M"
      and fields: "finite (map_relation_values D (fset Q))" "single_valued (map_relation_values D (fset Q))"
        "rel_dom (map_relation_values D (fset Q))=rel_dom M"
        "\<forall>s a. (s,a) \<in> M \<longrightarrow>
          (\<exists>x. (s,x) \<in> map_relation_values D (fset Q) \<and> R a x)"
      using reading by (auto simp: finite_artifacts_at_member)
    obtain F where candidate: "F |\<in>| finite_family_candidates C r" and represented: "fset F=M"
      using finite_family_candidates_complete[OF family] by blast
    have sockets: "Q |\<in>| finite_socket_readings F reads"
      using fields represented by (simp add: socket)
    show "Q |\<in>| finite_family_readings E u r reads"
      unfolding finite_family_readings_step
      apply (rule conjI)
       apply (use ef in \<open>simp add: finite_environment_formed_correct\<close>)
      apply (rule exI[of _ C], rule exI[of _ F])
      using source family represented sockets by simp
  qed
qed

lemma finite_relation_value_representation:
  assumes finite: "finite R"
    and inverse: "\<And>s x. (s,x) \<in> R \<Longrightarrow> D (F x)=x"
  shows "\<exists>Q. map_relation_values D (fset Q)=R"
proof -
  have represented: "fset (Abs_fset (map_relation_values F R))=map_relation_values F R"
    by (rule Abs_fset_inverse) (simp add: finite)
  have recovered: "map_relation_values D (map_relation_values F R)=R"
    by (rule map_relation_values_inverse, rule inverse)
  show ?thesis
    by (rule exI[of _ "Abs_fset (map_relation_values F R)"]) (simp add: represented recovered)
qed

export_code finite_reading_values finite_socket_readings finite_family_readings checking SML

text \<open>
  The complete actual family determines the socket domain. Every endpoint must
  have a reading, and the resulting socket relation must be functional. Distinct
  sockets remain distinct even when their endpoint or recovered value is shared.
  The correspondence theorem requires unique endpoint readings; it does not
  select one result from an ambiguous interpretation.
\<close>

end
