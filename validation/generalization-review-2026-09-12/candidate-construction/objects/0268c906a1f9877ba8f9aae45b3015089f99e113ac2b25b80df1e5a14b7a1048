theory Finite_Compatible_Unions
  imports RRA_Finite_Artifacts Finite_Set_Composition
begin

section \<open>Compatible finite unions of independently supplied relations\<close>

lemma finite_relation_functional_subset:
  assumes "finite_relation_functional W" "V |\<subseteq>| W"
  shows "finite_relation_functional V"
  using assms by (auto simp: finite_relation_functional_correct single_valued_def)

definition finite_compatible_unions where
  "finite_compatible_unions B=ffilter finite_relation_functional (fimage ffUnion (fPow B))"

lemma finite_compatible_union_member:
  "V |\<in>| finite_compatible_unions B \<longleftrightarrow>
    finite_relation_functional V \<and> (\<exists>A. A |\<subseteq>| B \<and> V=ffUnion A)"
  by (auto simp: finite_compatible_unions_def)

lemma finite_compatible_union_origin:
  assumes "V |\<in>| finite_compatible_unions B" "(a,t) |\<in>| V"
  shows "\<exists>W. W |\<in>| B \<and> (a,t) |\<in>| W"
  using assms by (auto simp: finite_compatible_union_member ffUnion.rep_eq; blast)

lemma finite_compatible_unions_mono:
  assumes "B |\<subseteq>| D"
  shows "finite_compatible_unions B |\<subseteq>| finite_compatible_unions D"
  using assms by (auto simp: finite_compatible_union_member; blast)

theorem finite_compatible_union_support:
  assumes generated: "V |\<in>| finite_compatible_unions B"
  shows "ffUnion (ffilter (\<lambda>W. W |\<subseteq>| V) B)=V"
proof -
  obtain A where included: "A |\<subseteq>| B" and union: "V=ffUnion A"
    using generated by (simp only: finite_compatible_union_member) blast
  have supported: "A |\<subseteq>| ffilter (\<lambda>W. W |\<subseteq>| V) B"
    using included by (auto simp: union ffUnion.rep_eq less_eq_fset.rep_eq; blast)
  have complete: "V |\<subseteq>| ffUnion (ffilter (\<lambda>W. W |\<subseteq>| V) B)"
    using ffunion_mono[OF supported] by (simp only: union)
  have inside: "ffUnion (ffilter (\<lambda>W. W |\<subseteq>| V) B) |\<subseteq>| V"
    by (auto simp: ffUnion.rep_eq less_eq_fset.rep_eq)
  show ?thesis by (rule order_antisym[OF inside complete])
qed

lemma finite_compatible_union_empty [simp]:
  "finite_compatible_unions {||}={|{||}|}"
  by (rule fset_inject[THEN iffD1])
    (auto simp: finite_compatible_unions_def finite_relation_functional_correct single_valued_def)

lemma finite_compatible_union_step:
  "finite_compatible_unions (finsert W B)=finite_compatible_unions B |\<union>|
    fimage (\<lambda>V. W |\<union>| V)
      (ffilter (\<lambda>V. finite_relation_functional (W |\<union>| V)) (finite_compatible_unions B))"
proof -
  let ?R="finite_compatible_unions B |\<union>| fimage (\<lambda>V. W |\<union>| V)
    (ffilter (\<lambda>V. finite_relation_functional (W |\<union>| V)) (finite_compatible_unions B))"
  have forward: "V |\<in>| ?R" if member: "V |\<in>| finite_compatible_unions (finsert W B)" for V
  proof -
    obtain A where functional: "finite_relation_functional V" and inside: "A |\<subseteq>| finsert W B"
      and union: "V=ffUnion A" using member by (simp only: finite_compatible_union_member) blast
    show ?thesis
    proof (cases "W |\<in>| A")
      case False
      have "A |\<subseteq>| B" using inside False by auto
      then have "V |\<in>| finite_compatible_unions B"
        using functional union by (simp only: finite_compatible_union_member) blast
      then show ?thesis by simp
    next
      case True
      let ?A="A |-| {|W|}"
      have included: "?A |\<subseteq>| B" using inside by auto
      have reconstruct: "A=finsert W ?A" using True by auto
      have shape: "V=W |\<union>| ffUnion ?A"
        using arg_cong[OF reconstruct, of ffUnion] by (simp only: union ffunion_insert)
      have smaller: "ffUnion ?A |\<subseteq>| V" by (simp only: shape) simp
      have partial: "finite_relation_functional (ffUnion ?A)"
        by (rule finite_relation_functional_subset[OF functional smaller])
      have generated: "ffUnion ?A |\<in>| finite_compatible_unions B"
        using partial included by (simp only: finite_compatible_union_member) blast
      have filtered: "ffUnion ?A |\<in>| ffilter (\<lambda>U. finite_relation_functional (W |\<union>| U))
          (finite_compatible_unions B)"
        using generated functional by (simp only: shape) simp
      have image: "W |\<union>| ffUnion ?A |\<in>| fimage (\<lambda>U. W |\<union>| U)
          (ffilter (\<lambda>U. finite_relation_functional (W |\<union>| U)) (finite_compatible_unions B))"
        by (rule fimageI[OF filtered])
      show ?thesis using image by (simp only: shape) simp
    qed
  qed
  have reverse: "V |\<in>| finite_compatible_unions (finsert W B)" if member: "V |\<in>| ?R" for V
  proof (cases "V |\<in>| finite_compatible_unions B")
    case True
    have "finite_compatible_unions B |\<subseteq>| finite_compatible_unions (finsert W B)"
      by (rule finite_compatible_unions_mono) auto
    then show ?thesis using True by auto
  next
    case False
    obtain U where generated: "U |\<in>| finite_compatible_unions B"
      and functional: "finite_relation_functional (W |\<union>| U)" and shape: "V=W |\<union>| U"
      using member False by auto
    obtain A where inside: "A |\<subseteq>| B" and union: "U=ffUnion A"
      using generated by (simp only: finite_compatible_union_member) blast
    have included: "finsert W A |\<subseteq>| finsert W B" using inside by auto
    have reconstruct: "V=ffUnion (finsert W A)"
      by (simp only: shape union ffunion_insert)
    show ?thesis using functional included reconstruct
      by (simp only: finite_compatible_union_member shape) blast
  qed
  show ?thesis by (rule fset_inject[THEN iffD1]) (use forward reverse in auto)
qed

lemma finite_compatible_union_initial [simp]:
  "{||} |\<in>| finite_compatible_unions B"
  by (auto simp: finite_compatible_union_member finite_relation_functional_correct single_valued_def
    intro!: exI[of _ "{||}"])

lemma finite_compatible_union_add:
  assumes generated: "V |\<in>| finite_compatible_unions B" and member: "W |\<in>| B"
    and compatible: "finite_relation_functional (V |\<union>| W)"
  shows "V |\<union>| W |\<in>| finite_compatible_unions B"
proof -
  have extended: "V |\<union>| W |\<in>| finite_compatible_unions (finsert W B)"
    using generated compatible by (auto simp: finite_compatible_union_step sup_commute)
  have absorbed: "finsert W B=B"
    by (rule fset_inject[THEN iffD1]) (use member in auto)
  show ?thesis using extended by (simp only: absorbed)
qed

fun finite_compatible_union_list where
  "finite_compatible_union_list []={|{||}|}"
| "finite_compatible_union_list (W#Bs)=
    (let A=finite_compatible_union_list Bs
     in A |\<union>| fimage (\<lambda>V. W |\<union>| V)
       (ffilter (\<lambda>V. finite_relation_functional (W |\<union>| V)) A))"

lemma finite_compatible_unions_list:
  "finite_compatible_union_list Bs=finite_compatible_unions (fset_of_list Bs)"
  by (induction Bs) (simp_all add: finite_compatible_union_step Let_def)

definition set_compatible_unions where
  "set_compatible_unions B=finite_compatible_unions (Abs_fset B)"

lemma set_compatible_unions_list [code]:
  "set_compatible_unions (set Bs)=finite_compatible_union_list Bs"
proof -
  have representation: "Abs_fset (set Bs)=fset_of_list Bs"
    using fset_inverse[of "fset_of_list Bs"] by (simp only: fset_of_list.rep_eq)
  show ?thesis by (simp only: set_compatible_unions_def representation finite_compatible_unions_list)
qed

lemma finite_compatible_unions_code [code]:
  "finite_compatible_unions B=set_compatible_unions (fset B)"
  by (simp only: set_compatible_unions_def fset_inverse)

lemma finite_functional_included_domain:
  assumes functional: "finite_relation_functional V" and included: "U |\<subseteq>| V"
    and domain: "fimage fst U=fimage fst V"
  shows "U=V"
proof (rule order_antisym[OF included], rule fsubsetI)
  fix row assume row: "row |\<in>| V"
  obtain a b where shape: "row=(a,b)" by (cases row)
  have actual: "(a,b) |\<in>| V" using row by (simp only: shape)
  have projected: "a |\<in>| fimage fst V" using fimageI[OF actual, of fst] by simp
  have key: "a |\<in>| fimage fst U" using projected by (simp only: domain)
  obtain c where original: "(a,c) |\<in>| U" using key by auto
  have same: "c=b" using functional included original row
    by (auto simp: shape finite_relation_functional_correct single_valued_def; blast)
  show "row |\<in>| U" using original by (simp only: shape same)
qed

lemma finite_compatible_union_covering_part:
  assumes generated: "V |\<in>| finite_compatible_unions B" and key: "a |\<in>| fimage fst V"
  obtains W where "W |\<in>| B" "W |\<subseteq>| V" "a |\<in>| fimage fst W"
proof -
  have support: "ffUnion (ffilter (\<lambda>W. W |\<subseteq>| V) B)=V"
    by (rule finite_compatible_union_support[OF generated])
  obtain t where row: "(a,t) |\<in>| V" using key by auto
  have supported: "(a,t) |\<in>| ffUnion (ffilter (\<lambda>W. W |\<subseteq>| V) B)"
    by (simp only: support; rule row)
  obtain W where parts: "W |\<in>| B" "W |\<subseteq>| V" "(a,t) |\<in>| W"
    using supported by (simp only: ffUnion_membership) auto
  show thesis by (rule that[OF parts(1,2)]) (use parts(3) in auto)
qed

end
