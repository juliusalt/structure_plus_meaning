"""Guard structural comparison inputs before they become executable source."""
import json
from pathlib import Path
import sys
import tempfile
import unittest
from unittest.mock import patch

import check_application_comparison as comparison
import check_reasoning as review


class ApplicationComparisonInputs(unittest.TestCase):
    def test_conflicting_observation_cannot_split_a_whole_match(self):
        a, b, c = map(review.payload, [1, 2, 3])
        contributions = [{0: a, 1: b}, {1: c}]
        self.assertEqual(list(review.observation_valuations({0, 1}, contributions)), [{0: a, 1: b}])
        partial = {review.freeze(v) for v in review.observation_valuations({0, 1}, contributions, complete=False)}
        self.assertEqual(partial, {review.freeze({}), review.freeze({1: c}), review.freeze({0: a, 1: b})})

    def test_missing_and_repeated_contributions_keep_the_same_boundary(self):
        part = {0: review.payload(1)}
        self.assertEqual(list(review.observation_valuations({0, 1}, [part])), [])
        self.assertEqual(list(review.observation_valuations({0}, [part] * 4)), [part])

    def test_identifier_fields_are_natural_data(self):
        for value in [True, -1, 1.5, "0); invalid code"]:
            with self.subTest(value=value):
                for encode in [lambda: review.ml_term({"var": value}),
                               lambda: review.ml_call([value, review.payload()]),
                               lambda: review.ml_premise([value, 1, review.payload()]),
                               lambda: review.ml_library({"entry": value, "schema": review.schema(review.payload()),
                                                          "enumeration": []})]:
                    with self.assertRaises(ValueError):
                        encode()

    def test_supplied_observations_are_rejected_before_execution(self):
        with tempfile.TemporaryDirectory(prefix="application-comparison-") as directory:
            base = Path(directory)
            source = base / "case.json"
            source.write_text(json.dumps({"selected": [], "problems": [{}], "observations": [[0, 0, 0]]}))
            args = ["comparison", "--specification", str(source), "--proof", str(base / "proof.json"),
                    "--poly", sys.executable, "--output", str(base / "run")]
            with patch.object(sys, "argv", args), self.assertRaises(AssertionError):
                comparison.main()
            self.assertFalse((base / "run").exists())

    def construction_case(self):
        p = {"id": 0, "entry": 1, "schema": review.schema(review.payload()),
             "enumeration": [], "frontier": [], "requests": [], "required": []}
        return {"cases": [{"name": "constant", "problems": [p], "parts": [["head"]]}]}

    def test_complete_problem_indices_reject_ambiguity(self):
        spec = self.construction_case()
        problem = spec["cases"][0]["problems"][0]
        spec["cases"][0]["problems"].append({**problem, "entry": 2})
        with self.assertRaisesRegex(AssertionError, "Ambiguous workload"):
            comparison.construction_cases(spec)

    def test_target_fields_cannot_be_silently_dropped(self):
        spec = self.construction_case()
        spec["cases"][0]["target_presentations"] = [[{
            "conclusion": review.payload(), "bindings": [], "premises": [], "extra": 1}]]
        with self.assertRaises(AssertionError):
            comparison.construction_cases(spec)

    def test_redundant_target_owner_is_checked(self):
        spec = self.construction_case()
        problem = spec["cases"][0]["problems"][0]
        target = {"conclusion": review.payload(), "bindings": [], "premises": [],
                  "entry": problem["entry"], "schema": review.clone_json(problem["schema"])}
        problem["required"] = [target]
        self.assertEqual(comparison.construction_cases(spec)[0]["problems"][0]["required"], [target])
        target["entry"] += 1
        with self.assertRaises(AssertionError):
            comparison.construction_cases(spec)

    def test_redundant_target_schema_cannot_disagree(self):
        spec = self.construction_case()
        problem = spec["cases"][0]["problems"][0]
        problem["required"] = [{"conclusion": review.payload(), "bindings": [], "premises": [],
            "entry": problem["entry"], "schema": review.schema(review.payload(1))}]
        with self.assertRaises(AssertionError):
            comparison.construction_cases(spec)

    def test_term_constructor_cannot_be_silently_dropped(self):
        spec = self.construction_case()
        spec["cases"][0]["problems"][0]["schema"]["head"] = {"var": 0, "payload": [1]}
        with self.assertRaises(AssertionError):
            comparison.construction_cases(spec)

    def test_semantically_malformed_payload_remains_a_native_case(self):
        spec = self.construction_case()
        spec["cases"][0]["problems"][0]["schema"]["head"] = {"payload": [256]}
        rows = comparison.construction_cases(spec)
        self.assertEqual(rows[0]["problems"], spec["cases"][0]["problems"])

    def test_complete_problem_roundtrip_preserves_enumeration(self):
        row = {"id": 0, "entry": 1, "schema": review.schema(review.payload(), [[0, 2, review.payload()]]),
               "enumeration": [[0, 2, review.payload()]], "frontier": [], "requests": [], "required": []}
        changed = review.clone_json(row)
        changed["enumeration"] *= 2
        self.assertNotEqual(comparison.normalized_problem(row), comparison.normalized_problem(changed))


if __name__ == "__main__":
    unittest.main()
