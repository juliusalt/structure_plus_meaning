"""Criticize the candidate-input gate with complete source and target controls."""
import json
from pathlib import Path
import prototype as p
import application_controls as controls
import sys
sys.path.insert(0,'/home/julius/structure_and_semantics/tools')
import investigate,compare_reasoning_methods as comparison
B=Path(__file__).parent

def target_key(x):return p.local_application_key(x)
def main():
 rows=[]
 for case in controls.controls():
  old,new=True,True;details=[]
  for i,P in enumerate(case['problems']):
   e={'entry':P['entry'],'schema':P['schema'],'enumeration':P['enumeration']};item={'library':[e],'frontier':P['frontier']}
   original=p.reference.reconstruct_applications(item)[0]+p.reference.reconstruct_requested_applications(item,P['requests'])
   mandatory={target_key(x):x for x in P['required']+original}
   xs=list(mandatory.values()) if case['target_presentations'] is None else case['target_presentations'][i]
   enumeration={p.reference.freeze(x) for x in P['enumeration']}=={p.reference.freeze(x) for x in P['schema']['premises']}
   valid_targets=all((value:=p.reference.application_from_valuation(e,dict(x['bindings']))) is not None and target_key(value)==target_key(x) for x in xs)
   target_presentation={target_key(x) for x in xs}==set(mandatory)
   source=p.reference.schema_formed(P['schema']) and all(p.reference.formed(t) for _,t in P['frontier']+P['requests'])
   old_part=enumeration and valid_targets and target_presentation
   old &= old_part;new &= old_part and source
   details.append({'problem':P,'target_presentation':xs,'mandatory_targets':list(mandatory.values()),'enumeration_complete':enumeration,'targets_valid':valid_targets,'target_presentation_complete':target_presentation,'whole_source_formed':source})
  assert new==case['expected_formed'],case['name']
  rows.append({'case':case,'subjects':details,'old_gate':old,'new_gate':new,'expected':case['expected_formed']})
 subject=B/'application-gate-subjects.json';subject.write_text(json.dumps(rows,indent=2)+'\n')
 boundary='Conditional host comparison using complete retained source records, target presentations and existing independent structural validators. It guides which proposed native gate to check. The universal application constructor contract remains a separate proof obligation.'
 obs=[[0,c,w] for w,r in enumerate(rows) for c,k in enumerate(['old_gate','new_gate']) if r[k]==r['expected']]
 case=comparison.comparison_case([0,1],[0],obs,[],question='Check every complete source field even when the target family has no variables.',scope={'candidates':{'0':'Target and enumeration checks only','1':'Target checks plus complete schema and supplied-call formation'},'facets':{'0':'The gate agrees with the independently required whole-input formation result'},'subjects':str(subject)},evidence=[{'path':str(x),'sha256':investigate.file_hash(x)} for x in [subject,Path(__file__),B/'application_controls.py',B/'application-input-gate-criticism.json']]);case['semantic_boundary']=boundary
 (B/'application-gate-investigation.json').write_text(json.dumps({'question':case['question'],'boundary':boundary,'problems':[{'name':'complete-construction-input','case':case,'required_observations':[[0,w] for w in range(len(rows))]}]},indent=2)+'\n')
 print(json.dumps([{'case':r['case']['name'],'old':r['old_gate'],'new':r['new_gate'],'expected':r['expected']} for r in rows],indent=2))
if __name__=='__main__':main()
