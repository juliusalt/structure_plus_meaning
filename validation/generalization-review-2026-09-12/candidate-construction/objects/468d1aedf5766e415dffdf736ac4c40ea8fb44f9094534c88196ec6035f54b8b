lemma finite_observed_schema_applications_scoped [code]:
  "finite_observed_schema_applications S obs=ffUnion (fimage (\<lambda>V.
    let H=finite_instantiated_premises S V
    in fimage (\<lambda>t. (t,V,H))
      (ffilter (\<lambda>t. finite_schema_instance S V t H \<and> finite_schema_material_satisfied S V)
        (finite_pattern_instances V (finite_schema_conclusion S))))
    (finite_scoped_compatible_unions (finite_schema_variables S)
      (fimage (\<lambda>(i,p,t). finite_matching_bindings p t)
        (finite_pattern_observations (finite_schema_observation_sources S) obs))))"
proof -
  let ?F="\<lambda>V. let H=finite_instantiated_premises S V in
    fimage (\<lambda>t. (t,V,H)) (ffilter (\<lambda>t. finite_schema_instance S V t H \<and>
      finite_schema_material_satisfied S V) (finite_pattern_instances V (finite_schema_conclusion S)))"
  let ?B="finite_observed_bindings (finite_schema_observation_sources S) obs"
  have empty: "?F V={||}" if outside: "fimage fst V\<noteq>finite_schema_variables S" for V
    using outside by (auto simp: Let_def finite_schema_instance_def finite_term_bindings_formed_def)
  have restricted: "ffUnion (fimage ?F ?B)=ffUnion (fimage ?F
    (ffilter (\<lambda>V. fimage fst V=finite_schema_variables S) ?B))"
    by (rule fset_eqI) (use empty in \<open>auto simp: finite_union_image_member\<close>)
  show ?thesis by (simp only: finite_observed_schema_applications_def
    finite_scoped_compatible_unions_def finite_observed_bindings_def[symmetric] restricted)
qed
