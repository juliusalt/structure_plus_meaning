"""Reuse the checked complete-session boundary for its existing presenter export."""
from pathlib import Path
import json,os,shutil,subprocess,sys,uuid
M=Path('/home/julius/structure_and_semantics');C=Path(__file__).parent;O=C/'current-presenter-export';O.mkdir()
sys.path.insert(0,str(M/'tools'));import prove_context,investigate
session,sources,inputs=prove_context.accepted_parent(M)
assert 'Factor_Executable_Environment_Values' in sources
for name in ['build.json','check.json']:
 shutil.copyfile(M/'validation'/name,O/name)
helpers={str(Path(x.__file__).resolve()):investigate.file_hash(Path(x.__file__)) for x in [prove_context,investigate,prove_context.proved_code]}
helpers[str(Path(__file__).resolve())]=investigate.file_hash(Path(__file__))
tracked=inputs|helpers
command=['isabelle','export','-n','-d',str(M),'-x',session+'.Factor_Executable_Environment_Values:code/finite_presented_data.ML','-O',str(O/'export'),session]
with (O/'export.log').open('w') as log:
 completed=subprocess.run(command,stdout=log,stderr=subprocess.STDOUT,env={**os.environ,'USER_HOME':'/tmp/structural-isabelle','PYTHONDONTWRITEBYTECODE':'1'},timeout=60)
assert completed.returncode==0
assert all(investigate.file_hash(Path(p))==sha for p,sha in tracked.items())
paths=list((O/'export').rglob('finite_presented_data.ML'));assert len(paths)==1
receipt={'status':'accepted','exit_code':0,'sources_unchanged':True,'sources':sources,
 'proof_kind':'Existing code export from the independently accepted complete session',
 'source_proof':str(M/'validation/check.json'),'source_proof_sha256':inputs[str(M/'validation/check.json')],
 'parent_build_receipt':str(M/'validation/build.json'),'parent_build_sha256':inputs[str(M/'validation/build.json')],
 'export_command':command,'export_inputs':tracked,'exports':[{'path':str(paths[0]),'sha256':investigate.file_hash(paths[0])}]}
(O/'proof.json').write_text(json.dumps(receipt,indent=2)+'\n')
print(json.dumps({'source_status':'accepted','source_theories':len(sources),'export':str(paths[0]),'sha256':receipt['exports'][0]['sha256']}))
