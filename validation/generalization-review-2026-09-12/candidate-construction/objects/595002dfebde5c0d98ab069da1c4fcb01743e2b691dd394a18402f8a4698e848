lemma finite_compatible_union_supported:
  "V |\<in>| finite_compatible_unions B \<longleftrightarrow>
    finite_relation_functional V \<and> ffUnion (ffilter (\<lambda>W. W |\<subseteq>| V) B)=V"
proof
  assume generated: "V |\<in>| finite_compatible_unions B"
  then show "finite_relation_functional V \<and> ffUnion (ffilter (\<lambda>W. W |\<subseteq>| V) B)=V"
    using finite_compatible_union_support[OF generated]
    by (simp only: finite_compatible_union_member; blast)
next
  assume valid: "finite_relation_functional V \<and> ffUnion (ffilter (\<lambda>W. W |\<subseteq>| V) B)=V"
  have included: "ffilter (\<lambda>W. W |\<subseteq>| V) B |\<subseteq>| B" by simp
  show "V |\<in>| finite_compatible_unions B"
    by (simp only: finite_compatible_union_member; intro conjI)
      (use valid in blast, rule exI[of _ "ffilter (\<lambda>W. W |\<subseteq>| V) B"]; use valid included in blast)
qed

lemma finite_compatible_union_scope_supported:
  assumes functional: "finite_relation_functional V"
  shows "V |\<in>| finite_compatible_unions B \<longleftrightarrow>
    fimage fst V |\<subseteq>| fimage fst (ffUnion (ffilter (\<lambda>W. W |\<subseteq>| V) B))"
proof
  assume generated: "V |\<in>| finite_compatible_unions B"
  show "fimage fst V |\<subseteq>| fimage fst (ffUnion (ffilter (\<lambda>W. W |\<subseteq>| V) B))"
    by (simp only: finite_compatible_union_support[OF generated]) simp
next
  let ?U="ffUnion (ffilter (\<lambda>W. W |\<subseteq>| V) B)"
  assume covered: "fimage fst V |\<subseteq>| fimage fst ?U"
  have subset: "?U |\<subseteq>| V" by (auto simp: fsubset_iff ffUnion_membership)
  have domain: "fimage fst ?U=fimage fst V"
    by (rule order_antisym[OF fimage_mono[OF subset] covered])
  have equal: "?U=V" by (rule finite_functional_included_domain[OF functional subset domain])
  show "V |\<in>| finite_compatible_unions B"
    by (simp only: finite_compatible_union_supported; intro conjI functional equal)
qed
