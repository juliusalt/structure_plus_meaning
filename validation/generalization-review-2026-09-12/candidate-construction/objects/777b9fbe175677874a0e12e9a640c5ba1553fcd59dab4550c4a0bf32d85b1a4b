def pin_restored_modules(directory):
    """Resolve every retained helper from its verified restored source file."""
    import importlib.abc
    import importlib.util

    sources = {path.stem: path for path in directory.glob("*.py")}
    for name in sources:
        sys.modules.pop(name, None)

    class RestoredSources(importlib.abc.MetaPathFinder):
        def find_spec(self, fullname, path=None, target=None):
            source = sources.get(fullname)
            return importlib.util.spec_from_file_location(fullname, source) if source else None

    finder = RestoredSources()
    sys.meta_path.insert(0, finder)
    return finder


def timed_data_reports(raw, kind):
    """Compare all native fields, omitting only the declared clock measurements."""
    result = []
    for line in raw.splitlines():
        if kind == "directed_search":
            if line.startswith("SEARCH_STARTED "):
                result.append(line)
            elif line.startswith(("BINDING_INPUT ", "ASSEMBLY_INPUT ", "BINDINGS ", "ASSEMBLY ")):
                label, identifier, value = line.split(" ", 2)
                if label in {"BINDINGS", "ASSEMBLY"}:
                    value, seconds = value.rsplit(" ", 1)
                    assert float(seconds) >= 0
                result.append((label, int(identifier), json.loads(value)))
        elif line.startswith("APPLICATION_"):
            label, identifier, value = line.split(" ", 2)
            data = json.loads(value)
            if label == "APPLICATION_CONSTRUCTION":
                data = dict(data)
                assert float(data.pop("seconds")) >= 0
            result.append((label, int(identifier), data))
    return result


def timed_data_assessment(value):
    """The assessed case family's only measurement is each case's seconds field."""
    result = json.loads(json.dumps(value))
    for case in result["cases"]:
        assert float(case.pop("seconds")) >= 0
    return result


