theory Finite_Indexed_Candidate_Assembly
  imports Finite_Candidate_Assembly
begin

section \<open>Indices present the complete requirement subjects\<close>

definition finite_requirement_subjects where
  "finite_requirement_subjects As=zip [0..<length As] As"

lemma finite_requirement_subject:
  "(i,a)\<in>set (finite_requirement_subjects As) \<longleftrightarrow> i<length As \<and> a=As!i"
  by (auto simp: finite_requirement_subjects_def in_set_zip intro!: exI[of _ i])

definition finite_indexed_part_coverage where
  "finite_indexed_part_coverage As K p=(let covered=K p in
    fset_of_list (map fst (filter (\<lambda>(i,a). a |\<in>| covered) (finite_requirement_subjects As))))"

theorem finite_indexed_part_coverage_subject:
  "i |\<in>| finite_indexed_part_coverage As K p \<longleftrightarrow>
    i<length As \<and> As!i |\<in>| K p"
  by (auto simp: finite_indexed_part_coverage_def Let_def fset_of_list_elem
    finite_requirement_subject split_paired_Ex)

lemma finite_indexed_assembly_coverage:
  "i |\<in>| finite_assembly_coverage (finite_indexed_part_coverage As K) A \<longleftrightarrow>
    i<length As \<and> As!i |\<in>| finite_assembly_coverage K A"
  by (simp only: finite_assembly_coverage_member finite_indexed_part_coverage_subject; blast)

theorem finite_indexed_assembly_sufficient:
  "fset_of_list [0..<length As] |\<subseteq>|
      finite_assembly_coverage (finite_indexed_part_coverage As K) A \<longleftrightarrow>
    fset_of_list As |\<subseteq>| finite_assembly_coverage K A"
  by (auto simp: fsubset_iff fset_of_list_elem finite_indexed_assembly_coverage in_set_conv_nth)

section \<open>The search result retains the original part and requirement language\<close>

definition finite_construct_indexed_candidate where
  "finite_construct_indexed_candidate As Ps K=
    finite_construct_candidate [0..<length As] Ps (finite_indexed_part_coverage As K)"

theorem finite_construct_indexed_candidate_sound:
  assumes built: "finite_construct_indexed_candidate As Ps K=Some A"
  shows "A |\<in>| finite_candidate_assemblies (fset_of_list Ps) (fset_of_list As) K"
    "\<forall>Z. Z |\<subseteq>| A \<and> fset_of_list As |\<subseteq>| finite_assembly_coverage K Z \<longrightarrow> Z=A"
proof -
  have actual: "finite_construct_candidate [0..<length As] Ps (finite_indexed_part_coverage As K)=Some A"
    using built by (simp only: finite_construct_indexed_candidate_def)
  show "A |\<in>| finite_candidate_assemblies (fset_of_list Ps) (fset_of_list As) K"
    using finite_construct_candidate_sound(1)[OF actual]
    by (simp only: finite_candidate_assembly_member finite_indexed_assembly_sufficient)
  show "\<forall>Z. Z |\<subseteq>| A \<and> fset_of_list As |\<subseteq>| finite_assembly_coverage K Z \<longrightarrow> Z=A"
    using finite_construct_candidate_sound(2)[OF actual] by (simp only: finite_indexed_assembly_sufficient)
qed

theorem finite_construct_indexed_candidate_failure:
  "finite_construct_indexed_candidate As Ps K=None \<longleftrightarrow>
    \<not>fset_of_list As |\<subseteq>| finite_assembly_coverage K (fset_of_list Ps)"
  by (simp only: finite_construct_indexed_candidate_def finite_construct_candidate_failure finite_indexed_assembly_sufficient)

theorem finite_construct_indexed_candidate_complete:
  "finite_construct_indexed_candidate As Ps K\<noteq>None \<longleftrightarrow>
    finite_candidate_assemblies (fset_of_list Ps) (fset_of_list As) K\<noteq>{||}"
  by (simp only: finite_construct_indexed_candidate_failure
    finite_construct_candidate_failure[symmetric] finite_construct_candidate_complete)

theorem finite_construct_indexed_candidate_necessity:
  assumes built: "finite_construct_indexed_candidate As Ps K=Some A" and member: "p |\<in>| A"
  shows "\<exists>q. q |\<in>| fset_of_list As \<and> q |\<in>| K p \<and>
    q |\<notin>| finite_assembly_coverage K (A |-| {|p|})"
proof -
  have actual: "finite_construct_candidate [0..<length As] Ps (finite_indexed_part_coverage As K)=Some A"
    using built by (simp only: finite_construct_indexed_candidate_def)
  obtain i where witness: "i |\<in>| finite_indexed_part_coverage As K p"
    "i |\<notin>| finite_assembly_coverage (finite_indexed_part_coverage As K) (A |-| {|p|})"
    using finite_construct_candidate_necessity_witness[OF actual member] by blast
  have facts: "i<length As" "As!i |\<in>| K p"
    "As!i |\<notin>| finite_assembly_coverage K (A |-| {|p|})"
    using witness by (auto simp: finite_indexed_part_coverage_subject finite_indexed_assembly_coverage)
  show ?thesis by (rule exI[of _ "As!i"]) (use facts in \<open>auto simp: fset_of_list_elem\<close>)
qed

text \<open>
  Every index presents a complete original requirement through the exact source
  map. Coverage at that index is equivalent to the original part covering that
  requirement. Indexing changes neither the full subset language nor existence,
  sufficiency or inclusion minimality. Repeated presentations retain their
  source equations. Search can compare compact indices while the source map
  and removal witnesses retain the actual structural requirements.
\<close>

export_code finite_construct_indexed_candidate checking SML

end
