fun finite_artifact_enumeration c a e b f =
  finite_exact_formed c andalso
    (distinct (equal_list equal_nat) a andalso
      (distinct
         (equal_prod (equal_list equal_nat)
           (equal_prod (equal_list equal_nat) (equal_list equal_nat)))
         e andalso
        (distinct (equal_prod (equal_list equal_nat) (equal_list equal_nat))
           f andalso
          equal_finite_structured_object_ext (equal_list equal_nat)
            (equal_list equal_nat) equal_unit c
            (finite_enumerated_artifact a e b f))));

fun finite_material_observation (Finite_Target (Finite_Whole c)) atoms edges
  counts functions =
  (case (finite_enumeration_read (finite_atom_read c) atoms,
          (finite_enumeration_read (finite_incidence_read c) edges,
            (finite_enumeration_read (finite_attachment_read c) counts,
              finite_enumeration_read (finite_attachment_read c) functions)))
    of (NONE, _) => false | (SOME _, (NONE, _)) => false
    | (SOME _, (SOME _, (NONE, _))) => false
    | (SOME _, (SOME _, (SOME _, NONE))) => false
    | (SOME a, (SOME e, (SOME ba, SOME b))) =>
      finite_artifact_enumeration c a e ba b)
  | finite_material_observation (Finite_Target (Finite_Anchor (va, vb))) atoms
    edges counts functions = false
  | finite_material_observation (Finite_Payload v) atoms edges counts functions
    = false
  | finite_material_observation (Finite_Pair (v, va)) atoms edges counts
    functions = false;

fun finite_pattern_instances A_ v (Finite_Variable a) =
  fimage snd (ffilter (fn x => eq A_ (fst x) a) v)
  | finite_pattern_instances A_ v (Finite_Pattern_Target t) =
    (if finite_target_formed t
      then finsert equal_finite_factor_term (Finite_Target t) bot_fset
      else bot_fset)
  | finite_pattern_instances A_ va (Finite_Pattern_Payload v) =
    (if octets_formed v
      then finsert equal_finite_factor_term (Finite_Payload v) bot_fset
      else bot_fset)
  | finite_pattern_instances A_ v (Finite_Pattern_Pair (p, q)) =
    ffUnion equal_finite_factor_term
      (fimage
        (fn x =>
          fimage (fn a => Finite_Pair (x, a)) (finite_pattern_instances A_ v q))
        (finite_pattern_instances A_ v p));

fun finite_material_satisfied A_ v m =
  bex (fset (finite_pattern_instances A_ v (finite_material_source m)))
    (fn s =>
      bex (fset (finite_pattern_instances A_ v (finite_material_atoms m)))
        (fn a =>
          bex (fset (finite_pattern_instances A_ v (finite_material_edges m)))
            (fn e =>
              bex (fset (finite_pattern_instances A_ v
                          (finite_material_counts m)))
                (fn b =>
                  bex (fset (finite_pattern_instances A_ v
                              (finite_material_functions m)))
                    (finite_material_observation s a e b)))));

fun finite_schema_material_satisfied A_ s v =
  ball (fset (finite_schema_materials s))
    (fn (_, a) => finite_material_satisfied A_ v a);

fun finite_premise_set_joins A_ B_ C_ [] c =
  finsert
    (equal_prod (equal_fset (equal_prod C_ equal_finite_factor_term))
      (equal_fset (equal_prod A_ (equal_prod B_ equal_finite_factor_term))))
    (bot_fset, bot_fset) bot_fset
  | finite_premise_set_joins A_ B_ C_ ((s, (d, p)) :: ps) c =
    ffUnion
      (equal_prod (equal_fset (equal_prod C_ equal_finite_factor_term))
        (equal_fset (equal_prod A_ (equal_prod B_ equal_finite_factor_term))))
      (fimage
        (fn (v, h) =>
          fimage
            (fn (e, t) =>
              (sup_fset (equal_prod C_ equal_finite_factor_term) v
                 (finite_matching_bindings C_ p t),
                finsert (equal_prod A_ (equal_prod B_ equal_finite_factor_term))
                  (s, (e, t)) h))
            (ffilter
              (fn (e, t) =>
                eq B_ e d andalso
                  (finite_pattern_accepts C_ p t andalso
                    finite_relation_functional C_ equal_finite_factor_term
                      (sup_fset (equal_prod C_ equal_finite_factor_term) v
                        (finite_matching_bindings C_ p t))))
              c))
        (finite_premise_set_joins A_ B_ C_ ps c));

fun finite_schema_generation_on_set A_ B_ C_ s ps c =
  (if finite_schema_formed A_ B_ C_ s andalso
        equal_set (equal_prod B_ (equal_prod C_ (equal_finite_term_pattern A_)))
          (Set ps) (fset (finite_schema_premises s))
    then ffUnion
           (equal_prod equal_finite_factor_term
             (equal_prod (equal_fset (equal_prod A_ equal_finite_factor_term))
               (equal_fset
                 (equal_prod B_ (equal_prod C_ equal_finite_factor_term)))))
           (fimage
             (fn (v, h) =>
               fimage (fn t => (t, (v, h)))
                 (ffilter
                   (fn t =>
                     finite_schema_instance A_ B_ C_ s v t h andalso
                       finite_schema_material_satisfied A_ s v)
                   (finite_pattern_instances A_ v
                     (finite_schema_conclusion s))))
             (finite_premise_set_joins B_ C_ A_ ps c))
    else bot_fset);

fun finite_generated_applications_on_set A_ B_ C_ D_ l c =
  ffUnion
    (equal_prod A_
      (equal_prod (equal_finite_factor_schema_ext B_ C_ D_ equal_unit)
        (equal_prod equal_finite_factor_term
          (equal_prod (equal_fset (equal_prod B_ equal_finite_factor_term))
            (equal_fset
              (equal_prod C_ (equal_prod D_ equal_finite_factor_term)))))))
    (fimage
      (fn (d, (s, ps)) =>
        fimage (fn (t, (v, h)) => (d, (s, (t, (v, h)))))
          (finite_schema_generation_on_set B_ C_ D_ s ps c))
      (fset_of_list l));

fun finite_instantiated_premises A_ B_ C_ s v =
  ffUnion (equal_prod B_ (equal_prod C_ equal_finite_factor_term))
    (fimage
      (fn (sa, (d, p)) =>
        fimage (fn t => (sa, (d, t))) (finite_pattern_instances A_ v p))
      (finite_schema_premises s));

fun finite_requested_schema_applications A_ B_ C_ s t =
  let
    val v = finite_matching_bindings A_ (finite_schema_conclusion s) t;
    val h = finite_instantiated_premises A_ B_ C_ s v;
  in
    (if finite_schema_instance A_ B_ C_ s v t h andalso
          finite_schema_material_satisfied A_ s v
      then finsert
             (equal_prod equal_finite_factor_term
               (equal_prod (equal_fset (equal_prod A_ equal_finite_factor_term))
                 (equal_fset
                   (equal_prod B_ (equal_prod C_ equal_finite_factor_term)))))
             (t, (v, h)) bot_fset
      else bot_fset)
  end;

fun finite_requested_applications A_ B_ C_ D_ l q =
  ffUnion
    (equal_prod A_
      (equal_prod (equal_finite_factor_schema_ext B_ C_ D_ equal_unit)
        (equal_prod equal_finite_factor_term
          (equal_prod (equal_fset (equal_prod B_ equal_finite_factor_term))
            (equal_fset
              (equal_prod C_ (equal_prod D_ equal_finite_factor_term)))))))
    (fimage
      (fn (d, (s, ps)) =>
        (if equal_set
              (equal_prod C_ (equal_prod D_ (equal_finite_term_pattern B_)))
              (Set ps) (fset (finite_schema_premises s))
          then ffUnion
                 (equal_prod A_
                   (equal_prod
                     (equal_finite_factor_schema_ext B_ C_ D_ equal_unit)
                     (equal_prod equal_finite_factor_term
                       (equal_prod
                         (equal_fset (equal_prod B_ equal_finite_factor_term))
                         (equal_fset
                           (equal_prod C_
                             (equal_prod D_ equal_finite_factor_term)))))))
                 (fimage
                   (fn (_, t) =>
                     fimage (fn (qa, (v, h)) => (d, (s, (qa, (v, h)))))
                       (finite_requested_schema_applications B_ C_ D_ s t))
                   (ffilter (fn qa => eq A_ (fst qa) d) q))
          else bot_fset))
      (fset_of_list l));

fun finite_schema_observation_sources A_ B_ C_ s =
  finsert
    (equal_prod (equal_finite_schema_observation_site B_ C_)
      (equal_finite_term_pattern A_))
    (Finite_Conclusion_Site, finite_schema_conclusion s)
    (sup_fset
      (equal_prod (equal_finite_schema_observation_site B_ C_)
        (equal_finite_term_pattern A_))
      (fimage (fn (sa, (d, a)) => (Finite_Premise_Site (sa, d), a))
        (finite_schema_premises s))
      (ffUnion
        (equal_prod (equal_finite_schema_observation_site B_ C_)
          (equal_finite_term_pattern A_))
        (fimage
          (fn (sa, m) =>
            fset_of_list
              [(Finite_Material_Source_Site sa, finite_material_source m),
                (Finite_Material_Atoms_Site sa, finite_material_atoms m),
                (Finite_Material_Edges_Site sa, finite_material_edges m),
                (Finite_Material_Counts_Site sa, finite_material_counts m),
                (Finite_Material_Functions_Site sa,
                  finite_material_functions m)])
          (finite_schema_materials s))));

fun finite_compatible_binding_parts A_ B_ scope b u =
  ffilter
    (fn w =>
      less_eq_fset A_ (fimage fst w) scope andalso
        finite_relation_functional A_ B_ (sup_fset (equal_prod A_ B_) u w))
    b;

fun finite_assignment_agrees A_ B_ r w =
  ball (fset w)
    (fn s => (if eq A_ (fst s) (fst r) then eq B_ (snd s) (snd r) else true));

fun finite_value_binding_search A_ B_ n asa b u =
  (if equal_nata n zero_nat
    then (if eq (equal_fset A_) (fimage fst u) (fset_of_list asa) andalso
               less_eq_fset A_ (fset_of_list asa)
                 (fimage fst (ffUnion (equal_prod A_ B_) b))
           then finsert (equal_fset (equal_prod A_ B_)) u bot_fset
           else bot_fset)
    else let
           val m = ffUnion (equal_prod A_ B_) b;
         in
           (if not (less_eq_fset A_ (fset_of_list asa) (fimage fst m))
             then bot_fset
             else (case finite_demand_choice A_ linorder_nat
                          (fn a =>
                            fcard (equal_prod A_ B_)
                              (ffilter (fn r => eq A_ (fst r) a) m))
                          asa (fimage fst u)
                    of NONE =>
                      finsert (equal_fset (equal_prod A_ B_)) u bot_fset
                    | SOME a =>
                      ffUnion (equal_fset (equal_prod A_ B_))
                        (fimage
                          (fn r =>
                            finite_value_binding_search A_ B_
                              (minus_nat n one_nat) asa
                              (ffilter (finite_assignment_agrees A_ B_ r) b)
                              (finsert (equal_prod A_ B_) r u))
                          (ffilter (fn r => eq A_ (fst r) a) m))))
         end);

fun set_scoped_compatible_unions A_ B_ (Set asa) b =
  finite_value_binding_search A_ B_ (fcard A_ (fset_of_list asa)) asa
    (finite_compatible_binding_parts A_ B_ (fset_of_list asa) b bot_fset)
    bot_fset;

fun finite_scoped_compatible_unions A_ B_ scope b =
  set_scoped_compatible_unions A_ B_ (fset scope) b;

fun finite_observed_schema_applications A_ B_ C_ s obs =
  ffUnion
    (equal_prod equal_finite_factor_term
      (equal_prod (equal_fset (equal_prod A_ equal_finite_factor_term))
        (equal_fset (equal_prod B_ (equal_prod C_ equal_finite_factor_term)))))
    (fimage
      (fn v =>
        let
          val h = finite_instantiated_premises A_ B_ C_ s v;
        in
          fimage (fn t => (t, (v, h)))
            (ffilter
              (fn t =>
                finite_schema_instance A_ B_ C_ s v t h andalso
                  finite_schema_material_satisfied A_ s v)
              (finite_pattern_instances A_ v (finite_schema_conclusion s)))
        end)
      (finite_scoped_compatible_unions A_ equal_finite_factor_term
        (finite_schema_variables A_ s)
        (fimage (fn (_, (a, b)) => finite_matching_bindings A_ a b)
          (finite_pattern_observations
            (equal_finite_schema_observation_site B_ C_) A_
            (finite_schema_observation_sources A_ B_ C_ s) obs))));

fun finite_schema_call_observations A_ C_ D_ F_ d s c q =
  sup_fset (equal_prod (equal_finite_schema_observation_site C_ D_) F_)
    (fimage (fn (_, a) => (Finite_Conclusion_Site, a))
      (ffilter (fn (e, _) => eq A_ e d) q))
    (ffUnion (equal_prod (equal_finite_schema_observation_site C_ D_) F_)
      (fimage
        (fn (sa, (e, _)) =>
          fimage (fn (_, a) => (Finite_Premise_Site (sa, e), a))
            (ffilter (fn (f, _) => eq D_ f e) c))
        (finite_schema_premises s)));

fun finite_guided_applications A_ B_ C_ D_ l c q =
  ffUnion
    (equal_prod A_
      (equal_prod (equal_finite_factor_schema_ext B_ C_ D_ equal_unit)
        (equal_prod equal_finite_factor_term
          (equal_prod (equal_fset (equal_prod B_ equal_finite_factor_term))
            (equal_fset
              (equal_prod C_ (equal_prod D_ equal_finite_factor_term)))))))
    (fimage
      (fn (d, (s, ps)) =>
        (if equal_set
              (equal_prod C_ (equal_prod D_ (equal_finite_term_pattern B_)))
              (Set ps) (fset (finite_schema_premises s))
          then fimage (fn (t, (v, h)) => (d, (s, (t, (v, h)))))
                 (finite_observed_schema_applications B_ C_ D_ s
                   (finite_schema_call_observations A_ C_ D_
                     equal_finite_factor_term d s c q))
          else bot_fset))
      (fset_of_list l));

fun application_construction_result Separate_Application_Sources p =
  fimage (fn (_, (_, (t, (v, h)))) => (t, (v, h)))
    (sup_fset
      (equal_prod equal_nat
        (equal_prod
          (equal_finite_factor_schema_ext equal_nat equal_nat equal_nat
            equal_unit)
          (equal_prod equal_finite_factor_term
            (equal_prod
              (equal_fset (equal_prod equal_nat equal_finite_factor_term))
              (equal_fset
                (equal_prod equal_nat
                  (equal_prod equal_nat equal_finite_factor_term)))))))
      (finite_generated_applications_on_set equal_nat equal_nat equal_nat
        equal_nat
        [(application_entry p,
           (application_schema p, application_enumeration p))]
        (application_frontier p))
      (finite_requested_applications equal_nat equal_nat equal_nat equal_nat
        [(application_entry p,
           (application_schema p, application_enumeration p))]
        (application_requests p)))
  | application_construction_result Joined_Application_Observations p =
    fimage (fn (_, (_, (t, (v, h)))) => (t, (v, h)))
      (finite_guided_applications equal_nat equal_nat equal_nat equal_nat
        [(application_entry p,
           (application_schema p, application_enumeration p))]
        (application_frontier p) (application_requests p));

fun application_mandatory_targets p =
  sup_fset
    (equal_prod equal_finite_factor_term
      (equal_prod (equal_fset (equal_prod equal_nat equal_finite_factor_term))
        (equal_fset
          (equal_prod equal_nat
            (equal_prod equal_nat equal_finite_factor_term)))))
    (application_required p)
    (application_construction_result Separate_Application_Sources p);

fun application_instances_valid A_ B_ C_ s a =
  ball (fset a)
    (fn (t, (v, h)) =>
      finite_schema_instance A_ B_ C_ s v t h andalso
        finite_schema_material_satisfied A_ s v);

fun application_construction_case_formed p xs =
  equal_fseta
    (equal_prod equal_finite_factor_term
      (equal_prod (equal_fset (equal_prod equal_nat equal_finite_factor_term))
        (equal_fset
          (equal_prod equal_nat
            (equal_prod equal_nat equal_finite_factor_term)))))
    (fset_of_list xs) (application_mandatory_targets p) andalso
    (finite_schema_formed equal_nat equal_nat equal_nat
       (application_schema p) andalso
      (ball (sup_set (equal_prod equal_nat equal_finite_factor_term)
              (fset (application_frontier p)) (fset (application_requests p)))
         (fn q => finite_term_formed (snd q)) andalso
        (equal_set
           (equal_prod equal_nat
             (equal_prod equal_nat (equal_finite_term_pattern equal_nat)))
           (Set (application_enumeration p))
           (fset (finite_schema_premises (application_schema p))) andalso
          application_instances_valid equal_nat equal_nat equal_nat
            (application_schema p) (fset_of_list xs))));

fun application_construction_cases_formed cs =
  list_all (fn (a, b) => application_construction_case_formed a b) cs;

fun finite_requirement_subjects asa = zip (upt zero_nat (size_list asa)) asa;

fun application_plan_requirements cs =
  maps (fn (p, a) =>
         maps (fn x =>
                map (fn aa => (p, (x, aa)))
                  (sorted_list_of_fset (equal_nat, linorder_nat)
                    (finite_schema_variables equal_nat (application_schema p))))
           a)
    cs;

fun application_requirement_subjects cs =
  finite_requirement_subjects (application_plan_requirements cs);

fun application_problem_observations p =
  finite_schema_call_observations equal_nat equal_nat equal_nat
    equal_finite_factor_term (application_entry p) (application_schema p)
    (application_frontier p) (application_requests p);

fun finite_selected_observations A_ a obs =
  ffilter (fn (i, _) => member A_ i (fset a)) obs;

fun finite_observation_union B_ m =
  ffUnion (equal_prod B_ equal_finite_factor_term)
    (fimage (fn (_, (a, b)) => finite_matching_bindings B_ a b) m);

fun finite_observation_site_coverage A_ B_ p obs v i =
  fimage fst
    (finite_observation_union B_
      (finite_binding_support A_ B_ p
        (finite_selected_observations A_ (finsert A_ i bot_fset) obs) v));

fun application_requirement_covered i q =
  let
    val (p, ((_, (v, _)), a)) = q;
  in
    member equal_nat a
      (fset (finite_observation_site_coverage
              (equal_finite_schema_observation_site equal_nat equal_nat)
              equal_nat
              (finite_schema_observation_sources equal_nat equal_nat equal_nat
                (application_schema p))
              (application_problem_observations p) v i))
  end;

fun application_indexed_part_coverage cs p =
  fset_of_list
    (map_filter
      (fn x =>
        (if let
              val (_, a) = x;
            in
              application_requirement_covered p a
            end
          then SOME (fst x) else NONE))
      (application_requirement_subjects cs));

fun finite_construct_candidate A_ B_ asa ps k =
  let
    val table = map (fn p => (p, k p)) ps;
    val cached =
      (fn p => (case map_of B_ table p of NONE => k p | SOME value => value));
  in
    map_option (finite_prune_assembly B_ A_ ps cached (fset_of_list asa))
      (finite_assembly_search A_ B_ (fcard A_ (fset_of_list asa)) asa ps cached
        bot_fset)
  end;

fun application_construct_plan ps cs =
  (if application_construction_cases_formed cs
    then finite_construct_candidate equal_nat
           (equal_finite_schema_observation_site equal_nat equal_nat)
           (upt zero_nat (size_list (application_plan_requirements cs))) ps
           (application_indexed_part_coverage cs)
    else NONE);

fun application_candidate_subjects ps cs =
  (case application_construct_plan ps cs of NONE => bot_fset
    | SOME a =>
      finsert
        (equal_prod equal_nat
          (equal_fset
            (equal_finite_schema_observation_site equal_nat equal_nat)))
        (zero_nat, a) bot_fset);

fun application_plan_result a p =
  (if equal_set
        (equal_prod equal_nat
          (equal_prod equal_nat (equal_finite_term_pattern equal_nat)))
        (Set (application_enumeration p))
        (fset (finite_schema_premises (application_schema p)))
    then finite_observed_schema_applications equal_nat equal_nat equal_nat
           (application_schema p)
           (finite_selected_observations
             (equal_finite_schema_observation_site equal_nat equal_nat) a
             (application_problem_observations p))
    else bot_fset);

fun application_condition_holds Complete_Instance_Condition a p =
  application_instances_valid equal_nat equal_nat equal_nat
    (application_schema p) (application_plan_result a p)
  | application_condition_holds Existing_Application_Condition a p =
    less_eq_fset
      (equal_prod equal_finite_factor_term
        (equal_prod (equal_fset (equal_prod equal_nat equal_finite_factor_term))
          (equal_fset
            (equal_prod equal_nat
              (equal_prod equal_nat equal_finite_factor_term)))))
      (application_construction_result Separate_Application_Sources p)
      (application_plan_result a p)
  | application_condition_holds Required_Application_Condition a p =
    less_eq_fset
      (equal_prod equal_finite_factor_term
        (equal_prod (equal_fset (equal_prod equal_nat equal_finite_factor_term))
          (equal_fset
            (equal_prod equal_nat
              (equal_prod equal_nat equal_finite_factor_term)))))
      (application_required p) (application_plan_result a p);

fun finite_derived_observations A_ C_ E_ c u w p =
  ffUnion (equal_prod C_ (equal_prod A_ E_))
    (fimage
      (fn (f, ua) =>
        ffUnion (equal_prod C_ (equal_prod A_ E_))
          (fimage
            (fn (ca, s) =>
              fimage (fn (wa, _) => (f, (ca, wa)))
                (ffilter (fn (_, a) => p ua s a) w))
            c))
      u);

fun application_observations A_ ps cs w =
  finite_derived_observations equal_nat equal_nat A_
    (application_candidate_subjects ps cs) application_condition_subjects w
    application_condition_holds;

fun application_comparison A_ ps cs w =
  ffilter
    (fn (c, d) =>
      less_eq_fset (equal_prod equal_nat A_)
        (finite_candidate_profile equal_nat equal_nat
          (fimage fst application_condition_subjects)
          (application_observations A_ ps cs w) c)
        (finite_candidate_profile equal_nat equal_nat
          (fimage fst application_condition_subjects)
          (application_observations A_ ps cs w) d))
    (ffUnion (equal_prod equal_nat equal_nat)
      (fimage
        (fn (c, _) =>
          fimage (fn (d, _) => (c, d)) (application_candidate_subjects ps cs))
        (application_candidate_subjects ps cs)));

fun natural_binding_support p e v =
  finite_binding_support
    (equal_finite_schema_observation_site equal_nat equal_nat) equal_nat p e v;

fun finite_available_observation_repairs A_ B_ C_ c relation u f table =
  let
    val a =
      ffilter (fn fa => not (member B_ fa (fset f)))
        (finite_sound_observation_facets A_ B_ C_ c relation u table);
  in
    ffUnion (equal_prod A_ (equal_prod A_ (equal_prod B_ C_)))
      (fimage
        (fn (ca, d) =>
          (if relation ca d then bot_fset
            else fimage (fn (fa, w) => (ca, (d, (fa, w))))
                   (finite_candidate_losses B_ A_ C_ a table ca d)))
        (finite_basis_residual A_ B_ C_ c f table relation))
  end;

fun finite_unrepairable_comparisons A_ B_ C_ c relation u table =
  finite_basis_residual A_ B_ C_ c
    (finite_sound_observation_facets A_ B_ C_ c relation u table) table
    relation;

fun finite_observation_conflicts A_ B_ C_ c relation f table =
  ffUnion (equal_prod A_ (equal_prod A_ (equal_prod B_ C_)))
    (fimage
      (fn ca =>
        ffUnion (equal_prod A_ (equal_prod A_ (equal_prod B_ C_)))
          (fimage
            (fn d =>
              (if relation ca d
                then fimage (fn (fa, w) => (ca, (d, (fa, w))))
                       (finite_candidate_losses B_ A_ C_ f table ca d)
                else bot_fset))
            c))
      c);

fun investigation_loss_rows candidates observations =
  maps (fn (c, d) => map (fn (f, (_, w)) => (c, (d, (f, w)))) observations)
    (investigation_pairs candidates);

fun investigation_repairs candidates facets selected observations relation =
  let
    val c = fset_of_list candidates;
    val u = fset_of_list facets;
    val f = fset_of_list selected;
    val table = fset_of_list observations;
    val compare =
      (fn ca => fn d =>
        membera (equal_prod equal_nat equal_nat) relation (ca, d));
    val loss_rows = investigation_loss_rows candidates observations;
  in
    (investigation_select equal_nat facets
       (finite_sound_observation_facets equal_nat equal_nat equal_nat c compare
         u table),
      (investigation_select
         (equal_prod equal_nat
           (equal_prod equal_nat (equal_prod equal_nat equal_nat)))
         loss_rows
         (finite_observation_conflicts equal_nat equal_nat equal_nat c compare f
           table),
        (investigation_select
           (equal_prod equal_nat
             (equal_prod equal_nat (equal_prod equal_nat equal_nat)))
           loss_rows
           (finite_available_observation_repairs equal_nat equal_nat equal_nat c
             compare u f table),
          investigation_select (equal_prod equal_nat equal_nat)
            (investigation_pairs candidates)
            (finite_unrepairable_comparisons equal_nat equal_nat equal_nat c
              compare u table))))
  end;

fun make_application_problem d s ps c q r =
  Finite_application_problem_ext (d, s, ps, c, q, r, ());

fun finite_join_observations A_ B_ p e =
  let
    val m = finite_pattern_observations A_ B_ p e;
    val v = finite_observation_union B_ m;
  in
    (if finite_relation_functional A_ (equal_finite_term_pattern B_) p andalso
          (equal_fseta (equal_prod A_ equal_finite_factor_term)
             (fimage (fn (i, (_, a)) => (i, a)) m) e andalso
            finite_relation_functional B_ equal_finite_factor_term v)
      then SOME v else NONE)
  end;

fun natural_observation_join p e =
  finite_join_observations
    (equal_finite_schema_observation_site equal_nat equal_nat) equal_nat p e;

fun finite_observed_bindings A_ B_ p obs =
  finite_compatible_unions B_ equal_finite_factor_term
    (fimage (fn (_, (a, b)) => finite_matching_bindings B_ a b)
      (finite_pattern_observations A_ B_ p obs));

fun investigation_revision candidates facets selected observations relation =
  let
    val retained =
      investigation_retain candidates facets selected observations relation;
    val withdrawn =
      filtera (fn f => not (membera equal_nat retained f))
        (remdups equal_nat selected);
    val repairs =
      fst (snd (snd (investigation_repairs candidates facets retained
                      observations relation)));
    val revised = investigation_extend retained repairs;
    val residual =
      fst (snd (investigation_basis candidates facets revised observations
                 relation));
  in
    (retained, (withdrawn, (repairs, (revised, residual))))
  end;

fun natural_observed_bindings p e =
  finite_observed_bindings
    (equal_finite_schema_observation_site equal_nat equal_nat) equal_nat p e;

fun finite_reasoning_term_equal t u = equal_finite_factor_terma t u;

fun application_part_coverage cs i =
  ffilter (application_requirement_covered i)
    (fset_of_list (application_plan_requirements cs));

fun application_investigation_observations ps cs ws =
  sorted_list_of_fset
    (equal_prod equal_nat (equal_prod equal_nat equal_nat),
      linorder_prod linorder_nat (linorder_prod linorder_nat linorder_nat))
    (application_observations equal_nat ps cs (fset_of_list ws));

fun application_investigation_candidates ps cs =
  sorted_list_of_fset (equal_nat, linorder_nat)
    (fimage fst (application_candidate_subjects ps cs));

fun application_investigation_relation ps cs ws =
  sorted_list_of_fset
    (equal_prod equal_nat equal_nat, linorder_prod linorder_nat linorder_nat)
    (application_comparison equal_nat ps cs (fset_of_list ws));

fun application_uncovered_requirements ps cs =
  let
    val qs = application_plan_requirements cs;
  in
    fimage (nth qs)
      (minus_fset equal_nat (fset_of_list (upt zero_nat (size_list qs)))
        (finite_assembly_coverage equal_nat
          (application_indexed_part_coverage cs) (fset_of_list ps)))
  end;

fun application_construction_report ps cs =
  (application_construction_cases_formed cs,
    (application_uncovered_requirements ps cs,
      application_construct_plan ps cs));

fun application_investigation ps cs ws selected =
  (application_construction_report ps cs,
    investigation_basis (application_investigation_candidates ps cs)
      [zero_nat, one_nat, nat_of_integer (2 : IntInf.int)] selected
      (application_investigation_observations ps cs ws)
      (application_investigation_relation ps cs ws));

fun application_plan_sufficient cs a =
  list_all
    (fn (p, _) =>
      less_eq_fset
        (equal_prod equal_finite_factor_term
          (equal_prod
            (equal_fset (equal_prod equal_nat equal_finite_factor_term))
            (equal_fset
              (equal_prod equal_nat
                (equal_prod equal_nat equal_finite_factor_term)))))
        (application_mandatory_targets p) (application_plan_result a p))
    cs;

fun application_observation_scope ps cs ws =
  finite_relation_functional equal_nat
    (equal_fset (equal_finite_schema_observation_site equal_nat equal_nat))
    (application_candidate_subjects ps cs) andalso
    (finite_relation_functional equal_nat equal_application_condition
       application_condition_subjects andalso
      finite_relation_functional equal_nat
        (equal_finite_application_problem_ext equal_unit) (fset_of_list ws));

fun natural_schema_call_observations d s c q =
  finite_schema_call_observations equal_nat equal_nat equal_nat
    equal_finite_factor_term d s c q;

fun natural_schema_observation_sources s =
  finite_schema_observation_sources equal_nat equal_nat equal_nat s;

fun natural_observed_schema_applications s obs =
  finite_observed_schema_applications equal_nat equal_nat equal_nat s obs;

end; (*struct Application_Comparison*)
