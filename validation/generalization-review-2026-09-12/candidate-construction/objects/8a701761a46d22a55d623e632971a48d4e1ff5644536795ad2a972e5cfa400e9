 assert replay.timed_data_assessment(mapped)==replay.timed_data_assessment(before)
 result={'status':'accepted','baseline':str(baseline),'new':str(D/label),'complete_cases':len(current),'outer_case_index_map':list(enumerate(ids)),'boundary':'Complete supplied input rows agree under their explicit outer case enumeration map. Every mathematical report and per-part witness agrees; only declared clocks vary.'}
 (D/(label+'-preservation.json')).write_text(json.dumps(result,indent=2)+'\n');print(json.dumps(result),flush=True)
