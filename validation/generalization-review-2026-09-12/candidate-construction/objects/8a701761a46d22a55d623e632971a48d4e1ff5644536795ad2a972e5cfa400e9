"""Run the supplied-input adapter and compare every original complete case."""
from pathlib import Path
import json,os,subprocess,sys
B=Path(__file__).parent;W=B/'worktree';M=Path('/home/julius/structure_and_semantics')
sys.path.insert(0,str(W/'tools'))
import check_application_comparison as adapter,replay_reasoning_review as replay
