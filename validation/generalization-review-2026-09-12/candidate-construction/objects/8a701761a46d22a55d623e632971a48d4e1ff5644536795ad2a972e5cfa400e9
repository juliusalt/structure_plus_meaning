 with (D/(label+'.log')).open('w') as log:
  r=subprocess.run(list(map(str,command)),cwd=W,env=ENV,stdout=log,stderr=subprocess.STDOUT,timeout=150)
 step={'label':label,'command':list(map(str,command)),'exit_code':r.returncode,'log':str(D/(label+'.log'))}
 steps.append(step);(D/'steps.json').write_text(json.dumps(steps,indent=2)+'\n');print(json.dumps(step),flush=True)
 return r.returncode
