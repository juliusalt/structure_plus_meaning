theory Factor_Application_Comparison
  imports "Factor_Application_Candidates" "RRA_Factor_Structural_Bootstrap.Finite_Derived_Observations" "HOL-Library.Product_Lexorder"
begin

datatype application_condition =
    Complete_Instance_Condition
  | Existing_Application_Condition
  | Required_Application_Condition

fun application_condition_holds where
  "application_condition_holds Complete_Instance_Condition A P=
    application_instances_valid (application_schema P) (application_plan_result A P)"
| "application_condition_holds Existing_Application_Condition A P=
    (application_construction_result Separate_Application_Sources P |\<subseteq>| application_plan_result A P)"
| "application_condition_holds Required_Application_Condition A P=
    (application_required P |\<subseteq>| application_plan_result A P)"

definition application_condition_subjects where
  "application_condition_subjects=fset_of_list
    [(0::nat,Complete_Instance_Condition),(1,Existing_Application_Condition),(2,Required_Application_Condition)]"

lemma application_candidate_subjects_functional:
  "single_valued (fset (application_candidate_subjects Ps Cs))"
  by (auto simp: single_valued_def application_candidate_subjects_def split: option.splits)

definition application_observations where
  "application_observations Ps Cs W=finite_derived_observations (application_candidate_subjects Ps Cs)
    application_condition_subjects W application_condition_holds"

theorem application_observation_subject:
  assumes workloads: "single_valued (fset W)"
    and candidate: "(c,A) |\<in>| application_candidate_subjects Ps Cs"
    and condition: "(f,r) |\<in>| application_condition_subjects"
    and problem: "(w,P) |\<in>| W"
  shows "(f,c,w) |\<in>| application_observations Ps Cs W \<longleftrightarrow> application_condition_holds r A P"
  unfolding application_observations_def
  apply (rule finite_derived_observation_at_subject[OF _ candidate condition problem])
  using workloads application_candidate_subjects_functional[of Ps Cs]
  by (auto simp: finite_observation_subjects_formed_def application_condition_subjects_def
    single_valued_def fset_of_list.rep_eq)

theorem application_observation_required:
  assumes workloads: "single_valued (fset W)" and problem: "(w,P) |\<in>| W"
    and built: "application_construct_plan Ps Cs=Some A"
  shows "(2,0,w) |\<in>| application_observations Ps Cs W \<longleftrightarrow>
    application_required P |\<subseteq>| application_plan_result A P"
  using application_observation_subject[OF workloads, of 0 A Ps Cs 2 Required_Application_Condition w P]
    problem built
  by (simp add: application_candidate_subject application_condition_subjects_def fset_of_list.rep_eq)

definition application_comparison where
  "application_comparison Ps Cs W=ffilter (\<lambda>(c,d).
    finite_candidate_profile (fimage fst application_condition_subjects) (application_observations Ps Cs W) c
      |\<subseteq>| finite_candidate_profile (fimage fst application_condition_subjects) (application_observations Ps Cs W) d)
    (ffUnion (fimage (\<lambda>(c,A). fimage (\<lambda>(d,B). (c,d)) (application_candidate_subjects Ps Cs))
      (application_candidate_subjects Ps Cs)))"

definition application_investigation_candidates where
  "application_investigation_candidates Ps Cs=sorted_list_of_fset (fimage fst (application_candidate_subjects Ps Cs))"

definition application_investigation_observations where
  "application_investigation_observations Ps Cs (Ws::(nat\<times>finite_application_problem) list)=
    sorted_list_of_fset (application_observations Ps Cs (fset_of_list Ws))"

definition application_investigation_relation where
  "application_investigation_relation Ps Cs (Ws::(nat\<times>finite_application_problem) list)=
    sorted_list_of_fset (application_comparison Ps Cs (fset_of_list Ws))"

definition application_investigation where
  "application_investigation Ps Cs Ws selected=(application_construction_report Ps Cs,
    investigation_basis (application_investigation_candidates Ps Cs) [0,1,2] selected
      (application_investigation_observations Ps Cs Ws) (application_investigation_relation Ps Cs Ws))"

text \<open>
  Candidate subjects come from the checked source-site constructor. The separate
  construction report states input validity, uncovered requirements and whether
  a plan was found. An empty comparison basis cannot replace that report.
  Comparison conditions execute the constructed plan on complete problem
  records. Their indexed observation equation retains the actual plan, condition
  and problem as subjects. The constructor's subset language and completeness
  theorem state its search scope independently of the returned candidate list.
\<close>

end
