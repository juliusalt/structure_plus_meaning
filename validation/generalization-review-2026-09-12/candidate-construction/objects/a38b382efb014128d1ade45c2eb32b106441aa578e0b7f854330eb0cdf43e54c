theory Factor_Application_Candidates
  imports "Factor_Application_Problems" "Factor_Observation_Assembly"
begin

type_synonym finite_application_plan = "(nat,nat) finite_schema_observation_site fset"
type_synonym finite_application_construction_case = "finite_application_problem \<times> finite_natural_application list"
type_synonym finite_application_requirement = "finite_application_problem \<times> finite_natural_application \<times> nat"

definition application_problem_observations where
  "application_problem_observations P=finite_schema_call_observations (application_entry P)
    (application_schema P) (application_frontier P) (application_requests P)"

definition application_plan_result where
  "application_plan_result (A::finite_application_plan) P=
    (if set (application_enumeration P)=fset (finite_schema_premises (application_schema P))
     then finite_observed_schema_applications (application_schema P)
       (finite_selected_observations A (application_problem_observations P)) else {||})"

lemma application_plan_result_member:
  "(t,V,H) |\<in>| application_plan_result A P \<longleftrightarrow>
    set (application_enumeration P)=fset (finite_schema_premises (application_schema P)) \<and>
    V |\<in>| finite_observed_bindings (finite_schema_observation_sources (application_schema P))
      (finite_selected_observations A (application_problem_observations P)) \<and>
    finite_schema_instance (application_schema P) V t H \<and>
    finite_schema_material_satisfied (application_schema P) V"
  by (auto simp: application_plan_result_def finite_observed_schema_applications_exact)

lemma application_plan_result_valid:
  "application_instances_valid (application_schema P) (application_plan_result A P)"
  by (auto simp: application_instances_valid_def application_plan_result_member split: prod.splits)

definition application_mandatory_targets where
  "application_mandatory_targets P=application_required P |\<union>|
    application_construction_result Separate_Application_Sources P"

definition application_construction_case_formed where
  "application_construction_case_formed P Xs \<longleftrightarrow>
    fset_of_list Xs=application_mandatory_targets P \<and>
    finite_schema_formed (application_schema P) \<and>
    fBall (application_frontier P |\<union>| application_requests P) (\<lambda>q. finite_term_formed (snd q)) \<and>
    set (application_enumeration P)=fset (finite_schema_premises (application_schema P)) \<and>
    application_instances_valid (application_schema P) (fset_of_list Xs)"

definition application_construction_cases_formed where
  "application_construction_cases_formed Cs \<longleftrightarrow>
    (\<forall>(P,Xs)\<in>set Cs. application_construction_case_formed P Xs)"

definition application_plan_requirements where
  "application_plan_requirements (Cs::finite_application_construction_case list)=
    concat (map (\<lambda>(P,Xs). concat (map (\<lambda>X.
      map (\<lambda>a. (P,X,a)) (sorted_list_of_fset (finite_schema_variables (application_schema P)))) Xs)) Cs)"

lemma application_plan_requirement_member:
  "(P,X,a)\<in>set (application_plan_requirements Cs) \<longleftrightarrow>
    (\<exists>Xs. (P,Xs)\<in>set Cs \<and> X\<in>set Xs \<and>
      a |\<in>| finite_schema_variables (application_schema P))"
  by (simp only: application_plan_requirements_def list_family_requirements_member; simp)

definition application_part_coverage where
  "application_part_coverage (Cs::finite_application_construction_case list) i=
    ffilter (\<lambda>(P,(t,V,H),a). a |\<in>| finite_observation_site_coverage
      (finite_schema_observation_sources (application_schema P)) (application_problem_observations P) V i)
      (fset_of_list (application_plan_requirements Cs))"

lemma application_part_coverage_member:
  "(P,(t,V,H),a) |\<in>| application_part_coverage Cs i \<longleftrightarrow>
    (P,(t,V,H),a)\<in>set (application_plan_requirements Cs) \<and>
    a |\<in>| finite_observation_site_coverage (finite_schema_observation_sources (application_schema P))
      (application_problem_observations P) V i"
  by (auto simp: application_part_coverage_def fset_of_list_elem)

lemma application_plan_coverage_at_target:
  assumes actual: "(P,Xs)\<in>set Cs" "(t,V,H)\<in>set Xs"
    and variable: "a |\<in>| finite_schema_variables (application_schema P)"
  shows "(P,(t,V,H),a) |\<in>| finite_assembly_coverage (application_part_coverage Cs) A \<longleftrightarrow>
    a |\<in>| finite_assembly_coverage
      (finite_observation_site_coverage (finite_schema_observation_sources (application_schema P))
        (application_problem_observations P) V) A"
  using actual variable by (simp only: finite_assembly_coverage_member application_part_coverage_member
    application_plan_requirement_member; blast)

definition application_plan_sufficient where
  "application_plan_sufficient Cs A \<longleftrightarrow>
    (\<forall>(P,Xs)\<in>set Cs. application_mandatory_targets P |\<subseteq>| application_plan_result A P)"

theorem application_plan_coverage_exact:
  assumes formed: "application_construction_cases_formed Cs"
  shows "application_plan_sufficient Cs A \<longleftrightarrow>
    fset_of_list (application_plan_requirements Cs) |\<subseteq>| finite_assembly_coverage (application_part_coverage Cs) A"
proof -
  have target: "(t,V,H) |\<in>| application_plan_result A P \<longleftrightarrow>
    finite_schema_variables (application_schema P) |\<subseteq>|
      finite_assembly_coverage (finite_observation_site_coverage
        (finite_schema_observation_sources (application_schema P)) (application_problem_observations P) V) A"
    if actual: "(P,Xs)\<in>set Cs" "(t,V,H)\<in>set Xs" for P Xs t V H
  proof -
    have valid: "application_construction_case_formed P Xs"
      using formed actual(1) by (auto simp: application_construction_cases_formed_def)
    have enumeration: "set (application_enumeration P)=fset (finite_schema_premises (application_schema P))"
      and targets: "application_instances_valid (application_schema P) (fset_of_list Xs)"
      using valid by (simp only: application_construction_case_formed_def; blast)+
    have member: "(t,V,H) |\<in>| fset_of_list Xs"
      using actual(2) by (simp only: fset_of_list_elem)
    have inst: "finite_schema_instance (application_schema P) V t H"
      and material: "finite_schema_material_satisfied (application_schema P) V"
      using application_instances_valid_at[OF targets member] by blast+
    have functional: "finite_relation_functional V"
      and domain: "fimage fst V=finite_schema_variables (application_schema P)"
      using inst by (auto simp: finite_schema_instance_def finite_term_bindings_formed_def)
    show ?thesis by (simp only: application_plan_result_member enumeration inst material
      finite_observation_assembly_exact[OF functional] domain; simp)
  qed
  have presentations: "fset_of_list Xs=application_mandatory_targets P"
    if "(P,Xs)\<in>set Cs" for P Xs
    using formed that by (auto simp: application_construction_cases_formed_def application_construction_case_formed_def)
  show ?thesis
  proof
    assume sufficient: "application_plan_sufficient Cs A"
    show "fset_of_list (application_plan_requirements Cs) |\<subseteq>|
      finite_assembly_coverage (application_part_coverage Cs) A"
    proof (rule fsubsetI)
      fix q
      assume member: "q |\<in>| fset_of_list (application_plan_requirements Cs)"
      obtain P t V H a where q: "q=(P,(t,V,H),a)" by (cases q; auto)
      obtain Xs where actual: "(P,Xs)\<in>set Cs" "(t,V,H)\<in>set Xs"
        and variable: "a |\<in>| finite_schema_variables (application_schema P)"
        using member by (simp only: q fset_of_list_elem application_plan_requirement_member; blast)
      have mandatory: "(t,V,H) |\<in>| application_mandatory_targets P"
        using actual(2) by (simp only: presentations[OF actual(1), symmetric] fset_of_list_elem)
      have preserved: "application_mandatory_targets P |\<subseteq>| application_plan_result A P"
        using sufficient actual(1) by (auto simp: application_plan_sufficient_def)
      have result: "(t,V,H) |\<in>| application_plan_result A P"
        by (rule fsubsetD[OF preserved mandatory])
      have covered: "finite_schema_variables (application_schema P) |\<subseteq>|
        finite_assembly_coverage (finite_observation_site_coverage
          (finite_schema_observation_sources (application_schema P)) (application_problem_observations P) V) A"
        using result by (simp only: target[OF actual])
      show "q |\<in>| finite_assembly_coverage (application_part_coverage Cs) A"
        using fsubsetD[OF covered variable]
        by (simp only: q application_plan_coverage_at_target[OF actual variable])
    qed
  next
    assume covered: "fset_of_list (application_plan_requirements Cs) |\<subseteq>|
      finite_assembly_coverage (application_part_coverage Cs) A"
    have preserved: "application_mandatory_targets P |\<subseteq>| application_plan_result A P"
      if actual: "(P,Xs)\<in>set Cs" for P Xs
    proof (rule fsubsetI)
      fix X
      assume mandatory: "X |\<in>| application_mandatory_targets P"
      obtain t V H where X: "X=(t,V,H)" by (cases X; auto)
      have listed: "(t,V,H)\<in>set Xs"
        using mandatory by (simp only: X presentations[OF actual, symmetric] fset_of_list_elem)
      have scope: "finite_schema_variables (application_schema P) |\<subseteq>|
        finite_assembly_coverage (finite_observation_site_coverage
          (finite_schema_observation_sources (application_schema P)) (application_problem_observations P) V) A"
      proof (rule fsubsetI)
        fix a
        assume variable: "a |\<in>| finite_schema_variables (application_schema P)"
        have requirement: "(P,(t,V,H),a) |\<in>| fset_of_list (application_plan_requirements Cs)"
          using actual listed variable by (simp only: fset_of_list_elem application_plan_requirement_member; blast)
        have global: "(P,(t,V,H),a) |\<in>| finite_assembly_coverage (application_part_coverage Cs) A"
          by (rule fsubsetD[OF covered requirement])
        show "a |\<in>| finite_assembly_coverage (finite_observation_site_coverage
          (finite_schema_observation_sources (application_schema P)) (application_problem_observations P) V) A"
          using global by (simp only: application_plan_coverage_at_target[OF actual listed variable])
      qed
      show "X |\<in>| application_plan_result A P"
        using scope by (simp only: X target[OF actual listed])
    qed
    show "application_plan_sufficient Cs A"
      using preserved by (auto simp: application_plan_sufficient_def)
  qed
qed

definition application_candidate_language where
  "application_candidate_language (Ps::(nat,nat) finite_schema_observation_site list) Cs=
    ffilter (application_plan_sufficient Cs) (fPow (fset_of_list Ps))"

lemma application_candidate_language_member:
  "A |\<in>| application_candidate_language Ps Cs \<longleftrightarrow>
    A |\<subseteq>| fset_of_list Ps \<and> application_plan_sufficient Cs A"
  by (auto simp: application_candidate_language_def)

definition application_construct_plan where
  "application_construct_plan Ps Cs=
    (if application_construction_cases_formed Cs
     then finite_construct_candidate (application_plan_requirements Cs) Ps (application_part_coverage Cs)
     else None)"

definition application_uncovered_requirements where
  "application_uncovered_requirements Ps Cs=fset_of_list (application_plan_requirements Cs) |-|
    finite_assembly_coverage (application_part_coverage Cs) (fset_of_list Ps)"

definition application_construction_report where
  "application_construction_report Ps Cs=(application_construction_cases_formed Cs,
    application_uncovered_requirements Ps Cs,application_construct_plan Ps Cs)"

theorem application_construct_plan_sound:
  assumes built: "application_construct_plan Ps Cs=Some A"
  shows "application_construction_cases_formed Cs"
    "A |\<in>| application_candidate_language Ps Cs"
    "\<forall>Z. Z |\<subseteq>| A \<and> application_plan_sufficient Cs Z \<longrightarrow> Z=A"
proof -
  have formed: "application_construction_cases_formed Cs"
    and constructed: "finite_construct_candidate (application_plan_requirements Cs) Ps (application_part_coverage Cs)=Some A"
    using built by (auto simp: application_construct_plan_def split: if_splits)
  show "application_construction_cases_formed Cs" by (rule formed)
  show "A |\<in>| application_candidate_language Ps Cs"
    using finite_construct_candidate_sound(1)[OF constructed]
    by (simp only: finite_candidate_assembly_member application_candidate_language_member
      application_plan_coverage_exact[OF formed])
  show "\<forall>Z. Z |\<subseteq>| A \<and> application_plan_sufficient Cs Z \<longrightarrow> Z=A"
    using finite_construct_candidate_sound(2)[OF constructed]
    by (simp only: application_plan_coverage_exact[OF formed])
qed

theorem application_construct_plan_complete:
  assumes formed: "application_construction_cases_formed Cs"
  shows "application_construct_plan Ps Cs\<noteq>None \<longleftrightarrow> application_candidate_language Ps Cs\<noteq>{||}"
proof -
  have language: "application_candidate_language Ps Cs=
    finite_candidate_assemblies (fset_of_list Ps) (fset_of_list (application_plan_requirements Cs)) (application_part_coverage Cs)"
    by (rule fset_eqI) (simp only: application_candidate_language_member finite_candidate_assembly_member
      application_plan_coverage_exact[OF formed])
  show ?thesis by (simp only: application_construct_plan_def formed if_True language finite_construct_candidate_complete)
qed

theorem application_construct_plan_failure:
  assumes formed: "application_construction_cases_formed Cs"
  shows "application_construct_plan Ps Cs=None \<longleftrightarrow> application_uncovered_requirements Ps Cs\<noteq>{||}"
  by (simp add: application_construct_plan_def formed finite_construct_candidate_failure
    application_uncovered_requirements_def)

theorem application_construct_plan_necessity:
  assumes built: "application_construct_plan Ps Cs=Some A" and member: "i |\<in>| A"
  shows "\<exists>q. q |\<in>| application_part_coverage Cs i \<and>
    q |\<notin>| finite_assembly_coverage (application_part_coverage Cs) (A |-| {|i|})"
proof -
  have constructed: "finite_construct_candidate (application_plan_requirements Cs) Ps (application_part_coverage Cs)=Some A"
    using built by (auto simp: application_construct_plan_def split: if_splits)
  show ?thesis using finite_construct_candidate_necessity_witness[OF constructed member] by blast
qed

definition application_candidate_subjects where
  "application_candidate_subjects Ps Cs=(case application_construct_plan Ps Cs of
    None \<Rightarrow> {||} | Some A \<Rightarrow> {|(0::nat,A)|})"

lemma application_candidate_subject:
  "(c,A) |\<in>| application_candidate_subjects Ps Cs \<longleftrightarrow>
    c=0 \<and> application_construct_plan Ps Cs=Some A"
  by (auto simp: application_candidate_subjects_def split: option.splits)

text \<open>
  Every subset of the supplied source-site basis is in the declared candidate
  language when its actual applications preserve all mandatory targets across
  the complete input family. Search constructs one such plan whenever that
  language is nonempty, under the explicit input gate. The gate checks the
  complete target presentation, original premise enumeration, instance and
  material conditions before variable coverage can decide feasibility.

  A constructed plan is inclusion minimal and every retained site has a
  missing-requirement witness if removed. Search order may choose a different
  sufficient plan. It does not change the declared subset language or existence.
  No assertion of minimum cardinality or coverage of all possible algorithms is
  made. A failed construction is reported independently of comparison residuals.
\<close>

end
