#!/usr/bin/env python3
"""Replay an exact retained case family with its original checker and code."""
from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path
import shutil
import subprocess
import sys
import evidence_io


def digest(path):
    return evidence_io.digest(path)


def fresh_output(args):
    output = args.output.resolve()
    if getattr(args, "decoded_view_prepared", False):
        assert set(output.iterdir()) == {output / "decoded-evidence"}
    else:
        assert not output.exists(), "Use a new replay directory."
    return output


def replay_investigation(args, base, index):
    stage = index["investigations"][args.investigation]
    before = json.loads((base / stage["files"]["receipt.json"]).read_text())
    assert set(stage["external"].values()) == {digest(args.poly.resolve())}
    output = fresh_output(args)
    (output / "tools").mkdir(parents=True)
    for path in before["tools"]:
        shutil.copyfile(base / stage["inputs"][path], output / "tools" / Path(path).name)
    shutil.copyfile(base / stage["reviewer"], output / "tools/review_investigations.py")
    sys.path.insert(0, str(output / "tools"))
    import investigate
    import review_investigations as review
    case_path = base / stage["files"]["case.json"]
    case = json.loads(case_path.read_text())
    investigate.validate_case(case)
    contract_args = ()
    if "formal_subject_contract" in before:
        contract = before["formal_subject_contract"]
        operation = before["registered_operation"]
        contract_path = base / stage["inputs"][contract["path"]]
        assert digest(contract_path) == contract["sha256"]
        actual = investigate.observation_contracts.read_contract(
            contract_path, operation["theory"], operation["function"])
        assert actual == {key: value for key, value in contract.items() if key not in {"path", "sha256"}}
        contract_args = (actual,)
    original = base / stage["files"]["execute.ML"]
    assert original.read_text() == investigate.runtime_program(case, Path(before["generated_engine"]), *contract_args)
    engine = base / stage["inputs"][before["generated_engine"]]
    program = output / "execute.ML"
    program.write_text(investigate.runtime_program(case, engine, *contract_args))
    execution = subprocess.run([str(args.poly.resolve()), "--script", str(program)],
                               stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=60)
    (output / "results.log").write_bytes(execution.stdout)
    assert execution.returncode == 0
    reports = lambda raw: [line for line in raw.splitlines() if line.startswith("INVESTIGATION_RESULT ")]
    lines = reports(execution.stdout.decode())
    assert len(lines) == 1
    assert lines == reports((base / stage["files"]["run.log"]).read_text())
    result = json.loads(lines[0].removeprefix("INVESTIGATION_RESULT "))
    investigate.validate_result(result, case["kind"])
    assert result == before["result"]
    mismatches, checked, facts = (review.inference_analysis(case, result) if case["kind"] == "inference"
                                  else review.basis_analysis(case, result, before["scope"]))
    assert not mismatches, mismatches
    evidence = {"investigation": args.investigation, "status": "accepted",
                "original_receipt_sha256": digest(base / stage["files"]["receipt.json"]),
                "archive_index_sha256": digest(base / "index.json"),
                "replayer_sha256": digest(Path(__file__)), "runtime_program_sha256": digest(program),
                "evidence_io_sha256": digest(Path(evidence_io.__file__)),
                "results_log_sha256": digest(output / "results.log"),
                "generated_engine_sha256": digest(engine), "poly_sha256": digest(args.poly.resolve()),
                "checked_fields": checked, "facts": facts, "result": result,
                "boundary": "Exact retained code and inputs reproduce every complete result and pass independent reconstruction. This does not repeat proof checking, candidate construction, or subject-meaning justification."}
    (output / "replay.json").write_text(json.dumps(evidence, indent=2) + "\n")
    print(json.dumps({"investigation": args.investigation, "status": evidence["status"],
                      "replay_sha256": digest(output / "replay.json")}, indent=2))
    return 0


TIMED_DATA_CHECKERS = {
    "directed_search": "check_directed_native",
    "application_candidates": "check_application_comparison",
    "application_candidate_experiment": "check_application_candidates",
}


def pin_restored_modules(directory):
    """Resolve every retained helper from its verified restored source file."""
    import importlib.abc
    import importlib.util

    sources = {path.stem: path for path in directory.glob("*.py")}
    for name in sources:
        sys.modules.pop(name, None)

    class RestoredSources(importlib.abc.MetaPathFinder):
        def find_spec(self, fullname, path=None, target=None):
            source = sources.get(fullname)
            return importlib.util.spec_from_file_location(fullname, source) if source else None

    finder = RestoredSources()
    sys.meta_path.insert(0, finder)
    return finder


def timed_data_reports(raw, kind):
    """Compare all native fields, omitting only the declared clock measurements."""
    result = []
    for line in raw.splitlines():
        if kind == "directed_search":
            if line.startswith("SEARCH_STARTED "):
                result.append(line)
            elif line.startswith(("BINDING_INPUT ", "ASSEMBLY_INPUT ", "BINDINGS ", "ASSEMBLY ")):
                label, identifier, value = line.split(" ", 2)
                if label in {"BINDINGS", "ASSEMBLY"}:
                    value, seconds = value.rsplit(" ", 1)
                    assert float(seconds) >= 0
                result.append((label, int(identifier), json.loads(value)))
        elif line.startswith("APPLICATION_"):
            label, identifier, value = line.split(" ", 2)
            data = json.loads(value)
            if label == "APPLICATION_CONSTRUCTION":
                data = dict(data)
                assert float(data.pop("seconds")) >= 0
            result.append((label, int(identifier), data))
    return result


def timed_data_assessment(value):
    """Retain all mathematical fields and canonicalize the per-part witness family."""
    result = json.loads(json.dumps(value))
    for case in result["cases"]:
        assert float(case.pop("seconds")) >= 0
        if "necessity_witnesses" in case:
            case["necessity_witnesses"] = sorted(case["necessity_witnesses"],
                key=lambda witness: json.dumps(witness["part"], sort_keys=True))
    return result


def replay_finite_data(args, base, stage, proof, output):
    """Reconstruct and reassess a retained finite presenter or native input run."""
    import investigate

    before = json.loads((base / stage["files"]["receipt.json"]).read_text())
    original_proof = json.loads((base / proof["receipt"]).read_text())
    original_engine = Path(original_proof["exports"][0]["path"])
    engine = base / proof["engine"]
    kind = stage["replay_kind"]
    expected_failure = stage["expected_failure"]
    assert not expected_failure or kind in {"application_comparison", "binding_contributions"}
    if kind == "finite_presentations":
        import check_finite_presentations as checker
        cases = json.loads((base / stage["files"]["cases.json"]).read_text())
        program = lambda path: checker.program(path, cases)
        prefix = "PRESENTATION_RESULT "
    elif kind == "builtin_cases":
        import check_builtin_cases as checker
        cases = json.loads((base / stage["files"]["cases.json"]).read_text())
        contracts = before["assessment"].get("formal_subject_contracts")
        if contracts is not None:
            actual = {}
            for case_kind in sorted({case["kind"] for case in cases}):
                descriptor = investigate.BUILTIN_CASES[case_kind]
                entries = [row for row in original_proof["subject_contracts"]
                           if Path(row["path"]).name == descriptor["function"] + ".yxml"]
                assert len(entries) == 1
                entry = entries[0]
                path = base / stage["inputs"][entry["path"]]
                assert digest(path) == entry["sha256"]
                actual[case_kind] = checker.observation_contracts.read_contract(
                    path, descriptor["theory"], descriptor["function"])
            assert actual == contracts
        program = (lambda path: checker.program(path, cases, contracts)) if contracts is not None else (
            lambda path: checker.program(path, cases))
        prefix = "INDEXED_INVESTIGATION "
    elif kind in TIMED_DATA_CHECKERS:
        import importlib
        checker = importlib.import_module(TIMED_DATA_CHECKERS[kind])
        cases = json.loads((base / stage["files"]["cases.json"]).read_text())
        program = lambda path: checker.program(path, cases)
        prefix = ("BINDING_INPUT ", "ASSEMBLY_INPUT ", "BINDINGS ", "ASSEMBLY ", "SEARCH_STARTED ") if kind == "directed_search" else "APPLICATION_"
    elif kind in {"application_comparison", "binding_contributions"}:
        import importlib
        checker = importlib.import_module("check_" + kind)
        cases = json.loads((base / stage["files"]["cases.json"]).read_text())
        program = lambda path: checker.program(path, cases)
        prefix = (("APPLICATION_SUBJECTS ", "APPLICATION_RESULTS ", "APPLICATION_INITIAL ", "APPLICATION_FOLLOWED ")
                  if kind == "application_comparison" else "BINDING_CONTRIBUTIONS ")
    else:
        assert kind == "finite_inference_inputs"
        import check_finite_inference as checker
        program = lambda path: "use " + investigate.ml_string(str(path)) + ";\n" + checker.PRELUDE
        prefix = "NATIVE_INPUT "
    assert (base / stage["files"]["execute.ML"]).read_text() == program(original_engine)
    runtime = output / "execute.ML"
    runtime.write_text(program(engine))
    execution = subprocess.run([str(args.poly.resolve()), "--script", str(runtime)],
                               stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=60)
    log_path = output / "results.log"
    log_path.write_bytes(execution.stdout)
    assert execution.returncode == (before["exit_code"] if expected_failure else 0)
    reports = lambda text: [line for line in text.splitlines() if line.startswith(prefix)]
    lines = reports(execution.stdout.decode())
    original_raw = (base / stage["files"]["results.log"]).read_text()
    if kind in TIMED_DATA_CHECKERS:
        assert timed_data_reports(execution.stdout.decode(), kind) == timed_data_reports(original_raw, kind)
    else:
        assert lines == reports(original_raw)
    if expected_failure:
        assert before["status"] == "failed"
        assert expected_failure in execution.stdout.decode()
        if execution.returncode == 0:
            try:
                checker.assess(cases, execution.stdout.decode())
            except AssertionError as error:
                assert str(error) == before["error"]
            else:
                raise AssertionError("The original assessment rejection was not reproduced.")
        assessment = {"expected_error": before["error"], "exit_code": execution.returncode}
    elif kind in TIMED_DATA_CHECKERS:
        assessment = json.loads(json.dumps(checker.assess(cases, execution.stdout.decode())))
        assert timed_data_assessment(assessment) == timed_data_assessment(before["assessment"])
    elif kind in {"application_comparison", "binding_contributions"}:
        assessment = checker.review.clone_json(checker.assess(cases, execution.stdout.decode()))
        assert assessment == before["assessment"]
    elif kind == "builtin_cases":
        prior = None
        if before["assessment"]["original_complete_result_equality"]:
            paths = [base / reference for name, reference in stage["inputs"].items()
                     if Path(name).name == "complete-results.json"]
            assert len(paths) == 1
            prior = json.loads(paths[0].read_text())
        assessment = (checker.assess(cases, execution.stdout.decode(), prior, contracts)
                      if contracts is not None else checker.assess(cases, execution.stdout.decode(), prior))
        # Older checkers return tuple-valued reconstruction fields before the
        # public JSON encoding. Compare their complete serialized objects.
        assert json.dumps(assessment, sort_keys=True) == json.dumps(before["assessment"], sort_keys=True)
    elif kind == "finite_presentations":
        results = [json.loads(line[len(prefix):]) for line in lines]
        assessment = checker.family.assess(cases, results)
        assert assessment == before["assessment"]
        assert len(cases) == before["checked_cases"]
    else:
        results = [json.loads(line[len(prefix):]) for line in lines]
        assert len(results) == 1
        actual = results[0]
        expected = json.loads((base / stage["inputs"][before["source_spec"]]).read_text())
        assessment = checker.recover_argument(actual["argument"], expected)
        assert assessment == before["recovery"]
        catalog_root = Path(before["catalogs"])
        catalog_receipt = json.loads((base / stage["inputs"][str(catalog_root / "receipt.json")]).read_text())
        assert catalog_receipt["status"] == "accepted"
        catalogs = {}
        for name, entry in catalog_receipt["exported_libraries"].items():
            path = base / stage["inputs"][str(catalog_root / ("library-" + name + ".json"))]
            assert digest(path) == entry["sha256"]
            catalogs[name] = json.loads(path.read_text())
        cases, trace = checker.native_cases(catalogs, actual["argument"], actual["known"])
        cases = checker.construction.reader_cases(catalogs, combined=True) + cases
        original_cases = json.loads((base / stage["files"]["specification.json"]).read_text())["cases"]
        assert checker.review.clone_json(cases) == original_cases and len(cases) == before["prepared_cases"]
        assert trace == json.loads((base / stage["files"]["native-expansion.json"]).read_text())
    evidence = {"stage": args.stage,
                "status": "expected failure reproduced" if expected_failure else "accepted", "replay_kind": kind,
                "original_receipt_sha256": digest(base / stage["files"]["receipt.json"]),
                "archive_index_sha256": digest(base / "index.json"),
                "replayer_sha256": digest(Path(__file__)), "runtime_program_sha256": digest(runtime),
                "evidence_io_sha256": digest(Path(evidence_io.__file__)),
                "results_sha256": digest(log_path), "assessment": assessment,
                "boundary": "Exact archived code reproduces every complete data output and its original independent assessment. This does not repeat native proof checking."}
    if kind in TIMED_DATA_CHECKERS:
        evidence["measurement_boundary"] = "Raw clocks are retained in both logs and assessments. Only each case's seconds and the native constructor's declared clock field are excluded from mathematical equality. The unordered per-part necessity witnesses are compared in actual-site order, retaining every witness field and duplicate."
    (output / "replay.json").write_text(json.dumps(evidence, indent=2) + "\n")
    print(json.dumps({"stage": args.stage, "status": evidence["status"], "replay_kind": kind,
                      "replay_sha256": digest(output / "replay.json")}, indent=2))
    return 0


def main():
    if not __debug__:
        raise ValueError("Evidence replay requires Python assertions to be enabled.")
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--archive", type=Path, required=True)
    selection = parser.add_mutually_exclusive_group(required=True)
    selection.add_argument("--stage")
    selection.add_argument("--investigation")
    parser.add_argument("--poly", type=Path, required=True)
    parser.add_argument("--output", type=Path, required=True)
    args = parser.parse_args()
    base = args.archive.resolve()
    manifest = json.loads((base / "archive.json").read_text())
    for name, sha in manifest["files"].items():
        assert digest(base / name) == sha, name
    index_path = base / "index.json"
    index = json.loads(index_path.read_text())
    assert index["version"] == 1
    if manifest.get("encodings"):
        if args.investigation:
            selected = index["investigations"][args.investigation]
            references = set(selected["files"].values()) | set(selected["inputs"].values()) | {selected["reviewer"]}
        else:
            selected = index["runs"][args.stage]
            selected_proof = index["proofs"][selected["proof"]]
            references = (set(selected["files"].values()) | set(selected["inputs"].values())
                          | set(selected_proof["sources"].values())
                          | {selected_proof["receipt"], selected_proof["engine"]})
        assert not args.output.exists(), "Use a new replay directory."
        base = evidence_io.decoded_view(base, manifest, references, args.output)
        index_path = base / "index.json"
        args.decoded_view_prepared = True
    if args.investigation:
        return replay_investigation(args, base, index)
    stage = index["runs"][args.stage]
    proof = index["proofs"][stage["proof"]]
    assert proof["status"] == "accepted"
    assert set(stage["external"].values()) == {digest(args.poly.resolve())}
    output = fresh_output(args)
    (output / "source/theories").mkdir(parents=True)
    (output / "tools").mkdir()
    for name, reference in proof["sources"].items():
        shutil.copyfile(base / reference, output / "source/theories" / (name + ".thy"))
    for name, reference in stage["inputs"].items():
        path = Path(name)
        if path.suffix == ".py":
            destination = output / "tools" / path.name
            assert not destination.exists() or digest(destination) == digest(base / reference), path.name
            shutil.copyfile(base / reference, destination)
    sys.path.insert(0, str(output / "tools"))
    pin_restored_modules(output / "tools")
    if stage.get("replay_kind", "reasoning") != "reasoning":
        return replay_finite_data(args, base, stage, proof, output)
    import check_reasoning as review
    review.ROOT = output / "source"
    cases_file = base / stage["files"]["cases.json"]
    cases = json.loads(cases_file.read_text())
    parameters = argparse.Namespace(proof=base / proof["receipt"], engine=base / proof["engine"],
                                    poly=args.poly.resolve(), output=output / "run")
    status = review.run(parameters, cases_factory=lambda: cases, cases_source=cases_file,
                        cases_dependencies=[Path(__file__), index_path],
                        library_exports=stage["library_exports"])
    receipt = json.loads((parameters.output / "receipt.json").read_text())
    before = json.loads((base / stage["files"]["receipt.json"]).read_text())
    if stage["expected_failure"]:
        assert status == 1 and receipt["status"] == "failed"
        assert stage["expected_failure"] in (parameters.output / "results.log").read_text()
    else:
        assert status == 0 and receipt["status"] == "accepted"
        for field in ["reasoning_cases", "binding_source_executions", "construction_frontier_executions",
                      "construction_seed_executions", "coverage_executions", "compilation_executions",
                      "native_library_executions", "binding_gap_executions", "guided_state_executions",
                      "native_guided_executions", "unproved_goal_assumption_cases", "environment_requirement_executions"]:
            assert receipt.get(field, 0) == before.get(field, 0), field
        # Compiler diagnostics contain the relocated module's absolute path.
        # Compare every complete machine report, retaining both raw logs.
        labels = {"REASONING_RESULT", "BINDING_RESULT", "CONSTRUCTION_FRONTIER",
                  "CONSTRUCTION_SEED", "COVERAGE_RESULT", "COMPILED_LIBRARY",
                  "LIBRARY_CATALOG", "INPUT_RESULT", "BINDING_GAPS_RESULT", "GUIDED_STATE", "ENVIRONMENT_REQUIREMENT_RESULT"}
        reports = lambda path: [line for line in path.read_text().splitlines()
                                if line.partition(" ")[0] in labels]
        assert reports(parameters.output / "results.log") == reports(base / stage["files"]["results.log"])
    evidence = {
        "stage": args.stage, "status": "expected failure reproduced" if stage["expected_failure"] else "accepted",
        "receipt_sha256": digest(parameters.output / "receipt.json"),
        "archive_index_sha256": digest(index_path), "replayer_sha256": digest(Path(__file__)),
        "evidence_io_sha256": digest(Path(evidence_io.__file__)),
        "boundary": "The retained inputs and original code are replayed. This reproduces complete checked reports; it does not rerun case selection or establish new native source readings.",
    }
    (output / "replay.json").write_text(json.dumps(evidence, indent=2) + "\n")
    print(json.dumps(evidence, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
