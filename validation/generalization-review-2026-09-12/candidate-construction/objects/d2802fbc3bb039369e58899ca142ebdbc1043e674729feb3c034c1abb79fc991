"""Check one constructed source plan against a whole family of actual problems."""
from itertools import combinations
import json
from pathlib import Path
import prototype as p

B = Path(__file__).parent


def applications(problem, selected):
    entry = {'entry': problem['entry'], 'schema': problem['schema'], 'enumeration': problem['enumeration']}
    observations = p.reference.schema_call_observations(entry, problem['frontier'], problem['requests'])
    fragments = p.reference.recover_observations(p.reference.schema_observation_sources(entry['schema']), observations)
    values = p.reference.observation_valuations(p.reference.schema_variables(entry['schema']),
        [part for site, _, _, part in fragments if p.reference.freeze(site) in selected])
    return [a for v in values if (a := p.reference.application_from_valuation(entry, v)) is not None]


def joint(problems):
    individuals = [p.constructed_plan(problem) for problem in problems]
    parts = p.ordered({site for row in individuals for site in row['parts']})
    scope = {(w, key) for w, row in enumerate(individuals) for key in row['scope']}
    effects = [set() for _ in parts]
    for w, row in enumerate(individuals):
        for site, effect in zip(row['parts'], row['part_effects']):
            effects[parts.index(site)].update((((w, key), value) for key, value in effect))
    effects = [frozenset(x) for x in effects]
    result = p.directed(scope, effects, first=True)
    valid = not any(row['invalid_required_applications'] for row in individuals)
    selected, witnesses = p.minimize_cover(scope, effects, result['witnesses'][0][1]) if valid and result['witnesses'] else (None, {})
    requirements = [row['required_applications'] for row in individuals]

    def adequate(indices):
        actual = [applications(problem, {parts[i] for i in indices}) for problem in problems]
        return all({p.local_application_key(a) for a in required} <= {p.local_application_key(a) for a in returned}
                   for required, returned in zip(requirements, actual)), actual

    complete = []
    if len(parts) <= 12:
        for n in range(len(parts) + 1):
            for indices in combinations(range(len(parts)), n):
                checked, _ = adequate(indices)
                covered = valid and scope <= set().union(*(p.domain(effects[i]) for i in indices))
                assert checked == covered
                complete.append({'parts': indices, 'adequate': checked})
        assert (selected is not None) == any(row['adequate'] for row in complete)
    accepted, actual = adequate(selected) if selected is not None else (False, [])
    assert selected is None or accepted
    missing = scope - set().union(*(p.domain(effect) for effect in effects))
    assert (selected is None) == (bool(missing) or not valid)
    return {'problems': problems, 'required_applications': requirements, 'parts': parts, 'effects': effects,
            'scope': scope, 'candidate_language_size': 2 ** len(parts), 'search': result,
            'selected': selected, 'constructed_plan': [parts[i] for i in selected] if selected is not None else None,
            'necessity_witnesses': witnesses, 'missing_requirements': missing,
            'applications': actual, 'complete_subset_comparison': complete}


def main():
    original = json.loads((B/'original-comparison-problems.json').read_text())['problems']
    impossible = {**original[0], 'requests': []}
    cases = [joint(original), joint([p.large_application(n, r) for n, r in [(32, 16), (64, 32), (128, 64)]]), joint([impossible])]
    (B/'joint-prototype-results.json').write_text(json.dumps(p.display(cases), indent=2)+'\n')
    print(json.dumps([{'problems': len(row['problems']), 'parts': len(row['parts']), 'requirements': len(row['scope']),
                       'selected_parts': len(row['selected']) if row['selected'] is not None else None,
                       'states': row['search']['states'], 'missing': p.display(row['missing_requirements']),
                       'exhaustive_subset_comparisons': len(row['complete_subset_comparison'])} for row in cases], indent=2))


if __name__ == '__main__':
    main()
