theory Finite_Candidate_Assembly
  imports "Finite_Demand_Selection"
begin

section \<open>The candidate language consists of assemblies of the declared parts\<close>

definition finite_assembly_coverage where
  "finite_assembly_coverage K A=ffUnion (fimage K A)"

lemma finite_assembly_coverage_member:
  "q |\<in>| finite_assembly_coverage K A \<longleftrightarrow> (\<exists>p. p |\<in>| A \<and> q |\<in>| K p)"
  by (simp only: finite_assembly_coverage_def finite_union_image_member)

lemma finite_assembly_coverage_mono:
  "A |\<subseteq>| B \<Longrightarrow> finite_assembly_coverage K A |\<subseteq>| finite_assembly_coverage K B"
  by (auto simp: fsubset_iff fset_of_list_elem finite_assembly_coverage_member)

lemma finite_assembly_coverage_insert [simp]:
  "finite_assembly_coverage K (finsert p A)=K p |\<union>| finite_assembly_coverage K A"
  by (simp add: finite_assembly_coverage_def)

lemma finite_assembly_coverage_empty [simp]: "finite_assembly_coverage K {||}={||}"
  by (simp add: finite_assembly_coverage_def)

definition finite_candidate_assemblies where
  "finite_candidate_assemblies parts required K=
    ffilter (\<lambda>A. required |\<subseteq>| finite_assembly_coverage K A) (fPow parts)"

lemma finite_candidate_assembly_member:
  "A |\<in>| finite_candidate_assemblies parts required K \<longleftrightarrow>
    A |\<subseteq>| parts \<and> required |\<subseteq>| finite_assembly_coverage K A"
  by (simp add: finite_candidate_assemblies_def conj_commute)

section \<open>Coverage constructs a sufficient assembly without enumerating subsets\<close>

fun finite_assembly_search where
  "finite_assembly_search 0 As Ps K A=
    (if fset_of_list As |\<subseteq>| finite_assembly_coverage K A then Some A else None)"
| "finite_assembly_search (Suc n) As Ps K A=
    (case finite_demand_choice (\<lambda>a. length (filter (\<lambda>p. a |\<in>| K p) Ps))
      As (finite_assembly_coverage K A) of None \<Rightarrow> Some A
    | Some a \<Rightarrow> (case List.find (\<lambda>p. a |\<in>| K p) Ps of None \<Rightarrow> None
        | Some p \<Rightarrow> finite_assembly_search n As Ps K (finsert p A)))"

lemma finite_assembly_search_sound:
  assumes result: "finite_assembly_search n As Ps K A=Some Z"
  shows "A |\<subseteq>| Z" "Z |\<subseteq>| A |\<union>| fset_of_list Ps"
    "fset_of_list As |\<subseteq>| finite_assembly_coverage K Z"
proof -
  have all: "A |\<subseteq>| Z \<and> Z |\<subseteq>| A |\<union>| fset_of_list Ps \<and>
      fset_of_list As |\<subseteq>| finite_assembly_coverage K Z"
    using result
  proof (induction n arbitrary: A)
    case 0
    then show ?case by (auto simp: fsubset_iff fset_of_list_elem split: if_splits)
  next
    case (Suc n)
    let ?C="finite_demand_choice (\<lambda>a. length (filter (\<lambda>p. a |\<in>| K p) Ps)) As (finite_assembly_coverage K A)"
    show ?case
    proof (cases ?C)
      case None
      have covered: "fset_of_list As |\<subseteq>| finite_assembly_coverage K A"
        using None by (simp only: finite_demand_choice_none)
      show ?thesis using Suc.prems covered by (simp add: None)
    next
      case (Some a)
      obtain p where selected: "List.find (\<lambda>p. a |\<in>| K p) Ps=Some p"
        and recursive: "finite_assembly_search n As Ps K (finsert p A)=Some Z"
        using Suc.prems by (auto simp: fsubset_iff fset_of_list_elem Some split: option.splits)
      have member: "p\<in>set Ps" using selected by (auto simp: fsubset_iff fset_of_list_elem find_Some_iff)
      show ?thesis using Suc.IH[OF recursive] member by (auto simp: fsubset_iff fset_of_list_elem fset_of_list_elem)
    qed
  qed
  then show "A |\<subseteq>| Z" "Z |\<subseteq>| A |\<union>| fset_of_list Ps"
    "fset_of_list As |\<subseteq>| finite_assembly_coverage K Z" by blast+
qed

lemma finite_assembly_search_complete:
  assumes possible: "fset_of_list As |\<subseteq>| finite_assembly_coverage K (A |\<union>| fset_of_list Ps)"
    and budget: "fcard (fset_of_list As |-| finite_assembly_coverage K A) \<le> n"
  shows "finite_assembly_search n As Ps K A\<noteq>None"
  using possible budget
proof (induction n arbitrary: A)
  case 0
  then show ?case by (auto simp: fsubset_iff fset_of_list_elem)
next
  case (Suc n)
  let ?Q="fset_of_list As"
  let ?C="finite_demand_choice (\<lambda>a. length (filter (\<lambda>p. a |\<in>| K p) Ps)) As (finite_assembly_coverage K A)"
  show ?case
  proof (cases ?C)
    case None
    then show ?thesis by simp
  next
    case (Some a)
    have key: "a |\<in>| ?Q" "a |\<notin>| finite_assembly_coverage K A"
      by (rule finite_demand_choice_member[OF Some])+
    have supplied: "\<exists>p\<in>set Ps. a |\<in>| K p"
      using Suc.prems(1) key by (auto simp: fsubset_iff fset_of_list_elem finite_assembly_coverage_member fset_of_list_elem)
    obtain p where selected: "List.find (\<lambda>p. a |\<in>| K p) Ps=Some p"
      using supplied by (cases "List.find (\<lambda>p. a |\<in>| K p) Ps") (auto simp: fsubset_iff fset_of_list_elem find_None_iff)
    have part: "p\<in>set Ps" "a |\<in>| K p"
      using selected by (auto simp: fsubset_iff fset_of_list_elem find_Some_iff)
    have same: "finsert p A |\<union>| fset_of_list Ps=A |\<union>| fset_of_list Ps"
      using part(1) by (auto simp: fsubset_iff fset_of_list_elem fset_of_list_elem)
    have covered: "?Q |\<subseteq>| finite_assembly_coverage K (finsert p A |\<union>| fset_of_list Ps)"
      using Suc.prems(1) by (simp only: same)
    have progress: "fcard (?Q |-| finite_assembly_coverage K (finsert p A)) <
      fcard (?Q |-| finite_assembly_coverage K A)"
      using finite_demand_progress[OF key part(2)] by (simp add: sup_commute)
    have smaller: "fcard (?Q |-| finite_assembly_coverage K (finsert p A)) \<le> n"
      using progress Suc.prems(2) by arith
    show ?thesis using Suc.IH[OF covered smaller] by (simp only: finite_assembly_search.simps Some selected option.simps)
  qed
qed

section \<open>Each retained part must have an uncovered requirement if removed\<close>

fun finite_prune_assembly where
  "finite_prune_assembly [] K required A=A"
| "finite_prune_assembly (p#Ps) K required A=
    finite_prune_assembly Ps K required
      (if required |\<subseteq>| finite_assembly_coverage K (A |-| {|p|}) then A |-| {|p|} else A)"

lemma finite_prune_assembly_subset:
  "finite_prune_assembly Ps K required A |\<subseteq>| A"
  by (induction Ps arbitrary: A) (auto simp: fsubset_iff fset_of_list_elem split: if_splits)

lemma finite_prune_assembly_preserves:
  assumes "required |\<subseteq>| finite_assembly_coverage K A"
  shows "required |\<subseteq>| finite_assembly_coverage K (finite_prune_assembly Ps K required A)"
  using assms by (induction Ps arbitrary: A) (auto simp: fsubset_iff fset_of_list_elem split: if_splits)

lemma finite_prune_assembly_necessary:
  assumes member: "p\<in>set Ps" "p |\<in>| finite_prune_assembly Ps K required A"
  shows "\<not>required |\<subseteq>| finite_assembly_coverage K (finite_prune_assembly Ps K required A |-| {|p|})"
  using member
proof (induction Ps arbitrary: A)
  case Nil
  then show ?case by simp
next
  case (Cons q Ps)
  let ?B="if required |\<subseteq>| finite_assembly_coverage K (A |-| {|q|}) then A |-| {|q|} else A"
  let ?Z="finite_prune_assembly Ps K required ?B"
  have pz: "p |\<in>| ?Z" using Cons.prems(2) by simp
  show ?case
  proof (cases "p=q")
    case False
    have inside: "p\<in>set Ps" using Cons.prems(1) False by simp
    show ?thesis using Cons.IH[OF inside pz] by simp
  next
    case True
    have included: "?Z |\<subseteq>| ?B" by (rule finite_prune_assembly_subset)
    have kept: "\<not>required |\<subseteq>| finite_assembly_coverage K (A |-| {|q|})"
      using included pz True by (auto simp: fsubset_iff fset_of_list_elem split: if_splits)
    have rest: "?Z |-| {|p|} |\<subseteq>| A |-| {|p|}" using included kept by (auto simp: fsubset_iff fset_of_list_elem)
    have coverage: "finite_assembly_coverage K (?Z |-| {|p|}) |\<subseteq>|
      finite_assembly_coverage K (A |-| {|p|})" by (rule finite_assembly_coverage_mono[OF rest])
    show ?thesis using kept coverage by (simp only: finite_prune_assembly.simps True) blast
  qed
qed

lemma finite_assembly_minimal:
  assumes necessary: "\<forall>p\<in>fset A. \<not>required |\<subseteq>| finite_assembly_coverage K (A |-| {|p|})"
    and included: "Z |\<subseteq>| A" and sufficient: "required |\<subseteq>| finite_assembly_coverage K Z"
  shows "Z=A"
proof (rule ccontr)
  assume "Z\<noteq>A"
  then obtain p where part: "p |\<in>| A" "p |\<notin>| Z" using included by (auto simp: fsubset_iff fset_of_list_elem)
  have smaller: "Z |\<subseteq>| A |-| {|p|}" using included part(2) by (auto simp: fsubset_iff fset_of_list_elem)
  have covered: "required |\<subseteq>| finite_assembly_coverage K (A |-| {|p|})"
    using finite_assembly_coverage_mono[OF smaller] sufficient by blast
  show False using necessary part(1) covered by blast
qed

definition finite_construct_candidate where
  "finite_construct_candidate As Ps K=map_option
    (finite_prune_assembly Ps K (fset_of_list As))
    (finite_assembly_search (fcard (fset_of_list As)) As Ps K {||})"

theorem finite_construct_candidate_sound:
  assumes built: "finite_construct_candidate As Ps K=Some A"
  shows "A |\<in>| finite_candidate_assemblies (fset_of_list Ps) (fset_of_list As) K"
    "\<forall>Z. Z |\<subseteq>| A \<and> fset_of_list As |\<subseteq>| finite_assembly_coverage K Z \<longrightarrow> Z=A"
proof -
  obtain Z where searched: "finite_assembly_search (fcard (fset_of_list As)) As Ps K {||}=Some Z"
    and actual: "A=finite_prune_assembly Ps K (fset_of_list As) Z"
    using built by (auto simp: fsubset_iff fset_of_list_elem finite_construct_candidate_def split: option.splits)
  have search: "Z |\<subseteq>| fset_of_list Ps" "fset_of_list As |\<subseteq>| finite_assembly_coverage K Z"
    using finite_assembly_search_sound[OF searched] by (auto simp: fsubset_iff fset_of_list_elem)
  have subset: "A |\<subseteq>| Z" by (simp only: actual; rule finite_prune_assembly_subset)
  have covered: "fset_of_list As |\<subseteq>| finite_assembly_coverage K A"
    by (simp only: actual; rule finite_prune_assembly_preserves[OF search(2)])
  show "A |\<in>| finite_candidate_assemblies (fset_of_list Ps) (fset_of_list As) K"
    using search(1) subset covered by (auto simp: fsubset_iff fset_of_list_elem finite_candidate_assembly_member)
  have necessary: "\<forall>p\<in>fset A. \<not>fset_of_list As |\<subseteq>| finite_assembly_coverage K (A |-| {|p|})"
    using finite_prune_assembly_necessary[of _ Ps K "fset_of_list As" Z] search(1) subset
    by (auto simp only: fsubset_iff fset_of_list_elem actual fset_of_list_elem)
  show "\<forall>Z. Z |\<subseteq>| A \<and> fset_of_list As |\<subseteq>| finite_assembly_coverage K Z \<longrightarrow> Z=A"
    using finite_assembly_minimal[OF necessary] by blast
qed

theorem finite_construct_candidate_failure:
  "finite_construct_candidate As Ps K=None \<longleftrightarrow>
    \<not>fset_of_list As |\<subseteq>| finite_assembly_coverage K (fset_of_list Ps)"
proof -
  have complete: "fset_of_list As |\<subseteq>| finite_assembly_coverage K (fset_of_list Ps) \<Longrightarrow>
    finite_assembly_search (fcard (fset_of_list As)) As Ps K {||}\<noteq>None"
    by (rule finite_assembly_search_complete) simp_all
  have sound: "finite_assembly_search (fcard (fset_of_list As)) As Ps K {||}=Some A \<Longrightarrow>
    fset_of_list As |\<subseteq>| finite_assembly_coverage K (fset_of_list Ps)" for A
    using finite_assembly_search_sound[of "fcard (fset_of_list As)" As Ps K "{||}" A]
      finite_assembly_coverage_mono[of A "fset_of_list Ps" K] by (auto simp: fsubset_iff fset_of_list_elem)
  show ?thesis using complete sound
    by (auto simp: fsubset_iff fset_of_list_elem finite_construct_candidate_def split: option.splits)
qed

corollary finite_construct_candidate_complete:
  "finite_construct_candidate As Ps K\<noteq>None \<longleftrightarrow>
    finite_candidate_assemblies (fset_of_list Ps) (fset_of_list As) K\<noteq>{||}"
  using finite_assembly_coverage_mono[of _ "fset_of_list Ps" K]
  by (auto simp: fsubset_iff fset_of_list_elem finite_construct_candidate_failure finite_candidate_assembly_member
    intro!: exI[of _ "fset_of_list Ps"])

theorem finite_construct_candidate_necessity_witness:
  assumes built: "finite_construct_candidate As Ps K=Some A" and member: "p |\<in>| A"
  shows "\<exists>q. q |\<in>| fset_of_list As \<and> q |\<in>| K p \<and>
    q |\<notin>| finite_assembly_coverage K (A |-| {|p|})"
proof -
  have accepted: "A |\<subseteq>| fset_of_list Ps" "fset_of_list As |\<subseteq>| finite_assembly_coverage K A"
    using finite_construct_candidate_sound(1)[OF built] by (simp_all add: finite_candidate_assembly_member)
  have removed: "A |-| {|p|}\<noteq>A" using member by (auto simp: fsubset_iff fset_of_list_elem)
  have fails: "\<not>fset_of_list As |\<subseteq>| finite_assembly_coverage K (A |-| {|p|})"
    using finite_construct_candidate_sound(2)[OF built] removed by (auto simp: fsubset_iff fset_of_list_elem)
  obtain q where key: "q |\<in>| fset_of_list As" "q |\<notin>| finite_assembly_coverage K (A |-| {|p|})"
    using fails by (auto simp: fsubset_iff fset_of_list_elem)
  have part: "q |\<in>| K p" using accepted(2) key
    by (auto simp: fsubset_iff fset_of_list_elem finite_assembly_coverage_member; blast)
  show ?thesis using key part by blast
qed

text \<open>
  The declared language contains every subset of the supplied parts. Search
  constructs a sufficient assembly by covering missing requirements, then
  removes parts whose deletion preserves the complete requirement set. Failure
  means an actual requirement is uncovered even by the whole available language.
  Every retained part has a requirement witness. This proves inclusion
  minimality, not minimum cardinality or adequacy outside this declared scope.
\<close>

export_code finite_construct_candidate checking SML

end
