theory Finite_Directed_Contributions
  imports "Finite_Compatible_Unions" "Finite_Demand_Selection"
begin

section \<open>Only a complete compatible contribution can supply a missing key\<close>

definition finite_binding_alternatives where
  "finite_binding_alternatives scope B U a=ffilter
    (\<lambda>W. a |\<in>| fimage fst W \<and> fimage fst W |\<subseteq>| scope \<and>
      finite_relation_functional (U |\<union>| W)) B"

lemma finite_binding_alternative:
  "W |\<in>| finite_binding_alternatives scope B U a \<longleftrightarrow>
    W |\<in>| B \<and> a |\<in>| fimage fst W \<and> fimage fst W |\<subseteq>| scope \<and>
      finite_relation_functional (U |\<union>| W)"
  by (simp add: finite_binding_alternatives_def)

fun finite_directed_binding_search where
  "finite_directed_binding_search 0 As B U=
    (if fimage fst U=fset_of_list As then {|U|} else {||})"
| "finite_directed_binding_search (Suc n) As B U=
    (case finite_demand_choice (\<lambda>a. fcard (finite_binding_alternatives (fset_of_list As) B U a))
      As (fimage fst U) of None \<Rightarrow> {|U|}
    | Some a \<Rightarrow> ffUnion (fimage (\<lambda>W. finite_directed_binding_search n As B (U |\<union>| W))
        (finite_binding_alternatives (fset_of_list As) B U a)))"

lemma finite_directed_binding_search_sound:
  assumes generated: "U |\<in>| finite_compatible_unions B"
    and scope: "fimage fst U |\<subseteq>| fset_of_list As"
    and result: "V |\<in>| finite_directed_binding_search n As B U"
  shows "V |\<in>| finite_compatible_unions B" "fimage fst V=fset_of_list As" "U |\<subseteq>| V"
proof -
  have all: "V |\<in>| finite_compatible_unions B \<and> fimage fst V=fset_of_list As \<and> U |\<subseteq>| V"
    using generated scope result
  proof (induction n arbitrary: U)
    case 0
    then show ?case by (auto split: if_splits)
  next
    case (Suc n)
    let ?C="finite_demand_choice (\<lambda>a. fcard (finite_binding_alternatives (fset_of_list As) B U a)) As (fimage fst U)"
    show ?case
    proof (cases ?C)
      case None
      have covered: "fset_of_list As |\<subseteq>| fimage fst U"
        using None by (simp only: finite_demand_choice_none)
      show ?thesis using Suc.prems covered by (auto simp: None)
    next
      case (Some a)
      obtain W where part: "W |\<in>| finite_binding_alternatives (fset_of_list As) B U a"
        and recursive: "V |\<in>| finite_directed_binding_search n As B (U |\<union>| W)"
        using Suc.prems(3) by (simp only: finite_directed_binding_search.simps Some option.simps
          finite_union_image_member) blast
      have built: "U |\<union>| W |\<in>| finite_compatible_unions B"
        by (rule finite_compatible_union_add[OF Suc.prems(1)]) (use part in \<open>auto simp: finite_binding_alternative\<close>)
      have inside: "fimage fst (U |\<union>| W) |\<subseteq>| fset_of_list As"
        using Suc.prems(2) part by (auto simp: finite_binding_alternative)
      show ?thesis using Suc.IH[OF built inside recursive] by auto
    qed
  qed
  then show "V |\<in>| finite_compatible_unions B" "fimage fst V=fset_of_list As" "U |\<subseteq>| V" by blast+
qed

lemma finite_directed_binding_search_complete:
  assumes generated: "V |\<in>| finite_compatible_unions B"
    and partial: "U |\<subseteq>| V" and scope: "fimage fst V=fset_of_list As"
    and budget: "fcard (fset_of_list As |-| fimage fst U) \<le> n"
  shows "V |\<in>| finite_directed_binding_search n As B U"
  using partial budget
proof (induction n arbitrary: U)
  case 0
  have covered: "fset_of_list As |\<subseteq>| fimage fst U" using 0.prems(2) by auto
  have domain: "fimage fst U=fimage fst V" using 0.prems(1) covered scope by auto
  have functional: "finite_relation_functional V" using generated by (simp only: finite_compatible_union_member) blast
  have same: "U=V" by (rule finite_functional_included_domain[OF functional 0.prems(1) domain])
  show ?case by (simp add: same scope)
next
  case (Suc n)
  let ?A="fset_of_list As"
  let ?C="finite_demand_choice (\<lambda>a. fcard (finite_binding_alternatives ?A B U a)) As (fimage fst U)"
  have functional: "finite_relation_functional V" using generated by (simp only: finite_compatible_union_member) blast
  show ?case
  proof (cases ?C)
    case None
    have covered: "?A |\<subseteq>| fimage fst U" using None by (simp only: finite_demand_choice_none)
    have domain: "fimage fst U=fimage fst V" using Suc.prems(1) covered scope by auto
    have same: "U=V" by (rule finite_functional_included_domain[OF functional Suc.prems(1) domain])
    show ?thesis by (simp only: finite_directed_binding_search.simps None option.simps same) simp
  next
    case (Some a)
    have key: "a |\<in>| ?A" "a |\<notin>| fimage fst U"
      by (rule finite_demand_choice_member[OF Some])+
    obtain W where part: "W |\<in>| B" "W |\<subseteq>| V" "a |\<in>| fimage fst W"
      by (rule finite_compatible_union_covering_part[OF generated]) (use key(1) scope in auto)
    have included: "U |\<union>| W |\<subseteq>| V" using Suc.prems(1) part(2) by auto
    have compatible: "finite_relation_functional (U |\<union>| W)"
      by (rule finite_relation_functional_subset[OF functional included])
    have available: "W |\<in>| finite_binding_alternatives ?A B U a"
      using part compatible scope by (auto simp: finite_binding_alternative)
    have progress: "fcard (?A |-| fimage fst (U |\<union>| W)) < fcard (?A |-| fimage fst U)"
      using finite_demand_progress[OF key part(3)] by simp
    have smaller: "fcard (?A |-| fimage fst (U |\<union>| W)) \<le> n"
      using progress Suc.prems(2) by arith
    have found: "V |\<in>| finite_directed_binding_search n As B (U |\<union>| W)"
      by (rule Suc.IH[OF included smaller])
    show ?thesis by (simp only: finite_directed_binding_search.simps Some option.simps finite_union_image_member)
      (use available found in blast)
  qed
qed

section \<open>The full union meaning and its scope-directed implementation agree\<close>

definition finite_scoped_compatible_unions where
  "finite_scoped_compatible_unions scope B=
    ffilter (\<lambda>V. fimage fst V=scope) (finite_compatible_unions B)"

lemma finite_scoped_compatible_union_member:
  "V |\<in>| finite_scoped_compatible_unions scope B \<longleftrightarrow>
    V |\<in>| finite_compatible_unions B \<and> fimage fst V=scope"
  by (simp add: finite_scoped_compatible_unions_def)

theorem finite_directed_binding_search_exact:
  "finite_directed_binding_search (fcard (fset_of_list As)) As B {||}=
    finite_scoped_compatible_unions (fset_of_list As) B"
proof (rule fset_inject[THEN iffD1], rule set_eqI)
  fix V
  show "V\<in>fset (finite_directed_binding_search (fcard (fset_of_list As)) As B {||}) \<longleftrightarrow>
    V\<in>fset (finite_scoped_compatible_unions (fset_of_list As) B)"
    using finite_directed_binding_search_sound[OF finite_compatible_union_initial, of As V]
      finite_directed_binding_search_complete[of V B "{||}" As "fcard (fset_of_list As)"]
    by (auto simp: finite_scoped_compatible_union_member)
qed

definition set_scoped_compatible_unions where
  "set_scoped_compatible_unions scope B=finite_scoped_compatible_unions (Abs_fset scope) B"

lemma set_scoped_compatible_unions_list [code]:
  "set_scoped_compatible_unions (set As) B=
    finite_directed_binding_search (fcard (fset_of_list As)) As B {||}"
proof -
  have representation: "Abs_fset (set As)=fset_of_list As"
    using fset_inverse[of "fset_of_list As"] by (simp only: fset_of_list.rep_eq)
  show ?thesis by (simp only: set_scoped_compatible_unions_def representation finite_directed_binding_search_exact)
qed

lemma finite_scoped_compatible_unions_code [code]:
  "finite_scoped_compatible_unions scope B=set_scoped_compatible_unions (fset scope) B"
  by (simp only: set_scoped_compatible_unions_def fset_inverse)

text \<open>
  The semantic relation still contains every compatible union. Its scoped
  implementation chooses a missing variable with the fewest currently
  compatible contributors. Each branch adds one complete contribution and
  strictly reduces the missing scope. Exactness covers every complete binding,
  all conflicts and missing-key failures, and every list presentation of the
  demanded scope. The number of distinct complete answers can still be large.
\<close>

export_code finite_scoped_compatible_unions checking SML

end
