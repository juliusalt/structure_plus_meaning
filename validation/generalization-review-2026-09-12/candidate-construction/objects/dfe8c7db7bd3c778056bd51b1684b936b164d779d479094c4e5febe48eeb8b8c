theory Finite_Directed_Contributions
  imports Finite_Compatible_Unions Finite_Demand_Selection
begin

section \<open>Complete fragments remain feasible under a partial assignment\<close>

definition finite_assignment_agrees where
  "finite_assignment_agrees r W \<longleftrightarrow>
    fBall W (\<lambda>s. fst s=fst r \<longrightarrow> snd s=snd r)"

lemma finite_functional_insert:
  "finite_relation_functional (finsert r W) \<longleftrightarrow>
    finite_relation_functional W \<and> finite_assignment_agrees r W"
  by (cases r) (auto simp: fsubset_iff fset_of_list_elem finite_relation_functional_def finite_assignment_agrees_def)

lemma finite_assignment_agrees_union [simp]:
  "finite_assignment_agrees r (U |\<union>| W) \<longleftrightarrow>
    finite_assignment_agrees r U \<and> finite_assignment_agrees r W"
  by (auto simp: fsubset_iff fset_of_list_elem finite_assignment_agrees_def)

lemma finite_assignment_agrees_fresh:
  assumes fresh: "fst r |\<notin>| fimage fst U"
  shows "finite_assignment_agrees r U"
proof (unfold finite_assignment_agrees_def, rule fBallI, intro impI)
  fix s assume row: "s |\<in>| U" and key: "fst s=fst r"
  have present: "fst s |\<in>| fimage fst U" by (rule fimageI[OF row])
  show "snd s=snd r" using fresh present by (simp add: key)
qed

definition finite_compatible_binding_parts where
  "finite_compatible_binding_parts scope B U=ffilter
    (\<lambda>W. fimage fst W |\<subseteq>| scope \<and> finite_relation_functional (U |\<union>| W)) B"

lemma finite_compatible_binding_part:
  "W |\<in>| finite_compatible_binding_parts scope B U \<longleftrightarrow>
    W |\<in>| B \<and> fimage fst W |\<subseteq>| scope \<and> finite_relation_functional (U |\<union>| W)"
  by (auto simp: finite_compatible_binding_parts_def)

lemma finite_compatible_binding_parts_insert:
  assumes fresh: "fst r |\<notin>| fimage fst U"
  shows "finite_compatible_binding_parts scope B (finsert r U)=
    ffilter (finite_assignment_agrees r) (finite_compatible_binding_parts scope B U)"
proof (rule fset_eqI)
  fix W
  have agrees: "finite_assignment_agrees r U" by (rule finite_assignment_agrees_fresh[OF fresh])
  show "W |\<in>| finite_compatible_binding_parts scope B (finsert r U) \<longleftrightarrow>
    W |\<in>| ffilter (finite_assignment_agrees r) (finite_compatible_binding_parts scope B U)"
    by (simp only: finite_compatible_binding_part ffmember_filter funion_finsert_left
      finite_functional_insert finite_assignment_agrees_union agrees; blast)
qed

lemma finite_compatible_binding_value:
  assumes selected: "r |\<in>| ffUnion (finite_compatible_binding_parts scope B U)"
  shows "finite_relation_functional (finsert r U)" "fst r |\<in>| scope"
proof -
  obtain W where part: "W |\<in>| finite_compatible_binding_parts scope B U" "r |\<in>| W"
    using selected by (simp only: ffUnion_membership) blast
  have functional: "finite_relation_functional (U |\<union>| W)"
    and domain: "fimage fst W |\<subseteq>| scope" using part(1) by (auto simp: fsubset_iff fset_of_list_elem finite_compatible_binding_part)
  show "finite_relation_functional (finsert r U)"
    by (rule finite_relation_functional_subset[OF functional]) (use part(2) in \<open>auto simp: fsubset_iff fset_of_list_elem\<close>)
  have key: "fst r |\<in>| fimage fst W" by (rule fimageI[OF part(2)])
  show "fst r |\<in>| scope" using key domain by (auto simp: fsubset_iff fset_of_list_elem)
qed

lemma finite_compatible_target_supported:
  assumes generated: "V |\<in>| finite_compatible_unions B"
    and included: "U |\<subseteq>| V" and domain: "fimage fst V=scope"
  shows "V |\<subseteq>| ffUnion (finite_compatible_binding_parts scope B U)"
proof -
  have functional: "finite_relation_functional V" using generated by (simp only: finite_compatible_union_member)
  have part: "W |\<in>| finite_compatible_binding_parts scope B U"
    if "W |\<in>| B" "W |\<subseteq>| V" for W
  proof -
    have compatible: "finite_relation_functional (U |\<union>| W)"
      by (rule finite_relation_functional_subset[OF functional]) (use included that(2) in \<open>auto simp: fsubset_iff fset_of_list_elem\<close>)
    have keys: "fimage fst W |\<subseteq>| scope"
      using fimage_mono[OF that(2), of fst] by (simp only: domain)
    show ?thesis by (simp only: finite_compatible_binding_part; intro conjI that(1) keys compatible)

  qed
  have subset: "ffilter (\<lambda>W. W |\<subseteq>| V) B |\<subseteq>| finite_compatible_binding_parts scope B U"
    using part by (auto simp: fsubset_iff fset_of_list_elem)
  show ?thesis using ffunion_mono[OF subset] finite_compatible_union_support[OF generated] by simp
qed

lemma finite_compatible_complete_supported:
  assumes functional: "finite_relation_functional U" and domain: "fimage fst U=scope"
    and covered: "scope |\<subseteq>| fimage fst (ffUnion (finite_compatible_binding_parts scope B U))"
  shows "U |\<in>| finite_compatible_unions B"
proof -
  let ?A="finite_compatible_binding_parts scope B U"
  have each: "W |\<subseteq>| U" if "W |\<in>| ?A" for W
  proof -
    have compatible: "finite_relation_functional (U |\<union>| W)"
      and inside: "fimage fst W |\<subseteq>| scope" using that by (auto simp: fsubset_iff fset_of_list_elem finite_compatible_binding_part)
    have same_domain: "fimage fst U=fimage fst (U |\<union>| W)" using inside domain by (auto simp: fsubset_iff fset_of_list_elem)
    have same: "U=U |\<union>| W"
      by (rule finite_functional_included_domain[OF compatible _ same_domain]) simp
    show ?thesis using same by (auto simp: fsubset_iff fset_of_list_elem)
  qed
  have subset: "ffUnion ?A |\<subseteq>| U" using each by (auto simp: fsubset_iff fset_of_list_elem ffUnion_membership)
  have same_domain: "fimage fst (ffUnion ?A)=fimage fst U" using subset covered domain by (auto simp: fsubset_iff fset_of_list_elem)
  have reconstructed: "ffUnion ?A=U" by (rule finite_functional_included_domain[OF functional subset same_domain])
  have origin: "?A |\<subseteq>| B" by (auto simp: fsubset_iff fset_of_list_elem finite_compatible_binding_parts_def)
  show ?thesis by (simp only: finite_compatible_union_member; intro conjI functional)
    (rule exI[of _ ?A]; use origin reconstructed in blast)
qed

section \<open>Search branches on distinct possible values of an uncovered key\<close>

fun finite_value_binding_search where
  "finite_value_binding_search 0 As B U=
    (if fimage fst U=fset_of_list As \<and> fset_of_list As |\<subseteq>| fimage fst (ffUnion B)
     then {|U|} else {||})"
| "finite_value_binding_search (Suc n) As B U=
    (let M=ffUnion B in if \<not>fset_of_list As |\<subseteq>| fimage fst M then {||} else
      case finite_demand_choice (\<lambda>a. fcard (ffilter (\<lambda>r. fst r=a) M)) As (fimage fst U) of
        None \<Rightarrow> {|U|}
      | Some a \<Rightarrow> ffUnion (fimage (\<lambda>r. finite_value_binding_search n As
          (ffilter (finite_assignment_agrees r) B) (finsert r U)) (ffilter (\<lambda>r. fst r=a) M)))"

lemma finite_value_binding_search_sound:
  assumes functional: "finite_relation_functional U"
    and inside: "fimage fst U |\<subseteq>| fset_of_list As"
    and result: "V |\<in>| finite_value_binding_search n As (finite_compatible_binding_parts (fset_of_list As) B U) U"
  shows "V |\<in>| finite_compatible_unions B" "fimage fst V=fset_of_list As" "U |\<subseteq>| V"
proof -
  have all: "V |\<in>| finite_compatible_unions B \<and> fimage fst V=fset_of_list As \<and> U |\<subseteq>| V"
    using functional inside result
  proof (induction n arbitrary: U)
    case 0
    then show ?case using finite_compatible_complete_supported[of U "fset_of_list As" B]
      by (auto simp: fsubset_iff fset_of_list_elem split: if_splits)
  next
    case (Suc n)
    let ?A="fset_of_list As"
    let ?P="finite_compatible_binding_parts ?A B U"
    let ?M="ffUnion ?P"
    let ?C="finite_demand_choice (\<lambda>a. fcard (ffilter (\<lambda>r. fst r=a) ?M)) As (fimage fst U)"
    have covered: "?A |\<subseteq>| fimage fst ?M"
      using Suc.prems(3) by (auto simp: fsubset_iff fset_of_list_elem Let_def split: if_splits)
    show ?case
    proof (cases ?C)
      case None
      have covers: "?A |\<subseteq>| fimage fst U" using None by (simp only: finite_demand_choice_none)
      have domain: "fimage fst U=?A" by (rule order_antisym[OF Suc.prems(2) covers])
      have generated: "U |\<in>| finite_compatible_unions B"
        by (rule finite_compatible_complete_supported[OF Suc.prems(1) domain covered])
      have equal: "V=U" using Suc.prems(3) by (simp add: Let_def covered None)
      show ?thesis using generated domain by (simp add: equal)
    next
      case (Some a)
      have returned: "V |\<in>| ffUnion (fimage (\<lambda>r. finite_value_binding_search n As
        (ffilter (finite_assignment_agrees r) ?P) (finsert r U)) (ffilter (\<lambda>r. fst r=a) ?M))"
        using Suc.prems(3) by (simp add: Let_def covered Some)
      obtain r where selected: "r |\<in>| ffilter (\<lambda>r. fst r=a) ?M"
        and recursive: "V |\<in>| finite_value_binding_search n As (ffilter (finite_assignment_agrees r) ?P) (finsert r U)"
        using returned by (simp only: finite_union_image_member; blast)
      have option: "r |\<in>| ?M" "fst r=a" using selected by simp_all
      have missing: "a |\<notin>| fimage fst U" by (rule finite_demand_choice_member(2)[OF Some])
      have fresh: "fst r |\<notin>| fimage fst U" by (simp only: option(2) missing)
      have compatible: "finite_relation_functional (finsert r U)" and key: "fst r |\<in>| ?A"
        by (rule finite_compatible_binding_value[OF option(1)])+
      have scope: "fimage fst (finsert r U) |\<subseteq>| ?A" using Suc.prems(2) key by (auto simp: fsubset_iff fset_of_list_elem)
      have child: "V |\<in>| finite_value_binding_search n As (finite_compatible_binding_parts ?A B (finsert r U)) (finsert r U)"
        using recursive by (simp only: finite_compatible_binding_parts_insert[OF fresh])
      show ?thesis using Suc.IH[OF compatible scope child] by (auto simp: fsubset_iff fset_of_list_elem)
    qed
  qed
  then show "V |\<in>| finite_compatible_unions B" "fimage fst V=fset_of_list As" "U |\<subseteq>| V" by blast+
qed

lemma finite_value_binding_search_complete:
  assumes generated: "V |\<in>| finite_compatible_unions B" and domain: "fimage fst V=fset_of_list As"
    and partial: "U |\<subseteq>| V" and budget: "fcard (fset_of_list As |-| fimage fst U) \<le> n"
  shows "V |\<in>| finite_value_binding_search n As (finite_compatible_binding_parts (fset_of_list As) B U) U"
  using partial budget
proof (induction n arbitrary: U)
  case 0
  have covers: "fset_of_list As |\<subseteq>| fimage fst U" using 0.prems(2) by (auto simp: fsubset_iff fset_of_list_elem)
  have same_domain: "fimage fst U=fimage fst V" using covers 0.prems(1) domain by (auto simp: fsubset_iff fset_of_list_elem)
  have functional: "finite_relation_functional V" using generated by (simp only: finite_compatible_union_member)
  have same: "U=V" by (rule finite_functional_included_domain[OF functional 0.prems(1) same_domain])
  have supported: "V |\<subseteq>| ffUnion (finite_compatible_binding_parts (fset_of_list As) B U)"
    by (rule finite_compatible_target_supported[OF generated 0.prems(1) domain])
  show ?case using supported by (auto simp: fsubset_iff fset_of_list_elem same domain)
next
  case (Suc n)
  let ?A="fset_of_list As"
  let ?P="finite_compatible_binding_parts ?A B U"
  let ?M="ffUnion ?P"
  let ?C="finite_demand_choice (\<lambda>a. fcard (ffilter (\<lambda>r. fst r=a) ?M)) As (fimage fst U)"
  have supported: "V |\<subseteq>| ?M" by (rule finite_compatible_target_supported[OF generated Suc.prems(1) domain])
  have covered: "?A |\<subseteq>| fimage fst ?M" using supported domain by (auto simp: fsubset_iff fset_of_list_elem)
  show ?case
  proof (cases ?C)
    case None
    have covers: "?A |\<subseteq>| fimage fst U" using None by (simp only: finite_demand_choice_none)
    have same_domain: "fimage fst U=fimage fst V" using Suc.prems(1) covers domain by (auto simp: fsubset_iff fset_of_list_elem)
    have functional: "finite_relation_functional V" using generated by (simp only: finite_compatible_union_member)
    have same: "U=V" by (rule finite_functional_included_domain[OF functional Suc.prems(1) same_domain])
    have result: "finite_value_binding_search (Suc n) As ?P U={|U|}"
      by (simp add: Let_def covered None)
    show ?thesis by (simp only: result same; simp)
  next
    case (Some a)
    have key: "a |\<in>| ?A" "a |\<notin>| fimage fst U" by (rule finite_demand_choice_member[OF Some])+
    obtain t where row: "(a,t) |\<in>| V" using key(1) domain by (auto simp: fsubset_iff fset_of_list_elem finite_image_member)
    have option: "(a,t) |\<in>| ffilter (\<lambda>r. fst r=a) ?M" using row supported by (auto simp: fsubset_iff fset_of_list_elem)
    have partial: "finsert (a,t) U |\<subseteq>| V" using Suc.prems(1) row by (auto simp: fsubset_iff fset_of_list_elem)
    have progress: "fcard (?A |-| fimage fst (finsert (a,t) U)) < fcard (?A |-| fimage fst U)"
      using finite_demand_progress[OF key, where added="{|a|}"] by (simp add: sup_commute)
    have smaller: "fcard (?A |-| fimage fst (finsert (a,t) U)) \<le> n"
      using progress Suc.prems(2) by arith
    have child: "V |\<in>| finite_value_binding_search n As
        (ffilter (finite_assignment_agrees (a,t)) ?P) (finsert (a,t) U)"
      using Suc.IH[OF partial smaller] by (simp only: finite_compatible_binding_parts_insert[of "(a,t)" U ?A B, simplified key(2) fst_conv])
    show ?thesis by (simp only: finite_value_binding_search.simps Let_def covered if_False Some option.simps finite_union_image_member)
      (use option child in blast)
  qed
qed

section \<open>The full union meaning and its scoped search agree\<close>

definition finite_scoped_compatible_unions where
  "finite_scoped_compatible_unions scope B=ffilter (\<lambda>V. fimage fst V=scope) (finite_compatible_unions B)"

lemma finite_scoped_compatible_union_member:
  "V |\<in>| finite_scoped_compatible_unions scope B \<longleftrightarrow>
    V |\<in>| finite_compatible_unions B \<and> fimage fst V=scope"
  by (simp add: finite_scoped_compatible_unions_def)

theorem finite_value_binding_search_exact:
  "finite_value_binding_search (fcard (fset_of_list As)) As
    (finite_compatible_binding_parts (fset_of_list As) B {||}) {||}=
    finite_scoped_compatible_unions (fset_of_list As) B"
proof (rule fset_inject[THEN iffD1], rule set_eqI)
  fix V
  have functional: "finite_relation_functional {||}" by (simp add: finite_relation_functional_def)
  show "V\<in>fset (finite_value_binding_search (fcard (fset_of_list As)) As (finite_compatible_binding_parts (fset_of_list As) B {||}) {||})
    \<longleftrightarrow> V\<in>fset (finite_scoped_compatible_unions (fset_of_list As) B)"
    using finite_value_binding_search_sound[OF functional, of As V "fcard (fset_of_list As)" B]
      finite_value_binding_search_complete[of V B As "{||}" "fcard (fset_of_list As)"]
    by (auto simp: fsubset_iff fset_of_list_elem finite_scoped_compatible_union_member)
qed

definition set_scoped_compatible_unions where
  "set_scoped_compatible_unions scope B=finite_scoped_compatible_unions (Abs_fset scope) B"

lemma set_scoped_compatible_unions_list [code]:
  "set_scoped_compatible_unions (set As) B=finite_value_binding_search (fcard (fset_of_list As)) As
    (finite_compatible_binding_parts (fset_of_list As) B {||}) {||}"
proof -
  have representation: "Abs_fset (set As)=fset_of_list As"
    using fset_inverse[of "fset_of_list As"] by (simp only: fset_of_list.rep_eq)
  show ?thesis by (simp only: set_scoped_compatible_unions_def representation finite_value_binding_search_exact)
qed

lemma finite_scoped_compatible_unions_code [code]:
  "finite_scoped_compatible_unions scope B=set_scoped_compatible_unions (fset scope) B"
  by (simp only: set_scoped_compatible_unions_def fset_inverse)

text \<open>
  The meaning retains every compatible union. Search instead chooses a missing
  key with the fewest distinct possible values. It keeps whole fragments that
  remain compatible after each assignment; unsupported keys reject immediately.
  A partial assignment is a search candidate. A completed result is admitted
  only when whole original fragments cover every demanded key. The exactness
  theorem preserves every complete binding under all scope presentations.
\<close>

export_code finite_scoped_compatible_unions checking SML

end
