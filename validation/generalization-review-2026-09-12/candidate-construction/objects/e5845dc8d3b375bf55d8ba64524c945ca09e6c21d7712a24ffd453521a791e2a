theory Factor_Binding_Contributions
  imports "RRA_Factor_Structural_Bootstrap.Factor_Matching_Instances" "Finite_Compatible_Unions"
begin

section \<open>Each contribution is recovered from an actual source pattern\<close>

definition pattern_binding_observation where
  "pattern_binding_observation P obs i p t V \<longleftrightarrow>
    (i,p)\<in>P \<and> (i,t)\<in>obs \<and>
    term_bindings_formed (pattern_variables p) V \<and> pattern_instance V p t"

definition finite_pattern_observations where
  "finite_pattern_observations P obs=ffUnion (fimage (\<lambda>(i,p).
    fimage (\<lambda>(j,t). (i,p,t))
      (ffilter (\<lambda>(j,t). j=i \<and> finite_pattern_accepts p t) obs)) P)"

lemma finite_pattern_observation_member:
  "(i,p,t) |\<in>| finite_pattern_observations P obs \<longleftrightarrow>
    (i,p) |\<in>| P \<and> (i,t) |\<in>| obs \<and> finite_pattern_accepts p t"
  by (auto simp: finite_pattern_observations_def ffUnion.rep_eq fimage.rep_eq
    image_iff split: prod.splits; force)

section \<open>The match result satisfies the independent binding observation\<close>

theorem finite_pattern_observation_witness:
  "((i,p,t) |\<in>| finite_pattern_observations P obs \<and> V=finite_matching_bindings p t) \<longleftrightarrow>
    (i,p) |\<in>| P \<and> (i,t) |\<in>| obs \<and>
    finite_term_bindings_formed (finite_pattern_variables p) V \<and> finite_pattern_instance V p t"
proof
  assume actual: "(i,p,t) |\<in>| finite_pattern_observations P obs \<and> V=finite_matching_bindings p t"
  then show "(i,p) |\<in>| P \<and> (i,t) |\<in>| obs \<and>
      finite_term_bindings_formed (finite_pattern_variables p) V \<and> finite_pattern_instance V p t"
    by (auto simp: finite_pattern_observation_member finite_pattern_accepts_def)
next
  assume actual: "(i,p) |\<in>| P \<and> (i,t) |\<in>| obs \<and>
    finite_term_bindings_formed (finite_pattern_variables p) V \<and> finite_pattern_instance V p t"
  have bindings: "finite_term_bindings_formed (finite_pattern_variables p) V"
    and inst: "finite_pattern_instance V p t" using actual by blast+
  have same: "finite_matching_bindings p t=V"
    by (rule finite_matching_complete_scope[OF bindings inst])
  have decoded_bindings: "term_bindings_formed (pattern_variables (decode_finite_pattern p))
      (decode_finite_term_bindings V)"
    using bindings by (simp only: finite_term_bindings_formed_correct finite_pattern_variables_correct)
  have decoded_instance: "pattern_instance (decode_finite_term_bindings V) (decode_finite_pattern p)
      (decode_finite_term t)"
    using inst by (simp only: finite_pattern_instance_correct)
  have formed: "finite_term_formed t"
    using pattern_instance_formed_term[OF decoded_bindings decoded_instance]
    by (simp only: finite_term_formed_correct)
  show "(i,p,t) |\<in>| finite_pattern_observations P obs \<and> V=finite_matching_bindings p t"
    using actual formed by (simp add: finite_pattern_observation_member finite_pattern_accepts_def same)
qed

theorem finite_pattern_observation_contract:
  "((i,p,t) |\<in>| finite_pattern_observations P obs \<and> V=finite_matching_bindings p t) \<longleftrightarrow>
    pattern_binding_observation (map_relation_values decode_finite_pattern (fset P))
      (map_relation_values decode_finite_term (fset obs)) i (decode_finite_pattern p)
      (decode_finite_term t) (decode_finite_term_bindings V)"
  by (simp add: finite_pattern_observation_witness pattern_binding_observation_def
    finite_term_bindings_formed_correct finite_pattern_variables_correct finite_pattern_instance_correct)

definition finite_observed_bindings where
  "finite_observed_bindings P obs=finite_compatible_unions
    (fimage (\<lambda>(i,p,t). finite_matching_bindings p t) (finite_pattern_observations P obs))"

lemma finite_observed_bindings_initial [simp]:
  "{||} |\<in>| finite_observed_bindings P obs"
  by (simp only: finite_observed_bindings_def finite_compatible_union_initial)

lemma finite_observed_bindings_add:
  assumes generated: "V |\<in>| finite_observed_bindings P obs"
    and observed: "(i,p,t) |\<in>| finite_pattern_observations P obs"
    and compatible: "finite_relation_functional (V |\<union>| finite_matching_bindings p t)"
  shows "V |\<union>| finite_matching_bindings p t |\<in>| finite_observed_bindings P obs"
proof -
  have member: "finite_matching_bindings p t |\<in>|
    fimage (\<lambda>(i,p,t). finite_matching_bindings p t) (finite_pattern_observations P obs)"
    using fimageI[OF observed, of "\<lambda>(i,p,t). finite_matching_bindings p t"] by simp
  show ?thesis unfolding finite_observed_bindings_def
    apply (rule finite_compatible_union_add[OF _ member compatible])
    apply (use generated in \<open>simp only: finite_observed_bindings_def\<close>)
    done
qed

lemma finite_observed_bindings_single:
  assumes "(i,p,t) |\<in>| finite_pattern_observations P obs"
  shows "finite_matching_bindings p t |\<in>| finite_observed_bindings P obs"
proof -
  have functional: "finite_relation_functional (finite_matching_bindings p t)"
    using assms by (auto simp: finite_pattern_observation_member finite_pattern_accepts_def
      finite_term_bindings_formed_def)
  have "{||} |\<union>| finite_matching_bindings p t |\<in>| finite_observed_bindings P obs"
    by (rule finite_observed_bindings_add[OF finite_observed_bindings_initial assms])
      (use functional in simp)
  then show ?thesis by simp
qed

definition finite_binding_support where
  "finite_binding_support P obs V=ffilter
    (\<lambda>(i,p,t). finite_matching_bindings p t |\<subseteq>| V) (finite_pattern_observations P obs)"

lemma finite_binding_support_member:
  "(i,p,t) |\<in>| finite_binding_support P obs V \<longleftrightarrow>
    (i,p) |\<in>| P \<and> (i,t) |\<in>| obs \<and> finite_pattern_accepts p t \<and>
    finite_matching_bindings p t |\<subseteq>| V"
  by (auto simp: finite_binding_support_def finite_pattern_observation_member)

lemma finite_pattern_instance_binding_mono:
  assumes inst: "finite_pattern_instance V p t" and included: "V |\<subseteq>| W"
  shows "finite_pattern_instance W p t"
proof -
  have decoded: "pattern_instance (decode_finite_term_bindings V) (decode_finite_pattern p) (decode_finite_term t)"
    using inst by (simp only: finite_pattern_instance_correct)
  have subset: "decode_finite_term_bindings V\<subseteq>decode_finite_term_bindings W"
    using included by (auto simp: decode_finite_term_bindings_def map_relation_values_def)
  show ?thesis using pattern_instance_binding_mono[OF decoded subset]
    by (simp only: finite_pattern_instance_correct)
qed

theorem finite_binding_support_instance:
  assumes member: "(i,p,t) |\<in>| finite_binding_support P obs V"
  shows "finite_pattern_instance V p t"
  by (rule finite_pattern_instance_binding_mono)
    (use member in \<open>auto simp: finite_binding_support_member finite_pattern_accepts_def\<close>)

definition finite_observation_union where
  "finite_observation_union M=ffUnion (fimage (\<lambda>(i,p,t). finite_matching_bindings p t) M)"

lemma finite_observation_union_domain_member:
  "a |\<in>| fimage fst (finite_observation_union M) \<longleftrightarrow>
    (\<exists>i p t u. (i,p,t) |\<in>| M \<and> (a,u) |\<in>| finite_matching_bindings p t)"
  by (auto simp: finite_observation_union_def ffUnion.rep_eq fimage.rep_eq
    image_iff split: prod.splits; force)

lemma finite_observation_union_contains:
  assumes "(i,p,t) |\<in>| M"
  shows "finite_matching_bindings p t |\<subseteq>| finite_observation_union M"
  using assms by (auto simp: finite_observation_union_def ffUnion.rep_eq fimage.rep_eq
    image_iff split: prod.splits; force)

lemma finite_binding_support_image:
  "fimage (\<lambda>(i,p,t). finite_matching_bindings p t) (finite_binding_support P obs V)=
    ffilter (\<lambda>W. W |\<subseteq>| V)
      (fimage (\<lambda>(i,p,t). finite_matching_bindings p t) (finite_pattern_observations P obs))"
  by (rule fset_eqI)
    (auto simp: finite_binding_support_def finite_image_member split_paired_Ex; force)

theorem finite_observed_bindings_support_complete:
  assumes generated: "V |\<in>| finite_observed_bindings P obs"
  shows "finite_observation_union (finite_binding_support P obs V)=V"
proof -
  have unions: "V |\<in>| finite_compatible_unions
    (fimage (\<lambda>(i,p,t). finite_matching_bindings p t) (finite_pattern_observations P obs))"
    using generated by (simp only: finite_observed_bindings_def)
  show ?thesis using finite_compatible_union_support[OF unions]
    by (simp only: finite_observation_union_def finite_binding_support_image)
qed

theorem finite_observed_bindings_scope_supported:
  assumes functional: "finite_relation_functional V"
  shows "V |\<in>| finite_observed_bindings P obs \<longleftrightarrow>
    fimage fst V |\<subseteq>| fimage fst (finite_observation_union (finite_binding_support P obs V))"
  by (simp only: finite_observed_bindings_def finite_compatible_union_scope_supported[OF functional]
    finite_observation_union_def finite_binding_support_image)

definition finite_join_observations where
  "finite_join_observations P E=
    (let M=finite_pattern_observations P E; V=finite_observation_union M
     in if finite_relation_functional P \<and> fimage (\<lambda>(i,p,t). (i,t)) M=E \<and>
       finite_relation_functional V then Some V else None)"

theorem finite_join_observations_exact:
  "finite_join_observations P E=Some V \<longleftrightarrow>
    finite_relation_functional P \<and>
    fimage (\<lambda>(i,p,t). (i,t)) (finite_pattern_observations P E)=E \<and>
    finite_relation_functional V \<and> V=finite_observation_union (finite_pattern_observations P E)"
  by (auto simp: finite_join_observations_def Let_def split: if_splits)

theorem finite_join_observations_retains_every_input:
  assumes joined: "finite_join_observations P E=Some V" and observed: "(i,t) |\<in>| E"
  shows "\<exists>p. (i,p) |\<in>| P \<and> finite_pattern_accepts p t \<and>
    finite_matching_bindings p t |\<subseteq>| V"
proof -
  let ?M="finite_pattern_observations P E"
  have projection: "fimage (\<lambda>(i,p,t). (i,t)) ?M=E"
    and union: "V=finite_observation_union ?M"
    using joined by (simp_all add: finite_join_observations_exact)
  have image: "(i,t) |\<in>| fimage (\<lambda>(i,p,t). (i,t)) ?M"
    using observed by (simp only: projection)
  obtain p where member: "(i,p,t) |\<in>| ?M"
    using image by auto
  have included: "finite_matching_bindings p t |\<subseteq>| V"
    using finite_observation_union_contains[OF member] by (simp only: union)
  show ?thesis using member included by (auto simp: finite_pattern_observation_member)
qed

theorem finite_observed_binding_origin:
  assumes generated: "V |\<in>| finite_observed_bindings P obs" and row: "(a,t) |\<in>| V"
  shows "\<exists>i p u. (i,p) |\<in>| P \<and> (i,u) |\<in>| obs \<and>
    finite_pattern_accepts p u \<and> (a,t) |\<in>| finite_matching_bindings p u"
proof -
  have unions: "V |\<in>| finite_compatible_unions
      (fimage (\<lambda>(i,p,u). finite_matching_bindings p u) (finite_pattern_observations P obs))"
    using generated by (simp only: finite_observed_bindings_def)
  obtain W where member: "W |\<in>| fimage (\<lambda>(i,p,u). finite_matching_bindings p u)
      (finite_pattern_observations P obs)" and inside: "(a,t) |\<in>| W"
    using finite_compatible_union_origin[OF unions row] by blast
  obtain i p u where source: "(i,p,u) |\<in>| finite_pattern_observations P obs"
    and shape: "W=finite_matching_bindings p u" using member by auto
  show ?thesis using source inside by (auto simp: finite_pattern_observation_member shape)
qed

lemma finite_observed_bindings_functional:
  "V |\<in>| finite_observed_bindings P obs \<Longrightarrow> finite_relation_functional V"
  by (auto simp: finite_observed_bindings_def finite_compatible_union_member)

lemma finite_observed_bindings_values:
  assumes generated: "V |\<in>| finite_observed_bindings P obs" and row: "(a,t) |\<in>| V"
  shows "finite_term_formed t"
  using finite_observed_binding_origin[OF generated row]
  by (auto simp: finite_pattern_accepts_def finite_term_bindings_formed_def)

theorem finite_observed_bindings_complete_scope:
  assumes generated: "V |\<in>| finite_observed_bindings P obs"
  shows "finite_term_bindings_formed B V \<longleftrightarrow> fimage fst V=B"
  using finite_observed_bindings_functional[OF generated] finite_observed_bindings_values[OF generated]
  by (auto simp: finite_term_bindings_formed_def)

text \<open>
  P contains the actual source patterns and obs the observed terms at their
  source keys. Only an accepted structural match supplies a relation. The
  union operation considers compatible combinations of any finite number of
  contributions; no contribution must cover the complete application alone.
  Every resulting pair has an actual source match, and disagreement on one
  variable is rejected. Whole-scope completion is a separate final condition.

  These observations establish substitution information. They do not establish
  the truth of a requested conclusion or a possible premise. Concrete schema
  consumers must derive P from the same complete schema they later check.
\<close>

end
