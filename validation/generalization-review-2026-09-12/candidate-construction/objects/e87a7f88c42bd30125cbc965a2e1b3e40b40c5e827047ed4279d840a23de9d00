#!/usr/bin/env python3
"""Execute and independently recover complete schema observation contributions."""
from __future__ import annotations

import argparse
import json
from pathlib import Path

import application_subjects as comparison
import check_reasoning as review
import investigate
import proved_code


def ml_site(site):
    if site == ["head"]:
        return "N.Finite_Conclusion_Site"
    if len(site) == 3 and site[0] == "premise":
        return "N.Finite_Premise_Site (" + investigate.ml_nat(site[1]) + "," + investigate.ml_nat(site[2]) + ")"
    if len(site) == 3 and site[0] == "material" and site[1] in review.MATERIAL_OBSERVATION_FIELDS:
        return "N.Finite_Material_" + site[1].title() + "_Site (" + investigate.ml_nat(site[2]) + ")"
    raise ValueError("Expected an actual schema observation site.")


PRELUDE = ("structure N = Application_Comparison;\n" + review.FSET_TERM_SCHEMA_JSON_PRELUDE
           + review.LOCAL_APPLICATION_JSON_PRELUDE + r'''
fun jsite N.Finite_Conclusion_Site = "[\"head\"]"
 | jsite (N.Finite_Premise_Site (s,d)) = "[\"premise\"," ^ jnat s ^ "," ^ jnat d ^ "]"
 | jsite (N.Finite_Material_Source_Site s) = "[\"material\",\"source\"," ^ jnat s ^ "]"
 | jsite (N.Finite_Material_Atoms_Site s) = "[\"material\",\"atoms\"," ^ jnat s ^ "]"
 | jsite (N.Finite_Material_Edges_Site s) = "[\"material\",\"edges\"," ^ jnat s ^ "]"
 | jsite (N.Finite_Material_Counts_Site s) = "[\"material\",\"counts\"," ^ jnat s ^ "]"
 | jsite (N.Finite_Material_Functions_Site s) = "[\"material\",\"functions\"," ^ jnat s ^ "]";
fun jsource (i,p) = "[" ^ jsite i ^ "," ^ jpattern p ^ "]";
fun jobservation (i,t) = "[" ^ jsite i ^ "," ^ jterm t ^ "]";
fun jwitness (i,(p,t)) = "[" ^ jsite i ^ "," ^ jpattern p ^ "," ^ jterm t ^ "]";
fun jjoined NONE = "null" | jjoined (SOME v) = jf jbinding v;
fun emit id schema observations = let
 val sources = N.natural_schema_observation_sources schema;
 val joined = N.natural_observation_join sources observations;
 val bindings = N.natural_observed_bindings sources observations;
 fun supported v = "{\"bindings\":" ^ jf jbinding v ^ ",\"witnesses\":" ^
   jf jwitness (N.natural_binding_support sources observations v) ^ "}";
 val applications = N.natural_observed_schema_applications schema observations;
 in print ("BINDING_CONTRIBUTIONS " ^ Int.toString id ^ " {\"schema\":" ^ jschema schema ^
  ",\"observations\":" ^ jf jobservation observations ^ ",\"sources\":" ^ jf jsource sources ^
  ",\"joined\":" ^ jjoined joined ^ ",\"bindings\":" ^ jf supported bindings ^
  ",\"applications\":" ^ jf jlocal applications ^ "}\n") end;
''')


def program(engine, cases):
    source = "use " + investigate.ml_string(str(engine)) + ";\n" + PRELUDE
    for i, case in enumerate(cases):
        schema = review.ml_schema(case["schema"], schema_constructor="N.make_finite_schema",
                                  material_constructor="N.make_finite_material")
        observations = investigate.ml_list(case["observations"],
            lambda row: "(" + ml_site(row[0]) + "," + review.ml_term(row[1]) + ")")
        source += "val () = emit " + str(i) + " (" + schema + ") (fs " + observations + ");\n"
    return source


def binding_key(rows):
    return frozenset((v, review.freeze(t)) for v, t in rows)


def assess(cases, raw):
    reports = {}
    for line in raw.splitlines():
        if line.startswith("BINDING_CONTRIBUTIONS "):
            _, identifier, value = line.split(" ", 2)
            identifier = int(identifier)
            assert identifier not in reports
            reports[identifier] = json.loads(value)
    assert set(reports) == set(range(len(cases)))
    for i, case in enumerate(cases):
        result = reports[i]
        rule, observations = case["schema"], case["observations"]
        sources = review.schema_observation_sources(rule)
        assert review.schema_key(result["schema"]) == review.schema_key(rule)
        assert set(map(review.freeze, result["observations"])) == set(map(review.freeze, observations))
        assert set(map(review.freeze, result["sources"])) == set(map(review.freeze, sources))
        witnesses = review.recover_observations(sources, observations)
        contributions = [part for _, _, _, part in witnesses]
        valuations = list(review.observation_valuations(review.schema_variables(rule), contributions, complete=False))
        expected = {binding_key(v.items()): v for v in valuations}
        actual = {binding_key(v["bindings"]): v for v in result["bindings"]}
        assert set(actual) == set(expected), i
        for key, row in actual.items():
            values = expected[key]
            support = [review.freeze([site, pattern, term]) for site, pattern, term, part in witnesses
                       if all(values.get(v) == t for v, t in part.items())]
            assert set(map(review.freeze, row["witnesses"])) == set(support), i
        all_rows = [(v, t) for part in contributions for v, t in part.items()]
        covered = {review.freeze([site, term]) for site, _, term, _ in witnesses}
        join_ok = (review.functional(sources) and covered == set(map(review.freeze, observations))
                   and review.functional(all_rows))
        assert (result["joined"] is not None) == join_ok, i
        if join_ok:
            assert binding_key(result["joined"]) == binding_key(all_rows), i
        applications = []
        if review.schema_formed(rule):
            for values in valuations:
                application = review.application_from_valuation({"entry": 0, "schema": rule}, values)
                if application is not None:
                    applications.append(application)
        assert set(map(comparison.application_key, result["applications"])) == set(map(comparison.application_key, applications)), i
    return {"cases": [{"name": case["name"], "result": reports[i]} for i, case in enumerate(cases)],
            "checked_cases": len(cases),
            "contracts": ["finite_pattern_observation_contract", "finite_join_observations_exact",
                          "finite_join_observations_retains_every_input", "finite_binding_support_instance",
                          "finite_observed_bindings_support_complete",
                          "finite_observed_schema_applications_exact"],
            "boundary": "Every source is a projection of the supplied complete schema. Required groups retain every input; the observation pool permits compatible alternatives. Applications retain the original complete instance and material checks. Observations do not establish premise truth."}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    for name in ["specification", "proof", "poly", "output"]:
        parser.add_argument("--" + name, type=Path, required=True)
    args = parser.parse_args()
    cases = json.loads(args.specification.read_text())
    receipt = proved_code.checked_execution(args.proof, args.poly, args.output,
        required_theories=["Factor_Application_Execution", "Factor_Binding_Contributions"], inputs=cases,
        input_paths=[args.specification], program=program, assess=assess,
        question="Recover compatible bindings from actual schema observation sites.",
        boundary="The complete schema and observed terms are inputs; supplied facet ratings are not.")
    print(json.dumps({k: v for k, v in receipt.items() if k not in {"assessment", "execution_inputs", "evidence_archive"}}, indent=2))
    if receipt["status"] == "accepted":
        print(json.dumps({"checked_cases": receipt["assessment"]["checked_cases"]}))
    return int(receipt["status"] != "accepted")


if __name__ == "__main__":
    raise SystemExit(main())
