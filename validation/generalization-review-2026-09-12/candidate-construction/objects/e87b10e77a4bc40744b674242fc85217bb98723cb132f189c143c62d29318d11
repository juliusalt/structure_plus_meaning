"""Export code from the exact accepted isolated proof without replacing its receipt."""
import argparse,json,os,re,subprocess,sys
from pathlib import Path
sys.path.insert(0,'/home/julius/structure_and_semantics/tools')
import investigate,proved_code

def main():
 p=argparse.ArgumentParser();p.add_argument('--proof',type=Path,required=True);p.add_argument('--project',type=Path,required=True);p.add_argument('--output',type=Path,required=True);p.add_argument('--theory',required=True);p.add_argument('--prefix',required=True);a=p.parse_args()
 proof,sources=proved_code.accepted_proof(a.proof,project=a.project,required_theories=[a.theory])
 context=a.proof.parent;session=re.search(r'^session (\S+) =',(context/'ROOT').read_text()).group(1)
 parent=json.loads((context/'parent.json').read_text())
 assert not a.output.exists();a.output.mkdir()
 tracked={**sources,str(a.proof):investigate.file_hash(a.proof),str(Path(__file__)):investigate.file_hash(Path(__file__))}
 command=['isabelle','export','-n','-d',str(parent['project']),'-d',str(context),'-x','*:code/'+a.prefix+'.ML','-O',str(a.output/'export'),session]
 with (a.output/'export.log').open('w') as f:r=subprocess.run(command,env={**os.environ,'USER_HOME':'/tmp/structural-isabelle'},stdout=f,stderr=subprocess.STDOUT,timeout=60)
 assert r.returncode==0
 exports=list((a.output/'export').rglob(a.prefix+'.ML'));assert len(exports)==1
 assert all(investigate.file_hash(Path(p))==sha for p,sha in tracked.items())
 result={**proof,'source_proof':str(a.proof),'source_proof_sha256':tracked[str(a.proof)],'export_command':command,'export_inputs':tracked,'exports':[{'path':str(exports[0]),'sha256':investigate.file_hash(exports[0])}]}
 (a.output/'proof.json').write_text(json.dumps(result,indent=2)+'\n');print(exports[0])
if __name__=='__main__':main()
