"""Retain the complete construction batch, replay it, and preserve combined diagnostics."""
from pathlib import Path
from concurrent.futures import ThreadPoolExecutor
import json,os,subprocess,sys,time
B=Path(__file__).parent;M=Path('/home/julius/structure_and_semantics')
A=M/'validation/generalization-review-2026-09-12/candidate-construction'
D=B/'final-archive-validation1';D.mkdir()
ENV={**os.environ,'PYTHONDONTWRITEBYTECODE':'1'}
POLY=Path('/opt/isabelle/contrib/polyml-5.9.2-2/x86_64-linux/poly')
def run(label,command,timeout):
 start=time.monotonic()
 with (D/(label+'.log')).open('w') as log:
  try:code=subprocess.run(list(map(str,command)),cwd=M,env=ENV,stdout=log,stderr=subprocess.STDOUT,timeout=timeout).returncode
  except subprocess.TimeoutExpired:code='timeout'
 return {'label':label,'command':list(map(str,command)),'exit_code':code,'seconds':time.monotonic()-start,'log':str(D/(label+'.log'))}
steps=[]
command=['python3','-B',M/'tools/retain_reasoning_review.py','--specification',B/'candidate-archive-spec.json','--output',A,'--project',M,'--fallback-sources',B,'--prior-archive',M/'validation/generalization-review-2026-09-11/structural-observations','--prior-archive',M/'validation/generalization-review-2026-09-11/indexed-subject-contracts-retained-inputs']
step=run('retain-complete-batch',command,1200);steps.append(step)
if step['exit_code']==0:
 index=json.loads((A/'index.json').read_text())
 native=['application-controls','application-large-7','application-large-8','application-large-9','application-large-10','generic-search','original-guided','native-source','original-reader']
 assert set(native)<=index['runs'].keys()
 def replay_investigation(name):
  return run('investigation--'+name,['python3','-B',M/'tools/replay_reasoning_review.py','--archive',A,'--investigation',name,'--poly',POLY,'--output',D/'investigations'/name],180)
 with ThreadPoolExecutor(max_workers=4) as pool:
  investigations=list(pool.map(replay_investigation,sorted(index.get('investigations',{}))))
 steps.extend(investigations)
 for name in native:
  steps.append(run('native--'+name,['python3','-B',M/'tools/replay_reasoning_review.py','--archive',A,'--stage',name,'--poly',POLY,'--output',D/'native'/name],240))
(D/'steps.json').write_text(json.dumps(steps,indent=2)+'\n')
summary={'complete':all(row['exit_code']==0 for row in steps),'steps':len(steps),'failures':[row for row in steps if row['exit_code']!=0],'archive':str(A),'diagnostics':str(D/'steps.json')}
(D/'summary.json').write_text(json.dumps(summary,indent=2)+'\n');print(json.dumps(summary),flush=True)
raise SystemExit(0 if summary['complete'] else 1)
