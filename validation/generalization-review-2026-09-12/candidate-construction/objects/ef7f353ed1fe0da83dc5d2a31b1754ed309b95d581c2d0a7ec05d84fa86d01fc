 relative=p.relative_to(B)
 return 'worktree' in relative.parts or '__pycache__' in relative.parts or '.git' in relative.parts or any(x.startswith('delivery-replay-fixture') or x.startswith('delivery-native-replay') for x in relative.parts) or 'candidate-replay' in relative.parts
