#!/usr/bin/env python3
"""Execute complete finite presenters and independently recover every input field."""
from __future__ import annotations

import argparse
import json
from pathlib import Path
import subprocess
import uuid

import check_reasoning as review
import finite_presentation_cases as family
import investigate
import proved_code


def ml_word(word):
    return investigate.ml_list(word, investigate.ml_nat)


def ml_use(use):
    return "NONE" if use is None else "(SOME " + ml_word(use) + ")"


def ml_artifact(source):
    pair = lambda row: "(" + ml_word(row[0]) + "," + ml_word(row[1]) + ")"
    edge = lambda row: "(" + ml_word(row[0]) + "," + pair(row[1:]) + ")"
    return "(N.finite_enumerated_artifact " + " ".join([
        investigate.ml_list(source["carrier"], ml_word),
        investigate.ml_list(source["incidence"], edge),
        investigate.ml_list(source["bag"], pair),
        investigate.ml_list(source["functional"], pair)]) + ")"


def ml_environment(source):
    artifact = lambda row: "(" + ml_use(row[0]) + "," + ml_artifact(row[1]) + ")"
    binding = lambda row: "((" + ml_use(row[0]) + "," + ml_word(row[1]) + ")," + ml_use(row[2]) + ")"
    return "(N.finite_enumerated_environment " + investigate.ml_list(source["artifacts"], artifact) \
        + " " + investigate.ml_list(source["bindings"], binding) + ")"


PRELUDE = r'''
structure N = Finite_Presented_Data;
val n = N.nat_of_integer;
val emptyTarget = N.Finite_Whole N.finite_empty_artifact;
''' + review.SCALAR_JSON_PRELUDE + r'''
fun jtarget _ = raise Fail "Unexpected target in a data-only presenter output";
''' + review.TERM_JSON_PRELUDE + r'''
fun joption NONE = "null" | joption (SOME t) = jterm t;
fun valueFormed NONE = false | valueFormed (SOME t) = N.finite_term_formed t;
fun emit name formed result = print ("PRESENTATION_RESULT " ^
 "{\"name\":\"" ^ name ^ "\",\"source_formed\":" ^ Bool.toString formed ^
 ",\"value\":" ^ joption result ^ ",\"value_formed\":" ^
 Bool.toString (valueFormed result) ^ "}\n");
'''


def program(engine, inputs):
    text = "use " + investigate.ml_string(str(engine)) + ";\n" + PRELUDE
    for item in inputs:
        kind, source = item["kind"], item["source"]
        if kind == "projection":
            value = review.ml_term(source)
            formed, convert = "N.finite_term_formed", "N.finite_data_projection"
        elif kind == "artifact":
            value = ml_artifact(source)
            formed, convert = "N.finite_exact_formed", "(SOME o N.finite_artifact_value)"
        else:
            assert kind == "environment"
            value = ml_environment(source)
            formed, convert = "N.finite_presented_environment_formed", "(SOME o N.finite_environment_value)"
        text += ("val () = let val source = " + value + " in emit "
                 + investigate.ml_string(item["name"]) + " (" + formed + " source) ("
                 + convert + " source) end;\n")
    return text


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--proof", type=Path, required=True)
    parser.add_argument("--poly", type=Path, required=True)
    parser.add_argument("--output", type=Path, required=True)
    args = parser.parse_args()
    if not __debug__:
        raise ValueError("Presentation checking requires Python assertions.")
    proof_path, poly, output = args.proof.resolve(), args.poly.resolve(), args.output.resolve()
    proof, engine, sources = proved_code.proved_export(
        proof_path, required_theories=["Factor_Executable_Environment_Values"])
    assert not output.exists(), "Retain previous results and use a new directory."
    output.mkdir(parents=True)
    report = {"status": "failed", "invocation": str(uuid.uuid4()), "question": __doc__,
              "boundary": "Finite data presentation checks; native inference admission remains separate."}
    try:
        inputs = family.cases()
        cases_path = output / "cases.json"
        cases_path.write_text(json.dumps(inputs, indent=2) + "\n")
        runtime = output / "execute.ML"
        runtime.write_text(program(engine, inputs))
        tracked = {path: review.digest(path) for path in
                   [proof_path, engine, poly, runtime, cases_path, *review.loaded_tool_sources()]}
        execution_inputs = {str(path): sha for path, sha in tracked.items()} | sources
        (output / "execution-inputs.json").write_text(json.dumps(execution_inputs, indent=2) + "\n")
        proved_code.archive_execution_inputs(output, report, execution_inputs, external=[poly])
        log_path = output / "results.log"
        with log_path.open("w") as log:
            result = subprocess.run([str(poly), "--script", str(runtime)], stdout=log,
                                    stderr=subprocess.STDOUT, timeout=60)
        report["exit_code"] = result.returncode
        assert result.returncode == 0, "See the retained results.log."
        prefix = "PRESENTATION_RESULT "
        outputs = [json.loads(line[len(prefix):]) for line in log_path.read_text().splitlines()
                   if line.startswith(prefix)]
        assessment = family.assess(inputs, outputs)
        stable = proved_code.execution_inputs_unchanged(execution_inputs, report, external=[poly])
        assert stable, "Sources, execution inputs or checker changed during execution."
        report.update(status="accepted", sources_and_tools_unchanged=stable,
                      checked_cases=len(inputs), assessment=assessment,
                      proof_receipt_sha256=review.digest(proof_path), export_sha256=review.digest(engine),
                      results_sha256=review.digest(log_path),
                      execution_inputs=execution_inputs)
        (output / "complete-results.json").write_text(json.dumps(outputs, indent=2) + "\n")
    except (AssertionError, ValueError, OSError, subprocess.SubprocessError) as error:
        report["error"] = str(error)
    (output / "receipt.json").write_text(json.dumps(report, indent=2) + "\n")
    print(json.dumps({k: v for k, v in report.items()
                      if k not in {"evidence_archive", "execution_inputs"}}, indent=2))
    return 0 if report["status"] == "accepted" else 1


if __name__ == "__main__":
    raise SystemExit(main())
