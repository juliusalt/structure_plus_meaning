theory Finite_Demand_Selection
  imports "RRA_Factor_Structural_Bootstrap.Finite_Set_Composition"
begin

section \<open>A required key is chosen from the actual uncovered scope\<close>

definition finite_demand_choice where
  "finite_demand_choice cost As covered =
    (let remaining=filter (\<lambda>a. a |\<notin>| covered) As
     in if remaining=[] then None else Some (arg_min_list cost remaining))"

lemma finite_demand_choice_none:
  "finite_demand_choice cost As covered=None \<longleftrightarrow> fset_of_list As |\<subseteq>| covered"
  by (auto simp: finite_demand_choice_def Let_def filter_empty_conv fset_of_list_elem split: if_splits)

lemma finite_demand_choice_member:
  assumes "finite_demand_choice cost As covered=Some a"
  shows "a |\<in>| fset_of_list As" "a |\<notin>| covered"
  using assms arg_min_list_in[of "filter (\<lambda>a. a |\<notin>| covered) As" cost]
  by (auto simp: finite_demand_choice_def Let_def fset_of_list_elem split: if_splits)

lemma finite_demand_choice_least:
  assumes selected: "finite_demand_choice cost As covered=Some a"
    and other: "b |\<in>| fset_of_list As" "b |\<notin>| covered"
  shows "cost a \<le> cost b"
proof -
  let ?R="filter (\<lambda>a. a |\<notin>| covered) As"
  have nonempty: "?R\<noteq>[]" and chosen: "a=arg_min_list cost ?R"
    using selected by (auto simp: finite_demand_choice_def Let_def split: if_splits)
  have member: "cost b\<in>cost ` set ?R" using other by (auto simp: fset_of_list_elem)
  show ?thesis by (simp only: chosen f_arg_min_list_f[OF nonempty])
    (rule Min_le; use member in auto)
qed

lemma finite_demand_progress:
  assumes "a |\<in>| scope" "a |\<notin>| covered" "a |\<in>| added"
  shows "fcard (scope |-| (covered |\<union>| added)) < fcard (scope |-| covered)"
  by (rule pfsubset_fcard_mono) (use assms in auto)

text \<open>
  The list order resolves only ties. Every selected key is still required and
  has minimum supplied cost among all uncovered keys. The progress law concerns
  the finite scope itself, including repeated list presentations.
\<close>

end
