"""Verify the complete retained delivery before proposing bounded staging cleanup."""
from pathlib import Path
import json, sys

M = Path('/home/julius/structure_and_semantics')
Q = Path(__file__).parent
V = M / 'validation/generalization-review-2026-09-12'
A, D = V / 'candidate-construction', V / 'candidate-construction-delivery'
T = Path('/tmp/generalization-quality-review/candidate-delivery')
S = V / 'candidate-storage-recovery'
sys.path.insert(0, str(M / 'tools'))
import evidence_io, prove_context, investigate, compare_reasoning_methods as comparison


def write(path, value):
    path.write_text(json.dumps(value, indent=2) + '\n')


archive_checks = []
for base in [A, D]:
    manifest = json.loads((base / 'archive.json').read_text())
    for ref, sha in manifest['files'].items():
        path = (base / ref).resolve()
        assert path.is_relative_to(M / 'validation'), (base, ref)
        assert evidence_io.digest(path) == sha, path
        if ref in manifest.get('encodings', {}):
            evidence_io.unpack(path, manifest['encodings'][ref])
    archive_checks.append({'archive': str(base), 'index_sha256': evidence_io.digest(base / 'index.json'),
                          'manifest_sha256': evidence_io.digest(base / 'archive.json'),
                          'verified_references': len(manifest['files']),
                          'verified_decoded_blobs': len(manifest.get('encodings', {}))})

index = json.loads((D / 'index.json').read_text())
manifest = json.loads((D / 'archive.json').read_text())
physical = json.loads((T / 'physical-files.json').read_text())
rows = [row for row in physical if Path(row['path']).is_relative_to(S / 'runtime')]
assert rows
assert {Path(row['path']) for row in rows} == {p for p in (S / 'runtime').rglob('*') if p.is_file()}
for row in rows:
    path = Path(row['path'])
    assert path.is_symlink() == row['symlink'] and path.stat().st_size == row['bytes']
    assert evidence_io.digest(path) == row['sha256'], path
    ref = index['attachments'][row['attachment']]
    assert manifest.get('encodings', {}).get(ref, {}).get('sha256', manifest['files'][ref]) == row['sha256']
    row['retained_reference'] = str((D / ref).relative_to(M))
write(Q / 'runtime-copies.json', rows)

session, sources, inputs = prove_context.accepted_parent(M)
proof_check = {'session': session, 'accepted_source_theories': len(sources),
               'unchanged_recorded_build_inputs': len(inputs),
               'build_invocation': json.loads((M / 'validation/check.json').read_text())['invocation']}
supplements = []
for name in ['storage-initial', 'storage-followed', 'documentation-initial', 'documentation-followed']:
    base = T / 'supplement-replays' / name
    receipt = json.loads((base / 'replay.json').read_text())
    assert receipt['status'] == 'accepted'
    assert receipt['archive_index_sha256'] == evidence_io.digest(D / 'index.json')
    assert receipt['replayer_sha256'] == evidence_io.digest(M / 'tools/replay_reasoning_review.py')
    assert receipt['runtime_program_sha256'] == evidence_io.digest(base / 'execute.ML')
    assert receipt['results_log_sha256'] == evidence_io.digest(base / 'results.log')
    supplements.append({'stage': name, 'receipt': receipt, 'receipt_sha256': evidence_io.digest(base / 'replay.json')})
write(Q / 'verification.json', {'archives': archive_checks, 'source_check': proof_check,
      'verified_runtime_copies': len(rows), 'logical_copy_bytes': sum(row['bytes'] for row in rows),
      'supplemental_replays': supplements,
      'primary_replays': json.loads((D / 'replays.json').read_text()),
      'delivery_steps': json.loads((T / 'steps.json').read_text()),
      'documentation_adoption': json.loads(Path('/tmp/generalization-quality-review/candidate-documentation/adoption.json').read_text()),
      'boundary': 'All stored and decoded archive identities and current accepted build inputs are checked. Complete replay receipts are retained; proof checking and host scheduling claims remain distinct.'})

requirements = ['Every runtime copy retains its exact bytes in the permanent delivery archives.',
                'Remove only the enumerated redundant runtime files after rechecking their identities, so they cannot introduce large raw blobs into the commit.',
                'Preserve the current accepted proof sources, complete native results, conditional reasons and declared remaining obligations.',
                'Retain all four supplemental replay receipts and outputs, then check the exact staged files and publish the authorized batch only after those checks pass.']
proposal = {'problem': 'Finish the proved candidate-construction delivery with complete retained verification and a portable commit, while avoiding reintroduction of redundant gigabyte replay inputs.',
            'requirements': requirements, 'cleanup_scope': str(Q / 'runtime-copies.json'),
            'cleanup_operation': 'Recheck every listed live identity and archive manifest identity, then unlink only the listed paths and remove their empty runtime directories.',
            'publication_prerequisites': ['Unchanged accepted source inputs', 'Exact retained recovery for all removed copies', 'Complete supplemental replay evidence', 'No new staged object at or above 100 MiB', 'No active source/document whitespace errors', 'All final retained references resolve inside repository validation'],
            'criticism': 'The host supplies the concrete cleanup operation and observation claims. The finite conditional machinery compares these claims; it does not derive filesystem semantics or search arbitrary repository edits. Hash checks establish identity, not semantic adequacy. Commit and push remain dependent on the stated final checks.'}
write(Q / 'proposal.json', proposal)
boundary = 'Prospective conditional delivery choice on the enumerated runtime copies, actual complete archive and source identity checks, and complete supplemental replay receipts. Final publication prerequisites remain explicit.'
case = comparison.comparison_case([0, 1], list(range(4)), [[0, 0, 0], [2, 0, 0]] + [[f, 1, 0] for f in range(4)], [],
    question=proposal['problem'], scope={'candidates': {'0': 'Stage the raw runtime copies without the final supplemental record', '1': 'Remove exact retained runtime copies, retain final verification and pass the stated publication checks'},
    'facets': dict(enumerate(requirements)), 'subjects': str(Q / 'proposal.json')},
    evidence=[{'path': str(p), 'sha256': investigate.file_hash(p)} for p in [Q / 'proposal.json', Q / 'verification.json', Q / 'runtime-copies.json', Path(__file__), Q / 'finish.py']])
case['semantic_boundary'] = boundary
write(Q / 'investigation.json', {'question': proposal['problem'], 'boundary': boundary,
      'problems': [{'name': 'finish-verified-candidate-delivery', 'case': case, 'required_observations': [[f, 0] for f in range(4)]}]})
print(json.dumps({'archives': archive_checks, 'source_check': proof_check, 'runtime_files': len(rows),
                  'logical_copy_bytes': sum(row['bytes'] for row in rows), 'supplemental_replays': len(supplements)}), flush=True)
