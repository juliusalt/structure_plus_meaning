    "source": "from pathlib import Path\nimport hashlib,json,subprocess,sys,tempfile,time\nsys.path.insert(0,'/home/julius/structure_and_semantics/tools')\nimport proof_contexts as c, export_proved_code as e, native_execution_runtime as rt, investigate\nD=Path(tempfile.mkdtemp(prefix='context-lineage-real-',dir='/tmp'));P=D/'source';(P/'theories').mkdir(parents=True)\n(P/'ROOT').write_text('session Lineage_Source = HOL +\\n  theories\\n    A\\n    B\\n    Unrelated\\n')\n(P/'theories/A.thy').write_text('theory A imports Main begin\\ndefinition versioned :: nat where \"versioned=1\"\\nend\\n')\n(P/'theories/B.thy').write_text('theory B imports A begin\\nlemma dependent_claim: \"versioned=1\" by (simp add: versioned_def)\\nexport_code versioned integer_of_nat in Eval module_name B file_prefix \"versioned\"\\nend\\n')\n(P/'theories/Unrelated.thy').write_text('theory Unrelated imports Main begin\\ndefinition stable :: nat where \"stable=7\"\\nexport_code stable integer_of_nat in Eval module_name Unrelated file_prefix \"stable\"\\nend\\n')\nresults=[]\ndef prove(label,parent=None,roots=('B','Unrelated')):\n O=D/label;session='Context_'+label+'_'+str(time.time_ns());cmd=['python','-B','/home/julius/structure_and_semantics/tools/prove_context.py','--project',str(P),'--output',str(O),'--session',session,'--threads','4','--timeout','120']\n if parent:cmd+=['--parent-project',str(parent)]\n cmd+=list(roots);start=time.monotonic()\n with (D/(label+'.log')).open('w') as f:r=subprocess.run(cmd,stdout=f,stderr=subprocess.STDOUT,timeout=180)\n q=json.loads((O/'result.json').read_text());results.append({'label':label,'output':str(O),'exit_code':r.returncode,'status':q['status'],'rebuilt':q['checked_theories'],'reused':q['parent_theories_reused'],'seconds':time.monotonic()-start});print(results[-1],flush=True);return O,q\nfirst,a=prove('initial');assert a['status']=='accepted';c.adopt_proof_context(first,P)\np=P/'theories/A.thy';p.write_text(p.read_text().replace('versioned=1','versioned=2'))\nbad,b=prove('stale_dependent',first,('B',));assert b['status']=='failed' and b['checked_theories']==2\ntry:c.adopt_proof_context(bad,P)\nexcept AssertionError:pass\nelse:raise AssertionError('Failed dependent proof was admitted.')\np=P/'theories/B.thy';p.write_text(p.read_text().replace('versioned=1','versioned=2'))\nlast,z=prove('repaired',first,('B',));assert z['status']=='accepted';ctx=c.adopt_proof_context(last,P)\nassert ctx['providers']['B']['directory']==str(last) and ctx['providers']['Unrelated']['directory']==str(first)\nO=D/'exports';assert e.export_context(last,P,O,[('B','versioned.ML'),('Unrelated','stable.ML')])==0\nengines={n:Path(json.loads((O/(n+'.proof.json')).read_text())['exports'][0]['path']) for n in ('versioned','stable')}\nrun=D/'run';run.mkdir();text='use '+investigate.ml_string(str(engines['versioned']))+';\\nuse '+investigate.ml_string(str(engines['stable']))+';\\nval () = print (\"ACTUAL_VALUES \" ^ IntInf.toString (B.integer_of_nat B.versioned) ^ \" \" ^ IntInf.toString (Unrelated.integer_of_nat Unrelated.stable) ^ \"\\\\n\");\\n'\ncode,cmd,_=rt.prepare({'code_target':'Eval'},engines['versioned'],text,Path('/opt/isabelle/contrib/polyml-5.9.2-2/x86_64_32-linux/poly'),run,workers=2);(run/'execute.ML').write_text(code)\nwith (run/'native.log').open('w') as f:r=subprocess.run(cmd,stdout=f,stderr=subprocess.STDOUT,timeout=60)\nassert r.returncode==0 and 'ACTUAL_VALUES 2 7' in (run/'native.log').read_text()\nsummary={'status':'accepted','directory':str(D),'steps':results,'provider_sessions':{n:ctx['providers'][n] for n in ('A','B','Unrelated')},'actual_values':[2,7],'boundary':'Changing only an ancestor forced the unchanged dependent theorem to fail. Repairing that theorem produced a new accepted child; exports from the child and its unchanged ancestor both executed with the expected actual values.'};(D/'exercise.json').write_text(json.dumps(summary,indent=2)+'\\n');Path('/tmp/native-context-lineage-exercise.json').write_text(json.dumps(summary,indent=2)+'\\n');print('LINEAGE VERIFIED',D,flush=True)\n",
